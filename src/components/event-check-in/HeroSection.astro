---
// Split product hero, borrowed from the Event Registration / Speaker Management
// hero pattern and adapted to the check-in page content.

const points = [
  "iOS and Android Scanner",
  "QR check-in with offline resilience",
  "Live event, ticket, and instance counts",
];
---

<section class="ecx-hero">
  <div class="ecx-hero__grid">
    <div class="ecx-hero__content">
      <span class="ecx-hero__badge animate-on-scroll" data-animation="fadeInDown">
        Event check-in app
      </span>
      <h1 class="ecx-hero__title animate-on-scroll" data-animation="fadeInUp">
        Event check-in software that <span class="ds-hl">keeps arrivals moving.</span>
      </h1>
      <p class="ecx-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
        Give event-day teams the EventHex Scanner app on iOS or Android, validate
        attendee QR tickets, capture check-ins through connectivity gaps, and keep
        arrival counts visible as the venue fills.
      </p>
      <div class="ecx-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
        {points.map((point) => <span>{point}</span>)}
      </div>
      <div class="ecx-hero__cta-row animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
        <a href="/book-a-demo/" class="ds-btn">
          Book a Demo
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#checkin-rail" class="ds-btn--ghost">
          See the check-in workflow
        </a>
      </div>
    </div>

    <div class="ecx-hero__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="ds-browser ecx-browser">
        <div class="ds-browser__bar" aria-hidden="true">
          <i></i><i></i><i></i>
          <span>ascend-impact-summit.eventhex.ai/event-day-portal</span>
        </div>
        <video class="ecx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="488"
          poster="/feature-images/event-check-in/v5/ci-checkin-poster.webp"
          aria-label="At the Ascend Impact Summit desk the team searches Priya, taps Check in on the Delegate record and the card changes to Checked in">
          <source src="/feature-images/event-check-in/v5/ci-checkin.webm" type="video/webm" />
          <source src="/feature-images/event-check-in/v5/ci-checkin.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<style>
  /* Matches the Event Registration hero shell: full-bleed tinted band that sits
     under the fixed site header. */
  .ecx-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 72px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, color-mix(in srgb, var(--ds-blue) 14%, transparent), transparent 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, color-mix(in srgb, var(--ds-violet-soft) 24%, transparent), transparent 78%),
      var(--ds-white);
  }

  .ecx-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 2;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, transparent, color-mix(in srgb, var(--ds-white) 75%, transparent));
    pointer-events: none;
  }

  .ecx-hero__grid {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }

  .ecx-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .ecx-hero__badge {
    color: var(--brand-blue);
    font: 500 16px/1.4 var(--font-body);
    text-transform: uppercase;
  }

  .ecx-hero__title {
    width: 100%;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(44px, 5vw, 60px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -2.1px;
    color: transparent;
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    background-clip: text;
    -webkit-background-clip: text;
  }

  .ecx-hero__desc {
    width: 100%;
    margin: 0;
    color: var(--subheading-gray);
    font: 400 18px/24px var(--font-body);
    letter-spacing: -0.25px;
  }

  .ecx-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .ecx-hero__points span {
    position: relative;
    padding-left: 16px;
    color: var(--ds-sub);
    font: 500 14px/20px var(--font-body);
  }

  .ecx-hero__points span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .ecx-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-top: 8px;
  }

  .ecx-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: var(--heading-dark);
    color: var(--ds-white);
    font: 650 15px/22px var(--font-body);
    letter-spacing: -0.3px;
    text-decoration: none;
    transition: transform 0.3s, background 0.3s, border-color 0.3s;
  }

  .ecx-hero__btn:hover {
    transform: translateY(-2px);
    background: var(--ds-black);
  }

  .ecx-hero__btn--outline {
    border-color: rgba(16, 24, 40, 0.22);
    background: transparent;
    color: var(--heading-dark);
  }

  .ecx-hero__btn--outline:hover {
    border-color: var(--heading-dark);
    background: transparent;
  }

  .ecx-hero__visual {
    position: relative;
    margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px));
  }

  .ecx-hero__visual-card {
    position: relative;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-right: 0;
    border-radius: 22px 0 0 22px;
    background: var(--ds-glass-fill);
    backdrop-filter: blur(16px);
  }

  .ecx-hero__visual-inner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
    border-radius: 16px 0 0 16px;
    background: linear-gradient(135deg, var(--ds-line), var(--ds-surface) 45%, var(--ds-white));
  }

  .ecx-hero__lottie {
    width: 100%;
    max-width: 460px;
  }

  @media (max-width: 960px) {
    .ecx-hero__grid { grid-template-columns: 1fr; }
    .ecx-hero__content { max-width: 720px; margin: 0 auto; align-items: center; text-align: center; }
    .ecx-hero__points,
    .ecx-hero__cta-row { justify-content: center; }
    .ecx-hero__visual { width: min(680px, 100%); margin: 0 auto; }
    .ecx-hero__visual-card,
    .ecx-hero__visual-inner {
      border-radius: 22px;
      border-right: 1px solid rgba(255, 255, 255, 0.62);
    }
  }

  @media (max-width: 767px) {
    .ecx-hero { margin-top: -80px; padding: 120px 20px 56px; }
    .ecx-hero::after { display: none; }
    .ecx-hero__grid { gap: 34px; }
    .ecx-hero__title { font-size: 38px; line-height: 1.08; letter-spacing: -1.2px; }
    .ecx-hero__desc { font-size: 16px; line-height: 1.6; }
    .ecx-hero__cta-row { width: 100%; flex-direction: column; }
    .ecx-hero__btn { width: 100%; justify-content: center; }
    .ecx-hero__visual-inner { padding: 14px; }
    .ecx-hero__lottie { max-width: 100%; }
  }

  /* ===== EventHex design system v5 overrides (tokens only) ===== */
  .ecx-hero { background: var(--ds-g4-stage); }
  .ecx-hero::after { display: none; }
  .ecx-hero__title { color: var(--ds-ink); background: none; -webkit-background-clip: border-box; background-clip: border-box; letter-spacing: -0.035em; line-height: 1.08; }
  .ecx-hero__badge { color: var(--ds-blue); text-transform: none; font-size: 14px; }
  .ecx-hero__desc { color: var(--ds-body); letter-spacing: 0; }
  .ecx-hero__visual-card { border-color: var(--ds-glass-edge); background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .ecx-hero__visual-inner { background: var(--ds-white); }
  .ecx-hero__visual { margin-right: 0; }
  .ecx-browser { width: 100%; }
  .ecx-loop { display: block; width: 100%; height: auto; background: var(--ds-white); }
</style>

<script>
  // Play the demo loop only while it is on screen; keep it paused for reduced motion.
  const ecxLoops = Array.from(document.querySelectorAll<HTMLVideoElement>('.ecx-loop'));
  const ecxReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (ecxReduced) {
    ecxLoops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const ecxObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    ecxLoops.forEach((video) => ecxObserver.observe(video));
  }
</script>
