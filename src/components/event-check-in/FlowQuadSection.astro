---
// Team section borrowed from the Event Registration spotlight
// ("One Form, or a Full Checkout, Your Call"): a centred title and subtitle
// above a 2x2 hairline quad that alternates copy cells with product-evidence
// composites, and a short centred note underneath.
interface Option {
  title: string;
  description: string;
  note: string;
}

interface Shot {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Composite {
  primary: Shot;
}

interface Props {
  id: string;
  title: string;
  subtitle: string;
  options: Option[];
  composites: Composite[];
  note?: string;
  stage?: boolean;
  highlight?: string;
}

const { id, title, subtitle, options, composites, note, stage = false, highlight } = Astro.props as Props;
const hlAt = highlight ? title.indexOf(highlight) : -1;
const [firstOption, secondOption] = options;
const [firstComposite, secondComposite] = composites;
---

<section class={`ecx-flow${stage ? " ecx-flow--stage" : ""}`} id={id} aria-labelledby={`${id}-heading`}>
  <div class="ecx-flow__header">
    <h2 class="ecx-flow__title animate-on-scroll" data-animation="fadeInUp" id={`${id}-heading`}>
      {hlAt >= 0 ? (<Fragment>{title.slice(0, hlAt)}<span class="ds-hl">{highlight}</span>{title.slice(hlAt + highlight!.length)}</Fragment>) : title}
    </h2>
    <p class="ecx-flow__subtitle animate-on-scroll" data-animation="fadeInUp">
      {subtitle}
    </p>
  </div>

  <div class="ecx-flow__quad">
    <article
      class="ecx-flow__cell ecx-flow__cell--copy animate-on-scroll"
      data-animation="fadeInUp"
    >
      <h3 class="ecx-flow__cell-title">{firstOption.title}</h3>
      <p class="ecx-flow__cell-text">{firstOption.description}</p>
      <span class="ecx-flow__cell-note"><i></i>{firstOption.note}</span>
    </article>

    <div
      class="ecx-flow__cell ecx-flow__cell--media animate-on-scroll"
      data-animation="fadeInRight"
    >
      <div class="ds-shot ecx-flow__shot">
        <img
          src={firstComposite.primary.src}
          alt={firstComposite.primary.alt}
          width={firstComposite.primary.width}
          height={firstComposite.primary.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div
      class="ecx-flow__cell ecx-flow__cell--media animate-on-scroll"
      data-animation="fadeInLeft"
    >
      <div class="ds-shot ecx-flow__shot">
        <img
          src={secondComposite.primary.src}
          alt={secondComposite.primary.alt}
          width={secondComposite.primary.width}
          height={secondComposite.primary.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <article
      class="ecx-flow__cell ecx-flow__cell--copy animate-on-scroll"
      data-animation="fadeInUp"
    >
      <h3 class="ecx-flow__cell-title">{secondOption.title}</h3>
      <p class="ecx-flow__cell-text">{secondOption.description}</p>
      <span class="ecx-flow__cell-note"><i></i>{secondOption.note}</span>
    </article>

    <span class="ecx-flow__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28">
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" />
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" />
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" />
      </svg>
    </span>
  </div>

  <slot />

  {note && <p class="ecx-flow__note">{note}</p>}
</section>

<style>
  /* Same band and quad measurements as the Event Registration spotlight. */
  .ecx-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 104px 24px;
    background: var(--ds-white);
  }

  .ecx-flow__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1040px;
    margin-bottom: 24px;
    text-align: center;
  }

  .ecx-flow__title {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    /* same ash ramp as the Event Registration spotlight title */
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .ecx-flow__subtitle {
    max-width: 640px;
    margin: 0;
    color: var(--subheading-gray, var(--ds-sub));
    font: 400 18px/1.5 var(--font-body);
  }

  .ecx-flow__quad {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* equal rows keep the divider at exactly 50%, where the notch sits */
    grid-template-rows: 1fr 1fr;
    width: 100%;
    max-width: 1180px;
    margin: 24px auto;
  }

  .ecx-flow__cross {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%);
    line-height: 0;
    pointer-events: none;
  }

  .ecx-flow__cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 260px;
    padding: 56px 48px;
    border-right: 1px solid var(--ds-surface-tab);
    border-bottom: 1px solid var(--ds-surface-tab);
  }

  .ecx-flow__cell:nth-child(2n) {
    border-right: none;
  }

  .ecx-flow__cell:nth-child(n + 3) {
    border-bottom: none;
  }

  .ecx-flow__cell--media {
    align-items: center;
    min-height: 360px;
    padding: 18px 22px;
    overflow: hidden;
  }

  .ecx-flow__cell-title {
    margin: 0 0 16px;
    color: var(--heading-dark, var(--ds-night-2));
    font: 700 clamp(24px, 2.6vw, 32px)/1.1 var(--font-heading);
    letter-spacing: -0.03em;
  }

  .ecx-flow__cell-text {
    max-width: 40ch;
    margin: 0;
    color: var(--subheading-gray, var(--ds-sub));
    font: 400 16px/1.6 var(--font-body);
  }

  .ecx-flow__cell-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: var(--ds-ink-2);
    font: 650 13px/1.4 var(--font-body);
  }

  .ecx-flow__cell-note i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .ecx-flow__note {
    max-width: 920px;
    margin: 28px auto 0;
    color: var(--ds-muted);
    font: 500 14px/1.6 var(--font-body);
    text-align: center;
  }

  @media (max-width: 960px) {
    .ecx-flow__cell {
      padding: 44px 32px;
    }
  }

  @media (max-width: 768px) {
    .ecx-flow {
      padding: 72px 16px;
    }
    .ecx-flow__quad {
      grid-template-columns: 1fr;
    }
    .ecx-flow__cross {
      display: none;
    }
    .ecx-flow__cell {
      min-height: 0;
      padding: 32px 20px;
      border-right: none;
      border-bottom: 1px solid var(--ds-surface-tab);
    }
    .ecx-flow__cell:nth-child(3) {
      order: 4;
      border-bottom: none;
    }
    .ecx-flow__cell:nth-child(4) {
      order: 3;
      border-bottom: 1px solid var(--ds-surface-tab);
    }
    .ecx-flow__cell--media {
      padding: 16px 20px 32px;
    }
  }

  /* ===== EventHex design system v5 overrides (tokens only) ===== */
  .ecx-flow--stage { background: var(--ds-g4-stage); }
  .ecx-flow__title { background: none; -webkit-text-fill-color: currentColor; color: var(--ds-ink); letter-spacing: -0.035em; }
  .ecx-flow__title .ds-hl { background-image: var(--ds-g1-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .ecx-flow__subtitle { color: var(--ds-body); }
  .ecx-flow__quad { gap: 24px; }
  .ecx-flow__cross { display: none; }
  .ecx-flow__cell, .ecx-flow__cell:nth-child(2n), .ecx-flow__cell:nth-child(n + 3) {
    border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl);
    background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow);
    -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur);
  }
  .ecx-flow:not(.ecx-flow--stage) .ecx-flow__cell { background: var(--ds-white); border-color: var(--ds-line); box-shadow: var(--ds-shadow-shot); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .ecx-flow__cell-title { font-weight: 500; letter-spacing: -0.025em; color: var(--ds-ink); }
  .ecx-flow__cell-text { color: var(--ds-body); }
  .ecx-flow__cell-note { color: var(--ds-sub); font-weight: 500; }
  .ecx-flow__cell--media { padding: 22px; }
  .ecx-flow__shot { width: 100%; }
  .ecx-flow__note { color: var(--ds-body); }
  @media (max-width: 768px) {
    .ecx-flow__cell, .ecx-flow__cell:nth-child(2n), .ecx-flow__cell:nth-child(n + 3), .ecx-flow__cell:nth-child(3), .ecx-flow__cell:nth-child(4) { border: 1px solid var(--ds-glass-edge); }
    .ecx-flow:not(.ecx-flow--stage) .ecx-flow__cell { border-color: var(--ds-line); }
  }
</style>
