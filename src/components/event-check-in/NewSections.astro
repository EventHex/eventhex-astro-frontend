---
// Sections for shipped check-in features the page did not mention (approved canvas copy, word for word).
interface Props { which: "A" | "B" | "C"; }
const { which } = Astro.props as Props;
const base = "/feature-images/event-check-in/v5/";
---

{which === "A" && (
  <section class="ecn ecn--light" id="attendance-rates" aria-labelledby="ecn-a-title">
    <div class="ecn__head">
      <h2 class="ds-h2" id="ecn-a-title">Check-in rate and no-show rate, <span class="ds-hl">without a spreadsheet</span></h2>
      <p class="ds-lead">The Attendance view in the dashboard shows how many people have checked in, how many are pending, the check-in rate and the no-show rate. Switch between Checked-in and Pending to Check, and export the list.</p>
    </div>
    <div class="ecn__duo">
      <figure class="ds-card ecn__panel">
        <div class="ds-shot"><img src={base + "cms-att-checked.webp"} width="2880" height="1250" loading="lazy" decoding="async" alt="CMS Attendance, Checked-in tab: 9 of 20 checked in, check-in rate 45%, no-show rate 55%" /></div>
        <figcaption class="ds-body">Checked-in tab: who arrived, with check-in time.</figcaption>
      </figure>
      <figure class="ds-card ecn__panel">
        <div class="ds-shot"><img src={base + "cms-att-pending.webp"} width="2880" height="1250" loading="lazy" decoding="async" alt="CMS Attendance, Pending to Check tab, with a Check-in button on each row" /></div>
        <figcaption class="ds-body">Pending to Check tab: who is still expected, with a Check-in button on each row.</figcaption>
      </figure>
    </div>
  </section>
)}

{which === "B" && (
  <section class="ecn ecn--light" id="registration-desk" aria-labelledby="ecn-b-title">
    <div class="ecn__split">
      <div class="ecn__copy">
        <h2 class="ds-h2" id="ecn-b-title">Check people in from the <span class="ds-hl">registration desk</span></h2>
        <p class="ds-lead">No phone needed. The Event Day Portal runs in the browser at the desk. Search a name, ticket, email or phone, tap Check in, and the card changes to Checked in while the counts on the home screen move.</p>
        <ul class="ecn__list">
          <li>Filters for All, Pending and Checked-In with live numbers</li>
          <li>Scan with a handheld barcode scanner or the device camera</li>
          <li>Search by name, ticket, email or phone</li>
        </ul>
      </div>
      <div class="ecn__stack">
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>ascend-impact-summit.eventhex.ai/event-day-portal</span></div>
          <video class="ecx-loop ecn__loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800" poster={base + "ci-scan-poster.webp"} aria-label="Animated demo: the Event Day Portal barcode scanner reads two attendee tickets and shows Attendance marked for Amara Okonkwo and Priya Raman">
            <source src={base + "ci-scan.webm"} type="video/webm" />
            <source src={base + "ci-scan.mp4"} type="video/mp4" />
          </video>
        </div>
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>ascend-impact-summit.eventhex.ai/event-day-portal</span></div>
          <video class="ecx-loop ecn__loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800" poster={base + "ci-badge-poster.webp"} aria-label="Animated demo: searching Priya in the Event Day Portal opens a badge preview with the QR code and a Print Badge button">
            <source src={base + "ci-badge.webm"} type="video/webm" />
            <source src={base + "ci-badge.mp4"} type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>
)}

{which === "C" && (
  <section class="ecn ds-night" id="scan-points" aria-labelledby="ecn-c-title">
    <div class="ecn__head">
      <h2 class="ds-h2" id="ecn-c-title">One scan point for each <span class="ds-hl-dark">meal, session or room</span></h2>
      <p class="ds-lead">Create an instance as General, Session or Meal / Break, choose who can use it, and watch its own check-in count and token order.</p>
    </div>
    <div class="ecn__split ecn__split--even">
      <div class="ds-glass-dark ecn__panel">
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>app.eventhex.ai/instance</span></div>
          <video class="ecx-loop ecn__loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800" poster={base + "ci-instance-poster.webp"} aria-label="Animated demo: the Instance list with Lunch, the Add Instance dialog with General, Session and Meal / Break types, and the Lunch instance check-in screen with token, name, phone, email, ticket and check-in time">
            <source src={base + "ci-instance.webm"} type="video/webm" />
            <source src={base + "ci-instance.mp4"} type="video/mp4" />
          </video>
        </div>
      </div>
      <div class="ecn__stack">
        <div class="ds-glass-dark ecn__panel">
          <div class="ds-shot"><img src={base + "cms-add-instance.webp"} width="1760" height="800" loading="lazy" decoding="async" alt="Add Instance dialog with General, Session and Meal / Break types" /></div>
        </div>
        <div class="ds-glass-dark ecn__panel ecn__types">
          <h3 class="ds-h3 ds-h3--sm">Three instance types</h3>
          <ul class="ecn__list">
            <li>General: for entrances and other general check-ins</li>
            <li>Session: for attendance at a scheduled session</li>
            <li>Meal / Break: for lunch, refreshments, or other meal access</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .ecn { padding: 104px 24px; }
  .ecn--light { background: var(--ds-white); }
  .ecn__head { max-width: 760px; margin: 0 auto 40px; text-align: center; display: flex; flex-direction: column; gap: 14px; }
  .ecn__head h2 { margin: 0; }
  .ecn__duo, .ecn__split { max-width: 1180px; margin: 0 auto; display: grid; gap: 24px; }
  .ecn__duo { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ecn__split { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; }
  .ecn__split--even { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 24px; align-items: start; }
  .ecn__panel { padding: 24px; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .ecn__panel figcaption { padding: 0 8px 8px; }
  .ecn__copy { display: flex; flex-direction: column; gap: 16px; }
  .ecn__copy h2 { margin: 0; }
  .ecn__stack { display: flex; flex-direction: column; gap: 24px; }
  .ecn__loop { display: block; width: 100%; height: auto; background: var(--ds-white); }
  .ecn__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; color: var(--ds-body); font: 400 15px/1.5 var(--ds-font-body); }
  .ecn__list li { display: flex; gap: 10px; }
  .ecn__list li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 8px; border-radius: 50%; background: var(--ds-blue); }
  .ds-night .ecn__list { color: var(--ds-on-night-body); }
  .ds-night .ecn__list li::before { background: var(--ds-on-night-accent); }
  .ecn__types h3 { margin: 0; }
  @media (max-width: 960px) {
    .ecn__split, .ecn__split--even { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 767px) {
    .ecn { padding: 72px 16px; }
    .ecn__duo { grid-template-columns: 1fr; }
    .ecn__panel { padding: 14px; }
  }
</style>
