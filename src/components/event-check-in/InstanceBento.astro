---
// Scanning-instance bento, borrowed from the Event Registration
// "Confirmations That Reach People" alternating product-evidence grid
// (event-registration.astro, .erg-bento-*): hairline stack with corner
// notches, alternating visual/content rows and a pastel shot stage per row
// holding a real EventHex portal screen.
interface Row {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  image: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}

interface Props {
  id: string;
}

const { id } = Astro.props;

const rows: Row[] = [
  {
    id: "meals",
    eyebrow: "F&B areas",
    title: "Meals and refreshments",
    body: "Confirm who received an included meal or entered an F&B area.",
    image: {
      src: "/feature-images/event-check-in/v5/cms-instance-list.webp",
      alt: "CMS Instance list: Lunch (General, All Tickets), Impact Measurement Workshop (Session, Delegate) and Speaker Dinner (General, Speaker)",
      width: 2880,
      height: 1300,
    },
  },
  {
    id: "sessions",
    eyebrow: "Ticket-based rooms",
    title: "Sessions and workshops",
    body: "Record entry for a ticket-based room or programmed activity.",
    image: {
      src: "/feature-images/event-check-in/v5/cms-add-instance.webp",
      alt: "CMS Add Instance dialog: Instance Details and Access Control steps, Instance Name, types General, Session, Meal / Break",
      width: 1760,
      height: 800,
    },
  },
  {
    id: "merchandise",
    eyebrow: "Configured items",
    title: "Merchandise collection",
    body: "Track whether an eligible attendee received the configured item.",
    image: {
      src: "/feature-images/event-check-in/v5/cms-instance-checkin.webp",
      alt: "CMS Instance Check-In for Lunch with the Download the Scanner app banner, 9 of 20 checked in, and a list with token, name, phone, email, ticket and check-in time",
      width: 2880,
      height: 1650,
    },
  },
  {
    id: "custom",
    eyebrow: "Custom activities",
    title: "Your own entitlement",
    body: "Name the instance for the activity your operations team needs to count.",
    image: {
      src: "/feature-images/event-check-in/v5/cms-add-instance.webp",
      alt: "CMS Add Instance dialog with the instance name field on the Instance Details step",
      width: 1760,
      height: 800,
    },
  },
];
---

<section class="ecx-bento" id={id} aria-labelledby={`${id}-heading`}>
  <div class="ecx-bento__container">
    <div class="ecx-bento__header animate-on-scroll" data-animation="fadeInUp">
      <h2 id={`${id}-heading`}>
        Use the scanner again after the
        <span class="ecx-bento__gradient">front door</span>
      </h2>
      <p class="ecx-bento__lead">
        Create a named scanning point, attach the ticket types that can use it, and track that
        activity independently from arrival check-in.
      </p>
    </div>

    <div class="ecx-bento__grid animate-on-scroll" data-animation="fadeInUp">
      <span class="ecx-bento__notch ecx-bento__notch--top" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)"></path>
        </svg>
      </span>
      <span class="ecx-bento__notch ecx-bento__notch--bottom" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)" transform="scale(1,-1)"></path>
        </svg>
      </span>

      {rows.map((row, index) => (
        <div class:list={["ecx-bento__row", index % 2 === 1 && "ecx-bento__row--reverse"]}>
          <div
            class:list={[
              "ecx-bento__cell",
              index % 2 === 1 ? "ecx-bento__content" : "ecx-bento__visual",
            ]}
          >
            {index % 2 === 1 ? (
              <>
                <span class="ecx-bento__eyebrow">{row.eyebrow}</span>
                <h3>{row.title}</h3>
                <p>{row.body}</p>
              </>
            ) : (
              <div class:list={["ecx-bento__stage", `ecx-bento__stage--${row.id}`]}>
                <img
                  class="ds-shot ecx-bento__shot"
                  src={row.image.src}
                  alt={row.image.alt}
                  width={row.image.width}
                  height={row.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>

          <div
            class:list={[
              "ecx-bento__cell",
              index % 2 === 1 ? "ecx-bento__visual" : "ecx-bento__content",
            ]}
          >
            {index % 2 === 1 ? (
              <div class:list={["ecx-bento__stage", `ecx-bento__stage--${row.id}`]}>
                <img
                  class="ds-shot ecx-bento__shot"
                  src={row.image.src}
                  alt={row.image.alt}
                  width={row.image.width}
                  height={row.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <>
                <span class="ecx-bento__eyebrow">{row.eyebrow}</span>
                <h3>{row.title}</h3>
                <p>{row.body}</p>
              </>
            )}
          </div>

          <span class="ecx-bento__cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--ds-line-strong)" transform="rotate(-90)"></path>
            </svg>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ecx-bento {
    padding: 80px 5%;
    background: transparent;
  }
  .ecx-bento__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ecx-bento__header {
    text-align: center;
    margin-bottom: 60px;
  }
  .ecx-bento__header h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ds-night-2);
  }
  .ecx-bento__gradient {
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .ecx-bento__lead {
    max-width: 760px;
    margin: 18px auto 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ds-muted);
  }

  .ecx-bento__grid {
    position: relative;
    border: 1px solid var(--ds-line-strong);
    border-radius: 16px;
    overflow: hidden;
    background: transparent;
  }
  .ecx-bento__notch {
    position: absolute;
    left: 50%;
    width: 28px;
    height: 28px;
    z-index: 2;
    line-height: 0;
    pointer-events: none;
  }
  .ecx-bento__notch--top {
    top: 0;
    transform: translate(-50%, -50%);
  }
  .ecx-bento__notch--bottom {
    bottom: 0;
    transform: translate(-50%, 50%);
  }

  .ecx-bento__row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--ds-line-strong);
  }
  .ecx-bento__row:last-child {
    border-bottom: none;
  }
  .ecx-bento__cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem;
  }
  .ecx-bento__row .ecx-bento__cell:first-child {
    border-right: 1px solid var(--ds-line-strong);
  }
  .ecx-bento__content {
    background: transparent;
  }
  .ecx-bento__visual {
    align-items: center;
    background: transparent;
  }
  .ecx-bento__visual > * {
    max-width: 100%;
    height: auto;
  }

  .ecx-bento__stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 32px 18px;
    border-radius: 22px;
  }
  .ecx-bento__stage--meals {
    background: linear-gradient(180deg, var(--ds-warning-soft) 0%, var(--ds-warning-soft) 45%, var(--ds-surface) 100%);
  }
  .ecx-bento__stage--sessions {
    background: linear-gradient(180deg, var(--ds-cat-teal-bg) 0%, var(--ds-surface-tab) 45%, var(--ds-surface) 100%);
  }
  .ecx-bento__stage--merchandise {
    background: linear-gradient(180deg, var(--ds-surface-tint) 0%, var(--ds-surface-tab) 45%, var(--ds-surface) 100%);
  }
  .ecx-bento__stage--custom {
    background: linear-gradient(180deg, var(--ds-line-strong) 0%, var(--ds-surface-tab) 45%, var(--ds-surface) 100%);
  }
  .ecx-bento__shot {
    display: block;
    width: 100%;
    border: 1px solid var(--ds-line-strong);
    border-radius: 14px;
    background: var(--ds-white);
  }


  .ecx-bento__cross {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 28px;
    height: 28px;
    z-index: 2;
    transform: translate(-50%, 50%);
    line-height: 0;
    pointer-events: none;
  }
  .ecx-bento__row:last-child .ecx-bento__cross {
    display: none;
  }

  .ecx-bento__eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: var(--ds-cat-violet);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .ecx-bento__content h3 {
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ds-night-2);
  }
  .ecx-bento__content p {
    margin-bottom: 1rem;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--ds-sub);
  }
  .ecx-bento__content p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .ecx-bento__row {
      display: flex;
      flex-direction: column;
    }
    .ecx-bento__cell {
      padding: 3rem 1.5rem;
    }
    .ecx-bento__row .ecx-bento__cell:first-child {
      border-right: none;
    }
    .ecx-bento__content {
      order: 1;
      border-bottom: 1px solid var(--ds-line-strong);
    }
    .ecx-bento__visual {
      order: 2;
    }
  }

  @media (max-width: 620px) {
    .ecx-bento {
      padding: 64px 20px;
    }
    .ecx-bento__header {
      margin-bottom: 40px;
    }
    .ecx-bento__cell {
      padding: 2.5rem 1.25rem;
    }
    .ecx-bento__content h3 {
      font-size: 1.75rem;
    }
    .ecx-bento__content p {
      font-size: 1rem;
    }
    .ecx-bento__stage {
      padding: 20px 12px;
      border-radius: 18px;
    }
  }

  /* ===== EventHex design system v5 overrides (tokens only) ===== */
  .ecx-bento { background: var(--ds-white); }
  .ecx-bento__header h2 { color: var(--ds-ink); letter-spacing: -0.035em; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.1; }
  .ecx-bento__gradient { background: var(--ds-g1-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .ecx-bento__lead { color: var(--ds-body); }
  .ecx-bento__grid { border-color: var(--ds-line); border-radius: var(--ds-r-xl); box-shadow: var(--ds-shadow-shot); }
  .ecx-bento__row { border-bottom-color: var(--ds-line); }
  .ecx-bento__notch, .ecx-bento__cross { display: none; }
  .ecx-bento__eyebrow { color: var(--ds-blue); font-weight: 500; letter-spacing: 0.01em; text-transform: none; font-size: 14px; }
  .ecx-bento__content h3 { font-weight: 500; letter-spacing: -0.025em; color: var(--ds-ink); line-height: 1.15; }
  .ecx-bento__content p { color: var(--ds-body); }
  .ecx-bento__shot { border-color: var(--ds-line-strong); box-shadow: var(--ds-shadow-shot); }
</style>
