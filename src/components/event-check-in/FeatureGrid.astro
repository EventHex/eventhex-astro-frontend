---
// Grid family borrowed two ways from Event Registration:
//   variant="number" -> bordered capability grid with indexed cells
//   variant="icon"   -> hairline use-case row with small line icons
interface Item {
  title: string;
  desc: string;
  icon?: "meal" | "session" | "merch" | "custom";
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  variant: "number" | "icon";
  items: Item[];
}

const { id, eyebrow, title, lede, variant, items } = Astro.props;

const icons: Record<NonNullable<Item["icon"]>, string> = {
  meal: '<path d="M5 3v7a2 2 0 0 0 2 2 2 2 0 0 0 2-2V3"></path><path d="M7 12v9"></path><path d="M17 3c-1.2 1.2-1.8 2.6-1.8 4.2S15.8 10.4 17 11.6V21"></path>',
  session: '<rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path>',
  merch: '<path d="M4 8h16l-1.2 12H5.2L4 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>',
  custom: '<circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path>',
};
---

<section class={`ecx-grid ecx-grid--${variant}`} id={id} aria-labelledby={`${id}-heading`}>
  <header class="ecx-grid__header">
    <span>{eyebrow}</span>
    <h2 id={`${id}-heading`}>{title}</h2>
    {lede && <p>{lede}</p>}
  </header>

  <div class="ecx-grid__cells">
    {items.map((item, index) => (
      <article
        class="ecx-grid__cell animate-on-scroll"
        data-animation="fadeInUp"
        data-delay={String(index * 60)}
      >
        {variant === "number" ? (
          <span class="ecx-grid__num">{String(index + 1).padStart(2, "0")}</span>
        ) : (
          <span class="ecx-grid__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={icons[item.icon ?? "custom"]}></svg>
          </span>
        )}
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .ecx-grid {
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: 104px 0;
  }

  .ecx-grid__header {
    max-width: 850px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .ecx-grid__header > span {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--brand-blue);
    font: 650 13px/1.3 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ecx-grid__header h2 {
    margin: 0;
    color: var(--heading-dark);
    font: 500 clamp(36px, 4.6vw, 56px)/1.05 var(--font-heading);
    letter-spacing: -0.045em;
  }

  .ecx-grid__header p {
    max-width: 720px;
    margin: 20px auto 0;
    color: var(--subheading-gray);
    font: 400 17px/1.65 var(--font-body);
  }

  .ecx-grid__cell h3 {
    margin: 0 0 12px;
    color: var(--heading-dark);
    font: 500 23px/1.15 var(--font-heading);
    letter-spacing: -0.02em;
  }

  .ecx-grid__cell p {
    margin: 0;
    color: var(--subheading-gray);
    font: 400 14px/1.6 var(--font-body);
  }

  /* variant: number -> bordered capability grid */
  .ecx-grid--number .ecx-grid__cells {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid var(--surface-card-border);
    border-radius: 24px;
    background: #fff;
  }

  .ecx-grid--number .ecx-grid__cell {
    min-height: 240px;
    padding: 34px 30px;
    border-right: 1px solid var(--surface-card-border);
    border-bottom: 1px solid var(--surface-card-border);
  }

  .ecx-grid--number .ecx-grid__cell:nth-child(3n) { border-right: 0; }
  .ecx-grid--number .ecx-grid__cell:nth-child(n + 4) { border-bottom: 0; }

  .ecx-grid__num {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    margin-bottom: 28px;
    border: 1px solid #e0e5ed;
    border-radius: 12px;
    color: var(--brand-blue);
    font: 700 13px/1 var(--font-body);
    letter-spacing: 0.04em;
  }

  /* variant: icon -> hairline use-case row */
  .ecx-grid--icon .ecx-grid__cells {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #e2e8f2;
  }

  .ecx-grid--icon .ecx-grid__cell {
    min-height: 300px;
    padding: 34px 28px;
    border-left: 1px solid #e2e8f2;
  }

  .ecx-grid--icon .ecx-grid__cell:first-child { border-left: 0; }

  .ecx-grid--icon .ecx-grid__icon {
    display: inline-flex;
    width: 30px;
    height: 30px;
    margin-bottom: 34px;
    color: #315dff;
  }

  .ecx-grid--icon .ecx-grid__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ecx-grid--icon .ecx-grid__cell h3 {
    max-width: 230px;
    margin-bottom: 20px;
  }

  @media (max-width: 960px) {
    .ecx-grid--number .ecx-grid__cells { grid-template-columns: repeat(2, 1fr); }
    .ecx-grid--number .ecx-grid__cell:nth-child(3n) { border-right: 1px solid var(--surface-card-border); }
    .ecx-grid--number .ecx-grid__cell:nth-child(2n) { border-right: 0; }
    .ecx-grid--number .ecx-grid__cell:nth-child(n + 4) { border-bottom: 1px solid var(--surface-card-border); }
    .ecx-grid--number .ecx-grid__cell:nth-child(n + 5) { border-bottom: 0; }

    .ecx-grid--icon .ecx-grid__cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ecx-grid--icon .ecx-grid__cell:nth-child(odd) { border-left: 0; }
    .ecx-grid--icon .ecx-grid__cell:nth-child(n + 3) { border-top: 1px solid #e2e8f2; }
  }

  @media (max-width: 767px) {
    .ecx-grid { width: min(100% - 32px, 1140px); padding: 72px 0; }
    .ecx-grid__header h2 { font-size: 34px; }
    .ecx-grid__header p { font-size: 15px; }
    .ecx-grid__header { margin-bottom: 36px; }

    .ecx-grid--number .ecx-grid__cells { grid-template-columns: 1fr; }
    .ecx-grid--number .ecx-grid__cell,
    .ecx-grid--number .ecx-grid__cell:nth-child(2n),
    .ecx-grid--number .ecx-grid__cell:nth-child(n + 5) {
      min-height: 0;
      padding: 28px 22px;
      border-right: 0;
      border-bottom: 1px solid var(--surface-card-border);
    }
    .ecx-grid--number .ecx-grid__cell:last-child { border-bottom: 0; }
    .ecx-grid__num { margin-bottom: 20px; }

    .ecx-grid--icon .ecx-grid__cells { grid-template-columns: 1fr; }
    .ecx-grid--icon .ecx-grid__cell {
      min-height: 0;
      padding: 30px 4px;
      border-left: 0;
      border-top: 1px solid #e2e8f2;
    }
    .ecx-grid--icon .ecx-grid__cell:first-child { border-top: 0; }
    .ecx-grid--icon .ecx-grid__icon { margin-bottom: 22px; }
    .ecx-grid--icon .ecx-grid__cell h3 { max-width: none; margin-bottom: 14px; }
  }
</style>
