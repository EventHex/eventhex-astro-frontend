---
// Numbered workflow accordion, borrowed from the Speaker Management
// "From call for papers to published program" section
// (components/speaker-management/ProgramContentSections.astro, section="cfp"):
// a centred gradient headline over an ordered list of numbered rows that expand
// into a plain-language point list beside a product view.
//
// All copy comes from the supplied content deck; each row pairs with a real
// organizer screenshot.
interface Point {
  title: string;
  desc: string;
}

interface AttendanceStep {
  title: string;
  desc: string;
  points: Point[];
  shot: { src: string; width: number; height: number; alt: string };
  note: string;
}

const steps: AttendanceStep[] = [
  {
    title: "Read the arrival state",
    desc: "Checked-in, registered, and pending state remains visible.",
    points: [
      {
        title: "Checked in",
        desc: "See accepted attendance for the selected event or scan point.",
      },
      {
        title: "Registered",
        desc: "Keep the full eligible population visible.",
      },
      {
        title: "Pending",
        desc: "Understand who has not yet checked in.",
      },
    ],
    shot: { src: "/feature-images/event-check-in/v5/cms-attendance.webp", width: 2880, height: 1500, alt: "CMS Attendance: No of check-in 9 / 20, Pending 11, Check-in rate 45%, No-show rate 55%, with a checked-in list showing check-in times" },
    note: "Kept for the selected event or scan point",
  },
  {
    title: "Filter the count the question asks for",
    desc: "Review arrival by ticket or participant group, and separate entrance attendance from another scanning point.",
    points: [
      {
        title: "Ticket filter",
        desc: "Review arrival by ticket or participant group.",
      },
      {
        title: "Instance filter",
        desc: "Separate entrance attendance from a meal, session, or other scanning point.",
      },
    ],
    shot: { src: "/feature-images/event-check-in/v5/portal-home.webp", width: 2220, height: 1160, alt: "Event Day Portal home with 26 total users, 8 checked in and 18 remaining, Scan Badge and Search Attendees" },
    note: "Arrival by ticket or by scanning point",
  },
  {
    title: "Open the record behind the number",
    desc: "The summary answers how many; the record answers who.",
    points: [
      {
        title: "Attendance records",
        desc: "Review the attendee, scan type, time, and related event context available to operations.",
      },
    ],
    shot: { src: "/feature-images/event-check-in/v5/portal-attendance.webp", width: 2880, height: 1500, alt: "Event Day Portal attendance list: Checked in and Check in states per attendee with Pending 18 and Checked-In 8 filters" },
    note: "The detail behind each attendance entry",
  },
];
---

<section class="ecx-att" id="attendance" aria-labelledby="attendance-heading">
  <div class="ecx-att__inner">
    <header class="ecx-att__header">
      <span class="ecx-att__eyebrow">Live attendance visibility</span>
      <div class="ecx-att__heading">
        <h2 id="attendance-heading">See who has arrived&#8212;<span class="ecx-att__hl">and who is still expected</span></h2>
      </div>
      <p class="ecx-att__lead">
        Keep arrival state connected to the same registration and ticket records used
        before the event.
      </p>
    </header>

    <ol class="ecx-att__steps">
      {
        steps.map((step, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span class="ecx-att__num">0{index + 1}</span>
                <div class="ecx-att__step-content">
                  <h3 class="ecx-att__step-title">{step.title}</h3>
                  <p class="ecx-att__step-desc">{step.desc}</p>
                  <ul class="ecx-att__points">
                    {step.points.map((point) => (
                      <li>
                        <i aria-hidden="true">&#10022;</i>
                        <span class="ecx-att__point">
                          <strong>{point.title}</strong>
                          <span>{point.desc}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                <button
                  type="button"
                  class="ecx-att__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" />
                  </svg>
                </button>
              </summary>

              <div class="ecx-att__visual">
                <div class="ds-shot ecx-att__shot">
                  <img src={step.shot.src} alt={step.shot.alt} width={step.shot.width} height={step.shot.height} loading="lazy" decoding="async" />
                </div>
                <p class="ecx-att__note">{step.note}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".ecx-att__steps details").forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".ecx-att__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} step`);
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<style>
  .ecx-att {
    padding: clamp(110px, 12vw, 160px) 24px;
    background: transparent;
  }

  .ecx-att__inner {
    width: min(1218px, 100%);
    margin: 0 auto;
  }

  .ecx-att__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 64px;
    text-align: center;
  }

  .ecx-att__eyebrow {
    display: block;
    color: var(--ds-cat-indigo);
    font: 700 13px/1.3 var(--font-body);
    letter-spacing: 0.08em;
  }

  .ecx-att__heading {
    max-width: 820px;
    margin-inline: auto;
  }

  .ecx-att__heading h2 {
    max-width: 780px;
    margin: 0 auto;
    font-family: var(--font-heading);
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .ecx-att__lead {
    max-width: 720px;
    margin: 0 auto;
    color: var(--subheading-gray);
    font: 400 17px/1.65 var(--font-body);
  }

  /* Numbered rows */
  .ecx-att__steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 0;
  }

  .ecx-att__steps > li {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .ecx-att__steps details {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ecx-att-border);
    border-radius: 18px;
    background: linear-gradient(135deg, var(--ecx-att-tint) 0%, var(--ds-white) 82%);
    box-shadow: 0 8px 24px rgba(31, 41, 55, 0.04);
    transition:
      border-radius 0.35s ease,
      background 0.35s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .ecx-att__steps details:not([open]):hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(31, 41, 55, 0.08);
  }

  .ecx-att__steps summary {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    min-height: 82px;
    padding: 18px 82px 18px 20px;
    cursor: pointer;
    list-style: none;
    transition: background 0.25s ease;
  }

  .ecx-att__steps summary::-webkit-details-marker {
    display: none;
  }

  .ecx-att__steps summary:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .ecx-att__num {
    display: block;
    color: var(--ds-night-2);
    font: 500 15px/1.1 var(--font-heading);
    letter-spacing: -0.05em;
  }

  .ecx-att__step-content {
    display: flex;
    flex-direction: column;
  }

  .ecx-att__step-title {
    margin: 0;
    color: var(--ds-night-2);
    font: 500 22px/1.2 var(--font-body);
    letter-spacing: -0.02em;
  }

  .ecx-att__step-desc {
    display: none;
  }

  .ecx-att__steps details:not([open]) .ecx-att__step-content {
    display: grid;
    grid-template-columns: minmax(230px, 0.7fr) minmax(320px, 1.3fr);
    align-items: center;
    gap: 36px;
  }

  .ecx-att__steps details:not([open]) .ecx-att__step-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    max-width: 460px;
    margin: 0;
    color: var(--ds-muted);
    font: 400 14.5px/1.5 var(--font-body);
  }

  .ecx-att__points {
    display: none;
  }

  .ecx-att__arrow {
    position: absolute;
    top: 24px;
    right: 28px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid rgba(17, 24, 39, 0.2);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.78);
    color: var(--ds-night-2);
    cursor: pointer;
    transition:
      transform 0.25s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .ecx-att__arrow:hover {
    border-color: rgba(17, 24, 39, 0.42);
    background: var(--ds-white);
  }

  .ecx-att__arrow:focus-visible {
    outline: 3px solid rgba(59, 130, 246, 0.28);
    outline-offset: 2px;
  }

  .ecx-att__arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Open row */
  .ecx-att__steps details[open] {
    display: flex;
    align-items: stretch;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--ecx-att-tint) 0%, var(--ds-white) 72%);
    margin: 0;
  }

  .ecx-att__steps details[open] .ecx-att__arrow {
    top: 28px;
    transform: rotate(180deg);
  }

  .ecx-att__steps details[open] summary {
    flex: 0 0 55%;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    min-height: 0;
    padding: 64px 40px 64px 28px;
    background: transparent;
  }

  .ecx-att__steps details[open] .ecx-att__num {
    font-size: 26px;
    line-height: 1;
    color: var(--ds-black);
  }

  .ecx-att__steps details[open] .ecx-att__step-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--ds-black);
  }

  .ecx-att__steps details[open] .ecx-att__step-desc {
    display: block;
    max-width: 90%;
    margin: 0 0 32px;
    color: var(--ds-ink-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .ecx-att__steps details[open] .ecx-att__points {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ecx-att__steps details[open] .ecx-att__points li {
    display: flex;
    align-items: center;
    gap: 14px;
    border: none;
    padding: 0;
    background: transparent;
    color: var(--ds-night-2);
    font-size: 16px;
    font-weight: 500;
  }

  .ecx-att__steps details[open] .ecx-att__points li i {
    font-size: 16px;
    font-style: normal;
  }

  .ecx-att__point {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .ecx-att__point strong {
    font-weight: 600;
  }

  .ecx-att__point span {
    color: var(--ds-muted);
    font-weight: 400;
  }

  /* Per-row tints, first three from the source sequence */
  .ecx-att__steps > li:nth-child(1) {
    --ecx-att-tint: var(--ds-warning-soft);
    --ecx-att-border: var(--ds-line-strong);
  }
  .ecx-att__steps > li:nth-child(2) {
    --ecx-att-tint: var(--ds-surface);
    --ecx-att-border: var(--ds-cat-sky-bg);
  }
  .ecx-att__steps > li:nth-child(3) {
    --ecx-att-tint: var(--ds-surface-tab);
    --ecx-att-border: var(--ds-surface-tint);
  }

  /* Product view beside the open row */
  .ecx-att__visual {
    display: none;
    margin: 0;
    opacity: 0;
  }

  .ecx-att__steps details[open] .ecx-att__visual {
    flex: 0 0 45%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding: 40px 88px 40px 0;
    opacity: 1;
  }















  .ecx-att__note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ds-muted);
  }

  @media (max-width: 960px) {
    .ecx-att__steps details:not([open]) .ecx-att__step-content {
      grid-template-columns: minmax(200px, 0.8fr) minmax(240px, 1.2fr);
      gap: 24px;
    }
  }

  @media (max-width: 620px) {
    .ecx-att {
      padding: 68px 20px;
    }
    .ecx-att__header {
      margin-bottom: 46px;
    }
    .ecx-att__heading h2 {
      font-size: 42px;
    }
    .ecx-att__steps summary,
    .ecx-att__steps summary:hover {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 10px;
      min-height: 96px;
      padding: 18px 62px 18px 14px;
    }
    .ecx-att__arrow {
      top: 31px;
      right: 16px;
    }
    .ecx-att__num {
      font-size: 13px;
    }
    .ecx-att__steps details:not([open]) .ecx-att__step-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }
    .ecx-att__steps details:not([open]) .ecx-att__step-desc {
      font-size: 13px;
      line-height: 1.4;
    }
    .ecx-att__step-title {
      font-size: 18px;
    }
    .ecx-att__steps details[open] {
      flex-direction: column;
    }
    .ecx-att__steps details[open] summary,
    .ecx-att__steps details[open] summary:hover {
      flex: none;
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 10px;
      padding: 34px 62px 24px 14px;
    }
    .ecx-att__steps details[open] .ecx-att__arrow {
      top: 24px;
      right: 16px;
    }
    .ecx-att__steps details[open] .ecx-att__num {
      font-size: 21px;
    }
    .ecx-att__steps details[open] .ecx-att__step-title {
      font-size: 26px;
    }
    .ecx-att__steps details[open] .ecx-att__step-desc {
      max-width: 100%;
      margin-bottom: 24px;
      font-size: 16px;
    }
    .ecx-att__steps details[open] .ecx-att__points li {
      align-items: flex-start;
      font-size: 15px;
    }
    .ecx-att__steps details[open] .ecx-att__visual {
      flex: none;
      padding: 0 24px 28px;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ecx-att__steps details,
    .ecx-att__arrow {
      transition: none;
    }
  }

  /* ===== EventHex design system v5 overrides (tokens only) ===== */
  .ecx-att { background: var(--ds-g4-stage); }
  .ecx-att__eyebrow { color: var(--ds-blue); font-weight: 500; letter-spacing: 0.01em; font-size: 14px; }
  .ecx-att__heading h2 { background: none; -webkit-text-fill-color: currentColor; color: var(--ds-ink); letter-spacing: -0.035em; line-height: 1.1; font-size: clamp(34px, 4vw, 48px); }
  .ecx-att__hl { background-image: var(--ds-g1-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .ecx-att__lead { color: var(--ds-body); }
  .ecx-att__steps details, .ecx-att__steps details[open] {
    background: var(--ds-glass-fill); border-color: var(--ds-glass-edge); box-shadow: var(--ds-glass-shadow);
    -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur);
  }
  .ecx-att__steps details[open] .ecx-att__step-title { font-weight: 500; color: var(--ds-ink); }
  .ecx-att__steps details[open] .ecx-att__num { color: var(--ds-blue); }
  .ecx-att__shot { width: 100%; }
</style>
