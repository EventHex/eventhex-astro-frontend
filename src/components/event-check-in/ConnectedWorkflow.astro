---
// Related-feature links, built on the Event Registration
// "Built for Every Kind of Sign-Up" grid: a centred gradient headline over a
// bordered four-column rail with notches at the column joins, one icon, a
// two-line title and a short description per column.
//
// The source turns only the title into a link. These four columns are a
// navigation grid, so the whole card stays an anchor and keeps a restrained
// hover treatment; every other measure follows the source section.
const links = [
  [
    "/event-registration/",
    "Event Registration",
    "Collect the attendee details and create the confirmed record used at the door.",
  ],
  [
    "/event-ticketing/",
    "Event Ticketing",
    "Configure the ticket, access, and QR delivery path.",
  ],
  [
    "/badge-certificate-designer/",
    "Badge & Certificate Designer",
    "Design the badge and certificate outputs used around the event journey.",
  ],
  [
    "/event-analytics/",
    "Event Analytics",
    "Review the supported registration and attendance signals after the event.",
  ],
];
---

<section class="ecx-links" id="connected-workflow" aria-labelledby="connected-workflow-heading">
  <div class="ecx-links__inner">
    <header class="ecx-links__header">
      <span>Connected event-day workflow</span>
      <h2 id="connected-workflow-heading">Continue into the job that owns the detail</h2>
      <p>Check-in validates arrival; these routes cover what comes before or after it.</p>
    </header>

    <div class="ecx-links__grid">
      <span class="ecx-links__notch ecx-links__notch--1" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path>
        </svg>
      </span>
      <span class="ecx-links__notch ecx-links__notch--2" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path>
        </svg>
      </span>
      <span class="ecx-links__notch ecx-links__notch--3" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path>
        </svg>
      </span>
      {links.map(([href, title, description], index) => (
        <a
          href={href}
          class="ecx-links__card animate-on-scroll"
          data-animation="fadeInUp"
          data-delay={String(index * 60)}
        >
          {index === 2 && (
            <span class="ecx-links__cross" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="scale(1,-1)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(90)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(-90)"></path>
              </svg>
            </span>
          )}
          <span class="ecx-links__icon" aria-hidden="true">
            {index === 0 && (
              <svg viewBox="0 0 24 24">
                <rect x="8" y="2" width="8" height="4" rx="1"></rect>
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <path d="M9 12h6M9 16h4"></path>
              </svg>
            )}
            {index === 1 && (
              <svg viewBox="0 0 24 24">
                <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
                <path d="M13 5v2M13 11v2M13 17v2"></path>
              </svg>
            )}
            {index === 2 && (
              <svg viewBox="0 0 24 24">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <circle cx="9" cy="11" r="2"></circle>
                <path d="M6.2 15.5a3 3 0 0 1 5.6 0"></path>
                <path d="M16 10h2M16 14h2"></path>
              </svg>
            )}
            {index === 3 && (
              <svg viewBox="0 0 24 24">
                <path d="M3 20h18"></path>
                <path d="M6 20v-6M11 20V7M16 20v-9"></path>
              </svg>
            )}
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Mirrors the Event Registration "Built for Every Kind of Sign-Up" section. */
  .ecx-links {
    padding: clamp(90px, 10vw, 140px) 24px clamp(82px, 9vw, 116px);
    background:
      radial-gradient(circle at 8% 25%, rgba(232, 237, 255, 0.8), transparent 42%),
      radial-gradient(circle at 94% 72%, rgba(245, 238, 255, 0.75), transparent 44%),
      #fff;
  }

  .ecx-links__inner {
    width: min(1140px, 100%);
    margin: 0 auto;
  }

  .ecx-links__header {
    margin: 0 auto 64px;
    text-align: center;
  }

  .ecx-links__header > span {
    display: inline-block;
    margin-bottom: 18px;
    color: var(--brand-blue);
    font: 650 13px/1.3 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* same gradient headline treatment as the Event Registration use-case grid */
  .ecx-links__header h2 {
    max-width: 900px;
    margin: 0 auto;
    background: linear-gradient(98deg, #182132 43%, #8f8f8f 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font: 500 clamp(32px, 4vw, 56px)/1.05 var(--font-heading);
    letter-spacing: -0.04em;
  }

  .ecx-links__header p {
    max-width: 720px;
    margin: 22px auto 0;
    color: var(--subheading-gray);
    font: 400 1.04rem/1.7 var(--font-body);
  }

  .ecx-links__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #e2e8f2;
  }

  .ecx-links__notch {
    position: absolute;
    top: 0;
    width: 28px;
    height: 28px;
    line-height: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .ecx-links__notch--1 { left: 25%; }
  .ecx-links__notch--2 { left: 50%; }
  .ecx-links__notch--3 { left: 75%; }

  .ecx-links__cross {
    display: none;
  }

  .ecx-links__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 326px;
    padding: 30px 28px;
    border-left: 1px solid #e2e8f2;
    color: inherit;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .ecx-links__card:first-of-type {
    border-left: 0;
  }

  .ecx-links__card:hover {
    background: #f8f9ff;
    transform: translateY(-4px);
  }

  .ecx-links__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-bottom: 34px;
    color: #315dff;
  }

  .ecx-links__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ecx-links__card h3 {
    max-width: 230px;
    /* Hold two lines so the copy below every column starts on the same baseline. */
    min-height: 2.5em;
    margin: 0 0 26px;
    color: #27334d;
    font: 500 21px/1.25 var(--font-heading);
  }

  .ecx-links__card p {
    margin: 14px 0 0;
    color: #68738a;
    font: 400 15.5px/1.45 var(--font-body);
  }

  @media (max-width: 900px) {
    .ecx-links__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ecx-links__notch--1,
    .ecx-links__notch--3 {
      display: none;
    }

    .ecx-links__card:nth-of-type(odd) {
      border-left: none;
    }

    .ecx-links__card:nth-of-type(n + 3) {
      border-top: 1px solid #e2e8f2;
    }

    .ecx-links__cross {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 28px;
      height: 28px;
      line-height: 0;
      pointer-events: none;
      transform: translate(50%, -50%);
      z-index: 2;
    }
  }

  @media (max-width: 600px) {
    .ecx-links {
      padding: 60px 20px 82px;
    }

    .ecx-links__header {
      margin-bottom: 44px;
    }

    .ecx-links__header p {
      font-size: 15px;
    }

    .ecx-links__grid {
      grid-template-columns: 1fr;
    }

    .ecx-links__card {
      min-height: 0;
      padding: 24px 20px;
      border-left: none;
      border-top: 1px solid #e2e8f2;
    }

    .ecx-links__card:first-of-type {
      border-top: none;
    }

    .ecx-links__card h3 {
      min-height: 0;
    }

    .ecx-links__cross,
    .ecx-links__notch--2 {
      display: none;
    }
  }
</style>
