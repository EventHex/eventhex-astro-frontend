---
// Instance setup-to-report sequence, borrowed from the Speaker Management
// "Built for the events that are hardest to coordinate" tab suite
// (DeckSections.astro, section="use-cases"): pill tablist, tinted two-column
// panel with a point-wise checklist and a labelled product showcase.
interface Props {
  id: string;
}

const { id } = Astro.props;

const steps = [
  {
    id: "create",
    tab: "Create an instance",
    title: "Create an instance",
    description: "Name the meal, session, merchandise point, or activity.",
    checklist: [
      "A named scan point",
      "Tracked separately from front-door arrival",
      "Used for meals, sessions, or merchandise",
    ],
    image: {
      src: "/feature-images/event-check-in/add-instance.png",
      alt: "EventHex Add Instance dialog with the instance name field on the instance details step",
      width: 606,
      height: 216,
    },
    visualLabel: "Instance named",
  },
  {
    id: "tickets",
    tab: "Attach ticket types",
    title: "Attach ticket types",
    description: "Choose which registrations are eligible for that point.",
    checklist: [
      "Eligible ticket types per instance",
      "Eligibility checked for the selected instance",
      "Uniqueness scoped to the instance",
    ],
    image: {
      src: "/feature-images/event-check-in/instance-list.png",
      alt: "EventHex scanning instance list showing instance names, applicable tickets and edit actions",
      width: 762,
      height: 300,
    },
    visualLabel: "Eligible tickets linked",
  },
  {
    id: "scanner",
    tab: "Open it in Scanner",
    title: "Open it in Scanner",
    description: "Staff select the instance that appears for the event.",
    checklist: [
      "Choose the event or the instance",
      "The usual Scanner check-in flow",
      "Scan mode stays on the selected point",
    ],
    image: {
      src: "/feature-images/event-check-in/instance-checkin.png",
      alt: "EventHex instance check-in screen with scan count, filter toolbar and Name, Phone Number, Email ID, Token and Status columns",
      width: 761,
      height: 262,
    },
    visualLabel: "Scanner instance mode",
  },
  {
    id: "count",
    tab: "Review the count",
    title: "Review the count",
    description: "See attendance and duplicate state for that instance.",
    checklist: [
      "Instance-specific attendance",
      "Duplicate state for the instance",
      "Kept apart from arrival check-in",
    ],
    image: {
      src: "/feature-images/event-check-in/attendance-overview.png",
      alt: "EventHex attendance view listing check-in totals per instance with export controls",
      width: 761,
      height: 215,
    },
    visualLabel: "Per-instance count",
  },
];
---

<section class="ecx-iflow" id={id} aria-labelledby={`${id}-heading`}>
  <div class="ecx-iflow__inner">
    <header class="ecx-iflow__header">
      <h2 id={`${id}-heading`} class="ecx-iflow__title animate-on-scroll" data-animation="fadeInUp">
        <span class="ecx-iflow__title-line">Define the point once.</span>
        <span class="ecx-iflow__title-line">Give staff the right scan mode.</span>
      </h2>
      <p class="ecx-iflow__subtitle animate-on-scroll" data-animation="fadeInUp">
        The selected instance controls eligibility and keeps its attendance separate.
      </p>
    </header>

    <div
      class="ecx-iflow__tabs animate-on-scroll"
      data-animation="fadeInUp"
      role="tablist"
      aria-label="How scanning instances work"
    >
      {steps.map((step, index) => (
        <button
          type="button"
          class:list={["ecx-iflow__tab", index === 0 && "ecx-iflow__tab--active"]}
          role="tab"
          id={`iflow-tab-${step.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`iflow-panel-${step.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-target={step.id}
        >
          {step.tab}
        </button>
      ))}
    </div>

    <div class="ecx-iflow__box animate-on-scroll" data-animation="fadeInUp">
      {steps.map((step, index) => (
        <div
          class:list={["ecx-iflow__panel", index === 0 && "ecx-iflow__panel--active"]}
          id={`iflow-panel-${step.id}`}
          role="tabpanel"
          aria-labelledby={`iflow-tab-${step.id}`}
          data-panel={step.id}
        >
          <div class="ecx-iflow__left">
            <h3 class="ecx-iflow__panel-title">{step.title}</h3>
            <p class="ecx-iflow__panel-desc">{step.description}</p>

            <ul class="ecx-iflow__checklist">
              {step.checklist.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="ecx-iflow__right">
            <div class="ecx-iflow__showcase">
              <img
                src={step.image.src}
                alt={step.image.alt}
                width={step.image.width}
                height={step.image.height}
                loading="lazy"
                decoding="async"
              />
              <span class:list={["ecx-iflow__visual-label", `ecx-iflow__visual-label--${step.id}`]}>
                {step.id === "create" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="M12 8.5v7M8.5 12h7"></path></svg>
                )}
                {step.id === "tickets" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-6Z"></path></svg>
                )}
                {step.id === "scanner" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"></path><path d="M8 12h8"></path></svg>
                )}
                {step.id === "count" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V11M12 19V5M19 19v-6"></path></svg>
                )}
                {step.visualLabel}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const suite = document.querySelector(".ecx-iflow");
    if (!suite) return;

    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".ecx-iflow__tab"));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>(".ecx-iflow__panel"));
    let rotationId: number | undefined;

    const activateTab = (tab: HTMLButtonElement) => {
      const targetId = tab.getAttribute("data-target");

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("ecx-iflow__tab--active", active);
        item.setAttribute("aria-selected", active ? "true" : "false");
        item.setAttribute("tabindex", active ? "0" : "-1");
      });

      panels.forEach((panel) => {
        panel.classList.toggle("ecx-iflow__panel--active", panel.id === `iflow-panel-${targetId}`);
      });
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      rotationId = window.setInterval(() => {
        const currentIndex = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateTab(tabs[(currentIndex + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activateTab(tab);
        startRotation();
      });
    });

    startRotation();
  });
</script>

<style>
  .ecx-iflow {
    padding: 112px 24px;
    background: #fff;
  }
  .ecx-iflow__inner {
    width: min(1080px, 100%);
    margin: 0 auto;
  }

  .ecx-iflow__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 32px;
  }
  .ecx-iflow__title {
    max-width: 800px;
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .ecx-iflow__title-line {
    display: block;
  }
  .ecx-iflow__subtitle {
    margin: 0;
    font-size: 17.5px;
    font-weight: 500;
    line-height: 1.5;
    color: #6b7280;
    white-space: nowrap;
  }

  .ecx-iflow__tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 6px;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: #f1f3f7;
    flex-wrap: wrap;
  }
  .ecx-iflow__tab {
    padding: 8px 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #64748b;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ecx-iflow__tab:hover {
    background: rgba(255, 255, 255, 0.65);
    color: #334155;
  }
  .ecx-iflow__tab--active {
    background: #ffffff;
    color: #3b82f6;
    border-color: #dbe4f0;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
  }

  .ecx-iflow__panel {
    --ecx-iflow-tint: #fff8dc;
    --ecx-iflow-border: #f0dfa6;
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 52px 64px;
    border: 1px solid var(--ecx-iflow-border);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--ecx-iflow-tint) 0%, #ffffff 72%);
    animation: ecxIflowFadeIn 0.4s ease forwards;
  }
  .ecx-iflow__panel:nth-child(2) {
    --ecx-iflow-tint: #edf7ff;
    --ecx-iflow-border: #d4e7f7;
  }
  .ecx-iflow__panel:nth-child(3) {
    --ecx-iflow-tint: #f3efff;
    --ecx-iflow-border: #e2d8fa;
  }
  .ecx-iflow__panel:nth-child(4) {
    --ecx-iflow-tint: #eefbf4;
    --ecx-iflow-border: #d4efdf;
  }
  .ecx-iflow__panel--active {
    display: grid;
  }
  @keyframes ecxIflowFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ecx-iflow__panel-title {
    margin: 0 0 18px;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 42px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1f2937;
  }
  .ecx-iflow__panel-desc {
    margin: 0 0 32px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    color: #4b5563;
  }

  .ecx-iflow__checklist {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ecx-iflow__checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
    color: #6b7280;
  }
  .ecx-iflow__checklist li svg {
    flex-shrink: 0;
    margin-top: 2px;
    stroke: #9ca3af;
  }

  .ecx-iflow__right {
    min-width: 0;
  }
  .ecx-iflow__showcase {
    position: relative;
    isolation: isolate;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 22px 48px rgba(31, 41, 55, 0.1);
  }
  .ecx-iflow__showcase::before {
    content: "";
    position: absolute;
    inset: 10% 7% -8%;
    z-index: -1;
    border-radius: 12px;
    background: var(--ecx-iflow-border);
    filter: blur(22px);
    opacity: 0.48;
  }
  .ecx-iflow__showcase > img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1117 / 837;
    object-fit: contain;
    border: 1px solid #e0e4ec;
    border-radius: 12px;
    background: #fff;
  }
  .ecx-iflow__visual-label {
    --ecx-iflow-label-bg: #eef4ff;
    --ecx-iflow-label-border: #cddcff;
    --ecx-iflow-label-color: #3158d4;
    --ecx-iflow-label-shadow: rgba(49, 88, 212, 0.16);
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border: 1px solid var(--ecx-iflow-label-border);
    border-radius: 10px;
    background: var(--ecx-iflow-label-bg);
    box-shadow: 0 8px 22px var(--ecx-iflow-label-shadow);
    color: var(--ecx-iflow-label-color);
    font: 700 11px/1.2 var(--font-body);
  }
  .ecx-iflow__visual-label--tickets {
    --ecx-iflow-label-bg: #eefbf5;
    --ecx-iflow-label-border: #cbeedb;
    --ecx-iflow-label-color: #168a55;
    --ecx-iflow-label-shadow: rgba(22, 138, 85, 0.15);
    border-radius: 999px;
  }
  .ecx-iflow__visual-label--scanner {
    --ecx-iflow-label-bg: #f5f1ff;
    --ecx-iflow-label-border: #ded2ff;
    --ecx-iflow-label-color: #7351cf;
    --ecx-iflow-label-shadow: rgba(115, 81, 207, 0.16);
    border-radius: 7px;
  }
  .ecx-iflow__visual-label--count {
    --ecx-iflow-label-bg: #fff8e8;
    --ecx-iflow-label-border: #f2dfad;
    --ecx-iflow-label-color: #9a6b12;
    --ecx-iflow-label-shadow: rgba(154, 107, 18, 0.15);
    border-radius: 10px 10px 10px 3px;
  }
  .ecx-iflow__visual-label svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .ecx-iflow__panel {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 48px;
    }
    .ecx-iflow__subtitle {
      max-width: 700px;
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .ecx-iflow {
      padding: 72px 20px;
    }
    .ecx-iflow__title {
      font-size: clamp(26px, 8.3vw, 38px);
    }
    .ecx-iflow__tabs {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 20px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .ecx-iflow__tabs::-webkit-scrollbar {
      display: none;
    }
    .ecx-iflow__tab {
      flex: 0 0 auto;
      padding-inline: 14px;
      white-space: nowrap;
      scroll-snap-align: start;
    }
    .ecx-iflow__panel {
      padding: 32px 24px;
      border-radius: 20px;
    }
    .ecx-iflow__showcase {
      padding: 14px;
      border-radius: 18px;
    }
    .ecx-iflow__visual-label {
      top: 5px;
      left: 5px;
      padding: 7px 9px;
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ecx-iflow__panel {
      animation: none;
    }
  }
</style>
