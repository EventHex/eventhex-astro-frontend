---
// Real store links for the EventHex Scanner app (same URLs the CMS uses).
interface Props { align?: "start" | "center"; }
const { align = "start" } = Astro.props as Props;
---

<div class:list={["ecx-store", { "ecx-store--center": align === "center" }]}>
  <a class="ds-btn--ghost ecx-store__btn" href="https://apps.apple.com/in/app/eventhex-scanner/id6749537089" target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path></svg>
    Download on the App Store
  </a>
  <a class="ds-btn--ghost ecx-store__btn" href="https://play.google.com/store/apps/details?id=eventhex.scanner.app" target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 2.5v19a1 1 0 0 0 1.5.86l17-9.5a1 1 0 0 0 0-1.72l-17-9.5A1 1 0 0 0 3 2.5z"></path></svg>
    Get it on Google Play
  </a>
</div>

<style>
  .ecx-store { display: flex; flex-wrap: wrap; gap: 12px; }
  .ecx-store--center { justify-content: center; margin-top: 8px; }
  .ecx-store__btn { display: inline-flex; align-items: center; gap: 8px; }
  @media (max-width: 767px) {
    .ecx-store { width: 100%; flex-direction: column; }
    .ecx-store__btn { justify-content: center; }
  }
</style>
