---
// Full-bleed dark conversion band, matching the Event Registration dark CTA.
---

<section class="ecx-cta">
  <div class="ecx-cta__inner animate-on-scroll" data-animation="fadeInUp">
    <span>Plan the door before event day</span>
    <h2>Bring your entrance plan. See the check-in workflow around it.</h2>
    <p>
      Show us the ticket groups, scanning points, staffing plan, badge needs, and
      venue-network risks for one event. We'll map the mobile and desk workflow in
      a focused demo.
    </p>
    <a href="/book-a-demo/">
      Book a Demo
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .ecx-cta {
    position: relative;
    overflow: hidden;
    background-color: #000;
    background-image:
      radial-gradient(60% 55% at 30% 100%, rgba(56, 189, 248, 0.26) 0%, transparent 72%),
      radial-gradient(55% 50% at 78% 62%, rgba(164, 92, 255, 0.2) 0%, transparent 74%);
    background-repeat: no-repeat;
  }

  .ecx-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.07) 0 1px,
      transparent 1px 46px
    );
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 38%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 38%, #000 100%);
  }

  .ecx-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: clamp(96px, 11vw, 168px) 24px clamp(80px, 9vw, 132px);
    color: #fff;
    text-align: center;
  }

  .ecx-cta__inner > span {
    color: #afa3ff;
    font: 650 13px/1.3 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ecx-cta__inner h2 {
    max-width: 850px;
    margin: 0;
    color: #fff;
    font: 500 clamp(38px, 5vw, 60px)/1.04 var(--font-heading);
    letter-spacing: -0.045em;
  }

  .ecx-cta__inner p {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font: 400 17px/1.65 var(--font-body);
  }

  .ecx-cta__inner a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 14px 28px;
    border-radius: 12px;
    background: #fff;
    color: #111827;
    font: 650 15px/1.4 var(--font-body);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ecx-cta__inner a:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 767px) {
    .ecx-cta__inner { gap: 18px; padding-top: 72px; padding-bottom: 72px; }
    .ecx-cta__inner h2 { font-size: 38px; }
    .ecx-cta__inner p { font-size: 15px; }
    .ecx-cta__inner a { width: 100%; justify-content: center; }
  }
</style>
