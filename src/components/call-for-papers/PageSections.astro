---
import { faqs } from "./content";

const lifecycle = [
  ["Configure", "Call + form"],
  ["Collect", "Abstracts"],
  ["Assign", "Reviewers"],
  ["Score", "Rubrics"],
  ["Decide", "Notify authors"],
  ["Programme", "Create sessions"],
];

const setupCapabilities = [
  { title: "Submission window", text: "Set opening and closing dates, availability, and limits." },
  { title: "Late submissions", text: "Allow a separate late-submission window when required." },
  { title: "Multiple authors", text: "Enable multi-author submissions for the call." },
  { title: "Review timeline", text: "Set review start, deadline, decision deadline, and notification date." },
  { title: "Review settings", text: "Choose reviewer counts, blind review, conflict flags, reminders, and decision behavior." },
];

const workflowCards = [
  {
    eyebrow: "Structured submissions",
    title: "Collect the information your programme committee actually needs",
    description: "Use the event form flow to capture author details, abstract content, files, and event-specific questions in a consistent submission record. Track every response through review and decisions from one central queue.",
    image: "/feature-images/call-for-papers/submission-portal-card.svg",
    alt: "EventHex abstract submission portal and response queue",
    width: 657,
    height: 479,
    points: ["Custom fields", "Author details", "File collection", "Submission status"],
  },
  {
    eyebrow: "Reviewer coordination",
    title: "Move submissions to the right reviewers with a visible assignment workflow",
    description: "Build the reviewer panel, assign work in bulk or through the available automatic assignment path, send configured notices, and give each reviewer a scoped portal for their assigned submissions.",
    image: "/feature-images/call-for-papers/peer-review-card.svg",
    alt: "EventHex reviewer assignment and scoped review workspace",
    width: 603,
    height: 574,
    points: ["Add reviewers", "Assign submissions", "Notify reviewers", "Scoped reviewer portal"],
  },
  {
    eyebrow: "Comparable review",
    title: "Give every reviewer the same decision framework",
    description: "Use stored rubric criteria and weights while preserving criterion comments, overall scores, recommendation, and confidence. Reviewers can save a draft before submitting their review.",
    image: "/feature-images/call-for-papers/compliance-card.svg",
    alt: "EventHex rubric scoring and reviewer recommendation interface",
    width: 588,
    height: 508,
    points: ["Weighted criteria", "Criterion comments", "Recommendation", "Blind review setting"],
  },
  {
    eyebrow: "Programme decisions",
    title: "Move from reviewer input to a clear author outcome",
    description: "Review scores and committee context, then apply accepted, conditional, waitlisted, or rejected decisions individually or in bulk. Reviewer input informs the workbench; the organizer controls the decision.",
    image: "/feature-images/call-for-papers/decision-flow-card.svg",
    alt: "EventHex programme decision workbench with submission outcomes",
    width: 582,
    height: 543,
    points: ["Accepted", "Conditional accept", "Waitlisted", "Rejected"],
  },
];

const evidenceRows = [
  {
    eyebrow: "Author follow-up",
    title: "Give authors a clear path after submission",
    description: "Authors can return to their own submissions, view released status and permitted feedback, upload an eligible revision, or withdraw before a final accepted or rejected state.",
    image: "/feature-images/call-for-papers/submission-portal-card.svg",
    alt: "EventHex author portal showing a submission record and status",
    width: 657,
    height: 479,
    facts: ["Submission history", "Released decision", "Reviewer feedback", "Revision upload", "Withdrawal"],
  },
  {
    eyebrow: "Scheduled communication",
    title: "Coordinate the messages that keep the review moving",
    description: "Use event email settings and notification dates for confirmations, assignments, reminders, and decisions. Delivery depends on valid templates, recipients, and channel configuration.",
    image: "/feature-images/call-for-papers/cta-visual.svg",
    alt: "EventHex communication controls for call for papers notifications",
    width: 589,
    height: 438,
    facts: ["Submission confirmation", "Assignment notice", "Reviewer reminder", "Decision notification", "Scheduled release"],
  },
  {
    eyebrow: "From accepted abstract to agenda",
    title: "Carry selected work into the event programme without rebuilding the record",
    description: "Use the accepted-submission workbench to create corresponding sessions, then complete timing, stage, track, and lineup in Session Management. Export submission and score context as CSV when needed.",
    image: "/feature-images/call-for-papers/decision-flow-card.svg",
    alt: "EventHex accepted-submission workflow connected to session management",
    width: 582,
    height: 543,
    facts: ["Ranked submission view", "Bulk decisions", "Push to sessions", "CSV export", "Complete the agenda"],
  },
];

const relatedLinks = [
  { title: "Session Management", text: "Schedule accepted work across days, stages, and tracks.", href: "/session-management/" },
  { title: "Speaker Management", text: "Coordinate presenter profiles and wider speaker operations.", href: "/speaker-management/" },
  { title: "Event Notifications", text: "Manage broader attendee and event communication workflows.", href: "/event-notifications/" },
  { title: "Event Website Builder", text: "Publish the event programme and supporting pages.", href: "/event-website-builder/" },
];

const useCases = [
  { title: "Academic conferences", titleLines: ["Academic", "conferences"], text: "Collect and review research abstracts.", textLines: ["Collect and review", "research abstracts."], bullets: ["Structured abstract forms", "Blind review settings", "Weighted scoring rubrics"], image: "/feature-images/speaker-management/cfp-portal-call-settings.jpg", alt: "EventHex call for papers settings for an academic conference", width: 1117, height: 837 },
  { title: "Association events", titleLines: ["Association", "events"], text: "Build member-led educational programmes.", textLines: ["Build member-led", "educational programmes."], bullets: ["Multi-author submissions", "Reviewer assignments", "Scheduled decision notices"], image: "/feature-images/speaker-management/cfp-portal-published-agenda.jpg", alt: "Published EventHex programme for an association event", width: 1102, height: 826 },
  { title: "Medical congresses", titleLines: ["Medical", "congresses"], text: "Coordinate structured submissions and reviewer panels.", textLines: ["Coordinate structured submissions", "and reviewer panels."], bullets: ["Scoped reviewer access", "Conflict flags", "Criterion-level comments"], image: "/feature-images/speaker-management/cfp-portal-rubric.jpg", alt: "EventHex review rubric for a medical congress", width: 1117, height: 837 },
  { title: "Tech conferences", titleLines: ["Tech", "conferences"], text: "Select talks, workshops, and practitioner sessions.", textLines: ["Select talks, workshops,", "and practitioner sessions."], bullets: ["Talk and workshop intake", "Bulk reviewer assignments", "Accepted-session handoff"], image: "/feature-images/speaker-management/cfp-portal-submissions.jpg", alt: "EventHex submission workspace for a technology conference", width: 1117, height: 837 },
  { title: "Awards and showcases", titleLines: ["Awards and", "showcases"], text: "Adapt rubric-led review to judged submissions.", textLines: ["Adapt rubric-led review", "to judged submissions."], bullets: ["Weighted review criteria", "Reviewer recommendations", "Bulk programme decisions"], image: "/feature-images/speaker-management/cfp-portal-rubric.jpg", alt: "EventHex scoring rubric for awards and showcases", width: 1117, height: 837 },
  { title: "Corporate programmes", titleLines: ["Corporate", "programmes"], text: "Curate internal experts and session proposals.", textLines: ["Curate internal experts", "and session proposals."], bullets: ["Internal expert submissions", "Revision workflows", "Session Management handoff"], image: "/feature-images/speaker-management/cfp-portal-sessions.jpg", alt: "EventHex session workspace for a corporate programme", width: 1117, height: 837 },
];
---

<div class="cfpr-page">
  <section class="cfpr-hero">
    <div class="cfpr-hero__grid">
      <div class="cfpr-hero__content">
        <span class="cfpr-eyebrow animate-on-scroll" data-animation="fadeInDown">Call for papers software</span>
        <h1 class="cfpr-hero__title animate-on-scroll" data-animation="fadeInUp">Run your call for papers from first submission to final programme</h1>
        <p class="cfpr-hero__description animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">Collect structured abstracts, coordinate reviewers, score with a shared rubric, release decisions, and move accepted work into the event agenda from one connected workflow.</p>
        <div class="cfpr-hero__points animate-on-scroll" data-animation="fadeIn" style="--anim-duration: 1200ms">
          <span>Open a structured call</span>
          <span>Keep reviews comparable</span>
          <span>Turn accepted work into sessions</span>
        </div>
        <div class="cfpr-hero__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1000ms">
          <a class="cfpr-button cfpr-button--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="cfpr-button cfpr-button--secondary" href="#cfpr-workflow">See the workflow</a>
        </div>
      </div>

      <div class="cfpr-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="cfpr-hero__visual-card">
          <div class="cfpr-hero__visual-inner">
            <img src="/feature-images/call-for-papers/hero-visual.svg" alt="EventHex call for papers workflow from submission to programme" width="730" height="591" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cfpr-lifecycle" id="cfpr-workflow" aria-label="Call for papers lifecycle">
    <div class="cfpr-lifecycle__inner">
      {lifecycle.map(([title, text]) => (
        <div class="cfpr-lifecycle__item">
          <strong>{title}</strong>
          <small>{text}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="cfpr-capabilities">
    <div class="cfpr-shell">
      <div class="cfpr-section-head cfpr-section-head--light animate-on-scroll" data-animation="fadeInUp">
        <span class="cfpr-eyebrow">Open the call</span>
        <h2>Set the Submission and Review Timeline Before Invitations Go Out</h2>
        <p>Define the call, dates, author options, and review configuration that belong to this event.</p>
      </div>
      <div class="cfpr-capabilities__grid">
        {setupCapabilities.map((item, index) => (
          <article class="cfpr-capability animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
            {[1, 2, 4].includes(index) && (
              <>
                <span class="cfpr-petal cfpr-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
                <span class="cfpr-petal cfpr-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
              </>
            )}
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <div class="cfpr-capability__visual" aria-hidden="true">
              {index === 0 && <div class="cfpr-cap-ui cfpr-cap-ui--dates"><small>Submission window</small><span><b>Opens</b><i></i></span><span><b>Closes</b><i></i></span><em>Accepting submissions</em></div>}
              {index === 1 && <div class="cfpr-cap-ui cfpr-cap-ui--switches"><span><b>Late window</b><i class="is-on"></i></span><span><b>Separate deadline</b><i class="is-on"></i></span><span><b>Availability limit</b><i></i></span></div>}
              {index === 2 && <div class="cfpr-cap-ui cfpr-cap-ui--authors"><small>Submission authors</small><span><i>AM</i><b>Alex Morgan</b><em>Lead author</em></span><span><i>SK</i><b>Sam Kim</b><em>Co-author</em></span><button>+ Add author</button></div>}
              {index === 3 && <div class="cfpr-cap-ui cfpr-cap-ui--timeline"><span><b>Review starts</b><i></i></span><span class="is-active"><b>Review deadline</b><i></i></span><span><b>Decision release</b><i></i></span></div>}
              {index === 4 && <div class="cfpr-cap-ui cfpr-cap-ui--rubric"><small>Review configuration</small><span><b>Blind review</b><i class="is-on"></i></span><span><b>Conflict flags</b><i class="is-on"></i></span><span><b>Reviewer reminder</b><em>3 days before</em></span></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cfpr-evidence">
    <div class="cfpr-shell">
      <div class="cfpr-section-head animate-on-scroll" data-animation="fadeInUp">
        <span class="cfpr-eyebrow">After the review</span>
        <h2>Keep Authors, Decisions, and the Programme Connected</h2>
      </div>
      <div class="cfpr-evidence__grid">
        <span class="cfpr-evidence__notch cfpr-evidence__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg></span>
        <span class="cfpr-evidence__notch cfpr-evidence__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg></span>
        {evidenceRows.map((row, index) => (
          <article class:list={["cfpr-evidence__row", index % 2 === 1 && "cfpr-evidence__row--reverse"]}>
            <div class="cfpr-evidence__media animate-on-scroll" data-animation={index % 2 === 1 ? "fadeInRight" : "fadeInLeft"}>
              <img src={row.image} alt={row.alt} width={row.width} height={row.height} loading="lazy" decoding="async" />
            </div>
            <div class="cfpr-evidence__content animate-on-scroll" data-animation="fadeInUp">
              <span class="cfpr-eyebrow">{row.eyebrow}</span>
              <h3>{row.title}</h3>
              <p>{row.description}</p>
              <ul>{row.facts.map((fact) => <li>{fact}</li>)}</ul>
            </div>
            {index < evidenceRows.length - 1 && <span class="cfpr-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cfpr-workflows">
    <div class="cfpr-workflows__inner">
      <header class="cfpr-workflows__header">
        <span class="cfpr-workflows__pill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.4 2.5-5Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>Submission to decision</span>
        <h2>A Review Workflow Your Programme Team Can Follow</h2>
      </header>
      <div class="cfpr-workflows__cards">
        {workflowCards.map((card, index) => (
          <article class="cfpr-workflow-card" style={`--cfpr-card-index: ${index}`}>
            <div class="cfpr-workflow-card__content">
              <span class="cfpr-workflow-card__eyebrow">{card.eyebrow}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <div class="cfpr-workflow-card__points">
                {card.points.map((point) => <span>{point}</span>)}
              </div>
            </div>
            <div class="cfpr-workflow-card__media">
              <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
        <div class="cfpr-workflows__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="cfpr-related">
    <div class="cfpr-shell">
      <div class="cfpr-section-head animate-on-scroll" data-animation="fadeInUp">
        <span class="cfpr-eyebrow">Connected content operations</span>
        <h2>Continue Into the Workflow That Owns the Next Task</h2>
        <p>Keep each route focused while preserving the full programme journey.</p>
      </div>
      <div class="cfpr-related__grid">
        {[25, 50, 75].map((left) => <span class="cfpr-grid-notch" style={`left:${left}%`} aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e6f0"></path></svg></span>)}
        {relatedLinks.map((item, index) => (
          <a class="cfpr-related__card animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60} href={item.href}>
            <span class="cfpr-related__icon" aria-hidden="true">
              {index === 0 && <svg viewBox="0 0 24 24"><path d="M4 5h16v15H4zM8 3v4m8-4v4M4 10h16M8 14h3m2 0h3M8 17h3" /></svg>}
              {index === 1 && <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>}
              {index === 2 && <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>}
              {index === 3 && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01" /></svg>}
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {index === 2 && <span class="cfpr-related__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e6f0"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e6f0" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e6f0" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e6f0" transform="rotate(-90)"></path></svg></span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cfpr-use-cases">
    <div class="cfpr-use-cases__inner">
      <header class="cfpr-use-cases__header animate-on-scroll" data-animation="fadeInUp">
        <span class="cfpr-eyebrow">Built for reviewed programmes</span>
        <h2>Use One Workflow Across Different Submission-Led Events</h2>
        <p>Configure the call, review, and decision model around the programme committee.</p>
      </header>
      <ol class="cfpr-use-cases__steps">
        {useCases.map((item, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div class="cfpr-use-case__content">
                  <h3 class="cfpr-use-case__title">
                    {item.titleLines.map((line, lineIndex) => (
                      <span class="cfpr-use-case__line">{line}{lineIndex === 0 && <span class="cfpr-use-case__line-space">&nbsp;</span>}</span>
                    ))}
                  </h3>
                  <p class="cfpr-use-case__desc">
                    {item.textLines.map((line, lineIndex) => (
                      <span class="cfpr-use-case__line">{line}{lineIndex === 0 && <span class="cfpr-use-case__line-space">&nbsp;</span>}</span>
                    ))}
                  </p>
                  <ul class="cfpr-use-case__bullets">
                    {item.bullets.map((bullet) => (
                      <li><i aria-hidden="true">✦</i> {bullet}</li>
                    ))}
                  </ul>
                </div>
                <button
                  type="button"
                  class="cfpr-use-cases__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${item.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </button>
              </summary>
              <div class="cfpr-use-case__visual">
                <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cfpr-faq" id="cfpr-faq">
    <div class="cfpr-faq__inner">
      <aside class="cfpr-faq__sidebar">
        <span class="cfpr-faq__eyebrow"><span aria-hidden="true">↗</span> Call for papers questions</span>
        <h2>What Programme Teams Ask Before Opening Submissions</h2>
        <p>Need to map a specific review model? Bring it to a product walkthrough.</p>
        <a class="cfpr-button cfpr-button--primary" href="/book-a-demo/">Book a Demo</a>
      </aside>
      <div class="cfpr-faq__list">
        {faqs.map((faq, index) => (
          <details class="cfpr-faq__item" open={index === 0}>
            <summary class="cfpr-faq__question"><strong>{faq.question}</strong><span class="cfpr-faq__icon" aria-hidden="true"></span></summary>
            <div class="cfpr-faq__answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</div>

<script>
  const capabilitiesBand = document.querySelector<HTMLElement>(".cfpr-capabilities");

  if (capabilitiesBand && capabilitiesBand.dataset.bleedReady !== "true" && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    capabilitiesBand.dataset.bleedReady = "true";

    let capabilitiesTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let capabilitiesFrame = 0;
    let lastCapabilitiesProgress = -1;

    const measureCapabilities = () => {
      viewportHeight = window.innerHeight || 1;
      capabilitiesTop = capabilitiesBand.getBoundingClientRect().top + window.scrollY;
    };

    const updateCapabilitiesBleed = () => {
      capabilitiesFrame = 0;
      const travelled = viewportHeight - (capabilitiesTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * .7)));
      const roundedProgress = Math.round(progress * 100) / 100;
      if (roundedProgress === lastCapabilitiesProgress) return;
      lastCapabilitiesProgress = roundedProgress;
      capabilitiesBand.style.setProperty("--capabilities-p", String(roundedProgress));
    };

    const queueCapabilitiesBleed = () => {
      if (capabilitiesFrame) return;
      capabilitiesFrame = requestAnimationFrame(updateCapabilitiesBleed);
    };

    const resizeCapabilitiesBleed = () => {
      measureCapabilities();
      lastCapabilitiesProgress = -1;
      queueCapabilitiesBleed();
    };

    measureCapabilities();
    updateCapabilitiesBleed();
    window.addEventListener("scroll", queueCapabilitiesBleed, { passive: true });
    window.addEventListener("resize", resizeCapabilitiesBleed, { passive: true });
    window.addEventListener("load", resizeCapabilitiesBleed);
  }

  const workflowSection = document.querySelector<HTMLElement>(".cfpr-workflows");
  const workflowHeader = workflowSection?.querySelector<HTMLElement>(".cfpr-workflows__header");
  const workflowCards = workflowSection?.querySelectorAll<HTMLElement>(".cfpr-workflow-card");
  const finalWorkflowCard = workflowCards?.[workflowCards.length - 1];

  if (workflowHeader && finalWorkflowCard) {
    let frame = 0;
    const syncRelease = () => {
      frame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalWorkflowCard).top) || 0;
      const releaseOffset = Math.min(0, finalWorkflowCard.getBoundingClientRect().top - stickyTop);
      workflowHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueRelease = () => {
      if (frame) return;
      frame = requestAnimationFrame(syncRelease);
    };
    window.addEventListener("scroll", queueRelease, { passive: true });
    window.addEventListener("resize", queueRelease, { passive: true });
    syncRelease();
  }

  document.querySelectorAll<HTMLDetailsElement>(".cfpr-use-cases__steps details").forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".cfpr-use-cases__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} programme type`);
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  document.querySelectorAll<HTMLDetailsElement>(".cfpr-faq__item").forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      document.querySelectorAll<HTMLDetailsElement>(".cfpr-faq__item").forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

