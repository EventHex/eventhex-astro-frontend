---

<div class="spm-page">
  <!-- 01 Hero -->
  <section class="spm-hero" id="hero">
    <div class="spm-hero__shell">
      <div class="spm-hero__grid">
      <div class="spm-hero__copy">
        <span class="spm-hero__badge animate-on-scroll" data-animation="fadeInDown">
          <span class="spm-hero__badge-dot"></span>
          <span>Event sponsor management software</span>
        </span>
        <h1 class="spm-hero__title animate-on-scroll" data-animation="fadeInUp">
          <span class="spm-hero__title-line">Organize sponsor</span>
          <span class="spm-hero__title-line">profiles and present</span>
          <span class="spm-hero__title-line">every partner clearly</span>
        </h1>
        <p class="spm-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Keep sponsor and partner details attached to the event, group them into ordered
          categories, and publish branded sponsor sections across your EventHex event website.
        </p>
        <ul class="spm-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          <li class="spm-hero__point">Sponsor and partner profiles</li>
          <li class="spm-hero__point">Ordered categories</li>
          <li class="spm-hero__point">Website-ready logos</li>
        </ul>
        <div class="spm-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a href="/book-a-demo/" class="spm-hero__btn spm-hero__btn--primary">Book a Demo</a>
          <a href="#workflow" class="spm-hero__btn spm-hero__btn--secondary">See the sponsor workflow</a>
        </div>
      </div>

      <div class="spm-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="spm-hero__visual-card">
          <div class="spm-hero__visual-inner">
            <img
              class="spm-hero__analytics-shot"
              src="/images/sponsor-management/sponsor-packages-web-806.webp"
              alt="EventHex sponsor package workspace showing the event's sponsor category and package configuration"
              width="806"
              height="696"
              loading="eager"
              decoding="async"
            />
            <div
              class="spm-board spm-board--fallback"
              role="img"
              aria-label="EventHex sponsor workspace for the Future Tech Forum with four sponsor categories and eighteen partner records, a Platinum partner and a Gold partner, a tiered sponsor section on the event website, and a public sponsor directory"
            >
              <div class="spm-board__chrome" aria-hidden="true">
                <span class="spm-board__dot"></span>
                <span class="spm-board__dot"></span>
                <span class="spm-board__dot"></span>
                <b>EventHex &middot; Sponsors</b>
              </div>

              <div class="spm-board__rows" aria-hidden="true">
                <div class="spm-board__row spm-board__row--head">
                  <b class="spm-board__label">Event workspace</b>
                  <span class="spm-board__value">Future Tech Forum</span>
                  <small class="spm-board__meta">4 categories &middot; 18 partner records</small>
                </div>

                <div class="spm-board__row">
                  <b class="spm-board__label">Platinum</b>
                  <span class="spm-board__value">Northstar Labs</span>
                  <small class="spm-board__meta">Logo &middot; website &middot; description</small>
                </div>

                <div class="spm-board__row">
                  <b class="spm-board__label">Gold</b>
                  <span class="spm-board__value">Orbit Systems</span>
                  <small class="spm-board__meta">Category order 02</small>
                </div>

                <div class="spm-board__pair">
                  <div class="spm-board__row">
                    <b class="spm-board__label">Website</b>
                    <span class="spm-board__value">Tiered sponsor section</span>
                    <small class="spm-board__meta">Color logos &middot; 4 columns</small>
                  </div>
                  <div class="spm-board__row">
                    <b class="spm-board__label">Directory</b>
                    <span class="spm-board__value">Meet our partners</span>
                    <small class="spm-board__meta">Responsive public page</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- 02 Capability rail -->
  <section class="spm-rail" id="workflow" aria-label="Sponsor management workflow">
    <div class="spm-rail__inner">
      {
        flowRail.map((step) => (
          <span class="spm-rail__item">
            <b>{step.label}</b> {step.text}
          </span>
        ))
      }
    </div>
  </section>

  <!-- 03 Spotlight: the sponsor record -->
  <section class="spm-section" id="profiles" aria-labelledby="spm-profiles-title">
    <div class="spm-wrap spm-spot__grid">
      <div class="spm-head">
        <span class="spm-eyebrow animate-on-scroll" data-animation="fadeIn">A useful sponsor record</span>
        <h2 class="spm-title animate-on-scroll" data-animation="fadeInUp" id="spm-profiles-title">
          Keep the details your event team and <em>attendees need</em>
        </h2>
        <p class="spm-lead animate-on-scroll" data-animation="fadeInUp">
          Create a sponsor or partner profile with the core identity and contact information tied to the
          event.
        </p>
      </div>

      <div class="spm-panel animate-on-scroll" data-animation="fadeInRight">
        <div class="spm-shot">
          <img
            class="spm-profile-shot"
            src="/images/sponsor-management/exhibitor-list-web-806.webp"
            alt="EventHex exhibitor and sponsor records with company, package, team member, lead, and booth details"
            width="806"
            height="696"
            loading="lazy"
            decoding="async"
          />
          <div
            class="spm-editor"
            role="img"
            aria-label="EventHex sponsor profile form with brand identity, logo, website, and category fields beside a compact public sponsor card preview"
          >
            <div class="spm-editor__form" aria-hidden="true">
              <span class="spm-editor__field is-on">Brand name<b>Northstar Labs</b></span>
              <span class="spm-editor__field">Logo<b>northstar-labs.svg</b></span>
              <span class="spm-editor__field">Website<b>northstarlabs.com</b></span>
              <span class="spm-editor__field">Category<b>Platinum</b></span>
            </div>
            <div class="spm-editor__card" aria-hidden="true">
              <span class="spm-editor__logo"></span>
              <b>Northstar Labs</b>
              <small>Platinum partner</small>
            </div>
          </div>
        </div>
        <ul class="spm-list">
          {
            recordFields.map((item) => (
              <li>
                <strong>{item.label}</strong>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 04 Flow quad: profile draft and review -->
  <section class="spm-section spm-soft" id="profile-draft" aria-labelledby="spm-draft-title">
    <div class="spm-wrap">
      <div class="spm-map__header">
        <span class="spm-eyebrow animate-on-scroll" data-animation="fadeIn"
          >A faster starting point for profile setup</span
        >
        <h2 class="spm-map__title animate-on-scroll" data-animation="fadeInUp" id="spm-draft-title">
          <span class="spm-map__line">Start from known company information,</span>
          <span class="spm-map__line">then review the record</span>
        </h2>
        <p class="spm-map__subtitle animate-on-scroll" data-animation="fadeInUp">
          <span class="spm-map__line">The sponsor form includes a LinkedIn company-profile lookup that can map</span>
          <span class="spm-map__line">returned company details into the EventHex fields.</span>
        </p>
      </div>

      <div class="spm-map__quad">
        <article class="spm-map__cell spm-map__cell--copy animate-on-scroll" data-animation="fadeInUp">
          <h3>Generate a draft</h3>
          <p>
            Use a company profile URL to request available title, website, description, email, and social
            details. Treat returned data as a starting point.
          </p>
          <span class="spm-cue">Returned values are a draft, not a saved record.</span>
        </article>

        <div
          class="spm-map__cell spm-map__cell--media animate-on-scroll"
          data-animation="fadeInRight"
          aria-hidden="true"
        >
          <img class="spm-source-shot" src="/images/sponsor-management/exhibitor-list-web-806.webp" alt="EventHex exhibitor and sponsor records table showing company names, packages, team members, leads, and booth numbers" width="806" height="696" loading="lazy" decoding="async" />
          <div class="spm-map__composite">
            <div class="spm-map__screen spm-map__screen--primary">
              <span class="spm-map__tag">Company profile lookup</span>
              <span class="spm-map__row is-on">linkedin.com/company/northstar-labs</span>
              <span class="spm-map__row">Title and website</span>
              <span class="spm-map__row">Description</span>
              <span class="spm-map__row">Email and social details</span>
            </div>
            <div class="spm-map__screen spm-map__screen--secondary">
              <span class="spm-map__tag">Draft result</span>
              <span class="spm-map__row">Northstar Labs</span>
              <span class="spm-map__row">Ready to review</span>
            </div>
            <span class="spm-map__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Details requested
            </span>
            <span class="spm-map__action">Fetch details</span>
          </div>
        </div>

        <div
          class="spm-map__cell spm-map__cell--media animate-on-scroll"
          data-animation="fadeInLeft"
          aria-hidden="true"
        >
          <div class="spm-map__composite">
            <div class="spm-map__screen spm-map__screen--primary">
              <span class="spm-map__tag">Review before saving</span>
              <span class="spm-map__row">Brand name and logo</span>
              <span class="spm-map__row">Contact details</span>
              <span class="spm-map__row is-on">Category and description</span>
            </div>
            <div class="spm-map__screen spm-map__screen--secondary">
              <span class="spm-map__tag">Organizer step</span>
              <span class="spm-map__row">Confirm each field</span>
            </div>
            <span class="spm-map__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Reviewed
            </span>
            <span class="spm-map__action">Save sponsor</span>
          </div>
        </div>

        <article class="spm-map__cell spm-map__cell--copy animate-on-scroll" data-animation="fadeInUp">
          <h3>Review before use</h3>
          <p>
            Confirm the brand name, contact details, description, category, and logo before saving.
            Organizer review remains the approval step.
          </p>
          <span class="spm-cue">Nothing publishes without an organizer confirming it.</span>
        </article>

        <span class="spm-map__cross" aria-hidden="true"></span>
      </div>

      <p class="spm-note spm-map__note animate-on-scroll" data-animation="fadeIn">
        This is profile assistance, not automated sponsorship sales, package fulfillment, or ROI analysis.
      </p>
    </div>
  </section>

  <!-- 05 Dark band: sponsor categories -->
  <section class="spm-catband" id="categories" aria-labelledby="spm-categories-title">
    <div class="spm-catband__head">
      <span class="spm-catband__eyebrow animate-on-scroll" data-animation="fadeInDown"
        >Categories that match your event</span
      >
      <h2 class="spm-catband__title animate-on-scroll" data-animation="fadeInUp" id="spm-categories-title">
        Group sponsors in the structure your audience understands
      </h2>
      <p class="spm-catband__lead animate-on-scroll" data-animation="fadeInUp">
        Create category names and descriptions, then control the order in which those groups appear.
      </p>
    </div>

    <div class="spm-catband__grid">
      <div class="spm-catgrid">
        <article class="spm-catgrid__cell animate-on-scroll" data-animation="fadeInUp" data-delay="0">
          <h3 class="spm-catgrid__label">{categoryGroups[0].label}</h3>
          <p class="spm-catgrid__desc">{categoryGroups[0].text}</p>
          <div class="spm-catgrid__visual" aria-hidden="true">
            <div class="spm-catgrid__card">
              <span class="spm-catgrid__card-head">Sponsor categories</span>
              <div class="spm-catgrid__row is-on">
                <span class="spm-catgrid__num">01</span><b>Platinum</b><small>2 partners</small>
              </div>
              <div class="spm-catgrid__row">
                <span class="spm-catgrid__num">02</span><b>Gold</b><small>5 partners</small>
              </div>
              <div class="spm-catgrid__row">
                <span class="spm-catgrid__num">03</span><b>Community Partner</b><small>6 partners</small>
