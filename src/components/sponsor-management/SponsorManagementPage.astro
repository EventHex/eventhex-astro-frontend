const destinations = [
  {
    label: "Event Website Builder",
    text: "Design the sponsor section and dedicated event pages.",
    href: "/event-website-builder/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v14H3z"/><path d="M3 9h18M7 13h6"/></svg>`,
  },
  {
