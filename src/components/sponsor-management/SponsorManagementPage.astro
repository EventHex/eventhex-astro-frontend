  <script>
    const sponsorVisibilitySection = document.querySelector<HTMLElement>('#responsive-visibility');
    const sponsorVisibilityHeader = sponsorVisibilitySection?.querySelector<HTMLElement>('.spm-shell__head');
    const sponsorVisibilityCards = sponsorVisibilitySection?.querySelectorAll<HTMLElement>('.spm-shell__card');
    const sponsorVisibilityFinalCard = sponsorVisibilityCards?.[sponsorVisibilityCards.length - 1];

    if (sponsorVisibilityHeader && sponsorVisibilityFinalCard) {
      let sponsorVisibilityFrame = 0;
      const syncSponsorVisibilityRelease = () => {
        sponsorVisibilityFrame = 0;
        const stickyTop = Number.parseFloat(getComputedStyle(sponsorVisibilityFinalCard).top) || 0;
        const releaseOffset = Math.min(0, sponsorVisibilityFinalCard.getBoundingClientRect().top - stickyTop);
        sponsorVisibilityHeader.style.setProperty('--spm-shell-release-y', `${releaseOffset}px`);
      };
      const queueSponsorVisibilityRelease = () => {
        if (sponsorVisibilityFrame) return;
        sponsorVisibilityFrame = requestAnimationFrame(syncSponsorVisibilityRelease);
      };

      window.addEventListener('scroll', queueSponsorVisibilityRelease, { passive: true });
      window.addEventListener('resize', queueSponsorVisibilityRelease, { passive: true });
      syncSponsorVisibilityRelease();
    }
  </script>

