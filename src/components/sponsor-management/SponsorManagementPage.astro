<script>
  // The sponsor categories band mirrors the Event Registration capabilities band: it
  // starts inset with rounded corners and opens to full bleed as it travels up the
  // viewport. Writing one custom property keeps the whole reveal paint-only.
  function initSponsorCategoryBandBleed() {
    const band = document.querySelector<HTMLElement>(".spm-catband");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    // cache the band's document offset so the scroll handler never reads layout
    let bandTop = 0;
    let vh = window.innerHeight || 1;
    const measure = () => {
      vh = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let last = -1;
    const update = () => {
      ticking = false;
      // 0 while the band's top sits at the viewport bottom, 1 once it has
      // travelled 70% of a viewport upward
      const travelled = vh - (bandTop - window.scrollY);
      const p = Math.min(1, Math.max(0, travelled / (vh * 0.7)));
      const rounded = Math.round(p * 100) / 100;
      if (rounded === last) return;
      last = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      last = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
  }

  initSponsorCategoryBandBleed();

  // One click leaves exactly one FAQ row open, matching the Event Registration and
  // Speaker Management references.
  const sponsorFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-spm-faq-item]"));
  sponsorFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      sponsorFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<script>
  // Sponsor-led event models: segmented tabs over one tinted panel per model.
  function initSponsorEventSuites() {
    document.querySelectorAll<HTMLElement>(".spm-suites").forEach((suite) => {
      const box = suite.querySelector<HTMLElement>(".spm-suites__box");
      const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".spm-suites__tab"));
      const panels = Array.from(suite.querySelectorAll<HTMLElement>(".spm-suites__panel"));
      if (!box || box.dataset.ready === "true" || !tabs.length || !panels.length) return;

      const select = (index: number) => {
        tabs.forEach((tab, tabIndex) => {
          const isActive = tabIndex === index;
          tab.setAttribute("aria-selected", isActive ? "true" : "false");
          tab.tabIndex = isActive ? 0 : -1;
        });
        panels.forEach((panel, panelIndex) => {
          panel.classList.toggle("is-active", panelIndex === index);
        });
      };

      // Marking the box ready lets the stylesheet hide the inactive panels, so the
      // markup stays readable when the script never runs.
      box.dataset.ready = "true";
      select(0);

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
          event.preventDefault();
          const offset = event.key === "ArrowRight" ? 1 : -1;
          const nextIndex = (index + offset + tabs.length) % tabs.length;
          tabs[nextIndex].focus();
          select(nextIndex);
        });
      });
    });
  }

  initSponsorEventSuites();
</script>
