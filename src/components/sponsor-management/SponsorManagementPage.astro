---
// Sponsor Management feature page.
// Section patterns reuse the Event Registration and Speaker Management design language
// (documented in the EventHex pattern library): split hero + workflow rail + spotlight
// panels + flow quads + bento bands + operations grid + journey track + audience cards +
// destination links + single-column FAQ. The layout's dark footer CTA closes the page.
// Copy comes from the approved sponsor-management content deck; the package-sales,
// cross-channel-placement, and ROI claims the deck removed are intentionally absent.

interface Props {
  faqs: Array<[string, string]>;
}

const { faqs } = Astro.props;

const flowRail = [
  { label: "Add", text: "Create the profile" },
  { label: "Categorize", text: "Assign the group" },
