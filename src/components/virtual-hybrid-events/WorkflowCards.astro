---
const cards = [
  {
    eyebrow: "Meeting bot control",
    title: "Prepare the bot before the room opens",
    copy: "Configure the identity and joining behavior, then start the bot manually or use the supported auto-join setting for the event schedule.",
    items: [
      ["Save the meeting link", "Attach the correct room before the session."],
      ["Set bot identity", "Choose the bot name, welcome message, and available behavior."],
      ["Choose when it joins", "Start manually or enable the scheduled auto-join option."],
      ["Watch the phase", "See setup, joining, waiting-room, live, processing, and completed states."],
    ],
    kind: "bot",
  },
  {
    eyebrow: "Capture the session",
    title: "Turn the live room into a recording and transcript your team can use",
    copy: "After processing, supported provider paths can surface the session recording, timestamped transcript, chat, participants, and speaker timeline in the event workspace.",
    items: [
      ["Recording playback", "Review available video or audio after the provider finishes processing."],
      ["Timestamped transcript", "Move between transcript segments and the corresponding moment in the recording when available."],
      ["Chat record", "Keep supported meeting chat messages with the session record."],
      ["Speaker and participant context", "Review joins, leaves, participation, and speaker-timeline data where the provider supplies it."],
    ],
    kind: "capture",
  },
  {
    eyebrow: "Optional live streaming",
    title: "Send the meeting feed to the destinations your broadcast plan requires",
    copy: "Before the bot starts, enable streaming and add one or more supported destinations with the stream details supplied by each platform.",
    items: [
      ["YouTube Live", "Add the YouTube RTMP destination and stream key."],
      ["Facebook Live", "Add the Facebook RTMP destination and stream key."],
      ["Custom RTMP", "Use the RTMP URL and key supplied by another compatible destination."],
      ["Multiple destinations", "Configure more than one destination for the same meeting-bot session when the selected provider supports RTMP streaming."],
    ],
    kind: "stream",
  },
];
---

<section class="vhw-shell" aria-labelledby="vhw-title">
  <div class="vhw-section">
    <header class="vhw-header">
      <span class="vhw-header__eyebrow">One session lifecycle</span>
      <h2 id="vhw-title">From meeting link to usable event record</h2>
    </header>

    <div class="vhw-cards">
      {cards.map((card, cardIndex) => (
        <article class="vhw-card" style={`--card-index:${cardIndex}`}>
          <div class="vhw-card__content">
            <span class="vhw-card__eyebrow">{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
            <ul>
              {card.items.map(([title, copy]) => (
                <li><b>{title}</b><span>{copy}</span></li>
              ))}
            </ul>
          </div>
          <div class:list={["vhw-card__visual", `vhw-card__visual--${card.kind}`]} aria-hidden="true">
            <div class="vhw-ui">
              <div class="vhw-ui__bar"><span><i></i><i></i><i></i></span><b>{card.eyebrow}</b></div>
              {card.kind === "bot" && (
                <div class="vhw-ui__bot">
                  <div class="vhw-ui__field"><small>Meeting link</small><span>Save the meeting link</span><i></i></div>
                  <div class="vhw-ui__field"><small>Set bot identity</small><span>Choose the bot name, welcome message, and available behavior.</span></div>
                  <div class="vhw-ui__toggle"><span><b>Choose when it joins</b><small>Start manually or enable the scheduled auto-join option.</small></span><i></i></div>
                  <ol><li class="is-done">Setup</li><li class="is-active">Joining</li><li>Live</li><li>Processing</li></ol>
                </div>
              )}
              {card.kind === "capture" && (
                <div class="vhw-ui__capture">
                  <div class="vhw-ui__player"><span>Recording playback</span><div><i></i></div><small></small></div>
                  <div class="vhw-ui__transcript"><b>Timestamped transcript</b><p>Chat record</p><p>Speaker and participant context</p></div>
                </div>
              )}
              {card.kind === "stream" && (
                <div class="vhw-ui__stream">
                  <div class="vhw-ui__source"><i></i><span><b>Meeting bot</b><small></small></span></div>
                  <div class="vhw-ui__routes" aria-hidden="true"><i></i><i></i><i></i></div>
                  <div class="vhw-ui__destinations"><span><i>Y</i><b>YouTube Live</b><small></small></span><span><i>F</i><b>Facebook Live</b><small></small></span><span><i>R</i><b>Custom RTMP</b><small></small></span></div>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
      <div class="vhw-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style is:global>
  /* Speaker Management sticky dark narrative-card pattern. */
  .vhw-shell { width:100%; color:var(--ds-white); background:radial-gradient(130% 42% at 50% 0,rgba(92, 138, 255, 0.22) 0,rgba(124, 108, 255, 0.1) 45%,transparent 72%),var(--ds-night); }
  .vhw-section { display:flex; flex-direction:column; align-items:center; width:100%; padding:74px 24px 48px; }
  .vhw-header { position:sticky; top:110px; z-index:0; width:min(760px,100%); margin:0 auto; text-align:center; }
  .vhw-header__eyebrow { display:inline-flex; padding:7px 13px; border:1px solid rgba(175, 163, 255, 0.28); border-radius:999px; color:var(--ds-violet-soft); background:rgba(175, 163, 255, 0.1); font:600 12px/1.2 var(--font-body); }
  .vhw-header h2 { margin:18px 0 16px; color:var(--ds-surface-tab); font:500 clamp(36px,5vw,56px)/1.06 var(--font-heading); letter-spacing:-.04em; }
  .vhw-header p { max-width:650px; margin:0 auto; color:rgba(255, 255, 255, 0.57); font:400 17px/1.55 var(--font-body); }
  .vhw-cards { --vhw-top:340px; position:relative; z-index:1; display:flex; flex-direction:column; gap:24px; width:min(1120px,100%); padding-top:100px; }
  .vhw-card { position:sticky; top:calc(var(--vhw-top) + var(--card-index) * 20px); display:flex; min-height:600px; overflow:hidden; border:1px solid rgba(255, 255, 255, 0.12); border-radius:28px; background:radial-gradient(circle at 85% 8%,rgba(109, 92, 235, 0.21),transparent 34%),var(--ds-night-2); box-shadow:0 -10px 40px rgba(0, 0, 0, 0.6); }
  .vhw-card__content { display:flex; flex:0 0 49%; flex-direction:column; justify-content:center; padding:46px; }
  .vhw-card__eyebrow { align-self:flex-start; margin-bottom:15px; padding:7px 13px; border:1px solid rgba(175, 163, 255, 0.28); border-radius:999px; color:var(--ds-violet-soft); background:rgba(175, 163, 255, 0.1); font:600 12px/1.2 var(--font-body); }
  .vhw-card__content h3 { margin:0 0 16px; color:var(--ds-line-strong); font:500 clamp(28px,3vw,38px)/1.12 var(--font-heading); letter-spacing:-.03em; }
  .vhw-card__content > p { margin:0; color:rgba(255, 255, 255, 0.55); font:400 16px/1.6 var(--font-body); }
  .vhw-card__content ul { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:26px 0 0; padding:0; list-style:none; }
  .vhw-card__content li { display:flex; flex-direction:column; gap:5px; padding:13px; border:1px solid rgba(255, 255, 255, 0.07); border-radius:12px; background:rgba(255, 255, 255, 0.03); }
  .vhw-card__content li b { color:var(--ds-surface-tab); font:600 12px/1.3 var(--font-body); }.vhw-card__content li span { color:rgba(255, 255, 255, 0.47); font:400 11px/1.45 var(--font-body); }
  .vhw-card__visual { display:flex; flex:1; align-items:center; justify-content:center; margin:18px 18px 18px 0; padding:28px; border:1px solid rgba(255, 255, 255, 0.16); border-radius:18px; background:linear-gradient(160deg,rgba(255, 255, 255, 0.13),rgba(255, 255, 255, 0.04)); }
  .vhw-ui { width:100%; overflow:hidden; border:1px solid rgba(255, 255, 255, 0.13); border-radius:16px; color:var(--ds-ink); background:var(--ds-surface); box-shadow:0 24px 60px rgba(0, 0, 0, 0.33); font-family:var(--font-body); }
  .vhw-ui__bar { display:flex; align-items:center; gap:12px; padding:13px 15px; border-bottom:1px solid var(--ds-line-strong); background:var(--ds-white); }.vhw-ui__bar span{display:flex;gap:4px}.vhw-ui__bar i{width:7px;height:7px;border-radius:50%;background:var(--ds-line-strong)}.vhw-ui__bar b{font-size:11px}
  .vhw-ui__bot,.vhw-ui__capture,.vhw-ui__stream { min-height:350px; padding:24px; }
  .vhw-ui__field { position:relative; display:flex; flex-direction:column; gap:6px; margin-bottom:14px; padding:13px 14px; border:1px solid var(--ds-line-strong); border-radius:10px; background:var(--ds-white); }.vhw-ui__field small{color:var(--ds-label);font-size:9px}.vhw-ui__field span{font-size:11px;font-weight:600}.vhw-ui__field i{position:absolute;right:12px;bottom:12px;padding:4px 6px;border-radius:6px;color:var(--ds-success);background:var(--ds-success-soft);font-size:8px;font-style:normal}
  .vhw-ui__toggle{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid var(--ds-line-strong);border-radius:10px;background:var(--ds-white)}.vhw-ui__toggle span{display:flex;flex-direction:column;gap:4px}.vhw-ui__toggle b{font-size:11px}.vhw-ui__toggle small{color:var(--ds-label);font-size:8px}.vhw-ui__toggle>i{position:relative;width:32px;height:18px;border-radius:999px;background:var(--ds-blue)}.vhw-ui__toggle>i::after{content:"";position:absolute;top:3px;right:3px;width:12px;height:12px;border-radius:50%;background:var(--ds-white)}
  .vhw-ui__bot ol{display:flex;margin:24px 0 0;padding:0;list-style:none}.vhw-ui__bot li{position:relative;flex:1;padding-top:17px;color:var(--ds-label);font-size:8px;text-align:center}.vhw-ui__bot li::before{content:"";position:absolute;top:2px;left:50%;width:8px;height:8px;border:2px solid var(--ds-line-strong);border-radius:50%;background:var(--ds-white)}.vhw-ui__bot li::after{content:"";position:absolute;top:7px;left:calc(50% + 8px);width:calc(100% - 16px);border-top:1px solid var(--ds-line-strong)}.vhw-ui__bot li:last-child::after{display:none}.vhw-ui__bot .is-done::before,.vhw-ui__bot .is-active::before{border-color:var(--ds-blue);background:var(--ds-blue)}.vhw-ui__bot .is-active{color:var(--ds-blue);font-weight:700}
  .vhw-ui__player{display:flex;flex-direction:column;justify-content:flex-end;height:170px;padding:16px;border-radius:12px;color:var(--ds-white);background:linear-gradient(135deg,var(--ds-ink),var(--ds-night-2))}.vhw-ui__player>span{font-size:10px}.vhw-ui__player>div{height:3px;margin:65px 0 7px;border-radius:3px;background:rgba(255, 255, 255, 0.19)}.vhw-ui__player>div i{display:block;width:42%;height:100%;background:var(--ds-violet)}.vhw-ui__player small{font-size:8px}
  .vhw-ui__transcript{margin-top:14px;padding:14px;border:1px solid var(--ds-line-strong);border-radius:10px;background:var(--ds-white)}.vhw-ui__transcript>b{display:block;margin-bottom:9px;font-size:10px}.vhw-ui__transcript p{margin:7px 0;color:var(--ds-muted);font-size:8px}.vhw-ui__transcript time{margin-right:7px;color:var(--ds-blue);font-weight:700}
  .vhw-ui__stream{display:flex;align-items:center;justify-content:center;gap:18px}.vhw-ui__source{display:flex;align-items:center;gap:9px;padding:14px;border:1px solid var(--ds-line-strong);border-radius:12px;background:var(--ds-white)}.vhw-ui__source>i{width:28px;height:28px;border-radius:9px;background:var(--ds-blue)}.vhw-ui__source span{display:flex;flex-direction:column;gap:3px}.vhw-ui__source b{font-size:9px}.vhw-ui__source small{color:var(--ds-cat-green);font-size:7px}
  .vhw-ui__routes{display:flex;flex-direction:column;gap:28px}.vhw-ui__routes i{display:block;width:34px;border-top:1px dashed var(--ds-label)}.vhw-ui__destinations{display:flex;flex-direction:column;gap:10px}.vhw-ui__destinations span{display:grid;grid-template-columns:28px 1fr;column-gap:8px;align-items:center;min-width:145px;padding:11px;border:1px solid var(--ds-line-strong);border-radius:10px;background:var(--ds-white)}.vhw-ui__destinations i{grid-row:1/3;display:grid;place-items:center;width:28px;height:28px;border-radius:8px;color:var(--ds-white);background:var(--ds-danger);font-size:9px;font-style:normal}.vhw-ui__destinations span:nth-child(2) i{background:var(--ds-cat-blue)}.vhw-ui__destinations span:nth-child(3) i{background:var(--ds-muted)}.vhw-ui__destinations b{font-size:9px}.vhw-ui__destinations small{color:var(--ds-cat-green);font-size:7px}
  .vhw-spacer{height:80px}
  @media(max-width:1024px){.vhw-cards{--vhw-top:220px}.vhw-card{min-height:560px}.vhw-card__content{padding:32px}.vhw-card__content ul{grid-template-columns:1fr}.vhw-card__content li:nth-child(n+3){display:none}.vhw-card__visual{padding:18px}}
  @media(max-width:767px){.vhw-section{padding:60px 18px 30px}.vhw-header{position:static}.vhw-cards{padding-top:54px}.vhw-card{position:relative;top:auto!important;flex-direction:column;min-height:0}.vhw-card__content{padding:26px 22px 18px}.vhw-card__content ul{grid-template-columns:1fr}.vhw-card__content li:nth-child(n+3){display:flex}.vhw-card__visual{min-height:390px;margin:12px;padding:14px}.vhw-ui__bot,.vhw-ui__capture,.vhw-ui__stream{min-height:320px;padding:18px}.vhw-ui__stream{gap:8px}.vhw-ui__routes i{width:16px}.vhw-spacer{display:none}}
</style>
