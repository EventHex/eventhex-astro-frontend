    text: "Use the meeting link, bot, virtual check-in, recording, transcript, and follow-up as the primary attendee journey.",
    cue: "Best for remote-first programmes",
    items: ["Meeting link as the room", "Gated virtual check-in", "Session outputs after processing"],
    status: "Virtual check-in",
    action: "Join the meeting",
    media: {
      primary: {
        src: "/feature-images/virtual-hybrid-events/virtual-meeting-workspace.png",
        alt: "EventHex virtual meeting workspace with the meeting link, virtual check-in and AI meeting bot",
