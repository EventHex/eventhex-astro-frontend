---
const lifecycle = [
  { title: "Connect", text: "Meeting link" },
  { title: "Join", text: "EventHex bot" },
  { title: "Capture", text: "Recording + transcript" },
  { title: "Stream", text: "RTMP destinations" },
  { title: "Track", text: "Virtual attendance" },
  { title: "Follow up", text: "Recap + insights" },
];

const formats = [
  {
    title: "Virtual event",
    text: "Use the meeting link, bot, virtual check-in, recording, transcript, and follow-up as the primary attendee journey.",
    cue: "Best for remote-first programmes",
  },
  {
    title: "Hybrid event",
    text: "Run the meeting workflow alongside onsite check-in and event-day operations while keeping the same event and sessions at the center.",
    cue: "Best for connected venues and remote audiences",
  },
];

const meetingPlatforms = [
  { title: "Zoom", text: "Connect a supported Zoom meeting URL.", tone: "blue" },
  { title: "Google Meet", text: "Connect a Google Meet room or create the supported calendar-led setup.", tone: "green" },
  { title: "Microsoft Teams", text: "Connect a supported Teams meeting URL.", tone: "violet" },
  { title: "Event context", text: "Keep the meeting attached to the correct event, schedule, and organizer workspace.", tone: "amber" },
];

const workflowCards = [
  {
    eyebrow: "Meeting bot control",
    title: "Prepare the bot before the room opens",
    text: "Configure the identity and joining behavior, then start the bot manually or use the supported auto-join setting for the event schedule.",
    items: [
      ["Save the meeting link", "Attach the correct room before the session."],
      ["Set bot identity", "Choose the bot name, welcome message, and available behavior."],
      ["Choose when it joins", "Start manually or enable the scheduled auto-join option."],
      ["Watch the phase", "See setup, joining, waiting-room, live, processing, and completed states."],
    ],
    visual: "bot",
  },
  {
    eyebrow: "Capture the session",
    title: "Turn the live room into a recording and transcript your team can use",
    text: "After processing, supported provider paths can surface the session recording, timestamped transcript, chat, participants, and speaker timeline in the event workspace.",
    items: [
      ["Recording playback", "Review available video or audio after the provider finishes processing."],
      ["Timestamped transcript", "Move between transcript segments and the corresponding moment in the recording when available."],
      ["Chat record", "Keep supported meeting chat messages with the session record."],
      ["Speaker and participant context", "Review joins, leaves, participation, and speaker-timeline data where the provider supplies it."],
    ],
    visual: "capture",
  },
  {
    eyebrow: "Optional live streaming",
    title: "Send the meeting feed to the destinations your broadcast plan requires",
    text: "Before the bot starts, enable streaming and add one or more supported destinations with the stream details supplied by each platform.",
    items: [
      ["YouTube Live", "Add the YouTube RTMP destination and stream key."],
      ["Facebook Live", "Add the Facebook RTMP destination and stream key."],
      ["Custom RTMP", "Use the RTMP URL and key supplied by another compatible destination."],
      ["Multiple destinations", "Configure more than one destination for the same meeting-bot session when the selected provider supports RTMP streaming."],
    ],
    visual: "stream",
  },
];

const attendanceItems = [
  ["Unique participants", "Review the participant roster captured for the meeting."],
  ["Join and leave", "Use available meeting events to understand attendance windows."],
  ["Speaking context", "Review speaker-timeline or speaking-time data where supported."],
  ["Registration match", "Link identified virtual participants to ticket registrations."],
  ["Live status", "See whether the meeting bot is joining, waiting, live, or finished."],
  ["Event-level review", "Keep session results inside the same organizer event workspace."],
];

const connectedOperations = [
  ["Event Registration", "Collect attendee details and route people into the selected virtual or hybrid experience.", "/event-registration/"],
  ["Event Check-In", "Coordinate onsite arrival for the in-person side of a hybrid event.", "/event-check-in/"],
  ["AI Session Recap", "Create the attendee-facing transcript, takeaways, and recap experience.", "/ai-session-recap/"],
  ["Event Analytics", "Review broader event performance beyond the individual meeting session.", "/event-analytics/"],
];

const eventTypes = [
  ["Conferences", "Run multi-session programmes with remote access and post-session records."],
  ["Association events", "Connect recurring member sessions to registration and attendance."],
  ["Corporate events", "Coordinate internal or external virtual programmes with controlled access."],
  ["Tech conferences", "Extend product talks and panels to remote viewers and recap journeys."],
  ["Exhibitions", "Support hybrid briefings, exhibitor sessions, or streamed programme content."],
  ["Recorded events", "Capture a scheduled live session and reuse its approved output after processing."],
];

const faqs = [
  ["Does EventHex replace Zoom, Google Meet, or Microsoft Teams?", "No. EventHex uses the supported meeting link and adds event operations around it, including bot control, streaming configuration, attendance, session outputs, and follow-up."],
  ["Can the meeting bot join automatically?", "A supported auto-join setting exists alongside manual start. Confirm the event schedule, waiting-room behavior, provider, and host permissions before relying on it."],
  ["Can we stream to more than one destination?", "The organizer can configure YouTube, Facebook, or custom RTMP destinations, including multiple destination entries. RTMP availability still depends on the active meeting-bot provider and valid stream credentials."],
  ["Are recording and transcripts always available?", "They depend on the configured provider, meeting permissions, bot admission, processing success, and feature setup. EventHex shows the outputs and states available for that session; it does not guarantee every meeting will be captured."],
  ["How does virtual check-in work?", "Organizers can enable a gated event link and opening window. The supported OTP path identifies the attendee and can connect the resulting virtual attendance to a registration."],
  ["Does EventHex support live captions and translation?", "EventHex has live transcription and translation paths, but supported languages, attendee surfaces, and behavior depend on the chosen provider and session configuration. Confirm the exact requirement during the demo."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<div class="vhx-page">
  <section class="vhx-hero">
    <div class="vhx-hero__grid">
      <div class="vhx-hero__content">
        <span class="vhx-eyebrow animate-on-scroll" data-animation="fadeInDown">Virtual &amp; hybrid events</span>
        <h1 class="vhx-hero__title animate-on-scroll" data-animation="fadeInUp">Run virtual and hybrid events around the meeting tools your audience already uses</h1>
        <p class="vhx-hero__copy animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">Connect Zoom, Google Meet, or Microsoft Teams to EventHex, control a meeting bot, and keep streaming, attendance, recordings, transcripts, and post-session follow-up tied to the event.</p>
        <div class="vhx-hero__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1000ms">
          <a class="vhx-button vhx-button--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="vhx-button vhx-button--secondary" href="#vhx-formats">See the workflow</a>
        </div>
        <div class="vhx-hero__points animate-on-scroll" data-animation="fadeIn" style="--anim-duration: 1200ms">
          <span>Use the meeting room you already planned</span>
          <span>Configure recording and streaming before go-live</span>
          <span>Carry session outcomes into event operations</span>
        </div>
      </div>

      <div class="vhx-hero__visual animate-on-scroll" data-animation="fadeInRight" role="img" aria-label="Connected virtual session showing a meeting link, EventHex bot, recording, streaming, and attendance">
        <div class="vhx-window">
          <div class="vhx-window__bar"><i></i><i></i><i></i><span>EventHex · Virtual events</span></div>
          <div class="vhx-hero-ui">
            <div class="vhx-hero-ui__side">
              <small>EVENT WORKSPACE</small>
              <strong>Meeting link</strong>
              <span><i></i> EventHex bot · Live</span>
            </div>
            <div class="vhx-hero-ui__flow" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="vhx-hero-ui__cards">
              <div><small>ROOM</small><strong>Google Meet</strong><span>Existing link</span></div>
              <div><small>BOT</small><strong>Recording</strong><span>Provider-supported</span></div>
              <div><small>STREAM</small><strong>RTMP destinations</strong><span>Configured</span></div>
              <div><small>ATTENDANCE</small><strong>Virtual + onsite</strong><span>Live status</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vhx-lifecycle" aria-labelledby="vhx-lifecycle-title">
    <div class="vhx-lifecycle__header">
      <span>One session lifecycle</span>
      <h2 id="vhx-lifecycle-title">From meeting link to usable event record</h2>
    </div>
    <div class="vhx-lifecycle__grid">
      {lifecycle.map((item, index) => (
        <div class="vhx-lifecycle__item">
          <small>{String(index + 1).padStart(2, "0")}</small>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section id="vhx-formats" class="vhx-formats">
    <div class="vhx-section-heading animate-on-scroll" data-animation="fadeInUp">
      <span class="vhx-eyebrow">Choose the operating model</span>
      <h2>Use one virtual workflow—or connect it to an in-person programme</h2>
      <p>Start with the event format, then configure the meeting, streaming, and attendance path that belongs to it.</p>
    </div>
    <div class="vhx-format-grid">
      {formats.map((format, index) => (
        <article class="vhx-format-card animate-on-scroll" data-animation={index === 0 ? "fadeInLeft" : "fadeInRight"}>
          <div class="vhx-format-card__visual" aria-hidden="true">
            <div class:list={["vhx-format-device", index === 1 && "vhx-format-device--hybrid"]}>
              <span class="vhx-format-device__top"></span>
              <i></i><i></i><i></i>
            </div>
          </div>
          <div class="vhx-format-card__copy">
            <span class="vhx-format-card__number">0{index + 1}</span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
            <strong>{format.cue}</strong>
          </div>
        </article>
      ))}
    </div>
    <p class="vhx-format-note">EventHex coordinates the event workflow; Zoom, Meet, or Teams remains the meeting room.</p>
  </section>

  <div class="vhx-capability-band">
    <section class="vhx-platforms">
      <div class="vhx-section-heading vhx-section-heading--dark animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow">Connect your meeting</span>
        <h2>Start with the link your speakers and attendees already know</h2>
        <p>Add the scheduled meeting link to the EventHex event; the platform is identified from the URL and used by the configured bot workflow.</p>
      </div>
      <div class="vhx-platform-grid">
        {meetingPlatforms.map((platform, index) => (
          <article class="vhx-platform-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
            <div class:list={["vhx-platform-card__icon", `is-${platform.tone}`]} aria-hidden="true">
              <span></span><i></i>
            </div>
            <h3>{platform.title}</h3>
            <p>{platform.text}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="vhx-workflows">
    <div class="vhx-workflows__inner">
      <div class="vhx-workflows__heading">
        <span class="vhx-workflows__eyebrow">One session lifecycle</span>
        <h2>From meeting link to <span>usable event record</span></h2>
      </div>
      <div class="vhx-workflows__cards">
        {workflowCards.map((card, cardIndex) => (
          <article class="vhx-workflow-card" style={`--card-index: ${cardIndex}`}>
            <div class="vhx-workflow-card__copy">
              <span>{card.eyebrow}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
            <div class="vhx-workflow-card__visual">
              <div class:list={["vhx-workflow-ui", `vhx-workflow-ui--${card.visual}`]}>
                <div class="vhx-workflow-ui__bar"><i></i><i></i><i></i><span>{card.eyebrow}</span></div>
                <div class="vhx-workflow-ui__list">
                  {card.items.map(([title, text], index) => (
                    <div class="vhx-workflow-ui__item">
                      <b>{String(index + 1).padStart(2, "0")}</b>
                      <span><strong>{title}</strong><small>{text}</small></span>
                      <i aria-hidden="true"></i>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
        <div class="vhx-workflows__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="vhx-evidence">
    <div class="vhx-evidence__intro animate-on-scroll" data-animation="fadeInUp">
      <span class="vhx-eyebrow">Virtual check-in</span>
      <h2>Give registered attendees a controlled path into the online session</h2>
      <p>Enable a virtual check-in link, choose when it opens, and use the registration-aware entry path instead of distributing only the raw meeting URL.</p>
    </div>
    <div class="vhx-evidence-grid">
      <div class="vhx-evidence-media animate-on-scroll" data-animation="fadeInLeft">
        <div class="vhx-checkin-ui">
          <div class="vhx-checkin-ui__head"><span>Virtual check-in</span><i>Live</i></div>
          <div class="vhx-checkin-ui__link"><small>Gated event link</small><strong>Event-specific virtual check-in URL</strong></div>
          <div class="vhx-checkin-ui__row"><span>Opening window</span><strong>Before the event</strong></div>
          <div class="vhx-checkin-ui__row"><span>Attendee verification</span><strong>OTP entry flow</strong></div>
          <div class="vhx-checkin-ui__status"><i></i><span>Attendance record</span><strong>Registration match</strong></div>
        </div>
      </div>
      <div class="vhx-evidence-copy animate-on-scroll" data-animation="fadeInRight">
        <ol>
          <li><span>01</span><div><h3>Gated event link</h3><p>Generate or regenerate an event-specific virtual check-in URL.</p></div></li>
          <li><span>02</span><div><h3>Opening window</h3><p>Choose how long before the event the check-in path opens.</p></div></li>
          <li><span>03</span><div><h3>Attendee verification</h3><p>Use the supported OTP entry flow to identify the attendee.</p></div></li>
          <li><span>04</span><div><h3>Attendance record</h3><p>Connect virtual participation back to the registration where a match is available.</p></div></li>
        </ol>
      </div>
    </div>

    <div class="vhx-evidence__intro animate-on-scroll" data-animation="fadeInUp">
      <span class="vhx-eyebrow">Hybrid attendance context</span>
      <h2>See who joined, when they participated, and how the session progressed</h2>
      <p>EventHex retains supported virtual participant data and attaches it to attendee records so operations can review the online side of the event alongside the wider programme.</p>
    </div>
    <div class="vhx-attendance-grid">
      {attendanceItems.map(([title, text], index) => (
        <article class="vhx-attendance-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 50)}>
          <span>0{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          <div aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </article>
      ))}
    </div>

    <div class="vhx-evidence-split vhx-evidence-split--language">
      <div class="vhx-evidence-copy-block animate-on-scroll" data-animation="fadeInLeft">
        <span class="vhx-eyebrow">Live transcription options</span>
        <h2>Scope captions and translation to the session experience you need</h2>
        <p>EventHex contains live transcription and translation paths, but language coverage and delivery depend on the configured session and speech provider.</p>
        <div class="vhx-qualification">Confirm languages, provider, latency expectations, attendee surface, and event format during the demo; do not assume universal coverage.</div>
      </div>
      <div class="vhx-language-cards animate-on-scroll" data-animation="fadeInRight">
        <article>
          <span>01</span><h3>Live transcript experience</h3>
          <p>Surface spoken content as text in the supported attendee-facing session experience.</p>
          <strong>Best for accessible session follow-along</strong>
        </article>
        <article>
          <span>02</span><h3>Translated subtitle experience</h3>
          <p>Show translated text where the selected language and transcription configuration support it.</p>
          <strong>Best for multilingual audience planning</strong>
        </article>
      </div>
    </div>

    <div class="vhx-evidence-split vhx-evidence-split--recap">
      <div class="vhx-recap-ui animate-on-scroll" data-animation="fadeInLeft">
        <div class="vhx-recap-ui__head"><span>After the session</span><i>Insights ready</i></div>
        <div class="vhx-recap-ui__timeline">
          <div><b>01</b><span><strong>Recording ready</strong><small>Open the processed session media.</small></span></div>
          <div><b>02</b><span><strong>Transcript ready</strong><small>Review text, timestamps, and available speaker labels.</small></span></div>
          <div><b>03</b><span><strong>Insights ready</strong><small>Use generated summary and key-insight outputs where configured.</small></span></div>
          <div><b>04</b><span><strong>Recap handoff</strong><small>Open the connected InstaRecap experience for attendee-facing follow-up.</small></span></div>
        </div>
      </div>
      <div class="vhx-evidence-copy-block animate-on-scroll" data-animation="fadeInRight">
        <span class="vhx-eyebrow">After the session</span>
        <h2>Move from raw recording to a session record people can revisit</h2>
        <p>Keep the available media and transcript together, review generated insights, and continue into the public recap workflow when it is enabled for the event.</p>
      </div>
    </div>
  </section>

  <section class="vhx-connected">
    <div class="vhx-section-heading animate-on-scroll" data-animation="fadeInUp">
      <span class="vhx-eyebrow">Connected event operations</span>
      <h2>Continue into the feature that owns the next job</h2>
      <p>Virtual delivery works best when access, content, attendance, and follow-up each hand off to the correct EventHex workflow.</p>
    </div>
    <div class="vhx-connected-grid">
      {connectedOperations.map(([title, text, href], index) => (
        <a class="vhx-connected-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)} href={href}>
          <span>0{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          <i aria-hidden="true">→</i>
        </a>
      ))}
    </div>
  </section>

  <section class="vhx-event-types">
    <div class="vhx-section-heading animate-on-scroll" data-animation="fadeInUp">
      <span class="vhx-eyebrow">Built for programmed events</span>
      <h2>Use the same operating model across high-value session formats</h2>
      <p>Configure each event around its audience, programme, and delivery plan.</p>
    </div>
    <div class="vhx-event-type-grid">
      {eventTypes.map(([title, text], index) => (
        <article class="vhx-event-type-card animate-on-scroll" data-animation="fadeInUp" data-delay={String((index % 4) * 50)}>
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="vhx-faq">
    <div class="vhx-faq__inner">
      <div class="vhx-faq__sidebar animate-on-scroll" data-animation="fadeInLeft">
        <span class="vhx-faq__eyebrow">Virtual and hybrid event questions</span>
        <h2>What organizers ask before connecting a meeting</h2>
      </div>
      <div class="vhx-faq__list">
        {faqs.map(([question, answer], index) => (
          <details class="vhx-faq__item animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 45)} data-vhx-faq open={index === 0}>
            <summary><strong>{question}</strong><span aria-hidden="true"></span></summary>
            <div><p>{answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-final-cta">
    <div class="vhx-final-cta__inner animate-on-scroll" data-animation="fadeInUp">
      <span>Map one live session</span>
      <h2>Bring your virtual or hybrid run-of-show to the demo</h2>
      <p>Show us the meeting platform, event format, streaming destinations, access path, and post-session outcome you need. We’ll walk through the matching EventHex workflow and qualify provider-dependent pieces before launch.</p>
      <a href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</div>

<script>
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-vhx-faq]"));
  faqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const workflow = document.querySelector<HTMLElement>(".vhx-workflows");
  const workflowHeading = workflow?.querySelector<HTMLElement>(".vhx-workflows__heading");
  const workflowCards = workflow?.querySelectorAll<HTMLElement>(".vhx-workflow-card");
  const finalWorkflowCard = workflowCards?.[workflowCards.length - 1];
  if (workflowHeading && finalWorkflowCard) {
    let frame = 0;
    const syncRelease = () => {
      frame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalWorkflowCard).top) || 0;
      const releaseOffset = Math.min(0, finalWorkflowCard.getBoundingClientRect().top - stickyTop);
      workflowHeading.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueRelease = () => {
      if (frame) return;
      frame = requestAnimationFrame(syncRelease);
    };
    window.addEventListener("scroll", queueRelease, { passive: true });
    window.addEventListener("resize", queueRelease, { passive: true });
    syncRelease();
  }
</script>

<style>
  .vhx-page {
    --vhx-ink: var(--heading-dark, #1e1d24);
    --vhx-muted: var(--subheading-gray, #596579);
    --vhx-blue: var(--brand-blue, #375dfb);
    overflow: clip;
    background:
      radial-gradient(circle 360px at 2% 38%, rgba(175, 163, 255, .18), transparent 100%),
      radial-gradient(circle 320px at 98% 68%, rgba(255, 182, 213, .16), transparent 100%),
      #fff;
  }
  .vhx-eyebrow {
    color: var(--vhx-blue);
    font: 600 14px/1.35 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .vhx-section-heading {
    width: min(860px, 100%);
    margin: 0 auto 48px;
    text-align: center;
  }
  .vhx-section-heading h2,
  .vhx-evidence__intro h2,
  .vhx-evidence-copy-block h2 {
    margin: 12px 0 16px;
    color: var(--vhx-ink);
    font: 500 clamp(36px, 5vw, 56px)/1.08 var(--font-heading);
    letter-spacing: -.04em;
  }
  .vhx-section-heading p,
  .vhx-evidence__intro p,
  .vhx-evidence-copy-block > p {
    margin: 0 auto;
    color: var(--vhx-muted);
    font: 400 17px/1.65 var(--font-body);
  }

  .vhx-hero {
    position: relative;
    margin-top: -90px;
    padding: 144px 24px 72px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, rgba(55, 93, 251, .14), transparent 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, rgba(255, 116, 184, .24), transparent 78%),
      #fff;
  }
  .vhx-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 2;
    width: min(220px, 30vw);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .72) 70%, rgba(255, 255, 255, .88));
    pointer-events: none;
  }
  .vhx-hero__grid {
    display: grid;
    grid-template-columns: minmax(320px, 542px) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    width: min(1080px, 100%);
    margin: 0 auto;
  }
  .vhx-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .vhx-hero__title {
    margin: 0;
    color: transparent;
    background: linear-gradient(98deg, var(--vhx-ink) 43%, #8f8f8f 92%);
    -webkit-background-clip: text;
    background-clip: text;
    font: 500 clamp(44px, 5vw, 60px)/1.06 var(--font-heading);
    letter-spacing: -.045em;
  }
  .vhx-hero__copy { margin: 0; color: var(--vhx-muted); font: 400 18px/1.55 var(--font-body); }
  .vhx-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px; }
