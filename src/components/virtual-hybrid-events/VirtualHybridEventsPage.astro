  .vhx-usecases__header h2 {
    max-width: 820px;
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
