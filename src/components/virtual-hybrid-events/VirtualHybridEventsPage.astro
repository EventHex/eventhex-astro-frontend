];

const setupCards = [
  {
    title: "Attach the meeting link",
    body: "Add the scheduled Zoom, Google Meet, or Microsoft Teams link to the event. The platform is identified from the URL and used by the configured bot workflow.",
    icon: "link",
    visual: "link",
  },
  {
    title: "Control the meeting bot",
    body: "Set the bot display name, welcome message, camera image, auto screen share, and whether the bot joins automatically at event start.",
    icon: "bot",
    visual: "bot",
  },
  {
    title: "Configure streaming first",
    body: "Add YouTube, Facebook, or custom RTMP destinations with the stream details supplied by each platform before the bot joins the meeting.",
    icon: "cast",
    visual: "stream",
  },
  {
    title: "Keep outputs provider-scoped",
    body: "Recording, transcript, participants, and chat depend on the configured provider, meeting permissions, and successful bot admission.",
    icon: "file",
    visual: "outputs",
  },
];

const workflowCards = [
  {
    eyebrow: "Meeting bot control",
    title: "Prepare the bot before the room opens",
    text: "Configure the identity and joining behavior, then start the bot manually or use the supported auto-join setting for the event schedule.",
    image: "/feature-images/virtual-hybrid-events/meeting-bot-settings.jpg",
    alt: "EventHex meeting bot settings showing the bot display name, welcome message, auto screen share, and auto join options",
  },
  {
    eyebrow: "Capture the session",
    title: "Turn the live room into a recording and transcript your team can use",
    text: "After processing, supported provider paths surface the session recording, timestamped transcript, and AI insights inside the event workspace.",
    image: "/feature-images/virtual-hybrid-events/meeting-recording-insights.jpg",
    alt: "EventHex recording and transcript tab with a processed session recording and generated key insights",
  },
  {
    eyebrow: "Optional live streaming",
    title: "Send the meeting feed to the destinations your broadcast plan requires",
    text: "Before the bot starts, enable streaming and add one or more supported destinations with the stream details supplied by each platform.",
    image: "/feature-images/virtual-hybrid-events/live-streaming-destinations.jpg",
    alt: "EventHex live streaming settings with YouTube Live, Facebook Live, and custom RTMP destinations",
  },
];

const attendanceItems = [
  "Unique participants",
  "Join and leave times",
  "Speaking time",
  "Screen share usage",
  "Registration match",
  "Event-level review",
];

const evidenceRows = [
  {
    number: "01",
    eyebrow: "Virtual check-in",
    title: "Give registered attendees a controlled path into the online session",
    text: "Enable a virtual check-in link, choose how long before the event it opens, and share the gated entry instead of the raw meeting URL.",
    bullets: ["Event-specific virtual check-in URL", "Opening window before the event", "Registration-aware OTP entry flow"],
    image: "/feature-images/virtual-hybrid-events/virtual-check-in-link.jpg",
    alt: "EventHex virtual meeting page showing the meeting link, virtual check-in toggle, and gated attendee entry link",
  },
  {
    number: "02",
    eyebrow: "Virtual attendance",
    title: "See who joined, how long they stayed, and how the session progressed",
    text: "EventHex keeps the meeting attendance record inside the organizer workspace so the online side of the event stays reviewable.",
    bullets: attendanceItems,
    image: "/feature-images/virtual-hybrid-events/virtual-attendance-report.jpg",
    alt: "EventHex virtual attendance report listing participants with platform, join and leave times, duration, speaking time, and screen share",
  },
  {
    number: "03",
    eyebrow: "Transcript and insights",
    title: "Move from raw recording to a session record people can revisit",
    text: "Keep the available media and transcript together, review generated insights, and continue into the recap workflow when it is enabled for the event.",
    bullets: ["Timestamped speaker transcript", "Generated key insights", "Public recap handoff"],
    image: "/feature-images/virtual-hybrid-events/timestamped-transcript.jpg",
    alt: "EventHex timestamped session transcript with named speakers and a YouTube connection panel",
  },
  {
    number: "04",
    eyebrow: "Meeting overview",
    title: "Review the whole virtual session at a glance",
    text: "Participants, duration, speaking time, and the speaker timeline sit above the attendance report for the meeting the bot joined.",
    bullets: ["Participants and duration", "Speaking time and messages", "Speaker timeline"],
    image: "/feature-images/virtual-hybrid-events/virtual-meeting-overview.jpg",
    alt: "EventHex virtual meeting overview showing participants, duration, speaking time, messages, and a speaker timeline",
  },
];

const connectedOperations = [
  ["Event Registration", "Collect attendee details and route people into the selected virtual or hybrid experience.", "/event-registration/"],
  ["Event Check-In", "Coordinate onsite arrival for the in-person side of a hybrid event.", "/event-check-in/"],
  ["AI Session Recap", "Create the attendee-facing transcript, takeaways, and recap experience.", "/ai-session-recap/"],
  ["Event Analytics", "Review broader event performance beyond the individual meeting session.", "/event-analytics/"],
];

const eventTypes = [
  {
    id: "conferences",
    label: "Conferences",
    title: "Keep multi-session programmes connected",
    text: "Run multi-session programmes with remote access and post-session records.",
    checklist: ["Scheduled meeting access", "Virtual attendance records", "Post-session recordings and insights"],
    image: "/feature-images/virtual-hybrid-events/virtual-attendance-report.jpg",
    alt: "EventHex virtual attendance report for a conference session",
    visualLabel: "Attendance connected",
  },
  {
    id: "associations",
    label: "Association events",
    title: "Connect recurring member sessions",
    text: "Connect recurring member sessions to registration and attendance.",
    checklist: ["Registration-aware virtual entry", "Scheduled member sessions", "Participation records in one event"],
    image: "/feature-images/virtual-hybrid-events/virtual-check-in-link.jpg",
    alt: "EventHex virtual check-in setup for a registered online audience",
    visualLabel: "Member access ready",
  },
  {
    id: "corporate",
    label: "Corporate events",
    title: "Control the room before it opens",
    text: "Coordinate internal or external virtual programmes with controlled access.",
    checklist: ["Configured meeting bot identity", "Controlled attendee entry", "Session outputs for follow-up"],
    image: "/feature-images/virtual-hybrid-events/meeting-bot-settings.jpg",
    alt: "EventHex meeting bot controls for a corporate virtual event",
    visualLabel: "Bot configured",
  },
  {
    id: "tech",
    label: "Tech conferences",
    title: "Extend product talks beyond the room",
    text: "Extend product talks and panels to remote viewers and recap journeys.",
    checklist: ["Supported live destinations", "Recording and transcript workflow", "Insights ready for the recap"],
    image: "/feature-images/virtual-hybrid-events/live-streaming-destinations.jpg",
    alt: "EventHex live streaming destinations for a technology conference",
    visualLabel: "Streaming destinations ready",
  },
  {
    id: "exhibitions",
    label: "Exhibitions",
    title: "Join onsite and remote programme moments",
    text: "Support hybrid briefings, exhibitor sessions, or streamed programme content.",
    checklist: ["In-person and virtual locations", "Remote exhibitor briefings", "Shared attendance reporting"],
    image: "/feature-images/virtual-hybrid-events/hybrid-location-setup.png",
    alt: "EventHex hybrid location setup for an exhibition programme",
    visualLabel: "Hybrid venue linked",
  },
  {
    id: "recorded",
    label: "Recorded events",
    title: "Give live sessions a useful second life",
    text: "Capture a scheduled live session and reuse its approved output after processing.",
    checklist: ["Processed session recording", "Timestamped transcript", "Insights and recap handoff"],
    image: "/feature-images/virtual-hybrid-events/meeting-recording-insights.jpg",
    alt: "EventHex recording, transcript, and insights workspace for a completed session",
    visualLabel: "Session outputs ready",
  },
];

const faqs = [
  ["Does EventHex replace Zoom, Google Meet, or Microsoft Teams?", "No. EventHex uses the supported meeting link and adds event operations around it, including bot control, streaming configuration, attendance, session outputs, and follow-up."],
  ["Can the meeting bot join automatically?", "A supported auto-join setting exists alongside manual start. Confirm the event schedule, waiting-room behavior, provider, and host permissions before relying on it."],
  ["Can we stream to more than one destination?", "The organizer can configure YouTube, Facebook, or custom RTMP destinations, including multiple destination entries. RTMP availability still depends on the active meeting-bot provider and valid stream credentials."],
  ["Are recording and transcripts always available?", "They depend on the configured provider, meeting permissions, bot admission, processing success, and feature setup. EventHex shows the outputs and states available for that session; it does not guarantee every meeting will be captured."],
  ["How does virtual check-in work?", "Organizers can enable a gated event link and opening window. The supported OTP path identifies the attendee and can connect the resulting virtual attendance to a registration."],
  ["Does EventHex support live captions and translation?", "EventHex has live transcription and translation paths, but supported languages, attendee surfaces, and behavior depend on the chosen provider and session configuration. Confirm the exact requirement during the demo."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};

const icons = {
  link: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6-6"/><path d="M11 6.5l1.5-1.5a4 4 0 116 6L17 12.5"/><path d="M13 17.5L11.5 19a4 4 0 11-6-6L7 11.5"/></svg>',
  bot: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 8V4"/><circle cx="12" cy="3" r="1.4"/><path d="M9.5 13h.01M14.5 13h.01"/><path d="M9.5 16.5h5"/></svg>',
  cast: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18a9 9 0 019 9"/><path d="M3 14a13 13 0 0113 13"/><rect x="3" y="4" width="18" height="12" rx="2.5"/></svg>',
  file: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>',
};
---

<div class="vhx-page">
  <section class="vhx-hero">
    <div class="vhx-hero__grid">
      <div class="vhx-hero__content">
        <span class="vhx-eyebrow animate-on-scroll" data-animation="fadeInDown">Virtual &amp; hybrid events</span>
        <h1 class="vhx-hero__title animate-on-scroll" data-animation="fadeInUp">
          Run virtual and hybrid events around the meeting tools your audience already uses
        </h1>
        <p class="vhx-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Connect Zoom, Google Meet, or Microsoft Teams to EventHex, control a meeting bot, and keep streaming,
          attendance, recordings, transcripts, and post-session follow-up tied to the event.
        </p>
        <div class="vhx-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          <span>Use the meeting room you already planned</span>
          <span>Configure recording and streaming before go-live</span>
          <span>Carry session outcomes into event operations</span>
        </div>
        <div class="vhx-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a class="vhx-btn vhx-btn--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="vhx-btn vhx-btn--secondary" href="#vhx-workspace">See how it works</a>
        </div>
      </div>

      <div class="vhx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="vhx-hero__visual-card">
          <div class="vhx-hero__visual-inner">
            <img
              class="vhx-hero__img"
              src="/feature-images/virtual-hybrid-events/virtual-event-setup.jpg"
              alt="EventHex event setup showing the Virtual and Hybrid location options, the connected meeting link, and the AI meeting bot card"
              width="1280"
              height="980"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vhx-trust" aria-label="Works with your meeting stack">
    <div class="vhx-trust__inner">
      <span class="vhx-trust__label">Works with your meeting stack</span>
      {meetingPlatforms.map((platform) => (
        <span class="vhx-trust__item">{platform}</span>
      ))}
    </div>
  </section>

  <section class="vhx-formats">
    <div class="vhx-formats__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Choose the operating model</span>
        <h2>Use one virtual workflow, or connect it to an in-person programme</h2>
        <p>Start with the event format, then configure the meeting, streaming, and attendance path that belongs to it.</p>
      </header>

      <div class="vhx-flow-quad">
        <article
          class="vhx-flow-quad__cell vhx-flow-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="vhx-flow-quad__title">{formats[0].title}</h3>
          <p class="vhx-flow-quad__text">{formats[0].text}</p>
          <ul class="vhx-flow-quad__list">
            {formats[0].items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span class="vhx-flow-quad__cue">{formats[0].cue}</span>
        </article>

        {formats.map((format, index) => (
          <div
            class="vhx-flow-quad__cell vhx-flow-quad__cell--media animate-on-scroll"
            data-animation={index === 0 ? "fadeInRight" : "fadeInLeft"}
          >
            <div class="vhx-flow-composite">
              <img
                class="vhx-flow-composite__screen vhx-flow-composite__screen--primary"
                src={format.media.primary.src}
                alt={format.media.primary.alt}
                width={format.media.primary.width}
                height={format.media.primary.height}
                loading="lazy"
              />
              <img
                class="vhx-flow-composite__screen vhx-flow-composite__screen--secondary"
                src={format.media.secondary.src}
                alt={format.media.secondary.alt}
                width={format.media.secondary.width}
                height={format.media.secondary.height}
                loading="lazy"
              />
              <img
                class="vhx-flow-composite__screen vhx-flow-composite__screen--detail"
                src={format.media.detail.src}
                alt={format.media.detail.alt}
                width={format.media.detail.width}
                height={format.media.detail.height}
                loading="lazy"
              />
              <span class="vhx-flow-composite__status">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                {format.status}
              </span>
              <span class="vhx-flow-composite__action">{format.action}</span>
              <img
                class="vhx-flow-composite__cursor"
                src="/feature-images/event-registration/cursor.svg"
                alt=""
                aria-hidden="true"
              />
            </div>
          </div>
        ))}

        <article
          class="vhx-flow-quad__cell vhx-flow-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="vhx-flow-quad__title">{formats[1].title}</h3>
          <p class="vhx-flow-quad__text">{formats[1].text}</p>
          <ul class="vhx-flow-quad__list">
            {formats[1].items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span class="vhx-flow-quad__cue">{formats[1].cue}</span>
        </article>

        <span class="vhx-flow-quad__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" />
          </svg>
        </span>
      </div>

      <p class="vhx-formats__note">
        EventHex coordinates the event workflow; Zoom, Meet, or Teams remains the meeting room.
      </p>
    </div>
  </section>

  <section class="vhx-setup">
    <div class="vhx-setup__inner">
      <header class="vhx-setup__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Before you go live</span>
        <h2>Set up the <span>virtual event</span></h2>
      </header>

      <div class="vhx-setup-cap">
        {setupCards.map((card, index) => (
          <article
            class="vhx-setup-cap__cell animate-on-scroll"
            data-animation="fadeInUp"
            data-delay={index * 60}
          >
            {index === 1 && (
              <>
                <span class="vhx-setup-cap__petal vhx-setup-cap__petal--top" aria-hidden="true">
                  <svg width="28" height="28" viewBox="-14 -14 28 28">
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" />
                  </svg>
                </span>
                <span class="vhx-setup-cap__petal vhx-setup-cap__petal--bottom" aria-hidden="true">
                  <svg width="28" height="28" viewBox="-14 -14 28 28">
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)" />
                  </svg>
                </span>
              </>
            )}
            {index === 3 && (
              <span class="vhx-setup-cap__petal vhx-setup-cap__petal--bottom" aria-hidden="true">
                <svg width="28" height="28" viewBox="-14 -14 28 28">
                  <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)" />
                </svg>
              </span>
            )}

            <h3 class="vhx-setup-cap__label">{card.title}</h3>
            <p class="vhx-setup-cap__desc">{card.body}</p>

            <div class="vhx-setup-cap__visual" aria-hidden="true">
              {card.visual === "link" && (
                <div class="vhx-setup-ui vhx-setup-ui--link">
                  <span class="vhx-setup-ui__heading">Meeting room</span>
                  <div class="vhx-setup-ui__provider">
                    <span class="vhx-setup-ui__icon" set:html={icons[card.icon as keyof typeof icons]} />
                    <strong>Google Meet</strong>
                    <span class="vhx-setup-ui__badge">Detected</span>
                  </div>
                  <div class="vhx-setup-ui__connection">
                    <span>Meeting link connected</span>
                    <i></i>
                  </div>
                </div>
              )}

              {card.visual === "bot" && (
                <div class="vhx-setup-ui vhx-setup-ui--settings">
                  <span class="vhx-setup-ui__heading">Meeting bot settings</span>
                  <div class="vhx-setup-ui__setting">
                    <span>Display name</span>
                    <strong>EventHex AI</strong>
                  </div>
                  <div class="vhx-setup-ui__setting">
                    <span>Auto join</span>
                    <i class="vhx-setup-ui__toggle is-on"></i>
                  </div>
                  <div class="vhx-setup-ui__setting">
                    <span>Auto screen share</span>
                    <i class="vhx-setup-ui__toggle is-on"></i>
                  </div>
                </div>
              )}

              {card.visual === "stream" && (
                <div class="vhx-setup-ui vhx-setup-ui--destinations">
                  <span class="vhx-setup-ui__heading">Streaming destinations</span>
                  <div class="vhx-setup-ui__destination"><i class="is-youtube"></i><span>YouTube</span><strong>Ready</strong></div>
                  <div class="vhx-setup-ui__destination"><i class="is-facebook"></i><span>Facebook</span><strong>Ready</strong></div>
                  <div class="vhx-setup-ui__destination"><i class="is-rtmp"></i><span>Custom RTMP</span><strong>Configured</strong></div>
                </div>
              )}

              {card.visual === "outputs" && (
                <div class="vhx-setup-ui vhx-setup-ui--outputs">
                  <span class="vhx-setup-ui__heading">Session outputs</span>
                  <div class="vhx-setup-ui__output"><span>Recording</span><strong>Provider</strong></div>
                  <div class="vhx-setup-ui__output"><span>Transcript</span><strong>Provider</strong></div>
                  <div class="vhx-setup-ui__output"><span>Participants</span><strong>Provider</strong></div>
                  <div class="vhx-setup-ui__output"><span>Chat</span><strong>Permissions</strong></div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-dark">
    <div class="vhx-dark__inner">
      <header class="vhx-dark__header">
        <div class="vhx-dark__eyebrow">
          <span class="vhx-dark__eyebrow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.4 2.5-5Z" fill="#4F8CFF" />
              <path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF" />
            </svg>
          </span>
          <span>From setup to session outputs</span>
        </div>
        <h2>Run the session <span>lifecycle</span></h2>
      </header>

      <div class="vhx-dark__cards" id="vhx-stacking-cards">
        {workflowCards.map((card, index) => (
          <article class="vhx-dark-card" data-card-index={index} style={`--card-index: ${index};`}>
            <div class="vhx-dark-card__copy">
              <span class="vhx-dark-card__eyebrow">{card.eyebrow}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
