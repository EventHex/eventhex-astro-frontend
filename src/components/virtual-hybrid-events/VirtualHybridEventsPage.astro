    .vhx-setup-cap__desc { max-width: none; }
    .vhx-usecase-panel { grid-template-columns: 1fr; gap: 48px; }
    .vhx-usecases__header p { max-width: 700px; }
  }

  @media (max-width: 767px) {
    .vhx-hero { padding: 128px 16px 48px; }
    .vhx-hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .vhx-hero__title { font-size: 40px; line-height: 1.08; letter-spacing: -1.2px; }
    .vhx-hero__desc { font-size: 16px; }
    .vhx-hero__cta { flex-direction: column; width: 100%; }
    .vhx-btn { width: 100%; flex: 0 0 auto; padding-inline: 20px; white-space: nowrap; }
    .vhx-hero__img { max-height: 320px; }
    .vhx-trust__inner { width: min(100% - 32px, 1120px); gap: 12px 24px; padding: 22px 0; }
    .vhx-trust__label { width: 100%; text-align: center; }
    .vhx-section__header h2 { font-size: 32px; }
    .vhx-section__header p { font-size: 16px; }
    .vhx-formats { padding: 64px 16px 0; }
