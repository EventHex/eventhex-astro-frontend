    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .vhx-usecases__header h2 span { display: block; }
  .vhx-usecases__header p {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-body);
    font-size: 17.5px;
    font-weight: 500;
