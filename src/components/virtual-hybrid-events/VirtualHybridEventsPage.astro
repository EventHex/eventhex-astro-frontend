---
const lifecycle = [
  { title: "Connect", text: "Meeting link" },
  { title: "Join", text: "EventHex bot" },
  { title: "Capture", text: "Recording + transcript" },
  { title: "Stream", text: "RTMP destinations" },
  { title: "Track", text: "Virtual attendance" },
  { title: "Follow up", text: "Recap + insights" },
];

const meetingPlatforms = [
  "Zoom",
  "Google Meet",
  "Microsoft Teams",
  "YouTube Live",
  "Facebook Live",
  "Custom RTMP",
];

const formats = [
  {
    title: "Virtual event",
    text: "Use the meeting link, bot, virtual check-in, recording, transcript, and follow-up as the primary attendee journey.",
    cue: "Best for remote-first programmes",
    items: ["Meeting link as the room", "Gated virtual check-in", "Session outputs after processing"],
  },
  {
    title: "Hybrid event",
    text: "Run the meeting workflow alongside onsite check-in and event-day operations while keeping the same event and sessions at the center.",
    cue: "Best for connected venues and remote audiences",
    items: ["One event, two audiences", "Onsite plus virtual attendance", "Shared sessions and agenda"],
  },
];

const setupCards = [
  {
    title: "Attach the meeting link",
    body: "Add the scheduled Zoom, Google Meet, or Microsoft Teams link to the event. The platform is identified from the URL and used by the configured bot workflow.",
    icon: "link",
  },
  {
    title: "Control the meeting bot",
    body: "Set the bot display name, welcome message, camera image, auto screen share, and whether the bot joins automatically at event start.",
    icon: "bot",
  },
  {
    title: "Configure streaming first",
    body: "Add YouTube, Facebook, or custom RTMP destinations with the stream details supplied by each platform before the bot joins the meeting.",
    icon: "cast",
  },
  {
    title: "Keep outputs provider-scoped",
    body: "Recording, transcript, participants, and chat depend on the configured provider, meeting permissions, and successful bot admission.",
    icon: "file",
  },
];

const workflowCards = [
  {
    eyebrow: "Meeting bot control",
    title: "Prepare the bot before the room opens",
    text: "Configure the identity and joining behavior, then start the bot manually or use the supported auto-join setting for the event schedule.",
    image: "/feature-images/virtual-hybrid-events/meeting-bot-settings.jpg",
    alt: "EventHex meeting bot settings showing the bot display name, welcome message, auto screen share, and auto join options",
  },
  {
    eyebrow: "Capture the session",
    title: "Turn the live room into a recording and transcript your team can use",
    text: "After processing, supported provider paths surface the session recording, timestamped transcript, and AI insights inside the event workspace.",
    image: "/feature-images/virtual-hybrid-events/meeting-recording-insights.jpg",
    alt: "EventHex recording and transcript tab with a processed session recording and generated key insights",
  },
  {
    eyebrow: "Optional live streaming",
    title: "Send the meeting feed to the destinations your broadcast plan requires",
    text: "Before the bot starts, enable streaming and add one or more supported destinations with the stream details supplied by each platform.",
    image: "/feature-images/virtual-hybrid-events/live-streaming-destinations.jpg",
    alt: "EventHex live streaming settings with YouTube Live, Facebook Live, and custom RTMP destinations",
  },
];

const attendanceItems = [
  "Unique participants",
  "Join and leave times",
  "Speaking time",
  "Screen share usage",
  "Registration match",
  "Event-level review",
];

const evidenceRows = [
  {
    number: "01",
    eyebrow: "Virtual check-in",
    title: "Give registered attendees a controlled path into the online session",
    text: "Enable a virtual check-in link, choose how long before the event it opens, and share the gated entry instead of the raw meeting URL.",
    bullets: ["Event-specific virtual check-in URL", "Opening window before the event", "Registration-aware OTP entry flow"],
    image: "/feature-images/virtual-hybrid-events/virtual-check-in-link.jpg",
    alt: "EventHex virtual meeting page showing the meeting link, virtual check-in toggle, and gated attendee entry link",
  },
  {
    number: "02",
    eyebrow: "Virtual attendance",
    title: "See who joined, how long they stayed, and how the session progressed",
    text: "EventHex keeps the meeting attendance record inside the organizer workspace so the online side of the event stays reviewable.",
    bullets: attendanceItems,
    image: "/feature-images/virtual-hybrid-events/virtual-attendance-report.jpg",
    alt: "EventHex virtual attendance report listing participants with platform, join and leave times, duration, speaking time, and screen share",
  },
  {
    number: "03",
    eyebrow: "Transcript and insights",
    title: "Move from raw recording to a session record people can revisit",
    text: "Keep the available media and transcript together, review generated insights, and continue into the recap workflow when it is enabled for the event.",
    bullets: ["Timestamped speaker transcript", "Generated key insights", "Public recap handoff"],
    image: "/feature-images/virtual-hybrid-events/timestamped-transcript.jpg",
    alt: "EventHex timestamped session transcript with named speakers and a YouTube connection panel",
  },
  {
    number: "04",
    eyebrow: "Meeting overview",
    title: "Review the whole virtual session at a glance",
    text: "Participants, duration, speaking time, and the speaker timeline sit above the attendance report for the meeting the bot joined.",
    bullets: ["Participants and duration", "Speaking time and messages", "Speaker timeline"],
    image: "/feature-images/virtual-hybrid-events/virtual-meeting-overview.jpg",
    alt: "EventHex virtual meeting overview showing participants, duration, speaking time, messages, and a speaker timeline",
  },
];

const connectedOperations = [
  ["Event Registration", "Collect attendee details and route people into the selected virtual or hybrid experience.", "/event-registration/"],
  ["Event Check-In", "Coordinate onsite arrival for the in-person side of a hybrid event.", "/event-check-in/"],
  ["AI Session Recap", "Create the attendee-facing transcript, takeaways, and recap experience.", "/ai-session-recap/"],
  ["Event Analytics", "Review broader event performance beyond the individual meeting session.", "/event-analytics/"],
];

const eventTypes = [
  ["Conferences", "Run multi-session programmes with remote access and post-session records."],
  ["Association events", "Connect recurring member sessions to registration and attendance."],
  ["Corporate events", "Coordinate internal or external virtual programmes with controlled access."],
  ["Tech conferences", "Extend product talks and panels to remote viewers and recap journeys."],
  ["Exhibitions", "Support hybrid briefings, exhibitor sessions, or streamed programme content."],
  ["Recorded events", "Capture a scheduled live session and reuse its approved output after processing."],
];

const faqs = [
  ["Does EventHex replace Zoom, Google Meet, or Microsoft Teams?", "No. EventHex uses the supported meeting link and adds event operations around it, including bot control, streaming configuration, attendance, session outputs, and follow-up."],
  ["Can the meeting bot join automatically?", "A supported auto-join setting exists alongside manual start. Confirm the event schedule, waiting-room behavior, provider, and host permissions before relying on it."],
  ["Can we stream to more than one destination?", "The organizer can configure YouTube, Facebook, or custom RTMP destinations, including multiple destination entries. RTMP availability still depends on the active meeting-bot provider and valid stream credentials."],
  ["Are recording and transcripts always available?", "They depend on the configured provider, meeting permissions, bot admission, processing success, and feature setup. EventHex shows the outputs and states available for that session; it does not guarantee every meeting will be captured."],
  ["How does virtual check-in work?", "Organizers can enable a gated event link and opening window. The supported OTP path identifies the attendee and can connect the resulting virtual attendance to a registration."],
  ["Does EventHex support live captions and translation?", "EventHex has live transcription and translation paths, but supported languages, attendee surfaces, and behavior depend on the chosen provider and session configuration. Confirm the exact requirement during the demo."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};

const icons = {
  link: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6-6"/><path d="M11 6.5l1.5-1.5a4 4 0 116 6L17 12.5"/><path d="M13 17.5L11.5 19a4 4 0 11-6-6L7 11.5"/></svg>',
  bot: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 8V4"/><circle cx="12" cy="3" r="1.4"/><path d="M9.5 13h.01M14.5 13h.01"/><path d="M9.5 16.5h5"/></svg>',
  cast: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18a9 9 0 019 9"/><path d="M3 14a13 13 0 0113 13"/><rect x="3" y="4" width="18" height="12" rx="2.5"/></svg>',
  file: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>',
};
---

<div class="vhx-page">
  <section class="vhx-hero">
    <div class="vhx-hero__grid">
      <div class="vhx-hero__content">
        <span class="vhx-eyebrow animate-on-scroll" data-animation="fadeInDown">Virtual &amp; hybrid events</span>
        <h1 class="vhx-hero__title animate-on-scroll" data-animation="fadeInUp">
          Run virtual and hybrid events around the meeting tools your audience already uses
        </h1>
        <p class="vhx-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Connect Zoom, Google Meet, or Microsoft Teams to EventHex, control a meeting bot, and keep streaming,
          attendance, recordings, transcripts, and post-session follow-up tied to the event.
        </p>
        <div class="vhx-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          <span>Use the meeting room you already planned</span>
          <span>Configure recording and streaming before go-live</span>
          <span>Carry session outcomes into event operations</span>
        </div>
        <div class="vhx-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a class="vhx-btn vhx-btn--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="vhx-btn vhx-btn--secondary" href="#vhx-lifecycle">See how it works</a>
        </div>
      </div>

      <div class="vhx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="vhx-hero__visual-card">
          <div class="vhx-hero__visual-inner">
            <img
              class="vhx-hero__img"
              src="/feature-images/virtual-hybrid-events/virtual-event-setup.jpg"
              alt="EventHex event setup showing the Virtual and Hybrid location options, the connected meeting link, and the AI meeting bot card"
              width="1280"
              height="980"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vhx-trust" aria-label="Works with your meeting stack">
    <div class="vhx-trust__inner">
      <span class="vhx-trust__label">Works with your meeting stack</span>
      {meetingPlatforms.map((platform) => (
        <span class="vhx-trust__item">{platform}</span>
      ))}
    </div>
  </section>

  <section class="vhx-formats">
    <div class="vhx-formats__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Choose the operating model</span>
        <h2>Use one virtual workflow, or connect it to an in-person programme</h2>
        <p>Start with the event format, then configure the meeting, streaming, and attendance path that belongs to it.</p>
      </header>

      <div class="vhx-format-grid">
        {formats.map((format, index) => (
          <article class="vhx-format-card animate-on-scroll" data-animation={index === 0 ? "fadeInLeft" : "fadeInRight"}>
            <span class="vhx-format-card__number">0{index + 1}</span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
            <ul class="vhx-format-card__list">
              {format.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <strong>{format.cue}</strong>
          </article>
        ))}
      </div>

      <p class="vhx-formats__note">
        EventHex coordinates the event workflow; Zoom, Meet, or Teams remains the meeting room.
      </p>
    </div>
  </section>

  <section class="vhx-setup">
    <div class="vhx-setup__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Before you go live</span>
        <h2>Set up the virtual event</h2>
      </header>

      <div class="vhx-setup-grid">
        {setupCards.map((card) => (
          <article class="vhx-setup-card animate-on-scroll" data-animation="fadeInUp">
            <span class="vhx-setup-card__icon" set:html={icons[card.icon as keyof typeof icons]} aria-hidden="true" />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-dark">
    <div class="vhx-dark__inner">
      <header class="vhx-dark__header animate-on-scroll" data-animation="fadeInUp">
        <h2>Run the session <span>lifecycle</span></h2>
      </header>

      <div class="vhx-dark__grid">
        {workflowCards.map((card) => (
          <article class="vhx-dark-card animate-on-scroll" data-animation="fadeInUp">
            <div class="vhx-dark-card__copy">
              <span class="vhx-dark-card__eyebrow">{card.eyebrow}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
            <div class="vhx-dark-card__media">
              <img src={card.image} alt={card.alt} width="1117" height="837" loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="vhx-lifecycle" class="vhx-steps" aria-labelledby="vhx-steps-title">
    <div class="vhx-steps__inner">
      <div class="vhx-steps__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow">One session lifecycle</span>
        <h2 id="vhx-steps-title">From meeting link to usable event record</h2>
      </div>
      <div class="vhx-steps__grid">
        {lifecycle.map((item, index) => (
          <div class="vhx-steps__item">
            <small>{String(index + 1).padStart(2, "0")}</small>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-evidence">
    <div class="vhx-evidence__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Inside the virtual meeting workspace</span>
        <h2>What the organizer sees after the bot joins</h2>
        <p>Every view below comes from the EventHex event workspace, not a separate virtual-event dashboard.</p>
      </header>

      <div class="vhx-evidence__rows">
        {evidenceRows.map((row, index) => (
          <article class:list={["vhx-evidence-row", index % 2 === 1 && "vhx-evidence-row--reverse"]}>
            <div class="vhx-evidence-row__copy animate-on-scroll" data-animation="fadeInUp">
              <span class="vhx-evidence-row__number">{row.number}</span>
              <span class="vhx-evidence-row__eyebrow">{row.eyebrow}</span>
              <h3>{row.title}</h3>
              <p>{row.text}</p>
              <ul class="vhx-evidence-row__list">
                {row.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
            <div class="vhx-evidence-row__media animate-on-scroll" data-animation="fadeInUp">
              <img src={row.image} alt={row.alt} width="1117" height="837" loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-usecases">
    <div class="vhx-usecases__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Where it fits</span>
        <h2>Run the programme you already planned, online</h2>
      </header>

      <div class="vhx-usecase-grid">
        {eventTypes.map(([title, text], index) => (
          <article class="vhx-usecase-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 50)}>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-connected">
    <div class="vhx-connected__inner">
      <header class="vhx-section__header animate-on-scroll" data-animation="fadeInUp">
        <span class="vhx-eyebrow vhx-eyebrow--center">Connected event operations</span>
        <h2>Continue into the feature that owns the next job</h2>
        <p>Virtual delivery works best when access, content, attendance, and follow-up each hand off to the correct EventHex surface.</p>
      </header>

      <div class="vhx-connected-grid">
        {connectedOperations.map(([title, text, href]) => (
          <a class="vhx-connected-card animate-on-scroll" data-animation="fadeInUp" href={href}>
            <h3>{title}</h3>
            <p>{text}</p>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-faq">
    <div class="vhx-faq__inner">
      <div class="vhx-faq__sidebar animate-on-scroll" data-animation="fadeInLeft">
        <span class="vhx-faq__eyebrow">Quick Answers</span>
        <h2 class="vhx-faq__heading">Virtual &amp; Hybrid<br />Questions, Answered.</h2>
        <p class="vhx-faq__intro">
          Find quick answers about meeting links, bot behaviour, streaming destinations, attendance, and session outputs.
        </p>
        <a href="/contact-en/" class="vhx-faq__cta">
          Visit Help Center
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>

      <div class="vhx-faq__list">
        {faqs.map(([question, answer], index) => (
          <details
            class="vhx-faq__item animate-on-scroll"
            data-animation="fadeInUp"
            data-delay={String(index * 50)}
            data-vhx-faq-item
            open={index === 0}
          >
            <summary>
              <strong>{question}</strong>
              <span class="vhx-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="vhx-faq__answer"><p>{answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="vhx-final-cta">
    <div class="vhx-final-cta__inner animate-on-scroll" data-animation="fadeInUp">
      <span>Virtual &amp; hybrid events</span>
      <h2>Ready to run your next session online?</h2>
      <p>
        Connect the meeting room you already use, configure the bot and streaming destinations before go-live, and keep
        attendance and session outputs inside the same event.
      </p>
      <a href="/book-a-demo/">Book a Free Demo</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</div>

<script>
  const vhxFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-vhx-faq-item]"));
  vhxFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      vhxFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<style>
  .vhx-page {
    background:
      radial-gradient(ellipse 760px 520px at -6% 4%, #375dfb1f, #375dfb0a 42%, transparent 76%),
      radial-gradient(ellipse 720px 560px at 104% 26%, #ff74b826, #ff74b80d 46%, transparent 78%),
      radial-gradient(ellipse 700px 520px at 88% 78%, #8f8fff1f, transparent 74%),
      #fff;
  }

  /* ---------- shared ---------- */
  .vhx-eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--brand-blue);
    text-transform: uppercase;
  }
  .vhx-eyebrow--center { justify-content: center; }

  .vhx-section__header {
    max-width: 860px;
    margin: 0 auto clamp(46px, 6vw, 68px);
    text-align: center;
  }
  .vhx-section__header h2 {
    margin: 14px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--heading-dark) 42%, #8f8f8f 94%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .vhx-section__header p {
    margin: 18px auto 0;
    max-width: 660px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    color: var(--body-light);
  }

  .vhx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 30px;
    border-radius: 10px;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.2px;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .vhx-btn--primary {
    color: #fff;
    background: var(--heading-dark);
  }
  .vhx-btn--primary:hover { transform: translateY(-2px); background: #000; }
  .vhx-btn--secondary {
    color: var(--heading-dark);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #dce4ff;
  }
  .vhx-btn--secondary:hover {
    transform: translateY(-2px);
    border-color: #c5d2ff;
    box-shadow: 0 10px 24px rgba(34, 39, 47, 0.06);
  }

  /* ---------- hero ---------- */
  .vhx-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
  }
  .vhx-hero__grid {
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 520px);
    align-items: center;
    gap: 48px;
    max-width: 1128px;
    margin: 0 auto;
  }
  .vhx-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .vhx-hero__title {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-heading);
    font-size: 52px;
    font-weight: 500;
    line-height: 58px;
    letter-spacing: -2.1px;
    background: linear-gradient(98deg, var(--heading-dark) 43%, #8f8f8f 92%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .vhx-hero__desc {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: -0.25px;
    color: var(--subheading-gray);
  }
  .vhx-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vhx-hero__points span {
    position: relative;
    padding-left: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: #475467;
  }
  .vhx-hero__points span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }
  .vhx-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 6px;
  }
  .vhx-hero__visual {
    position: relative;
    margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px));
    z-index: 3;
  }
  .vhx-hero__visual-card {
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-right: none;
    border-radius: 22px 0 0 22px;
    background: linear-gradient(180deg, #ffffff9e, #ffffff47), #ffffff57;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .vhx-hero__visual-inner {
    overflow: hidden;
    border-radius: 16px 0 0 16px;
    background: linear-gradient(135deg, #e7f1fd, #f2f7fd 46%, #fff);
  }
  .vhx-hero__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    object-position: left top;
    animation: vhxHeroFloat 7s ease-in-out infinite;
  }
  @keyframes vhxHeroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ---------- trust strip ---------- */
  .vhx-trust {
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
  }
  .vhx-trust__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 36px;
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
  }
  .vhx-trust__label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7f8898;
  }
  .vhx-trust__item {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: #22272f;
  }

  /* ---------- formats ---------- */
  .vhx-formats {
    padding: clamp(88px, 9vw, 128px) 24px 0;
  }
  .vhx-formats__inner {
    width: min(1120px, 100%);
    margin: 0 auto;
  }
  .vhx-format-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid #ececf2;
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
  }
  .vhx-format-card {
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 4vw, 48px);
  }
  .vhx-format-card + .vhx-format-card {
    border-left: 1px solid #ececf2;
    background: #f8f9fc;
  }
  .vhx-format-card__number {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-blue);
  }
  .vhx-format-card h3 {
    margin: 22px 0 12px;
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #202020;
  }
  .vhx-format-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #656572;
  }
  .vhx-format-card__list {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .vhx-format-card__list li {
    position: relative;
    padding-left: 22px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: #475467;
  }
  .vhx-format-card__list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-blue);
  }
  .vhx-format-card strong {
    align-self: flex-start;
    margin-top: 28px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #eef3ff;
    color: #2b46c8;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }
  .vhx-formats__note {
    margin: 22px 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: #7f8898;
  }

  /* ---------- setup grid ---------- */
  .vhx-setup {
    padding: clamp(88px, 9vw, 128px) 24px;
  }
  .vhx-setup__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-setup-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--surface-card-border);
    border-bottom: 1px solid var(--surface-card-border);
  }
  .vhx-setup-card {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: 30px 28px;
    border-left: 1px solid var(--surface-card-border);
  }
  .vhx-setup-card:first-child { border-left: 0; }
  .vhx-setup-card__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #eef3ff;
    color: var(--brand-blue);
  }
  .vhx-setup-card h3 {
    margin: 46px 0 12px;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #202020;
  }
  .vhx-setup-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #656572;
  }

  /* ---------- dark lifecycle band ---------- */
  .vhx-dark {
    padding: clamp(88px, 9vw, 128px) 24px;
    background:
      radial-gradient(ellipse 900px 420px at 50% -10%, rgba(120, 106, 255, 0.22), transparent 68%),
      #0a0a12;
    color: #fff;
  }
  .vhx-dark__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-dark__header {
    margin: 0 0 clamp(44px, 5vw, 64px);
    text-align: center;
  }
  .vhx-dark__header h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .vhx-dark__header h2 span { color: #a99bff; }
  .vhx-dark__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .vhx-dark-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: radial-gradient(circle at 88% 6%, rgba(120, 106, 255, 0.18), transparent 42%), #101019;
  }
  .vhx-dark-card__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px 28px 24px;
  }
  .vhx-dark-card__eyebrow {
    align-self: flex-start;
    padding: 6px 12px;
    border: 1px solid rgba(169, 155, 255, 0.32);
    border-radius: 999px;
    color: #b6abff;
    background: rgba(169, 155, 255, 0.1);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
  }
  .vhx-dark-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #eceafd;
  }
  .vhx-dark-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
  }
  .vhx-dark-card__media {
    margin-top: auto;
    padding: 0 16px 16px;
  }
  .vhx-dark-card__media img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
  }

  /* ---------- lifecycle steps ---------- */
  .vhx-steps {
    padding: clamp(80px, 8vw, 112px) 24px 0;
  }
  .vhx-steps__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-steps__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 34px;
  }
  .vhx-steps__header h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #202020;
  }
  .vhx-steps__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
  }
  .vhx-steps__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 118px;
    padding: 20px 18px;
    border-left: 1px solid #e8edf5;
  }
  .vhx-steps__item:first-child { border-left: 0; }
  .vhx-steps__item small {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    color: var(--brand-blue);
  }
  .vhx-steps__item strong {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: #202020;
  }
  .vhx-steps__item span {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: #667085;
  }

  /* ---------- evidence rows ---------- */
  .vhx-evidence {
    padding: clamp(88px, 9vw, 128px) 24px;
  }
  .vhx-evidence__inner {
    width: min(1160px, 100%);
    margin: 0 auto;
  }
  .vhx-evidence__rows {
    display: grid;
    gap: 24px;
  }
  .vhx-evidence-row {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 4vw, 56px);
    padding: clamp(28px, 3.4vw, 40px);
    border: 1px solid #efece2;
    border-radius: 22px;
    background: linear-gradient(120deg, #fffdf6, #fdfbf4);
  }
  .vhx-evidence-row--reverse {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }
  .vhx-evidence-row--reverse .vhx-evidence-row__copy { order: 2; }
  .vhx-evidence-row--reverse .vhx-evidence-row__media { order: 1; }
  .vhx-evidence-row__number {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 500;
    line-height: 1;
    color: #202020;
  }
  .vhx-evidence-row__eyebrow {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7b68ee;
  }
  .vhx-evidence-row__copy h3 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #1a1a1a;
  }
  .vhx-evidence-row__copy p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #656572;
  }
  .vhx-evidence-row__list {
    display: grid;
    gap: 10px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .vhx-evidence-row__list li {
    position: relative;
    padding-left: 24px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: #383838;
  }
  .vhx-evidence-row__list li::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 7px;
    width: 7px;
    height: 7px;
    background: #1a1a1a;
    transform: rotate(45deg);
  }
  .vhx-evidence-row__media img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(20, 20, 30, 0.08);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 24px 56px rgba(30, 28, 60, 0.1);
  }

  /* ---------- use cases ---------- */
  .vhx-usecases {
    padding: 0 24px clamp(88px, 9vw, 128px);
  }
  .vhx-usecases__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-usecase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #e8edf5;
    border-left: 1px solid #e8edf5;
  }
  .vhx-usecase-card {
    min-height: 240px;
    padding: 30px 28px;
    border-right: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
    background: rgba(255, 255, 255, 0.7);
  }
  .vhx-usecase-card h3 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #202020;
  }
  .vhx-usecase-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #656572;
  }

  /* ---------- connected ---------- */
  .vhx-connected {
    padding: 0 24px clamp(88px, 9vw, 128px);
  }
  .vhx-connected__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-connected-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
  }
  .vhx-connected-card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 30px 28px;
    border-left: 1px solid #e8edf5;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .vhx-connected-card:first-child { border-left: 0; }
  .vhx-connected-card:hover { background: #fff; transform: translateY(-4px); }
  .vhx-connected-card h3 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #202020;
  }
  .vhx-connected-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #656572;
  }
  .vhx-connected-card span {
    margin-top: auto;
    padding-top: 22px;
    color: var(--brand-blue);
    font-size: 22px;
    line-height: 1;
  }

  /* ---------- FAQ ---------- */
  .vhx-faq {
    width: 100%;
    padding: 80px 24px;
    background: #fff;
  }
  .vhx-faq__inner {
    display: grid;
    grid-template-columns: 360px 1fr;
    align-items: start;
    gap: 64px;
    max-width: 1140px;
    margin: 0 auto;
  }
  .vhx-faq__sidebar { position: sticky; top: 6rem; }
  .vhx-faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    padding: 8px 16px;
    border: 1px solid #e4e7ec;
    border-radius: 999px;
    color: #000;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
  }
  .vhx-faq__heading {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -1px;
    color: #000;
  }
  .vhx-faq__intro {
    margin: 0 0 28px;
    color: var(--body-light);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }
  .vhx-faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .vhx-faq__cta:hover { background: #000; transform: translateY(-1px); }
  .vhx-faq__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    counter-reset: vhx-faq;
  }
  .vhx-faq__item {
    counter-increment: vhx-faq;
    overflow: hidden;
    padding: 4px 28px;
    border: 1px solid #e4e7ec;
    border-radius: 20px;
    background: #fff;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .vhx-faq__item[open] { background: #e4e7ec; }
  .vhx-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
    color: #000;
  }
  .vhx-faq__item summary::-webkit-details-marker { display: none; }
  .vhx-faq__item summary strong { font-weight: 500; }
  .vhx-faq__item summary strong::before { content: counter(vhx-faq) ". "; }
  .vhx-faq__icon {
    position: relative;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vhx-faq__icon::before,
  .vhx-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: #000;
    transform: translate(-50%, -50%);
  }
  .vhx-faq__icon::before { width: 14px; height: 2px; }
  .vhx-faq__icon::after { width: 2px; height: 14px; transition: opacity 0.2s ease; }
  .vhx-faq__item[open] .vhx-faq__icon { transform: scale(0.9); }
  .vhx-faq__item[open] .vhx-faq__icon::after { opacity: 0; }
  .vhx-faq__answer { max-width: 640px; padding: 0 0 24px; }
  .vhx-faq__answer p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: #000;
  }

  /* ---------- final CTA ---------- */
  .vhx-final-cta {
    padding: 24px 24px 72px;
  }
  .vhx-final-cta__inner {
    position: relative;
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: clamp(64px, 8vw, 104px) 24px;
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(circle at 16% 12%, rgba(85, 126, 255, 0.34), transparent 40%),
      radial-gradient(circle at 84% 84%, rgba(163, 108, 255, 0.24), transparent 40%),
      #080b15;
    color: #fff;
    text-align: center;
  }
  .vhx-final-cta__inner > span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ab2ff;
  }
  .vhx-final-cta h2 {
    width: min(760px, 100%);
    margin: 14px auto 18px;
    font-family: var(--font-heading);
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 500;
    line-height: 1.07;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .vhx-final-cta p {
    width: min(720px, 100%);
    margin: 0 auto 30px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.64);
  }
  .vhx-final-cta a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 13px 26px;
    border-radius: 12px;
    background: #fff;
    color: #111522;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 650;
    transition: transform 0.25s ease;
  }
  .vhx-final-cta a:hover { transform: translateY(-2px); }

  /* ---------- responsive ---------- */
  @media (max-width: 1120px) {
    .vhx-hero { padding: 140px 20px 56px; }
    .vhx-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 32px; }
    .vhx-hero__title { font-size: 44px; line-height: 50px; letter-spacing: -1.6px; }
    .vhx-hero__visual { margin-right: 0; }
    .vhx-hero__visual-card { border-right: 1px solid rgba(255, 255, 255, 0.62); border-radius: 22px; }
    .vhx-hero__visual-inner { border-radius: 16px; }
    .vhx-dark__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vhx-connected-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vhx-connected-card:nth-child(3) { border-left: 0; }
    .vhx-connected-card:nth-child(n + 3) { border-top: 1px solid #e8edf5; }
  }

  @media (max-width: 1024px) {
    .vhx-setup-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vhx-setup-card:nth-child(3) { border-left: 0; }
    .vhx-setup-card:nth-child(n + 3) { border-top: 1px solid var(--surface-card-border); }
    .vhx-steps__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .vhx-steps__item:nth-child(4) { border-left: 0; }
