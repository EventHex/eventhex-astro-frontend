        src: "/feature-images/virtual-hybrid-events/hybrid-location-setup.png",
        alt: "EventHex location setup with in-person and virtual options plus the meeting link",
        width: 445,
        height: 247,
      },
      secondary: {
        src: "/feature-images/virtual-hybrid-events/hybrid-registration-method.png",
