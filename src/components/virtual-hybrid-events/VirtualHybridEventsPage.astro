<script>
  const vhxWorkspaceItems = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-vhx-workspace-item]"),
  );
  vhxWorkspaceItems.forEach((item) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".vhx-workspace-step__toggle");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      const label = trigger?.dataset.label ?? "workspace step";
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} ${label}`);
      if (!item.open) return;
      vhxWorkspaceItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const vhxUseCaseTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-vhx-use-tab]"));
  const vhxUseCasePanels = Array.from(document.querySelectorAll<HTMLElement>("[data-vhx-use-panel]"));

  const activateVhxUseCase = (activeTab: HTMLButtonElement) => {
    const target = activeTab.dataset.vhxUseTab;
    vhxUseCaseTabs.forEach((tab) => {
      const selected = tab === activeTab;
      tab.classList.toggle("is-active", selected);
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    vhxUseCasePanels.forEach((panel) => {
      const selected = panel.dataset.vhxUsePanel === target;
      panel.classList.toggle("is-active", selected);
      panel.hidden = !selected;
    });
    activeTab.scrollIntoView({ behavior: "auto", block: "nearest", inline: "center" });
  };

  vhxUseCaseTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateVhxUseCase(tab));
    tab.addEventListener("keydown", (event) => {
      let nextIndex = index;
      if (event.key === "ArrowRight") nextIndex = (index + 1) % vhxUseCaseTabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (index - 1 + vhxUseCaseTabs.length) % vhxUseCaseTabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = vhxUseCaseTabs.length - 1;
      else return;

      event.preventDefault();
      const nextTab = vhxUseCaseTabs[nextIndex];
      activateVhxUseCase(nextTab);
      nextTab.focus();
    });
  });

  const vhxFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-vhx-faq-item]"));
  vhxFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      vhxFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const vhxWorkflowSection = document.querySelector<HTMLElement>(".vhx-dark");
  const vhxWorkflowHeader = vhxWorkflowSection?.querySelector<HTMLElement>(".vhx-dark__header");
  const vhxWorkflowCards = vhxWorkflowSection?.querySelectorAll<HTMLElement>(".vhx-dark-card");
  const vhxFinalWorkflowCard = vhxWorkflowCards?.[vhxWorkflowCards.length - 1];

  if (vhxWorkflowHeader && vhxFinalWorkflowCard) {
    let vhxWorkflowFrame = 0;
    const syncVhxWorkflowRelease = () => {
      vhxWorkflowFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(vhxFinalWorkflowCard).top) || 0;
      const releaseOffset = Math.min(0, vhxFinalWorkflowCard.getBoundingClientRect().top - stickyTop);
      vhxWorkflowHeader.style.setProperty("--vhx-dark-release-y", `${releaseOffset}px`);
      vhxWorkflowHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueVhxWorkflowRelease = () => {
      if (vhxWorkflowFrame) return;
      vhxWorkflowFrame = requestAnimationFrame(syncVhxWorkflowRelease);
    };

    window.addEventListener("scroll", queueVhxWorkflowRelease, { passive: true });
    window.addEventListener("resize", queueVhxWorkflowRelease, { passive: true });
    syncVhxWorkflowRelease();
  }
</script>

