    padding: 9px 12px;
    border: 1px solid #cddcff;
    border-radius: 10px;
    background: #eef4ff;
    box-shadow: 0 8px 22px rgba(49, 88, 212, 0.16);
    color: #3158d4;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vhx-usecase-panel__label svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vhx-usecase-panel:nth-child(2) .vhx-usecase-panel__label,
  .vhx-usecase-panel:nth-child(4) .vhx-usecase-panel__label {
    border-color: #cbeedb;
    background: #eefbf5;
    box-shadow: 0 8px 22px rgba(22, 138, 85, 0.15);
    color: #168a55;
  }
  .vhx-usecase-panel:nth-child(3) .vhx-usecase-panel__label,
  .vhx-usecase-panel:nth-child(5) .vhx-usecase-panel__label {
    border-color: #ded2ff;
    background: #f5f1ff;
    box-shadow: 0 8px 22px rgba(115, 81, 207, 0.16);
    color: #7351cf;
  }
  .vhx-usecase-panel:nth-child(6) .vhx-usecase-panel__label {
    border-color: #f2dfad;
    background: #fff8e8;
    box-shadow: 0 8px 22px rgba(154, 107, 18, 0.15);
    color: #9a6b12;
  }

  /* ---------- connected ---------- */
  .vhx-connected {
    padding: 0 24px clamp(88px, 9vw, 128px);
  }
  .vhx-connected__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .vhx-connected-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
  }
  .vhx-connected-card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 30px 28px;
    border-left: 1px solid #e8edf5;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .vhx-connected-card:first-child { border-left: 0; }
  .vhx-connected-card:hover { background: #fff; transform: translateY(-4px); }
  .vhx-connected-card h3 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #202020;
  }
  .vhx-connected-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #656572;
  }
  .vhx-connected-card span {
    margin-top: auto;
    padding-top: 22px;
    color: var(--brand-blue);
    font-size: 22px;
    line-height: 1;
  }

  /* ---------- FAQ ---------- */
  .vhx-faq {
    width: 100%;
    padding: 80px 24px;
    background: #fff;
  }
  .vhx-faq__inner {
    display: grid;
    grid-template-columns: 360px 1fr;
    align-items: start;
    gap: 64px;
    max-width: 1140px;
    margin: 0 auto;
  }
  .vhx-faq__sidebar { position: sticky; top: 6rem; }
  .vhx-faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    padding: 8px 16px;
    border: 1px solid #e4e7ec;
    border-radius: 999px;
    color: #000;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
  }
  .vhx-faq__heading {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -1px;
    color: #000;
  }
  .vhx-faq__intro {
    margin: 0 0 28px;
    color: var(--body-light);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }
  .vhx-faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .vhx-faq__cta:hover { background: #000; transform: translateY(-1px); }
  .vhx-faq__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    counter-reset: vhx-faq;
  }
  .vhx-faq__item {
    counter-increment: vhx-faq;
    overflow: hidden;
    padding: 4px 28px;
    border: 1px solid #e4e7ec;
    border-radius: 20px;
    background: #fff;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .vhx-faq__item[open] { background: #e4e7ec; }
  .vhx-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
    color: #000;
  }
  .vhx-faq__item summary::-webkit-details-marker { display: none; }
  .vhx-faq__item summary strong { font-weight: 500; }
  .vhx-faq__item summary strong::before { content: counter(vhx-faq) ". "; }
  .vhx-faq__icon {
    position: relative;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vhx-faq__icon::before,
  .vhx-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: #000;
    transform: translate(-50%, -50%);
  }
  .vhx-faq__icon::before { width: 14px; height: 2px; }
  .vhx-faq__icon::after { width: 2px; height: 14px; transition: opacity 0.2s ease; }
  .vhx-faq__item[open] .vhx-faq__icon { transform: scale(0.9); }
  .vhx-faq__item[open] .vhx-faq__icon::after { opacity: 0; }
  .vhx-faq__answer { max-width: 640px; padding: 0 0 24px; }
  .vhx-faq__answer p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: #000;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1120px) {
    .vhx-hero { padding: 140px 20px 56px; }
    .vhx-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 32px; }
    .vhx-hero__title { font-size: 44px; line-height: 50px; letter-spacing: -1.6px; }
    .vhx-hero__visual { margin-right: 0; }
    .vhx-hero__visual-card { border-right: 1px solid rgba(255, 255, 255, 0.62); border-radius: 22px; }
    .vhx-hero__visual-inner { border-radius: 16px; }
    .vhx-connected-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vhx-connected-card:nth-child(3) { border-left: 0; }
