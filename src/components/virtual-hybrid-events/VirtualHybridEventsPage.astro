      margin: 64px 16px;
      padding: 56px 0 32px;
      border-radius: 20px;
    }
    .vhx-setup__inner { width: calc(100% - 32px); }
    .vhx-setup__header { padding: 0 8px 36px; }
    .vhx-setup__header h2 { font-size: 32px; }
    .vhx-setup-cap__cell { padding: 28px 20px; }
    .vhx-dark__inner { padding: 16px 20px 30px; }
    .vhx-dark__header { width: 100%; }
    .vhx-dark__header h2 { font-size: 30px; }
    .vhx-dark__cards {
      --vhx-dark-stack-top: 320px;
      padding-top: 80px;
      padding-bottom: 40px;
    }
    .vhx-dark-card {
      flex-direction: column;
      height: 620px;
    }
    .vhx-dark-card__copy {
      flex: 0 0 54%;
      padding: 20px 20px 0;
    }
    .vhx-dark-card__media {
      margin: 12px;
      padding: 16px;
    }
    .vhx-dark-card h3 { font-size: 24px; }
    .vhx-dark-card p { font-size: 15px; }
    .vhx-dark-card__btn { padding: 10px 22px; }
    .vhx-workspace { padding: 72px 16px; }
    .vhx-workspace__header { margin-bottom: 46px; }
    .vhx-workspace__header h2 { font-size: 42px; }
    .vhx-workspace__header p { font-size: 16px; }
    .vhx-workspace__steps summary,
    .vhx-workspace__steps summary:hover {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 10px;
      min-height: 104px;
      padding: 18px 62px 18px 14px;
    }
    .vhx-workspace-step__toggle { top: 34px; right: 16px; }
    .vhx-workspace-step__number { font-size: 13px; }
    .vhx-workspace-step__content {
      display: flex;
