  .vhx-usecase-tab {
    padding: 8px 16px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #64748b;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }
  .vhx-usecase-tab:hover {
    background: rgba(255, 255, 255, 0.65);
    color: #334155;
  }
  .vhx-usecase-tab:focus-visible {
    outline: 3px solid rgba(59, 130, 246, 0.28);
    outline-offset: 2px;
  }
  .vhx-usecase-tab.is-active {
    border-color: #dbe4f0;
    background: #fff;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
    color: #3b82f6;
  }
  .vhx-usecase-box {
    border: 0;
    background: transparent;
  }
  .vhx-usecase-panel {
    --vhx-usecase-tint: #fff8dc;
    --vhx-usecase-border: #f0dfa6;
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding: 52px 64px;
    border: 1px solid var(--vhx-usecase-border);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--vhx-usecase-tint) 0%, #fff 72%);
    animation: vhx-usecase-enter 0.4s ease forwards;
  }
  .vhx-usecase-panel:nth-child(2) { --vhx-usecase-tint: #edf7ff; --vhx-usecase-border: #d4e7f7; }
  .vhx-usecase-panel:nth-child(3) { --vhx-usecase-tint: #f3efff; --vhx-usecase-border: #e2d8fa; }
  .vhx-usecase-panel:nth-child(4) { --vhx-usecase-tint: #eefbf4; --vhx-usecase-border: #d4efdf; }
  .vhx-usecase-panel:nth-child(5) { --vhx-usecase-tint: #fff0f7; --vhx-usecase-border: #f4d6e5; }
  .vhx-usecase-panel:nth-child(6) { --vhx-usecase-tint: #fff4eb; --vhx-usecase-border: #f4ddc8; }
  .vhx-usecase-panel.is-active { display: grid; }
  @keyframes vhx-usecase-enter {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .vhx-usecase-panel__copy h3 {
    margin: 0 0 18px;
    color: #1f2937;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 42px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }
  .vhx-usecase-panel__copy > p {
    margin: 0 0 32px;
    color: #4b5563;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
  }
  .vhx-usecase-panel__signal {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .vhx-usecase-panel__signal > span:first-child {
    color: #9ca3af;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .vhx-usecase-panel__signal-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #9ca3af;
  }
  .vhx-usecase-panel__signal-icons svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vhx-usecase-panel__copy ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vhx-usecase-panel__copy li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #6b7280;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
  }
  .vhx-usecase-panel__copy li svg {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    fill: none;
    stroke: #9ca3af;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vhx-usecase-panel__visual { min-width: 0; }
  .vhx-usecase-panel__showcase {
    position: relative;
    isolation: isolate;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 22px 48px rgba(31, 41, 55, 0.1);
  }
  .vhx-usecase-panel__showcase::before {
    content: "";
    position: absolute;
    inset: 10% 7% -8%;
    z-index: -1;
    border-radius: 12px;
    background: var(--vhx-usecase-border);
    filter: blur(22px);
    opacity: 0.48;
  }
  .vhx-usecase-panel__showcase > img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
