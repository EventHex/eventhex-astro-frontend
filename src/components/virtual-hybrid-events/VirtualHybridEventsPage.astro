  .vhx-flow-composite__action {
    right: 14px;
    bottom: 14px;
    padding: 10px 13px;
    background: #4b65f6;
    color: #fff;
  }
  .vhx-flow-composite__cursor {
    position: absolute;
    right: 4px;
    bottom: 34px;
    z-index: 6;
    width: 22px;
    height: 26px;
    filter: drop-shadow(0 3px 3px rgba(17, 24, 39, 0.25));
    pointer-events: none;
  }
  .vhx-formats__note {
    margin: 28px auto 0;
    max-width: 920px;
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    color: #667085;
