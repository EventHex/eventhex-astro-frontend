  .vhh-rail li::after { content:""; position:absolute; top:50%; right:-4px; z-index:1; width:7px; height:7px; border-top:1px solid var(--ds-label); border-right:1px solid var(--ds-label); background:var(--ds-white); transform:translateY(-50%) rotate(45deg); }
  .vhh-rail li:last-child::after { display:none; }.vhh-rail li b { font:650 13px/1.2 var(--font-body); }.vhh-rail li span { margin-top:4px; color:var(--ds-muted); font:400 11px/1.3 var(--font-body); }
  @media(max-width:1100px){.vhh-rail{grid-template-columns:1fr}.vhh-rail__heading{align-items:center;border-right:0;border-bottom:1px solid var(--surface-card-border);text-align:center}.vhh-rail__inner{max-width:none}}
  @media(max-width:900px){.vhh-hero__grid{grid-template-columns:1fr}.vhh-hero__visual{margin-right:-24px}.vhh-hero__title{font-size:52px;line-height:1.05}.vhh-rail__inner{grid-template-columns:repeat(3,1fr)}.vhh-rail li:nth-child(3){border-right:0}.vhh-rail li:nth-child(-n+3){border-bottom:1px solid var(--surface-card-border)}}
  @media(max-width:767px){.vhh-hero{padding:128px 18px 48px}.vhh-hero__content{align-items:center;text-align:center}.vhh-hero__title{font-size:42px;line-height:1.04;letter-spacing:-1.7px}.vhh-hero__desc{font-size:16px;line-height:24px}.vhh-hero__cta-row{width:100%}.vhh-hero__btn{justify-content:center;width:100%}.vhh-hero__trust{justify-content:center}.vhh-hero__visual{width:100%;margin-right:0}.vhh-hero__visual-inner{padding:14px}.vhh-console{min-width:430px;transform:scale(.78);transform-origin:left center;margin-right:-96px}.vhh-rail__inner{grid-template-columns:repeat(2,1fr)}.vhh-rail li:nth-child(3){border-right:1px solid var(--surface-card-border)}.vhh-rail li:nth-child(2n){border-right:0}.vhh-rail li:nth-child(-n+4){border-bottom:1px solid var(--surface-card-border)}}
