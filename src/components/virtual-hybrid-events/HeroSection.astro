  .vhh-hero::after { content:""; position:absolute; inset:0 0 0 auto; z-index:2; width:220px; max-width:30vw; background:linear-gradient(to right,rgba(255, 255, 255, 0),rgba(255, 255, 255, 0.45) 70%,rgba(255, 255, 255, 0.75)); pointer-events:none; }
