---
const platforms = [
  { name: "Zoom", copy: "Connect a supported Zoom meeting URL.", mark: "Z" },
  { name: "Google Meet", copy: "Connect a Google Meet room or create the supported calendar-led setup.", mark: "M" },
  { name: "Microsoft Teams", copy: "Connect a supported Teams meeting URL.", mark: "T" },
  { name: "Event context", copy: "Keep the meeting attached to the correct event, schedule, and organizer workspace.", mark: "E" },
];
---

<section id="vhe-formats" class="vhp-flow">
  <header class="vhp-flow__header">
    <span class="vhp-eyebrow">Choose the operating model</span>
    <h2 class="animate-on-scroll" data-animation="fadeInUp">Use one virtual workflow—or connect it to an in-person programme</h2>
    <p>Start with the event format, then configure the meeting, streaming, and attendance path that belongs to it.</p>
  </header>

  <div class="vhp-flow__quad">
    <article class="vhp-flow__cell animate-on-scroll" data-animation="fadeInUp">
      <span class="vhp-choice-label">Remote-first</span>
      <h3>Virtual event</h3>
      <p>Use the meeting link, bot, virtual check-in, recording, transcript, and follow-up as the primary attendee journey.</p>
      <small>Best for remote-first programmes</small>
    </article>
    <div class="vhp-flow__cell vhp-flow__cell--media animate-on-scroll" data-animation="fadeInRight">
      <div class="vhp-format-visual" role="img" aria-label="Virtual event workflow connecting remote attendees to one online session">
        <div class="vhp-room"><span class="vhp-avatar">EH</span><b>Online session</b><i>Bot ready</i></div>
        <div class="vhp-people" aria-hidden="true"><span>MC</span><span>AK</span><span>JL</span></div>
        <div class="vhp-format-line" aria-hidden="true"></div>
      </div>
    </div>
    <div class="vhp-flow__cell vhp-flow__cell--media animate-on-scroll" data-animation="fadeInLeft">
      <div class="vhp-format-visual vhp-format-visual--hybrid" role="img" aria-label="Hybrid event workflow connecting a venue and remote attendees to the same event">
        <div class="vhp-venue"><b>Venue</b><span>Onsite check-in</span></div>
        <div class="vhp-plus" aria-hidden="true">+</div>
        <div class="vhp-room"><span class="vhp-avatar">EH</span><b>Online session</b><i>Bot ready</i></div>
      </div>
    </div>
    <article class="vhp-flow__cell animate-on-scroll" data-animation="fadeInUp">
      <span class="vhp-choice-label">Venue + remote</span>
      <h3>Hybrid event</h3>
      <p>Run the meeting workflow alongside onsite check-in and event-day operations while keeping the same event and sessions at the center.</p>
      <small>Best for connected venues and remote audiences</small>
    </article>
    <span class="vhp-flow__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0A14,14 0 0,1 0,14A14,14 0 0,1 14,0Z" fill="var(--surface-card-border)"></path><path d="M-14,0A14,14 0 0,1 0,14A14,14 0 0,1 14,0Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path><path d="M-14,0A14,14 0 0,1 0,14A14,14 0 0,1 14,0Z" fill="var(--surface-card-border)" transform="rotate(90)"></path><path d="M-14,0A14,14 0 0,1 0,14A14,14 0 0,1 14,0Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path></svg>
    </span>
  </div>
  <p class="vhp-flow__note">EventHex coordinates the event workflow; Zoom, Meet, or Teams remains the meeting room.</p>
</section>

<section class="vhp-dark" aria-labelledby="vhp-platform-title">
  <header class="vhp-dark__header">
    <span class="vhp-eyebrow">Connect your meeting</span>
    <h2 id="vhp-platform-title">Start with the link your speakers and attendees already know</h2>
    <p>Add the scheduled meeting link to the EventHex event; the platform is identified from the URL and used by the configured bot workflow.</p>
  </header>
  <div class="vhp-platforms">
    {platforms.map((platform, index) => (
      <article class="vhp-platform animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
        <div class="vhp-platform__mark" aria-hidden="true">{platform.mark}</div>
        <h3>{platform.name}</h3>
        <p>{platform.copy}</p>
        <div class="vhp-platform__status"><i></i><span>{index === 3 ? "Event workspace" : "Meeting link"}</span></div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Event Registration two-option comparison and dark capability grid. */
  .vhp-flow { display:flex; flex-direction:column; align-items:center; padding:clamp(72px,9vw,112px) 24px; background:#fff; }
  .vhp-flow__header { display:flex; flex-direction:column; align-items:center; max-width:900px; margin-bottom:24px; text-align:center; }
  .vhp-eyebrow { display:block; margin-bottom:12px; color:var(--brand-blue); font:700 12px/1.2 var(--font-body); letter-spacing:.12em; text-transform:uppercase; }
  .vhp-flow__header h2,.vhp-dark__header h2 { margin:0 0 14px; font:500 clamp(32px,4.4vw,52px)/1.08 var(--font-heading); letter-spacing:-.04em; }
  .vhp-flow__header h2 { background:linear-gradient(98deg,var(--heading-dark) 43.06%,#8f8f8f 91.81%); background-clip:text; color:transparent; }
  .vhp-flow__header p { max-width:670px; margin:0; color:var(--subheading-gray); font:400 18px/1.5 var(--font-body); }
  .vhp-flow__quad { position:relative; display:grid; grid-template:1fr 1fr/1fr 1fr; width:100%; max-width:1180px; margin:24px auto; }
  .vhp-flow__cross { position:absolute; left:50%; top:50%; z-index:2; width:18px; height:18px; transform:translate(-50%,-50%); line-height:0; }
  .vhp-flow__cell { display:flex; flex-direction:column; justify-content:center; min-height:300px; padding:56px 48px; border-right:1px solid #eef0f3; border-bottom:1px solid #eef0f3; }
  .vhp-flow__cell:nth-child(2n){border-right:0}.vhp-flow__cell:nth-child(n+3){border-bottom:0}
  .vhp-flow__cell h3 { margin:10px 0 16px; color:var(--heading-dark); font:600 clamp(26px,2.7vw,34px)/1.1 var(--font-heading); }
  .vhp-flow__cell p { max-width:42ch; margin:0; color:var(--subheading-gray); font:400 16px/1.6 var(--font-body); }
  .vhp-flow__cell small { align-self:flex-start; margin-top:20px; padding:7px 10px; border-radius:999px; color:#067647; background:#ecfdf3; font:700 11px/1.2 var(--font-body); }
  .vhp-choice-label { color:#7b8491; font:700 11px/1.2 var(--font-body); letter-spacing:.1em; text-transform:uppercase; }
  .vhp-flow__cell--media { align-items:center; min-height:360px; padding:26px; overflow:hidden; }
  .vhp-format-visual { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; height:300px; border:1px solid #d9e5f4; border-radius:24px; background:linear-gradient(145deg,#eaf3ff,#fff); box-shadow:inset 0 1px #fff; }
  .vhp-format-visual--hybrid { flex-direction:row; gap:17px; background:linear-gradient(145deg,#f1edff,#fff); }
  .vhp-room,.vhp-venue { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; min-width:150px; padding:24px 20px; border:1px solid #dbe2ea; border-radius:17px; background:#fff; box-shadow:0 16px 34px #1f294818; }
  .vhp-avatar { display:grid; place-items:center; width:44px; height:44px; margin-bottom:10px; border-radius:13px; color:#fff; background:#375dfb; font:800 13px/1 var(--font-body); }
  .vhp-room b,.vhp-venue b { font:650 13px/1.3 var(--font-body); }.vhp-room i,.vhp-venue span { margin-top:7px; color:#667085; font:500 10px/1.2 var(--font-body); font-style:normal; }
  .vhp-venue::before { content:""; width:54px; height:36px; margin-bottom:10px; border-radius:8px 8px 2px 2px; background:linear-gradient(90deg,#9aa7b7 15%,transparent 15% 28%,#9aa7b7 28% 43%,transparent 43% 57%,#9aa7b7 57% 72%,transparent 72% 85%,#9aa7b7 85%); border-bottom:7px solid #667085; }
  .vhp-plus { display:grid; place-items:center; width:30px; height:30px; border-radius:50%; color:#667085; background:#fff; box-shadow:0 5px 18px #1f29481a; font:700 18px/1 var(--font-body); }
  .vhp-people { display:flex; gap:8px; margin-top:17px; }.vhp-people span { display:grid; place-items:center; width:32px; height:32px; border:3px solid #fff; border-radius:50%; color:#334155; background:#dce7ff; font:700 9px/1 var(--font-body); }
  .vhp-format-line { position:absolute; top:50%; width:65%; border-top:1px dashed #9cafcc; }
  .vhp-flow__note { max-width:760px; margin:10px auto 0; padding:14px 18px; border-left:3px solid var(--brand-blue); color:#354052; background:#eef3ff; font:500 14px/1.5 var(--font-body); }
  .vhp-dark { padding:clamp(80px,9vw,120px) 24px; color:#fff; background:radial-gradient(110% 70% at 50% 0,#263a72 0,#151827 58%,#0d0f17 100%); }
  .vhp-dark__header { max-width:850px; margin:0 auto 48px; text-align:center; }.vhp-dark__header .vhp-eyebrow{color:#9cb4ff}.vhp-dark__header h2{color:#f5f7fb}.vhp-dark__header p{max-width:700px;margin:0 auto;color:#abb3c1;font:400 17px/1.55 var(--font-body)}
  .vhp-platforms { display:grid; grid-template-columns:repeat(4,1fr); max-width:1180px; margin:0 auto; border:1px solid #3b3a47; border-radius:18px; overflow:hidden; }
  .vhp-platform { position:relative; min-height:310px; padding:30px 27px; border-right:1px solid #3b3a47; background:#181923; }.vhp-platform:last-child{border-right:0}.vhp-platform__mark{display:grid;place-items:center;width:48px;height:48px;margin-bottom:30px;border:1px solid #ffffff21;border-radius:14px;color:#dce5ff;background:#ffffff0c;font:750 18px/1 var(--font-body)}
  .vhp-platform h3 { margin:0 0 13px; color:#f0eff8; font:500 22px/1.2 var(--font-heading); }.vhp-platform p{margin:0;color:#9ea3b1;font:400 14px/1.55 var(--font-body)}.vhp-platform__status{position:absolute;left:27px;right:27px;bottom:27px;display:flex;align-items:center;gap:8px;padding:11px;border:1px solid #ffffff12;border-radius:10px;color:#bfc5d1;background:#ffffff08;font:600 11px/1.2 var(--font-body)}.vhp-platform__status i{width:7px;height:7px;border-radius:50%;background:#5ad6a0}
  @media(max-width:900px){.vhp-flow__cell{padding:38px 28px}.vhp-platforms{grid-template-columns:repeat(2,1fr)}.vhp-platform:nth-child(2){border-right:0}.vhp-platform:nth-child(-n+2){border-bottom:1px solid #3b3a47}}
  @media(max-width:640px){.vhp-flow{padding:68px 18px}.vhp-flow__quad{display:flex;flex-direction:column}.vhp-flow__cell{min-height:0;padding:42px 20px;border-right:0;border-bottom:1px solid #eef0f3}.vhp-flow__cell:nth-child(2){order:2}.vhp-flow__cell:nth-child(3){order:4}.vhp-flow__cell:nth-child(4){order:3}.vhp-flow__cell:nth-child(n+3){border-bottom:1px solid #eef0f3}.vhp-flow__cell:last-of-type{border-bottom:0}.vhp-flow__cross{display:none}.vhp-flow__cell--media{min-height:320px;padding:18px}.vhp-format-visual--hybrid{gap:8px}.vhp-room,.vhp-venue{min-width:120px;padding:20px 12px}.vhp-platforms{grid-template-columns:1fr}.vhp-platform,.vhp-platform:nth-child(2){border-right:0;border-bottom:1px solid #3b3a47}.vhp-platform:last-child{border-bottom:0}}
</style>
