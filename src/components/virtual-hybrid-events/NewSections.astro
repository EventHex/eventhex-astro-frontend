---
// Sections for shipped virtual and hybrid features the page did not mention (approved canvas copy, word for word).
interface Props { which: "A" | "B" | "C"; }
const { which } = Astro.props as Props;
const base = "/feature-images/virtual-hybrid-events/v5/";
---

{which === "A" && (
  <section class="vhn ds-night" id="vhx-one-list" aria-labelledby="vhn-a-title">
    <div class="vhn__split vhn__split--narrow">
      <div class="vhn__copy">
        <span class="ds-eyebrow">Hybrid attendance</span>
        <h2 class="ds-h2" id="vhn-a-title">Onsite and Online Attendance in <span class="ds-hl-dark">One Attendee List</span></h2>
        <p class="ds-body">Virtual check-in and the meeting bot mark the same attendance as onsite check-in, so a hybrid event keeps one list. After the call, participants are matched to registrations by email, name or check-in time. Review the matches, link anyone the bot could not place, then mark attendance. Attendees marked as attended are eligible for certificates by email and WhatsApp.</p>
        <p class="ds-small">Links to <a href="/event-check-in/">Event Check-In</a> and <a href="/certificate-builder/">Certificate Builder</a>.</p>
      </div>
      <div class="ds-browser">
        <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <video class="vhx-loop vhn__loop" autoplay muted loop playsinline preload="metadata" width="1280" height="852" poster={base + "vh-matches-poster.webp"} aria-label="Animated demo: the ended-meeting overview, then Registration Matches: 6 of 7 participants matched, each with the matched registration, an Attended mark and the match method (Email, Name, Name fuzzy), one unmatched participant to link, and Re-run Matching and Mark Attendance buttons">
          <source src={base + "vh-matches.webm"} type="video/webm" />
          <source src={base + "vh-matches.mp4"} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
)}

{which === "B" && (
  <section class="vhn ds-stage" id="vhx-meet-link" aria-labelledby="vhn-b-title">
    <div class="vhn__split vhn__split--wide">
      <div class="ds-glass vhn__panel">
        <div class="ds-shot"><img src={base + "meet-link.webp"} width="2730" height="960" loading="lazy" decoding="async" alt="Event Info for the hybrid event with a meeting link field, the Create a Google Meet Link button and the AI Meeting Bot card" /></div>
      </div>
      <div class="vhn__copy">
        <span class="ds-eyebrow">Meeting link</span>
        <h2 class="ds-h2" id="vhn-b-title">Create the <span class="ds-hl">Google Meet Link</span> in One Click</h2>
        <p class="ds-body">Connect Google Calendar once and create the Google Meet link for the event without leaving EventHex. Zoom and Microsoft Teams links are pasted in.</p>
      </div>
    </div>
  </section>
)}

{which === "C" && (
  <section class="vhn vhn--light" id="vhx-recap-link" aria-labelledby="vhn-c-title">
    <div class="vhn__split vhn__split--mid">
      <div class="vhn__copy">
        <span class="ds-eyebrow">After the call</span>
        <h2 class="ds-h2" id="vhn-c-title">Share the <span class="ds-hl">Recap Link</span>, Keep the Recording</h2>
        <p class="ds-body">When the bot joins, it posts your welcome message in the meeting chat, including a link to the live transcript and recap. Afterwards, download the video or upload it to your YouTube channel, and share the public recap page with its transcript and takeaways.</p>
      </div>
      <div class="vhn__stack">
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <video class="vhx-loop vhn__loop" autoplay muted loop playsinline preload="metadata" width="1280" height="852" poster={base + "vh-recap-poster.webp"} aria-label="Animated demo: the meeting overview, then the Recording tab with the session video, a Download Video button and key insights, then the AI Insights takeaways">
            <source src={base + "vh-recap.webm"} type="video/webm" />
            <source src={base + "vh-recap.mp4"} type="video/mp4" />
          </video>
        </div>
        <div class="ds-shot ds-shot--crop" style="--ds-pos: 0% 12%; height: 300px">
          <img src={base + "bot-settings.webp"} width="2640" height="1820" loading="lazy" decoding="async" alt="Bot welcome message field and the other meeting bot settings" />
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .vhn { padding: 104px 24px; }
  .vhn--light { background: var(--ds-white); }
  .vhn__split { max-width: 1180px; margin: 0 auto; display: grid; gap: 56px; align-items: center; }
  .vhn__split--narrow { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  .vhn__split--wide { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  .vhn__split--mid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .vhn__copy { display: flex; flex-direction: column; gap: 18px; }
  .vhn__copy h2 { margin: 0; }
  .vhn__copy a { color: inherit; text-decoration: underline; }
  .vhn__panel { padding: 28px; }
  .vhn__stack { display: flex; flex-direction: column; gap: 16px; }
  .vhn__loop { display: block; width: 100%; height: auto; background: var(--ds-white); }
  @media (max-width: 960px) {
    .vhn__split { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 767px) {
    .vhn { padding: 72px 16px; }
    .vhn__panel { padding: 14px; }
  }
</style>
