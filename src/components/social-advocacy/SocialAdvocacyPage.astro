<script>
  function initSavBand() {
    const band = document.querySelector<HTMLElement>(".sav-band");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let ticking = false;
    let lastProgress = -1;

    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * 0.7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === lastProgress) return;
      lastProgress = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const onResize = () => {
      measure();
      lastProgress = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSavBand);
  else initSavBand();
</script>

<script>
  // Event-role use cases: segmented tabs over one tinted panel per role.
  function initSavSuites() {
    document.querySelectorAll<HTMLElement>(".sav-suites").forEach((suite) => {
      const box = suite.querySelector<HTMLElement>(".sav-suites__box");
      const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".sav-suites__tab"));
      const panels = Array.from(suite.querySelectorAll<HTMLElement>(".sav-suites__panel"));
      if (!box || box.dataset.ready === "true" || !tabs.length || !panels.length) return;

      const select = (index: number) => {
        tabs.forEach((tab, tabIndex) => {
          const isActive = tabIndex === index;
          tab.setAttribute("aria-selected", isActive ? "true" : "false");
          tab.tabIndex = isActive ? 0 : -1;
        });
        panels.forEach((panel, panelIndex) => {
          panel.classList.toggle("is-active", panelIndex === index);
        });
      };

      // Marking the box ready lets the stylesheet hide the inactive panels, so
      // the markup stays readable when the script never runs.
      box.dataset.ready = "true";
      select(0);

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
          event.preventDefault();
          const offset = event.key === "ArrowRight" ? 1 : -1;
          const nextIndex = (index + offset + tabs.length) % tabs.length;
          tabs[nextIndex].focus();
          select(nextIndex);
        });
      });
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSavSuites);
  else initSavSuites();
</script>

<script>
  // Sharing stack: release the pinned header once the last card has settled, so it
  // scrolls away together with the pile instead of staying pinned over dead space.
  function initSavShareStack() {
    const header = document.querySelector<HTMLElement>(".sav-share-header");
    const cards = document.querySelectorAll<HTMLElement>(".sav-stack-card");
    const lastCard = cards[cards.length - 1];
    if (!header || !lastCard || header.dataset.stackReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let released = false;
    let ticking = false;

    const release = () => {
      const beforeTop = header.getBoundingClientRect().top;
      header.style.position = "static";
      const naturalTop = header.getBoundingClientRect().top;
      header.style.position = "";
      header.style.top = `${beforeTop - naturalTop}px`;
      header.classList.add("sav-share-header--released");
      released = true;
    };

    const restore = () => {
      header.classList.remove("sav-share-header--released");
      header.style.top = "";
      released = false;
    };

    const update = () => {
      ticking = false;
      // On small screens the header is static, so there is nothing to release.
      if (getComputedStyle(header).position !== "sticky") {
        if (released) restore();
        return;
      }
      const offset = Number.parseFloat(getComputedStyle(lastCard).top) || 0;
      const shouldRelease = lastCard.getBoundingClientRect().top < offset - 0.5;
      if (shouldRelease && !released) release();
      else if (!shouldRelease && released) restore();
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    header.dataset.stackReady = "true";
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSavShareStack);
  else initSavShareStack();
</script>

<script>
  // FAQ accordion: one answer open at a time, animated so the row grows and
  // shrinks instead of snapping. Reduced motion falls straight through.
  function initSavFaq() {
    const items = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-sav-faq-item]"));
    if (!items.length) return;

    const animations = new WeakMap<HTMLDetailsElement, Animation[]>();
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const animateItem = (item: HTMLDetailsElement, shouldOpen: boolean) => {
      const summary = item.querySelector<HTMLElement>(".sav-faq__question");
      const answer = item.querySelector<HTMLElement>(".sav-faq__answer");
      if (!summary || !answer) return;

      const startHeight = item.getBoundingClientRect().height;
      animations.get(item)?.forEach((animation) => animation.cancel());

      if (shouldOpen) item.open = true;
      const styles = window.getComputedStyle(item);
      const closedHeight =
        summary.getBoundingClientRect().height +
        parseFloat(styles.paddingTop) +
        parseFloat(styles.paddingBottom) +
        parseFloat(styles.borderTopWidth) +
        parseFloat(styles.borderBottomWidth);
      const endHeight = shouldOpen ? item.getBoundingClientRect().height : closedHeight;

      item.dataset.faqExpanded = String(shouldOpen);

      if (reducedMotion.matches) {
        item.open = shouldOpen;
        return;
      }

      const itemAnimation = item.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 280, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      const answerAnimation = answer.animate(
        shouldOpen
          ? { opacity: [0, 1], transform: ["translateY(-6px)", "translateY(0)"] }
          : { opacity: [1, 0], transform: ["translateY(0)", "translateY(-6px)"] },
        { duration: shouldOpen ? 240 : 180, easing: "ease-out", fill: "both" },
      );

      animations.set(item, [itemAnimation, answerAnimation]);
      itemAnimation.addEventListener(
        "finish",
        () => {
          item.open = shouldOpen;
          answerAnimation.cancel();
          animations.delete(item);
        },
        { once: true },
      );
    };

    items.forEach((item) => {
      item.dataset.faqExpanded = String(item.open);
      item.querySelector(".sav-faq__question")?.addEventListener("click", (event) => {
        event.preventDefault();
        const shouldOpen = item.dataset.faqExpanded !== "true";

        if (shouldOpen) {
          items.forEach((other) => {
            if (other !== item && other.dataset.faqExpanded === "true") {
              animateItem(other, false);
            }
          });
        }

        animateItem(item, shouldOpen);
      });
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSavFaq);
  else initSavFaq();
</script>

<script>
  // Poster variations: numbered accordion rows with a single row open at a time,
  // matching the workflow list on /speaker-management/.
  function initSavVariations() {
    const rows = Array.from(document.querySelectorAll<HTMLDetailsElement>(".sav-variations details"));
    if (!rows.length) return;

    rows.forEach((row) => {
      const summary = row.querySelector("summary");
      const toggle = row.querySelector<HTMLButtonElement>(".sav-variation__toggle");
      const label = toggle?.dataset.label ?? "";

      summary?.addEventListener("click", (event) => {
        event.preventDefault();
        row.open = !row.open;
      });

      row.addEventListener("toggle", () => {
        toggle?.setAttribute("aria-expanded", String(row.open));
        if (label) {
          toggle?.setAttribute("aria-label", `${row.open ? "Collapse" : "Expand"} ${label}`);
        }
        if (!row.open) return;
        rows.forEach((other) => {
          if (other !== row) other.open = false;
        });
      });
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSavVariations);
  else initSavVariations();
</script>
