---
// Social Advocacy (attendee advocacy software) feature page.
// Section patterns follow the Event Registration and Speaker Management references:
// hero + capability rail + spotlight panels + choice cards + bento bands + journey
// track + tabbed audience suites + destination links + single-column FAQ + dark closing CTA.
// Copy is taken from the approved attendee-advocacy content deck.

interface Props {
  faqs: Array<[string, string]>;
}

const { faqs } = Astro.props;

const flowRail = [
  { label: "Design", text: "Build the branded poster" },
  { label: "Map", text: "Choose attendee fields" },
  { label: "Connect", text: "Assign eligible tickets" },
  { label: "Personalize", text: "Render attendee details" },
  { label: "Share", text: "Download or post" },
  { label: "Review", text: "See poster usage" },
];

const ticketRules = [
  {
    label: "All tickets",
    text: "Make the poster available across eligible event registrations.",
  },
  {
    label: "Selected tickets",
    text: "Choose the ticket types that should receive this design.",
  },
  {
    label: "Draft or published",
    text: "Prepare a campaign without exposing it, then publish when it is ready.",
  },
  {
    label: "Priority order",
    text: "Control which poster is selected when more than one published design matches.",
  },
];

const variations = [
  {
    label: "I'm attending",
    text: "A registration-led announcement.",
    points: ["Registration-led announcement", "Name, photo and company from the form"],
    shot: "/feature-images/social-advocacy/poster-design-dark.png",
    alt: "Advocacy poster design reading I'm attending, with the event name, the attendee photo, name and company",
  },
  {
    label: "I'm speaking",
    text: "A role-led promotional card.",
    points: ["Role-led promotional card", "Speaker photo, name and designation"],
    shot: "/feature-images/social-advocacy/poster-design-speaking.png",
    alt: "Advocacy poster design reading I'm speaking at, with the event name, the speaker photo, name and designation",
  },
  {
    label: "Community edition",
    text: "A second visual treatment for the same event.",
    points: ["Second visual treatment", "Same campaign and caption template"],
    shot: "/feature-images/social-advocacy/poster-design-blue.png",
    alt: "Advocacy poster design reading Join me at, with the event name, the attendee photo, name and designation",
  },
];

const journeySteps = [
  {
    label: "Open the poster",
    text: "Move from the successful registration to the assigned advocacy campaign.",
    status: "Registration complete",
    tone: "success",
    action: "Open poster",
    shot: "/feature-images/social-advocacy/advocacy-poster-publish-connected.webp",
    shotW: 660,
    shotH: 412,
    shotAlt:
      "EventHex publish and share settings with the poster connected so posters are generated automatically on registration",
  },
  {
    label: "Complete the details",
    text: "Confirm mapped text or choose the image required by the design.",
    status: "3 fields mapped",
    tone: "info",
    action: "Save details",
    shot: "/feature-images/social-advocacy/advocacy-poster-field-mapping-rows.webp",
    shotW: 660,
    shotH: 412,
    shotAlt:
      "EventHex field mapping table listing the poster fields and the registration field each one is mapped to",
  },
  {
    label: "Choose a variation",
    text: "Pick from the organizer's available poster designs.",
    status: "Variation selected",
    tone: "success",
    action: "Use this design",
    shot: "/feature-images/social-advocacy/advocacy-poster-templates.webp",
    shotW: 932,
    shotH: 583,
    shotAlt:
      "EventHex poster builder with the saved design templates listed beside the poster canvas",
  },
  {
    label: "Generate and preview",
    text: "Render the personalized artwork before taking action.",
    status: "Preview ready",
    tone: "success",
    action: "Generate poster",
    shot: "/feature-images/social-advocacy/advocacy-poster-canvas-preview.webp",
    shotW: 980,
    shotH: 640,
    shotAlt:
      "EventHex poster canvas rendering an attendee poster with the layer list and background controls beside it",
  },
  {
    label: "Download or share",
    text: "Save the image or continue through the available sharing option.",
    status: "Saved to device",
    tone: "success",
    action: "Share poster",
    shot: "/feature-images/social-advocacy/advocacy-poster-download.webp",
    shotW: 1164,
    shotH: 637,
    shotAlt:
      "EventHex attendee poster form with the personalized poster preview and the Download Poster action",
  },
];

const shareOptions = [
  {
    eyebrow: "PNG or JPEG",
    label: "Download the image",
    text: "Save the finished poster as PNG or JPEG where the campaign flow supports the format.",
  },
  {
    eyebrow: "Campaign message + link",
    label: "Share on WhatsApp",
    text: "Open a WhatsApp share with the campaign message and link.",
  },
  {
    eyebrow: "Prepared message + URL",
    label: "Continue to LinkedIn",
    text: "Use the LinkedIn sharing path with the prepared message and campaign URL.",
  },
  {
    eyebrow: "Native share sheet",
    label: "Use the device share sheet",
    text: "Share through another compatible app when native sharing is available.",
  },
];

const roles = [
  {
    key: "attendees",
    label: "Attendees",
    text: "I'm attending announcements after registration.",
    crop: "portrait",
    chip: "Attendee poster",
    shot: "/feature-images/social-advocacy/poster-design-purple.webp",
    shotAlt: "EventHex advocacy poster reading I'm attending with the event name, attendee photo, name and designation",
    points: [
      "Registration-led announcements",
      "Attendee details from the form",
      "Download or share the image",
    ],
  },
  {
    key: "speakers",
    label: "Speakers",
    text: "Role-led cards that help promote a confirmed appearance.",
    crop: "stage",
    chip: "Speaker card",
    shot: "/feature-images/social-advocacy/poster-design-orange.webp",
    shotAlt: "EventHex speaker poster reading I'm speaking at with the event name, speaker photo, name and designation",
    points: [
      "Role-led promotional cards",
      "Confirmed appearance details",
      "Brand elements from your artwork",
    ],
  },
  {
    key: "exhibitors-and-sponsors",
    label: "Exhibitors and sponsors",
    text: "Campaign artwork mapped to the fields and tickets you configure.",
    crop: "booth",
    chip: "Sponsor artwork",
    shot: "/feature-images/social-advocacy/poster-design-blue.webp",
    shotAlt: "EventHex sponsor poster reading Join me at with the event name, exhibitor photo, name and designation",
    points: [
      "Fields you choose to map",
      "Selected ticket types",
      "Priority poster order",
    ],
  },
  {
    key: "associations-and-communities",
    label: "Associations and communities",
    text: "Member-ready event visuals with consistent messaging.",
    crop: "group",
    chip: "Member campaign",
    shot: "/feature-images/social-advocacy/poster-design-green.webp",
    shotAlt: "EventHex community poster reading I'm attending with the event logo, member photo, name and designation",
    points: [
      "Member-ready event visuals",
      "One consistent message",
      "Templates saved for the next edition",
    ],
  },
];

const destinations = [
  {
    label: "Event Registration",
    text: "Collect the attendee and ticket data used by poster mapping.",
    href: "/event-registration/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`,
  },
  {
    label: "Event Marketing",
    text: "Run planned email and WhatsApp campaigns for broader promotion.",
    href: "/event-marketing/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  },
  {
    label: "Event Notifications",
    text: "Send operational and triggered attendee updates.",
    href: "/event-notifications/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>`,
  },
  {
    label: "AI Photo Gallery",
    text: "Help attendees find and share their event photos after the event.",
    href: "/ai-photo-gallery/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>`,
  },
];
---

<div class="sav-page">
  <!-- 01 Hero -->
  <section class="sav-hero" id="hero">
    <div class="sav-wrap sav-hero__grid">
      <div class="sav-hero__copy">
        <span class="sav-eyebrow animate-on-scroll" data-animation="fadeInDown"
          >Attendee advocacy software</span
        >
        <h1 class="sav-hero__title animate-on-scroll" data-animation="fadeInUp">
          Turn registrations into branded posts attendees want to share
        </h1>
        <p class="sav-hero__lead animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Give attendees a personalized event poster after registration. EventHex brings your design,
          their approved registration details, a ready caption, and practical sharing options into one
          attendee advocacy flow.
        </p>
        <ul class="sav-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 900ms">
          <li>Branded poster builder</li>
          <li>Attendee personalization</li>
          <li>Download and share</li>
        </ul>
        <div class="sav-hero__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1000ms">
          <a class="sav-btn sav-btn--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="sav-btn sav-btn--ghost" href="#workflow">See the advocacy flow</a>
        </div>
      </div>

      <div class="sav-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="sav-visual">
          <div class="sav-visual__chrome">
            <span class="sav-visual__dot"></span>
            <span class="sav-visual__dot"></span>
            <span class="sav-visual__dot"></span>
            <b>EventHex &middot; Advocacy posters</b>
          </div>
          <img
            class="sav-visual__shot"
            src="/feature-images/social-advocacy/advocacy-poster-builder-hero.webp"
            width="980"
            height="640"
            alt="EventHex advocacy poster builder showing an I'm attending poster on the canvas with its editable layers listed alongside"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Capability rail -->
  <section class="sav-rail" id="workflow" aria-label="Attendee advocacy flow">
    <div class="sav-rail__inner">
      {
        flowRail.map((step) => (
          <span class="sav-rail__item">
            <b>{step.label}</b> {step.text}
          </span>
        ))
      }
    </div>
  </section>

  <!-- 04 Flow: registration-data mapping -->
  <section class="sav-section sav-soft" id="field-mapping" aria-labelledby="sav-map-title">
    <div class="sav-wrap">
      <div class="sav-map__header">
        <span class="sav-eyebrow animate-on-scroll" data-animation="fadeIn">Personalization from registration data</span>
        <h2 class="sav-map__title animate-on-scroll" data-animation="fadeInUp" id="sav-map-title">
          <span class="sav-map__line">Decide which attendee</span>
          <span class="sav-map__line">details appear</span>
        </h2>
        <p class="sav-map__subtitle animate-on-scroll" data-animation="fadeInUp">
          <span class="sav-map__line">Map each poster element to a common registration field or a ticket-specific</span>
          <span class="sav-map__line">answer before the campaign goes live.</span>
        </p>
      </div>

      <div class="sav-map__quad">
        <article class="sav-map__cell sav-map__cell--copy animate-on-scroll" data-animation="fadeInUp">
          <h3>Common attendee fields</h3>
          <p>Use shared registration details such as name, designation, company, or profile photo.</p>
          <span class="sav-cue">Keep the poster consistent across eligible tickets.</span>
        </article>

        <div class="sav-map__cell sav-map__cell--media animate-on-scroll" data-animation="fadeInRight">
          <div class="sav-map__composite">
            <img
              class="sav-map__screen sav-map__screen--primary"
              src="/feature-images/event-registration/single-registration-form.png"
              width="760"
              height="480"
              alt="EventHex registration form collecting the shared attendee fields reused by every poster"
              loading="lazy"
              decoding="async"
            />
            <img
              class="sav-map__screen sav-map__screen--secondary"
              src="/feature-images/event-registration/single-preview-settings.png"
              width="360"
              height="480"
              alt="EventHex single registration preview settings for the ticket form heading and copy"
              loading="lazy"
              decoding="async"
            />
            <span class="sav-map__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Fields mapped
            </span>
            <span class="sav-map__action">Assign to poster</span>
          </div>
        </div>

        <div class="sav-map__cell sav-map__cell--media animate-on-scroll" data-animation="fadeInLeft">
          <div class="sav-map__composite sav-map__composite--ticket">
            <img
              class="sav-map__screen sav-map__screen--primary"
              src="/feature-images/event-registration/checkout-attendee-details.png"
              width="1180"
              height="540"
              alt="EventHex attendee details step collecting the fields tied to the selected ticket"
              loading="lazy"
              decoding="async"
            />
            <img
              class="sav-map__screen sav-map__screen--secondary"
              src="/feature-images/event-registration/private-ticket-settings.png"
              width="760"
              height="480"
              alt="EventHex private ticket list where different ticket types keep their own registration form"
              loading="lazy"
              decoding="async"
            />
            <span class="sav-map__status">Ticket fields linked</span>
            <span class="sav-map__action">Review mapping</span>
          </div>
        </div>

        <article class="sav-map__cell sav-map__cell--copy animate-on-scroll" data-animation="fadeInUp">
          <h3>Ticket-specific fields</h3>
          <p>Map a poster element to a question collected for a selected ticket.</p>
          <span class="sav-cue">Use the information already captured in that registration path.</span>
        </article>

        <span class="sav-map__cross" aria-hidden="true"></span>
      </div>

      <p class="sav-note sav-map__note animate-on-scroll" data-animation="fadeIn">
        The organizer controls the mapping. The attendee can complete or confirm editable fields on the
        campaign page before generating the poster.
      </p>
    </div>
  </section>

  <!-- 05 Dark band: ticket eligibility -->
  <section class="sav-band" id="ticket-rules" aria-labelledby="sav-rules-title">
    <div class="sav-band__heading">
      <span class="sav-band__pill animate-on-scroll" data-animation="fadeIn">
        <span class="sav-band__pill-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.4 2.5-5Z"
              fill="#4F8CFF"></path>
            <path
              d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z"
              fill="#B08BFF"></path>
          </svg>
        </span>
        Control who gets each campaign
      </span>
      <h2 class="sav-band__title animate-on-scroll" data-animation="fadeInUp" id="sav-rules-title">
        Connect the right poster to the right registrations
      </h2>
      <p class="sav-band__lead animate-on-scroll" data-animation="fadeInUp">
        Use one advocacy design across the event or limit it to selected ticket types.
      </p>
    </div>

    <div class="sav-band__grid-wrap">
      <div class="sav-band__grid">
        <article class="sav-band__cell animate-on-scroll" data-animation="fadeInUp">
          <h3 class="sav-band__label">{ticketRules[0].label}</h3>
          <p class="sav-band__desc">{ticketRules[0].text}</p>
          <div class="sav-band__visual" aria-hidden="true">
            <div class="sav-band__card">
              <span class="sav-band__card-head">Poster assignment</span>
              <div class="sav-band__field is-on"><span>I'm attending</span><b>All eligible tickets</b></div>
              <div class="sav-band__field"><span>I'm speaking</span><b>Speaker pass</b></div>
              <div class="sav-band__field"><span>Community edition</span><b>Community pass</b></div>
            </div>
          </div>
        </article>

        <article class="sav-band__cell animate-on-scroll" data-animation="fadeInUp" data-delay="70">
          <span class="sav-band__petal sav-band__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="sav-band__petal sav-band__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="sav-band__label">{ticketRules[1].label}</h3>
          <p class="sav-band__desc">{ticketRules[1].text}</p>
          <div class="sav-band__visual" aria-hidden="true">
            <div class="sav-band__chips">
              <span class="is-active">Speaker pass</span>
              <span class="is-active">Community pass</span>
              <span>All eligible tickets</span>
            </div>
          </div>
        </article>

        <article class="sav-band__cell animate-on-scroll" data-animation="fadeInUp" data-delay="140">
          <h3 class="sav-band__label">{ticketRules[2].label}</h3>
          <p class="sav-band__desc">{ticketRules[2].text}</p>
          <div class="sav-band__visual" aria-hidden="true">
            <div class="sav-band__card">
              <span class="sav-band__card-head">Poster status</span>
              <div class="sav-band__field"><span>Draft</span><b>Hidden</b></div>
              <div class="sav-band__field is-on"><span>Published</span><b>Live</b></div>
            </div>
          </div>
        </article>

        <article class="sav-band__cell animate-on-scroll" data-animation="fadeInUp" data-delay="210">
          <span class="sav-band__petal sav-band__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="sav-band__petal sav-band__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="sav-band__label">{ticketRules[3].label}</h3>
          <p class="sav-band__desc">{ticketRules[3].text}</p>
          <div class="sav-band__visual" aria-hidden="true">
            <div class="sav-band__stack">
              <div class="sav-band__ticket is-active"><span>I'm attending</span><small>Priority 1</small></div>
              <div class="sav-band__ticket"><span>I'm speaking</span><small>Priority 2</small></div>
              <div class="sav-band__ticket"><span>Community edition</span><small>Priority 3</small></div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 06 Accordion: poster variations -->
  <section
    class="sav-section sav-variations-section"
    id="design-variations"
    aria-labelledby="sav-variations-title"
  >
    <div class="sav-wrap sav-wrap--accordion">
      <header class="sav-head sav-head--center">
        <span class="sav-eyebrow animate-on-scroll" data-animation="fadeIn">More than one creative direction</span>
        <h2
          class="sav-title animate-on-scroll"
          id="sav-variations-title"
          data-animation="fadeInUp"
        >
          Offer multiple poster variations in one campaign
        </h2>
        <p class="sav-lead animate-on-scroll" data-animation="fadeInUp">
          Store several designs under the same advocacy poster and let the attendee choose the version
          they prefer.
        </p>
      </header>

      <ol class="sav-variations">
        {
          variations.map((item, index) => (
            <li>
              <details open={index === 0}>
                <summary tabindex="-1">
                  <span>0{index + 1}</span>
                  <div class="sav-variation__content">
                    <h3 class="sav-variation__title">{item.label}</h3>
                    <p class="sav-variation__desc">{item.text}</p>
                    <ul class="sav-variation__points">
                      {item.points.map((point) => (
                        <li>
                          <i aria-hidden="true">&#10022;</i> {point}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <button
                    type="button"
                    class="sav-variation__toggle"
                    data-label={item.label}
                    aria-label={`${index === 0 ? "Collapse" : "Expand"} ${item.label}`}
                    aria-expanded={index === 0 ? "true" : "false"}
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="m5 7.5 5 5 5-5" />
                    </svg>
                  </button>
                </summary>
                <div class="sav-variation__visual">
                  <img
                    src={item.shot}
                    width="600"
                    height="600"
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 07 Journey: attendee experience -->
  <section class="sav-section sav-soft sav-path" id="attendee-experience">
    <div class="sav-wrap sav-path__grid">
      <div class="sav-path__intro">
        <span class="sav-eyebrow animate-on-scroll" data-animation="fadeIn">Designed for the moment after registration</span>
        <h2 class="sav-title animate-on-scroll" data-animation="fadeInUp">
          Give each attendee a short path from <em>confirmation to share</em>
        </h2>
        <p class="sav-lead animate-on-scroll" data-animation="fadeInUp">
          The advocacy prompt can appear in the registration-success experience and open the connected
          campaign page.
        </p>
        <a class="sav-path__cta animate-on-scroll" data-animation="fadeInUp" href="/book-a-demo/">
          Book a Demo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </a>
      </div>

      <ol class="sav-path__steps">
        {
          journeySteps.map((step, index) => (
            <li
              class="sav-step animate-on-scroll"
              data-animation="fadeInUp"
              data-delay={index * 60}
            >
              <div class="sav-step__head">
                <span class="sav-step__num">{String(index + 1).padStart(2, "0")}</span>
                <div class="sav-step__copy">
                  <h3>{step.label}</h3>
                  <p>{step.text}</p>
                </div>
              </div>

              <div class="sav-step__visual">
                <div class="sav-step__screen" aria-hidden="true">
                  <img
                    src={step.shot}
                    width={step.shotW}
                    height={step.shotH}
                    alt={step.shotAlt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <span
                  class:list={[
