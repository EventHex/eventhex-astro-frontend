    padding-block: clamp(64px, 7vw, 96px);
  }

  .sav-soft {
    background: var(--sav-soft);
  }

  /* Band sections stay unpainted so the page wash shows through, matching
     /event-registration/ where only cards and the dark bands carry colour.
     The dark .sav-band and .sav-share-shell keep their own backgrounds. */
