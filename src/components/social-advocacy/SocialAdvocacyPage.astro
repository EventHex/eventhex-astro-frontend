    background: transparent;
  }

  /* ---------- Shared text ---------- */
  .sav-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-blue);
  }

  .sav-title {
    margin: 16px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 56px);
