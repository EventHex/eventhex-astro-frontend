---
const reports = [
  { eyebrow: "Registration analytics", title: "Track volume, timing, ticket mix, and recent registrants together", desc: "Use the registration view to understand how demand is building for the selected event.", image: "/images/live-polling-qa/app/registration-analytics.png", alt: "EventHex registration analytics dashboard showing registration totals and trends", tint: "#fff0bd", points: ["Registration totals", "Timeline", "Ticket mix", "Peak hour", "Recent registrations", "Event overview"] },
  { eyebrow: "Event-day attendance", title: "Watch check-in volume, rate, timing, and ticket mix", desc: "Switch to the attendance view when arrivals begin and the event team needs operational signals.", image: "/images/event-gamification/app/attendee-engagement-analytics.png", alt: "EventHex attendee analytics dashboard used to monitor event-day activity", tint: "#dff3e8", points: ["Registered vs checked in", "Pending attendees", "Check-in rate", "Check-in timeline", "By-ticket views", "Recent check-ins"] },
  { eyebrow: "Audience composition", title: "Turn selected registration answers into configurable dashboard charts", desc: "Use categorical registration fields to understand who registered or checked in, with ticket filters where supported.", image: "/images/event-gamification/app/platform-analytics-live.png", alt: "EventHex analytics dashboard with configurable audience charts and event filters", tint: "#e2e8ff", points: ["Choose fields", "Reorder widgets", "Change chart type", "Filter by ticket", "Compare scopes", "Keep the denominator visible"] },
  { eyebrow: "Event app analytics", title: "Understand who opened the app and which screens they used", desc: "Review the selected period across Overview, Audience, Behaviour, and Live views.", image: "/images/live-polling-qa/app/mobile-app-analytics.png", alt: "EventHex mobile app analytics showing audience and screen activity", tint: "#f5e2ef", points: ["Reach and access", "Session depth", "Audience breakdowns", "Screen use", "Return behaviour", "Live activity"] },
];

const boundaries = [
  ["Screen view ≠ session attendance", "Opening a session screen does not prove physical attendance or content completion."],
  ["Ticket revenue ≠ settled payout", "Refunds, tax, fees, and settlement require finance workflows."],
  ["Check-in ≠ engagement", "Arrival state does not measure satisfaction or participation."],
  ["Sponsor visibility ≠ sponsor ROI", "ROI requires agreed value and attributable sponsor outcomes."],
  ["Guest conversion ≠ ticket conversion", "The app funnel measures app sign-in behaviour."],
  ["Trend ≠ forecast", "Historical movement does not guarantee future registrations or attendance."],
];

const boundaryImages = [
  ["/images/live-polling-qa/app/session-recap-analytics.png", "Session recap analytics view"],
  ["/feature-images/event-payment-processing/revenue-reporting.svg", "Event revenue reporting interface"],
  ["/images/event-gamification/app/attendee-engagement-analytics.png", "Attendee engagement analytics view"],
  ["/images/live-polling-qa/app/ai-gallery-analytics.png", "Event gallery analytics view"],
  ["/images/live-polling-qa/analytics-overview.png", "Event app analytics overview"],
  ["/images/live-polling-qa/analytics-insights.png", "Event analytics insights view"],
];

const workflowLinks = [
  { title: "Event Registration", desc: "Improve the form or checkout generating registrant data.", href: "/event-registration/", icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4M3 9h18"></path><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M8 13h3M8 17h6"></path></svg>' },
  { title: "Event Check-in", desc: "Configure and run the arrival workflow behind attendance data.", href: "/event-check-in/", icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path><path d="M12 3a9 9 0 1 0 9 9"></path></svg>' },
  { title: "Event Mobile App", desc: "Shape the attendee experience measured by app analytics.", href: "/event-mobile-app/", icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M12 18h.01"></path></svg>' },
  { title: "Event Marketing", desc: "Plan campaigns; do not infer campaign attribution from this dashboard alone.", href: "/event-marketing/", icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14z"></path><path d="M7 15l2 6h4l-2-7"></path></svg>' },
];

const detailSteps = [
  { title: "Choose the period", desc: "Today, 7, 30, or 90 days.", image: "/images/live-polling-qa/app/mobile-app-analytics.png", alt: "App analytics period controls", status: "Period selected", action: "Apply range" },
  { title: "Choose the audience", desc: "Review all, signed-in, or guest sessions where supported.", image: "/images/live-polling-qa/app/platform-analytics.png", alt: "App analytics audience filters", status: "Audience filtered", action: "View sessions" },
  { title: "Inspect session context", desc: "Use platform, duration, screen count, and entry or exit information.", image: "/images/live-polling-qa/analytics-insights.png", alt: "Detailed app session analytics", status: "Session selected", action: "Inspect details" },
  { title: "Export CSV", desc: "Download the current app-session dataset for further analysis.", image: "/images/live-polling-qa/app/session-recap-analytics.png", alt: "Analytics report ready for export", status: "Report ready", action: "Export CSV" },
];

const revenueViews = [
  { id: "activity", label: "Paid ticket activity", title: "Monitor paid ticket activity", desc: "See whether paid ticket activity is changing while monitoring registrations.", image: "/feature-images/event-payment-processing/revenue-reporting.svg", alt: "EventHex ticket revenue reporting", badge: "Revenue view", checks: ["Today’s ticket revenue", "Total ticket revenue", "Registration volume"] },
  { id: "volume", label: "Registration volume", title: "Read volume beside value", desc: "Keep registration counts and ticket revenue in the same operating view without treating them as interchangeable metrics.", image: "/images/live-polling-qa/app/registration-analytics.png", alt: "EventHex registration analytics dashboard", badge: "Volume and value", checks: ["Registration totals", "Ticket mix", "Revenue context"] },
  { id: "boundary", label: "Finance boundary", title: "Know where analytics stops", desc: "Dashboard revenue is an operational signal, not a settled payout or accounting ledger.", image: "/feature-images/event-registration/single-ticket-list.png", alt: "EventHex ticket list and pricing view", badge: "Boundary explicit", checks: ["Refunds remain separate", "Tax requires finance records", "Fees affect settlement"] },
  { id: "workflow", label: "Reconciliation", title: "Use the finance workflow", desc: "Use payment, invoice, tax, refund, and payout workflows for reconciliation and accounting decisions.", image: "/feature-images/event-ticketing/secure-payment.svg", alt: "EventHex secure payment workflow", badge: "Finance workflow", checks: ["Payment records", "Invoices and tax", "Refunds and payouts"] },
];

const faqs = [
  ["What can the main event dashboard track?", "Verified views cover registration totals and trends, ticket revenue totals, attendance counts and rates, ticket breakdowns, recent activity, repeat attendance, and selected registration-field distributions."],
  ["Can we analyze registration fields?", "Yes. Supported categorical fields can become configurable charts with visibility, order, chart type, answered count, and optional ticket filtering."],
  ["What does app analytics include?", "It includes visitor and session summaries, audience breakdowns, screens and feature use, guest funnel, retention, live activity, and a filtered app-session list."],
  ["Is every metric real time?", "No blanket real-time claim should be made. Event dashboard queries have view-specific caching, while the app Live tab polls its endpoint every 15 seconds."],
  ["Can we export reports?", "The reviewed App Analytics session list has a CSV export. A universal custom report builder or export for every dashboard was not verified."],
  ["Does EventHex calculate sponsor ROI?", "The reviewed route evidence does not establish a sponsor ROI report. Use exhibitor or sponsor-specific evidence and an agreed attribution model before making that claim."],
];
---

<main class="eax-page">
  <section class="eax-hero">
    <div class="eax-hero__copy">
      <span class="eax-kicker animate-on-scroll" data-animation="fadeInDown">Event analytics dashboard</span>
      <h1 class="animate-on-scroll" data-animation="fadeInUp">See registration, attendance, revenue, and app activity <em>in the views your event team uses</em></h1>
      <p class="animate-on-scroll" data-animation="fadeInUp">Follow the event from demand to arrival and attendee app use with focused dashboards built from EventHex registration, ticketing, check-in, and app data.</p>
      <div class="eax-actions animate-on-scroll" data-animation="fadeInUp"><a href="/book-a-demo/" class="eax-btn eax-btn--dark">Book a Demo <span>→</span></a><a href="#analytics-reports" class="eax-btn">Explore the dashboards <span>→</span></a></div>
      <div class="eax-signals"><span>Monitor registration</span><span>Operate arrivals</span><span>Understand app use</span></div>
    </div>
    <div class="eax-hero__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="eax-hero__visual-card"><div class="eax-hero__visual-inner">
        <div class="eax-screen"><img src="/images/platform-analytics-hero.png" alt="EventHex platform analytics dashboard overview" width="1010" height="620" loading="eager" decoding="async" fetchpriority="high" /></div>
        <span class="eax-float eax-float--top"><i></i>Dashboard connected</span><span class="eax-float eax-float--bottom">Current event view</span>
      </div></div>
    </div>
  </section>

  <section class="eax-journey" aria-labelledby="journey-title">
    <div class="eax-journey__inner">
      <span class="eax-journey__eyebrow">A connected event view</span>
      <h2 id="journey-title">Move from registration demand to event-day behaviour</h2>
      <ol>{[["Register","People + tickets"],["Collect","Profile answers"],["Transact","Ticket revenue"],["Check in","Attendance state"],["Use app","Audience + screens"],["Review","Trends + lists"]].map(([title,sub],i)=><li><b>{String(i+1).padStart(2,"0")} {title}</b> {sub}</li>)}</ol>
    </div>
  </section>

  <section class="eax-reports" id="analytics-reports" aria-labelledby="reports-title">
    <header><span class="eax-kicker">Focused dashboards</span><h2 id="reports-title">See the operational question and the supporting view together</h2></header>
    <div class="eax-bento">{reports.map((report,i)=><article class:list={["eax-report",{"eax-report--reverse":i%2===1}]}>
      <div class="eax-report__visual" style={`--tint:${report.tint}`}><div class="eax-report__stage"><img src={report.image} alt={report.alt} width="1263" height="697" loading="lazy" decoding="async" /><span class="eax-float eax-float--top"><i></i>{report.eyebrow}</span><span class="eax-float eax-float--bottom">View details →</span></div></div>
      <div class="eax-report__copy"><span class="eax-kicker">{String(i+1).padStart(2,"0")} · {report.eyebrow}</span><h3>{report.title}</h3><p>{report.desc}</p><ul>{report.points.map(point=><li>{point}</li>)}</ul></div>
    </article>)}</div>
  </section>

  <section class="eax-detail" aria-labelledby="eax-detail-title">
    <div class="eax-detail__container">
      <div class="eax-detail__left"><div class="eax-detail__sticky"><span class="eax-detail__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>Move from chart to detail</span><h2 id="eax-detail-title">Inspect app sessions and export the current <em>session list</em></h2><p>The App Analytics audience view provides session-level rows and a CSV export for the selected period and audience filter.</p><a href="/book-a-demo/">Book a Demo <span>→</span></a></div></div>
      <div class="eax-detail__right">{detailSteps.map((step,i)=><article class="eax-detail-card"><div class="eax-detail-card__header"><b>{String(i+1).padStart(2,"0")}</b><div><h3>{step.title}</h3><p>{step.desc}</p></div></div><div class="eax-detail-card__visual"><div><img src={step.image} alt={step.alt} loading="lazy" decoding="async" /><span class="eax-detail-card__status">✓ {step.status}</span><span class="eax-detail-card__action">{step.action}</span></div></div></article>)}</div>
    </div>
  </section>

  <section class="eax-freshness" aria-labelledby="eax-freshness-title">
    <header class="eax-freshness__header">
      <h2 id="eax-freshness-title">Match the Dashboard Refresh Pattern<br />to the Operational Question</h2>
      <p>Different views use different query freshness and aggregation paths, so confirm the last refresh before treating a number as current.</p>
    </header>
    <div class="eax-freshness__quad">
      <article class="eax-freshness__cell eax-freshness__cell--copy"><span>Event dashboard</span><h3>Operationally current</h3><p>Registration, overview, and attendance queries use cached client requests with different stale times and manual refetch support.</p></article>
      <div class="eax-freshness__cell eax-freshness__cell--media"><div class="eax-freshness__visual"><img src="/images/live-polling-qa/app/registration-analytics.png" alt="EventHex event dashboard analytics overview" width="1263" height="697" loading="lazy" decoding="async" /><span class="eax-freshness__status">✓ Dashboard view</span><span class="eax-freshness__action">Refresh when needed</span></div></div>
      <div class="eax-freshness__cell eax-freshness__cell--media"><div class="eax-freshness__visual"><img src="/images/live-polling-qa/app/mobile-app-analytics.png" alt="EventHex app live analytics view" width="1263" height="697" loading="lazy" decoding="async" /><span class="eax-freshness__status">✓ Live tab open</span><span class="eax-freshness__action">Polls every 15 seconds</span></div></div>
      <article class="eax-freshness__cell eax-freshness__cell--copy"><span>App live view</span><h3>Near-live polling</h3><p>The organizer screen polls its live analytics endpoint every 15 seconds while the Live tab is open.</p></article>
      <span class="eax-freshness__cross" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)"></path></svg></span>
    </div>
    <aside>Always confirm the selected event, period, ticket filter, audience scope, timezone, and last refresh before making a high-impact decision.</aside>
  </section>

  <section class="eax-boundaries" aria-labelledby="eax-boundaries-title">
    <div class="eax-boundaries__section">
      <header class="eax-boundaries__header">
        <span class="eax-boundaries__eyebrow"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.9 2.5-5.5Z" fill="#4F8CFF"></path><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"></path></svg>Read each metric honestly</span>
        <h2 id="eax-boundaries-title">Use the dashboard signal without turning it into an <em>unsupported conclusion</em></h2>
      </header>
      <div class="eax-boundaries__cards">
        {boundaries.map(([title,desc],i)=><article class="eax-boundary-card" style={`--card-index:${i}`}><div class="eax-boundary-card__content"><span>{String(i+1).padStart(2,"0")} · Metric boundary</span><h3>{title}</h3><p>{desc}</p><a href="#analytics-reports">Explore reports</a></div><div class="eax-boundary-card__image"><img src={boundaryImages[i][0]} alt={boundaryImages[i][1]} loading="lazy" decoding="async" /></div></article>)}
        <div class="eax-boundaries__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="eax-revenue" aria-labelledby="eax-revenue-title">
    <div class="eax-revenue__inner">
      <header class="eax-revenue__header"><h2 id="eax-revenue-title">Keep Registration Volume and Ticket Value in the Same Operating View</h2><p>The event dashboard surfaces today’s ticket revenue and total ticket revenue beside registration counts.</p></header>
      <div class="eax-revenue__tabs" role="tablist" aria-label="Ticket revenue views">{revenueViews.map((view,i)=><button class:list={["eax-revenue__tab",{"is-active":i===0}]} id={`eax-revenue-tab-${view.id}`} role="tab" aria-selected={i===0?"true":"false"} aria-controls={`eax-revenue-panel-${view.id}`} tabindex={i===0?0:-1} data-revenue-tab={view.id}>{view.label}</button>)}</div>
      <div class="eax-revenue__box">{revenueViews.map((view,i)=><article class:list={["eax-revenue__panel",{"is-active":i===0}]} id={`eax-revenue-panel-${view.id}`} role="tabpanel" aria-labelledby={`eax-revenue-tab-${view.id}`} data-revenue-panel={view.id} hidden={i!==0}><div class="eax-revenue__panel-copy"><h3>{view.title}</h3><p>{view.desc}</p><span>INCLUDES</span><ul>{view.checks.map(item=><li>✓ {item}</li>)}</ul></div><div class="eax-revenue__showcase"><img src={view.image} alt={view.alt} loading="lazy" decoding="async" /><span>{view.badge}</span></div></article>)}</div>
    </div>
  </section>

  <section class="eax-links" aria-labelledby="eax-links-title">
    <div class="eax-links__inner">
      <header class="eax-links__header"><h2 id="eax-links-title">Open the feature that owns<br />the underlying workflow</h2></header>
      <div class="eax-links__grid">
        {workflowLinks.slice(0,-1).map((_,i)=><span class="eax-links__notch" style={`left:${((i+1)/workflowLinks.length)*100}%`} aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg></span>)}
        {workflowLinks.map((item,i)=><a class:list={["eax-link-card",{"eax-link-card--first":i===0}]} href={item.href}><span class="eax-link-card__icon" set:html={item.icon}></span><div><h3>{item.title}</h3><p>{item.desc}</p></div></a>)}
      </div>
    </div>
  </section>

  <section class="eax-faq" aria-labelledby="eax-faq-title">
    <div class="eax-faq__inner">
      <div class="eax-faq__sidebar animate-on-scroll" data-animation="fadeInLeft">
        <span class="eax-faq__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Quick Answers</span>
        <h2 class="eax-faq__heading" id="eax-faq-title">Event Analytics<br />Questions, Answered.</h2>
        <p class="eax-faq__intro">Find quick answers about registration, attendance, revenue, event-app activity, and reporting.</p>
        <a href="/contact-en/" class="eax-faq__cta">Visit Help Center <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
      </div>
      <div class="eax-faq__list">{faqs.map(([q,a],i)=><details class="eax-faq__item animate-on-scroll" data-animation="fadeInUp" data-delay={String(i*50)} data-eax-faq open={i===0}><summary class="eax-faq__question"><strong>{q}</strong><span class="eax-faq__icon" aria-hidden="true"></span></summary><div class="eax-faq__answer"><p>{a}</p></div></details>)}</div>
    </div>
  </section>

</main>

<script>
  document.querySelectorAll('[data-eax-faq]').forEach((item) => item.addEventListener('toggle', () => { if (!(item instanceof HTMLDetailsElement) || !item.open) return; document.querySelectorAll('[data-eax-faq]').forEach((other) => { if (other !== item && other instanceof HTMLDetailsElement) other.open = false; }); }));
  const revenueTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-revenue-tab]'));
  const selectRevenueTab = (tab: HTMLButtonElement) => {
    revenueTabs.forEach((button) => {
      const active = button === tab;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
      const panel = document.querySelector<HTMLElement>(`[data-revenue-panel="${button.dataset.revenueTab}"]`);
      if (panel) { panel.hidden = !active; panel.classList.toggle('is-active', active); }
    });
  };
  revenueTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectRevenueTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const next = revenueTabs[(index + direction + revenueTabs.length) % revenueTabs.length];
      selectRevenueTab(next); next.focus();
    });
  });
</script>

