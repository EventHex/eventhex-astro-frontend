---
import EditorialCard from "./EditorialCard.astro";
import EditorialFeaturedCard from "./EditorialFeaturedCard.astro";
import type { EditorialEntry, EditorialKind } from "../../lib/editorial";
import { getUniqueCategories } from "../../lib/editorial";

interface Props {
  kind: EditorialKind;
  pageTitle: string;
  pageDescription: string;
  eyebrow: string;
  items: EditorialEntry[];
}

const { kind, pageTitle, pageDescription, eyebrow, items } = Astro.props;

const featuredItem = items[0] ?? null;
const archiveItems = items.slice(1);
const topics = getUniqueCategories(items);
const activeCategorySlug = Astro.url.pathname.match(/^\/blog\/category\/([^/]+)\/?$/)?.[1] ?? "";
const isBlogHome = kind === "blog" && !activeCategorySlug;
const blogGridItems = isBlogHome ? archiveItems : items;
const titleWords = pageTitle.split(" ");
const titleSplit = Math.max(0, titleWords.length - 2);
const titleLead = titleWords.slice(0, titleSplit).join(" ");
const titleKey = titleWords.slice(titleSplit).join(" ");
---

<section class:list={["editorial-shell", `editorial-shell--${kind}`]}>
  <!-- Hero header with textured background matching site-wide pattern -->
  <div class="editorial-hero">
    <div class="editorial-hero__inner">
      <header class="editorial-header">
        <p class="editorial-eyebrow">{eyebrow}</p>
        <h1 class="editorial-title">{titleLead}{titleLead ? " " : ""}<span class="ds-hl">{titleKey}</span></h1>
        <p class="editorial-lead">{pageDescription}</p>

        {kind !== "blog" && topics.length > 0 && (
          <div class="editorial-categories">
            {topics.map((topic) => (
              <a class="editorial-category-tag" href={`/blog/category/${topic.slug}/`}>{topic.name}</a>
            ))}
          </div>
        )}
      </header>
    </div>
  </div>

  <div class="editorial-container">
    {isBlogHome && featuredItem && (
      <section class="editorial-blog-featured" aria-label="Featured article">
        <EditorialFeaturedCard item={featuredItem} />
      </section>
    )}

    {kind === "blog" && (
      <nav class="editorial-filter-nav" aria-label="Blog categories">
        <a
          class:list={["editorial-filter-link", { "is-active": !activeCategorySlug }]}
          href="/blog/"
          aria-current={!activeCategorySlug ? "page" : undefined}
        >All</a>
        {topics.map((topic) => (
          <a
            class:list={["editorial-filter-link", { "is-active": activeCategorySlug === topic.slug }]}
            href={`/blog/category/${topic.slug}/`}
            aria-current={activeCategorySlug === topic.slug ? "page" : undefined}
          >{topic.name}</a>
        ))}
      </nav>
    )}

    {featuredItem ? (
      <main class="editorial-main">
        {kind === "blog" ? (
          <section class="editorial-grid editorial-grid--blog">
            {blogGridItems.map((item) => (
              <EditorialCard item={item} variant="blog" />
            ))}
          </section>
        ) : (
          <>
            <section class="editorial-featured">
              <EditorialCard item={featuredItem} variant="feature" />
            </section>

            {archiveItems.length > 0 && (
              <section class="editorial-grid">
                {archiveItems.map((item) => (
                  <EditorialCard item={item} />
                ))}
              </section>
            )}
          </>
        )}
      </main>
    ) : (
      <section class="editorial-empty">
        <h2>No articles published yet.</h2>
        <p>Stay tuned for updates from our team.</p>
      </section>
    )}

    <section class="editorial-cta">
      <div class="editorial-cta-content">
        <p class="editorial-cta-eyebrow">Ready to level up?</p>
        <h2>Turn ideas into <span class="ds-hl-dark">smoother event execution.</span></h2>
        <p>See how EventHex connects registration, ticketing, attendee experiences, and analytics in one AI-powered workflow.</p>
        <a class="editorial-cta-btn" href="/book-a-demo/">Schedule a walkthrough</a>
      </div>
    </section>
  </div>
</section>

<style>
  /* ── Shell ── */
  .editorial-shell {
    background-color: var(--ds-white);
  }

  /* ── Hero header with EventHex branded background ── */
  .editorial-hero {
    position: relative;
    margin-top: -90px;
    padding: 0;
    background: var(--ds-g4-stage);
  }

  .editorial-hero__inner {
    padding: 180px 20px 80px;
  }

  .editorial-header {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ds-sub);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.48px;
    margin-bottom: 16px;
  }

  .editorial-title {
    font-family: var(--font-heading);
    font-size: 52px;
    line-height: 60px;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ds-ink);
    margin: 0 0 20px;
  }

  .editorial-lead {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
    letter-spacing: -0.48px;
    color: var(--ds-sub);
    margin: 0 0 32px;
    max-width: 580px;
  }

  .editorial-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .editorial-category-tag {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--surface-blue-tint, var(--ds-surface-tint));
    color: var(--ds-sub);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    box-shadow: 0 8px 24px rgba(34, 39, 47, 0.05);
    transition: background 0.2s, border-color 0.2s;
    cursor: pointer;
    text-decoration: none;
  }

  .editorial-category-tag:hover {
    background: var(--ds-white);
    border-color: var(--brand-blue, var(--ds-blue));
  }

  /* ── Content container ── */
  .editorial-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 60px 48px 100px;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .editorial-shell--blog .editorial-container {
    padding-top: 14px;
  }

  .editorial-filter-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    min-width: 0;
    padding: 4px 2px 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .editorial-filter-nav::-webkit-scrollbar {
    display: none;
  }

  .editorial-filter-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 48px;
    padding: 12px 2px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--ds-ink);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    line-height: 22px;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .editorial-filter-link:hover {
    color: var(--brand-blue, var(--ds-blue));
  }

  .editorial-filter-link.is-active {
    min-width: 70px;
    padding-inline: 22px;
    border-color: var(--ds-line-strong);
    background: var(--ds-white);
    color: var(--ds-night-2);
    box-shadow: 0 3px 8px rgba(25, 25, 23, 0.1), 0 18px 34px rgba(25, 25, 23, 0.05);
  }

  .editorial-filter-link:focus-visible {
    outline: 2px solid var(--brand-blue, var(--ds-blue));
    outline-offset: 3px;
  }

  .editorial-main {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .editorial-featured {
    padding-bottom: 60px;
    border-bottom: 1px solid var(--surface-card-border, var(--ds-line));
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .editorial-grid--blog {
    align-items: stretch;
    gap: 26px;
  }

  @media (max-width: 1180px) {
    .editorial-grid--blog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .editorial-empty {
    text-align: center;
    padding: 80px 20px;
    background: var(--surface-light, var(--ds-surface));
    border-radius: 20px;
    border: 1px dashed var(--surface-card-border, var(--ds-line));
  }

  .editorial-empty h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--heading-dark, var(--ds-ink));
  }

  .editorial-empty p {
    font-family: var(--font-body);
    color: var(--body-gray, var(--ds-body));
  }

  /* ── CTA section ── */
  .editorial-cta {
    padding: 64px 40px;
    background: var(--ds-night-bg);
    border-radius: var(--ds-r-xl);
    text-align: center;
    border: 1px solid var(--ds-glass-dark-edge);
  }

  .editorial-cta-content {
    max-width: 560px;
    margin: 0 auto;
  }

  .editorial-cta-eyebrow {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ds-on-night-accent);
    margin-bottom: 16px;
  }

  .editorial-cta h2 {
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 44px;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ds-white);
    margin-bottom: 16px;
  }

  .editorial-cta p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 28px;
    color: var(--ds-on-night-body);
    margin-bottom: 32px;
  }

  .editorial-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    background: var(--brand-blue, var(--ds-blue));
    color: var(--ds-white);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s, transform 0.3s;
  }

  .editorial-cta-btn:hover {
    background: var(--brand-blue-hover, var(--ds-blue-hover));
    
  }

  /* ── Tablet ── */
  @media (max-width: 1024px) {
    .editorial-hero__inner {
      padding: 140px 20px 60px;
    }

    .editorial-title {
      font-size: 40px;
      line-height: 1.1em;
    }

    .editorial-container {
      padding-inline: 32px;
    }

    .editorial-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .editorial-cta {
      padding: 48px 28px;
    }

    .editorial-cta h2 {
      font-size: 28px;
      line-height: 36px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .editorial-hero {
      margin-top: -90px;
    }

    .editorial-hero__inner {
      padding: 130px 16px 50px;
    }

    .editorial-title {
      font-size: 30px;
      line-height: 1.2em;
      letter-spacing: 0;
    }

    .editorial-lead {
      font-size: 16px;
      line-height: 1.5em;
    }

    .editorial-container {
      padding: 40px 16px 80px;
      gap: 40px;
    }

    .editorial-shell--blog .editorial-container {
      padding-top: 10px;
    }

    .editorial-filter-nav {
      flex-wrap: nowrap;
      gap: 16px;
      margin-inline: -16px;
      padding: 4px 16px 10px;
    }

    .editorial-filter-link {
      min-height: 44px;
      font-size: 16px;
    }

    .editorial-filter-link.is-active {
      min-width: 62px;
      padding-inline: 18px;
    }

    .editorial-main {
      gap: 40px;
    }

    .editorial-featured {
      padding-bottom: 40px;
    }

    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .editorial-cta {
      padding: 40px 20px;
      border-radius: 16px;
    }

    .editorial-cta h2 {
      font-size: 24px;
      line-height: 32px;
    }

    .editorial-cta p {
      font-size: 15px;
    }
  }
</style>
