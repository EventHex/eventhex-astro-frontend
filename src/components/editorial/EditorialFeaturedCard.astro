---
import type { EditorialEntry } from "../../lib/editorial";
import { getEditorialCardImage } from "../../lib/editorial-card-images";

interface Props {
  item: EditorialEntry;
}

const { item } = Astro.props;
const cardImage = getEditorialCardImage(item);
const shortDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(item.date));
---

<article class="featured-blog-card">
  <a class="featured-blog-card__overlay-link" href={item.href} aria-label={`Read ${item.title}`}></a>

  <div class="featured-blog-card__content">
    <time class="featured-blog-card__date" datetime={item.date}>{shortDate}</time>

    <h2 class="featured-blog-card__title">{item.title}</h2>

    <div class="featured-blog-card__intro">
      <p>{item.description}</p>
    </div>

    <div class="featured-blog-card__actions">
      <span class="featured-blog-card__category">{item.category}</span>
      <span class="featured-blog-card__read" aria-hidden="true">Read article</span>
    </div>

    <footer class="featured-blog-card__footer">
      <span>By {item.author}</span>
      <span class="featured-blog-card__reading-time">{item.readingTime} min read</span>
    </footer>
  </div>

  <div class="featured-blog-card__media">
    {cardImage ? (
      <img
        src={cardImage.src}
        alt={cardImage.alt}
        loading="lazy"
        width={cardImage.width}
        height={cardImage.height}
      />
    ) : (
      <div class="featured-blog-card__fallback"><span>{item.category}</span></div>
    )}
  </div>
</article>

<style>
  .featured-blog-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    min-height: 430px;
    overflow: hidden;
    padding: 7px;
    border: 1px solid #dededb;
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(25, 25, 23, 0.07);
    cursor: pointer;
  }

  .featured-blog-card__overlay-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    border-radius: inherit;
  }

  .featured-blog-card__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 27px 26px 22px;
  }

  .featured-blog-card__date {
    margin-bottom: 24px;
    color: #999996;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-blog-card__title {
    max-width: 520px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(30px, 2.5vw, 38px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #181816;
  }

  .featured-blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-blog-card__intro {
    margin-top: 24px;
  }

  .featured-blog-card__intro p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #6b6b67;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-blog-card__category {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 16px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    text-decoration: none;
  }

  .featured-blog-card__read {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--brand-blue, #375DFB);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease, visibility 0.2s;
  }

  .featured-blog-card:hover .featured-blog-card__read,
  .featured-blog-card:focus-within .featured-blog-card__read {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .featured-blog-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
  }

  .featured-blog-card__category {
    align-self: flex-start;
    min-height: 36px;
    padding: 8px 13px;
    color: #242422;
    background: #f1f1ef;
    font-size: 13px;
    line-height: 18px;
  }

  .featured-blog-card__category:hover {
    background: #e8e8e5;
  }

  .featured-blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: auto;
    padding-top: 28px;
    color: #242422;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
  }

  .featured-blog-card__reading-time {
    color: #777773;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-blog-card__media {
    display: block;
    min-width: 0;
    min-height: 416px;
    overflow: hidden;
    border-radius: 20px;
    background: #efefec;
  }

  .featured-blog-card__media img,
  .featured-blog-card__fallback {
    width: 100%;
    height: 100%;
  }

  .featured-blog-card__media img {
    display: block;
    object-fit: cover;
  }

  .featured-blog-card__fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, rgba(175, 163, 255, 0.34), rgba(171, 255, 255, 0.2));
  }

  .featured-blog-card__fallback span {
    color: #475467;
    font-family: var(--font-body);
    font-weight: 500;
  }

  .featured-blog-card__overlay-link:focus-visible {
    outline: 2px solid var(--brand-blue, #375DFB);
    outline-offset: -3px;
  }

  @media (max-width: 1024px) {
    .featured-blog-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 400px;
    }

    .featured-blog-card__content {
      padding: 22px 20px 18px;
    }

    .featured-blog-card__title {
      font-size: 28px;
    }

    .featured-blog-card__intro {
      margin-top: 18px;
    }

    .featured-blog-card__actions {
      margin-top: 14px;
    }

    .featured-blog-card__media {
      min-height: 386px;
    }
  }

  @media (max-width: 767px) {
    .featured-blog-card {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 6px;
      border-radius: 22px;
    }

    .featured-blog-card__content {
      min-height: 350px;
      padding: 20px 16px 18px;
    }

    .featured-blog-card__date {
      margin-bottom: 18px;
    }

    .featured-blog-card__title {
      font-size: 28px;
    }

    .featured-blog-card__read {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .featured-blog-card__footer {
      font-size: 18px;
    }

    .featured-blog-card__media {
      min-height: 0;
      aspect-ratio: 1.45 / 1;
      border-radius: 17px;
    }
  }

  @media (hover: none) {
    .featured-blog-card__read {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-blog-card__read {
      transition: none;
    }
  }
</style>
