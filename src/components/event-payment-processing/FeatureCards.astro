---
const cards = [
  {
    eyebrow: "Attendee checkout",
    title: "Keep the payment handoff connected to the ticket order",
    description: "The configured event and gateway determine the payment path; the attendee does not choose between processors during checkout.",
  },
  {
    eyebrow: "Payment status",
    title: "Give operations a payment record they can act on",
    description: "Review the payment state beside the order instead of reconciling a separate attendee list against processor emails.",
  },
  {
    eyebrow: "Approval-led payment paths",
    title: "Keep payment state aligned with registration approval",
    description: "When the ticket flow requires review, the order can carry approval and capture context so operations can see what still needs a decision.",
  },
];
---

<section class="eppx-flow-shell" id="payment-flow" aria-label="Event payment processing">
  <div class="eppx-flow">
    <header class="eppx-flow__header">
      <div class="eppx-flow__eyebrow">
        <span class="eppx-flow__eyebrow-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.4 2.5-5Z" fill="#4F8CFF"></path>
            <path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"></path>
          </svg>
        </span>
        <span>Attendee checkout, payment status &amp; approval</span>
      </div>
      <h2 class="eppx-flow__title">
        <span>Keep payment state connected to</span>
        <span>the <em>ticket order</em></span>
      </h2>
    </header>

    <div class="eppx-flow__cards">
      {cards.map((card, index) => (
        <article class="eppx-flow__card" style={`--card-index: ${index}`}>
          <div class="eppx-flow__content">
            <span>{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>

          <div class="eppx-flow__visual">
            {index === 0 && (
              <div class="eppx-checkout-ui" aria-label="Attendee checkout">
                <div class="eppx-ui-top"><i></i><span>Attendee checkout</span></div>
                <div class="eppx-checkout-ui__steps">
                  <div class="is-done"><b>01</b><span>Create the order<small>Keep buyer, ticket, amount, currency, and tax context together.</small></span></div>
                  <div class="is-active"><b>02</b><span>Start the gateway handoff<small>Open the supported redirect, hosted, SDK, or provider flow used by that configuration.</small></span></div>
                  <div><b>03</b><span>Receive the result<small>Confirm payment or update the order from the provider response and webhook path.</small></span></div>
                  <div><b>04</b><span>Continue the journey<small>Move a successful order into confirmation, ticket delivery, and invoice handling.</small></span></div>
                </div>
              </div>
            )}
            {index === 1 && (
              <div class="epp-status-ui" aria-label="Payment status">
                <div class="eppx-ui-top"><i></i><span>Payment status</span></div>
                <div class="epp-status-ui__grid">
                  <span><small>Gateway</small><b>See which supported provider handled the payment.</b></span>
                  <span><small>Amount and currency</small><b>Keep the paid value in the event's configured currency context.</b></span>
                  <span><small>Captured or pending state</small><b>Understand whether the order is ready for the next ticketing action.</b></span>
                  <span><small>Failure context</small><b>Keep an unsuccessful attempt separate from a completed order.</b></span>
                  <span><small>Refund history</small><b>See refund activity and the amount still eligible for another refund.</b></span>
                  <span><small>Order detail</small><b>Connect the payment history to its buyer and tickets.</b></span>
                </div>
              </div>
            )}
            {index === 2 && (
              <div class="epp-approval-ui" aria-label="Approval-led payment paths">
                <div class="eppx-ui-top"><i></i><span>Approval-led payment paths</span></div>
                <div class="epp-approval-ui__person">
                  <div><b>Registration submitted</b><small>Create the attendee and order context for review.</small></div>
                </div>
                <div class="epp-approval-ui__state">
                  <span><i></i><b>Payment authorization state</b><small>Keep the processor result and capture status visible to the workflow.</small></span>
                  <span><i></i><b>Organizer decision</b><small>Approve or reject through the configured ticket process.</small></span>
                  <span><i></i><b>Outcome message</b><small>Continue into the applicable ticket and payment communication.</small></span>
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
      <div class="eppx-flow__spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const paymentFlow = document.querySelector<HTMLElement>('.eppx-flow-shell');
  const paymentFlowHeader = paymentFlow?.querySelector<HTMLElement>('.eppx-flow__header');
  const paymentFlowCards = paymentFlow?.querySelectorAll<HTMLElement>('.eppx-flow__card');
  const finalPaymentFlowCard = paymentFlowCards?.[paymentFlowCards.length - 1];

  if (paymentFlowHeader && finalPaymentFlowCard) {
    let paymentFlowFrame = 0;
    const syncPaymentFlowRelease = () => {
      paymentFlowFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalPaymentFlowCard).top) || 0;
      const releaseOffset = Math.min(0, finalPaymentFlowCard.getBoundingClientRect().top - stickyTop);
      paymentFlowHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queuePaymentFlowRelease = () => {
      if (paymentFlowFrame) return;
      paymentFlowFrame = requestAnimationFrame(syncPaymentFlowRelease);
    };

    window.addEventListener('scroll', queuePaymentFlowRelease, { passive: true });
    window.addEventListener('resize', queuePaymentFlowRelease, { passive: true });
    syncPaymentFlowRelease();
  }
</script>

<style>
  .eppx-flow-shell {
    width: 100%;
    background:
      linear-gradient(180deg, #0d0a2c 0%, transparent 320px),
      radial-gradient(circle at 12% 30%, rgba(70,130,255,.28), transparent 55%),
      #000;
    background-repeat: no-repeat;
    background-size: 100% 100%, 120% 120%;
    animation: eppx-flow-mesh 30s linear infinite;
  }

  @keyframes eppx-flow-mesh {
    0%, 100% { background-position: 0 0, 0% 0%; }
    50% { background-position: 0 0, 8% 10%; }
  }

  .eppx-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: 4px 0 30px;
  }

  .eppx-flow__header {
    position: sticky;
    top: 69px;
    z-index: 20;
    isolation: isolate;
    display: flex;
    width: min(94%, 1050px);
    padding: 24px 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    will-change: transform;
  }

  .eppx-flow__header::before {
    position: absolute;
    z-index: -1;
    top: -1px;
    bottom: -28px;
    left: 50%;
    width: 100vw;
    background: linear-gradient(180deg, rgba(13,10,44,.99) 0%, rgba(7,11,27,.98) 72%, rgba(7,11,27,0) 100%);
    content: "";
    pointer-events: none;
    transform: translateX(-50%);
  }

  .eppx-flow__eyebrow {
    display: flex;
    width: fit-content;
    padding: 6px 16px 6px 12px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 6px 16px -6px rgba(0,0,0,.35);
    color: #fff;
    font: 500 15px/24px var(--font-body);
    backdrop-filter: blur(16px);
  }

  .eppx-flow__eyebrow-icon {
    display: flex;
    width: 16px;
    height: 16px;
  }

  .eppx-flow__eyebrow-icon svg {
    width: 100%;
    height: 100%;
  }

  .eppx-flow__title {
    margin: 0;
    color: #fff;
    font: 500 46px/1.15 var(--font-heading);
  }

  .eppx-flow__title > span {
    display: block;
  }

  .eppx-flow__title em {
    color: #afa3ff;
    font-style: normal;
  }

  .eppx-flow__cards {
    --stack-top: 300px;
    position: relative;
    width: 100%;
    padding: 80px 0 50px;
  }

  .eppx-flow__card {
    position: sticky;
    top: calc(var(--stack-top) + var(--card-index) * 20px);
    z-index: var(--card-index);
    min-height: 540px;
    margin-bottom: 60px;
    display: flex;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 20px;
    background:
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255,255,255,.16), transparent 70%),
      radial-gradient(circle at 12% 8%, rgba(90,130,255,.18), transparent 40%),
      #0a0a0f;
  }

  .eppx-flow__card:first-child {
    background:
      radial-gradient(circle at 82% 12%, rgba(109,92,235,.24), transparent 34%),
      radial-gradient(circle at 8% 92%, rgba(66,173,218,.13), transparent 28%),
      #090a10;
  }

  .eppx-flow__content {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    padding: 40px;
  }

  .eppx-flow__content > span {
    padding: 7px 13px;
    border: 1px solid rgba(175,163,255,.28);
    border-radius: 999px;
    background: rgba(175,163,255,.1);
    color: #afa3ff;
    font: 600 12px/1.2 var(--font-body);
  }
  .eppx-flow__content h3 {
    margin: 0;
    color: #e7e4fa;
    font: 500 32px/1.2 var(--font-heading);
  }
  .eppx-flow__content p {
    margin: 0;
    color: rgba(255,255,255,.55);
    font: 400 17px/1.65 var(--font-body);
  }
  .eppx-flow__visual {
    flex: 1;
    display: grid;
    place-items: center;
    margin: 16px 16px 16px 0;
    padding: 28px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
  }

  .eppx-ui-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e8edf5;
    color: #263247;
    font: 700 12px/1.3 var(--font-body);
  }
  .eppx-ui-top > i { width: 10px; height: 10px; border-radius: 3px; background: #375dfb; }
  .eppx-ui-top > b { margin-left: auto; color: #667085; font-size: 10px; }
  .eppx-ui-top > b.is-paid { padding: 5px 8px; border-radius: 999px; background: #eafaf3; color: #087a51; }

  .eppx-checkout-ui,
  .epp-status-ui,
  .epp-approval-ui {
    width: min(100%, 470px);
    padding: 22px;
    border: 1px solid #dfe5f0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(0,0,0,.22);
    font-family: var(--font-body);
  }

  .eppx-checkout-ui__steps { display: grid; gap: 10px; margin-top: 16px; }
  .eppx-checkout-ui__steps > div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px;
    border: 1px solid #e8edf5;
    border-radius: 11px;
    color: #7b8494;
  }
  .eppx-checkout-ui__steps > div > b {
    display: grid;
    flex: 0 0 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: #f3f5f8;
    font-size: 10px;
  }
  .eppx-checkout-ui__steps > div > span { display: flex; flex-direction: column; color: #263247; font-size: 12px; font-weight: 700; }
  .eppx-checkout-ui__steps small { margin-top: 2px; color: #8992a3; font-size: 9px; font-weight: 500; }
  .eppx-checkout-ui__steps .is-done > b { background: #eafaf3; color: #087a51; }
  .eppx-checkout-ui__steps .is-active { border-color: #91a5ff; background: #f3f5ff; }
  .eppx-checkout-ui__steps .is-active > b { background: #375dfb; color: #fff; }

  .epp-status-ui__grid small { display: block; color: #375dfb; font-size: 9px; font-weight: 700; }
  .epp-status-ui__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .epp-status-ui__grid span { padding: 10px; border: 1px solid #e8edf5; border-radius: 10px; }
  .epp-status-ui__grid b { display: block; margin-top: 4px; color: #344054; font-size: 9px; line-height: 1.35; }

  .epp-approval-ui__person { display: flex; gap: 12px; align-items: center; margin: 16px 0; padding: 13px; border-radius: 12px; background: #f5f7ff; }
  .epp-approval-ui__person div, .epp-approval-ui__state span { display: flex; flex-direction: column; }
  .epp-approval-ui__person b, .epp-approval-ui__state b { color: #344054; font-size: 11px; }
  .epp-approval-ui__person small, .epp-approval-ui__state small { margin-top: 2px; color: #8992a3; font-size: 9px; }
  .epp-approval-ui__state { display: grid; gap: 8px; }
  .epp-approval-ui__state span { position: relative; padding: 10px 10px 10px 28px; border: 1px solid #e8edf5; border-radius: 10px; }
  .epp-approval-ui__state i { position: absolute; left: 10px; top: 15px; width: 7px; height: 7px; border-radius: 50%; background: #f5b942; }
  .eppx-flow__spacer { height: 190px; }

  @media (max-width: 1024px) {
    .eppx-flow { padding-inline: 20px; }
    .eppx-flow__header { width: 94%; }
    .eppx-flow__title { font-size: 40px; line-height: 1; }
    .eppx-flow__cards { --stack-top: 292px; }
    .eppx-flow__content { flex-basis: 50%; }
  }

  @media (max-width: 767px) {
    .eppx-flow { padding-inline: 20px; }
    .eppx-flow__header { width: 100%; }
    .eppx-flow__eyebrow { font-size: 14px; }
    .eppx-flow__title { font-size: 30px; }
    .eppx-flow__title > span { display: inline; }
    .eppx-flow__cards { --stack-top: 320px; padding-top: 80px; }
    .eppx-flow__card { min-height: 720px; flex-direction: column; }
    .eppx-flow__content { flex: 0 0 auto; padding: 22px 20px 4px; }
    .eppx-flow__content h3 { font-size: 24px; }
    .eppx-flow__content p { font-size: 14px; line-height: 1.55; }
    .eppx-flow__visual { min-height: 292px; margin: 12px; padding: 12px; }
    .eppx-checkout-ui, .epp-status-ui, .epp-approval-ui { padding: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eppx-flow-shell { animation: none; }
  }

</style>
