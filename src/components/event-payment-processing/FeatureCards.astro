---
const cards = [
  {
    eyebrow: "Attendee checkout",
    title: "Keep the payment handoff connected to the ticket order",
    description: "The configured event and gateway determine the payment path; the attendee does not choose between processors during checkout.",
    cta: "See the checkout path",
  },
  {
    eyebrow: "Payment status",
    title: "Give operations a payment record they can act on",
    description: "Review gateway, amount, currency, captured or pending state, failures, refund history, and buyer detail beside the order.",
    cta: "See payment status",
  },
  {
    eyebrow: "Approval-led payment paths",
    title: "Keep payment state aligned with registration approval",
    description: "When a ticket flow requires review, the order carries approval and capture context so operations can see what still needs a decision.",
    cta: "Map the approval flow",
  },
];
---

<section class="eppx-flow-shell" id="payment-flow">
  <div class="eppx-flow">
    <header class="eppx-flow__header">
      <span class="eppx-flow__eyebrow">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/>
          <path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/>
        </svg>
        Order-linked payment flow
      </span>
      <h2>One order context from <em>checkout</em> to outcome</h2>
    </header>

    <div class="eppx-flow__cards">
      {cards.map((card, index) => (
        <article class="eppx-flow__card" style={`--card-index: ${index}`}>
          <div class="eppx-flow__content">
            <span>{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <a href="/book-a-demo/">{card.cta}</a>
          </div>

          <div class="eppx-flow__visual">
            {index === 0 && (
              <div class="eppx-checkout-ui" aria-label="Illustration of an order moving through checkout">
                <div class="eppx-ui-top"><i></i><span>Order #EH-2408</span><b>USD 240</b></div>
                <div class="eppx-checkout-ui__steps">
                  <div class="is-done"><b>01</b><span>Create the order<small>Buyer, tickets, tax, currency</small></span></div>
                  <div class="is-active"><b>02</b><span>Gateway handoff<small>Configured provider path</small></span></div>
                  <div><b>03</b><span>Receive the result<small>Response and webhook state</small></span></div>
                  <div><b>04</b><span>Continue the journey<small>Confirmation and ticket delivery</small></span></div>
                </div>
              </div>
            )}
            {index === 1 && (
              <div class="epp-status-ui" aria-label="Illustration of order-linked payment status">
                <div class="eppx-ui-top"><i></i><span>Payment detail</span><b class="is-paid">Captured</b></div>
                <div class="epp-status-ui__amount"><small>Amount</small><strong>₹42,500</strong><span>Razorpay</span></div>
                <div class="epp-status-ui__grid">
                  <span><small>Currency</small><b>INR</b></span>
                  <span><small>Order</small><b>#EH-9821</b></span>
                  <span><small>Refunded</small><b>₹5,000</b></span>
                  <span><small>Remaining</small><b>₹37,500</b></span>
                </div>
                <div class="epp-status-ui__history"><i></i><span><b>Refund recorded</b><small>Connected to the original payment</small></span></div>
              </div>
            )}
            {index === 2 && (
              <div class="epp-approval-ui" aria-label="Illustration of payment authorization and registration approval states">
                <div class="eppx-ui-top"><i></i><span>Approval workflow</span><b>1 decision</b></div>
                <div class="epp-approval-ui__person">
                  <span>AK</span><div><b>Registration submitted</b><small>Order and attendee ready for review</small></div>
                </div>
                <div class="epp-approval-ui__state">
                  <span><i></i><b>Authorization state</b><small>Processor result visible</small></span>
                  <span><i></i><b>Organizer decision</b><small>Approve or reject</small></span>
                  <span><i></i><b>Outcome message</b><small>Continue the configured path</small></span>
                </div>
                <div class="epp-approval-ui__actions"><button type="button">Reject</button><button type="button">Approve</button></div>
              </div>
            )}
          </div>
        </article>
      ))}
      <div class="eppx-flow__spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const paymentFlow = document.querySelector<HTMLElement>(".eppx-flow-shell");
  const paymentFlowHeader = paymentFlow?.querySelector<HTMLElement>(".eppx-flow__header");
  const paymentFlowCards = paymentFlow?.querySelectorAll<HTMLElement>(".eppx-flow__card");
  const paymentFlowLastCard = paymentFlowCards?.[paymentFlowCards.length - 1];

  if (paymentFlowHeader && paymentFlowLastCard) {
    let frame = 0;
    const syncHeaderRelease = () => {
      frame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(paymentFlowLastCard).top) || 0;
      const offset = Math.min(0, paymentFlowLastCard.getBoundingClientRect().top - stickyTop);
      paymentFlowHeader.style.transform = `translateY(${offset}px)`;
    };
    const queueHeaderRelease = () => {
      if (frame) return;
      frame = requestAnimationFrame(syncHeaderRelease);
    };
    window.addEventListener("scroll", queueHeaderRelease, { passive: true });
    window.addEventListener("resize", queueHeaderRelease, { passive: true });
    syncHeaderRelease();
  }
</script>

<style>
  .eppx-flow-shell {
    width: 100%;
    background:
      linear-gradient(180deg, #0d0a2c 0%, transparent 320px),
      radial-gradient(circle at 12% 30%, rgba(70,130,255,.28), transparent 55%),
      #000;
  }

  .eppx-flow {
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: 4px 0 30px;
  }

  .eppx-flow__header {
    position: sticky;
    top: 69px;
    z-index: 20;
    isolation: isolate;
    width: min(94%, 1050px);
    margin: 0 auto;
    padding: 28px 0;
    text-align: center;
    will-change: transform;
  }

  .eppx-flow__header::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1px auto -28px 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: linear-gradient(180deg, rgba(13,10,44,.99), rgba(7,11,27,.98) 72%, rgba(7,11,27,0));
    pointer-events: none;
  }

  .eppx-flow__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 15px 7px 11px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    color: #fff;
    font: 500 15px/1.4 var(--font-body);
  }
  .eppx-flow__eyebrow svg { width: 16px; height: 16px; }
  .eppx-flow__header h2 {
    margin: 16px 0 0;
    color: #fff;
    font: 500 46px/1.15 var(--font-heading);
    letter-spacing: -.035em;
  }
  .eppx-flow__header h2 em { color: #afa3ff; font-style: normal; }

  .eppx-flow__cards {
    --stack-top: 288px;
    position: relative;
    width: 100%;
    padding: 80px 0 50px;
  }

  .eppx-flow__card {
    position: sticky;
    top: calc(var(--stack-top) + var(--card-index) * 20px);
    z-index: var(--card-index);
    height: 500px;
    margin-bottom: 60px;
    display: flex;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 20px;
    background:
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255,255,255,.16), transparent 70%),
      radial-gradient(circle at 12% 8%, rgba(90,130,255,.18), transparent 40%),
      #0a0a0f;
  }

  .eppx-flow__card:first-child {
    background:
      radial-gradient(circle at 82% 12%, rgba(109,92,235,.24), transparent 34%),
      radial-gradient(circle at 8% 92%, rgba(66,173,218,.13), transparent 28%),
      #090a10;
  }

  .eppx-flow__content {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    padding: 40px;
  }

  .eppx-flow__content > span {
    padding: 7px 13px;
    border: 1px solid rgba(175,163,255,.28);
    border-radius: 999px;
    background: rgba(175,163,255,.1);
    color: #afa3ff;
    font: 600 12px/1.2 var(--font-body);
  }
  .eppx-flow__content h3 {
    margin: 0;
    color: #e7e4fa;
    font: 500 32px/1.2 var(--font-heading);
  }
  .eppx-flow__content p {
    margin: 0;
    color: rgba(255,255,255,.55);
    font: 400 17px/1.65 var(--font-body);
  }
  .eppx-flow__content a {
    margin-top: 8px;
    padding: 12px 26px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    color: #fff;
    font: 500 15px/1.4 var(--font-body);
    text-decoration: none;
  }

  .eppx-flow__visual {
    flex: 1;
    display: grid;
    place-items: center;
    margin: 16px 16px 16px 0;
    padding: 28px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
  }

  .eppx-ui-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e8edf5;
    color: #263247;
    font: 700 12px/1.3 var(--font-body);
  }
  .eppx-ui-top > i { width: 10px; height: 10px; border-radius: 3px; background: #375dfb; }
  .eppx-ui-top > b { margin-left: auto; color: #667085; font-size: 10px; }
  .eppx-ui-top > b.is-paid { padding: 5px 8px; border-radius: 999px; background: #eafaf3; color: #087a51; }

  .eppx-checkout-ui,
  .epp-status-ui,
  .epp-approval-ui {
    width: min(100%, 470px);
    padding: 22px;
    border: 1px solid #dfe5f0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(0,0,0,.22);
    font-family: var(--font-body);
  }

  .eppx-checkout-ui__steps { display: grid; gap: 10px; margin-top: 16px; }
  .eppx-checkout-ui__steps > div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px;
    border: 1px solid #e8edf5;
    border-radius: 11px;
    color: #7b8494;
  }
  .eppx-checkout-ui__steps > div > b {
    display: grid;
    flex: 0 0 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: #f3f5f8;
    font-size: 10px;
  }
  .eppx-checkout-ui__steps > div > span { display: flex; flex-direction: column; color: #263247; font-size: 12px; font-weight: 700; }
  .eppx-checkout-ui__steps small { margin-top: 2px; color: #8992a3; font-size: 9px; font-weight: 500; }
  .eppx-checkout-ui__steps .is-done > b { background: #eafaf3; color: #087a51; }
  .eppx-checkout-ui__steps .is-active { border-color: #91a5ff; background: #f3f5ff; }
  .eppx-checkout-ui__steps .is-active > b { background: #375dfb; color: #fff; }

  .epp-status-ui__amount { position: relative; margin: 16px 0; padding: 16px; border-radius: 12px; background: #f5f7ff; }
  .epp-status-ui__amount small, .epp-status-ui__grid small { display: block; color: #8992a3; font-size: 9px; }
  .epp-status-ui__amount strong { display: block; margin-top: 4px; color: #1d2939; font-size: 24px; }
  .epp-status-ui__amount span { position: absolute; top: 16px; right: 16px; padding: 6px 9px; border-radius: 999px; background: #fff; color: #375dfb; font-size: 10px; font-weight: 700; }
  .epp-status-ui__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .epp-status-ui__grid span { padding: 10px; border: 1px solid #e8edf5; border-radius: 10px; }
  .epp-status-ui__grid b { display: block; margin-top: 4px; color: #344054; font-size: 11px; }
  .epp-status-ui__history { display: flex; gap: 10px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #e8edf5; }
  .epp-status-ui__history i { width: 8px; height: 8px; margin-top: 4px; border-radius: 50%; background: #10b981; }
  .epp-status-ui__history span { display: flex; flex-direction: column; color: #344054; font-size: 10px; }
  .epp-status-ui__history small { margin-top: 2px; color: #8992a3; font-size: 9px; }

  .epp-approval-ui__person { display: flex; gap: 12px; align-items: center; margin: 16px 0; padding: 13px; border-radius: 12px; background: #f5f7ff; }
  .epp-approval-ui__person > span { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 50%; background: #dfe5ff; color: #375dfb; font-size: 11px; font-weight: 750; }
  .epp-approval-ui__person div, .epp-approval-ui__state span { display: flex; flex-direction: column; }
  .epp-approval-ui__person b, .epp-approval-ui__state b { color: #344054; font-size: 11px; }
  .epp-approval-ui__person small, .epp-approval-ui__state small { margin-top: 2px; color: #8992a3; font-size: 9px; }
  .epp-approval-ui__state { display: grid; gap: 8px; }
  .epp-approval-ui__state span { position: relative; padding: 10px 10px 10px 28px; border: 1px solid #e8edf5; border-radius: 10px; }
  .epp-approval-ui__state i { position: absolute; left: 10px; top: 15px; width: 7px; height: 7px; border-radius: 50%; background: #f5b942; }
  .epp-approval-ui__actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
  .epp-approval-ui__actions button { padding: 8px 13px; border: 1px solid #dfe5f0; border-radius: 9px; background: #fff; color: #667085; font: 650 10px/1 var(--font-body); }
  .epp-approval-ui__actions button:last-child { border-color: #375dfb; background: #375dfb; color: #fff; }

  .eppx-flow__spacer { height: 190px; }

  @media (max-width: 1024px) {
    .eppx-flow { padding-inline: 20px; }
    .eppx-flow__header h2 { font-size: 40px; }
    .eppx-flow__cards { --stack-top: 284px; }
    .eppx-flow__card { height: 460px; }
    .eppx-flow__content { flex-basis: 50%; }
  }

  @media (max-width: 767px) {
    .eppx-flow { padding-inline: 20px; }
    .eppx-flow__header { width: 100%; }
    .eppx-flow__header h2 { font-size: 30px; }
    .eppx-flow__cards { --stack-top: 310px; padding-top: 70px; }
    .eppx-flow__card { height: 610px; flex-direction: column; }
    .eppx-flow__content { flex: 0 0 auto; padding: 22px 20px 4px; }
    .eppx-flow__content h3 { font-size: 24px; }
    .eppx-flow__content p { font-size: 14px; line-height: 1.55; }
    .eppx-flow__content a { padding: 9px 16px; font-size: 12px; }
    .eppx-flow__visual { min-height: 292px; margin: 12px; padding: 12px; }
    .eppx-checkout-ui, .epp-status-ui, .epp-approval-ui { padding: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eppx-flow__header { transform: none !important; }
  }
</style>
