---
// CTA band rebuilt on the home footer banner pattern: dark rounded banner with
// a blue glow, left copy + button, right product image.
---

<section class="eppx-cta">
  <div class="eppx-cta__banner animate-on-scroll" data-animation="fadeInUp">
    <div class="eppx-cta__glow" aria-hidden="true"></div>

    <div class="eppx-cta__left">
      <span class="eppx-cta__pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Map your event payment setup
      </span>

      <h2 class="eppx-cta__title">Bring your gateway and finance workflow to the demo</h2>

      <p class="eppx-cta__subtitle">
        Show us the market, currency, ticket flow, supported provider account,
        refund process, and reporting needs for one event. We’ll walk through the
        matching EventHex path and call out anything that requires separate scoping.
      </p>

      <a href="/book-a-demo/" class="eppx-cta__button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Book a Demo
      </a>
    </div>

    <div class="eppx-cta__right">
      <img
        src="/feature-images/event-payment-processing/finance-view.png"
        alt="EventHex event Finance view with gross collected, refunded, fees and charges, net payout, applied gateway rates, and breakdowns by gateway and order status"
        width="906"
        height="556"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  /* Matches the home footer CTA banner: dark rounded band, blue glow, grid wash. */
  .eppx-cta {
    padding: clamp(72px, 8vw, 112px) 24px;
    background: #fff;
  }
  .eppx-cta__banner {
    position: relative;
    display: flex;
    align-items: stretch;
    max-width: 1280px;
    min-height: 480px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(172, 161, 241, .2);
    border-radius: 30px;
    background: #060704;
  }
  .eppx-cta__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle 560px at 64% 55%, rgba(55, 93, 251, .85) 0%, rgba(20, 40, 130, .4) 45%, transparent 78%),
      radial-gradient(circle 380px at 8% 90%, rgba(50, 90, 180, .4) 0%, transparent 72%);
  }
  .eppx-cta__glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(circle 500px at 64% 55%, #000 0%, transparent 75%);
    mask-image: radial-gradient(circle 500px at 64% 55%, #000 0%, transparent 75%);
  }

  .eppx-cta__left {
    position: relative;
    z-index: 1;
    flex: 0 0 52%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    padding: 56px 24px 56px 56px;
  }
  .eppx-cta__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 999px;
    background: rgba(255, 255, 255, .08);
    color: #e8ebe6;
    font: 500 13px/1.3 var(--font-body);
  }
  .eppx-cta__title {
    max-width: 92%;
    margin: 0;
    color: #fff;
    font: 600 44px/1.14 var(--font-heading);
    letter-spacing: -1px;
  }
  .eppx-cta__subtitle {
    max-width: 88%;
    margin: 0;
    color: #a3ab9f;
    font: 400 16px/1.5 var(--font-body);
  }
  .eppx-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    margin-top: 6px;
    padding: 12px 24px;
    border-radius: 10px;
    background: #fff;
    color: #06120a;
    font: 600 15px/24px var(--font-body);
    letter-spacing: -.48px;
    text-decoration: none;
    transition: transform .3s ease;
  }
  .eppx-cta__button:hover { transform: scale(1.05); }

  .eppx-cta__right {
    position: relative;
    z-index: 1;
    flex: 0 0 48%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 42px 44px 42px 0;
  }
  .eppx-cta__right img {
    display: block;
    width: 100%;
    max-width: 620px;
    height: auto;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 18px;
    box-shadow: 0 30px 70px rgba(3, 7, 25, .55);
  }

  @media (max-width: 1024px) {
    .eppx-cta__banner { min-height: 420px; }
    .eppx-cta__left { flex: 0 0 56%; padding: 44px 20px 44px 40px; }
    .eppx-cta__title { max-width: 100%; font-size: 34px; }
    .eppx-cta__subtitle { max-width: 100%; }
    .eppx-cta__right { flex: 0 0 44%; padding: 32px 32px 32px 0; }
    .eppx-cta__right img { max-width: 460px; }
  }

  @media (max-width: 767px) {
    .eppx-cta { padding: 64px 16px; }
    .eppx-cta__banner {
      flex-direction: column;
      min-height: 0;
      border-radius: 24px;
    }
    .eppx-cta__left { flex: 1 1 auto; gap: 16px; padding: 40px 22px 8px; }
    .eppx-cta__title { font-size: 30px; line-height: 1.2; }
    .eppx-cta__right { flex: 1 1 auto; padding: 26px 22px 34px; }
    .eppx-cta__right img { max-width: 100%; }
    .eppx-cta__button { width: 100%; }
  }
</style>
