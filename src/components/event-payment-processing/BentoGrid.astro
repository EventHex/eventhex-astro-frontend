---
const gateways = [
  {
    name: "Stripe",
    description: "Use the supported Stripe checkout and webhook path for the configured event account.",
    visual: ["Checkout", "Webhook"],
  },
  {
    name: "Razorpay",
    description: "Use Razorpay paths for relevant India-first payment experiences, including supported hosted or SDK handoffs.",
    visual: ["Hosted", "SDK"],
  },
  {
    name: "Tap",
    description: "Use Tap for supported GCC/MENA currency and payment-source flows.",
    visual: ["GCC", "MENA"],
  },
  {
    name: "Configured checkout",
    description: "The attendee follows the supported gateway path configured for the event.",
    visual: ["Event", "Gateway", "Order"],
  },
  {
    name: "Need another gateway?",
    description: "Bring the provider and checkout model to the demo so the EventHex team can scope what would need to be built.",
    visual: ["Provider", "Scope"],
  },
];
---

<div class="eppx-gateway-band">
  <section class="eppx-gateway" aria-labelledby="gateway-heading">
    <header class="eppx-gateway__header animate-on-scroll" data-animation="fadeInUp">
      <span>Supported payment gateways</span>
      <h2 id="gateway-heading">
        Choose the current gateway path that fits the <em>event market</em>
      </h2>
      <p>
        EventHex has active payment flows for Stripe, Razorpay, and Tap; attendee
        checkout follows the gateway configured for the event.
      </p>
    </header>

    <div class="eppx-gateway__grid">
      {gateways.map((gateway, index) => (
        <article class="eppx-gateway__card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          <div>
            <span class="eppx-gateway__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{gateway.name}</h3>
            <p>{gateway.description}</p>
          </div>
          <div class="eppx-gateway__visual" aria-hidden="true">
            {gateway.visual.map((item, itemIndex) => (
              <span class:list={[itemIndex === 0 && "is-active"]}>{item}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<section class="eppx-account" aria-labelledby="account-heading">
  <header class="eppx-account__header">
    <span>Your supported gateway account</span>
    <h2 id="account-heading">Keep the event connected to the processor account your team controls</h2>
    <p>Configure supported credentials at the event or organization level and keep sensitive values masked in normal organizer responses.</p>
  </header>

  <div class="eppx-account__quad">
    <article class="eppx-account__cell eppx-account__copy animate-on-scroll" data-animation="fadeInUp">
      <span class="eppx-account__tag">Event-specific</span>
      <h3>Event-level setup</h3>
      <p>Use a supported gateway configuration for a specific event when the account or market differs.</p>
      <strong>Best for event-specific payment operations</strong>
    </article>
    <div class="eppx-account__cell eppx-account__media animate-on-scroll" data-animation="fadeInRight">
      <div class="eppx-settings" aria-label="Example event gateway settings">
        <div class="eppx-settings__top"><i></i><span>Event payment settings</span><b>•••</b></div>
        <label>Gateway <span>Stripe</span></label>
        <label>Event currency <span>USD</span></label>
        <label>Secret key <span>••••••••••••</span></label>
        <small><i></i> Credentials saved for this event</small>
      </div>
    </div>

    <div class="eppx-account__cell eppx-account__media animate-on-scroll" data-animation="fadeInLeft">
      <div class="eppx-settings eppx-settings--org" aria-label="Example organization gateway settings">
        <div class="eppx-settings__top"><i></i><span>Organization payments</span><b>•••</b></div>
        <div class="eppx-settings__row"><span>Razorpay</span><b>Connected</b></div>
        <div class="eppx-settings__row"><span>Tap</span><b>Connected</b></div>
        <small><i></i> Available to supported event setups</small>
      </div>
    </div>
    <article class="eppx-account__cell eppx-account__copy animate-on-scroll" data-animation="fadeInUp">
      <span class="eppx-account__tag">Reusable</span>
      <h3>Organization-level setup</h3>
      <p>Reuse supported payment settings where the organization model allows shared configuration.</p>
      <strong>Best for repeat event portfolios</strong>
    </article>
  </div>

  <p class="eppx-account__note">
    This is bring-your-own account support for Stripe, Razorpay, or Tap—not a universal adapter for any gateway.
  </p>
</section>

<style>
  .eppx-gateway-band {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 8%, rgba(111, 93, 245, 0.2), transparent 30%),
      radial-gradient(circle at 8% 90%, rgba(74, 192, 233, 0.12), transparent 26%),
      #080910;
    color: #fff;
  }

  .eppx-gateway-band::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(rgba(255,255,255,.3) .6px, transparent .6px);
    background-size: 22px 22px;
    pointer-events: none;
  }

  .eppx-gateway {
    position: relative;
    z-index: 1;
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: 104px 0;
  }

  .eppx-gateway__header {
    max-width: 790px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .eppx-gateway__header > span,
  .eppx-account__header > span {
    display: inline-block;
    margin-bottom: 12px;
    color: #8da2ff;
    font: 650 13px/1.3 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .eppx-gateway__header h2,
  .eppx-account__header h2 {
    margin: 0;
    font: 500 clamp(36px, 4.6vw, 56px)/1.05 var(--font-heading);
    letter-spacing: -.045em;
  }

  .eppx-gateway__header h2 { color: #f7f7fb; }
  .eppx-gateway__header h2 em { color: #afa3ff; font-style: normal; }
  .eppx-gateway__header p,
  .eppx-account__header p {
    max-width: 700px;
    margin: 20px auto 0;
    font: 400 17px/1.65 var(--font-body);
  }
  .eppx-gateway__header p { color: rgba(255,255,255,.58); }

  .eppx-gateway__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid #3b3a47;
    border-left: 1px solid #3b3a47;
  }

  .eppx-gateway__card {
    grid-column: span 2;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 34px;
    border-right: 1px solid #3b3a47;
    border-bottom: 1px solid #3b3a47;
    background: rgba(9, 10, 16, .76);
  }
  .eppx-gateway__card:nth-child(n + 4) { grid-column: span 3; }

  .eppx-gateway__index {
    color: #777889;
    font: 650 11px/1 var(--font-body);
    letter-spacing: .08em;
  }
  .eppx-gateway__card h3 {
    margin: 18px 0 10px;
    color: #fff;
    font: 500 25px/1.15 var(--font-heading);
  }
  .eppx-gateway__card p {
    margin: 0;
    color: rgba(255,255,255,.56);
    font: 400 15px/1.65 var(--font-body);
  }

  .eppx-gateway__visual {
    min-height: 102px;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    gap: 8px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.025));
  }
  .eppx-gateway__visual span {
    padding: 9px 12px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    color: #b9bcc8;
    font: 600 11px/1 var(--font-body);
  }
  .eppx-gateway__visual span.is-active {
    border-color: rgba(141,162,255,.5);
    background: rgba(55,93,251,.18);
    color: #dce3ff;
  }

  .eppx-account {
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: 104px 0 88px;
  }

  .eppx-account__header {
    max-width: 850px;
    margin: 0 auto 42px;
    text-align: center;
  }
  .eppx-account__header > span { color: #375dfb; }
  .eppx-account__header h2 { color: var(--heading-dark); }
  .eppx-account__header p { color: var(--subheading-gray); }

  .eppx-account__quad {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    overflow: hidden;
  }

  .eppx-account__cell {
    min-height: 360px;
    padding: 46px;
  }
  .eppx-account__cell:nth-child(odd) { border-right: 1px solid #e5e7eb; }
  .eppx-account__cell:nth-child(n + 3) { border-top: 1px solid #e5e7eb; }

  .eppx-account__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  .eppx-account__tag {
    margin-bottom: 18px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #eef2ff;
    color: #375dfb;
    font: 650 12px/1 var(--font-body);
  }
  .eppx-account__copy h3 {
    margin: 0 0 14px;
    color: var(--heading-dark);
    font: 500 30px/1.15 var(--font-heading);
    letter-spacing: -.03em;
  }
  .eppx-account__copy p {
    margin: 0 0 22px;
    color: var(--subheading-gray);
    font: 400 16px/1.65 var(--font-body);
  }
  .eppx-account__copy strong {
    color: #344054;
    font: 650 13px/1.4 var(--font-body);
  }

  .eppx-account__media {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #f4f7ff, #fff);
  }

  .eppx-settings {
    width: min(100%, 390px);
    padding: 20px;
    border: 1px solid #dfe5f0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(35, 50, 88, .12);
    font-family: var(--font-body);
  }
  .eppx-settings__top,
  .eppx-settings label,
  .eppx-settings__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .eppx-settings__top {
    padding-bottom: 15px;
    border-bottom: 1px solid #e8edf5;
    color: #202939;
    font-size: 13px;
    font-weight: 700;
  }
  .eppx-settings__top i {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: #375dfb;
  }
  .eppx-settings label,
  .eppx-settings__row {
    margin-top: 12px;
    padding: 12px 13px;
    border: 1px solid #e8edf5;
    border-radius: 10px;
    color: #697386;
    font-size: 11px;
  }
  .eppx-settings label span { color: #202939; font-weight: 650; }
  .eppx-settings small {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: #667085;
    font-size: 10px;
  }
  .eppx-settings small i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
  }
  .eppx-settings__row b {
    padding: 5px 8px;
    border-radius: 999px;
    background: #eafaf3;
    color: #087a51;
    font-size: 9px;
  }

  .eppx-account__note {
    max-width: 780px;
    margin: 28px auto 0;
    padding-left: 16px;
    border-left: 3px solid #375dfb;
    color: #667085;
    font: 500 14px/1.6 var(--font-body);
  }

  @media (max-width: 900px) {
    .eppx-gateway__grid { grid-template-columns: repeat(2, 1fr); }
    .eppx-gateway__card, .eppx-gateway__card:nth-child(n + 4) { grid-column: span 1; }
    .eppx-gateway__card:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {
    .eppx-gateway, .eppx-account { width: min(100% - 32px, 1140px); padding: 72px 0; }
    .eppx-gateway__header h2, .eppx-account__header h2 { font-size: 34px; }
    .eppx-gateway__grid { grid-template-columns: 1fr; }
    .eppx-gateway__card, .eppx-gateway__card:nth-child(n + 4), .eppx-gateway__card:last-child {
      grid-column: 1;
      min-height: 300px;
      padding: 28px;
    }
    .eppx-account__quad { grid-template-columns: 1fr; }
    .eppx-account__cell { min-height: auto; padding: 34px 24px; border-right: 0 !important; border-top: 1px solid #e5e7eb; }
    .eppx-account__cell:first-child { border-top: 0; }
    .eppx-account__media { min-height: 320px; }
    .eppx-account__copy:nth-child(4) { grid-row: 3; }
    .eppx-account__media:nth-child(3) { grid-row: 4; }
  }
</style>
