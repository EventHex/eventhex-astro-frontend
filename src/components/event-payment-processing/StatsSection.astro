---
const stages = [
  { value: "Connect", label: "Supported account" },
  { value: "Checkout", label: "Payment handoff" },
  { value: "Confirm", label: "Provider result" },
  { value: "Deliver", label: "Ticket outcome" },
  { value: "Refund", label: "Full or partial" },
  { value: "Review", label: "Event finance" },
];
---

<section class="eppx-reference" aria-label="One connected payment lifecycle">
  <div class="eppx-reference__inner">
    {stages.map((stage) => (
      <a class="eppx-reference__stat" href="#gateway-heading">
        <b>{stage.value}</b>
        {stage.label}
      </a>
    ))}
  </div>
</section>

<style>
  /* Matches the compact post-hero trust strip on Event Registration. */
  .eppx-reference {
    border-top: 1px solid var(--surface-card-border);
    background: #fff;
    padding: 1.5rem;
  }

  .eppx-reference__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem 2.25rem;
  }

  .eppx-reference__stat {
    color: var(--subheading-gray);
    font: 400 0.9375rem/1.5 var(--font-body);
    white-space: nowrap;
    text-decoration: none;
  }

  .eppx-reference__stat:hover {
    text-decoration: none;
  }

  .eppx-reference__stat b {
    color: var(--heading-dark);
    font-weight: 700;
  }

  .eppx-reference__stat:hover b {
    color: var(--brand-blue);
  }

  @media (max-width: 640px) {
    .eppx-reference__inner {
      justify-content: flex-start;
      gap: 0.6rem 1.5rem;
    }
  }
</style>
