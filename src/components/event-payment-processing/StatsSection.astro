---
const stages = [
  ["Connect", "Supported account"],
  ["Checkout", "Payment handoff"],
  ["Confirm", "Provider result"],
  ["Deliver", "Ticket outcome"],
  ["Refund", "Full or partial"],
  ["Review", "Event finance"],
];
---

<section class="eppx-rail" aria-labelledby="eppx-rail-title">
  <div class="eppx-rail__heading">
    <span>One connected payment lifecycle</span>
    <h2 id="eppx-rail-title">From gateway setup to finance review</h2>
  </div>
  <div class="eppx-rail__inner">
    {stages.map(([title, detail], index) => (
      <div class="eppx-rail__stage">
        <span class="eppx-rail__number">{String(index + 1).padStart(2, "0")}</span>
        <span><b>{title}</b>{detail}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .eppx-rail {
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
    background: #fff;
  }

  .eppx-rail__heading {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 24px 0 14px;
    text-align: center;
  }

  .eppx-rail__heading span {
    color: #375dfb;
    font: 700 12px/1.4 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .eppx-rail__heading h2 {
    margin: 5px 0 0;
    color: #22272f;
    font: 500 22px/1.25 var(--font-heading);
    letter-spacing: -0.02em;
  }

  .eppx-rail__inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }

  .eppx-rail__stage {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 12px;
    border-left: 1px solid #e8edf5;
    color: #697386;
    font: 500 12px/1.35 var(--font-body);
  }

  .eppx-rail__stage:last-child { border-right: 1px solid #e8edf5; }
  .eppx-rail__stage > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .eppx-rail__stage b { color: #22272f; font-size: 14px; }

  .eppx-rail__number {
    display: grid;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: #eef2ff;
    color: #375dfb;
    font-size: 10px;
    font-weight: 750;
  }

  @media (max-width: 900px) {
    .eppx-rail__inner { grid-template-columns: repeat(3, 1fr); padding-bottom: 16px; }
    .eppx-rail__stage:nth-child(n + 4) { border-top: 1px solid #e8edf5; }
  }

  @media (max-width: 540px) {
    .eppx-rail__heading { text-align: left; }
    .eppx-rail__inner { grid-template-columns: repeat(2, 1fr); }
    .eppx-rail__stage:nth-child(n + 3) { border-top: 1px solid #e8edf5; }
  }
</style>
