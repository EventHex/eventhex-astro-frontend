---
const stages = [
  { value: "Connect", label: "Supported account" },
  { value: "Checkout", label: "Payment handoff" },
  { value: "Confirm", label: "Provider result" },
  { value: "Deliver", label: "Ticket outcome" },
  { value: "Refund", label: "Full or partial" },
  { value: "Review", label: "Event finance" },
];
---

<section class="eppx-reference" aria-label="One connected payment lifecycle">
  <div class="eppx-reference__inner">
    {stages.map((stage) => (
      <a class="eppx-reference__stage" href="#gateway-heading">
        <b>{stage.value}</b>
        <span>{stage.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* Matches the compact post-hero reference strip on AI Event Copilot. */
  .eppx-reference {
    width: 100%;
    padding: 58px 24px;
    border-top: 1px solid var(--surface-card-border);
    color: var(--heading-dark);
    background: #fff;
  }

  .eppx-reference__inner {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    max-width: 1180px;
    margin: 0 auto;
  }

  .eppx-reference__stage {
    display: flex;
    min-width: 0;
    min-height: 74px;
    padding: 8px 24px;
    border-right: 1px solid var(--surface-card-border);
    flex-direction: column;
    justify-content: center;
    color: var(--body-light);
    font: 13px/1.3 var(--font-body);
    text-decoration: none;
  }

  .eppx-reference__stage:last-child {
    border-right: 0;
  }

  .eppx-reference__stage b {
    display: block;
    margin-bottom: 4px;
    color: var(--heading-dark);
    font: 600 18px/1.15 var(--font-heading);
  }

  .eppx-reference__stage:hover b {
    color: var(--brand-blue);
  }

  @media (max-width: 960px) {
    .eppx-reference {
      padding-block: 34px;
    }

    .eppx-reference__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .eppx-reference__stage {
      border-bottom: 1px solid var(--surface-card-border);
    }

    .eppx-reference__stage:nth-child(2n) {
      border-right: 0;
    }

    .eppx-reference__stage:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .eppx-reference {
      padding: 26px 16px;
    }

    .eppx-reference__inner {
      grid-template-columns: 1fr;
    }

    .eppx-reference__stage,
    .eppx-reference__stage:nth-child(2n) {
      min-height: 66px;
      padding-inline: 16px;
      border-right: 0;
      border-bottom: 1px solid var(--surface-card-border);
    }

    .eppx-reference__stage:nth-last-child(2) {
      border-bottom: 1px solid var(--surface-card-border);
    }

    .eppx-reference__stage:last-child {
      border-bottom: 0;
    }
  }
</style>
