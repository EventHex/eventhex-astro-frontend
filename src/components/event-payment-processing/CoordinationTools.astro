---
const trustItems = [
  {
    title: "Masked credentials",
    description: "Keep stored credential values out of normal organizer responses.",
    image: "/feature-images/event-payment-processing/v5/custom.webp",
    alt: "Custom Payment selected: Payment Gateway choices Stripe, Razorpay and TapPay, then API key and secret key fields with the note that they must never be exposed publicly",
    width: 2240,
    height: 1080,
  },
  {
    title: "Provider checkout",
    description: "Use the active integration path for the selected gateway.",
    image: "/feature-images/event-payment-processing/v5/checkout.webp",
    alt: "Meridian attendee checkout: buyer information form, order summary with Member x 1 at $290 and Continue",
    width: 2480,
    height: 1600,
  },
  {
    title: "Provider settlement",
    description: "Treat payout timing and account status as processor-specific.",
    image: "/feature-images/event-payment-processing/payout-integrations.png",
    alt: "EventHex organization Integrations page showing Payment Gateway, Stripe Connect, and Razorpay Route payout settings",
    width: 968,
    height: 450,
  },
  {
    title: "EventHex order state",
    description: "Use EventHex for the event order, ticket outcome, refund action, and finance context it records.",
    image: "/feature-images/event-payment-processing/v5/orders.webp",
    alt: "Orders page: 1,248 orders, 36 today, 9 failed, USD 318,420 total, each order with ticket, discount, amount, B2B flag, payment status and date",
    width: 2240,
    height: 1800,
  },
];

const links = [
  {
    href: "/event-ticketing/",
    title: "Event Ticketing",
    description: "Configure ticket price, capacity, sale windows, discounts, and access rules.",
    icon: '<path d="M4 9V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6Z"/><path d="M13 5v14"/>',
  },
  {
    href: "/event-registration/",
    title: "Event Registration",
    description: "Choose the form or checkout journey that creates the paid order.",
    icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  },
  {
    href: "/invoicing-gst/",
    title: "Invoicing and tax",
    description: "Collect billing details and generate an order-linked PDF invoice with configured tax lines.",
    icon: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  },
  {
    href: "/event-check-in/",
    title: "Event Check-In",
    description: "Use confirmed attendee records and QR tickets at arrival.",
    icon: '<path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><path d="m9 12 2 2 4-4"/>',
  },
];

const manualPaths = [
  {
    id: "gateway",
    tone: "auto",
    label: "Online gateway payment",
    title: "Online gateway payment",
    description:
      "Provider confirmation and webhook paths update the order through the supported integration.",
    status: "Automated provider path",
    image: "/feature-images/event-payment-processing/v5/config.webp",
    alt: "Payment Configuration with EventHex Payment selected and the Stripe fee estimate",
    width: 2240,
    height: 1130,
  },
  {
    id: "offline",
    tone: "manual",
    label: "Manual or offline payment",
    title: "Manual or offline payment",
    description:
      "The organizer provides instructions and remains responsible for confirming receipt outside EventHex gateway automation.",
    status: "Organizer-verified path",
    image: "/feature-images/event-payment-processing/v5/config.webp",
    alt: "Payment Options: EventHex Payment, Organization Payment, Custom Payment and Manual Payment (customer pays by bank account or UPI manually)",
    width: 2240,
    height: 1130,
  },
];
---

<section class="eppx-manual" aria-labelledby="manual-heading">
  <header class="eppx-manual__header">
    <span class="eppx-manual__badge">Manual payment instructions</span>
    <h2 id="manual-heading" class="eppx-manual__title">
      <span class="eppx-manual__title-line">Keep an offline payment option</span>
      <span class="eppx-manual__title-line ds-hl">separate from gateway automation</span>
    </h2>
    <p class="eppx-manual__subtitle">
      For bank transfer or another manual path, EventHex can show organizer-provided
      instructions and record the order flow without pretending the platform verified the external payment.
    </p>
  </header>

  <div
    class="eppx-manual__tabs animate-on-scroll"
    data-animation="fadeInUp"
    role="tablist"
    aria-label="Payment paths"
  >
    {manualPaths.map((tab, index) => (
      <button
        type="button"
        class={`eppx-manual__tab${index === 0 ? " eppx-manual__tab--active" : ""}`}
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`manual-panel-${tab.id}`}
        id={`manual-tab-${tab.id}`}
        data-target={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="eppx-manual__box animate-on-scroll" data-animation="fadeInUp">
    {manualPaths.map((tab, index) => (
      <div
        class={`eppx-manual__panel eppx-manual__panel--${tab.tone}${index === 0 ? " eppx-manual__panel--active" : ""}`}
        id={`manual-panel-${tab.id}`}
        role="tabpanel"
        aria-labelledby={`manual-tab-${tab.id}`}
        data-panel={tab.id}
      >
        <div class="eppx-manual__left">
          <h3 class="eppx-manual__panel-title">{tab.title}</h3>
          <p class="eppx-manual__panel-desc">{tab.description}</p>
          <span class="eppx-manual__panel-path">{tab.status}</span>
        </div>
        <div class="eppx-manual__right">
          <div class="eppx-manual__showcase">
            <img
              src={tab.image}
              alt={tab.alt}
              width={tab.width}
              height={tab.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="eppx-truststeps ds-night" aria-labelledby="trust-heading">
  <div class="eppx-truststeps__inner">
    <header class="eppx-section-heading">
      <span>Payment setup and trust</span>
      <h2 id="trust-heading">Keep <span class="ds-hl-dark">processor responsibilities</span> clear</h2>
      <p>
        EventHex connects the event order to supported gateway flows while the selected
        payment provider handles its own checkout, methods, settlement, and account requirements.
      </p>
    </header>
    <ol class="eppx-truststeps__list">
      {trustItems.map((item, index) => (
        <li>
          <details open={index === 0}>
            <summary tabindex="-1">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div class="eppx-tstep__content">
                <h3 class="eppx-tstep__title">{item.title}</h3>
                <p class="eppx-tstep__desc">{item.description}</p>
              </div>
              <button
                type="button"
                class="eppx-truststeps__arrow"
                aria-label={`${index === 0 ? "Collapse" : "Expand"} ${item.title}`}
                aria-expanded={index === 0 ? "true" : "false"}
              >
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m5 7.5 5 5 5-5" />
                </svg>
              </button>
            </summary>
            <div class="eppx-truststeps__visual">
              <img
                src={item.image}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="eppx-links ds-stage" aria-labelledby="links-heading">
  <div class="eppx-links__inner">
    <header class="eppx-section-heading">
      <span>Connected event commerce</span>
      <h2 id="links-heading">Continue into the job that <span class="ds-hl">owns the detail</span></h2>
      <p>Payments sit between ticket selection and the financial documents or attendee outcomes that follow.</p>
    </header>
    <div class="eppx-links__grid">
      {[0, 1, 2].map((n) => (
        <div class={`eppx-notch eppx-notch--${n + 1}`} aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path>
          </svg>
        </div>
      ))}
      {links.map((link, index) => (
        <a href={link.href} class="eppx-links__card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          <span class="eppx-links__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={link.icon}
            ></svg>
          </span>
          <h3>{link.title}</h3>
          <p>{link.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".eppx-truststeps details").forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".eppx-truststeps__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      const label = item.querySelector(".eppx-tstep__title")?.textContent?.trim() ?? "section";
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} ${label}`);
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<script>
  document.querySelectorAll(".eppx-manual").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".eppx-manual__tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".eppx-manual__panel"));
    if (!tabs.length || !panels.length) return;

    const activate = (tab: HTMLButtonElement) => {
      const target = tab.getAttribute("data-target");
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle("eppx-manual__tab--active", isActive);
        item.setAttribute("aria-selected", String(isActive));
      });
      panels.forEach((panel) => {
        panel.classList.toggle(
          "eppx-manual__panel--active",
          panel.getAttribute("data-panel") === target,
        );
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const step = event.key === "ArrowRight" ? 1 : tabs.length - 1;
        const next = tabs[(index + step) % tabs.length];
        next.focus();
        activate(next);
      });
    });
  });
</script>

<style>
  .eppx-section-heading {
    max-width: 850px;
    margin: 0 auto 42px;
    text-align: center;
  }
  .eppx-section-heading > span {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--ds-blue);
    font: 650 13px/1.3 var(--ds-font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .eppx-section-heading h2 {
    margin: 0;
    color: var(--ds-ink);
    font: 500 clamp(36px, 4.6vw, 56px)/1.05 var(--ds-font-heading);
    letter-spacing: -.045em;
  }
  .eppx-section-heading p {
    max-width: 720px;
    margin: 20px auto 0;
    color: var(--ds-body);
    font: 400 17px/1.65 var(--ds-font-body);
  }

  .eppx-manual {
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
    padding: 108px 0;
  }
  /* Tabbed panel suite carried over from the Speaker Management
     "Built for the events that are hardest to coordinate" section. */
  .eppx-manual__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 34px;
    text-align: center;
  }
  .eppx-manual__badge {
    margin-bottom: 16px;
    color: var(--ds-blue);
    font: 650 13px/1.3 var(--ds-font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .eppx-manual__title {
    max-width: 820px;
    margin: 0 0 16px;
    font: 500 clamp(36px, 4.5vw, 56px)/1.1 var(--ds-font-heading);
    letter-spacing: -.03em;
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .eppx-manual__title-line { display: block; }
  .eppx-manual__subtitle {
    max-width: 720px;
    margin: 0;
    color: var(--ds-muted);
    font: 500 17.5px/1.5 var(--ds-font-body);
  }
  .eppx-manual__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 6px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    background: var(--ds-surface-tab);
  }
  .eppx-manual__tab {
    padding: 8px 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ds-cat-slate);
    font: 600 13.5px/1 var(--ds-font-body);
    cursor: pointer;
    transition: background .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .eppx-manual__tab:hover { background: rgba(255, 255, 255, .65); color: var(--ds-ink-2); }
  .eppx-manual__tab--active,
  .eppx-manual__tab--active:hover {
    border-color: var(--ds-line-strong);
    background: var(--ds-white);
    box-shadow: 0 2px 8px rgba(30, 41, 59, .08);
    color: var(--ds-blue);
  }
  .eppx-manual__box { background: transparent; }
  .eppx-manual__panel {
    --eppx-manual-tint: var(--ds-warning-soft);
    --eppx-manual-border: var(--ds-line-strong);
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding: 52px 64px;
    border: 1px solid var(--eppx-manual-border);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--eppx-manual-tint) 0%, var(--ds-white) 72%);
    animation: eppxManualFade .4s ease forwards;
  }
  .eppx-manual__panel--manual {
    --eppx-manual-tint: var(--ds-surface);
    --eppx-manual-border: var(--ds-cat-sky-bg);
  }
  @keyframes eppxManualFade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .eppx-manual__panel--active { display: grid; }
  .eppx-manual__left { min-width: 0; }
  .eppx-manual__panel-title {
    margin: 0 0 18px;
    color: var(--ds-ink);
    font: 500 clamp(30px, 3.6vw, 40px)/1.1 var(--ds-font-heading);
    letter-spacing: -.03em;
  }
  .eppx-manual__panel-desc {
    max-width: 46ch;
    margin: 0;
    color: var(--ds-sub);
    font: 500 16px/1.6 var(--ds-font-body);
  }
  .eppx-manual__panel-path {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    color: var(--ds-ink-2);
    font: 650 13px/1.4 var(--ds-font-body);
  }
  .eppx-manual__panel-path::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ds-success);
  }
  .eppx-manual__panel--manual .eppx-manual__panel-path::before { background: var(--ds-warning); }
  .eppx-manual__right { min-width: 0; }
  .eppx-manual__showcase {
    display: flex;
    align-items: center;
    min-height: 220px;
    position: relative;
    isolation: isolate;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, .9);
    border-radius: 24px;
    background: rgba(255, 255, 255, .58);
    box-shadow: 0 22px 48px rgba(31, 41, 55, .1);
  }
  .eppx-manual__showcase::before {
    content: "";
    position: absolute;
    inset: 10% 7% -8%;
    z-index: -1;
    border-radius: 12px;
    background: var(--eppx-manual-border);
    filter: blur(22px);
    opacity: .48;
  }
  .eppx-manual__showcase img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--ds-line-strong);
    border-radius: 14px;
    background: var(--ds-white);
    box-shadow: 0 20px 46px rgba(31, 41, 72, .14);
  }

  /* Accordion step list carried over from the Speaker Management
     "From call for papers to published program" section. */
  .eppx-truststeps {
    padding: clamp(100px, 11vw, 140px) 24px;
    background: transparent;
  }
  .eppx-truststeps__inner { width: min(1218px, 100%); margin: 0 auto; }
  .eppx-truststeps .eppx-section-heading { margin-bottom: 64px; }
  .eppx-truststeps__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eppx-truststeps__list > li { position: relative; }
  .eppx-truststeps details {
    --eppx-tstep-tint: var(--ds-warning-soft);
    --eppx-tstep-border: var(--ds-line-strong);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--eppx-tstep-border);
    border-radius: 18px;
    background: linear-gradient(135deg, var(--eppx-tstep-tint) 0%, var(--ds-white) 82%);
    box-shadow: 0 8px 24px rgba(31, 41, 55, .04);
    transition: border-radius .35s ease, background .35s ease, box-shadow .25s ease, transform .25s ease;
  }
  .eppx-truststeps details > summary {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    min-height: 82px;
    padding: 18px 82px 18px 20px;
    cursor: pointer;
    list-style: none;
    transition: background .25s ease;
  }
  .eppx-truststeps details > summary::-webkit-details-marker { display: none; }
  .eppx-truststeps details > summary:hover { background: rgba(255, 255, 255, .28); }
  .eppx-truststeps details:not([open]):hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(31, 41, 55, .08);
  }
  .eppx-truststeps details > summary > span {
    color: var(--ds-night-2);
    font: 500 15px/1.1 var(--ds-font-heading);
    letter-spacing: -.05em;
  }
  .eppx-tstep__content { display: flex; flex-direction: column; }
  .eppx-truststeps details:not([open]) .eppx-tstep__content {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: 36px;
  }
  .eppx-tstep__title {
    margin: 0;
    color: var(--ds-night-2);
    font: 500 22px/1.2 var(--ds-font-body);
    letter-spacing: -.02em;
  }
  .eppx-tstep__desc { display: none; }
  .eppx-truststeps details:not([open]) .eppx-tstep__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    max-width: 460px;
    margin: 0;
    color: var(--ds-muted);
    font: 400 14.5px/1.5 var(--ds-font-body);
  }
  .eppx-truststeps__arrow {
    position: absolute;
    top: 24px;
    right: 28px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid rgba(17, 24, 39, .2);
    border-radius: 50%;
    background: rgba(255, 255, 255, .78);
    color: var(--ds-night-2);
    cursor: pointer;
    transition: transform .25s ease, background .2s ease, border-color .2s ease;
  }
  .eppx-truststeps__arrow:hover { border-color: rgba(17, 24, 39, .42); background: var(--ds-white); }
  .eppx-truststeps__arrow:focus-visible { outline: 3px solid rgba(59, 130, 246, .28); outline-offset: 2px; }
  .eppx-truststeps__arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .eppx-truststeps details[open] .eppx-truststeps__arrow { top: 28px; transform: rotate(180deg); }
  .eppx-truststeps details[open] {
    display: flex;
    align-items: stretch;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--eppx-tstep-tint) 0%, var(--ds-white) 72%);
  }
  .eppx-truststeps__list > li:nth-child(1) > details { --eppx-tstep-tint: var(--ds-warning-soft); --eppx-tstep-border: var(--ds-line-strong); }
  .eppx-truststeps__list > li:nth-child(2) > details { --eppx-tstep-tint: var(--ds-surface); --eppx-tstep-border: var(--ds-cat-sky-bg); }
  .eppx-truststeps__list > li:nth-child(3) > details { --eppx-tstep-tint: var(--ds-surface-tab); --eppx-tstep-border: var(--ds-surface-tint); }
  .eppx-truststeps__list > li:nth-child(4) > details { --eppx-tstep-tint: var(--ds-surface); --eppx-tstep-border: var(--ds-line-strong); }
  .eppx-truststeps__list > li:nth-child(5) > details { --eppx-tstep-tint: var(--ds-surface-tab); --eppx-tstep-border: var(--ds-line-strong); }
  .eppx-truststeps details[open] > summary {
    flex: 0 0 55%;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    min-height: 0;
    padding: 64px 40px 64px 28px;
    background: transparent;
  }
  .eppx-truststeps details[open] > summary:hover { padding-left: 28px; background: transparent; }
  .eppx-truststeps details[open] > summary > span { font-size: 26px; line-height: 1; color: var(--ds-black); }
  .eppx-truststeps details[open] .eppx-tstep__title {
    margin: 0 0 16px;
    color: var(--ds-black);
    font-family: var(--ds-font-heading);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }
  .eppx-truststeps details[open] .eppx-tstep__desc {
    display: block;
    max-width: 90%;
    margin: 0 0 32px;
    color: var(--ds-ink-2);
    font-size: 17px;
    line-height: 1.6;
