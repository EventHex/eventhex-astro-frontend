---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const faqItems = [
  {
    q: "Can EventHex process donations?",
    a: "No. EventHex does not include donation processing or a fundraising CRM. Paid event tickets can use the supported event-payment paths where appropriate.",
  },
  {
    q: "Can an event use registration without a paid ticket?",
    a: "Yes. Use the appropriate registration flow and ticket configuration; platform pricing remains a separate commercial decision.",
  },
  {
    q: "Does EventHex schedule volunteer shifts?",
    a: "No. EventHex does not include volunteer scheduling or rostering.",
  },
  {
    q: "Can we reach previous event attendees?",
    a: "Yes. Event Marketing can build supported audiences from current and previous EventHex registration data.",
  },
  {
    q: "Does EventHex generate nonprofit impact reports?",
    a: "No. EventHex does not create a specialized donor or impact report. Use the event analytics and exports in the organization's own reporting process.",
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex NGO and Nonprofit Event Management Software",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Coordinate fundraising galas, awareness events, community programmes, volunteer-facing events, and nonprofit conferences with registration, ticketing, campaigns, websites, badges, check-in, and reporting.",
  url: "https://eventhex.ai/industries/ngo/",
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Event registration and ticketing",
    "Event marketing audiences",
    "Event websites",
    "Badges and QR check-in",
    "Programme and speaker workflows",
    "Event analytics and exports",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

