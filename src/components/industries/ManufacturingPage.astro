  .mfg-links { padding: clamp(58px,4.5vw,76px) 24px clamp(52px,4vw,68px); scroll-margin-top: 68px; background: linear-gradient(rgba(255,255,255,0),rgba(255,255,255,.82) 62%,#fff); }
