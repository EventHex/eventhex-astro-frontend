<style>
  .mfg-page {
    --mfg-shadow: 0 22px 54px rgba(35, 49, 89, 0.1);
    overflow: clip;
    background:
      radial-gradient(
        ellipse 75% 68% at 50% 40%,
        rgba(255, 255, 255, 0.94) 0%,
        rgba(255, 255, 255, 0.65) 38%,
        rgba(255, 255, 255, 0.28) 58%,
        transparent 78%
      ),
      linear-gradient(
        to bottom,
        #fff 0,
        rgba(255, 255, 255, 0.85) 130px,
        rgba(255, 255, 255, 0.5) 260px,
        rgba(255, 255, 255, 0.18) 390px,
        transparent 500px
      ),
      linear-gradient(
        to top,
        #fff 0,
        rgba(255, 255, 255, 0.7) 70px,
        rgba(255, 255, 255, 0.3) 130px,
        transparent 190px
      ),
      radial-gradient(circle 380px at 3% 34%, rgba(175, 163, 255, 0.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 30%, rgba(255, 182, 213, 0.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 75%, rgba(130, 170, 255, 0.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 78%, rgba(255, 224, 150, 0.2) 0%, transparent 100%),
      #fff;
    background-attachment: fixed;
    color: var(--heading-dark);
    font-family: var(--font-body);
  }

  .mfg-shell {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .mfg-section {
    padding-block: clamp(72px, 8vw, 108px);
  }

  .mfg-section--soft {
    background: var(--surface-light);
  }

  .mfg-eyebrow {
    margin: 0 0 16px;
    color: var(--brand-blue);
    font: 700 0.8125rem/1.4 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mfg-heading {
    max-width: 760px;
    margin-bottom: 40px;
  }

  .mfg-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .mfg-heading h2 {
    margin: 0;
    color: var(--heading-dark);
    font: 500 clamp(36px, 4vw, 56px)/1.08 var(--font-heading);
    letter-spacing: -0.03em;
  }

  .mfg-heading > p:last-child {
    max-width: 650px;
    margin: 18px 0 0;
    color: var(--subheading-gray);
    font-size: 17px;
    line-height: 1.62;
  }

  .mfg-heading--center > p:last-child {
    margin-inline: auto;
  }

  .mfg-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
    border: 1px solid transparent;
    border-radius: 10px;
    font: 600 15px/1.4 var(--font-body);
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .mfg-button:hover { transform: translateY(-2px); }
  .mfg-button:focus-visible,
  .mfg-links__card a:focus-visible,
  .mfg-faq summary:focus-visible {
    outline: 3px solid rgba(55, 93, 251, 0.34);
    outline-offset: 4px;
  }

  .mfg-button--primary { background: var(--heading-dark); color: #fff; }
  .mfg-button--primary:hover { background: #000; box-shadow: 0 12px 26px rgba(34, 39, 47, 0.18); }
  .mfg-button--secondary { border-color: #dce4ff; background: rgba(255,255,255,.92); color: var(--heading-dark); }
  .mfg-button--secondary:hover { border-color: #c5d2ff; box-shadow: 0 10px 24px rgba(55,93,251,.1); }
  .mfg-button--light { background: #fff; color: var(--heading-dark); }
  .mfg-button--light:hover { background: #f4f6ff; box-shadow: 0 14px 30px rgba(0,0,0,.18); }

  .mfg-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background: transparent;
  }

  .mfg-hero::after {
    position: absolute;
    z-index: 2;
    inset: 0 0 0 auto;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, #fff0, #ffffff73 70%, #ffffffbf);
    content: "";
    pointer-events: none;
  }

  .mfg-hero__shell {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .mfg-hero__grid {
    display: grid;
    max-width: 1080px;
    margin: 0 auto;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }

  .mfg-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    text-align: left;
  }

  .mfg-hero__badge {
    margin: 0;
    color: var(--brand-blue);
    font: 500 16px/24px var(--font-body);
    text-transform: uppercase;
  }

  .mfg-hero__title {
    width: 100%;
    max-width: 620px;
    margin: 0;
    background: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font: 500 52px/58px var(--font-heading);
    letter-spacing: -2.1px;
  }

  .mfg-hero__title span {
    display: block;
    color: inherit;
    white-space: nowrap;
  }

  .mfg-hero__lead {
    width: 100%;
    max-width: 560px;
    margin: 0;
    color: var(--subheading-gray);
    font: 400 18px/24px var(--font-body);
    letter-spacing: -.25px;
  }

  .mfg-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mfg-hero__points li {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-left: 16px;
    color: #475467;
    font: 500 14px/20px var(--font-body);
  }

  .mfg-hero__points li::before {
    position: absolute;
    top: 7px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    content: "";
  }

  .mfg-actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 0; padding-top: 6px; }

  .mfg-hero__visual {
    position: relative;
    z-index: 3;
    margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px));
  }

  .mfg-hero__visual-card {
    position: relative;
    padding: 14px;
    border: 1px solid rgba(255,255,255,.62);
    border-right: 0;
    border-radius: 22px 0 0 22px;
    background: linear-gradient(180deg,#ffffff9e,#ffffff47),#ffffff57;
    backdrop-filter: blur(16px);
  }

  .mfg-hero__visual-inner {
    position: relative;
    height: 480px;
    overflow: hidden;
    border-radius: 16px 0 0 16px;
    background: linear-gradient(135deg,#d9ecfa,#eef6fc 45%,#fff);
  }

  .mfg-hero-phone,
