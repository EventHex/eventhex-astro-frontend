---
interface Props {
  faqs: [string, string][];
}

const { faqs } = Astro.props;

const operatingStages = [
  ["Recruit", "Exhibitors + buyers"],
  ["Approve", "Packages + access"],
  ["Prepare", "Teams + passes"],
  ["Meet", "Discovery + appointments"],
  ["Capture", "QR/manual leads"],
  ["Export", "Qualified data"],
];

const attendeeJourney = [
  {
    title: "Exhibitor onboarding",
    copy: "Move approved companies into the portal workflow.",
    bullets: ["Collect approved company records", "Add product and resource details", "Prepare teams, passes, and badges"],
  },
  {
    title: "Buyer registration",
    copy: "Collect event-specific attendee and ticket information.",
    bullets: ["Configure attendee fields", "Apply ticket and access rules", "Keep the attendee record connected"],
  },
  {
    title: "Preparation",
    copy: "Publish programme, exhibitor details, and operational updates.",
    bullets: ["Publish the event programme", "Share exhibitor details", "Send supported audience updates"],
  },
  {
    title: "Arrival",
    copy: "Validate attendee and exhibitor access.",
    bullets: ["Scan configured event QR codes", "Confirm attendee access", "Keep attendance status current"],
  },
  {
    title: "Meet and capture",
    copy: "Use meetings and lead capture during the event.",
    bullets: ["Support participant discovery", "Coordinate appointments", "Capture QR or manual leads"],
  },
  {
    title: "Handoff",
    copy: "Export supported lead data for the next business workflow.",
    bullets: ["Review team activity", "Export supported lead data", "Continue in the responsible system"],
  },
];

const boundaryScopes = [
  {
    id: "product",
    tab: "Product scope",
    title: "EventHex workflow",
    description: "Configure the supported event, audience, access, content, communication, engagement, and event-day mechanisms.",
    checklist: ["Registration and access", "Programme and communication", "Engagement and event-day operations"],
    visualLabel: "EventHex-owned workflow",
    visualTitle: "Manufacturing event workspace",
    visualRows: [["Registration", "Configured"], ["Programme", "Connected"], ["Event day", "Ready"]],
    image: "/images/industries/associations/portal/event-setup-web-960.webp",
    imageAlt: "EventHex event setup with ticket, venue, registration, and module controls",
  },
  {
    id: "review",
    tab: "Review scope",
    title: "Your specialist requirements",
    description: "Map legal, regulatory, accreditation, identity, accessibility, venue, payment-provider, and industry-specific obligations to the teams and systems responsible for them.",
    checklist: ["Name the requirement owner", "Confirm the responsible system", "Record the implementation decision"],
    visualLabel: "Specialist review required",
    visualTitle: "Requirement ownership review",
    visualRows: [["Legal and regulatory", "Assign owner"], ["Accreditation", "Validate"], ["External systems", "Confirm separately"]],
    image: "/images/industries/associations/portal/crm-integrations-web-960.webp",
    imageAlt: "EventHex CRM integrations screen for reviewing external systems and data connections",
  },
];

const eventFormats = [
  {
    id: "trade-fairs",
    index: "01",
    title: "Industrial trade fairs",
    copy: "Connect exhibitors, buyers, passes, leads, meetings, and event data.",
    modifier: "conference",
    checklist: ["Exhibitor and buyer workflows", "Passes, meetings, and lead capture", "Connected event reporting"],
    visualLabel: "Trade fair workflow",
    visualRows: [["Programme", "Connected"], ["Partners", "Ready"], ["Registration", "Open"]],
    image: "/images/industries/associations/portal/event-dashboard-web-960.webp",
    imageAlt: "EventHex event dashboard with registration and ticket activity",
  },
  {
    id: "supply-chain",
    index: "02",
    title: "Supply-chain summits",
    copy: "Build programme, registration, partners, networking, and event day.",
    modifier: "chapter",
    checklist: ["Programme and registration", "Partners and networking", "Connected event-day workflow"],
    visualLabel: "Summit workspace",
    visualRows: [["Event setup", "Focused"], ["Region", "Assigned"], ["Portfolio", "Visible"]],
    image: "/images/industries/associations/portal/programme-sessions-web-960.webp",
    imageAlt: "EventHex programme workspace with scheduled sessions and speakers",
  },
  {
    id: "conferences",
    index: "03",
    title: "Manufacturing conferences",
    copy: "Coordinate sessions, speakers, delegate access, and engagement.",
    modifier: "awards",
    checklist: ["Sessions and speakers", "Delegate access", "Supported engagement features"],
    visualLabel: "Conference programme",
    visualRows: [["Guest access", "Configured"], ["Badges", "Connected"], ["Seating", "Review separately"]],
    image: "/images/industries/associations/portal/registration-analytics-web-960.webp",
    imageAlt: "EventHex event analytics showing registrations, sessions, speakers, and exhibitors",
  },
  {
    id: "machinery-expos",
    index: "04",
    title: "Machinery expos",
    copy: "Run exhibitor teams, attendee entry, lead capture, and follow-up-ready exports.",
    modifier: "tradeshow",
    checklist: ["Exhibitor teams", "Attendee entry and lead capture", "Supported data exports"],
    visualLabel: "Expo operations",
    visualRows: [["Exhibitors", "Onboarded"], ["Meetings", "Available"], ["Lead capture", "Active"]],
    image: "/images/industries/associations/portal/event-portfolio-web-960.webp",
    imageAlt: "EventHex event portfolio showing event workspaces, dates, and locations",
  },
];

const featureLinks = [
  ["Exhibitor Management", "Run exhibitor and lead operations.", "/exhibitor-management/"],
  ["Appointments & Meetings", "Coordinate B2B meetings.", "/appointments-meetings/"],
  ["Event Check-In", "Operate attendee and team arrival.", "/event-check-in/"],
  ["Event Analytics", "Review event signals.", "/event-analytics/"],
];
---

<div class="mfg-page">
  <section id="hero" class="mfg-hero" aria-labelledby="mfg-hero-title">
    <div class="mfg-hero__shell">
      <div class="mfg-hero__grid">
      <div class="mfg-hero__content">
        <p class="mfg-hero__badge animate-on-scroll" data-animation="fadeInDown">Event management software for manufacturing events</p>
        <h1 id="mfg-hero-title" class="mfg-hero__title animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <span>Connect exhibitors,</span>
          <span>buyers, meetings, leads,</span>
          <span>and event day for</span>
          <span>industrial events</span>
        </h1>
        <p class="mfg-hero__lead animate-on-scroll" data-animation="fadeInUp" data-delay="150">
          Run industrial trade fairs, supply-chain summits, manufacturing conferences, and machinery expos with exhibitor portals, attendee access, badges, lead capture, meetings, communication, and reporting.
        </p>
        <ul class="mfg-hero__points animate-on-scroll" data-animation="fadeInUp" data-delay="220">
          <li>Exhibitor operations</li>
          <li>B2B meetings</li>
          <li>Lead capture</li>
        </ul>
        <div class="mfg-actions animate-on-scroll" data-animation="fadeInUp" data-delay="290">
          <a class="mfg-button mfg-button--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="mfg-button mfg-button--secondary" href="#operating-map">See the operating model</a>
        </div>
      </div>

      <div class="mfg-hero__visual animate-on-scroll" data-animation="fadeInRight" data-delay="120">
        <div class="mfg-hero__visual-card">
          <img
            class="mfg-hero__screenshot"
            src="/images/industries/manufacturing/portal/exhibitor-packages.webp"
            srcset="/images/industries/manufacturing/portal/exhibitor-packages-web-640.webp 640w, /images/industries/manufacturing/portal/exhibitor-packages.webp 946w"
            sizes="(max-width: 1024px) calc(100vw - 48px), 48vw"
            alt="EventHex exhibitor package workspace for managing package access and booth teams"
            width="946"
            height="697"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="mfg-hero__screen-label"><b>Exhibitor workflow</b><small>Packages, teams, and access</small></span>
        </div>
      </div>
      </div>
    </div>
  </section>

  <section id="operating-map" class="mfg-rail" aria-label="One connected event path: see the operating sequence before choosing modules">
    <div class="mfg-rail__inner">
      {operatingStages.map(([label, copy]) => (
        <span class="mfg-rail__item"><b>{label}</b> {copy}</span>
      ))}
    </div>
  </section>

  <section id="event-model" class="erg-bento-section mfg-scope-bento" aria-labelledby="mfg-model-title">
    <div class="erg-bento-container">
      <header class="erg-bento-header animate-on-scroll" data-animation="fadeInUp">
        <h2 id="mfg-model-title">Start with the operating shape that fits the <span class="erg-global-heading-gradient">event</span></h2>
      </header>

      <div class="erg-bento-grid animate-on-scroll" data-animation="fadeInUp">
        <span class="erg-bento-notch erg-bento-notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg></span>
        <span class="erg-bento-notch erg-bento-notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg></span>

        <article class="erg-bento-row">
          <div class="erg-bento-cell erg-bento-visual">
            <div class="erg-bento-shot-stage erg-bento-shot-stage--confirm">
              <img class="erg-bento-product-shot" src="/images/sponsor-management/sponsor-packages-web-806.webp" alt="EventHex exhibitor package configuration with team access controls" width="806" height="696" loading="lazy" decoding="async" />
              <span class="erg-shot-float erg-shot-float--top"><b>Exhibitor first</b><small>Teams + attendee access</small></span>
              <span class="erg-shot-float erg-shot-float--bottom"><i></i><b>Lead workflow connected</b></span>
            </div>
          </div>
          <div class="erg-bento-cell erg-bento-content">
            <span class="erg-bento-eyebrow">Primary model</span>
            <h3>Exhibition-led event</h3>
            <p>Connect exhibitor setup, passes, lead capture, attendee access, and event reporting.</p>
          </div>
          <span class="erg-bento-cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
            </svg>
          </span>
        </article>

        <article class="erg-bento-row erg-bento-row--reverse">
          <div class="erg-bento-cell erg-bento-content">
            <span class="erg-bento-eyebrow">Alternate model</span>
            <h3>Conference-led event</h3>
            <p>Use registration, programme, speakers, meetings, and communications without adding expo complexity.</p>
          </div>
          <div class="erg-bento-cell erg-bento-visual">
            <div class="erg-bento-shot-stage erg-bento-shot-stage--embed">
              <img class="erg-bento-product-shot" src="/images/industries/manufacturing/portal/registration-overview.webp" srcset="/images/industries/manufacturing/portal/registration-overview-web-640.webp 640w, /images/industries/manufacturing/portal/registration-overview.webp 946w" sizes="(max-width: 768px) calc(100vw - 80px), 45vw" alt="EventHex registration overview showing attendee totals and a configured delegate pass" width="946" height="380" loading="lazy" decoding="async" />
              <span class="erg-shot-float erg-shot-float--top"><b>Delegate access</b><small>Registration + tickets</small></span>
              <span class="erg-shot-float erg-shot-float--bottom"><i></i><b>Programme connected</b></span>
            </div>
          </div>
        </article>
      </div>

      <p class="mfg-reference-bento__note">Start with one model, then add only the modules the event actually needs.</p>
    </div>
  </section>

  <section id="core-workflow" class="mfg-dark-band" aria-labelledby="mfg-core-title">
    <header class="mfg-capabilities-heading">
      <p class="mfg-eyebrow">Exhibition operations</p>
      <h2 id="mfg-core-title" class="animate-on-scroll" data-animation="fadeInUp">
        Connect the exhibitor journey <span>to the attendee journey</span>
      </h2>
      <p class="mfg-capabilities-heading__copy">Keep exhibitor records, team access, leads, and event-day activity attached to the same event.</p>
    </header>

    <div class="mfg-cap-grid-section">
      <div class="mfg-cap-grid">
        <article class="mfg-cap-cell animate-on-scroll" data-animation="fadeInUp" data-delay="0">
          <h3 class="mfg-cap-label">Exhibitor portal</h3>
          <p class="mfg-cap-desc">Collect approved exhibitor company, product, resource, team, pass, and badge information.</p>
          <div class="mfg-cap-visual" aria-hidden="true">
            <div class="mfg-cap-card">
              <span class="mfg-cap-card__head">Exhibitor profile</span>
              <div class="mfg-cap-field"><span>Company</span><i></i></div>
              <div class="mfg-cap-field"><span>Products</span><i></i></div>
              <div class="mfg-cap-field"><span>Booth team</span><i></i></div>
              <div class="mfg-cap-field mfg-cap-field--add"><span>+ Add resource</span></div>
            </div>
          </div>
        </article>

        <article class="mfg-cap-cell animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="mfg-cap-petal mfg-cap-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
          <span class="mfg-cap-petal mfg-cap-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
          <h3 class="mfg-cap-label">Buyer and delegate access</h3>
          <p class="mfg-cap-desc">Configure registration, ticket rules, approvals, and event communication.</p>
          <div class="mfg-cap-visual" aria-hidden="true">
            <div class="mfg-cap-chips">
              <span>Buyer</span><span>Delegate</span><span class="is-active">VIP access</span><span>Speaker</span><span>Press</span><span>Partner</span><span>Day pass</span><span>Approval</span><span>Badge</span>
            </div>
          </div>
        </article>

        <article class="mfg-cap-cell animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <span class="mfg-cap-petal mfg-cap-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
          <span class="mfg-cap-petal mfg-cap-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
          <h3 class="mfg-cap-label">Meetings and networking</h3>
          <p class="mfg-cap-desc">Support participant-controlled discovery and the appointment workflow.</p>
          <div class="mfg-cap-visual" aria-hidden="true">
            <div class="mfg-cap-stack">
              <div class="mfg-cap-ticket"><span>Discover participants</span><small>Browse</small></div>
              <div class="mfg-cap-ticket"><span>Meeting request</span><small>Pending</small></div>
              <div class="mfg-cap-ticket is-active"><span>Buyer appointment</span><small>Confirmed</small></div>
            </div>
          </div>
        </article>

        <article class="mfg-cap-cell animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <h3 class="mfg-cap-label">Lead operations</h3>
          <p class="mfg-cap-desc">Capture QR or manual leads, qualify them, review team activity, and export CSV.</p>
          <div class="mfg-cap-visual" aria-hidden="true">
            <div class="mfg-cap-card">
              <span class="mfg-cap-card__head">Lead activity</span>
              <div class="mfg-cap-lead"><b>QR</b><span><strong>Production buyer</strong><i><em></em></i></span></div>
              <div class="mfg-cap-lead"><b>MAN</b><span><strong>Plant manager</strong><i><em style="width: 68%"></em></i></span></div>
            </div>
          </div>
        </article>

        <article class="mfg-cap-cell animate-on-scroll" data-animation="fadeInUp" data-delay="240">
          <span class="mfg-cap-petal mfg-cap-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
          <span class="mfg-cap-petal mfg-cap-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
          <h3 class="mfg-cap-label">One connected event record</h3>
          <p class="mfg-cap-desc">Keep exhibitor, attendee, meeting, lead, and event-day activity attached to the configured event.</p>
          <div class="mfg-cap-visual" aria-hidden="true">
            <div class="mfg-cap-records">
              <div class="is-active"><span>01</span><b>Exhibitors + buyers</b></div>
              <div><span>02</span><b>Appointments + leads</b></div>
              <div><span>03</span><b>Review + export</b></div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="operating-view" class="mfg-coordinate" aria-labelledby="mfg-operations-title">
    <div class="mfg-coordinate__inner">
      <div class="mfg-coordinate__left">
        <h2 id="mfg-operations-title" class="mfg-coordinate__title animate-on-scroll" data-animation="fadeInUp">
          <span class="mfg-coordinate__title-line">Keep the floor team</span>
          <span class="mfg-coordinate__title-line">and event team aligned</span>
        </h2>
        <p class="mfg-coordinate__copy animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 100ms">
          Give each team a clear job while keeping the attendee and event record connected. The event owner sets the operating decisions, specialist teams work in focused areas, and event leadership reviews event and portfolio signals.
        </p>
        <div class="mfg-coordinate__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 200ms">
          <a href="/book-a-demo/" class="mfg-coordinate__btn mfg-coordinate__btn--dark">Book a Demo &rarr;</a>
          <a href="#event-day" class="mfg-coordinate__btn mfg-coordinate__btn--light">Explore Event Day &rarr;</a>
        </div>
      </div>

      <div class="mfg-coordinate__right animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 300ms">
        <div class="mfg-coordinate__showcase">
          <img src="/images/industries/healthcare/app/healthcare-event-analytics-web-890.webp" alt="EventHex event analytics showing registration, programme, and attendance activity" width="890" height="600" loading="lazy" decoding="async" />
          <span class="mfg-coordinate__status">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
            Event owner accountable
          </span>
          <span class="mfg-coordinate__publish">Review event signals</span>
          <svg class="mfg-coordinate__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
        </div>
      </div>
    </div>
  </section>

  <section id="attendee-journey" class="mfg-journey-workflow" aria-labelledby="mfg-journey-title">
    <div class="mfg-journey-workflow__inner">
      <header class="mfg-journey-workflow__header">
        <p class="mfg-eyebrow">Audience experience</p>
        <h2 id="mfg-journey-title">Connect the moments attendees actually move through</h2>
      </header>
      <ol class="mfg-journey-steps">
        {attendeeJourney.map((step, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div class="mfg-journey-step__content">
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                  <ul>
                    {step.bullets.map((bullet) => <li><i aria-hidden="true">+</i>{bullet}</li>)}
                  </ul>
                </div>
                <button
                  type="button"
                  class="mfg-journey-step__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </button>
              </summary>
              <div class="mfg-journey-step__visual">
                {index === 0 && <img src="/images/sponsor-management/exhibitor-list-web-806.webp" alt="EventHex exhibitor list showing company records in the event workspace" width="806" height="696" loading="lazy" decoding="async" />}
                {index === 1 && <img src="/images/industries/associations/attendee-journey/checkout-attendee-details-web-960.webp" alt="EventHex registration checkout collecting attendee and ticket details" width="960" height="439" loading="lazy" decoding="async" />}
                {index === 2 && <img src="/images/industries/associations/attendee-journey/cfp-portal-published-agenda-web-960.webp" alt="Published EventHex event programme with sessions and booking options" width="960" height="720" loading="lazy" decoding="async" />}
                {index === 3 && <img src="/images/industries/healthcare/delegate-qr-arrival.webp" alt="EventHex QR arrival screen confirming delegate access" width="512" height="422" loading="lazy" decoding="async" />}
                {index === 4 && <img src="/images/appointments-meetings/app/registered-attendee-directory.png" alt="EventHex attendee directory used for participant discovery and meeting setup" width="1262" height="698" loading="lazy" decoding="async" />}
                {index === 5 && <img src="/images/industries/associations/attendee-journey/registration-analytics-web-960.webp" alt="EventHex registration analytics dashboard with event totals and timeline" width="960" height="530" loading="lazy" decoding="async" />}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="event-day" class="mfg-event-day" aria-labelledby="mfg-event-day-title">
    <div class="mfg-event-day__container">
      <div class="mfg-event-day__left">
        <header class="mfg-event-day__sticky animate-on-scroll" data-animation="fadeInUp">
          <div class="mfg-event-day__eyebrow">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
            During the event
          </div>
          <h2 id="mfg-event-day-title">Keep event-day actions tied to the <span>same event record</span></h2>
          <p>Keep exhibitor entry, buyer arrival, lead capture, and team visibility connected to the event record.</p>
          <a class="mfg-event-day__cta" href="/book-a-demo/">Book a Demo<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </header>
      </div>

      <div class="mfg-event-day__cards">
        <article class="mfg-event-card animate-on-scroll" data-animation="fadeInUp">
          <div class="mfg-event-card__header"><div class="mfg-event-card__number">01</div><div class="mfg-event-card__text"><h3>Exhibitor team entry</h3><p>Use allocated passes and badges for the configured event.</p></div></div>
          <div class="mfg-event-card__visual"><div class="mfg-event-card__shot mfg-event-card__shot--arrival">
            <img src="/feature-images/event-registration/approval-ticket-list.png" alt="EventHex pass approval list used to prepare team access" width="760" height="430" loading="lazy" decoding="async" />
