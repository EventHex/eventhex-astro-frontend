<script>
  const useCases = document.querySelector<HTMLElement>(".mfg-use-cases");

  if (useCases) {
    const useCaseTabs = Array.from(useCases.querySelectorAll<HTMLButtonElement>("[data-use-case-tab]"));
    const useCasePanels = Array.from(useCases.querySelectorAll<HTMLElement>("[data-use-case-panel]"));

    const activateUseCase = (tab: HTMLButtonElement, moveFocus = false) => {
      const target = tab.dataset.useCaseTab;
      useCaseTabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      useCasePanels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.useCasePanel === target));
      if (moveFocus) tab.focus();
    };

    useCases.classList.add("is-ready");
    useCaseTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateUseCase(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = useCaseTabs[(index + direction + useCaseTabs.length) % useCaseTabs.length];
        if (next) activateUseCase(next, true);
      });
    });
  }

  const journeyItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mfg-journey-steps details"));

  journeyItems.forEach((item) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".mfg-journey-step__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      const title = item.querySelector("h3")?.textContent?.trim() || "journey step";
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} ${title}`);
      if (!item.open) return;
      journeyItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mfg-faq details"));

  faqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const capabilitiesBand = document.querySelector<HTMLElement>(".mfg-dark-band");
  if (capabilitiesBand && capabilitiesBand.dataset.bleedReady !== "true" && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    capabilitiesBand.dataset.bleedReady = "true";
    let capabilitiesTop = 0;
    let capabilitiesViewportHeight = window.innerHeight || 1;
    let capabilitiesTicking = false;
    let capabilitiesProgress = -1;

    const measureCapabilitiesBand = () => {
      capabilitiesViewportHeight = window.innerHeight || 1;
      capabilitiesTop = capabilitiesBand.getBoundingClientRect().top + window.scrollY;
    };

    const updateCapabilitiesBand = () => {
      capabilitiesTicking = false;
      const travelled = capabilitiesViewportHeight - (capabilitiesTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (capabilitiesViewportHeight * .7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === capabilitiesProgress) return;
      capabilitiesProgress = rounded;
      capabilitiesBand.style.setProperty("--band-p", String(rounded));
    };

    const onCapabilitiesScroll = () => {
      if (capabilitiesTicking) return;
      capabilitiesTicking = true;
      requestAnimationFrame(updateCapabilitiesBand);
    };

    const onCapabilitiesResize = () => {
      measureCapabilitiesBand();
      capabilitiesProgress = -1;
      onCapabilitiesScroll();
    };

    measureCapabilitiesBand();
    updateCapabilitiesBand();
    window.addEventListener("scroll", onCapabilitiesScroll, { passive: true });
    window.addEventListener("resize", onCapabilitiesResize, { passive: true });
    window.addEventListener("load", onCapabilitiesResize);
  }

</script>
