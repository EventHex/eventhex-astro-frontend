  { src: "/images/stripe-step-checkout.png", alt: "EventHex analytics view for exhibitor access and badge workflows", status: "Access ready", action: "Review passes" },
  { src: "/images/stripe-flow-review.jpg", alt: "EventHex analytics view for QR and manual lead capture", status: "Lead captured", action: "Qualify contact" },
  { src: "/images/stripe-step-connect.png", alt: "EventHex analytics dashboard for the event overview", status: "Signals live", action: "View overview" },
];

const formats = [
  { label: "Property exhibitions", detail: "Connect exhibitors, attendees, passes, leads, meetings, and reporting." },
  { label: "Developer launches", detail: "Build a branded event, invite audiences, configure access, and capture interest." },
  { label: "Broker conferences", detail: "Combine programme, registration, networking, and follow-up-ready contacts." },
  { label: "Investment summits", detail: "Use configured approval, ticket, programme, and event-day workflows." },
];

const formatVisuals = [
  { src: "/images/platform-analytics-dashboard.jpg", alt: "EventHex platform analytics dashboard for property exhibition activity", status: "Exhibitor operations", action: "Review event data" },
  { src: "/images/_tmp-analytics-reference.png", alt: "EventHex platform analytics view for developer launch registration and activity", status: "Launch ready", action: "Open event data" },
  { src: "/images/razorpay-platform-analytics-reference.png", alt: "EventHex platform analytics view for broker conference registrations and payments", status: "Conference live", action: "Review registrations" },
  { src: "/images/stripe-analytics-overview.png", alt: "EventHex analytics overview for investment summit event signals", status: "Summit overview", action: "View event signals" },
