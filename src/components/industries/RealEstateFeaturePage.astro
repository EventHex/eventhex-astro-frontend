  <script>
    const formatStack = document.querySelector<HTMLElement>("#rer-format-stack-cards");
    const formatHeader = formatStack?.closest<HTMLElement>(".rer-format-stack")?.querySelector<HTMLElement>(".rer-format-stack__header");
    const formatCards = formatStack?.querySelectorAll<HTMLElement>(".rer-format-stack__card");
    const finalFormatCard = formatCards?.[formatCards.length - 1];

    if (formatStack && formatHeader && finalFormatCard) {
      let formatFrame = 0;
      const syncFormatRelease = () => {
        formatFrame = 0;
        const stickyTop = Number.parseFloat(getComputedStyle(finalFormatCard).top) || 0;
        const releaseOffset = Math.min(0, finalFormatCard.getBoundingClientRect().top - stickyTop);
        formatHeader.style.setProperty("--rer-format-release-y", `${releaseOffset}px`);
        formatHeader.style.transform = `translateY(${releaseOffset}px)`;
      };
      const queueFormatRelease = () => {
        if (formatFrame) return;
        formatFrame = requestAnimationFrame(syncFormatRelease);
      };

      window.addEventListener("scroll", queueFormatRelease, { passive: true });
      window.addEventListener("resize", queueFormatRelease, { passive: true });
      syncFormatRelease();
    }
  </script>

