const mechanisms = [
  { label: "Exhibitor Management", detail: "Run exhibitor and lead workflows.", href: "/exhibitor-management/" },
  { label: "Event Registration", detail: "Configure visitor intake.", href: "/event-registration/" },
  { label: "Appointments & Meetings", detail: "Coordinate event meetings.", href: "/appointments-meetings/" },
  { label: "Event Analytics", detail: "Review event signals.", href: "/event-analytics/" },
];

const mechanismTabs = [
  {
    id: "exhibitor-management",
    label: "Exhibitor Management",
    title: "Keep exhibitor work in one place",
    description: "Run exhibitor, company, product, pass, badge, and lead workflows from the same connected event record.",
    checklist: ["Company and product records", "Pass and badge workflows", "QR or manual lead capture"],
    image: "/images/razorpay-platform-analytics-organizations.png",
    imageAlt: "EventHex analytics view showing connected exhibitor organisations",
    visualLabel: "Exhibitor records linked"
  },
  {
    id: "event-registration",
    label: "Event Registration",
    title: "Shape the visitor intake",
    description: "Configure the registration flow, collect the event-specific fields, and keep ticket and access details tied to the attendee record.",
    checklist: ["Custom registration fields", "Ticket and approval rules", "Event-day access details"],
    image: "/images/_tmp-analytics-reference.png",
    imageAlt: "EventHex registration analytics view for attendee intake and ticket activity",
    visualLabel: "Registration flow ready"
  },
  {
    id: "appointments-meetings",
    label: "Appointments & Meetings",
    title: "Coordinate the conversations",
    description: "Give attendees and exhibitors a clear path to discover one another and manage the meetings configured for the event.",
    checklist: ["Attendee and exhibitor discovery", "Meeting availability", "Connected event context"],
    image: "/images/platform-analytics-dashboard.jpg",
    imageAlt: "EventHex platform analytics dashboard for attendee discovery and meeting activity",
    visualLabel: "Meetings in context"
  },
  {
    id: "event-analytics",
    label: "Event Analytics",
    title: "Review the signals that matter",
    description: "Use the event record to review attendance, registration, exhibitor, and lead signals without treating them as sales attribution.",
    checklist: ["Attendance and registration signals", "Exhibitor and lead views", "Export-ready event data"],
    image: "/images/stripe-analytics-overview.png",
    imageAlt: "EventHex analytics overview for attendance, exhibitor, and event signals",
    visualLabel: "Event signals visible"
  },
];

const prepCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`,
    title: "Start with the event format",
    body: "Choose the smallest workflow that matches this event.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`,
    title: "Add only the modules you need",
    body: "Use the connected feature pages to understand each mechanism.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3.1-6.8"></path><polyline points="21 3 21 9 15 9"></polyline><polyline points="8 12 11 15 17 9"></polyline></svg>`,
    title: "Review the setup in the demo",
    body: "Bring market, event, audience, access, communication, and onsite requirements.",
  },
];

const faqs = [
  {
    q: "Can exhibitors manage their own company and team information?",
    a: "Yes. The exhibitor portal supports company, product, resource, team, pass, and badge workflows.",
  },
  {
    q: "Can exhibitor teams scan leads?",
    a: "Yes. They can use supported QR or manual lead capture, add qualification detail, and export CSV.",
  },
  {
    q: "Does EventHex include a floor-plan editor?",
    a: "No. EventHex does not include a floor-plan editor.",
  },
  {
    q: "Can leads be sent to a CRM?",
    a: "An optional best-effort exhibitor CRM handoff exists where configured. It is not a guaranteed bidirectional sync or sales workflow.",
  },
  {
    q: "Can EventHex prove property sales ROI?",
    a: "No. Attendance, exhibitor, and lead data must not be presented as property-sales attribution or ROI.",
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Real Estate Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: "Event management software for property expos, developer launches, broker conferences, and investment summits with connected exhibitor, registration, communication, participation, and event-day workflows.",
  url: "https://eventhex.ai/industries/real-estate/",
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Exhibitor portal workflows",
    "Custom visitor registration",
    "QR and manual lead capture",
    "Event tickets and badges",
    "Meetings and attendee discovery",
    "Event analytics and reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<div class="rer-page">
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="rer-hero">
    <div class="rer-shell rer-hero__grid">
      <div class="rer-hero__copy">
        <p class="rer-eyebrow">Event management software for property events</p>
        <h1>
          <span>Connect property-event</span>
          <span>exhibitors, visitors,</span>
          <span>leads, and</span>
          <span>follow-up-ready data</span>
        </h1>
        <p class="rer-lead">Run property expos, developer launches, broker conferences, and investment summits with exhibitor operations, registration, tickets, badges, QR arrival, lead capture, meetings, and reporting.</p>
        <div class="rer-hero__points" aria-label="Event workflow highlights">
          <span>Exhibitor portal workflows</span>
          <span>QR and manual lead capture</span>
          <span>Event-day reporting</span>
        </div>
        <div class="rer-actions">
          <a class="rer-button rer-button--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="rer-button rer-button--quiet" href="#rer-sequence">See the workflow</a>
        </div>
      </div>

      <div class="rer-hero__visual" aria-label="Connected real estate event workflow preview">
        <div class="rer-hero__visual-card">
          <div class="rer-hero__visual-inner">
            <img
              src="/images/razorpay-platform-analytics-usage.png"
              alt="EventHex platform analytics feature usage and plan distribution dashboard"
              class="rer-hero__img"
              width="1262"
              height="697"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rer-section rer-section--light rer-sequence-section" id="rer-sequence">
    <div class="rer-shell">
      <div class="rer-sequence" role="list" aria-label="Connected event workflow">
        {stages.map((stage) => (
          <div class="rer-sequence__item" role="listitem">
            <span class="rer-sequence__label">{stage.label}</span>
            <span class="rer-sequence__detail">{stage.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rer-model-spotlight">
    <div class="rer-model-spotlight__header">
      <p class="rer-eyebrow">Choose the right event model</p>
      <h2 class="rer-model-spotlight__title">Start with the operating shape that fits the event</h2>
      <p class="rer-model-spotlight__subtitle">Pick the event model that matches how your property audience moves through the day. Add only the modules the event actually needs.</p>
    </div>

    <div class="rer-model-spotlight__grid">
      <article class="rer-model-spotlight__cell rer-model-spotlight__cell--copy">
        <h3>Exhibition-led event</h3>
        <p>Connect exhibitor setup, passes, lead capture, attendee access, and event reporting.</p>
      </article>
      <div class="rer-model-spotlight__cell rer-model-spotlight__cell--media">
        <div class="rer-model-spotlight__composite">
          <img class="rer-model-spotlight__screen rer-model-spotlight__screen--primary" src="/images/platform-analytics-dashboard.jpg" alt="EventHex platform analytics dashboard for exhibition event activity" width="1262" height="697" loading="lazy" />
          <img class="rer-model-spotlight__screen rer-model-spotlight__screen--secondary" src="/images/_tmp-analytics-reference.png" alt="EventHex platform analytics view of registration and check-in trends" width="1262" height="697" loading="lazy" />
          <span class="rer-model-spotlight__status">Exhibitor operations</span>
          <span class="rer-model-spotlight__action">Review event data</span>
        </div>
      </div>

      <div class="rer-model-spotlight__cell rer-model-spotlight__cell--media">
        <div class="rer-model-spotlight__composite">
          <img class="rer-model-spotlight__screen rer-model-spotlight__screen--primary" src="/images/razorpay-platform-analytics-organizations.png" alt="EventHex platform analytics organization and event operations view for conferences" width="1262" height="697" loading="lazy" />
          <img class="rer-model-spotlight__screen rer-model-spotlight__screen--secondary" src="/images/razorpay-platform-analytics-payment-result.png" alt="EventHex platform analytics feature usage and plan distribution view for conferences" width="1262" height="697" loading="lazy" />
          <span class="rer-model-spotlight__status">Conference operations</span>
          <span class="rer-model-spotlight__action">Review event data</span>
        </div>
      </div>
      <article class="rer-model-spotlight__cell rer-model-spotlight__cell--copy">
        <h3>Conference-led event</h3>
        <p>Use registration, programme, speakers, meetings, and communications without adding expo complexity.</p>
      </article>
    </div>
  </section>

  <section class="rer-section rer-section--dark rer-exhibition-band" id="rer-exhibition">
    <div class="rer-shell">
      <div class="rer-section__heading rer-section__heading--dark"><p class="rer-eyebrow">Exhibition operations</p><h2>Connect the exhibitor journey to the attendee journey</h2><p>Keep exhibitor records, team access, leads, and event-day activity attached to the same event.</p></div>
      <div class="rer-exhibition-grid">
        <article class="rer-exhibition-card rer-exhibition-card--portal">
          <span class="rer-exhibition-label">01 · Exhibitor portal</span>
          <h3>One record for every booth team</h3>
          <p>Move approved exhibitors into a portal for company, product, resource, team, pass, and badge details.</p>
          <div class="rer-exhibition-visual rer-portal-ui" aria-hidden="true">
            <div class="rer-ui-window__top"><span>Exhibitor portal</span><i></i></div>
            <div class="rer-ui-row"><b>Company profile</b><span>Complete</span></div>
            <div class="rer-ui-row"><b>Team access</b><span>6 members</span></div>
            <div class="rer-ui-row"><b>Passes + badges</b><span>Ready</span></div>
          </div>
          <a class="rer-exhibition-link" href="/exhibitor-management/">Learn about exhibitor management <span aria-hidden="true">→</span></a>
        </article>

        <article class="rer-exhibition-card rer-exhibition-card--registration">
          <span class="rer-exhibition-label">02 · Visitor registration</span>
          <h3>Configure buyer intake</h3>
          <p>Use custom and ticket-specific fields to configure buyer, broker, investor, or guest intake.</p>
          <div class="rer-exhibition-visual rer-form-ui" aria-hidden="true">
            <div class="rer-ui-window__top"><span>Visitor registration</span><b>Live</b></div>
            <div class="rer-ui-input"><span>Full name</span><i></i></div>
            <div class="rer-ui-input"><span>Company / role</span><i></i></div>
            <div class="rer-ui-chip-row"><em>Buyer</em><em class="is-active">Broker</em><em>Investor</em></div>
          </div>
        </article>

        <article class="rer-exhibition-card rer-exhibition-card--leads">
          <span class="rer-exhibition-label">03 · Lead capture</span>
          <h3>Capture useful contacts</h3>
          <p>Let exhibitor teams capture QR or manual leads, qualify them, and export CSV.</p>
          <div class="rer-exhibition-visual rer-leads-ui" aria-hidden="true">
            <div class="rer-ui-window__top"><span>New lead captured</span><i class="rer-ui-dot"></i></div>
            <div class="rer-lead-row"><span class="rer-lead-avatar">AM</span><b>Arun Mathew</b><em>QR scan</em></div>
            <div class="rer-lead-row"><span class="rer-lead-avatar rer-lead-avatar--violet">SK</span><b>Sarah Khan</b><em>Qualified</em></div>
            <div class="rer-ui-progress"><i></i></div>
          </div>
        </article>

        <article class="rer-exhibition-card rer-exhibition-card--meetings">
          <span class="rer-exhibition-label">04 · Meetings and follow-up</span>
          <h3>Keep the next step connected</h3>
          <p>Connect attendee discovery and meeting operations; use optional best-effort CRM handoff only where configured.</p>
          <div class="rer-exhibition-visual rer-meetings-ui" aria-hidden="true">
            <div class="rer-ui-window__top"><span>Follow-up queue</span><b>Today</b></div>
            <div class="rer-meeting-row"><span>10:30</span><b>Buyer briefing</b><i>Ready</i></div>
            <div class="rer-meeting-row"><span>12:15</span><b>Booth meeting</b><i>Next</i></div>
            <div class="rer-meeting-row"><span>15:45</span><b>Send qualified leads</b><i>CSV</i></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="rer-section rer-section--light rer-team-section" id="rer-team">
    <div class="rer-shell">
      <div class="rer-team-heading"><p class="rer-eyebrow">Team coordination</p><h2>Keep the floor team and event team aligned</h2><p>Give each team a clear job while keeping the attendee and event record connected.</p></div>
      <div class="rer-team-grid" role="list" aria-label="Event team responsibilities">
        <span class="rer-team-notch rer-team-notch--one" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg></span>
        <span class="rer-team-notch rer-team-notch--two" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg></span>
        <article class="rer-team-card" role="listitem">
          <span class="rer-team-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path><path d="M5 5 3 3"></path></svg></span>
          <div class="rer-team-card__content"><h3>Event owner</h3><p>Sets the event, audience, access, programme, and reporting decisions.</p></div>
        </article>
        <article class="rer-team-card" role="listitem">
          <span class="rer-team-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span>
          <div class="rer-team-card__content"><h3>Specialist teams</h3><p>Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.</p></div>
        </article>
        <article class="rer-team-card" role="listitem">
          <span class="rer-team-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 15 4-4 3 3 5-6"></path><path d="M17 8h2v2"></path></svg></span>
          <div class="rer-team-card__content"><h3>Event leadership</h3><p>Reviews event and portfolio signals for the next operating decision.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="rer-section rer-audience-access" id="rer-audience">
    <div class="rer-shell rer-audience-access__container">
      <div class="rer-audience-access__left">
        <div class="rer-audience-access__sticky">
          <div class="rer-audience-access__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>Audience experience</div>
          <h2>Connect the moments attendees actually move through</h2>
          <p>Keep discovery, registration, arrival, engagement, and exhibitor follow-up connected to one event record.</p>
          <a class="rer-audience-access__cta" href="/book-a-demo/">Book a Demo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>
      </div>

      <div class="rer-audience-access__right">
        {journeyCards.map((card, index) => (
          <article class:list={["rer-audience-card", `rer-audience-card--${index + 1}`]} style={`--audience-index: ${index};`}>
            <div class="rer-audience-card__header"><div class="rer-audience-card__number">0{index + 1}</div><div class="rer-audience-card__text"><h3>{card.label}</h3><p>{card.detail}</p></div></div>
            <div class="rer-audience-card__visual"><img src={journeyVisuals[index].src} alt={journeyVisuals[index].alt} width="1262" height="697" loading="lazy" /><span class="rer-audience-card__status">{journeyVisuals[index].status}</span><span class="rer-audience-card__action">{journeyVisuals[index].action}</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rer-section rer-event-bento" id="rer-event-day">
    <div class="rer-shell rer-event-bento__container">
      <div class="rer-event-bento__header"><p class="rer-eyebrow">During the event</p><h2>Keep event-day actions tied to the same event record</h2></div>
      <div class="rer-event-bento__grid">
        <span class="rer-event-bento__notch rer-event-bento__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg></span>
        <span class="rer-event-bento__notch rer-event-bento__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg></span>
        {eventDaySteps.map((step, index) => (
          <div class:list={["rer-event-bento__row", { "rer-event-bento__row--reverse": index % 2 === 1 }]}>
