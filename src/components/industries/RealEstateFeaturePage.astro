  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const suite = document.querySelector<HTMLElement>(".rer-mechanisms");
      if (!suite) return;

      const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".rer-mechanisms__tab"));
      const panels = Array.from(suite.querySelectorAll<HTMLElement>(".rer-mechanisms__panel"));
      let rotationId: number | undefined;

      const activateTab = (tab: HTMLButtonElement) => {
        const targetId = tab.getAttribute("data-target");
        if (!targetId) return;

        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("rer-mechanisms__tab--active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((panel) => {
          panel.classList.toggle("rer-mechanisms__panel--active", panel.getAttribute("data-panel") === targetId);
        });
      };

      const stopRotation = () => {
        if (rotationId === undefined) return;
        window.clearInterval(rotationId);
        rotationId = undefined;
      };

      const startRotation = () => {
        stopRotation();
        if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        rotationId = window.setInterval(() => {
          const currentIndex = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
          activateTab(tabs[(currentIndex + 1) % tabs.length]);
        }, 4000);
      };

      tabs.forEach((tab) => tab.addEventListener("click", () => {
        activateTab(tab);
        startRotation();
      }));
      suite.addEventListener("mouseenter", stopRotation);
      suite.addEventListener("mouseleave", startRotation);
      suite.addEventListener("focusin", stopRotation);
      suite.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) startRotation();
      });
      document.addEventListener("visibilitychange", () => (document.hidden ? stopRotation() : startRotation()));
      startRotation();
    });
  </script>

