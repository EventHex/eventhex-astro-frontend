    .gov-hero { margin-top: -80px; padding: 120px 18px 44px; }
    .gov-hero__title, .gov-suites__title { font-size: 38px; line-height: 1.2; letter-spacing: 0; }
    .gov-hero__lead { font-size: 15px; line-height: 1.7; }
    .gov-hero__points { justify-content: center; }
    .gov-hero .gov-actions { width: 100%; flex-direction: column; }
    .gov-hero .gov-btn { width: 100%; justify-content: center; }
    .gov-hero__image { padding: 10px; border-radius: 18px; }
    .gov-hero__image-inner { padding: 18px; border-radius: 14px; }
    .gov-console__bar { padding: 10px 12px; }
    .gov-console__bar b { font-size: 8px; }
    .gov-console__head { gap: 10px; padding: 14px; }
