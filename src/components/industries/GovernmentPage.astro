    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.04);
    border-radius: 12px;
  }
  .gov-programme-card__panel {
    width: min(100%, 360px);
    padding: 16px;
    border-color: transparent;
    border-radius: 16px;
