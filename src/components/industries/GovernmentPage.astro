    .gov-console__head > span { padding: 6px 8px; font-size: 8px; }
    .gov-console__flow { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 0 14px 14px; }
    .gov-console__flow div { min-height: 88px; gap: 6px; padding: 10px; }
