  .gov-programme-card__handoff { display: grid; width: min(100%, 380px); grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; }
  .gov-programme-card__handoff > span { display: grid; gap: 8px; min-height: 104px; align-content: center; padding: 16px; }
  .gov-programme-card__handoff > i { color: #9baaff; font: 400 24px/1 var(--font-body); font-style: normal; }
  .gov-programme-card__handoff small, .gov-programme-card__onsite small { color: rgba(255,255,255,.48); font: 500 10.5px/1.2 var(--font-body); }
  .gov-programme-card__handoff b, .gov-programme-card__onsite b { color: rgba(255,255,255,.88); font: 700 12px/1.25 var(--font-body); }
  .gov-programme-card__onsite { width: min(100%, 370px); }
  .gov-programme-card__onsite > span { min-height: 53px; }
  .gov-programme-card__onsite > span small { margin-right: auto; }

  @keyframes govProgrammeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes govProgrammeBloom { 0%, 100% { opacity: .68; } 50% { opacity: 1; } }
  @keyframes govProgrammePulse { 0%, 100% { opacity: .88; } 50% { opacity: 1; } }
  .gov-programme-card__panel,
  .gov-programme-card__handoff,
  .gov-programme-card__onsite { animation: govProgrammeFloat 7s ease-in-out infinite; }
  .gov-programme-card:nth-child(2) .gov-programme-card__handoff { animation-delay: -1.4s; }
  .gov-programme-card:nth-child(3) .gov-programme-card__panel { animation-delay: -2.8s; }
  .gov-programme-card:nth-child(4) .gov-programme-card__onsite { animation-delay: -4.2s; }
