  .gov-faq__question::-webkit-details-marker { display: none; }
  .gov-faq__icon { position: relative; width: 18px; height: 18px; flex-shrink: 0; transition: transform .28s cubic-bezier(.22, 1, .36, 1); }
  .gov-faq__icon::before, .gov-faq__icon::after { position: absolute; top: 50%; left: 50%; background: #000; content: ''; transform: translate(-50%, -50%); }
  .gov-faq__icon::before { width: 14px; height: 2px; }
  .gov-faq__icon::after { width: 2px; height: 14px; transition: opacity .2s ease; }
  .gov-faq__item[open] .gov-faq__icon { transform: scale(.9); }
