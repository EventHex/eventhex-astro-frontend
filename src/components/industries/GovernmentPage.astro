  .gov-faq__item { counter-increment: government-faq; overflow: hidden; padding: 4px 28px; border: 1px solid #e4e7ec; border-radius: 20px; background: #fff; transition: background .25s ease, border-color .25s ease; }
  .gov-faq__item[open] { border-color: #e4e7ec; background: #e4e7ec; }
