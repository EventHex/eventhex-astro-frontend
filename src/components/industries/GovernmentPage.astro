    .gov-programme-card__handoff > i { transform: rotate(90deg); text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .gov-programme-band { clip-path: none; will-change: auto; } .gov-console, .gov-hero__screenshot, .gov-model-screen, .gov-event-product-shot__cursor, .gov-suites__panel, .gov-programme-card__panel, .gov-programme-card__handoff, .gov-programme-card__onsite, .gov-programme-card__visual::before, .gov-programme-card__steps .is-active, .gov-programme-card__fields .is-active, .gov-programme-card__onsite .is-active, .gov-programme-card__handoff .is-active { animation: none; } .gov-btn, .gov-demo__btn, .gov-connected__card, .gov-grid-card, .gov-event-card, .gov-event-day__cta, .gov-faq__cta, .gov-faq__item, .gov-faq__icon, .gov-faq__icon::after, .gov-suites__tab { transition: none; } .gov-btn:hover, .gov-demo__btn:hover, .gov-grid-card:hover, .gov-event-card:hover, .gov-event-day__cta:hover, .gov-faq__cta:hover { transform: none; } }
</style>

<script>
  function initGovernmentFaq() {
    const items = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-gov-faq]"));
    items.forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  }

  function initGovernmentProgrammeBand() {
    const band = document.querySelector<HTMLElement>(".gov-programme-band");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let lastProgress = -1;
    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * .7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === lastProgress) return;
      lastProgress = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      lastProgress = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  function initGovernmentSuites() {
    const suite = document.querySelector<HTMLElement>(".gov-suites");
    if (!suite || suite.dataset.suitesReady === "true") return;

    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>("[data-gov-suite-tab]"));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>("[data-gov-suite-panel]"));
    if (!tabs.length || !panels.length) return;

    suite.dataset.suitesReady = "true";
    suite.classList.add("is-ready");
    let rotationId: number | undefined;

    const activate = (tab: HTMLButtonElement, moveFocus = false) => {
      const target = tab.dataset.govSuiteTab;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.govSuitePanel === target));
      if (moveFocus) tab.focus();
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };
    const startRotation = () => {
      stopRotation();
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const current = Math.max(0, tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true"));
        activate(tabs[(current + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activate(tab);
        startRotation();
      });
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next], true);
      });
    });

    suite.addEventListener("mouseenter", stopRotation);
    suite.addEventListener("mouseleave", startRotation);
    suite.addEventListener("focusin", stopRotation);
    suite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) startRotation();
    });
    startRotation();
  }

  function initGovernmentPage() {
    initGovernmentFaq();
    initGovernmentProgrammeBand();
    initGovernmentSuites();
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initGovernmentPage);
  else initGovernmentPage();
</script>
