  .gov-programme-band__heading h2 {
    max-width: 920px;
    margin: 0 auto;
    background: linear-gradient(100deg, #fff 0%, #f2f0ff 26%, #c9c2ff 52%, #a79aff 74%, #7d8dff 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font: 500 clamp(36px, 4.3vw, 56px)/1.08 var(--font-heading);
    letter-spacing: -.03em;
  }
  .gov-programme-band__heading h2 span { white-space: nowrap; }
  .gov-programme-band__intro { max-width: 650px; margin: 22px auto 0; color: rgba(255,255,255,.62); font: 400 17px/1.62 var(--font-body); }

  .gov-programme-grid {
    display: grid;
    max-width: 1076px;
