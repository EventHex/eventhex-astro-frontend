  .gov-programme-card__panel-label { display: block; margin-bottom: 10px; color: rgba(255,255,255,.55); font: 400 12px/1.3 var(--font-body); }
  .gov-programme-card__steps, .gov-programme-card__fields, .gov-programme-card__onsite { display: grid; gap: 10px; }
  .gov-programme-card__steps > span,
