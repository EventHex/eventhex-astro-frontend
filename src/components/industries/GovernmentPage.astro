---
import FeatureCards from "../speaker-management/FeatureCards.astro";

interface Props {
  faqs: [string, string][];
}

const { faqs } = Astro.props;

const operatingStages = [
  ["Scope", "Audience + event"],
  ["Configure", "Fields + approval"],
  ["Publish", "Programme + website"],
  ["Notify", "Selected audiences"],
  ["Validate", "Badge + QR"],
  ["Review", "Attendance + data"],
];

const eventDaySteps = [
  ["Entry validation", "Scan event QR codes and distinguish valid, duplicate, and ineligible attempts."],
  ["Offline resilience", "Continue supported capture when venue connectivity is unstable."],
  ["Audience updates", "Send operational push announcements to the selected app audience."],
  ["Live attendance", "Give the operating team current arrival context."],
];

const attendeeJourneyCards = [
  {
    title: "Invitation",
    desc: "Guide each attendee group to the intended entry point.",
    image: "/images/industries/associations/attendee-journey/lifecycle-before-event-web-936.webp",
    alt: "EventHex event communication lifecycle before an attendee arrives",
    animated: true,
    width: 936,
    height: 340,
  },
  {
    title: "Application or registration",
    desc: "Collect configured information and use approval where appropriate.",
    image: "/images/industries/associations/attendee-journey/checkout-attendee-details-web-960.webp",
    alt: "EventHex registration checkout collecting configured attendee details",
    animated: true,
    width: 960,
    height: 439,
  },
  {
    title: "Programme",
    desc: "Publish session and speaker information for the event.",
    image: "/images/industries/associations/attendee-journey/cfp-portal-published-agenda-web-960.webp",
    alt: "EventHex published agenda with sessions and speakers available to attendees",
    animated: true,
    width: 960,
    height: 720,
  },
  {
    title: "Updates",
    desc: "Send supported campaigns and operational announcements.",
    image: "/images/event-notifications/app/push-platform-notifications-web-900.webp",
    alt: "EventHex push notification workspace for operational event announcements",
    animated: true,
    width: 900,
    height: 483,
  },
  {
    title: "Arrival",
    desc: "Validate the event ticket and keep attendance current.",
    image: "/images/industries/associations/attendee-journey/scan-engine-figma-web-512.webp",
    alt: "EventHex QR scanner showing attendee arrival validation states",
    animated: true,
    width: 512,
    height: 422,
  },
  {
    title: "Review",
    desc: "Use event-level analytics and controlled exports within the product scope.",
    image: "/images/industries/associations/attendee-journey/registration-analytics-web-960.webp",
    alt: "EventHex registration analytics showing event-level attendee activity",
    animated: true,
    width: 960,
    height: 530,
  },
];

const useCases = [
  {
    id: "government-summits",
    title: "Government summits",
    description: "Coordinate delegates, programme, communications, badges, and arrival.",
    action: "Coordinate",
    checklist: ["Delegates", "Programme and communications", "Badges and arrival"],
  },
  {
    id: "policy-conferences",
    title: "Policy conferences",
    description: "Run speaker and session programmes with configured registration.",
    action: "Run",
    checklist: ["Speaker programmes", "Session programmes", "Configured registration"],
  },
  {
    id: "public-consultations",
    title: "Public consultations",
    description: "Collect event registration data and communicate updates while consultation records remain in the responsible system.",
    action: "Collect and communicate",
    checklist: ["Event registration data", "Communicate updates", "Consultation records remain in the responsible system"],
  },
  {
    id: "inter-agency-events",
    title: "Inter-agency events",
    description: "Use scoped event access, invitations, programme, and reporting.",
    action: "Use",
    checklist: ["Scoped event access", "Invitations and programme", "Reporting"],
  },
];

const connectedFeatures = [
  ["Event Registration", "Configure attendee intake and approval.", "/event-registration/"],
  ["Session Management", "Build the event programme.", "/session-management/"],
  ["Event Notifications", "Send operational app announcements.", "/event-notifications/"],
  ["Event Check-In", "Operate arrival validation.", "/event-check-in/"],
];

const connectedFeatureIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="14" y2="17"></line></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h3v3H8z"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3"></path></svg>`,
];
---

<main class="gov-page">
  <section id="hero" class="gov-hero">
    <div class="gov-wrap gov-hero__grid">
      <div class="gov-hero__copy">
        <p class="gov-eyebrow animate-on-scroll" data-animation="fadeInDown">Event management software for public-sector events</p>
        <h1 class="gov-hero__title animate-on-scroll" data-animation="fadeInUp">Configure public-sector registration, programme, communication, and event day</h1>
        <p class="gov-hero__lead animate-on-scroll" data-animation="fadeInUp">
          Run government summits, policy conferences, public consultations, and inter-agency events with configurable registration, approvals, sessions, badges, notifications, check-in, and reporting—within a clear product boundary.
        </p>
        <ul class="gov-hero__points animate-on-scroll" data-animation="fadeInUp" aria-label="Government event workflow priorities">
          <li>Configured registration</li>
          <li>Programme and communications</li>
          <li>Controlled event day</li>
        </ul>
        <div class="gov-actions animate-on-scroll" data-animation="fadeInUp">
          <a class="gov-btn gov-btn--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="gov-btn gov-btn--secondary" href="#operating-map">See the operating model</a>
        </div>
      </div>

      <div class="gov-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="gov-hero__image">
          <div class="gov-hero__image-inner">
            <img class="gov-hero__screenshot" src="/images/industries/healthcare/app/healthcare-event-analytics-web-890.webp" alt="EventHex event analytics showing registration, programme, and attendance activity" width="890" height="600" loading="eager" decoding="async" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="operating-map" class="gov-rail" aria-label="One connected event path. See the operating sequence before choosing modules">
    <div class="gov-rail__inner">
      {operatingStages.map(([label, copy]) => <span class="gov-rail__item"><b>{label}</b> {copy}</span>)}
    </div>
  </section>

  <section id="event-model" class="gov-model" aria-labelledby="gov-model-title">
    <header class="gov-model__header animate-on-scroll" data-animation="fadeInUp">
      <p class="gov-eyebrow">Choose the right event model</p>
      <h2 id="gov-model-title">Start with the operating shape that fits the event</h2>
    </header>

    <div class="gov-model__quad">
      <article class="gov-model__cell gov-model__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Programme-led event</h3>
        <p>Build submissions, speakers, sessions, registration, and the attendee agenda around one programme.</p>
      </article>

      <div class="gov-model__cell gov-model__cell--media animate-on-scroll" data-animation="fadeInRight">
        <div class="gov-model-workspace">
          <img class="gov-model-image" src="/images/industries/healthcare/app/programme-sessions-web-960.webp" alt="EventHex programme workspace with scheduled sessions, speakers, and engagement tools" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="gov-model__cell gov-model__cell--media animate-on-scroll" data-animation="fadeInLeft">
        <div class="gov-model-workspace gov-model-workspace--showcase">
          <img class="gov-model-image" src="/images/industries/healthcare/app/registration-ticket-web-960.webp" alt="EventHex registration workspace showing an active delegate ticket and registration count" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>

      <article class="gov-model__cell gov-model__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Community or showcase event</h3>
        <p>Lead with registration, the event website, communication, arrival, and attendee participation.</p>
      </article>

      <span class="gov-model__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)"></path></svg>
      </span>
    </div>
    <p class="gov-model__note">Start with one model, then add only the modules the event actually needs.</p>
  </section>

  <section id="core-workflow" class="gov-programme-band">
    <header class="gov-programme-band__heading animate-on-scroll" data-animation="fadeInUp">
      <p class="gov-programme-band__eyebrow">Programme operations</p>
      <h2>Move from content intake to a <span>programme people can attend</span></h2>
      <p class="gov-programme-band__intro">Connect the content, people, and access decisions that usually end up in separate files.</p>
    </header>

    <div class="gov-programme-grid">
      <article class="gov-programme-card animate-on-scroll" data-animation="fadeInUp">
        <h3>Registration and approval</h3>
        <p>Configure the attendee journey, fields, ticket/access type, and approval status for the event.</p>
        <div class="gov-programme-card__visual" aria-hidden="true">
          <div class="gov-programme-card__panel">
            <span class="gov-programme-card__panel-label">Attendee journey</span>
            <div class="gov-programme-card__steps">
              <span><i>01</i>Fields<b>Configured</b></span>
              <span class="is-active"><i>02</i>Approval<b>In review</b></span>
              <span><i>03</i>Access<b>Ready</b></span>
            </div>
          </div>
        </div>
      </article>

      <article class="gov-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:60ms">
        <span class="gov-programme-card__petal gov-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Programme coordination</h3>
        <p>Publish sessions, speakers, rooms, time, capacity context, and attendee agenda discovery.</p>
        <div class="gov-programme-card__visual" aria-hidden="true">
          <div class="gov-programme-card__handoff">
            <span><small>Content</small><b>Sessions + speakers</b></span>
            <i>→</i>
            <span class="is-active"><small>Programme</small><b>Publish agenda</b></span>
          </div>
        </div>
      </article>

      <article class="gov-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:120ms">
        <span class="gov-programme-card__petal gov-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Operational communication</h3>
        <p>Use planned campaigns and supported app announcements with clear audience and status controls.</p>
        <div class="gov-programme-card__visual" aria-hidden="true">
          <div class="gov-programme-card__panel">
            <span class="gov-programme-card__panel-label">Audience updates</span>
            <div class="gov-programme-card__fields">
              <span>Audience<i></i></span>
              <span>Channel<i></i></span>
              <span class="is-active">Status control<b>Ready</b></span>
            </div>
          </div>
        </div>
      </article>

      <article class="gov-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:180ms">
        <span class="gov-programme-card__petal gov-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Arrival and reporting</h3>
        <p>Connect badge output, QR validation, offline-resilient capture, live attendance, and event analytics.</p>
        <div class="gov-programme-card__visual" aria-hidden="true">
          <div class="gov-programme-card__onsite">
            <span><small>Badge</small><b>Ready to print</b></span>
            <span class="is-active"><small>QR check-in</small><b>Live</b></span>
            <span><small>Attendance</small><b>Current context</b></span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="operating-view" class="gov-role-template" aria-labelledby="operating-view-title">
    <div class="gov-role-template__shell">
      <header class="gov-role-template__heading animate-on-scroll" data-animation="fadeInUp">
        <p class="gov-eyebrow">Team coordination</p>
        <h2 id="operating-view-title">Give the event team one operating view</h2>
        <p class="gov-role-template__lead">Give each team a clear job while keeping the attendee and event record connected.</p>
      </header>

      <div class="gov-role-template__grid">
        <span class="gov-role-template__notch gov-role-template__notch--one" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>
        <span class="gov-role-template__notch gov-role-template__notch--two" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>
        <article class="gov-role-template__card gov-role-template__card--first animate-on-scroll" data-animation="fadeInUp">
          <div class="gov-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="gov-role-template__content"><h3>Event owner</h3><p>Sets the event, audience, access, programme, and reporting decisions.</p></div>
        </article>

        <article class="gov-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="100">
          <div class="gov-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div class="gov-role-template__content"><h3>Specialist teams</h3><p>Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.</p></div>
        </article>

        <article class="gov-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="200">
          <div class="gov-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 16 4-5 4 3 5-7"></path></svg>
          </div>
          <div class="gov-role-template__content"><h3>Event leadership</h3><p>Reviews event and portfolio signals for the next operating decision.</p></div>
        </article>
      </div>
    </div>
  </section>

  <FeatureCards
    id="attendee-journey"
    cards={attendeeJourneyCards}
    subtitle="Audience experience"
    titleLineOne="Connect the moments attendees"
    highlight="actually"
    titleLineTwo="move through"
    showLinks={false}
  />

  <section id="event-day" class="gov-event-day">
    <div class="gov-event-day__container">
      <div class="gov-event-day__left">
        <div class="gov-event-day__sticky animate-on-scroll" data-animation="fadeInUp">
          <div class="gov-event-day__eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
            </svg>
            During the event
          </div>
          <h2>Keep event-day actions tied to the <span>same event record</span></h2>
          <a class="gov-event-day__cta" href="/book-a-demo/">
            Book a Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="gov-event-day__right">
        <article class="gov-event-card animate-on-scroll" data-animation="fadeInUp">
          <div class="gov-event-card__header">
            <div class="gov-event-card__number">01</div>
            <div class="gov-event-card__text"><h3>{eventDaySteps[0][0]}</h3><p>{eventDaySteps[0][1]}</p></div>
          </div>
          <div class="gov-event-card__visual gov-event-card__visual--1">
            <div class="gov-event-product-shot">
              <img src="/images/industries/healthcare/delegate-qr-arrival.webp" alt="EventHex QR scanner and attendee check-in status for delegate arrival" width="512" height="422" loading="lazy" decoding="async" />
              <span class="gov-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>QR validated</span>
              <span class="gov-event-product-shot__action">Check in delegate</span>
              <svg class="gov-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="gov-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <div class="gov-event-card__header">
            <div class="gov-event-card__number">02</div>
            <div class="gov-event-card__text"><h3>{eventDaySteps[1][0]}</h3><p>{eventDaySteps[1][1]}</p></div>
          </div>
          <div class="gov-event-card__visual gov-event-card__visual--2">
            <div class="gov-offline-board" role="img" aria-label="EventHex check-in queue retaining captured arrivals until venue connectivity returns">
              <div class="gov-offline-board__top"><span>Check-in capture</span><b>Offline-ready</b></div>
              <div class="gov-offline-board__row"><i></i><span>Arrival captured</span><b>Stored</b></div>
              <div class="gov-offline-board__row"><i></i><span>Arrival captured</span><b>Stored</b></div>
              <div class="gov-offline-board__sync"><span></span>Ready to sync</div>
            </div>
          </div>
        </article>

        <article class="gov-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <div class="gov-event-card__header">
            <div class="gov-event-card__number">03</div>
            <div class="gov-event-card__text"><h3>{eventDaySteps[2][0]}</h3><p>{eventDaySteps[2][1]}</p></div>
          </div>
          <div class="gov-event-card__visual gov-event-card__visual--3">
            <div class="gov-event-product-shot">
              <img src="/images/industries/associations/event-day/push-send-alert-web-668.webp" alt="EventHex push announcement composer for a selected event audience" width="668" height="486" loading="lazy" decoding="async" />
              <span class="gov-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Audience selected</span>
              <span class="gov-event-product-shot__action">Send update</span>
              <svg class="gov-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="gov-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <div class="gov-event-card__header">
            <div class="gov-event-card__number">04</div>
            <div class="gov-event-card__text"><h3>{eventDaySteps[3][0]}</h3><p>{eventDaySteps[3][1]}</p></div>
          </div>
          <div class="gov-event-card__visual gov-event-card__visual--4">
            <div class="gov-event-product-shot">
              <img src="/images/industries/healthcare/attendance-review.webp" alt="EventHex attendance workspace showing current arrival totals and attendance status" width="640" height="353" loading="lazy" decoding="async" />
              <span class="gov-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Attendance current</span>
              <span class="gov-event-product-shot__action">Review attendance</span>
              <svg class="gov-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="configuration" class="gov-model gov-model--scope" aria-labelledby="gov-scope-title">
    <header class="gov-model__header animate-on-scroll" data-animation="fadeInUp">
      <p class="gov-eyebrow">Build the right scope</p>
      <h2 id="gov-scope-title">Keep EventHex responsibility separate from specialist requirements</h2>
      <p>Confirm every specialist obligation before implementation and record how it will be handled.</p>
    </header>

    <div class="gov-model__quad">
      <article class="gov-model__cell gov-model__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>EventHex workflow</h3>
        <p>Configure the supported event, audience, access, content, communication, engagement, and event-day mechanisms.</p>
      </article>

      <div class="gov-model__cell gov-model__cell--media animate-on-scroll" data-animation="fadeInRight">
        <div class="gov-model-workspace">
