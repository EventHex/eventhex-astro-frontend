    .gov-demo__shot--list { top: 30px; left: 12px; width: 80%; }
    .gov-demo__shot--settings { right: 12px; bottom: 23px; width: 72%; }
    .gov-demo__status { top: 14px; left: 12px; }
    .gov-demo__review { right: 12px; bottom: 12px; }
