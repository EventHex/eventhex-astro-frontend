  .gov-event-product-shot__status, .gov-event-product-shot__action { position: absolute; z-index: 2; display: inline-flex; align-items: center; border-radius: 10px; box-shadow: 0 10px 24px rgba(17,24,39,.16); white-space: nowrap; font: 700 12px/1 var(--font-body); }
