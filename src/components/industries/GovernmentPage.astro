  .gov-programme-card > p { max-width: 42ch; margin: 0; color: rgba(255,255,255,.62); font: 400 .9375rem/1.38 var(--font-body); }
  .gov-programme-card__petal { position: absolute; left: 0; z-index: 2; width: 28px; height: 28px; pointer-events: none; line-height: 0; }
  .gov-programme-card__petal--top { top: 0; transform: translate(-50%, -50%); }
  .gov-programme-card__petal--bottom { bottom: 0; transform: translate(-50%, 50%); }
