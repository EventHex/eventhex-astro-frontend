  .gov-programme-card__steps i { display: grid; flex: 0 0 25px; width: 25px; height: 25px; place-items: center; border-radius: 8px; background: rgba(255,255,255,.08); color: rgba(255,255,255,.5); font: 700 9px/1 var(--font-body); font-style: normal; }
  .gov-programme-card__steps b, .gov-programme-card__fields b { margin-left: auto; color: rgba(255,255,255,.48); font-size: 10.5px; font-weight: 600; }
  .gov-programme-card__steps .is-active,
