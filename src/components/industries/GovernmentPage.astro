  .gov-role-template__shell { width: min(1200px, 100%); margin: 0 auto; }
  .gov-role-template__heading { max-width: 1040px; margin: 0 auto 68px; text-align: center; }
  .gov-role-template__heading h2 { margin: 0; background: linear-gradient(135deg, #222 0%, #333 40%, #888 100%); color: transparent; font: 500 clamp(36px, 5vw, 56px)/1.1 var(--font-heading); letter-spacing: -.03em; white-space: nowrap; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
