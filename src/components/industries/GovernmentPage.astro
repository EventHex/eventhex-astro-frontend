  .gov-programme-card__visual::before { position: absolute; bottom: -10%; left: 50%; width: 80%; height: 80%; border-radius: 50%; background: radial-gradient(closest-side, rgba(92,138,255,.28), rgba(124,108,255,.15) 55%, transparent 100%); content: ""; filter: blur(30px); transform: translateX(-50%); }
  .gov-programme-card__visual > * { position: relative; z-index: 1; }
  .gov-programme-card__panel,
  .gov-programme-card__handoff > span,
