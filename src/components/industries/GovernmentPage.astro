  .gov-demo__steps li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 2px 10px; align-items: center; padding: 10px 12px; border: 1px solid #e5e9f0; border-radius: 12px; background: rgba(255,255,255,.72); counter-increment: government-demo-step; }
