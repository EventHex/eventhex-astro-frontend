  .asx-faq__question strong::before { content: counter(associations-faq) ". "; }
  .asx-faq__icon { position: relative; width: 18px; height: 18px; flex-shrink: 0; transition: transform .28s cubic-bezier(.22,1,.36,1); }
  .asx-faq__icon::before,
  .asx-faq__icon::after { position: absolute; top: 50%; left: 50%; background: #000; content: ""; transform: translate(-50%,-50%); }
  .asx-faq__icon::before { width: 14px; height: 2px; }
  .asx-faq__icon::after { width: 2px; height: 14px; transition: opacity .2s ease; }
  .asx-faq__item[open] .asx-faq__icon { transform: scale(.9); }
  .asx-faq__item[open] .asx-faq__icon::after { opacity: 0; }
  .asx-faq__answer { max-width: 640px; padding: 0 0 24px; }
  .asx-faq__answer p { margin: 0; color: #000; font: 400 .9375rem/1.7 var(--font-body); }

