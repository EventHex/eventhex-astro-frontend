  .asx-faq { width: 100%; padding: 80px 24px; background: transparent; }
  .asx-faq__shell { display: grid; width: 100%; max-width: 1140px; margin: 0 auto; grid-template-columns: 360px 1fr; gap: 64px; align-items: start; }
  .asx-faq__sidebar { position: sticky; top: 6rem; }
