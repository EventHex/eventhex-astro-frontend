  .asx-coordinate__chrome small { color: #7b8494; font-size: 6.5px; font-weight: 700; }
  .asx-coordinate__tabs { display: flex; gap: 5px; padding: 8px 10px 6px; border-bottom: 1px solid #edf0f5; }
  .asx-coordinate__tabs span { padding: 4px 7px; border-radius: 5px; color: #8a93a4; font-size: 6px; }
  .asx-coordinate__tabs .is-active { border: 1px solid #d9e2ff; background: #eff3ff; color: #4163ed; font-weight: 700; }
  .asx-coordinate__team-list { padding: 5px 9px 10px; }
  .asx-coordinate__team-list > div { display: grid; grid-template-columns: 24px 1fr auto; min-height: 37px; align-items: center; gap: 7px; border-bottom: 1px solid #edf0f5; }
  .asx-coordinate__team-list > div:last-child { border-bottom: 0; }
  .asx-coordinate__team-list > div > i { display: grid; width: 21px; height: 21px; place-items: center; border-radius: 6px; background: #eff3ff; color: #4163ed; font-size: 6px; font-style: normal; font-weight: 800; }
  .asx-coordinate__team-list span { display: flex; min-width: 0; flex-direction: column; gap: 2px; }
  .asx-coordinate__team-list strong { color: #2c3443; font-size: 7px; font-weight: 700; }
  .asx-coordinate__team-list small { overflow: hidden; color: #8a93a4; font-size: 5.5px; text-overflow: ellipsis; white-space: nowrap; }
  .asx-coordinate__team-list b { padding: 3px 5px; border-radius: 999px; background: #f3f5f9; color: #6f7a8c; font-size: 5px; }
  .asx-coordinate__detail-heading { display: flex; padding: 11px 12px 8px; align-items: center; justify-content: space-between; }
  .asx-coordinate__detail-heading span { color: #283142; font-size: 8px; font-weight: 800; }
  .asx-coordinate__detail-heading b { padding: 3px 6px; border-radius: 999px; background: #eefaf6; color: #238866; font-size: 5px; }
  .asx-coordinate__detail-grid { display: grid; padding: 0 12px 8px; grid-template-columns: 1fr 1fr; gap: 6px; }
  .asx-coordinate__detail-grid span { display: flex; min-height: 39px; padding: 7px; flex-direction: column; justify-content: center; gap: 3px; border: 1px solid #e8ecf3; border-radius: 7px; background: #fafbfe; }
