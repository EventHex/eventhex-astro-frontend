  .asx-coordinate__detail-grid b { color: #3a4658; font-size: 7px; }
  .asx-coordinate__detail-note { display: flex; margin: 0 12px 10px; padding: 7px 8px; align-items: center; gap: 7px; border-radius: 6px; background: #26345f; color: #eef2ff; font-size: 5.5px; }
  .asx-coordinate__detail-note i { width: 5px; height: 5px; border-radius: 50%; background: #83e8d2; box-shadow: 0 0 0 3px rgba(131,232,210,.14); }
  .asx-coordinate__status,
  .asx-coordinate__publish { position: absolute; z-index: 5; display: inline-flex; align-items: center; border-radius: 11px; font: 700 13px/1 var(--font-body); box-shadow: 0 8px 22px rgba(42,66,158,.18); }
  .asx-coordinate__status { top: 16px; left: 16px; gap: 8px; padding: 11px 15px; border: 1px solid #dce4ff; background: #f0f4ff; color: #4163ed; }
  .asx-coordinate__status svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; }
  .asx-coordinate__publish { right: 16px; bottom: 16px; padding: 12px 16px; background: #4163ed; color: #fff; }
  .asx-coordinate__cursor { position: absolute; z-index: 6; right: 20px; bottom: 50px; width: 23px; height: 27px; fill: #182033; stroke: #fff; stroke-width: 1.2; filter: drop-shadow(0 2px 3px rgba(17,24,39,.24)); }

  .asx-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .asx-journey-workflow {
    padding: clamp(110px,12vw,160px) 24px;
    background: linear-gradient(135deg,rgba(255,255,255,.2) 0%,rgba(246,248,255,.52) 52%,rgba(255,255,255,.18) 100%);
  }
  .asx-journey-workflow__inner { width: min(1218px,100%); margin-inline: auto; }
  .asx-journey-workflow__header { display: flex; max-width: 1000px; margin: 0 auto 64px; flex-direction: column; align-items: center; text-align: center; }
  .asx-journey-workflow__header h2 {
    max-width: 950px;
    margin: 0;
    font: 500 60px/66px var(--font-heading);
    letter-spacing: -2.1px;
    background: linear-gradient(98deg,var(--heading-dark) 43.06%,#8f8f8f 91.81%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .asx-journey-steps { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .asx-journey-steps > li { position: relative; display: block; padding: 0; border: 0; background: transparent; }
  .asx-journey-steps details {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--asx-journey-border);
    border-radius: 18px;
    background: linear-gradient(135deg,var(--asx-journey-tint) 0%,#fff 82%);
    box-shadow: 0 8px 24px rgba(31,41,55,.04);
    transition: border-radius .35s ease,background .35s ease,box-shadow .25s ease,transform .25s ease;
  }
  .asx-journey-steps > li:nth-child(1) { --asx-journey-tint: #fff8dc; --asx-journey-border: #f0dfa6; }
  .asx-journey-steps > li:nth-child(2) { --asx-journey-tint: #edf7ff; --asx-journey-border: #d4e7f7; }
  .asx-journey-steps > li:nth-child(3) { --asx-journey-tint: #f3efff; --asx-journey-border: #e2d8fa; }
  .asx-journey-steps > li:nth-child(4) { --asx-journey-tint: #eefbf4; --asx-journey-border: #d4efdf; }
  .asx-journey-steps > li:nth-child(5) { --asx-journey-tint: #fff0f7; --asx-journey-border: #f4d6e5; }
  .asx-journey-steps > li:nth-child(6) { --asx-journey-tint: #eef2ff; --asx-journey-border: #d7def8; }
  .asx-journey-steps summary {
    display: grid;
    grid-template-columns: 32px minmax(0,1fr);
    min-height: 82px;
    padding: 18px 82px 18px 20px;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    list-style: none;
    transition: background .25s ease;
  }
  .asx-journey-steps summary::-webkit-details-marker { display: none; }
  .asx-journey-steps summary:hover { background: rgba(255,255,255,.28); }
  .asx-journey-steps details:not([open]):hover { box-shadow: 0 12px 30px rgba(31,41,55,.08); transform: translateY(-2px); }
  .asx-journey-steps summary > span { color: #111; font: 500 15px/1.1 var(--font-heading); letter-spacing: -.05em; }
  .asx-journey-step__content { display: flex; flex-direction: column; }
  .asx-journey-steps details:not([open]) .asx-journey-step__content { display: grid; grid-template-columns: minmax(230px,.7fr) minmax(320px,1.3fr); align-items: center; gap: 36px; }
  .asx-journey-step__content h3 { margin: 0; color: #111; font: 500 22px/1.2 var(--font-body); letter-spacing: -.02em; }
  .asx-journey-step__content p { display: none; }
  .asx-journey-steps details:not([open]) .asx-journey-step__content p { display: -webkit-box; max-width: 460px; margin: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; color: #5f6673; font: 400 14.5px/1.5 var(--font-body); }
  .asx-journey-step__content ul { display: none; }
  .asx-journey-step__arrow {
    position: absolute;
    top: 24px;
    right: 28px;
    display: grid;
    width: 34px;
    height: 34px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(17,24,39,.2);
    border-radius: 50%;
    background: rgba(255,255,255,.78);
    color: #111827;
    cursor: pointer;
    transition: transform .25s ease,background .2s ease,border-color .2s ease;
  }
  .asx-journey-step__arrow:hover { border-color: rgba(17,24,39,.42); background: #fff; }
  .asx-journey-step__arrow:focus-visible { outline: 3px solid rgba(59,130,246,.28); outline-offset: 2px; }
  .asx-journey-step__arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .asx-journey-steps details[open] { display: flex; margin: 0; align-items: stretch; border-radius: 28px; background: linear-gradient(135deg,var(--asx-journey-tint) 0%,#fff 72%); }
  .asx-journey-steps details[open] summary { display: grid; flex: 0 0 55%; grid-template-columns: 44px minmax(0,1fr); min-height: 0; padding: 64px 40px 64px 28px; align-items: start; gap: 14px; background: transparent; }
  .asx-journey-steps details[open] summary:hover { padding-left: 28px; background: transparent; }
  .asx-journey-steps details[open] summary > span { color: #050505; font-size: 26px; line-height: 1; }
  .asx-journey-steps details[open] .asx-journey-step__content h3 { margin-bottom: 16px; color: #050505; font: 600 32px/1.2 var(--font-heading); }
  .asx-journey-steps details[open] .asx-journey-step__content p { display: block; max-width: 90%; margin: 0 0 32px; color: #333; font-size: 17px; line-height: 1.6; }
  .asx-journey-steps details[open] .asx-journey-step__content ul { display: flex; margin: 0; padding: 0; flex-direction: column; gap: 18px; list-style: none; }
  .asx-journey-steps details[open] .asx-journey-step__content li { display: flex; padding: 0; align-items: center; gap: 14px; border: 0; background: transparent; color: #111; font-size: 16px; font-weight: 500; }
  .asx-journey-steps details[open] .asx-journey-step__content li i { font-size: 16px; font-style: normal; }
  .asx-journey-steps details[open] .asx-journey-step__arrow { top: 28px; transform: rotate(180deg); }
  .asx-journey-step__visual { display: none; margin: 0; opacity: 0; }
  .asx-journey-steps details[open] .asx-journey-step__visual { display: flex; flex: 0 0 45%; max-height: none; padding: 40px 88px 40px 0; align-items: center; justify-content: flex-start; overflow: visible; opacity: 1; }
  .asx-journey-step__visual img { display: block; width: 100%; max-width: 400px; height: auto; object-fit: contain; border: 0; border-radius: 12px; background: transparent; box-shadow: 0 24px 60px rgba(0,0,0,.08); }

  .asx-event-day { padding: 100px 24px; background: transparent; }
