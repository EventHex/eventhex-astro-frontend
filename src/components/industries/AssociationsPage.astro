---
interface Props {
  faqs: [string, string][];
}

const { faqs } = Astro.props;

const operatingStages = [
  ["Configure", "Event + access"],
  ["Invite", "Audience segments"],
  ["Register", "Forms + tickets"],
  ["Programme", "Sessions + speakers"],
  ["Connect", "Members + partners"],
  ["Review", "Event + portfolio data"],
];

const attendeeJourney = [
  {
    title: "Discover",
    copy: "Publish the association event and programme.",
    bullets: ["Publish a branded event website", "Share the programme and speakers", "Keep updates in one place"],
  },
  {
    title: "Register",
    copy: "Collect the configured attendee details and ticket selection.",
    bullets: ["Configure attendee fields", "Apply ticket and access rules", "Build one connected attendee record"],
  },
  {
    title: "Prepare",
    copy: "Send planned campaigns and operational updates.",
    bullets: ["Schedule email campaigns", "Target the right event audience", "Track campaign delivery"],
  },
  {
    title: "Participate",
    copy: "Use agenda, app, networking, and engagement features as needed.",
    bullets: ["Open the agenda and schedule", "Use networking and event chat", "Join engagement features"],
  },
  {
    title: "Arrive",
    copy: "Validate QR access and keep attendance current.",
    bullets: ["Scan attendee QR codes", "Confirm access instantly", "Keep attendance status current"],
  },
  {
    title: "Continue",
    copy: "Review event data and prepare the next chapter or annual event.",
    bullets: ["Review registration performance", "Read event and portfolio signals", "Prepare the next event"],
  },
];

const boundaryScopes = [
  {
    id: "product",
    tab: "Product scope",
    title: "EventHex workflow",
    description: "Configure the supported event, audience, access, content, communication, engagement, and event-day mechanisms.",
    checklist: ["Registration and access", "Programme and communication", "Engagement and event-day operations"],
    visualLabel: "EventHex-owned workflow",
    visualTitle: "Association event workspace",
    visualRows: [["Registration", "Configured"], ["Programme", "Connected"], ["Event day", "Ready"]],
    image: "/images/industries/associations/portal/event-setup-web-960.webp",
    imageAlt: "EventHex event setup with ticket, venue, registration, and module controls",
  },
  {
    id: "review",
    tab: "Review scope",
    title: "Your specialist requirements",
    description: "Map legal, regulatory, accreditation, identity, accessibility, venue, payment-provider, and industry-specific obligations to the teams and systems responsible for them.",
    checklist: ["Name the requirement owner", "Confirm the responsible system", "Record the implementation decision"],
    visualLabel: "Specialist review required",
    visualTitle: "Requirement ownership review",
    visualRows: [["Legal and regulatory", "Assign owner"], ["Accreditation", "Validate"], ["External systems", "Confirm separately"]],
    image: "/images/industries/associations/portal/crm-integrations-web-960.webp",
    imageAlt: "EventHex CRM integrations screen for reviewing external systems and data connections",
  },
];

const eventFormats = [
  {
    id: "annual",
    index: "01",
    title: "Annual conferences",
    copy: "Connect programme, partners, registration, communications, and reporting.",
    modifier: "conference",
    checklist: ["Programme and speaker coordination", "Sponsor and exhibitor workflows", "Registration, communication, and reporting"],
    visualLabel: "Conference workflow",
    visualRows: [["Programme", "Connected"], ["Partners", "Ready"], ["Registration", "Open"]],
    image: "/images/industries/associations/portal/registration-analytics-web-960.webp",
    imageAlt: "EventHex conference analytics with registrations, sessions, speakers, and exhibitors",
  },
  {
    id: "chapter",
    index: "02",
    title: "Chapter events",
    copy: "Use a focused event setup and maintain portfolio visibility across regions.",
    modifier: "chapter",
    checklist: ["Focused event setup", "Regional team workflow", "Portfolio visibility"],
    visualLabel: "Chapter workspace",
    visualRows: [["Event setup", "Focused"], ["Region", "Assigned"], ["Portfolio", "Visible"]],
    image: "/images/industries/associations/portal/event-portfolio-web-960.webp",
    imageAlt: "EventHex event portfolio showing events across organizations, dates, and locations",
  },
  {
    id: "awards",
    index: "03",
    title: "Awards and galas",
    copy: "Configure attendee access, keep seating outside EventHex unless separately proven, and connect badges and communications.",
    modifier: "awards",
    checklist: ["Attendee access", "Badges and communications", "Separately reviewed seating needs"],
    visualLabel: "Guest access ready",
    visualRows: [["Guest access", "Configured"], ["Badges", "Connected"], ["Seating", "Review separately"]],
    image: "/images/industries/associations/portal/ticket-configuration-web-960.webp",
    imageAlt: "EventHex ticket configuration for managing guest registration and access",
  },
  {
    id: "trade-shows",
    index: "04",
    title: "Trade shows",
    copy: "Add exhibitors, sponsor visibility, attendee access, meetings, and lead capture.",
    modifier: "tradeshow",
    checklist: ["Exhibitor and sponsor visibility", "Attendee access and meetings", "Lead capture"],
    visualLabel: "Trade show operations",
    visualRows: [["Exhibitors", "Onboarded"], ["Meetings", "Available"], ["Lead capture", "Active"]],
    image: "/images/industries/associations/portal/exhibitor-packages-web-960.webp",
    imageAlt: "EventHex exhibitor package workspace with team access and response controls",
  },
];

const featureLinks = [
  ["Event Ticketing", "Configure access and pricing rules.", "/event-ticketing/"],
  ["Sponsor Management", "Present sponsor records.", "/sponsor-management/"],
  ["Exhibitor Management", "Run exhibitor and lead workflows.", "/exhibitor-management/"],
  ["Centralized Dashboard", "Review events across the portfolio.", "/centralized-dashboard/"],
];
---

<div class="asx-page">
  <section id="hero" class="asx-hero" aria-labelledby="asx-hero-title">
    <div class="asx-hero__shell">
      <div class="asx-hero__grid">
      <div class="asx-hero__content">
        <p class="asx-hero__badge animate-on-scroll" data-animation="fadeInDown">Event management software for associations</p>
        <h1 id="asx-hero-title" class="asx-hero__title animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <span>Connect annual,</span>
          <span>chapter, member, and</span>
          <span>partner events in one</span>
          <span>operating workflow</span>
        </h1>
        <p class="asx-hero__lead animate-on-scroll" data-animation="fadeInUp" data-delay="150">
          Run association conferences, chapter events, awards, and trade shows with configurable registration, ticket rules, sponsors, exhibitors, communications, networking, and portfolio visibility.
        </p>
        <ul class="asx-hero__points animate-on-scroll" data-animation="fadeInUp" data-delay="220">
          <li>Annual and chapter events</li>
          <li>Partner visibility</li>
          <li>Portfolio oversight</li>
        </ul>
        <div class="asx-actions animate-on-scroll" data-animation="fadeInUp" data-delay="290">
          <a class="asx-button asx-button--primary" href="/book-a-demo/">Book a Demo</a>
          <a class="asx-button asx-button--secondary" href="#operating-map">See the operating model</a>
        </div>
      </div>

      <div
        class="asx-hero__visual animate-on-scroll"
        data-animation="fadeInRight"
        data-delay="120"
        role="img"
        aria-label="EventHex association event workspace showing member audiences, event access, partners, and attendee experience"
      >
        <div class="asx-hero__visual-card" aria-hidden="true">
          <div class="asx-hero__visual-inner">
            <div class="asx-hero-phone">
              <div class="asx-hero-phone__bar"><span>9:41</span><i></i></div>
              <div class="asx-hero-phone__head"><b>‹</b><span><strong>Members</strong><small>Annual Leadership Congress</small></span><b>⌕</b></div>
              <div class="asx-hero-phone__members">
                <div><i class="asx-avatar asx-avatar--one"></i><span><strong>Amelia Chen</strong><small>Chapter delegate</small></span></div>
                <div><i class="asx-avatar asx-avatar--two"></i><span><strong>Omar Rahman</strong><small>Industry partner</small></span></div>
                <div><i class="asx-avatar asx-avatar--three"></i><span><strong>Sofia Patel</strong><small>Programme speaker</small></span></div>
              </div>
            </div>

            <div class="asx-hero-access">
              <div class="asx-hero-access__top"><span>Event access</span><b>•••</b></div>
              <div class="asx-hero-access__tools"><span>⌕</span><b>Filter</b><b>Sort</b></div>
              <div class="asx-hero-access__row"><i class="asx-avatar asx-avatar--one"></i><span><strong>Professional member</strong><small>Chapter access</small></span><b>Approved</b></div>
              <div class="asx-hero-access__row"><i class="asx-avatar asx-avatar--two"></i><span><strong>Partner delegate</strong><small>Exhibitor team</small></span><b>Active</b></div>
              <div class="asx-hero-access__row"><i class="asx-avatar asx-avatar--three"></i><span><strong>Industry guest</strong><small>Public ticket</small></span><b>Ready</b></div>
            </div>

            <div class="asx-hero-pulse">
              <small>PARTNER REGISTRATION</small>
              <strong>Audience status</strong>
              <div><span>Members</span><i><b style="width: 78%"></b></i><em>78%</em></div>
              <div><span>Partners</span><i><b style="width: 62%"></b></i><em>62%</em></div>
              <div><span>Guests</span><i><b style="width: 44%"></b></i><em>44%</em></div>
            </div>

            <div class="asx-hero-app">
              <div class="asx-hero-app__bar"><span>Annual Congress</span><b>•••</b></div>
              <small>MAIN STAGE · LIVE</small>
              <h3>Leadership keynote and community forum</h3>
              <p>10:30 AM · Grand Hall</p>
              <div class="asx-hero-app__actions"><span>Agenda</span><span>Connect</span><span>Updates</span></div>
              <nav><b>Info</b><b>Programme</b><b>People</b><b>More</b></nav>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <section id="operating-map" class="asx-rail" aria-label="One connected event path: see the operating sequence before choosing modules">
    <div class="asx-rail__inner">
      {operatingStages.map(([label, copy]) => (
        <span class="asx-rail__item"><b>{label}</b> {copy}</span>
      ))}
    </div>
  </section>

  <section id="event-model" class="asx-model-section" aria-labelledby="asx-model-title">
    <div class="asx-model-container">
      <header class="asx-model-header animate-on-scroll" data-animation="fadeInUp">
        <h2 id="asx-model-title">Start with the operating shape that fits the <span>event</span></h2>
      </header>

      <div class="asx-model-grid animate-on-scroll" data-animation="fadeInUp">
        <span class="asx-model-notch asx-model-notch--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg>
        </span>
        <span class="asx-model-notch asx-model-notch--bottom" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg>
        </span>

        <article class="asx-model-row">
          <div class="asx-model-cell asx-model-visual">
            <div class="asx-model-stage asx-model-stage--community">
              <img src="/images/industries/associations/portal/attendee-registrations-web-960.webp" alt="EventHex attendee registration workspace with ticket and registration records" width="960" height="516" loading="lazy" decoding="async" />
              <span class="asx-model-float asx-model-float--top"><b>People first</b><small>Registration + participation</small></span>
              <span class="asx-model-float asx-model-float--bottom"><i></i><b>Follow-up connected</b></span>
            </div>
          </div>
          <div class="asx-model-cell asx-model-content">
            <span class="asx-model-eyebrow">Primary model</span>
            <h3>Community-led event</h3>
            <p>Build registration, communications, participation, and follow-up around the people attending.</p>
          </div>
          <span class="asx-model-cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
            </svg>
          </span>
        </article>

        <article class="asx-model-row asx-model-row--reverse">
          <div class="asx-model-cell asx-model-content">
            <span class="asx-model-eyebrow">Alternate model</span>
            <h3>Programme-led event</h3>
            <p>Add submissions, speakers, sessions, or exhibitors when the format needs more structure.</p>
          </div>
          <div class="asx-model-cell asx-model-visual">
            <div class="asx-model-stage asx-model-stage--programme">
              <img src="/images/industries/associations/portal/programme-sessions-web-960.webp" alt="EventHex programme workspace with scheduled sessions, speakers, and engagement tools" width="960" height="516" loading="lazy" decoding="async" />
              <span class="asx-model-float asx-model-float--top"><b>Programme ready</b><small>Sessions + speakers</small></span>
              <span class="asx-model-float asx-model-float--bottom"><i></i><b>Partners included</b></span>
            </div>
          </div>
        </article>

        <p class="asx-model-decision">Start with one model, then add only the modules the event actually needs.</p>
      </div>
    </div>
  </section>

  <section id="core-workflow" class="asx-agenda-band" aria-labelledby="asx-core-title">
    <div class="asx-agenda-band__inner">
      <header class="asx-agenda-band__header">
        <h2 id="asx-core-title">Keep the attendee journey connected from invitation to follow-up</h2>
      </header>

      <div class="asx-agenda-grid">
        <article class="asx-agenda-card">
          <div class="asx-agenda-card__text">
            <h3>Flexible access</h3>
            <p>Use ticket types, custom fields, approvals, discounts, and coupons to represent the event’s access model.</p>
          </div>
          <div class="asx-agenda-visual">
            <div class="asx-agenda-product" aria-hidden="true">
              <div class="asx-agenda-product__bar"><span><i></i><i></i><i></i></span><small>Access model</small></div>
              <div class="asx-agenda-product__tabs"><span class="is-active">Tickets</span><span>Rules</span><span>Approvals</span></div>
              <div class="asx-agenda-access-list">
                <div><span><strong>Professional member</strong><small>Approved access</small></span><i class="is-on"></i></div>
                <div><span><strong>Chapter delegate</strong><small>Invite only</small></span><i class="is-on"></i></div>
                <div><span><strong>Industry guest</strong><small>Public access</small></span><i></i></div>
                <b><i></i></b>
              </div>
            </div>
          </div>
        </article>

        <article class="asx-agenda-card">
          <span class="asx-agenda-petal asx-agenda-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span>
          <span class="asx-agenda-petal asx-agenda-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span>
          <div class="asx-agenda-card__text">
            <h3>Chapter-ready event setup</h3>
            <p>Create separate event workspaces and reuse a proven event structure where appropriate.</p>
          </div>
          <div class="asx-agenda-visual">
            <div class="asx-agenda-product" aria-hidden="true">
              <div class="asx-agenda-product__bar"><span><i></i><i></i><i></i></span><small>Workspace structure</small></div>
              <div class="asx-agenda-product__tabs"><span class="is-active">Regions</span><span>Templates</span></div>
              <div class="asx-agenda-outline">
                <div><i></i><strong>Annual congress</strong><small>Global</small></div>
                <div class="is-child"><i></i><strong>North chapter</strong><small>Ready</small></div>
                <div class="is-child"><i></i><strong>South chapter</strong><small>Ready</small></div>
                <div class="is-break"><i></i><strong>Shared structure</strong><small>Synced</small></div>
              </div>
            </div>
          </div>
        </article>

        <article class="asx-agenda-card">
          <div class="asx-agenda-card__text">
            <h3>Sponsors and exhibitors</h3>
            <p>Present partner records, manage exhibitor teams, and capture leads through workflows.</p>
          </div>
          <div class="asx-agenda-visual">
            <div class="asx-agenda-product" aria-hidden="true">
              <div class="asx-agenda-product__bar"><span><i></i><i></i><i></i></span><small>Partner workspace</small></div>
              <div class="asx-agenda-product__tabs"><span class="is-active">Sponsors</span><span>Exhibitors</span><span>Leads</span></div>
              <div class="asx-agenda-stage-board">
                <span><i></i><i></i></span><span><i></i><i></i></span><span><i></i><i></i></span>
              </div>
            </div>
          </div>
        </article>

        <article class="asx-agenda-card">
          <div class="asx-agenda-card__text">
            <h3>Multi-event visibility</h3>
            <p>Use the centralized dashboard for attention, returning people, comparison, cloning, export, and scoped access.</p>
          </div>
          <div class="asx-agenda-visual">
            <div class="asx-agenda-product asx-agenda-product--wide" aria-hidden="true">
              <div class="asx-agenda-product__bar"><span><i></i><i></i><i></i></span><small>Event portfolio</small></div>
              <div class="asx-agenda-product__tabs"><span class="is-active">Events</span><span>Attention</span><span>Exports</span></div>
              <div class="asx-agenda-people">
                <div><i>AC</i><span><strong>Annual congress</strong><small>Returning audience</small></span><b>Active</b></div>
                <div><i>RF</i><span><strong>Regional forum</strong><small>Chapter workspace</small></span><b>Ready</b></div>
                <div><i>AE</i><span><strong>Awards evening</strong><small>Scoped access</small></span><b>Draft</b></div>
              </div>
            </div>
          </div>
        </article>

        <article class="asx-agenda-card">
          <span class="asx-agenda-petal asx-agenda-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span>
          <span class="asx-agenda-petal asx-agenda-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span>
          <div class="asx-agenda-card__text">
            <h3>One connected attendee path</h3>
            <p>Give each event a clear path through registration, content, arrival, participation, communication, and follow-up.</p>
          </div>
          <div class="asx-agenda-visual">
            <div class="asx-agenda-product asx-agenda-product--wide" aria-hidden="true">
              <div class="asx-agenda-product__bar"><span><i></i><i></i><i></i></span><small>Attendee journey</small></div>
              <div class="asx-agenda-product__tabs"><span class="is-active">Journey</span><span>Messages</span></div>
              <div class="asx-agenda-schedule-list">
                <div><time>01</time><span><strong>Invitation and registration</strong><small>Audience + access</small></span></div>
                <div class="is-accent"><time>02</time><span><strong>Arrival and participation</strong><small>Check-in + engagement</small></span></div>
                <div><time>03</time><span><strong>Communication and follow-up</strong><small>Connected context</small></span></div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="operating-view" class="asx-coordinate" aria-labelledby="asx-operations-title">
    <div class="asx-coordinate__inner">
      <div class="asx-coordinate__left">
        <h2 id="asx-operations-title" class="asx-coordinate__title animate-on-scroll" data-animation="fadeInUp">
          <span class="asx-coordinate__title-line">Coordinate the moments</span>
          <span class="asx-coordinate__title-line">that shape the experience</span>
        </h2>
        <p class="asx-coordinate__copy animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 100ms">
          Give each team a clear job while keeping the attendee and event record connected. Event owners, specialist teams, and leadership work from one shared operating view from setup through follow-up.
        </p>
        <div class="asx-coordinate__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 200ms">
          <a href="/book-a-demo/" class="asx-coordinate__btn asx-coordinate__btn--dark">Book a Demo &rarr;</a>
          <a href="#event-day" class="asx-coordinate__btn asx-coordinate__btn--light">Explore Event Day &rarr;</a>
        </div>
      </div>

      <div class="asx-coordinate__right animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 300ms">
        <div class="asx-coordinate__showcase">
          <img src="/images/industries/associations/portal/platform-analytics-web-960.webp" alt="EventHex platform analytics with organization, event, registration, and check-in totals" width="960" height="516" loading="lazy" decoding="async" />
          <span class="asx-coordinate__status">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
            Teams coordinated
          </span>
          <span class="asx-coordinate__publish">Review &amp; share</span>
          <svg class="asx-coordinate__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
        </div>
      </div>
    </div>
  </section>

  <section id="attendee-journey" class="asx-journey-workflow" aria-labelledby="asx-journey-title">
    <div class="asx-journey-workflow__inner">
      <header class="asx-journey-workflow__header">
        <p class="asx-eyebrow">Audience experience</p>
        <h2 id="asx-journey-title">Connect the moments attendees actually move through</h2>
      </header>
      <ol class="asx-journey-steps">
        {attendeeJourney.map((step, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div class="asx-journey-step__content">
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                  <ul>
                    {step.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}
                  </ul>
                </div>
                <button
                  type="button"
                  class="asx-journey-step__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </button>
              </summary>
              <div class="asx-journey-step__visual">
                {index === 0 && <img src="/images/industries/associations/attendee-journey/cfp-portal-published-agenda-web-960.webp" alt="Published EventHex event programme with sessions and booking options" width="960" height="720" loading="lazy" decoding="async" />}
                {index === 1 && <img src="/images/industries/associations/attendee-journey/checkout-attendee-details-web-960.webp" alt="EventHex registration checkout collecting attendee and ticket details" width="960" height="439" loading="lazy" decoding="async" />}
