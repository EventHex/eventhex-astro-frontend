  .asx-coordinate__right { width: 100%; max-width: 500px; justify-self: end; }
  .asx-coordinate__showcase { position: relative; isolation: isolate; width: 100%; height: clamp(320px,32vw,350px); overflow: hidden; border: 1px solid rgba(255,255,255,.9); border-radius: 24px; background: linear-gradient(155deg,#fff8dc 0%,#fffdf4 48%,#fff 100%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.55); }
