  .asx-faq__sidebar > p { margin: 0 0 28px; color: var(--body-light); font: 400 1rem/1.6 var(--font-body); }
  .asx-faq__cta { display: inline-flex; align-items: center; gap: 10px; padding: 14px 24px; border-radius: 999px; color: #fff; background: #171a21; font: 500 .9375rem/1 var(--font-body); text-decoration: none; transition: background .2s ease, transform .2s ease; }
  .asx-faq__cta:hover { background: #000; transform: translateY(-1px); }
  .asx-faq__list { display: flex; flex-direction: column; gap: 16px; counter-reset: associations-faq; }
  .asx-faq__item { counter-increment: associations-faq; padding: 4px 28px; overflow: hidden; border: 1px solid #e4e7ec; border-radius: 20px; background: #fff; transition: background .25s ease, border-color .25s ease; }
  .asx-faq__item[open] { border-color: #e4e7ec; background: #e4e7ec; }
