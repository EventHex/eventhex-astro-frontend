  .asx-coordinate__shot { position: absolute; overflow: hidden; aspect-ratio: 1117 / 837; border: 1px solid #e0e4ec; border-radius: 12px; background: #fff; box-shadow: 0 14px 30px rgba(17,24,39,.14); }
  .asx-coordinate__shot--overview { z-index: 1; top: 30px; left: 20px; width: 77%; }
  .asx-coordinate__shot--detail { z-index: 2; right: 18px; bottom: 24px; width: 70%; }
  .asx-coordinate__chrome { display: flex; height: 30px; padding: 0 10px; align-items: center; justify-content: space-between; border-bottom: 1px solid #edf0f5; background: #f8f9fc; }
  .asx-coordinate__chrome > span { display: flex; gap: 4px; }
