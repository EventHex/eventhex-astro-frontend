  .hcx-demo__status, .hcx-demo__review { position: absolute; z-index: 5; display: inline-flex; align-items: center; border-radius: 11px; box-shadow: 0 8px 22px rgba(42,66,158,.18); font: 700 13px/1 var(--font-body); }
