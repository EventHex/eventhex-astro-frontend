  @media (prefers-reduced-motion: reduce) { .hcx-programme-band { clip-path: none; will-change: auto; } .hcx-console, .hcx-hero__screenshot, .hcx-model-screen, .hcx-event-product-shot__cursor, .hcx-suites__panel, .hcx-programme-card__panel, .hcx-programme-card__handoff, .hcx-programme-card__onsite, .hcx-programme-card__visual::before, .hcx-programme-card__steps .is-active, .hcx-programme-card__fields .is-active, .hcx-programme-card__onsite .is-active, .hcx-programme-card__handoff .is-active { animation: none; } .hcx-btn, .hcx-demo__btn, .hcx-connected__card, .hcx-grid-card, .hcx-event-card, .hcx-event-day__cta, .hcx-faq__cta, .hcx-faq__item, .hcx-faq__icon, .hcx-faq__icon::after, .hcx-suites__tab { transition: none; } .hcx-btn:hover, .hcx-demo__btn:hover, .hcx-grid-card:hover, .hcx-event-card:hover, .hcx-event-day__cta:hover, .hcx-faq__cta:hover { transform: none; } }
</style>

<script>
  function initHealthcareSuites() {
    const suite = document.querySelector("[data-hcx-suites]");
    if (!suite || suite.dataset.ready === "true") return;

    const tabs = Array.from(suite.querySelectorAll("[data-hcx-suite-tab]"));
    const panels = Array.from(suite.querySelectorAll("[data-hcx-suite-panel]"));
    if (!tabs.length || !panels.length) return;

    const activateTab = (nextTab, moveFocus = false) => {
      const target = nextTab.dataset.hcxSuiteTab;
      tabs.forEach((tab) => {
        const active = tab === nextTab;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.hcxSuitePanel === target));
      if (moveFocus) nextTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        activateTab(tabs[nextIndex], true);
      });
    });

    suite.classList.add("is-ready");
    suite.dataset.ready = "true";
  }

  function initHealthcareFaq() {
    const items = Array.from(document.querySelectorAll("[data-hcx-faq]"));
    items.forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  }

  function initHealthcareProgrammeBand() {
    const band = document.querySelector<HTMLElement>(".hcx-programme-band");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let lastProgress = -1;
    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * .7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === lastProgress) return;
      lastProgress = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      lastProgress = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  function initHealthcarePage() {
    initHealthcareSuites();
    initHealthcareFaq();
    initHealthcareProgrammeBand();
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initHealthcarePage);
  else initHealthcarePage();
</script>
