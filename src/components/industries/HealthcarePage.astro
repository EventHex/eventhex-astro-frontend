  }
  .hcx-programme-card:nth-child(2n) { border-right: 0; }
  .hcx-programme-card:nth-child(n + 3) { border-bottom: 0; }
  .hcx-programme-card h3 { margin: 0 0 14px; color: #fff; font: 700 15px/1.25 var(--font-heading); letter-spacing: -.01em; }
  .hcx-programme-card > p { max-width: 42ch; margin: 0; color: rgba(255,255,255,.62); font: 400 .9375rem/1.38 var(--font-body); }
  .hcx-programme-card__petal { position: absolute; left: 0; z-index: 2; width: 28px; height: 28px; pointer-events: none; line-height: 0; }
  .hcx-programme-card__petal--top { top: 0; transform: translate(-50%, -50%); }
  .hcx-programme-card__petal--bottom { bottom: 0; transform: translate(-50%, 50%); }
  .hcx-programme-card__visual { position: relative; display: flex; align-items: flex-end; justify-content: center; flex: 1; margin-top: 28px; }
  .hcx-programme-card__visual::before { position: absolute; bottom: -10%; left: 50%; width: 80%; height: 80%; border-radius: 50%; background: radial-gradient(closest-side, rgba(92,138,255,.28), rgba(124,108,255,.15) 55%, transparent 100%); content: ""; filter: blur(30px); transform: translateX(-50%); }
  .hcx-programme-card__visual > * { position: relative; z-index: 1; }
  .hcx-programme-card__panel,
  .hcx-programme-card__handoff > span,
  .hcx-programme-card__onsite > span {
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.04);
    border-radius: 12px;
  }
  .hcx-programme-card__panel {
    width: min(100%, 360px);
    padding: 16px;
    border-color: transparent;
    border-radius: 16px;
    background: linear-gradient(#08080e, #08080e) padding-box, linear-gradient(135deg, #38bdf8 0%, #5c8aff 38%, #7c6cff 70%, #a45cff 100%) border-box;
    box-shadow: 0 18px 44px -22px rgba(92,138,255,.5);
