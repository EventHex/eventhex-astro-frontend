---
import FeatureCards from "../speaker-management/FeatureCards.astro";

interface Props {
  faqs: [string, string][];
}

const { faqs } = Astro.props;

const operatingStages = [
  ["Open", "Call for submissions"],
  ["Review", "Assignments + rubric"],
  ["Decide", "Accepted work"],
  ["Programme", "Sessions + speakers"],
  ["Register", "Delegate data"],
  ["Deliver", "Badges + check-in"],
];

const attendeeJourney = [
  ["Submit", "Give authors a structured route into the review workflow."],
  ["Review", "Assign reviewers and use the configured scoring rubric."],
  ["Publish", "Turn accepted work into programme content."],
  ["Register", "Collect delegate details through the selected event flow."],
  ["Arrive", "Validate event access and keep attendance current."],
  ["Follow up", "Use supported notifications, certificates, and analytics with their exact boundaries."],
];

const attendeeJourneyCards = attendeeJourney.map(([title, desc], index) => {
  const visuals = [
    { image: "/feature-images/call-for-papers/submission-portal-card.svg", width: 657, height: 479 },
    { image: "/feature-images/call-for-papers/peer-review-card.svg", width: 603, height: 574 },
    { image: "/feature-images/speaker-management/session-timeline-v2.svg", width: 701, height: 729 },
    { image: "/feature-images/event-registration/registration-to-checkin.png", width: 762, height: 696 },
    { image: "/feature-images/event-check-in/scan-engine-visual.svg", width: 578, height: 476 },
    { image: "/feature-images/speaker-management/instarecap-v2.svg", width: 603, height: 746 },
  ];

  return {
    title,
    desc,
    ...visuals[index],
    alt: `EventHex healthcare attendee journey: ${title}`,
    animated: true,
    ...(index === 0 ? { eyebrow: "One connected attendee journey" } : {}),
  };
});

const eventDaySteps = [
  ["Delegate arrival", "Scan event QR codes and distinguish valid, duplicate, or ineligible attempts."],
  ["Badge workflow", "Use the badge design and print workflow for the event."],
  ["Programme discovery", "Keep sessions, speakers, and attendee agenda access together."],
  ["Attendance review", "Use live attendance context and the analytics surfaces."],
];

const useCases = [
  {
    id: "medical-congresses",
    label: "Medical congresses",
    title: "Move abstracts into the medical programme",
    description: "Connect abstract review, accepted sessions, delegate registration, and event day.",
    checklist: ["Structured abstract review", "Accepted work moved into sessions", "Programme ready for delegates"],
    visualLabel: "Programme connected",
  },
  {
    id: "healthcare-conferences",
    label: "Healthcare conferences",
    title: "Coordinate every track in one workspace",
    description: "Build multi-track education and networking while accreditation remains in the responsible system.",
    checklist: ["Multi-track programme planning", "Speaker and room coordination", "Attendance context for follow-up"],
    visualLabel: "Attendance visible",
  },
  {
    id: "pharma-summits",
    label: "Pharma summits",
    title: "Configure access before delegates arrive",
    description: "Use configured access, programme, communications, and onsite operations.",
    checklist: ["Configured delegate access", "Targeted event communications", "Badge workflow prepared onsite"],
    visualLabel: "Badge workflow ready",
  },
  {
    id: "health-technology-expos",
    label: "Health-technology expos",
    title: "Keep expo arrival moving",
    description: "Add exhibitors, passes, leads, sessions, and attendee discovery.",
    checklist: ["Exhibitor and attendee passes", "Session and showcase discovery", "QR arrival validation"],
    visualLabel: "Delegate access verified",
  },
];

const connectedFeatures = [
  ["Call for Papers", "Run submissions and review.", "/call-for-papers/"],
  ["Session Management", "Build the scientific programme.", "/session-management/"],
  ["Event Registration", "Configure delegate intake.", "/event-registration/"],
  ["Event Check-In", "Operate delegate arrival.", "/event-check-in/"],
];

const connectedFeatureIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="14" y2="17"></line></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h3v3H8z"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3"></path></svg>`,
];
---

<main class="hcx-page">
  <section id="hero" class="hcx-hero">
    <div class="hcx-wrap hcx-hero__grid">
      <div class="hcx-hero__copy">
        <p class="hcx-eyebrow animate-on-scroll" data-animation="fadeInDown">Event management software for healthcare conferences</p>
        <h1 class="hcx-hero__title animate-on-scroll" data-animation="fadeInUp">Build a medical conference workflow around abstracts, programme, and delegates</h1>
        <p class="hcx-hero__lead animate-on-scroll" data-animation="fadeInUp">
          Move medical congresses, healthcare conferences, pharma summits, and health-technology expos from submissions to programme, registration, badges, arrival, and reporting—with each operational step connected to its EventHex feature.
        </p>
        <ul class="hcx-hero__points animate-on-scroll" data-animation="fadeInUp" aria-label="Healthcare event workflow priorities">
          <li>Submission and review</li>
          <li>Multi-track programme</li>
          <li>Delegate operations</li>
        </ul>
        <div class="hcx-actions animate-on-scroll" data-animation="fadeInUp">
          <a class="hcx-btn hcx-btn--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="hcx-btn hcx-btn--secondary" href="#operating-map">See the operating model</a>
        </div>
      </div>

      <div class="hcx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="hcx-hero__image">
          <div class="hcx-hero__image-inner">
            <img class="hcx-hero__screenshot" src="/images/industries/healthcare/app/healthcare-event-analytics-web-890.webp" alt="EventHex event analytics with registrations, sessions, speakers, exhibitors, and programme activity" width="890" height="600" loading="eager" decoding="async" fetchpriority="high" />
          </div>
        </div>
    </div>
  </section>

  <section id="operating-map" class="hcx-rail" aria-label="One connected event path: see the operating sequence before choosing modules">
    <div class="hcx-rail__inner">
      {operatingStages.map(([label, copy]) => <span class="hcx-rail__item"><b>{label}</b> {copy}</span>)}
    </div>
  </section>

  <section id="event-model" class="hcx-model" aria-labelledby="hcx-model-title">
    <header class="hcx-model__header animate-on-scroll" data-animation="fadeInUp">
      <h2 id="hcx-model-title">Start with the operating shape that fits the event</h2>
      <p>Choose the path that matches how your healthcare event needs to run.</p>
    </header>

    <div class="hcx-model__quad">
      <article class="hcx-model__cell hcx-model__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Programme-led event</h3>
        <p>Build submissions, speakers, sessions, registration, and the attendee agenda around one programme.</p>
      </article>

      <div class="hcx-model__cell hcx-model__cell--media animate-on-scroll" data-animation="fadeInRight">
        <div class="hcx-model-workspace">
          <img class="hcx-model-image" src="/images/industries/healthcare/app/programme-sessions-web-960.webp" alt="EventHex programme workspace with scheduled sessions, speakers, and engagement tools" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="hcx-model__cell hcx-model__cell--media animate-on-scroll" data-animation="fadeInLeft">
        <div class="hcx-model-workspace hcx-model-workspace--showcase">
          <img class="hcx-model-image" src="/images/industries/healthcare/app/registration-ticket-web-960.webp" alt="EventHex registration workspace showing an active delegate ticket and registration count" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>

      <article class="hcx-model__cell hcx-model__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Community or showcase event</h3>
        <p>Lead with registration, the event website, communication, arrival, and attendee participation.</p>
      </article>

      <span class="hcx-model__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)"></path></svg>
      </span>
    </div>
  </section>

  <section id="core-workflow" class="hcx-programme-band">
    <header class="hcx-programme-band__heading animate-on-scroll" data-animation="fadeInUp">
      <p class="hcx-programme-band__eyebrow">Programme operations</p>
      <h2>Move from content intake to a <span>programme people can attend</span></h2>
      <p class="hcx-programme-band__intro">Connect the content, people, and access decisions that usually end up in separate files.</p>
    </header>

    <div class="hcx-programme-grid">
      <article class="hcx-programme-card animate-on-scroll" data-animation="fadeInUp">
        <h3>Call for Papers</h3>
        <p>Collect submissions, assign reviewers, score with a rubric, and record decisions.</p>
        <div class="hcx-programme-card__visual" aria-hidden="true">
          <div class="hcx-programme-card__panel">
            <span class="hcx-programme-card__panel-label">Submission review</span>
            <div class="hcx-programme-card__steps">
              <span><i>01</i>Submission<b>Received</b></span>
              <span class="is-active"><i>02</i>Review<b>In progress</b></span>
              <span><i>03</i>Decision<b>Pending</b></span>
            </div>
          </div>
        </div>
      </article>

      <article class="hcx-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:60ms">
        <span class="hcx-programme-card__petal hcx-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Programme handoff</h3>
        <p>Push accepted work into the event programme and coordinate sessions and speakers.</p>
        <div class="hcx-programme-card__visual" aria-hidden="true">
          <div class="hcx-programme-card__handoff">
            <span><small>Accepted work</small><b>12 submissions</b></span>
            <i>→</i>
            <span class="is-active"><small>Programme</small><b>Build sessions</b></span>
          </div>
        </div>
      </article>

      <article class="hcx-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:120ms">
        <span class="hcx-programme-card__petal hcx-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Delegate registration</h3>
        <p>Collect configured attendee and ticket-specific fields with approvals where needed.</p>
        <div class="hcx-programme-card__visual" aria-hidden="true">
          <div class="hcx-programme-card__panel">
            <span class="hcx-programme-card__panel-label">Delegate details</span>
            <div class="hcx-programme-card__fields">
              <span>Name<i></i></span>
              <span>Ticket type<i></i></span>
              <span class="is-active">Approval required<b>On</b></span>
            </div>
          </div>
        </div>
      </article>

      <article class="hcx-programme-card animate-on-scroll" data-animation="fadeInUp" style="--delay:180ms">
        <span class="hcx-programme-card__petal hcx-programme-card__petal--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
        </span>
        <h3>Onsite operations</h3>
        <p>Connect badge design, QR arrival validation, live attendance, and event reporting.</p>
        <div class="hcx-programme-card__visual" aria-hidden="true">
          <div class="hcx-programme-card__onsite">
            <span><small>Badge</small><b>Ready to print</b></span>
            <span class="is-active"><small>QR check-in</small><b>Live</b></span>
            <span><small>Attendance</small><b>842 arrived</b></span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="operating-view" class="hcx-role-template" aria-labelledby="operating-view-title">
    <div class="hcx-role-template__shell">
      <header class="hcx-role-template__heading animate-on-scroll" data-animation="fadeInUp">
        <h2 id="operating-view-title">Give the event team one operating view</h2>
        <p class="hcx-role-template__sr-only">Team coordination. Give each team a clear job while keeping the attendee and event record connected.</p>
      </header>

      <div class="hcx-role-template__grid">
        <span class="hcx-role-template__notch hcx-role-template__notch--one" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>
        <span class="hcx-role-template__notch hcx-role-template__notch--two" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>
        <span class="hcx-role-template__notch hcx-role-template__notch--three" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>

        <article class="hcx-role-template__card hcx-role-template__card--first animate-on-scroll" data-animation="fadeInUp">
          <div class="hcx-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="hcx-role-template__content"><h3>Event owner</h3><p>Sets the event, audience, access, programme, and reporting decisions.</p></div>
        </article>

        <article class="hcx-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="100">
          <div class="hcx-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div class="hcx-role-template__content"><h3>Specialist teams</h3><p>Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.</p></div>
        </article>

        <article class="hcx-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="200">
          <div class="hcx-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          </div>
          <div class="hcx-role-template__content"><h3>Connected event record</h3><p>Keeps attendee actions and team decisions tied to the same event workspace.</p></div>
        </article>

        <article class="hcx-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="300">
          <div class="hcx-role-template__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 16 4-5 4 3 5-7"></path></svg>
          </div>
          <div class="hcx-role-template__content"><h3>Event leadership</h3><p>Reviews event and portfolio signals for the next operating decision.</p></div>
        </article>
      </div>
    </div>
  </section>

  <div id="attendee-journey" class="hcx-attendee-journey">
    <FeatureCards
      cards={attendeeJourneyCards}
      subtitle="Audience experience"
      titleLineOne="Connect the"
      titleLineTwo="attendees actually move through"
      highlight="moments"
    />
  </div>

  <section id="event-day" class="hcx-event-day">
    <div class="hcx-event-day__container">
      <div class="hcx-event-day__left">
        <div class="hcx-event-day__sticky animate-on-scroll" data-animation="fadeInUp">
          <div class="hcx-event-day__eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
            </svg>
            During the event
          </div>
          <h2>Keep event-day actions tied to the <span>same event record</span></h2>
          <p>Run arrival, badges, programme access, and attendance from one connected event workspace.</p>
          <a class="hcx-event-day__cta" href="/book-a-demo/">
            Book a Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="hcx-event-day__right">
        <article class="hcx-event-card animate-on-scroll" data-animation="fadeInUp">
          <div class="hcx-event-card__header">
            <div class="hcx-event-card__number">01</div>
            <div class="hcx-event-card__text"><h3>{eventDaySteps[0][0]}</h3><p>{eventDaySteps[0][1]}</p></div>
          </div>
          <div class="hcx-event-card__visual hcx-event-card__visual--1">
            <div class="hcx-event-product-shot">
              <img src="/images/industries/healthcare/delegate-qr-arrival.webp" alt="EventHex QR scanner and attendee check-in status for delegate arrival" width="512" height="422" loading="lazy" decoding="async" />
              <span class="hcx-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>QR validated</span>
              <span class="hcx-event-product-shot__action">Check in delegate</span>
              <svg class="hcx-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="hcx-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <div class="hcx-event-card__header">
            <div class="hcx-event-card__number">02</div>
            <div class="hcx-event-card__text"><h3>{eventDaySteps[1][0]}</h3><p>{eventDaySteps[1][1]}</p></div>
          </div>
          <div class="hcx-event-card__visual hcx-event-card__visual--2">
            <div class="hcx-event-product-shot">
              <img src="/images/industries/healthcare/badge-workflow.webp" alt="EventHex printable event badges with attendee details and QR codes" width="615" height="512" loading="lazy" decoding="async" />
              <span class="hcx-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Badge ready</span>
              <span class="hcx-event-product-shot__action">Print badge</span>
              <svg class="hcx-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="hcx-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <div class="hcx-event-card__header">
            <div class="hcx-event-card__number">03</div>
            <div class="hcx-event-card__text"><h3>{eventDaySteps[2][0]}</h3><p>{eventDaySteps[2][1]}</p></div>
          </div>
          <div class="hcx-event-card__visual hcx-event-card__visual--3">
            <div class="hcx-event-product-shot">
              <img src="/images/industries/healthcare/programme-discovery.webp" alt="EventHex attendee programme with sessions, times, and booking options" width="640" height="480" loading="lazy" decoding="async" />
              <span class="hcx-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Programme live</span>
              <span class="hcx-event-product-shot__action">View agenda</span>
              <svg class="hcx-event-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="hcx-event-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <div class="hcx-event-card__header">
            <div class="hcx-event-card__number">04</div>
            <div class="hcx-event-card__text"><h3>{eventDaySteps[3][0]}</h3><p>{eventDaySteps[3][1]}</p></div>
          </div>
          <div class="hcx-event-card__visual hcx-event-card__visual--4">
            <div class="hcx-event-product-shot">
              <img src="/images/industries/healthcare/attendance-review.webp" alt="EventHex attendance workspace with check-in and no-show metrics" width="640" height="353" loading="lazy" decoding="async" />
              <span class="hcx-event-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Attendance current</span>
              <span class="hcx-event-product-shot__action">Review attendance</span>
