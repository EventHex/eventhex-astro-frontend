  .hcx-programme-card__panel-label { display: block; margin-bottom: 10px; color: rgba(255,255,255,.55); font: 400 12px/1.3 var(--font-body); }
  .hcx-programme-card__steps, .hcx-programme-card__fields, .hcx-programme-card__onsite { display: grid; gap: 10px; }
  .hcx-programme-card__steps > span,
  .hcx-programme-card__fields > span,
  .hcx-programme-card__onsite > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    padding: 12px 13px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 9px;
    background: rgba(255,255,255,.05);
    color: rgba(255,255,255,.84);
    font: 500 12.5px/1.2 var(--font-body);
  }
  .hcx-programme-card__steps i { display: grid; flex: 0 0 25px; width: 25px; height: 25px; place-items: center; border-radius: 8px; background: rgba(255,255,255,.08); color: rgba(255,255,255,.5); font: 700 9px/1 var(--font-body); font-style: normal; }
  .hcx-programme-card__steps b, .hcx-programme-card__fields b { margin-left: auto; color: rgba(255,255,255,.48); font-size: 10.5px; font-weight: 600; }
  .hcx-programme-card__steps .is-active,
  .hcx-programme-card__fields .is-active,
  .hcx-programme-card__onsite .is-active,
  .hcx-programme-card__handoff .is-active {
    border-color: transparent;
    background: linear-gradient(#11111b, #11111b) padding-box, linear-gradient(135deg, #38bdf8, #7c6cff 58%, #a45cff) border-box;
    color: #fff;
  }
  .hcx-programme-card__fields > span { justify-content: flex-start; }
  .hcx-programme-card__fields i { width: 45%; height: 6px; margin-left: auto; border-radius: 999px; background: rgba(255,255,255,.14); }
  .hcx-programme-card__handoff { display: grid; width: min(100%, 380px); grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; }
  .hcx-programme-card__handoff > span { display: grid; gap: 8px; min-height: 104px; align-content: center; padding: 16px; }
  .hcx-programme-card__handoff > i { color: #9baaff; font: 400 24px/1 var(--font-body); font-style: normal; }
  .hcx-programme-card__handoff small, .hcx-programme-card__onsite small { color: rgba(255,255,255,.48); font: 500 10.5px/1.2 var(--font-body); }
  .hcx-programme-card__handoff b, .hcx-programme-card__onsite b { color: rgba(255,255,255,.88); font: 700 12px/1.25 var(--font-body); }
  .hcx-programme-card__onsite { width: min(100%, 370px); }
  .hcx-programme-card__onsite > span { min-height: 53px; }
  .hcx-programme-card__onsite > span small { margin-right: auto; }

  @keyframes hcxProgrammeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes hcxProgrammeBloom { 0%, 100% { opacity: .68; } 50% { opacity: 1; } }
  @keyframes hcxProgrammePulse { 0%, 100% { opacity: .88; } 50% { opacity: 1; } }
  .hcx-programme-card__panel,
  .hcx-programme-card__handoff,
  .hcx-programme-card__onsite { animation: hcxProgrammeFloat 7s ease-in-out infinite; }
  .hcx-programme-card:nth-child(2) .hcx-programme-card__handoff { animation-delay: -1.4s; }
  .hcx-programme-card:nth-child(3) .hcx-programme-card__panel { animation-delay: -2.8s; }
  .hcx-programme-card:nth-child(4) .hcx-programme-card__onsite { animation-delay: -4.2s; }
  .hcx-programme-card__visual::before { animation: hcxProgrammeBloom 6s ease-in-out infinite; }
  .hcx-programme-card__steps .is-active,
  .hcx-programme-card__fields .is-active,
  .hcx-programme-card__onsite .is-active,
  .hcx-programme-card__handoff .is-active { animation: hcxProgrammePulse 3.2s ease-in-out infinite; }

  .hcx-demo-section {
