  .hcx-model-status, .hcx-model-action { position: absolute; z-index: 5; display: inline-flex; align-items: center; border-radius: 10px; white-space: nowrap; font: 700 11px/1 var(--font-body); box-shadow: 0 10px 24px rgba(31,41,72,.16); }
