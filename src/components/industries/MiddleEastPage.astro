<script>
  document.querySelectorAll<HTMLDetailsElement>("[data-me-role]").forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".smp-workflow__arrow");
    summary?.addEventListener("click", (event) => { event.preventDefault(); item.open = !item.open; });
    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      if (!item.open) return;
      all.forEach((other) => { if (other !== item) other.open = false; });
    });
  });

  const suite = document.querySelector<HTMLElement>("#use-cases");
  if (suite) {
    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>("[data-me-suite-target]"));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>("[data-me-suite-panel]"));
    const activate = (tab: HTMLButtonElement, focus = false) => {
      const target = tab.dataset.meSuiteTarget;
      tabs.forEach((item) => { const active = item === tab; item.classList.toggle("smd-agent__tab--active", active); item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => panel.classList.toggle("smd-agent__panel--active", panel.dataset.meSuitePanel === target));
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        activate(tabs[(index + offset + tabs.length) % tabs.length], true);
      });
    });
  }

  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-me-faq]"));
  faqItems.forEach((item) => item.addEventListener("toggle", () => {
    if (!item.open) return;
    faqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));
</script>

