<script>
  document.querySelectorAll<HTMLDetailsElement>("#operating-view .smp-steps details").forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".smp-workflow__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} workflow step`);
      if (!item.open) return;
      all.forEach((other) => { if (other !== item) other.open = false; });
    });
  });

  const mediaFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-media-faq]"));
  mediaFaqItems.forEach((item) => item.addEventListener("toggle", () => {
    if (!item.open) return;
    mediaFaqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));

  const mediaSuite = document.querySelector<HTMLElement>(".media-use-suites");
  if (mediaSuite) {
    const tabs = Array.from(mediaSuite.querySelectorAll<HTMLButtonElement>("[data-media-suite-target]"));
    const panels = Array.from(mediaSuite.querySelectorAll<HTMLElement>("[data-media-suite-panel]"));
    let rotationId: number | undefined;

    const activateTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const targetId = tab.dataset.mediaSuiteTarget;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("smd-agent__tab--active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle("smd-agent__panel--active", panel.dataset.mediaSuitePanel === targetId));
      if (moveFocus) tab.focus();
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };
    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const index = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateTab(tabs[(index + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => { activateTab(tab); startRotation(); });
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        activateTab(tabs[(index + offset + tabs.length) % tabs.length], true);
        startRotation();
      });
    });
    mediaSuite.addEventListener("mouseenter", stopRotation);
    mediaSuite.addEventListener("mouseleave", startRotation);
    mediaSuite.addEventListener("focusin", stopRotation);
    mediaSuite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !mediaSuite.contains(event.relatedTarget)) startRotation();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? stopRotation() : startRotation());
    startRotation();
  }
</script>

