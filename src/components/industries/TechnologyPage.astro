<script>
  const faq = document.querySelectorAll(".tech-faq details");
  faq.forEach((item) => item.addEventListener("toggle", () => { if (item.open) faq.forEach((other) => { if (other !== item) other.removeAttribute("open"); }); }));
  const usecaseTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tech-usecase-tab]"));
  const usecasePanels = Array.from(document.querySelectorAll<HTMLElement>("[data-tech-usecase-panel]"));
  usecaseTabs.forEach((tab) => tab.addEventListener("click", () => {
    const selected = tab.dataset.techUsecaseTab;
    usecaseTabs.forEach((item) => { const active = item === tab; item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); });
    usecasePanels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.techUsecasePanel === selected));
  }));
  const dayFlowItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".tech-day-flow__rows details"));
  dayFlowItems.forEach((item) => item.addEventListener("toggle", () => { if (item.open) dayFlowItems.forEach((other) => { if (other !== item) other.removeAttribute("open"); }); }));

  const dayFlowScreens = [
    ["/feature-images/event-check-in/scan-engine-visual.png", "EventHex Scanner showing a QR code ready for arrival validation", 240, 197],
    ["/images/live-polling-qa/app/attendance-overview.png", "EventHex attendance workspace showing check-in status and attendance context", 1263, 697],
    ["/images/event-mobile-app/app/platform-notification-management.png", "EventHex platform notifications workspace for reaching the app audience", 900, 520],
    ["/images/webhooks/platform-analytics-web-960.webp", "EventHex Platform Analytics showing event creation, registration, and check-in trends", 960, 516],
  ];
  dayFlowItems.forEach((item, index) => {
    let visual = item.querySelector<HTMLElement>(".tech-day-flow__visual");
    if (!visual) {
      visual = document.createElement("div");
      visual.className = "tech-day-flow__visual";
      item.appendChild(visual);
    }
    const [src, alt, width, height] = dayFlowScreens[index];
    visual.setAttribute("role", "img");
    visual.setAttribute("aria-label", alt);
    visual.innerHTML = `<img src="${src}" alt="${alt}" width="${width}" height="${height}" loading="lazy" decoding="async" />`;
  });

  const boundaryScreens = [
    ["/images/industries/technology/event-dashboard-web-800.webp", "EventHex event dashboard showing the supported workflow across registrations, sessions, speakers, and attendees", 800, 691],
    ["/images/webhooks/platform-analytics-web-960.webp", "EventHex analytics workspace showing the review and reporting surface around event operations", 960, 516],
  ];
  document.querySelectorAll<HTMLElement>(".tech-choice article").forEach((article, index) => {
    const [src, alt, width, height] = boundaryScreens[index];
    const image = document.createElement("img");
    image.className = "tech-choice__screenshot";
    image.src = src;
    image.alt = alt;
    image.width = width;
    image.height = height;
    image.loading = "lazy";
    image.decoding = "async";
    const stage = document.createElement("div");
    stage.className = "tech-choice__stage";
    stage.append(image);
    article.prepend(stage);
  });

  const useCaseScreens = [
    ["/images/live-polling-qa/app/sessions-workspace.png", "EventHex sessions workspace for a developer conference programme", 1263, 697],
    ["/images/industries/technology/event-dashboard-web-800.webp", "EventHex event dashboard for a SaaS launch", 800, 691],
    ["/images/live-polling-qa/app/attendance-overview.png", "EventHex attendance workspace for a hackathon", 1263, 697],
    ["/images/event-mobile-app/app/platform-notification-management.png", "EventHex platform notifications for a technology meetup", 900, 520],
  ];
  document.querySelectorAll<HTMLElement>(".tech-usecase-art").forEach((art, index) => {
    const [src, alt, width, height] = useCaseScreens[index];
    const image = document.createElement("img");
    image.className = "tech-usecase-screenshot";
    image.src = src;
    image.alt = alt;
    image.width = width;
    image.height = height;
    image.loading = "lazy";
    image.decoding = "async";
    art.prepend(image);
  });

  const demoScreens = [
    ["/images/industries/technology/event-dashboard-web-800.webp", "EventHex Programme workspace showing the technology event setup", 800, 691],
    ["/images/webhooks/platform-analytics-web-960.webp", "EventHex Review workspace showing supported event operations", 960, 516],
  ];
  document.querySelectorAll<HTMLElement>(".tech-demo__window").forEach((window, index) => {
    const [src, alt, width, height] = demoScreens[index];
    const image = document.createElement("img");
    image.className = "tech-demo-screenshot";
    image.src = src;
    image.alt = alt;
    image.width = width;
    image.height = height;
    image.loading = "lazy";
    image.decoding = "async";
    window.prepend(image);
  });
</script>
