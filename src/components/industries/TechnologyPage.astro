---
interface Props { faqs: [string, string][] }
const { faqs } = Astro.props;
import FeatureCards from "../speaker-management/FeatureCards.astro";
const rail = [["Plan", "Event structure"], ["Publish", "Website + registration"], ["Programme", "Sessions + speakers"], ["Connect", "Smart recommendations"], ["Engage", "Polls + app"], ["Continue", "Recaps + follow-up"]];
const journey = [
  ["Event website", "Publish the event story and programme entry points."], ["Registration", "Collect attendee and ticket-specific information."], ["Personal agenda", "Help attendees discover the sessions relevant to them."], ["Networking", "Move from recommendations to participant-controlled connections."], ["Live engagement", "Use supported polls, questions, and app interactions."], ["Post-session value", "Make supported recap outputs available after the room clears."]
];
const useCases = [["Developer conferences", "Build a technical agenda and help attendees navigate tracks and connections."], ["SaaS launches", "Connect a branded event page, registration, live participation, and follow-up."], ["Hackathons", "Register cohorts and mentors, publish the programme, and keep event updates visible."], ["Tech meetups", "Use a lighter registration, agenda, networking, and notification setup."]];
const technologyJourneyCards = journey.map(([title, desc], i) => ({ title, desc, image: ["/feature-images/speaker-management/session-timeline-v2.svg", "/feature-images/speaker-management/speaker-dashboard-v2.svg", "/feature-images/speaker-management/live-engagement-v2.svg", "/feature-images/speaker-management/instarecap-v2.svg", "/feature-images/speaker-management/session-timeline-v2.svg", "/feature-images/speaker-management/live-engagement-v2.svg"][i], alt: `EventHex technology attendee journey: ${title}`, animated: true, width: 701, height: 729 }))
---

<div class="tech-page">
  <section class="tech-hero"><div class="tech-wrap tech-hero__grid"><div><span class="tech-eyebrow">Event management software for technology events</span><h1>Run the programme, people, and participation behind your next tech event</h1><p>Build multi-track conferences, developer summits, SaaS launches, hackathons, and meetups with connected registration, sessions, networking, live engagement, and recaps.</p><div class="tech-actions"><a class="tech-btn tech-btn--dark" href="/book-a-demo/">Book a Demo <span>→</span></a><a class="tech-btn tech-btn--outline" href="#operating-map">See the operating model</a></div><ul class="tech-checks"><li>Multi-track programmes</li><li>Attendee-led networking</li><li>Live participation</li></ul></div><div class="tech-console" role="img" aria-label="EventHex technology event operating view showing programme, audience and event-day states"><div class="tech-console__bar"><i></i><i></i><i></i><span>EventHex · Technology event</span></div><div class="tech-console__head">Connected event operating view <b>Live</b></div><div class="tech-console__rows"><span>PROGRAMME <strong>6 tracks · 42 sessions</strong></span><span>PEOPLE <strong>Registration and agenda</strong></span><span>PARTICIPATION <strong>Polls · Q&amp;A · app</strong></span><span>EVENT DAY <strong>QR check-in ready</strong></span></div></div></div></section>

  <section id="operating-map" class="tech-rail"><div class="tech-wrap"><p class="tech-section-note">See the operating sequence before choosing modules</p><div class="tech-rail__items">{rail.map(([label, text]) => <span><b>{label}</b> {text}</span>)}</div></div></section>

  <section id="event-model" class="tech-quad-section" aria-labelledby="tech-model-title">
    <header class="tech-quad-header animate-on-scroll" data-animation="fadeInUp">
      <h2 id="tech-model-title">Start with the operating shape that fits the event</h2>
      <p>Choose the path that matches how your technology event needs to run.</p>
    </header>

    <div class="tech-quad">
      <article class="tech-quad__cell tech-quad__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Programme-led event</h3>
        <p>Build submissions, speakers, sessions, registration, and the attendee agenda around one programme.</p>
      </article>

      <div class="tech-quad__cell tech-quad__cell--media animate-on-scroll" data-animation="fadeInRight">
        <div class="tech-model-workspace" role="img" aria-label="Programme-led technology event workspace showing submissions, speakers, and a published agenda">
          <div class="tech-model-screen">
            <div class="tech-model-screen__bar"><i></i><i></i><i></i><b>Programme workspace</b></div>
            <div class="tech-model-screen__body">
              <span><small>Submissions</small><strong>Review ready</strong></span>
              <span><small>Speakers</small><strong>12 confirmed</strong></span>
              <span><small>Agenda</small><strong>Publish programme</strong></span>
            </div>
          </div>
          <span class="tech-status">✓ Programme connected</span>
          <span class="tech-action">Publish agenda</span>
          <span class="tech-model-cursor" aria-hidden="true"></span>
        </div>
      </div>

      <div class="tech-quad__cell tech-quad__cell--media animate-on-scroll" data-animation="fadeInLeft">
        <div class="tech-model-workspace tech-model-workspace--showcase" role="img" aria-label="Community technology event workspace showing registration, attendee updates, and check-in">
          <div class="tech-model-screen tech-model-screen--showcase">
            <div class="tech-model-screen__bar"><i></i><i></i><i></i><b>Event workspace</b></div>
            <div class="tech-model-screen__body">
              <span><small>Registration</small><strong>Audience connected</strong></span>
              <span><small>Updates</small><strong>Ready to send</strong></span>
              <span><small>Arrival</small><strong>Check-in prepared</strong></span>
            </div>
          </div>
          <span class="tech-status">✓ Event connected</span>
          <span class="tech-action">Open event view</span>
          <span class="tech-model-cursor" aria-hidden="true"></span>
        </div>
      </div>

      <article class="tech-quad__cell tech-quad__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Community or showcase event</h3>
        <p>Lead with registration, the event website, communication, arrival, and attendee participation.</p>
      </article>

      <span class="tech-quad__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)"></path></svg>
      </span>
    </div>
  </section>

  <section id="programme-capabilities" class="tech-role-template" aria-labelledby="programme-capabilities-title">
    <div class="tech-role-template__shell">
      <header class="tech-role-template__heading animate-on-scroll" data-animation="fadeInUp">
        <h2 id="programme-capabilities-title">Move from content intake to a programme people can attend</h2>
        <p class="tech-role-template__sr-only">Connect the content, people, and access decisions that usually end up in separate files.</p>
      </header>
      <div class="tech-role-template__grid">
        <span class="tech-role-template__notch tech-role-template__notch--one" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <span class="tech-role-template__notch tech-role-template__notch--two" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <span class="tech-role-template__notch tech-role-template__notch--three" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <article class="tech-role-template__card tech-role-template__card--first animate-on-scroll" data-animation="fadeInUp">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h10"></path><circle cx="19" cy="19" r="2"></circle></svg></div>
          <div class="tech-role-template__content"><h3>Build the programme</h3><p>Arrange sessions, speakers, rooms, time, capacity, and attendee agenda discovery.</p></div>
        </article>
        <article class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="100">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
          <div class="tech-role-template__content"><h3>Connect the audience</h3><p>Surface relevant attendee recommendations while participants decide whom to connect with.</p></div>
        </article>
        <article class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="200">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V9"></path><path d="M10 19V5"></path><path d="M16 19v-7"></path><path d="M22 19V3"></path></svg></div>
          <div class="tech-role-template__content"><h3>Engage live</h3><p>Add multiple-choice polls, anonymous access where configured, spotlight, and feedback.</p></div>
        </article>
        <article class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="300">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 16 4-5 4 3 5-7"></path></svg></div>
          <div class="tech-role-template__content"><h3>Continue afterwards</h3><p>Connect eligible live transcription and recap outputs to the session experience.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="tech-section tech-operations-section"><div class="tech-wrap tech-spotlight"><div class="tech-spotlight__intro"><span class="tech-eyebrow">Technology operations panel</span><h2>Give the event team one operating view</h2><p>Give each team a clear job while keeping the attendee and event record connected.</p><a class="tech-operations__cta" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a></div><div class="tech-role-panel"><div><div class="tech-role-card__header"><span class="tech-role-card__number">01</span><div class="tech-role-card__text"><b>Event owner</b><span>Sets the event, audience, access, programme, and reporting decisions.</span><em>Accountable</em></div></div><img src="/images/industries/technology/event-dashboard-web-800.webp" alt="EventHex event owner operating dashboard" width="800" height="691" loading="lazy" decoding="async" /></div><div><div class="tech-role-card__header"><span class="tech-role-card__number">02</span><div class="tech-role-card__text"><b>Specialist teams</b><span>Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.</span><em>Operational</em></div></div><img src="/images/live-polling-qa/app/sessions-workspace.png" alt="EventHex specialist programme workspace" width="1263" height="697" loading="lazy" decoding="async" /></div><div><div class="tech-role-card__header"><span class="tech-role-card__number">03</span><div class="tech-role-card__text"><b>Event leadership</b><span>Reviews event and portfolio signals for the next operating decision.</span><em>Decision</em></div></div><img src="/images/webhooks/platform-analytics-web-960.webp" alt="EventHex event leadership analytics view" width="960" height="516" loading="lazy" decoding="async" /></div></div></div></section>

  <FeatureCards cards={technologyJourneyCards} subtitle="Technology attendee journey" titleLineOne="Connect the moments attendees" titleLineTwo="actually move through" highlight="" />

  <section class="tech-section tech-day-flow"><div class="tech-wrap"><header class="tech-day-flow__head"><span class="tech-eyebrow">Technology event-day workflow</span><h2>Keep event-day actions tied to the same event record</h2></header><ol class="tech-day-flow__rows"><li><details open><summary><span>01</span><div class="tech-day-flow__content"><h3>Scan arrivals</h3><p>Validate event QR codes with EventHex Scanner.</p><ul><li>Fast QR validation at the venue</li><li>Keep attendance current as people arrive</li><li>Give operations a live event-day view</li></ul></div><button type="button" class="tech-day-flow__arrow" aria-label="Collapse Scan arrivals" aria-expanded="true"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></button></summary><div class="tech-day-flow__visual" role="img" aria-label="EventHex Scanner showing QR code ready and attendance synced"><div class="tech-day-flow__visual-bar"><i></i><i></i><i></i><span>EventHex Scanner</span></div><strong>QR code ready</strong><span>Attendance synced</span><span>Event-day view live</span></div></details></li><li><details><summary><span>02</span><div class="tech-day-flow__content"><h3>Keep attendance current</h3><p>Use live attendance context while the event is running.</p></div><button type="button" class="tech-day-flow__arrow" aria-label="Expand Keep attendance current" aria-expanded="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></button></summary></details></li><li><details><summary><span>03</span><div class="tech-day-flow__content"><h3>Reach the app audience</h3><p>Publish operational push announcements to selected attendees.</p></div><button type="button" class="tech-day-flow__arrow" aria-label="Expand Reach the app audience" aria-expanded="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></button></summary></details></li><li><details><summary><span>04</span><div class="tech-day-flow__content"><h3>Review event signals</h3><p>Use the event analytics surfaces after the event.</p></div><button type="button" class="tech-day-flow__arrow" aria-label="Expand Review event signals" aria-expanded="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></button></summary></details></li></ol></div></section>

  <section class="tech-section tech-section--tint"><div class="tech-wrap"><header class="tech-header"><span class="tech-eyebrow">Technology configuration boundary</span><h2>Keep EventHex responsibility separate from specialist requirements</h2></header><div class="tech-choice"><article><span class="tech-kicker">Product scope</span><h3>EventHex workflow</h3><p>Configure the supported event, audience, access, content, communication, engagement, and event-day mechanisms.</p></article><article><span class="tech-kicker">Review scope</span><h3>Your specialist requirements</h3><p>Map legal, regulatory, accreditation, identity, accessibility, venue, payment-provider, and industry-specific obligations to the teams and systems responsible for them.</p></article></div><p class="tech-decision">Confirm every specialist obligation before implementation and record how it will be handled.</p></div></section>

  <section class="tech-section tech-usecase-suite"><div class="tech-wrap"><header class="tech-header"><span class="tech-eyebrow">Technology use-case grid</span><h2>Configure EventHex around the event you are running</h2></header><div class="tech-usecase-tabs" role="tablist" aria-label="Technology event formats">{useCases.map(([title], i) => <button type="button" role="tab" aria-selected={i === 0} class:list={{'is-active': i === 0}} data-tech-usecase-tab={i}>{title}</button>)}</div><div class="tech-usecase-panels">{useCases.map(([title, text], i) => <article class:list={{'is-active': i === 0}} data-tech-usecase-panel={i} role="tabpanel"><div class="tech-usecase-copy"><span class="tech-kicker">Use case 0{i + 1}</span><h3>{title}</h3><p>{text}</p><ul><li>Connect registration and the event website</li><li>Publish the programme and attendee agenda</li><li>Keep communication and participation in one workflow</li></ul></div><div class="tech-usecase-art" aria-hidden="true"><div class="tech-usecase-art__top"><i></i><i></i><i></i><b>EventHex · {title}</b></div><div class="tech-usecase-art__body"><span>PROGRAMME <strong>Ready to publish</strong></span><span>ATTENDEES <strong>Audience connected</strong></span><span>EVENT DAY <strong>Workflow prepared</strong></span></div></div></article>)}</div></div></section>

  <section id="connected-features" class="tech-role-template tech-role-template--links" aria-labelledby="connected-features-title">
    <div class="tech-role-template__shell">
      <header class="tech-role-template__heading animate-on-scroll" data-animation="fadeInUp">
        <h2 id="connected-features-title">Open the page that owns each mechanism</h2>
      </header>
      <div class="tech-role-template__grid">
        <span class="tech-role-template__notch tech-role-template__notch--one" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <span class="tech-role-template__notch tech-role-template__notch--two" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <span class="tech-role-template__notch tech-role-template__notch--three" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg></span>
        <a class="tech-role-template__card tech-role-template__card--first animate-on-scroll" data-animation="fadeInUp" href="/session-management/">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h10"></path><path d="m17 16 3 3 3-3"></path></svg></div>
          <div class="tech-role-template__content"><h3>Session Management</h3><p>Build the multi-track programme.</p></div>
        </a>
        <a class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="100" href="/enhance-networking-ai-smart-connect/">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></div>
          <div class="tech-role-template__content"><h3>AI Smart-Connect</h3><p>Support attendee-led discovery.</p></div>
        </a>
        <a class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="200" href="/live-polling-qa/">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path><path d="M8 9h8"></path><path d="M8 13h5"></path></svg></div>
          <div class="tech-role-template__content"><h3>Live Polling &amp; Q&amp;A</h3><p>Add live participation.</p></div>
        </a>
        <a class="tech-role-template__card animate-on-scroll" data-animation="fadeInUp" data-delay="300" href="/ai-session-recap/">
          <div class="tech-role-template__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M8 13h8"></path><path d="M8 17h6"></path></svg></div>
          <div class="tech-role-template__content"><h3>AI Session Recap</h3><p>Continue the value after a session.</p></div>
        </a>
      </div>
    </div>
  </section>

  <section class="tech-section tech-demo-section"><div class="tech-wrap tech-demo"><div class="tech-demo__content"><h2><span>Bring one real event</span><span>workflow to the demo</span></h2><p>Use the event format, audience groups, access rules, programme, communication channels, event-day plan, and required integrations to review the supported configuration.</p><div class="tech-demo__actions"><a class="tech-btn tech-btn--dark" href="/book-a-demo/">Book a Demo <span>→</span></a><a class="tech-btn tech-btn--outline" href="#operating-map">See the operating model <span>→</span></a></div></div><div class="tech-demo__visual" role="img" aria-label="Technology event workflow preview showing programme, audience, and event-day setup"><div class="tech-demo__window tech-demo__window--list"><div class="tech-demo__windowbar"><i></i><i></i><i></i><b>EventHex · Programme</b></div><div class="tech-demo__screen"><strong>Technology event setup</strong><span>Programme <b>6 tracks ready</b></span><span>Audience <b>Registration connected</b></span><span>Event day <b>Check-in prepared</b></span></div></div><div class="tech-demo__window tech-demo__window--builder"><div class="tech-demo__windowbar"><i></i><i></i><i></i><b>EventHex · Review</b></div><div class="tech-demo__screen"><strong>Workflow review</strong><span>Access rules <b>Confirmed</b></span><span>Integrations <b>Supported</b></span></div></div><div class="tech-demo__float">✓ Workflow ready</div><span class="tech-demo__publish">Review &amp; publish</span></div></div></section>

  <section class="tech-section tech-section--faq"><div class="tech-wrap tech-faq"><div class="tech-faq__sidebar"><span class="tech-faq__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Quick Answers</span><h2>Review the<br />questions that<br />shape the setup</h2><p>Short answers, with the important limits kept visible.</p><a class="tech-faq__cta" href="/contact-en/">Visit Help Center <span aria-hidden="true">→</span></a></div><div class="tech-faq__list">{faqs.map(([q, a], index) => <details class="tech-faq__item" open={index === 0}><summary><strong>{q}</strong><span class="tech-faq__icon" aria-hidden="true"></span></summary><p>{a}</p></details>)}</div></div></section>

</div>

<style>
