<script>
  document.querySelectorAll<HTMLDetailsElement>(".fin-journey-section details").forEach((item, _, all) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const useCasesSection = document.querySelector<HTMLElement>(".fin-use-cases");
  const useCasesHeader = useCasesSection?.querySelector<HTMLElement>(".fin-use-cases__header");
  const useCaseCards = useCasesSection?.querySelectorAll<HTMLElement>(".fin-use-case-card");
  const lastUseCaseCard = useCaseCards?.[useCaseCards.length - 1];

  if (useCasesHeader && lastUseCaseCard) {
    let useCasesFrame = 0;
    const syncUseCasesRelease = () => {
      useCasesFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(lastUseCaseCard).top) || 0;
      const releaseOffset = Math.min(0, lastUseCaseCard.getBoundingClientRect().top - stickyTop);
      useCasesHeader.style.setProperty("--fin-use-cases-release-y", `${releaseOffset}px`);
      useCasesHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueUseCasesRelease = () => {
      if (useCasesFrame) return;
      useCasesFrame = requestAnimationFrame(syncUseCasesRelease);
    };

    window.addEventListener("scroll", queueUseCasesRelease, { passive: true });
    window.addEventListener("resize", queueUseCasesRelease, { passive: true });
    syncUseCasesRelease();
  }

  const connectedSection = document.querySelector<HTMLElement>(".fin-connected-features");
  if (connectedSection) {
    const connectedTabs = Array.from(connectedSection.querySelectorAll<HTMLButtonElement>(".fin-connected__tab"));
    const connectedPanels = Array.from(connectedSection.querySelectorAll<HTMLElement>(".fin-connected__panel"));
    let connectedRotation: number | undefined;

    const activateConnectedTab = (tab: HTMLButtonElement) => {
      const targetId = tab.dataset.target;
      connectedTabs.forEach((item) => {
        item.classList.toggle("fin-connected__tab--active", item === tab);
        item.setAttribute("aria-selected", item === tab ? "true" : "false");
      });
      connectedPanels.forEach((panel) => panel.classList.toggle("fin-connected__panel--active", panel.dataset.panel === targetId));
    };
    const stopConnectedRotation = () => {
      if (connectedRotation === undefined) return;
      window.clearInterval(connectedRotation);
      connectedRotation = undefined;
    };
    const startConnectedRotation = () => {
      stopConnectedRotation();
      if (connectedTabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      connectedRotation = window.setInterval(() => {
        const currentIndex = connectedTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateConnectedTab(connectedTabs[(currentIndex + 1) % connectedTabs.length]);
      }, 4200);
    };

    connectedTabs.forEach((tab) => tab.addEventListener("click", () => {
      activateConnectedTab(tab);
      startConnectedRotation();
    }));
    connectedSection.addEventListener("mouseenter", stopConnectedRotation);
    connectedSection.addEventListener("mouseleave", startConnectedRotation);
    connectedSection.addEventListener("focusin", stopConnectedRotation);
    connectedSection.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !connectedSection.contains(event.relatedTarget)) startConnectedRotation();
    });
    document.addEventListener("visibilitychange", () => { document.hidden ? stopConnectedRotation() : startConnectedRotation(); });
    startConnectedRotation();
  }

  const financeFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-fin-faq-item]"));
  financeFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      financeFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

