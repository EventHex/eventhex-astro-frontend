---
const coreWorkflow = [
  ["Configured registration", "Use ticket-specific fields, approvals, access rules, discounts, and coupons for the event."],
  ["Paid access", "Keep supported gateway handoff, payment state, refunds, invoice, and tax detail attached to the event order."],
  ["Programme and connections", "Publish sessions and support participant-controlled networking and meetings."],
  ["Event day", "Connect badge output, QR arrival validation, live attendance, and event analytics."],
];
const attendeeJourneySteps = [
  { title: "Invitation", desc: "Send the right audience to the right registration or checkout path.", bullets: ["Configured audience routes", "Registration or checkout handoff", "Branded event entry"], image: "/feature-images/event-registration/private-invitations.png", alt: "EventHex private invitation settings for an event audience" },
  { title: "Qualification", desc: "Use configured fields and approval status while identity verification stays in the appropriate external process.", bullets: ["Ticket-specific fields", "Approval-based access", "Clear attendee status"], image: "/feature-images/event-registration/approval-setting.png", alt: "EventHex approval settings for attendee registration" },
  { title: "Payment", desc: "Use the event's supported provider and currency setup.", bullets: ["Supported payment handoff", "Order and ticket context", "Provider-dependent settlement"], image: "/feature-images/event-registration/checkout-order-details.png", alt: "EventHex checkout order details for a paid event" },
  { title: "Programme", desc: "Give attendees session, speaker, and agenda context.", bullets: ["Sessions and speakers", "Agenda context", "Programme updates"], image: "/feature-images/speaker-management/ai-agenda-list.jpg", alt: "EventHex agenda and sessions workspace for an attendee programme" },
  { title: "Networking", desc: "Support participant-controlled connections and meeting handoff.", bullets: ["Participant-led discovery", "Connection requests", "Meeting workflow handoff"], image: "/feature-images/ai/ai-smart-networking.webp", alt: "EventHex AI Smart-Connect networking experience" },
  { title: "Arrival", desc: "Validate the issued event ticket at check-in.", bullets: ["Ticket validation", "QR arrival workflow", "Attendance context"], image: "/feature-images/event-check-in/attendee-list.png", alt: "EventHex attendee check-in list for event-day arrival" },
];
const faqs = [
  ["Can finance events use approval-based registration?", "Yes. Configure the appropriate registration journey and approval flow for the event."],
  ["Which payment gateways are supported?", "Current paths include Stripe, Razorpay, and Tap Payments. Account eligibility, methods, currencies, fees, and settlement are provider-dependent."],
  ["Does EventHex guarantee financial-services compliance?", "No. EventHex does not provide regulatory, security, data-residency, or compliance certification through this event workflow."],
  ["Can attendees network and arrange meetings?", "Use AI Smart-Connect for participant-controlled discovery and the appointments workflow for meeting operations."],
  ["Can we track ROI?", "EventHex provides event analytics, but financial ROI and attribution are not included."],
];
const useCaseCards = [
  {
    title: "Banking summits",
    desc: "Coordinate invitations, programme, access, communication, and arrival from one event record.",
    image: "/feature-images/event-registration/private-invitations.png",
    alt: "EventHex private invitation settings for a banking summit audience",
    width: 762,
    height: 696,
  },
  {
    title: "Fintech conferences",
    desc: "Connect tickets, supported payment, sessions, sponsors, exhibitors, and networking around the agenda.",
    image: "/feature-images/speaker-management/session-scheduling-dashboard.png",
    alt: "EventHex session scheduling dashboard for a fintech conference programme",
    width: 762,
    height: 696,
  },
  {
    title: "Investor events",
    desc: "Use configured approval and access flows while investor identity checks stay in the appropriate external process.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard for investor event reporting",
    width: 1262,
    height: 697,
  },
  {
    title: "Insurance forums",
    desc: "Run registration, programme, attendee communication, and event-day operations as one connected workflow.",
    image: "/feature-images/event-check-in/attendee-list.png",
    alt: "EventHex attendee list and check-in status for an insurance forum",
    width: 177,
    height: 179,
  },
];
const connectedFeatureTabs = [
  {
    id: "registration",
    label: "Event Registration",
    title: "Shape the intake before the event starts",
    description: "Configure attendee intake, ticket rules, approval, and access context without losing the event record.",
    checklist: ["Registration and ticket setup", "Approval and access rules", "Branded event entry"],
    image: "/feature-images/event-registration/private-invitations.png",
    alt: "EventHex private invitation settings for finance event registration",
    visualLabel: "Registration configured",
    width: 762,
    height: 696,
  },
  {
    id: "payments",
    label: "Event Payment Processing",
    title: "Keep payment state with the event order",
    description: "Use supported gateway handoff while payment state, refunds, invoice, and tax detail stay attached to the order.",
    checklist: ["Supported gateway handoff", "Order and ticket context", "Provider-dependent settlement"],
    image: "/feature-images/event-payment-processing/revenue-reporting.svg",
    alt: "EventHex payment revenue reporting for a finance event",
    visualLabel: "Supported payments",
    width: 720,
    height: 480,
  },
  {
    id: "networking",
    label: "AI Smart-Connect",
    title: "Let attendees find the right connection",
    description: "Support participant-controlled discovery and meeting handoff when the event needs networking around the programme.",
    checklist: ["Participant-led discovery", "Connection requests", "Meeting workflow handoff"],
    image: "/feature-images/ai/ai-smart-networking.webp",
    alt: "EventHex AI Smart-Connect networking workspace for event attendees",
    visualLabel: "Networking connected",
    width: 1200,
    height: 800,
  },
  {
    id: "analytics",
    label: "Event Analytics",
    title: "Review the signals after every milestone",
    description: "Bring registration, attendance, and event-level reporting into one view so the next decision has context.",
    checklist: ["Registration and attendance signals", "Event-level reporting", "Decision-ready context"],
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard with registration and attendance trends",
    visualLabel: "Event data ready",
    width: 1262,
    height: 697,
  },
];
---

<div class="fin-page">
  <section class="fin-hero"><div class="fin-wrap fin-hero__grid"><div class="fin-hero__copy"><p class="fin-hero__badge">Event management software for financial-services events</p><h1>Control invitation, programme, access, and event day for finance audiences</h1><p class="fin-hero__desc">Run banking summits, fintech conferences, investor events, and insurance forums with configurable registration, ticketing, payment, programme, networking, badges, check-in, and analytics.</p><div class="fin-actions"><a class="fin-button fin-button--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a><a class="fin-button fin-button--quiet" href="#event-model">See the event model</a></div><div class="fin-hero__signals" aria-label="Event workflow capabilities"><span>Configured access</span><span>Programme and networking</span></div></div><div class="fin-hero__visual"><div class="fin-hero__visual-card"><div class="fin-hero__visual-inner"><img src="/images/razorpay-platform-analytics-organizations.png" alt="EventHex Platform Analytics organizations and top events overview" width="1262" height="697" loading="eager" decoding="async" /></div></div></div></div></section>
  <section class="fin-trust-strip" aria-label="Event workflow capabilities"><div class="fin-trust-strip__inner"><span><b>Configured</b> registration</span><span><b>Supported</b> payments</span><span><b>Connected</b> programme</span><span><b>Event-day</b> workflow</span></div></section>

  <section id="event-model" class="fin-model-section"><div class="fin-wrap"><div class="fin-model-header"><p class="fin-eyebrow">Choose the right event model</p><h2>Start with the operating shape that fits the event</h2></div><div class="fin-model-grid">
    <article class="fin-model-cell fin-model-cell--copy"><div class="fin-model-copy"><h3>Programme-led event</h3><p>Build submissions, speakers, sessions, registration, and the attendee agenda around one programme.</p><span class="fin-model-label">Programme + sessions</span></div></article>
    <div class="fin-model-cell fin-model-cell--media"><div class="fin-model-visual"><img class="fin-model-screen fin-model-screen--primary" src="/feature-images/speaker-management/ai-agenda-list.jpg" alt="EventHex agenda and sessions view for a programme-led finance event" width="1117" height="837" loading="lazy" decoding="async" /><img class="fin-model-screen fin-model-screen--secondary" src="/feature-images/speaker-management/session-scheduling-dashboard.png" alt="EventHex session scheduling view with tracks and timings" width="762" height="696" loading="lazy" decoding="async" /><img class="fin-model-screen fin-model-screen--detail" src="/feature-images/speaker-management/speaker-setup-dashboard.png" alt="EventHex speaker setup view for programme operations" width="762" height="696" loading="lazy" decoding="async" /><span class="fin-model-status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Programme connected</span><span class="fin-model-action">Open programme</span></div></div>
    <div class="fin-model-cell fin-model-cell--media"><div class="fin-model-visual fin-model-visual--violet"><img class="fin-model-screen fin-model-screen--primary" src="/images/platform-analytics-dashboard.jpg" alt="EventHex Platform Analytics overview for a community or showcase event" width="1262" height="697" loading="lazy" decoding="async" /><img class="fin-model-screen fin-model-screen--secondary" src="/feature-images/event-registration/registration-to-checkin.png" alt="EventHex registration to check-in workflow" width="762" height="696" loading="lazy" decoding="async" /><img class="fin-model-screen fin-model-screen--detail" src="/feature-images/event-registration/private-invitations.png" alt="EventHex private invitation settings for a showcase event" width="762" height="696" loading="lazy" decoding="async" /><span class="fin-model-status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Audience connected</span><span class="fin-model-action">Review event flow</span></div></div>
    <article class="fin-model-cell fin-model-cell--copy"><div class="fin-model-copy"><h3>Community or showcase event</h3><p>Lead with registration, the event website, communication, arrival, and attendee participation.</p><span class="fin-model-label">Audience + arrival</span></div></article>
    <span class="fin-model-cross" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)" transform="scale(1,-1)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)" transform="rotate(90)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)" transform="rotate(-90)"/></svg></span>
  </div><p class="fin-note">Start with one model, then add only the modules the event actually needs.</p></div></section>

  <section id="core-workflow" class="fin-setup-section"><div class="fin-setup-inner"><header class="fin-setup-header"><p class="fin-eyebrow">Programme operations</p><h2>Move from content intake to a programme people can attend</h2><p>Connect the content, people, and access decisions that usually end up in separate files.</p></header><div class="fin-setup-grid"><span class="fin-setup-notch" style="left:25%" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)"></path></svg></span><span class="fin-setup-notch" style="left:50%" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)"></path></svg></span><span class="fin-setup-notch" style="left:75%" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--fin-border)"></path></svg></span>{coreWorkflow.map(([title, body], i) => <article class:list={["fin-setup-card", { "fin-setup-card--first": i === 0 }]}><div class="fin-setup-card__icon" aria-hidden="true">{i === 0 && <svg viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>}{i === 1 && <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path><path d="M6 15h4"></path></svg>}{i === 2 && <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>}{i === 3 && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path><path d="m8 15 2 2 5-5"></path></svg>}</div><div class="fin-setup-card__content"><h3>{title}</h3><p>{body}</p></div></article>)}</div></div></section>

  <section id="attendee-journey" class="fin-journey-section"><div class="fin-wrap fin-journey-inner"><header class="fin-journey-header"><p class="fin-eyebrow">Audience experience</p><h2>Connect the moments attendees actually move through</h2></header><ol class="fin-journey-steps">{attendeeJourneySteps.map((step, index) => <li><details open={index === 0}><summary><span class="fin-journey-number">0{index + 1}</span><div class="fin-journey-copy"><h3>{step.title}</h3><p>{step.desc}</p><ul>{step.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul></div><span class="fin-journey-arrow" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"></path></svg></span></summary><div class="fin-journey-visual"><img src={step.image} alt={step.alt} width={index === 0 ? 762 : index === 1 ? 760 : index === 2 ? 360 : index === 3 ? 1117 : index === 4 ? 1200 : 177} height={index === 0 ? 696 : index === 1 ? 430 : index === 2 ? 440 : index === 3 ? 837 : index === 4 ? 800 : 179} loading="lazy" decoding="async" /></div></details></li>)}</ol></div></section>

  <section id="event-day" class="fin-event-day-section"><div class="fin-event-day-container"><div class="fin-event-day-left"><div class="fin-event-day-sticky"><div class="fin-event-day-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>During the event</div><h2>Keep event-day actions <span>tied to the same event record</span></h2><p>Keep invitee status, badge handoff, QR arrival, and attendance context connected to the event record.</p><a class="fin-event-day-cta" href="/book-a-demo/">Book a Demo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="fin-event-day-right">
    <article class="fin-event-day-card"><div class="fin-event-day-card__header"><div class="fin-event-day-card__number">01</div><div class="fin-event-day-card__text"><h3>Invitee status</h3><p>Use the EventHex registration and ticket state configured for the event.</p></div></div><div class="fin-event-day-card__visual"><div class="fin-event-day-product"><img src="/feature-images/event-check-in/attendee-list.png" alt="EventHex attendee list with registration and ticket status" width="177" height="179" loading="lazy" decoding="async" /><span class="fin-event-day-status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Registration synced</span><span class="fin-event-day-action">Review invitee</span><svg class="fin-event-day-cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div></article>
    <article class="fin-event-day-card"><div class="fin-event-day-card__header"><div class="fin-event-day-card__number">02</div><div class="fin-event-day-card__text"><h3>Badge handoff</h3><p>Use the badge design and print workflow for the arrival desk.</p></div></div><div class="fin-event-day-card__visual"><div class="fin-event-day-product"><img src="/feature-images/event-check-in/badge-card.png" alt="EventHex attendee badge ready for event-day handoff" width="177" height="179" loading="lazy" decoding="async" /><span class="fin-event-day-status fin-event-day-status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Badge ready</span><span class="fin-event-day-action">Print badge</span><svg class="fin-event-day-cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div></article>
    <article class="fin-event-day-card"><div class="fin-event-day-card__header"><div class="fin-event-day-card__number">03</div><div class="fin-event-day-card__text"><h3>QR arrival</h3><p>Surface valid, duplicate, or ineligible scan feedback at check-in.</p></div></div><div class="fin-event-day-card__visual"><div class="fin-event-day-product"><img src="/feature-images/event-check-in/scan-engine-figma.png" alt="EventHex QR check-in scan validation screen" width="881" height="560" loading="lazy" decoding="async" /><span class="fin-event-day-status fin-event-day-status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Scan validated</span><span class="fin-event-day-action">Check attendee</span><svg class="fin-event-day-cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div></article>
    <article class="fin-event-day-card"><div class="fin-event-day-card__header"><div class="fin-event-day-card__number">04</div><div class="fin-event-day-card__text"><h3>Attendance context</h3><p>Review live attendance and event-level reporting from the same event record.</p></div></div><div class="fin-event-day-card__visual"><div class="fin-event-day-product"><img src="/images/platform-analytics-dashboard.jpg" alt="EventHex platform analytics dashboard with event attendance trends" width="1262" height="704" loading="lazy" decoding="async" /><span class="fin-event-day-status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Event data ready</span><span class="fin-event-day-action">View event data</span><svg class="fin-event-day-cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div></article>
  </div></div></section>


  <section id="use-cases" class="fin-use-cases">
    <div class="fin-use-cases__section">
      <header class="fin-use-cases__header">
        <div class="fin-use-cases__eyebrow"><span class="fin-use-cases__eyebrow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-1.2-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg></span><span>Where it fits</span></div>
        <h2 class="fin-use-cases__title"><span>Configure EventHex around the</span><span>event <span class="fin-use-cases__highlight">you are running</span></span></h2>
      </header>
      <div class="fin-use-cases__cards">
        {useCaseCards.map((card, i) => (
          <article class="fin-use-case-card" style={`--card-index:${i};`}>
            <div class="fin-use-case-card__content">
              <span class="fin-use-case-card__number">0{i + 1}</span>
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
              <a href="/book-a-demo/" class="fin-use-case-card__btn">Explore setup <span aria-hidden="true">→</span></a>
            </div>
            <div class:list={["fin-use-case-card__image", i === 2 && "fin-use-case-card__image--analytics"]}>
              <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
        <div class="fin-use-cases__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="connected-features" class="fin-connected-features" aria-labelledby="fin-connected-title">
    <div class="fin-connected-features__inner">
      <header class="fin-connected__header">
        <p class="fin-connected__eyebrow">Go deeper</p>
        <h2 id="fin-connected-title" class="fin-connected__title"><span>Open the page that owns</span><span>each <span>mechanism</span></span></h2>
        <p class="fin-connected__subtitle">Use the connected feature pages to understand the mechanism behind each finance event workflow.</p>
      </header>
      <div class="fin-connected__tabs" role="tablist" aria-label="Connected feature pages">
        {connectedFeatureTabs.map((tab, index) => (
          <button class:list={["fin-connected__tab", index === 0 && "fin-connected__tab--active"]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`fin-connected-panel-${tab.id}`} id={`fin-connected-tab-${tab.id}`} data-target={tab.id}>{tab.label}</button>
        ))}
      </div>
      <div class="fin-connected__panels">
        {connectedFeatureTabs.map((tab, index) => (
          <article class:list={["fin-connected__panel", index === 0 && "fin-connected__panel--active"]} id={`fin-connected-panel-${tab.id}`} role="tabpanel" aria-labelledby={`fin-connected-tab-${tab.id}`} data-panel={tab.id}>
            <div class="fin-connected__copy">
              <h3>{tab.title}</h3>
              <p>{tab.description}</p>
              <div class="fin-connected__replaces"><span>REPLACES</span><span class="fin-connected__replaces-icons" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg><svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></span></div>
              <ul>{tab.checklist.map((item) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>{item}</li>)}</ul>
              <a href={tab.id === "registration" ? "/event-registration/" : tab.id === "payments" ? "/event-payment-processing/" : tab.id === "networking" ? "/enhance-networking-ai-smart-connect/" : "/event-analytics/"} class="fin-connected__link">Open feature page <span aria-hidden="true">→</span></a>
            </div>
            <div class="fin-connected__visual">
              <div class="fin-connected__showcase"><img src={tab.image} alt={tab.alt} width={tab.width} height={tab.height} loading="lazy" decoding="async" /><span class:list={["fin-connected__visual-label", `fin-connected__visual-label--${tab.id}`]}>{tab.visualLabel}</span></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="demo-fit" class="fin-demo-fit" aria-labelledby="fin-demo-title">
    <div class="fin-demo-fit__inner">
      <header class="fin-demo-fit__header"><p class="fin-demo-fit__eyebrow">Plan the configuration</p><h2 id="fin-demo-title">Bring one real event workflow to the demo</h2></header>
      <div class="fin-demo-fit__grid">
        <span class="fin-demo-fit__notch" style="left:25%" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg></span>
