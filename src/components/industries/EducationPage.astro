  .edu-band__heading h2{max-width:920px;margin:0 auto;background:linear-gradient(100deg,#fff 0%,#f2f0ff 26%,#c9c2ff 52%,#a79aff 74%,#7d8dff 100%);background-clip:text;-webkit-background-clip:text;color:transparent;-webkit-text-fill-color:transparent;-webkit-text-stroke:0;font:500 clamp(38px,4.4vw,56px)/1.08 var(--font-heading);letter-spacing:-.04em}
