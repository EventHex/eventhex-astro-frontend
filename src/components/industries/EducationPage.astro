<style>
  /* Replicate the event-registration Access Control section for education operations. */
  .edu-operations {
    padding: 100px 24px;
    background: #fff;
  }

  .edu-operations__container {
    display: flex;
    max-width: 1200px;
    align-items: stretch;
    gap: 80px;
    margin: 0 auto;
  }

  .edu-operations__left {
    flex: 0 0 40%;
  }

  .edu-operations__sticky {
    position: sticky;
    top: 120px;
  }

  .edu-operations__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    padding: 6px 12px;
    border-radius: 99px;
    background: #f4f5f7;
    color: var(--heading-dark);
    font: 600 13px var(--font-body);
  }

  .edu-operations h2 {
    margin: 0 0 24px;
    color: var(--heading-dark);
    font: 500 clamp(36px, 4vw, 48px)/1.2 var(--font-heading);
    letter-spacing: -.02em;
  }

  .edu-operations h2 span {
    background: linear-gradient(98deg, #4f4f4f, #a5a5a5);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .edu-operations__left p {
    max-width: 470px;
    margin: 0;
    color: var(--subheading-gray);
    font: 400 18px/1.6 var(--font-body);
  }

  .edu-operations__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    font: 500 .9375rem var(--font-body);
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }

  .edu-operations__cta:hover {
    background: #000;
    transform: translateY(-1px);
  }

  .edu-operations__right {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 32px;
  }

  .edu-operations-card {
    position: sticky;
    top: 80px;
    padding: 32px;
    border-radius: 24px;
    background: #f4f5f7;
    transition: transform .3s ease;
  }

  .edu-operations-card:nth-child(2) { top: 100px; }
  .edu-operations-card:nth-child(3) { top: 120px; }
  .edu-operations-card:hover { transform: translateY(-4px); }

  .edu-operations-card__header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .edu-operations-card__number {
    display: flex;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font: 700 16px var(--font-heading);
  }

  .edu-operations-card__text h3 {
    margin: 0 0 8px;
    color: var(--heading-dark);
    font: 700 20px var(--font-heading);
  }

  .edu-operations-card__text p {
    margin: 0;
    color: var(--subheading-gray);
    font: 400 16px/1.6 var(--font-body);
  }

  .edu-operations-card__visual {
    position: relative;
    display: flex;
    min-height: 320px;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .86);
    border-radius: 20px;
  }

  .edu-operations-card:nth-child(1) .edu-operations-card__visual {
    background: linear-gradient(180deg, #fff9dc 0%, #fffdf1 48%, #fff 100%);
  }

  .edu-operations-card:nth-child(2) .edu-operations-card__visual {
    background: linear-gradient(180deg, #e9f9f0 0%, #f5fcf8 48%, #fff 100%);
  }

  .edu-operations-card:nth-child(3) .edu-operations-card__visual {
    background: linear-gradient(180deg, #eef1ff 0%, #f8f9ff 48%, #fff 100%);
  }

  .edu-operations-card__visual img {
    display: block;
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    border: 1px solid #e2e4e9;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 14px 30px rgba(17, 24, 39, .14);
  }

  .edu-operations-card__status {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 9px 13px;
    border: 1px solid #cfead9;
    border-radius: 10px;
    background: #effbf4;
    box-shadow: 0 10px 24px rgba(31, 41, 72, .16);
    color: #18864b;
    font: 700 11px var(--font-body);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  @media (max-width: 992px) {
    .edu-operations__container {
      flex-direction: column;
      gap: 40px;
    }

    .edu-operations__left {
      width: 100%;
      flex: none;
    }

    .edu-operations__sticky,
    .edu-operations-card,
    .edu-operations-card:nth-child(2),
    .edu-operations-card:nth-child(3) {
      position: static;
    }

    .edu-operations-card {
      padding: 32px 24px;
    }
  }

  @media (max-width: 640px) {
    .edu-operations { padding: 72px 16px; }
    .edu-operations h2 { font-size: 36px; }
    .edu-operations-card { padding: 24px 18px; border-radius: 20px; }
    .edu-operations-card__header { flex-direction: column; }
    .edu-operations-card__visual { min-height: 220px; padding: 16px; }
    .edu-operations-card__visual img { max-height: 230px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .edu-operations__cta,
    .edu-operations-card { transition: none; }
  }
</style>

<style>
  .edu-owner-links {
    padding: clamp(90px,10vw,140px) 24px;
    background: linear-gradient(180deg,#f8faff 0%,#fff 78%);
  }
  .edu-owner-links__shell { width: min(1200px,100%); margin: 0 auto; }
  .edu-owner-links__header { max-width: 1040px; margin: 0 auto 68px; text-align: center; }
  .edu-owner-links__header h2 {
    margin: 0;
    background: linear-gradient(to right,#111827 0%,#111827 60%,#9ca3af 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font: 500 clamp(36px,5vw,56px)/1.08 var(--font-heading);
    letter-spacing: -.03em;
  }
  .edu-owner-links__sr-copy {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
