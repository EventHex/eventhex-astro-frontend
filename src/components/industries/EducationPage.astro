<script>
  document.querySelectorAll('.edu-faq details').forEach((item) => item.addEventListener('toggle', () => { if (item.open) document.querySelectorAll('.edu-faq details').forEach((other) => { if (other !== item) other.open = false; }); }));
  document.querySelectorAll<HTMLDetailsElement>('.edu-workflow-reference details').forEach((item, _, all) => {
    const summary = item.querySelector('summary');
    const trigger = item.querySelector<HTMLButtonElement>('.edu-workflow-reference__arrow');

    summary?.addEventListener('click', (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener('toggle', () => {
      trigger?.setAttribute('aria-expanded', String(item.open));
      trigger?.setAttribute('aria-label', `${item.open ? 'Collapse' : 'Expand'} workflow step`);
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
  const eduBandObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); eduBandObserver.unobserve(entry.target); } }), { threshold: 0.1 });
  document.querySelectorAll('.edu-band .animate-on-scroll').forEach((el) => eduBandObserver.observe(el));

  const initEducationBandBleed = () => {
    const band = document.querySelector<HTMLElement>('.edu-band');
    if (!band || band.dataset.bleedReady === 'true' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    band.dataset.bleedReady = 'true';

    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let ticking = false;
    let lastProgress = -1;

    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };
    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * .7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === lastProgress) return;
      lastProgress = rounded;
      band.style.setProperty('--band-p', String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      lastProgress = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('load', onResize);
  };

  initEducationBandBleed();
</script>

