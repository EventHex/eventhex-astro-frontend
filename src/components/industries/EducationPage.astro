<script>
  document.addEventListener("DOMContentLoaded", () => {
    const suite = document.querySelector<HTMLElement>(".edu-use-cases");
    if (!suite) return;

    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".edu-use-cases__tab"));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>(".edu-use-cases__panel"));
    let rotationId: number | undefined;

    const activateTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const target = tab.dataset.useCase;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        const active = panel.dataset.useCasePanel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });

      if (moveFocus) tab.focus();
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateTab(tabs[(current + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activateTab(tab);
        startRotation();
      });
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        activateTab(tabs[next], true);
      });
    });

    suite.addEventListener("mouseenter", stopRotation);
    suite.addEventListener("mouseleave", startRotation);
    suite.addEventListener("focusin", stopRotation);
    suite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) startRotation();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? stopRotation() : startRotation());
    startRotation();
  });
</script>
