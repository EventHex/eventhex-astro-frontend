---
import FeatureCards from "../speaker-management/FeatureCards.astro";

interface Props { faqs: [string, string][] }
const { faqs } = Astro.props;
const rail = [["Invite", "Registration"], ["Collect", "Submissions + data"], ["Review", "Rubrics + decisions"], ["Build", "Programme + speakers"], ["Engage", "Polls + gamification"], ["Deliver", "Badges + check-in"]];
const journey = [["Prospect or delegate entry", "Send each audience to the right event page and registration flow."], ["Configured questions", "Collect only the attendee or ticket-specific information the event needs."], ["Programme discovery", "Publish sessions and speakers for attendees."], ["Live participation", "Use supported polls, questions, challenges, and updates."], ["Campus arrival", "Scan event access and keep attendance visible."], ["Completion", "Use certificates only for the event workflow—not as proof of academic credit."]];
const educationUseCases = [
  {
    id: "academic-conferences",
    label: "Academic conferences",
    title: "Connect the academic programme",
    description: "Connect submissions, review, programme, registration, and event day.",
    checklist: ["Collect abstracts and assign reviewers", "Move accepted work into the programme", "Keep registration and event day connected"],
    image: "/images/industries/education/cfp-portal-submissions.webp",
    srcset: "/images/industries/education/cfp-portal-submissions-web-640.webp 640w, /images/industries/education/cfp-portal-submissions-web-800.webp 800w",
    imageAlt: "EventHex submissions and reviewer workspace for an academic conference",
    width: 800,
    height: 599,
    visualLabel: "Submissions workspace",
  },
  {
    id: "university-open-days",
    label: "University open days",
    title: "Guide prospects from interest to arrival",
    description: "Publish activities, register prospects, communicate updates, and scan arrival.",
    checklist: ["Publish activities and audience routes", "Collect configured prospect details", "Send updates and scan campus arrival"],
    image: "/images/industries/education/single-registration.webp",
    srcset: "/images/industries/education/single-registration-web-640.webp 640w, /images/industries/education/single-registration-web-800.webp 800w",
    imageAlt: "EventHex registration form and event setup for a university open day",
    width: 800,
    height: 392,
    visualLabel: "Prospect registration",
  },
  {
    id: "graduation-events",
    label: "Graduation-related events",
    title: "Coordinate invitations and event access",
    description: "Manage invitations and event access; keep seating and academic records in the system responsible for it.",
    checklist: ["Manage invitation-only registration", "Keep event access and attendance visible", "Leave seating and records in their owner systems"],
    image: "/images/industries/education/attendance-overview.webp",
    srcset: "/images/industries/education/attendance-overview-web-640.webp 640w, /images/industries/education/attendance-overview-web-800.webp 800w",
    imageAlt: "EventHex attendance dashboard for graduation event access",
    width: 800,
    height: 441,
    visualLabel: "Attendance visible",
  },
  {
    id: "student-hackathons",
    label: "Student hackathons",
    title: "Run team-based participation in one place",
    description: "Register teams or participants using configured fields and publish sessions, mentors, and updates.",
    checklist: ["Register teams or individual participants", "Publish sessions and mentor details", "Support challenges, points, and updates"],
    image: "/images/industries/education/gamification-features-live.webp",
    srcset: "/images/industries/education/gamification-features-live-web-640.webp 640w, /images/industries/education/gamification-features-live-web-800.webp 800w",
    imageAlt: "EventHex challenge and leaderboard settings for a student hackathon",
    width: 800,
    height: 442,
    visualLabel: "Challenges enabled",
  },
];
const links = [["Call for Papers", "Run academic submissions and review.", "/call-for-papers/"], ["Session Management", "Build the programme.", "/session-management/"], ["Live Polling & Q&A", "Support live participation.", "/live-polling-qa/"], ["Badge & Certificate Designer", "Design event outputs.", "/badge-certificate-designer/"]];
const workflow = [
  {
    title: "Multiple entrances",
    desc: "Use the scanner workflow at the event's arrival points.",
    bullets: ["Fast QR validation", "Live attendance visibility", "Multiple entrance support"],
    image: "/feature-images/event-check-in/scan-engine-figma.png",
    alt: "EventHex Scanner ready to validate an attendee QR code",
    width: 512,
    height: 422,
  },
  {
    title: "Session discovery",
    desc: "Keep the current programme and attendee agenda accessible.",
    bullets: ["Current programme in one place", "Attendee agenda access", "Session updates stay connected"],
    image: "/feature-images/session-management/detail-panel.png",
    alt: "EventHex session details panel with programme information",
    width: 424,
    height: 524,
  },
  {
    title: "Audience updates",
    desc: "Send operational app announcements to selected attendees.",
    bullets: ["Target selected attendees", "Publish operational updates", "Keep the app audience informed"],
    image: "/images/event-notifications/app/lifecycle-agenda-changes.webp",
    alt: "EventHex notification editor for an attendee agenda update",
    width: 936,
    height: 414,
  },
  {
    title: "Badge and certificate design",
    desc: "Use the designer and output workflow for the event's approved output.",
    bullets: ["Design event badges", "Prepare approved certificates", "Keep outputs tied to event records"],
    image: "/images/badge-certificate-designer/app/badge-preview.png",
    alt: "EventHex badge designer showing an attendee badge preview",
    width: 1124,
    height: 838,
  },
];
const educationJourneyVisuals = [
  { image: "/feature-images/event-registration/single-registration.webp", alt: "EventHex registration page for an education event attendee", width: 1600, height: 783 },
  { image: "/images/badge-certificate-designer/app/registration-form-builder.png", alt: "EventHex registration form builder with configurable attendee questions", width: 1124, height: 838 },
  { image: "/images/industries/education/sessions-workspace-web-800.webp", alt: "EventHex education programme workspace with sessions for attendee discovery", width: 800, height: 441 },
  { image: "/images/live-polling-qa/app/attendee-mobile-app.png", alt: "EventHex attendee mobile app for live event participation", width: 1263, height: 697 },
  { image: "/images/live-polling-qa/app/attendance-overview.png", alt: "EventHex attendance overview for campus event arrivals", width: 1263, height: 697 },
  { image: "/images/badge-certificate-designer/app/certificate-library.png", alt: "EventHex certificate library for education event completion outputs", width: 1360, height: 838 },
];
const educationJourneyCards = journey.map(([title, desc], index) => ({
  ...(index === 0 ? { eyebrow: "One connected attendee journey" } : {}),
  title,
  desc,
  ...educationJourneyVisuals[index],
  animated: true,
}));
---

<div class="edu-page">
  <section class="edu-hero">
    <div class="edu-hero__shell">
      <div class="edu-hero__grid">
        <div class="edu-hero__content">
          <span class="edu-eyebrow">Event management software for higher education</span>
          <h1>
            <span class="edu-hero__title-line">Coordinate academic</span>
            <span class="edu-hero__title-line">programmes, campus</span>
            <span class="edu-hero__title-line">audiences, and event day</span>
            <span class="edu-hero__title-line">from one workflow</span>
          </h1>
          <p>Run academic conferences, university open days, graduation-related events, and student hackathons with submissions, sessions, registration, communication, engagement, badges, and check-in.</p>
          <ul class="edu-checks">
            <li>Academic submissions</li>
            <li>Campus audiences</li>
            <li>Connected event day</li>
          </ul>
          <div class="edu-actions">
            <a class="edu-btn edu-btn--dark" href="/book-a-demo/">Book a Demo</a>
            <a class="edu-btn edu-btn--outline" href="#operating-map">See the operating model</a>
          </div>
        </div>
        <div class="edu-hero__visual">
          <div class="edu-hero__visual-card">
            <div class="edu-hero__visual-inner">
              <img class="edu-hero__screenshot" src="/images/industries/education/app/education-operating-dashboard-web-890.webp" alt="EventHex education event dashboard with registrations, sessions, speakers, exhibitors, and activity trends" width="890" height="600" loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="operating-map" class="edu-rail"><div class="edu-wrap"><p class="edu-note">See the operating sequence before choosing modules</p><div class="edu-rail__items">{rail.map(([label, text]) => <span><b>{label}</b> {text}</span>)}</div></div></section>

  <section id="event-model" class="edu-model" aria-labelledby="edu-model-title">
    <div class="edu-model__header">
      <span class="edu-eyebrow">Education event model choice</span>
      <h2 id="edu-model-title">Start with the operating shape that fits the event</h2>
      <p>Choose the path that matches how your team needs to run this event.</p>
    </div>
    <div class="edu-model__quad">
      <article class="edu-model__cell edu-model__copy">
        <span class="edu-kicker">Primary model</span>
        <h3>Programme-led event</h3>
        <p>Build submissions, speakers, sessions, registration, and the attendee agenda around one programme.</p>
      </article>
      <div class="edu-model__cell edu-model__media">
        <div class="edu-model__shot edu-model__shot--programme">
          <img src="/images/industries/education/app/programme-timeline-web-960.webp" alt="EventHex programme timeline showing education sessions arranged across the event day" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="edu-model__cell edu-model__media">
        <div class="edu-model__shot edu-model__shot--showcase">
          <img src="/images/industries/education/app/community-website-mode-web-960.webp" alt="EventHex website-mode settings for publishing a community or showcase event experience" width="960" height="498" loading="lazy" decoding="async" />
        </div>
      </div>
      <article class="edu-model__cell edu-model__copy">
        <span class="edu-kicker">Alternate model</span>
        <h3>Community or showcase event</h3>
        <p>Lead with registration, the event website, communication, arrival, and attendee participation.</p>
      </article>
      <span class="edu-model__cross" aria-hidden="true">✦</span>
    </div>
    <p class="edu-decision">Start with one model, then add only the modules the event actually needs.</p>
  </section>

  <section class="edu-section edu-band" aria-labelledby="edu-core-workflow-title">
    <header class="edu-band__heading">
      <span class="edu-band__sr-copy">Education core workflow</span>
      <h2 id="edu-core-workflow-title">Move from content intake <span>to a programme people can attend</span></h2>
      <p class="edu-band__sr-copy">Connect the content, people, and access decisions that usually end up in separate files.</p>
    </header>
    <div class="edu-band__grid-section">
      <div class="edu-cap">
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="0">
          <h3>Academic submissions</h3>
          <p>Configure calls, reviewer assignments, rubrics, decisions, and programme handoff.</p>
          <div class="edu-band__visual"><b>Submission workspace</b><i>Abstract intake <strong>Open</strong></i><i>Reviewer rubric <strong>Ready</strong></i><i>Programme handoff <strong>Connected</strong></i></div>
        </article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="edu-cap__petal edu-cap__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
          <span class="edu-cap__petal edu-cap__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
          <h3>Programme and speakers</h3>
          <p>Build sessions and speaker participation for multi-track academic events.</p>
          <div class="edu-band__visual edu-band__chips"><i class="is-active">Speaker pass</i><i class="is-active">Session ready</i><i>All tracks</i></div>
        </article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <h3>Campus registration</h3>
          <p>Choose a focused single-ticket form or multi-ticket checkout and collect configured fields.</p>
          <div class="edu-band__visual"><b>Registration form</b><i>Attendee details <strong>Configured</strong></i><i>Access rules <strong>Confirmed</strong></i></div>
        </article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <h3>Participation</h3>
          <p>Add supported live polling, app-action gamification, notifications, badges, and check-in.</p>
          <div class="edu-band__visual"><b>Event-day view</b><i>Polls + updates <strong>Live</strong></i><i>Badges + check-in <strong>Ready</strong></i></div>
        </article>
      </div>
    </div>
  </section>

  <section class="edu-operations" aria-labelledby="edu-operations-title">
    <div class="edu-operations__container">
      <div class="edu-operations__left">
        <div class="edu-operations__sticky">
          <div class="edu-operations__eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Education operations panel
          </div>
          <h2 id="edu-operations-title">Give the event team one <span>operating view</span></h2>
          <p>Give each team a clear job while keeping the attendee and event record connected.</p>
          <a class="edu-operations__cta" href="/book-a-demo/">
            Book a Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="edu-operations__right">
        <article class="edu-operations-card">
          <div class="edu-operations-card__header">
            <div class="edu-operations-card__number">01</div>
            <div class="edu-operations-card__text">
              <h3>Event owner</h3>
              <p>Sets the event, audience, access, programme, and reporting decisions.</p>
            </div>
          </div>
          <div class="edu-operations-card__visual">
            <img src="/images/industries/education/event-dashboard.webp" srcset="/images/industries/education/event-dashboard-web-640.webp 640w, /images/industries/education/event-dashboard-web-800.webp 800w" sizes="(max-width: 992px) calc(100vw - 112px), 600px" alt="EventHex event dashboard used by an education event owner" width="800" height="691" loading="lazy" decoding="async" />
            <span class="edu-operations-card__status">Accountable</span>
          </div>
        </article>

        <article class="edu-operations-card">
          <div class="edu-operations-card__header">
            <div class="edu-operations-card__number">02</div>
            <div class="edu-operations-card__text">
              <h3>Specialist teams</h3>
              <p>Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.</p>
            </div>
          </div>
          <div class="edu-operations-card__visual">
            <img src="/images/industries/education/sessions-workspace.webp" srcset="/images/industries/education/sessions-workspace-web-640.webp 640w, /images/industries/education/sessions-workspace-web-800.webp 800w" sizes="(max-width: 992px) calc(100vw - 112px), 600px" alt="EventHex programme workspace for education event specialist teams" width="800" height="441" loading="lazy" decoding="async" />
            <span class="edu-operations-card__status">Operational</span>
          </div>
        </article>

        <article class="edu-operations-card">
          <div class="edu-operations-card__header">
            <div class="edu-operations-card__number">03</div>
            <div class="edu-operations-card__text">
              <h3>Event leadership</h3>
              <p>Reviews event and portfolio signals for the next operating decision.</p>
            </div>
          </div>
          <div class="edu-operations-card__visual">
            <img src="/images/industries/education/platform-analytics.webp" srcset="/images/industries/education/platform-analytics-web-640.webp 640w, /images/industries/education/platform-analytics-web-800.webp 800w" sizes="(max-width: 992px) calc(100vw - 112px), 600px" alt="EventHex analytics dashboard for education event leadership" width="800" height="430" loading="lazy" decoding="async" />
            <span class="edu-operations-card__status">Decision</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <FeatureCards
    cards={educationJourneyCards}
    subtitle="Education attendee journey"
    titleLineOne="Connect the moments"
    titleLineTwo="actually move through"
    highlight="attendees"
  />

  <section class="edu-workflow-reference" aria-labelledby="edu-event-day-workflow-title">
    <div class="edu-workflow-reference__inner">
      <header class="edu-workflow-reference__header">
        <div class="edu-workflow-reference__eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13"></path><path d="M3 6h.01M3 12h.01M3 18h.01"></path>
          </svg>
          Event-day workflow
        </div>
        <h2 id="edu-event-day-workflow-title">Keep event-day actions tied to <span>the same event record</span></h2>
      </header>
      <ol class="edu-workflow-reference__steps">
        {workflow.map((step, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span>0{index + 1}</span>
                <div class="edu-workflow-reference__content">
                  <h3>{step.title}</h3>
                  <p>{step.desc}</p>
                  <ul>
                    {step.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}
                  </ul>
                </div>
                <button
                  type="button"
                  class="edu-workflow-reference__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </button>
              </summary>
              <div class="edu-workflow-reference__visual">
                <img src={step.image} alt={step.alt} width={step.width} height={step.height} loading="lazy" decoding="async" />
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="edu-boundary" aria-labelledby="edu-boundary-title">
    <div class="edu-boundary__container">
      <header class="edu-boundary__header">
        <span class="edu-boundary__sr-copy">Education configuration boundary</span>
        <h2 id="edu-boundary-title">Keep EventHex responsibility separate from <span>specialist requirements</span></h2>
      </header>

      <div class="edu-boundary__grid">
        <span class="edu-boundary__notch edu-boundary__notch--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg>
        </span>
        <span class="edu-boundary__notch edu-boundary__notch--bottom" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg>
        </span>

        <article class="edu-boundary__row">
          <div class="edu-boundary__cell edu-boundary__visual">
            <div class="edu-boundary__stage edu-boundary__stage--workflow">
              <img src="/images/live-polling-qa/app/event-dashboard.png" alt="EventHex event dashboard showing connected event operations" width="1263" height="697" loading="lazy" decoding="async" />
              <span class="edu-boundary__float edu-boundary__float--top"><b>✓ Configured</b><small>Supported workflow</small></span>
              <span class="edu-boundary__float edu-boundary__float--bottom"><i></i><b>Event record connected</b></span>
            </div>
          </div>
          <div class="edu-boundary__cell edu-boundary__content">
            <span>Product scope</span>
            <h3>EventHex workflow</h3>
            <p>Configure the supported event, audience, access, content, communication, engagement, and event-day mechanisms.</p>
          </div>
          <span class="edu-boundary__cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg>
          </span>
        </article>

        <article class="edu-boundary__row edu-boundary__row--reverse">
          <div class="edu-boundary__cell edu-boundary__content">
            <span>Review scope</span>
            <h3>Your specialist requirements</h3>
            <p>Map legal, regulatory, accreditation, identity, accessibility, venue, payment-provider, and industry-specific obligations to the teams and systems responsible for them.</p>
          </div>
          <div class="edu-boundary__cell edu-boundary__visual">
            <div class="edu-boundary__stage edu-boundary__stage--review">
              <img src="/images/webhooks/platform-analytics-web-960.webp" alt="EventHex analytics workspace used to review event operations" width="960" height="516" loading="lazy" decoding="async" />
              <span class="edu-boundary__float edu-boundary__float--top"><b>Review required</b><small>Specialist obligations</small></span>
              <span class="edu-boundary__float edu-boundary__float--bottom"><i></i><b>Owner assigned</b></span>
            </div>
          </div>
        </article>
      </div>
      <p class="edu-boundary__decision">Confirm every specialist obligation before implementation and record how it will be handled.</p>
    </div>
  </section>

  <section class="edu-use-cases" aria-labelledby="edu-use-cases-title">
    <div class="edu-use-cases__inner">
      <header class="edu-use-cases__header">
        <h2 id="edu-use-cases-title">Configure EventHex around the <span>event you are running</span></h2>
        <p>Choose the education event model that best matches the workflow your team needs to coordinate.</p>
      </header>

      <div class="edu-use-cases__tabs" role="tablist" aria-label="Education event use cases">
        {educationUseCases.map((useCase, index) => (
          <button
            class:list={["edu-use-cases__tab", { "is-active": index === 0 }]}
            type="button"
            role="tab"
            id={`edu-use-case-tab-${useCase.id}`}
            aria-controls={`edu-use-case-panel-${useCase.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-use-case={useCase.id}
          >
            {useCase.label}
          </button>
        ))}
      </div>

      <div class="edu-use-cases__panels">
        {educationUseCases.map((useCase, index) => (
          <article
            class:list={["edu-use-cases__panel", { "is-active": index === 0 }]}
            id={`edu-use-case-panel-${useCase.id}`}
            role="tabpanel"
            aria-labelledby={`edu-use-case-tab-${useCase.id}`}
            data-use-case-panel={useCase.id}
            hidden={index !== 0}
          >
            <div class="edu-use-cases__copy">
              <h3>{useCase.title}</h3>
              <p>{useCase.description}</p>
              <div class="edu-use-cases__replaces">
                <span>REPLACES</span>
                <div aria-label="Separate documents, email, and chat threads">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
