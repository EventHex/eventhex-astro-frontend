    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--surface-card-border,#e8ecf2);
  }
  .edu-owner-links__item {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 318px;
    padding: 28px 28px 34px;
    border-left: 1px solid var(--surface-card-border,#e8ecf2);
    color: inherit;
    text-decoration: none;
  }
  .edu-owner-links__item--first { border-left: 0; }
  .edu-owner-links__item:focus-visible { outline: 3px solid rgba(55,93,251,.3); outline-offset: -3px; }
  .edu-owner-links__notch {
    position: absolute;
    top: 0;
    z-index: 2;
