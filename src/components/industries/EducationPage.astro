  .edu-owner-links__icon {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    color: var(--brand-blue,#375dfb);
  }
  .edu-owner-links__icon svg { width: 100%; height: 100%; }
  .edu-owner-links__content h3 {
    min-height: 2.5em;
    margin: 0 0 28px;
    color: var(--heading-dark,#22272f);
    font: 600 21px/1.25 var(--font-heading);
  }
  .edu-owner-links__content p { margin: 14px 0 0; color: var(--body-gray,#525866); font: 400 15px/1.4 var(--font-body); }
  @media(max-width:992px) {
    .edu-owner-links__grid { grid-template-columns: 1fr; }
    .edu-owner-links__notch { display: none; }
    .edu-owner-links__item { min-height: 0; border-top: 1px solid var(--surface-card-border,#e8ecf2); border-left: 0; }
    .edu-owner-links__item--first { border-top: 0; }
  }
  @media(max-width:620px) { .edu-owner-links { padding: 60px 20px; } }
</style>

