---
// 4-Column Setup Strip with Petal Notches
// Replicating the signature Event Registration / Speaker Management setup strip pattern

const setupCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
    title: "Ticket-backed packages",
    body: "Create Standard, Gold, or Custom exhibitor packages with booth details, sale periods, capacity limits, and optional pricing.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
    title: "Custom application forms",
    body: "Collect company identity, admin contacts, custom questionnaire responses, and floor-plan attachments during registration.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
    title: "Approval & review queue",
    body: "Review submitted companies in one workspace. Approve or reject with custom notifications, or reverse decisions when needed.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
    title: "0% fee lead capture access",
    body: "Decide whether each package includes attendee QR lead capture, with zero per-scan charges or platform commission.",
  },
];
---

<section class="exh-setup">
  <div class="exh-setup__inner">
    <header class="exh-setup__header">
      <h2 class="animate-on-scroll" data-animation="fadeInUp">Define packages, then review every application</h2>
    </header>

    <div class="exh-setup-grid animate-on-scroll" data-animation="fadeInUp">
      {setupCards.slice(0, -1).map((_, index) => (
        <div
          class="exh-setup-notch"
          style={`left: ${((index + 1) / setupCards.length) * 100}%`}
          aria-hidden="true"
        >
          <svg width="28" height="28" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path>
          </svg>
        </div>
      ))}
      {setupCards.map((card, index) => (
        <div class:list={["exh-setup-card", { "exh-setup-card--first": index === 0 }]}>
          <div class="exh-setup-card__icon" set:html={card.icon} />
          <div class="exh-setup-card__content">
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exh-setup {
    width: 100%;
    padding: clamp(64px, 7vw, 96px) 24px;
    background: linear-gradient(135deg, #f8faff 0%, #f1f4ff 52%, #f8fbff 100%);
  }

  .exh-setup__inner {
    max-width: 1140px;
    margin: 0 auto;
  }

  .exh-setup__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .exh-setup__header h2 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #111827;
    margin: 0;
  }

  .exh-setup-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
    border-top: 1px solid #e5e7eb;
  }

  .exh-setup-notch {
    position: absolute;
    top: -14px;
    transform: translateX(-50%);
    z-index: 3;
    pointer-events: none;
  }

  .exh-setup-card {
    position: relative;
    padding: 26px 28px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-right: 1px solid #e5e7eb;
    transition: transform 0.2s ease;
  }

  .exh-setup-card:last-child {
    border-right: none;
  }

  .exh-setup-card:hover {
    background: transparent;
    transform: translateY(-3px);
  }

  .exh-setup-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 0;
    background: transparent;
    color: var(--brand-blue, #2563eb);
    flex-shrink: 0;
  }

  .exh-setup-card__content h3 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: #0f172a;
    margin: 0 0 10px;
    letter-spacing: -0.015em;
  }

  .exh-setup-card__content p {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .exh-setup-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .exh-setup-card:nth-child(2n) {
      border-right: none;
    }
    .exh-setup-card:nth-child(-n+2) { border-bottom: 0; }
    .exh-setup-notch {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .exh-setup-grid {
      grid-template-columns: 1fr;
    }
    .exh-setup-card {
      border-right: none;
      border-bottom: 1px solid var(--surface-card-border, #e8ecf2);
      padding: 28px 20px;
    }
    .exh-setup-card:last-child {
      border-bottom: none;
    }
  }
</style>
