---
// Use Cases Tabbed Suite Section
// Replicating the exact interactive suite pattern from Speaker Management's DeckSections

const useCasesTabs = [
  {
    id: "trade-shows",
    label: "Trade shows & expos",
    title: "Coordinate high-volume<br/>booths, faster",
    description: "Manage exhibitor applications, booth packages, staff passes, attendee discovery, and lead capture across event formats.",
    checklist: [
      "Custom booth package tiers and pricing",
      "Bulk staff pass distribution and check-in",
      "High-speed QR lead capture with offline caching",
    ],
    visualLabel: "Multi-hall trade show",
    colorTint: "#fff8dc",
    borderColor: "#f0dfa6",
  },
  {
    id: "conferences",
    label: "Conferences & summits",
    title: "Connect sponsors with<br/>the right attendees",
    description: "Publish sponsor-exhibitor profiles directly on the agenda and enable booth representatives to engage in targeted B2B networking.",
    checklist: [
      "Integrated company profile on event website",
      "Direct link to sponsored sessions and speakers",
      "Lead qualification with custom sales remarks",
    ],
    visualLabel: "Conference sponsor booths",
    colorTint: "#edf7ff",
    borderColor: "#d4e7f7",
  },
  {
    id: "associations",
    label: "Association expos",
    title: "Simplify vendor &<br/>member onboarding",
    description: "Review member vendor applications, distribute included association passes, and keep setup instructions in one centralized portal.",
    checklist: [
      "Application review and approval workflows",
      "Included member pass entitlement tracking",
      "Direct floor-plan and compliance file distribution",
    ],
    visualLabel: "Association vendor portal",
    colorTint: "#f3efff",
    borderColor: "#e2d8fa",
  },
  {
    id: "corporate",
    label: "Corporate partner events",
    title: "VIP partner coordination<br/>without spreadsheets",
    description: "Coordinate invited strategic partner companies, private ticket allocations, shared resources, and executive attendee discovery.",
    checklist: [
      "Passwordless magic link entry for partner admins",
      "Private ticket-restricted pass issuing",
      "Automated lead handoff to exhibitor CRMs",
    ],
    visualLabel: "Corporate partner showcase",
    colorTint: "#eefbf4",
    borderColor: "#d4efdf",
  },
];
---

<section class="exh-suites" id="use-cases" aria-labelledby="exh-suites-title">
  <div class="exh-suites__inner">
    <header class="exh-suites__header">
      <span class="exh-suites__badge animate-on-scroll" data-animation="fadeIn">BUILT FOR EXHIBITOR-HEAVY EVENTS</span>
      <h2 id="exh-suites-title" class="exh-suites__title animate-on-scroll" data-animation="fadeInUp">
        <span class="exh-suites__title-line">Built for the events that</span>
        <span class="exh-suites__title-line">rely on exhibitors</span>
      </h2>
      <p class="exh-suites__subtitle animate-on-scroll" data-animation="fadeInUp">
        Manage packages, booths, staff, and leads across trade shows, summits, and corporate expos in one unified workspace.
      </p>
    </header>

    <div class="exh-suites__tabs animate-on-scroll" data-animation="fadeInUp" role="tablist">
      {useCasesTabs.map((tab, index) => (
        <button
          class={`exh-suites__tab ${index === 0 ? 'exh-suites__tab--active' : ''}`}
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${tab.id}`}
          id={`tab-${tab.id}`}
          data-target={tab.id}
          type="button"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="exh-suites__box animate-on-scroll" data-animation="fadeInUp">
      {useCasesTabs.map((tab, index) => (
        <div
          class={`exh-suites__panel ${index === 0 ? 'exh-suites__panel--active' : ''}`}
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          style={`--panel-tint: ${tab.colorTint}; --panel-border: ${tab.borderColor};`}
        >
          <div class="exh-suites__left">
            <h3 class="exh-suites__panel-title" set:html={tab.title} />
            <p class="exh-suites__panel-desc">{tab.description}</p>

            <div class="exh-suites__replaces">
              <span class="exh-suites__replaces-label">REPLACES</span>
              <span class="exh-suites__replaces-icons" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </span>
            </div>

            <ul class="exh-suites__checklist">
              {tab.checklist.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="exh-suites__right">
            <img class="exh-app-shot exh-app-shot--usecases" src="/images/app-6.png" alt="EventHex event workspace" loading="lazy" decoding="async" />
            <div class="exh-suites__showcase">
              <span class="exh-suites__visual-label">
                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2.5" y="3.5" width="15" height="13" rx="2"></rect><path d="M2.5 8h15M7.5 8v8.5M12.5 8v8.5"></path></svg>
                {tab.visualLabel}
              </span>
              
              <!-- Custom Visual Preview Mockup per Tab -->
              <div class="exh-panel-preview">
                <div class="exh-preview-header">
                  <b>{tab.label}</b>
                  <span>Live Module Workspace</span>
                </div>
                <div class="exh-preview-content">
                  <div class="exh-preview-card">
                    <span class="exh-preview-title">Package Allocation</span>
                    <div class="exh-preview-bar"><i style="width: 80%;"></i></div>
                    <small>24 / 30 Booths Allocated</small>
                  </div>
                  <div class="exh-preview-card">
                    <span class="exh-preview-title">Lead Sync &amp; Attended</span>
                    <div class="exh-preview-bar exh-preview-bar--green"><i style="width: 68%;"></i></div>
                    <small>Real-time Check-in Active</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const suite = document.querySelector('.exh-suites');
    if (!suite) return;

    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>('.exh-suites__tab'));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>('.exh-suites__panel'));
    let rotationId: number | undefined;

    const activateTab = (tab: HTMLButtonElement) => {
      const targetId = tab.getAttribute('data-target');

      tabs.forEach((item) => {
        item.classList.remove('exh-suites__tab--active');
        item.setAttribute('aria-selected', 'false');
      });

      panels.forEach((panel) => {
        panel.classList.remove('exh-suites__panel--active');
      });

      tab.classList.add('exh-suites__tab--active');
      tab.setAttribute('aria-selected', 'true');
      const activePanel = suite.querySelector<HTMLElement>(`#panel-${targetId}`);
      activePanel?.classList.add('exh-suites__panel--active');
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      rotationId = window.setInterval(() => {
        const currentIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
        activateTab(tabs[(currentIndex + 1) % tabs.length]);
      }, 4500);
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activateTab(tab);
        startRotation();
      });
    });

    suite.addEventListener('mouseenter', stopRotation);
    suite.addEventListener('mouseleave', startRotation);
    suite.addEventListener('focusin', stopRotation);
    suite.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) {
        startRotation();
      }
    });

    startRotation();
  });
</script>

<style>
  .exh-suites {
    padding: clamp(72px, 8vw, 112px) 24px;
    background: #ffffff;
  }

  .exh-suites__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .exh-suites__header {
    text-align: center;
    margin-bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .exh-suites__badge {
    color: #6366f1;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
    font-family: monospace;
  }

  .exh-suites__title {
    font-family: var(--font-heading);
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    max-width: 800px;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .exh-suites__title-line {
    display: block;
  }

  .exh-suites__subtitle {
    font-family: var(--font-body);
    font-size: 17px;
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
    font-weight: 500;
    max-width: 680px;
  }

  .exh-suites__tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 6px;
    background: #f1f3f7;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    flex-wrap: wrap;
  }

  .exh-suites__tab {
    background: transparent;
    border: 1px solid transparent;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }

  .exh-suites__tab:hover {
    background: rgba(255, 255, 255, 0.65);
    color: #334155;
  }

  .exh-suites__tab--active {
    background: #ffffff !important;
    color: #3b82f6 !important;
    border-color: #dbe4f0 !important;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
  }

  .exh-suites__box {
    background: transparent;
  }

  .exh-suites__panel {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 52px 64px;
    border: 1px solid var(--panel-border, #f0dfa6);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--panel-tint, #fff8dc) 0%, #ffffff 72%);
    animation: exhPanelFade 0.4s ease forwards;
  }

  @keyframes exhPanelFade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .exh-suites__panel--active {
    display: grid;
  }

  .exh-suites__panel-title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 3.6vw, 40px);
    font-weight: 500;
    color: #1f2937;
    line-height: 1.12;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
  }

  .exh-suites__panel-desc {
    font-size: 16px;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 28px;
    font-weight: 500;
  }

  .exh-suites__replaces {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .exh-suites__replaces-label {
    font-size: 11px;
    font-weight: 700;
    color: #9ca3af;
    letter-spacing: 0.12em;
  }

  .exh-suites__replaces-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #9ca3af;
  }

  .exh-suites__checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .exh-suites__checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 500;
    color: #6b7280;
    line-height: 1.4;
  }

  .exh-suites__checklist li svg {
    flex-shrink: 0;
    stroke: #10b981;
  }

  /* Right Showcase */
  .exh-suites__right {
    min-width: 0;
  }

  .exh-suites__showcase {
    position: relative;
    padding: 28px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 48px rgba(31, 41, 55, 0.08);
  }

  .exh-suites__visual-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    font-size: 11.5px;
    font-weight: 700;
    color: #2563eb;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .exh-panel-preview {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
  }

  .exh-preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f4f9;
  }

  .exh-preview-header b {
    font-size: 14px;
    color: #0f172a;
  }

  .exh-preview-header span {
    font-size: 11.5px;
    color: #64748b;
  }

  .exh-preview-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .exh-preview-card {
    padding: 12px 14px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #edf2f7;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exh-preview-title {
    font-size: 12.5px;
    font-weight: 600;
    color: #1e293b;
  }

  .exh-preview-bar {
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: #e2e8f0;
    overflow: hidden;
  }

  .exh-preview-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: #2563eb;
  }

  .exh-preview-bar--green i {
    background: #10b981;
  }

  .exh-preview-card small {
    font-size: 11px;
    color: #64748b;
  }

  @media (max-width: 900px) {
    .exh-suites__panel {
      grid-template-columns: 1fr;
      padding: 40px 32px;
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    .exh-suites {
      padding: 60px 16px;
    }
    .exh-suites__panel {
      padding: 28px 20px;
      border-radius: 20px;
    }
    .exh-suites__tabs {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .exh-suites__tabs::-webkit-scrollbar {
      display: none;
    }
    .exh-suites__tab {
      flex-shrink: 0;
    }
  }
</style>
