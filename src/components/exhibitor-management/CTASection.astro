---
// Mid-page CTA Section
// Matching the dark card with glowing orbs from Speaker Management
---

<section class="exh-cta">
  <div class="exh-cta__card">
    <div class="exh-cta__glow exh-cta__glow--1"></div>
    <div class="exh-cta__glow exh-cta__glow--2"></div>
    <div class="exh-cta__content">
      <span class="exh-cta__eyebrow animate-on-scroll" data-animation="fadeIn">Bring one real exhibitor workflow</span>
      <h2 class="exh-cta__title animate-on-scroll" data-animation="fadeInUp">
        See the exhibitor journey from application to captured lead
      </h2>
      <p class="exh-cta__desc animate-on-scroll" data-animation="fadeInUp">
        In the demo, map one package, application, approved company, booth team, pass allocation, public profile, and lead workflow to your next event.
      </p>
      <div class="exh-cta__buttons">
        <a href="/book-a-demo/" class="exh-cta__btn exh-cta__btn--primary">
          Book a Demo
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
    <div class="exh-cta__image">
      <img src="/feature-images/speaker-management/cta-illustration.svg" alt="Exhibitor Management Platform Illustration" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .exh-cta {
    max-width: 1140px;
    margin: 0 auto;
    padding: 60px 24px 80px;
  }

  .exh-cta__card {
    position: relative;
    border-radius: 24px;
    padding: 60px 48px;
    display: flex;
    flex-direction: row;
    align-items: center;
    text-align: left;
    overflow: hidden;
    background: #0f1629;
    gap: 40px;
  }

  .exh-cta__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .exh-cta__glow--1 {
    width: 400px;
    height: 400px;
    background: rgba(55, 93, 251, 0.22);
    top: -100px;
    left: -50px;
  }

  .exh-cta__glow--2 {
    width: 300px;
    height: 300px;
    background: rgba(159, 129, 255, 0.18);
    bottom: -80px;
    right: -30px;
  }

  .exh-cta__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    flex: 1;
    min-width: 0;
  }

  .exh-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.76);
  }

  .exh-cta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0;
  }

  .exh-cta__desc {
    font-family: var(--font-body);
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 540px;
  }

  .exh-cta__proof-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .exh-cta__proof-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .exh-cta__buttons {
    display: flex;
    gap: 12px;
  }

  .exh-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 28px;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .exh-cta__btn--primary {
    background: var(--brand-blue, #2563eb);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.4);
  }

  .exh-cta__btn--primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 6px 28px rgba(37, 99, 235, 0.5);
  }

  .exh-cta__image {
    position: relative;
    z-index: 1;
    flex: 0 0 40%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .exh-cta__image img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    animation: exhCtaFloat 4s ease-in-out infinite;
  }

  @keyframes exhCtaFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 1024px) {
    .exh-cta__card {
      padding: 48px 32px;
    }
  }

  @media (max-width: 768px) {
    .exh-cta {
      padding: 40px 16px 60px;
    }
    .exh-cta__card {
      padding: 40px 24px;
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .exh-cta__content {
      align-items: center;
    }
    .exh-cta__proof-row {
      justify-content: center;
    }
    .exh-cta__buttons {
      width: 100%;
      justify-content: center;
    }
    .exh-cta__btn {
      width: 100%;
    }
    .exh-cta__image {
      display: none;
    }
  }
</style>
