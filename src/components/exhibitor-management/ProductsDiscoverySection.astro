---
// Products, Collateral & Attendee Discovery Bento Section
---

<section class="exh-discovery" id="products-resources" aria-labelledby="exh-discovery-title">
  <div class="exh-discovery__inner">
    <header class="exh-discovery__header">
      <span class="exh-discovery__eyebrow animate-on-scroll" data-animation="fadeIn"><span aria-hidden="true">✦</span> More context at every booth</span>
      <h2 id="exh-discovery-title" class="exh-discovery__title animate-on-scroll" data-animation="fadeInUp">
        Turn each exhibitor profile into a useful <span class="exh-discovery__gradient">product destination</span>
      </h2>
      <p class="exh-discovery__subtitle animate-on-scroll" data-animation="fadeInUp">
        Give attendees reasons to explore before, during, and after the show with company-managed product catalogs, downloadable brochures, and interactive booth discovery.
      </p>
    </header>

    <div class="exh-discovery__grid">
      <!-- Bento 1: Product Showcase (Large Card) -->
      <article class="exh-disc-card exh-disc-card--wide animate-on-scroll" data-animation="fadeInUp">
        <img class="exh-app-shot--product-card" src="/images/app-hero.png" alt="EventHex event and exhibitor workspace" loading="lazy" decoding="async" />
        <div class="exh-disc-card__content">
          <span class="exh-disc-pill">Product Listings</span>
          <h3>Digital product catalog with external links</h3>
          <p>
            Exhibitors upload solution photos, descriptions, technical specifications, and custom destination links so attendees can research offerings straight from the event app or directory.
          </p>
          <div class="exh-product-item">
            <div class="exh-product-item__thumb">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="exh-product-item__meta">
              <strong>Northstar Analytics Suite</strong>
              <span>Real-time telemetry and edge monitoring platform</span>
            </div>
            <span class="exh-product-item__btn">View Product &rarr;</span>
          </div>
        </div>
      </article>

      <!-- Bento 2: Downloadable Brochures -->
      <article class="exh-disc-card animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 60ms">
        <img class="exh-app-shot--product-card" src="/images/app-5.png" alt="EventHex product and file management screen" loading="lazy" decoding="async" />
        <div class="exh-disc-card__content">
          <span class="exh-disc-pill">Collateral &amp; Files</span>
          <h3>Brochures &amp; spec sheets</h3>
          <p>
            Attach PDF brochures, whitepapers, and pricing sheets that attendees can download directly to their devices.
          </p>
          <div class="exh-file-strip">
            <span class="exh-file-icon">PDF</span>
            <div class="exh-file-meta">
              <b>product-datasheet-2026.pdf</b>
              <small>2.4 MB · 142 downloads</small>
            </div>
          </div>
        </div>
      </article>

      <!-- Bento 3: Attendee Bookmarks -->
      <article class="exh-disc-card animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 120ms">
        <img class="exh-app-shot--product-card" src="/images/app-3.png" alt="EventHex exhibitor portal product screen" loading="lazy" decoding="async" />
        <div class="exh-disc-card__content">
          <span class="exh-disc-pill">Mobile &amp; Web App</span>
          <h3>Attendee bookmarks</h3>
          <p>
            Attendees bookmark preferred exhibitors and products in their event app to build a personalized show route.
          </p>
          <div class="exh-bookmark-preview">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#2563eb" stroke="#2563eb" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            <span>Saved to Attendee Visit List (Hall 2 · Booth B14)</span>
          </div>
        </div>
      </article>

      <!-- Bento 4: Floor Plan Viewer -->
      <article class="exh-disc-card animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 180ms">
        <img class="exh-app-shot--product-card" src="/images/app-6.png" alt="EventHex venue and event workspace screen" loading="lazy" decoding="async" />
        <div class="exh-disc-card__content">
          <span class="exh-disc-pill">Venue Navigation</span>
          <h3>Floor-plan viewer</h3>
          <p>
            Upload titled venue maps and hall diagrams for exhibitors to review load-in routes and attendees to locate booths.
          </p>
          <div class="exh-map-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
            <span>Main Exhibition Hall 1–3 Map.pdf</span>
          </div>
        </div>
      </article>

      <!-- Bento 5: Public Website Directory -->
      <article class="exh-disc-card exh-disc-card--wide animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 240ms">
        <img class="exh-app-shot--product-card" src="/images/app-hero.png" alt="EventHex event directory workspace screen" loading="lazy" decoding="async" />
        <div class="exh-disc-card__content">
          <span class="exh-disc-pill">Website Integration</span>
          <h3>Searchable public exhibitor directory</h3>
          <p>
            Automatically publish approved exhibitors on your EventHex website. Attendees filter by category, search by keywords, and review company profiles with zero manual duplicate entry.
          </p>
          <div class="exh-directory-chips">
            <span class="exh-dir-tag is-active">All Exhibitors (24)</span>
            <span class="exh-dir-tag">Cloud &amp; DevOps</span>
            <span class="exh-dir-tag">AI &amp; Automation</span>
            <span class="exh-dir-tag">Cybersecurity</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .exh-discovery {
    padding: 4px 24px 80px;
    background-color: #000 !important;
    background-image: linear-gradient(180deg, #0d0a2c 0%, transparent 320px), radial-gradient(circle at 12% 30%, rgba(70,130,255,.28) 0%, transparent 55%);
  }

  .exh-discovery__inner {
    max-width: 1140px;
    margin: 0 auto;
  }

  .exh-discovery__header {
    text-align: center;
    max-width: 1050px;
    margin: 14px auto 64px;
  }

  .exh-discovery__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.24);
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -.02em;
    margin-bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 6px 16px -6px rgba(0,0,0,.35);
  }
  .exh-discovery__eyebrow > span { color: #afa3ff; font-size: 16px; }

  .exh-discovery__title {
    font-family: var(--font-heading);
    font-size: 46px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.02em;
    color: #fff;
    background: none;
    -webkit-text-fill-color: #fff;
    margin: 0 0 16px;
  }

  .exh-discovery__gradient {
    color: #afa3ff;
    background: none;
    -webkit-text-fill-color: #afa3ff;
  }

  .exh-discovery__subtitle {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    color: #9ca3af;
    margin: 0;
  }

  .exh-discovery__grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: min(1050px, 100%);
    margin: 0 auto;
    padding-bottom: 48px;
  }

  .exh-disc-card {
    position: sticky;
    top: 92px;
    height: 500px;
    min-height: 500px;
    padding: 0;
    border-radius: 22px;
    background: linear-gradient(135deg, #161a31 0%, #090b18 100%);
    border: 1px solid rgba(148,163,184,.22);
    box-shadow: 0 16px 40px rgba(0,0,0,.25);
    display: block;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .exh-disc-card::after {
    content: "";
    display: block;
    margin: 16px 16px 16px 0;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
    border: 1px solid rgba(255,255,255,.16);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
  }
  .exh-disc-card__content { display: flex; flex-direction: column; justify-content: center; width: 52%; height: 100%; padding: 40px; gap: 16px; }

  .exh-disc-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.07);
    border-color: rgba(176,139,255,.5);
  }

  .exh-disc-card--wide {
    grid-column: auto;
  }

  .exh-disc-card:nth-child(1) { z-index: 1; top: 92px; }
  .exh-disc-card:nth-child(2) { z-index: 2; top: 112px; }
  .exh-disc-card:nth-child(3) { z-index: 3; top: 132px; }
  .exh-disc-card:nth-child(4) { z-index: 4; top: 152px; }
  .exh-disc-card:nth-child(5) { z-index: 5; top: 172px; }
  .exh-disc-card:first-child {
    background: radial-gradient(circle at 82% 12%, rgba(109,92,235,.24), transparent 34%), radial-gradient(circle at 8% 92%, rgba(66,173,218,.13), transparent 28%), #090a10;
  }

  .exh-disc-pill {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8db4ff;
    margin-bottom: 2px;
    color: #afa3ff;
  }

  .exh-disc-card h3 {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #e7e4fa;
    margin: 0 0 10px;
  }

  .exh-disc-card p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255,255,255,.55);
    margin: 0 0 20px;
  }

  /* Product Item Preview */
  .exh-product-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(148,163,184,.16);
  }

  .exh-product-item__thumb {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .exh-product-item__meta {
    flex: 1;
    min-width: 0;
  }

  .exh-product-item__meta strong {
    display: block;
    font-size: 14px;
    color: #0f172a;
  }

  .exh-product-item__meta span {
    display: block;
    font-size: 12px;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exh-product-item__btn {
    font-size: 12.5px;
    font-weight: 600;
    color: #2563eb;
    white-space: nowrap;
  }

  /* File Strip */
  .exh-file-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(148,163,184,.16);
  }

  .exh-file-icon {
    font-size: 11px;
    font-weight: 800;
    background: #fee2e2;
    color: #dc2626;
    padding: 5px 8px;
    border-radius: 6px;
  }

  .exh-file-meta b {
    display: block;
    font-size: 13px;
    color: #0f172a;
  }

  .exh-file-meta small {
    font-size: 11px;
    color: #64748b;
  }

  /* Bookmark Preview */
  .exh-bookmark-preview {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    color: #1e40af;
    font-size: 13px;
    font-weight: 600;
  }

  /* Map Badge */
  .exh-map-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #edf2f7;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }

  /* Directory Chips */
  .exh-directory-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .exh-dir-tag {
    font-size: 12.5px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
  }

  .exh-dir-tag.is-active {
    background: #111827;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .exh-discovery__grid {
      display: flex;
    }
    .exh-disc-card--wide {
      grid-column: auto;
    }
    .exh-disc-card {
      grid-template-columns: 1fr;
      min-height: 360px;
      top: 76px !important;
    }
    .exh-discovery__title { font-size: clamp(36px, 8vw, 46px); }
  }
</style>
