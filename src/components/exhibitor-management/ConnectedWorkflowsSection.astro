---
// Connected Workflows Section
const connectedLinks = [
  {
    title: "Event Registration",
    href: "/event-registration/",
    desc: "Manage attendee-wide registration forms, multi-ticket checkout, and custom questionnaires.",
  },
  {
    title: "Event Ticketing",
    href: "/event-ticketing/",
    desc: "Configure general ticket types, inventory, tiered pricing, and zero-fee gateway delivery.",
  },
  {
    title: "Event Check-In",
    href: "/event-check-in/",
    desc: "Validate arrivals at venue doors and run instant badge printing for attendees and staff.",
  },
  {
    title: "Event Website Builder",
    href: "/event-website-builder/",
    desc: "Design the public exhibitor directory, session agendas, and branded event landing pages.",
  },
];
---

<section class="exh-workflows" id="connected-workflows" aria-labelledby="exh-workflows-title">
  <div class="exh-workflows__inner">
    <header class="exh-workflows__header">
      <span class="exh-workflows__eyebrow animate-on-scroll" data-animation="fadeIn">One unified platform</span>
      <h2 id="exh-workflows-title" class="exh-workflows__title animate-on-scroll" data-animation="fadeInUp">
        Connect the exhibitor journey to surrounding workflows
      </h2>
      <p class="exh-workflows__subtitle animate-on-scroll" data-animation="fadeInUp">
        Exhibitor Management owns company onboarding, booth passes, and lead capture. Connected EventHex modules power the rest of your event.
      </p>
    </header>

    <div class="exh-workflows__grid">
      {connectedLinks.map((link) => (
        <a class="exh-workflow-card animate-on-scroll" data-animation="fadeInUp" href={link.href}>
          <span class="exh-workflow-card__icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5h16v11H4z"></path><path d="M8 4v5M16 4v5M7 13h3M14 13h3M7 16h3"></path></svg></span>
          <div class="exh-workflow-card__head"><h3>{link.title}</h3></div>
          <p>{link.desc}</p>
          <span class="exh-workflow-card__link-text">Explore solution <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .exh-workflows {
    padding: 120px 24px;
    background: transparent;
  }

  .exh-workflows__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .exh-workflows__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 64px;
  }

  .exh-workflows__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-blue, #2563eb);
    margin-bottom: 12px;
  }

  .exh-workflows__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    background: linear-gradient(135deg, #222 0%, #333 40%, #888 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .exh-workflows__subtitle {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.5;
    color: #6b7280;
    margin: 0;
  }

  .exh-workflows__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--surface-card-border);
  }

  .exh-workflow-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 300px;
    padding: 28px;
    border: 0;
    border-left: 1px solid var(--surface-card-border);
    border-radius: 0;
    background: transparent;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .exh-workflow-card:hover {
    transform: translateY(-2px);
  }

  .exh-workflow-card:first-child { border-left: 0; }

  .exh-workflow-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 0;
  }

  .exh-workflow-card__head h3 {
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 650;
    color: #0f172a;
    margin: 0;
    line-height: 1.3;
  }

  .exh-workflow-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-bottom: 28px;
    color: var(--brand-blue);
  }

  .exh-workflow-card p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    color: var(--body-gray);
    margin: 14px 0 28px;
    flex: 1;
  }

  .exh-workflow-card__link-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-blue);
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .exh-workflows__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .exh-workflows__grid {
      grid-template-columns: 1fr;
    }
    .exh-workflow-card { border-left: 0; border-top: 1px solid var(--surface-card-border); min-height: 0; }
    .exh-workflow-card:first-child { border-top: 0; }
  }
</style>
