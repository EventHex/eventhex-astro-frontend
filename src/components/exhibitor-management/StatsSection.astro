---
// Stats & Trust Strip Section
// Matching the styling of Speaker Management and Event Registration
const stats = [
  { value: "500+", label: "Events Run on EventHex" },
  { value: "2,000+", label: "Exhibitors Managed" },
  { value: "15+", label: "Countries" },
  { value: "80%", label: "Fewer Organizer Emails" },
];
---

<section class="exh-trust-strip">
  <div class="exh-trust-strip__inner">
    <span class="exh-trust-strip__label">TRUSTED BY EVENT TEAMS</span>
    <div class="exh-trust-strip__divider" aria-hidden="true"></div>
    <div class="exh-trust-strip__stats">
      {stats.map((stat) => (
        <span class="exh-trust-strip__stat">
          <b>{stat.value}</b> {stat.label}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .exh-trust-strip {
    width: 100%;
    padding: 24px 20px;
    border-top: 1px solid #f1f4f9;
    border-bottom: 1px solid #f1f4f9;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
  }

  .exh-trust-strip__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .exh-trust-strip__label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  .exh-trust-strip__divider {
    width: 1px;
    height: 18px;
    background: #e2e8f0;
  }

  .exh-trust-strip__stats {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .exh-trust-strip__stat {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    color: #475569;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .exh-trust-strip__stat b {
    color: #0f172a;
    font-weight: 700;
    font-size: 14.5px;
  }

  @media (max-width: 768px) {
    .exh-trust-strip__divider {
      display: none;
    }
    .exh-trust-strip__inner {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
    .exh-trust-strip__stats {
      gap: 14px 20px;
    }
  }
</style>
