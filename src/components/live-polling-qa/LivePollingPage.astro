<script>
  function initPollingBandBleed() {
    const band = document.querySelector<HTMLElement>(".lpqr-polls-band");
    if (!band || band.dataset.bleedReady === "true" || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";
    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let ticking = false;
    let lastProgress = -1;
    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };
    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.round(Math.min(1, Math.max(0, travelled / (viewportHeight * .7))) * 100) / 100;
      if (progress === lastProgress) return;
      lastProgress = progress;
      band.style.setProperty("--band-p", String(progress));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => { measure(); lastProgress = -1; onScroll(); };
    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
  }
  function initFormatTabs() {
    const section = document.querySelector<HTMLElement>(".lpqr-formats");
    if (!section || section.dataset.tabsReady === "true") return;
    section.dataset.tabsReady = "true";
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>(".lpqr-format-tab"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>(".lpqr-format-panel"));
    const select = (tab: HTMLButtonElement) => {
      const target = tab.dataset.format;
      tabs.forEach(item => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach(panel => {
        const active = panel.dataset.formatPanel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", event => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + offset + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
  const initLivePollingPage = () => { initPollingBandBleed(); initFormatTabs(); };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initLivePollingPage, { once: true });
  else initLivePollingPage();
</script>

