---
interface Props { faqs: string[][] }
const { faqs } = Astro.props;

const controls = [
  ["Launch the poll", "Make the prepared question active."],
  ["Watch the response", "Review votes and percentages as they are recorded."],
  ["Close when ready", "End the poll when the room moves on."],
  ["Reopen if needed", "Accept more votes without rebuilding the question."],
  ["Preview the question", "Check Q&A content before selecting spotlight."],
  ["Change spotlight", "Move the stage display to the next audience question."],
];
const links = [
  ["Session-linked", "Session Management", "Build the agenda and session context that every poll, audience question, and feedback response uses.", "/session-management/", "/images/live-polling-qa/app/sessions-workspace.png", "Session connected", "Agenda context ready"],
  ["Attendee-ready", "Event Mobile App", "Give attendees the configured event and session experience, with the right interaction available at the right moment.", "/event-mobile-app/", "/images/live-polling-qa/app/attendee-mobile-app.png", "Interaction live", "Audience path open"],
  ["AI-assisted", "AI Session Recap", "Carry supported session content and audience signals into a useful attendee recap after the room moves on.", "/ai-session-recap/", "/images/live-polling-qa/app/instarecap-dashboard.png", "Recap prepared", "Session signals added"],
  ["Measurable", "Event Analytics", "Review event-wide engagement alongside the individual response so teams can see what resonated across the programme.", "/event-analytics/", "/images/live-polling-qa/app/platform-analytics.png", "Insights connected", "Reporting ready"],
];
const useCases = [
  { id: "conferences", label: "Conferences", title: "Keep the whole room involved", description: "Poll the room, surface audience questions, and capture feedback without breaking the flow of the programme.", image: "/images/live-polling-qa/app/event-dashboard.png", status: "Live responses connected", points: ["Session-linked polls", "Moderated audience Q&A", "Post-session feedback"] },
  { id: "associations", label: "Association events", title: "Turn member input into a clear signal", description: "Collect member perspectives during educational sessions and keep every response attached to the right programme context.", image: "/images/live-polling-qa/app/feedback-workspace.png", status: "Member feedback ready", points: ["Registered voting", "Anonymous participation", "Connected reporting"] },
  { id: "corporate", label: "Corporate events", title: "Make every town hall two-way", description: "Use structured questions in town halls and training sessions so teams can respond in the moment.", image: "/images/live-polling-qa/app/forms-workspace.png", status: "Session interaction live", points: ["Quick pulse checks", "Question spotlighting", "Private response paths"] },
  { id: "tech", label: "Tech conferences", title: "Capture product reactions live", description: "Give developer audiences a fast route to vote, ask detailed questions, and share immediate product feedback.", image: "/images/live-polling-qa/app/ai-gallery-analytics.png", status: "Product signal captured", points: ["Feature voting", "Technical Q&A", "Live sentiment"] },
  { id: "hybrid", label: "Hybrid events", title: "One interaction loop for every attendee", description: "Connect configured attendee surfaces to the same session whether the audience is in the room or joining remotely.", image: "/images/live-polling-qa/app/mobile-app-analytics.png", status: "Audience paths synced", points: ["QR and link access", "Shared live results", "Unified session context"] },
  { id: "workshops", label: "Workshops", title: "Check understanding as you teach", description: "Use quick questions and feedback prompts to see what landed and where the room needs more clarity.", image: "/images/live-polling-qa/app/session-recap-analytics.png", status: "Learning pulse ready", points: ["Knowledge checks", "Candid questions", "Instant facilitator feedback"] },
];
const feedbackItems = [
  ["Written response", "Open-text feedback", "Keep written comments connected to the correct session, so organizers can review the context behind every response.", "/images/live-polling-qa/app/gallery-contributions.png", "Feedback collected", "Session response saved"],
  ["In the moment", "Audience reaction", "Capture the supported mood or reaction value while the session is still fresh, without sending attendees into a separate survey flow.", "/images/live-polling-qa/app/event-chat.png", "Reaction saved", "Live sentiment captured"],
  ["Quick scoring", "1–5 session rating", "Record an optional numeric score alongside attendee feedback and keep it attached to the session that produced it.", "/images/live-polling-qa/app/attendance-overview.png", "Rating recorded", "Score added to session"],
  ["Connected insights", "Review every response", "Inspect individual feedback and broader event trends from the organizer workspace when the programme is over.", "/images/live-polling-qa/app/gallery-monetization.png", "Insights ready", "Responses connected"],
];
const liveFlowScreens = ["session-timeline.png", "speakers-workspace.png", "gallery-upload-history.png", "mobile-app-modules.png", "mobile-app-updates.png", "recap-translations.png"];
---

<div class="lpqr">
  <section class="lpqr-hero">
    <div class="lpqr-hero__grid">
      <div class="lpqr-hero__copy">
        <span class="lpqr-hero__badge animate-on-scroll" data-animation="fadeInDown">Live polling &amp; Q&amp;A for events</span>
        <h1 class="lpqr-hero__title animate-on-scroll" data-animation="fadeInUp">Turn each event session into a two-way conversation</h1>
        <p class="lpqr-lead animate-on-scroll" data-animation="fadeInUp">Launch a poll, collect audience questions, spotlight the one that belongs on stage, and review session feedback—without separating engagement from the event agenda.</p>
        <div class="lpqr-actions animate-on-scroll" data-animation="fadeInUp">
          <a class="lpqr-btn" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
        </div>
        <div class="lpqr-hero__trust"><span>Session-linked interactions</span><span>Registered or anonymous voting</span></div>
      </div>
      <div class="lpqr-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="lpqr-hero__visual-card">
          <div class="lpqr-hero__visual-inner">
            <div class="lpqr-analytics-shot">
              <img src="/images/platform-analytics-hero.png" alt="EventHex Platform Analytics dashboard showing event totals and event creation trends" width="1010" height="620" loading="eager" decoding="async" />
            </div>
            <div class="lpqr-analytics-chip lpqr-analytics-chip--live"><span></span> Live event insights</div>
            <div class="lpqr-analytics-chip lpqr-analytics-chip--trend"><b>+36</b><small>events created</small></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="lpqr-trust-strip" aria-label="Live polling and Q&A capabilities"><div class="lpqr-trust-strip__inner"><span><b>Session-linked</b> interactions</span><span><b>Registered &amp; anonymous</b> voting</span><span><b>QR code &amp; link</b> sharing</span><span><b>Polls, Q&amp;A &amp; feedback</b> in one workflow</span></div></section>

  <section class="lpqr-participation">
    <header class="lpqr-participation__header">
      <h2>Known Attendee, or Anonymous, Your Call</h2>
      <p>Choose the response path that fits the session and the audience signal you need to retain.</p>
    </header>
    <div class="lpqr-participation__grid">
      <article class="lpqr-participation__copy"><h3>Registered Voting</h3><p>Connect each vote to an attendee record, preserve session context, and carry a clear audience signal into your event reporting.</p></article>
      <div class="lpqr-participation__media"><div class="lpqr-participation__composite">
        <img class="lpqr-participation__screen lpqr-participation__screen--primary" src="/images/live-polling-qa/app/registrations-overview.png" alt="EventHex registered attendee overview" width="1263" height="420" loading="lazy" decoding="async" />
        <img class="lpqr-participation__screen lpqr-participation__screen--secondary" src="/images/live-polling-qa/app/registration-analytics.png" alt="EventHex registration analytics workspace" width="1263" height="698" loading="lazy" decoding="async" />
        <span class="lpqr-participation__status">✓ &nbsp;Attendee-linked insights</span><span class="lpqr-participation__action">View response</span>
      </div></div>
      <div class="lpqr-participation__media"><div class="lpqr-participation__composite">
        <img class="lpqr-participation__screen lpqr-participation__screen--primary" src="/images/live-polling-qa/app/instarecap-settings.png" alt="EventHex privacy-aware recap settings" width="1263" height="698" loading="lazy" decoding="async" />
        <img class="lpqr-participation__screen lpqr-participation__screen--secondary" src="/images/live-polling-qa/app/session-transcripts.png" alt="EventHex session transcript workspace" width="1263" height="698" loading="lazy" decoding="async" />
        <span class="lpqr-participation__status">✓ &nbsp;Privacy-friendly reporting</span><span class="lpqr-participation__action">Open poll</span>
      </div></div>
      <article class="lpqr-participation__copy"><h3>Anonymous Voting</h3><p>Use a public participation path and track the response without exposing attendee identity—the simple route for candid, low-friction feedback.</p></article>
    </div>
  </section>


  <section class="lpqr-section lpqr-dark lpqr-polls-band">
    <div class="lpqr-shell">
      <header class="lpqr-heading lpqr-heading--light"><span class="lpqr-eyebrow animate-on-scroll" data-animation="fadeInDown">Session polls</span><h2 class="animate-on-scroll" data-animation="fadeInUp">Ask One Clear Question <span>and See How the Room Responds</span></h2><p class="animate-on-scroll" data-animation="fadeInUp">Create a multiple-choice poll for the event or session, control when it is active, and review the resulting vote distribution.</p></header>
      <div class="lpqr-poll-grid">
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="0"><h3>Build the Question and Options</h3><p>Create one clear multiple-choice prompt and give the room focused ways to respond.</p><div class="lpqr-poll-ui lpqr-poll-ui--form"><small>LIVE POLL</small><strong>Which topic should we explore next?</strong><span>Audience engagement</span><span>Event analytics</span><span>Session planning</span><button type="button">+ Add option</button></div></article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="60"><span class="lpqr-poll-petal lpqr-poll-petal--top" aria-hidden="true"></span><span class="lpqr-poll-petal lpqr-poll-petal--bottom" aria-hidden="true"></span><h3>Start, End, and Reopen</h3><p>Control exactly when the poll accepts responses without rebuilding the question.</p><div class="lpqr-poll-ui lpqr-poll-ui--control"><span class="lpqr-pulse"></span><small>SESSION POLL</small><strong>Accepting responses</strong><div><b>128</b><em>votes received</em></div><button type="button">End poll</button><button type="button" class="is-ghost">Reopen</button></div></article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="120"><span class="lpqr-poll-petal lpqr-poll-petal--top" aria-hidden="true"></span><span class="lpqr-poll-petal lpqr-poll-petal--bottom" aria-hidden="true"></span><h3>See the Room Respond</h3><p>Watch option-level vote totals and percentages update while the session is live.</p><div class="lpqr-poll-ui lpqr-poll-ui--results"><small>LIVE RESULTS</small><div><span>Audience engagement</span><b>46%</b><i style="--result:46%"></i></div><div><span>Event analytics</span><b>34%</b><i style="--result:34%"></i></div><div><span>Session planning</span><b>20%</b><i style="--result:20%"></i></div></div></article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="180"><h3>Open Participation to Everyone</h3><p>Share the same live interaction through the event app, a direct link, or a room-ready QR code.</p><div class="lpqr-poll-ui lpqr-poll-ui--access"><small>PARTICIPATION PATHS</small><div><span>Event app</span><b>Ready</b></div><div><span>Share link</span><b>Copied</b></div><div><span>QR code</span><b>Live</b></div></div></article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="240"><span class="lpqr-poll-petal lpqr-poll-petal--top" aria-hidden="true"></span><h3>Carry the Signal Into Reporting</h3><p>Keep the poll, audience identity choice, and resulting response attached to the session after it ends.</p><div class="lpqr-poll-ui lpqr-poll-ui--summary"><small>SESSION SUMMARY</small><div><b>128</b><span>Total responses</span></div><div><b>82%</b><span>Participation rate</span></div><i><span style="--slice:46%"></span></i></div></article>
      </div>
    </div>
  </section>

  <section class="lpqr-reach">
    <div class="lpqr-reach__inner">
      <header class="lpqr-reach__header"><h2>Put Every Live Question <span>Within Reach</span></h2></header>
      <div class="lpqr-reach__grid">
        <article><div class="lpqr-reach__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 5h6M10 18h4"/></svg></div><h3>Event app</h3><p>Open polls directly from the attendee session experience.</p></article>
        <article><div class="lpqr-reach__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg></div><h3>Share link</h3><p>Send a direct participation URL from the organizer workspace.</p></article>
        <article><div class="lpqr-reach__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h4M14 21h3M21 14v3"/></svg></div><h3>QR code</h3><p>Display or distribute the generated QR participation path.</p></article>
        <article><div class="lpqr-reach__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M8 14h3M13 14h3"/></svg></div><h3>Session context</h3><p>Keep each interaction attached to the correct event and session.</p></article>
      </div>
    </div>
  </section>

  <section class="lpqr-qa-feature">
    <div class="lpqr-qa-feature__inner">
      <div class="lpqr-qa-feature__copy">
        <span class="lpqr-eyebrow">Audience Q&amp;A</span>
        <h2>collect the questions<br />and <span>spotlight the right one</span></h2>
        <p>Audience questions arrive in the session queue, where organizers can preview each one, protect anonymous identities, and move the right question into the stage-facing spotlight.</p>
        <div class="lpqr-qa-feature__actions"><a href="/book-a-demo/">Book a Demo →</a><a href="#faq">Explore Q&amp;A →</a></div>
      </div>
      <div class="lpqr-qa-feature__visual" role="img" aria-label="EventHex audience question queue and live spotlight view">
        <div class="lpqr-qa-feature__shot lpqr-qa-feature__shot--queue"><img src="/images/live-polling-qa/app/gallery-people-faces.png" alt="EventHex audience content review interface" width="1263" height="698" loading="lazy" decoding="async" /></div>
        <div class="lpqr-qa-feature__shot lpqr-qa-feature__shot--spotlight"><img src="/images/live-polling-qa/app/gallery-watermark.png" alt="EventHex stage content presentation settings" width="1263" height="698" loading="lazy" decoding="async" /></div>
        <span class="lpqr-qa-feature__status">✓ &nbsp;Question selected</span>
        <span class="lpqr-qa-feature__publish">Send to spotlight</span>
        <svg class="lpqr-qa-feature__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
      </div>
    </div>
  </section>

  <section class="lpqr-feedback-bento">
    <div class="lpqr-feedback-bento__inner">
      <header class="lpqr-feedback-bento__header"><span class="lpqr-eyebrow">Session feedback</span><h2>Capture what the room <span>really thought</span></h2></header>
      <div class="lpqr-feedback-bento__grid">
        <span class="lpqr-feedback-bento__notch lpqr-feedback-bento__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
        <span class="lpqr-feedback-bento__notch lpqr-feedback-bento__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
        {feedbackItems.map(([eyebrow,title,text,image,status,detail],i)=><article class:list={["lpqr-feedback-bento__row", { "lpqr-feedback-bento__row--reverse": i % 2 === 1 }]}>
          <div class="lpqr-feedback-bento__cell lpqr-feedback-bento__visual">
            <div class={`lpqr-feedback-bento__stage lpqr-feedback-bento__stage--${i+1}`}>
              <img src={image} alt={`EventHex ${title} organizer interface`} loading="lazy" decoding="async" />
              <span class="lpqr-feedback-bento__float lpqr-feedback-bento__float--top"><b>✓ {status}</b><small>{detail}</small></span>
              <span class="lpqr-feedback-bento__float lpqr-feedback-bento__float--bottom"><i></i><b>{i===3 ? "Review insights" : "Save response"}</b></span>
            </div>
          </div>
          <div class="lpqr-feedback-bento__cell lpqr-feedback-bento__content"><span>{eyebrow}</span><h3>{title}</h3><p>{text}</p></div>
          <span class="lpqr-feedback-bento__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(-90)"></path></svg></span>
        </article>)}
      </div>
    </div>
  </section>

  <section class="lpqr-section">
    <div class="lpqr-shell lpqr-live-flow">
      <header><span class="lpqr-eyebrow">Live control</span><h2>From prepared poll to live audience signal</h2></header>
      <div class="lpqr-live-flow__steps">
        {controls.map(([a,b], i)=><details class="lpqr-live-flow__step" open={i===0}>
          <summary><span>{String(i+1).padStart(2,"0")}</span><strong>{a}</strong><small>{b}</small><i aria-hidden="true"></i></summary>
          <div class="lpqr-live-flow__body">
            <div class="lpqr-live-flow__copy"><p>{b}</p><ul><li>Stay inside the session context</li><li>Keep the active state visible</li><li>Move to the next interaction quickly</li></ul></div>
            <div class="lpqr-live-flow__visual"><img src={`/images/live-polling-qa/app/${liveFlowScreens[i]}`} alt={`EventHex workflow screen for ${a}`} width="1263" height="698" loading="lazy" decoding="async" /><span>{i===0 ? 'Poll ready to launch' : i < 3 ? 'Session control' : 'Live response overview'}</span></div>
          </div>
        </details>)}
      </div>
    </div>
  </section>

  <section class="lpqr-section lpqr-soft">
    <div class="lpqr-connected">
      <header class="lpqr-connected__header"><span class="lpqr-eyebrow">Connected session operations</span><h2>Keep engagement connected<br />to the rest of the event</h2><p>Each interaction starts from a session record and hands off cleanly to the feature that owns the next task.</p></header>
      <div class="lpqr-connected__grid">
        <span class="lpqr-connected__notch lpqr-connected__notch--top" aria-hidden="true"></span>
        <span class="lpqr-connected__notch lpqr-connected__notch--bottom" aria-hidden="true"></span>
        {links.map(([eyebrow,title,description,href,image,status,detail], index)=><article class:list={["lpqr-connected__row", { "lpqr-connected__row--reverse": index % 2 === 1 }]}>
          <div class="lpqr-connected__visual"><div class:list={["lpqr-connected__stage", `lpqr-connected__stage--${index + 1}`]}><img src={image} alt={`EventHex ${title} workspace`} loading="lazy" decoding="async" /><span class="lpqr-connected__float lpqr-connected__float--top"><b>✓ {status}</b><small>{detail}</small></span><span class="lpqr-connected__float lpqr-connected__float--bottom"><i></i><b>Live workflow</b></span></div></div>
          <div class="lpqr-connected__content"><span>{eyebrow}</span><h3>{title}</h3><p>{description}</p><a href={href}>Learn more <span aria-hidden="true">→</span></a></div>
          <span class="lpqr-connected__cross" aria-hidden="true"></span>
        </article>)}
      </div>
    </div>
  </section>

  <section class="lpqr-section lpqr-formats">
    <div class="lpqr-formats__inner">
      <header class="lpqr-formats__header"><span class="lpqr-eyebrow">Built for live programmes</span><h2>Use the same interaction loop<br />across different session formats</h2><p>Choose the poll, question, and feedback path that fits the moment.</p></header>
      <div class="lpqr-format-tabs" role="tablist" aria-label="Live programme formats">
        {useCases.map((item, index)=><button class:list={["lpqr-format-tab", { "is-active": index === 0 }]} type="button" role="tab" id={`format-tab-${item.id}`} aria-controls={`format-panel-${item.id}`} aria-selected={index === 0 ? "true" : "false"} data-format={item.id}>{item.label}</button>)}
      </div>
      <div class="lpqr-format-box">
        {useCases.map((item, index)=><article class:list={["lpqr-format-panel", { "is-active": index === 0 }]} id={`format-panel-${item.id}`} role="tabpanel" aria-labelledby={`format-tab-${item.id}`} data-format-panel={item.id} hidden={index !== 0}>
          <div class="lpqr-format-panel__copy"><h3>{item.title}</h3><p>{item.description}</p><div class="lpqr-format-panel__replaces"><span>REPLACES</span><div aria-label="Spreadsheets, email, and chat"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6M8 13h8M8 17h8"></path></svg><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-9 5.7a2 2 0 0 1-2 0L2 7"></path></svg><svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"></path></svg></div></div><ul>{item.points.map(point=><li><svg viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"></path></svg>{point}</li>)}</ul></div>
          <div class="lpqr-format-panel__visual"><div class="lpqr-format-panel__showcase"><img src={item.image} alt={`EventHex live interaction workspace for ${item.label}`} loading="lazy" decoding="async" /><span><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7"></circle><path d="m6.8 10 2.1 2.2 4.5-4.6"></path></svg>{item.status}</span></div></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="lpqr-section lpqr-faq" id="faq">
    <div class="lpqr-faq__grid">
      <div class="lpqr-faq__sidebar">
        <span class="lpqr-faq__eyebrow"><span aria-hidden="true">↗</span> Quick Answers</span>
        <h2>Live Polling &amp; Q&amp;A<br />Questions, Answered.</h2>
        <p>Find quick answers about poll format, identity, access, spotlight, and session feedback.</p>
        <a class="lpqr-faq__cta" href="/contact-en/">Visit Help Center <span aria-hidden="true">→</span></a>
      </div>
      <div class="lpqr-faq__list">
        {faqs.map(([q,a],i)=><details class="lpqr-faq__item" open={i===0}>
          <summary><strong>{q}</strong><span class="lpqr-faq__icon" aria-hidden="true"></span></summary>
          <div class="lpqr-faq__answer"><p>{a}</p></div>
        </details>)}
      </div>
    </div>
  </section>

</div>

<style is:global>
