  .lpqr-participation__header { max-width: 1100px; margin: 0 auto 48px; text-align: center; }
  .lpqr .lpqr-participation__header h2 { margin: 0 0 12px;     font: 500 clamp(28px,4.2vw,48px)/1.1 var(--font-heading); letter-spacing: -.04em; }
  .lpqr .lpqr-participation__header p { max-width: 640px; margin: 0 auto; color: var(--muted); font: 400 18px/1.5 var(--font-body); }
  .lpqr-participation__grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; width: 100%; max-width: 1180px; margin: 0 auto; }
  .lpqr-participation__copy { display: flex; flex-direction: column; justify-content: center; min-height: 360px; padding: 56px 48px; border-right: 1px solid var(--ds-surface-tab); border-bottom: 1px solid var(--ds-surface-tab); }
  .lpqr-participation__copy:last-child { border: 0; }
  .lpqr .lpqr-participation__copy h3 { margin: 0 0 16px; color: var(--ds-ink); font: 700 clamp(24px,2.6vw,32px)/1.1 var(--font-heading); letter-spacing: -.03em; }
  .lpqr .lpqr-participation__copy p { max-width: 40ch; margin: 0; color: var(--muted); font: 400 16px/1.6 var(--font-body); }
  .lpqr-participation__media { display: flex; align-items: center; min-height: 360px; padding: 18px 22px; overflow: hidden; border-bottom: 1px solid var(--ds-surface-tab); }
  .lpqr-participation__media:nth-child(3) { border-right: 1px solid var(--ds-surface-tab); border-bottom: 0; }
  .lpqr-participation__composite { position: relative; width: 100%; height: 320px; }
  .lpqr-participation__screen { position: absolute; display: block; object-fit: cover; object-position: top left; border: 1px solid rgba(209,214,226,.92); border-radius: 12px; background: var(--ds-white); box-shadow: 0 16px 34px rgba(31,41,72,.14); }
  .lpqr-participation__screen--primary { top: 42px; left: 20px; z-index: 1; width: 78%; height: 68%; }
  .lpqr-participation__screen--secondary { right: 18px; bottom: 18px; z-index: 2; width: 64%; height: 52%; }
  .lpqr-participation__status,.lpqr-participation__action { position: absolute; z-index: 5; display: inline-flex; align-items: center; white-space: nowrap; border-radius: 10px; font: 700 11px/1 var(--font-body); box-shadow: 0 10px 24px rgba(31,41,72,.16); }
  .lpqr-participation__status { top: 14px; left: 14px; padding: 10px 12px; border: 1px solid var(--ds-line-strong); background: var(--ds-surface); color: var(--ds-cat-green); }
  .lpqr-participation__action { right: 14px; bottom: 14px; padding: 11px 14px; background: var(--ds-blue); color: var(--ds-white); }
  @media (max-width:768px) {
    .lpqr-participation { padding: 60px 16px; }
    .lpqr-participation__header { margin-bottom: 24px; }
    .lpqr-participation__grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .lpqr-participation__copy { min-height: 0; padding: 32px 20px; border-right: 0; border-bottom: 1px solid var(--ds-surface-tab); }
    .lpqr-participation__copy:last-child { order: 3; border-bottom: 1px solid var(--ds-surface-tab); }
    .lpqr-participation__media { padding: 16px 20px 32px; }
    .lpqr-participation__media:nth-child(3) { order: 4; border: 0; }
    .lpqr-participation__composite { height: 285px; }
  }
  .lpqr h1.lpqr-section-title,
  .lpqr h2.lpqr-section-title { font-size: 50px !important; font-weight: 500 !important; }
  @media (max-width:680px) {
    .lpqr h1.lpqr-section-title,
    .lpqr h2.lpqr-section-title { font-size: 34px !important; }
  }
</style>

<style is:global>
  /* Design system v5 layer: surfaces, headings, buttons, flat screenshot frames and quiet captions. */
  .lpqr { background: var(--ds-white); }
  .lpqr .lpqr-section-title { color: var(--ds-ink); font-weight: 500; letter-spacing: -.035em; }
  .lpqr .lpqr-hero__title { font-size: var(--ds-h1); line-height: 1.08; }
  .lpqr .ds-hl, .lpqr .ds-hl-dark {
    -webkit-background-clip: text !important; background-clip: text !important; color: transparent !important;
    -webkit-text-fill-color: transparent; -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .lpqr .ds-hl { background-image: var(--ds-g1-text); }
  .lpqr .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .lpqr .lpqr-eyebrow { font-weight: 500; letter-spacing: .06em; }
  .lpqr h3 { font-weight: 500; }

  /* Hero on the colour stage, screenshot in a flat frame with captions beneath */
  .lpqr .lpqr-hero { background: var(--ds-g4-stage); }
  .lpqr .lpqr-hero__badge, .lpqr .lpqr-hero__trust { color: var(--ds-sub); }
  .lpqr .lpqr-hero__visual { margin-right: 0; }
  .lpqr .lpqr-hero__visual-card { padding: 0; border: 0; border-radius: 0; background: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .lpqr .lpqr-hero__visual-inner { display: flex; flex-direction: column; gap: 12px; min-height: 0; padding: 0; overflow: visible; border-radius: 0; background: none; }
  .lpqr .lpqr-analytics-shot { width: 100%; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-lg); box-shadow: var(--ds-shadow-hero); animation: none; }
  .lpqr .lpqr-analytics-chip { position: static; display: flex; flex-direction: row; align-items: baseline; gap: 6px; padding: 0 4px; border: 0; border-radius: 0; background: none; box-shadow: none; backdrop-filter: none; animation: none; color: var(--ds-sub); font-weight: 500; }
  .lpqr .lpqr-analytics-chip--live span { align-self: center; }
  .lpqr .lpqr-analytics-chip--trend b { font-size: 12px; }
  .lpqr .lpqr-window { transform: none; }

  /* Buttons */
  .lpqr .lpqr-hero .lpqr-btn { padding: 14px 24px; border: 1px solid var(--ds-blue); border-radius: 12px; background: var(--ds-blue); color: var(--ds-white); font: 500 16px/1.2 var(--font-body); box-shadow: var(--ds-shadow-btn); }
  .lpqr .lpqr-hero .lpqr-btn:hover { background: var(--ds-blue-hover); border-color: var(--ds-blue-hover); }
  .lpqr .lpqr-formats__header h2 br { display: block; }
  .lpqr .lpqr-btn { padding: 14px 24px; font: 500 16px/1.2 var(--font-body); box-shadow: var(--ds-shadow-btn); }
  .lpqr .lpqr-btn:hover { transform: none; background: var(--ds-blue-hover); border-color: var(--ds-blue-hover); box-shadow: var(--ds-shadow-btn); }
  .lpqr .lpqr-faq__cta { padding: 14px 24px; border-radius: 12px; background: var(--ds-blue); font: 500 16px/1.2 var(--font-body); box-shadow: var(--ds-shadow-btn); }
  .lpqr .lpqr-faq__cta:hover { background: var(--ds-blue-hover); transform: none; }
  .lpqr .lpqr-connected__content a { padding: 12px 24px; border-radius: 12px; font-weight: 500; }
  .lpqr .lpqr-connected__content a:hover { transform: none; }

  /* Participation: flat screenshots, captions under them */
  .lpqr .lpqr-participation { background: var(--ds-white); }
  .lpqr .lpqr-participation__grid { border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-xl); overflow: hidden; background: var(--ds-surface); }
  .lpqr .lpqr-participation__screen { border: 1px solid var(--ds-line-strong); box-shadow: var(--ds-shadow-shot); }
  .lpqr .lpqr-participation__composite { height: 356px; }
  .lpqr .lpqr-participation__screen--primary { top: 8px; }
  .lpqr .lpqr-participation__screen--secondary { bottom: 46px; }
  .lpqr .lpqr-participation__status, .lpqr .lpqr-participation__action { top: auto; bottom: 8px; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; font-weight: 500; font-size: 12px; }
  .lpqr .lpqr-participation__status { left: 0; color: var(--ds-success); }
  .lpqr .lpqr-participation__action { right: 0; color: var(--ds-muted); }

  /* Poll band on deep night with dark glass */
  .lpqr .lpqr-polls-band { background: var(--ds-night-bg); }
  .lpqr .lpqr-polls-band::before, .lpqr .lpqr-polls-band::after { display: none; }
  .lpqr .lpqr-polls-band .lpqr-heading h2 { color: var(--ds-on-night); }
  .lpqr .lpqr-polls-band .lpqr-heading p, .lpqr .lpqr-heading--light p { color: var(--ds-on-night-body); }
  .lpqr .lpqr-polls-band .lpqr-eyebrow, .lpqr .lpqr-heading--light .lpqr-eyebrow { color: var(--ds-on-night-accent); }
  .lpqr .lpqr-poll-grid { border-color: var(--ds-glass-dark-edge); border-radius: var(--ds-r-xl); background: var(--ds-glass-dark-fill); box-shadow: var(--ds-glass-dark-shadow); }
  .lpqr .lpqr-poll-grid > article { border-color: var(--ds-glass-dark-edge); }
  .lpqr .lpqr-poll-grid > article > h3 { font-weight: 500; }
  .lpqr .lpqr-poll-grid > article > p { color: var(--ds-on-night-body); }

  /* Q&A: glass panel on the stage, flat shots, captions under the visual */
  .lpqr .lpqr-qa-feature { padding: clamp(48px,6vw,96px) 24px; background: var(--ds-g4-stage); }
  .lpqr .lpqr-qa-feature__inner { border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .lpqr .lpqr-qa-feature__visual { height: clamp(360px,34vw,390px); overflow: visible; background: none; }
  .lpqr .lpqr-qa-feature__visual::before { display: none; }
  .lpqr .lpqr-qa-feature__shot { border-radius: var(--ds-r-md); box-shadow: var(--ds-shadow-shot); }
  .lpqr .lpqr-qa-feature__shot--queue { top: 4px; }
  .lpqr .lpqr-qa-feature__shot--spotlight { bottom: 48px; }
  .lpqr .lpqr-qa-feature__status, .lpqr .lpqr-qa-feature__publish { bottom: 8px; top: auto; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; animation: none; font-weight: 500; font-size: 12px; }
  .lpqr .lpqr-qa-feature__status { left: 0; color: var(--ds-blue); }
  .lpqr .lpqr-qa-feature__publish { right: 0; color: var(--ds-muted); }
  .lpqr .lpqr-qa-feature__cursor { display: none; }
  .lpqr .lpqr-qa-feature__actions a { padding: 14px 24px; border-radius: 12px; background: var(--ds-blue); color: var(--ds-white); font: 500 16px/1.2 var(--font-body); box-shadow: var(--ds-shadow-btn); }
  .lpqr .lpqr-qa-feature__actions a:hover { transform: none; background: var(--ds-blue-hover); }
  .lpqr .lpqr-qa-feature__actions a:last-child { border: 1px solid var(--ds-line); background: var(--ds-glass-fill); color: var(--ds-ink); box-shadow: none; }

  /* Feedback: pastel stages stay, chips become captions under the screenshot */
  .lpqr .lpqr-feedback-bento__grid { border-radius: var(--ds-r-xl); }
  .lpqr .lpqr-feedback-bento__stage { display: flex; flex-direction: column; gap: 10px; }
  .lpqr .lpqr-feedback-bento__stage img { border-radius: var(--ds-r-md); box-shadow: var(--ds-shadow-shot); animation: none; }
  .lpqr .lpqr-feedback-bento__float { position: static; flex-direction: row; align-items: baseline; gap: 8px; padding: 0 2px; border: 0; border-radius: 0; background: none; box-shadow: none; animation: none; color: var(--ds-ink-2); }
  .lpqr .lpqr-feedback-bento__float b { font-size: 12px; font-weight: 500; }
  .lpqr .lpqr-feedback-bento__float small { display: inline; font-size: 12px; }
  .lpqr .lpqr-feedback-bento__float i { align-self: center; flex: none; }
  .lpqr .lpqr-feedback-bento__float--top { flex-direction: row; order: 2; }
  .lpqr .lpqr-feedback-bento__float--bottom { order: 3; }

  /* Live control steps */
  .lpqr .lpqr-live-flow__step { border-radius: var(--ds-r-xl); }
  .lpqr .lpqr-live-flow__step[open] .lpqr-live-flow__title { font-weight: 500; }

  /* Connected cards: opaque night so the stack never shows through */
  .lpqr .lpqr-connected-shell { background: var(--ds-night); animation: none; }
  .lpqr .lpqr-connected__header::before { background: linear-gradient(180deg, var(--ds-night) 0%, var(--ds-night) 72%, transparent 100%); }
  .lpqr .lpqr-connected__card, .lpqr .lpqr-connected__card:first-child { background: var(--ds-night-bg); border-radius: var(--ds-r-xl); border-color: var(--ds-glass-dark-edge); }
  .lpqr .lpqr-connected__image { border-color: var(--ds-glass-dark-edge); background: var(--ds-glass-dark-fill); }
  .lpqr .lpqr-connected__image img { animation: none; }
  .lpqr .lpqr-connected__header h2 em { color: transparent; font-style: normal; }

  /* Formats on the stage, panel as glass, caption under the screenshot */
  .lpqr .lpqr-formats { background: var(--ds-g4-stage); }
  .lpqr .lpqr-format-tabs { background: var(--ds-glass-fill); border-color: var(--ds-glass-edge); }
  .lpqr .lpqr-format-tab { font-weight: 500; }
  .lpqr .lpqr-format-panel { border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .lpqr .lpqr-format-panel__showcase { display: flex; flex-direction: column; gap: 12px; border: 0; border-radius: 0; background: none; box-shadow: none; padding: 0; }
  .lpqr .lpqr-format-panel__showcase::before { display: none; }
  .lpqr .lpqr-format-panel__showcase > img { border-radius: var(--ds-r-md); box-shadow: var(--ds-shadow-shot); }
  .lpqr .lpqr-format-panel__showcase > span { position: static; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; color: var(--ds-blue); font-weight: 500; font-size: 12px; }

  .lpqr .lpqr-faq { background: var(--ds-white); }
  .lpqr .lpqr-faq__item { border-radius: var(--ds-r-lg); }

  @media (max-width: 760px) {
    .lpqr .lpqr-participation__composite { height: 321px; }
    .lpqr .lpqr-qa-feature__visual { height: 330px; }
    .lpqr .lpqr-qa-feature__inner { padding: 28px 20px; }
  }
</style>
