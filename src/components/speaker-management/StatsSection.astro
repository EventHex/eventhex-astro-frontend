---
const stats = [
  { value: "500+", label: "Events Run on EventHex" },
  { value: "2,000+", label: "Speakers Managed" },
  { value: "15+", label: "Countries" },
  { value: "90%", label: "Less Data Entry" },
];

---

<section class="sms-reference" aria-label="Speaker management features">
  <div class="sms-trust ds-glass" aria-label="Speaker management results">
    <div class="sms-trust__inner">
      <span class="sms-trust__label">Trusted By Event Teams</span>
      {stats.map((stat) => (
        <span class="sms-trust__stat"><b>{stat.value}</b> {stat.label}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .sms-reference {
    width: 100%;
    background: transparent;
    color: var(--ds-ink);
    padding: 0 var(--ds-gutter);
    box-sizing: border-box;
  }

  /* glass band overlapping the hero stage, like Event Registration */
  .sms-trust {
    position: relative;
    z-index: 1;
    max-width: var(--ds-container);
    margin: -56px auto 0;
    box-sizing: border-box;
  }

  .sms-trust__inner {
    min-height: 78px;
    padding: 18px 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 36px;
  }

  .sms-trust__label,
  .sms-trust__stat {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ds-muted);
    text-align: center;
  }

  .sms-trust__label {
    color: var(--ds-label);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .sms-trust__stat b {
    color: var(--ds-ink);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .sms-trust__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 28px;
      padding: 22px 24px;
    }
    .sms-trust__label { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {
    .sms-trust { margin-top: -40px; }
  }
</style>
