---
const stats = [
  { value: "500+", label: "Events Run on EventHex" },
  { value: "2,000+", label: "Speakers Managed" },
  { value: "15+", label: "Countries" },
  { value: "90%", label: "Less Data Entry" },
];

---

<section class="sms-reference" aria-label="Speaker management features">
  <div class="sms-trust" aria-label="Speaker management results">
    <div class="sms-trust__inner">
      <span class="sms-trust__label">Trusted By Event Teams</span>
      {stats.map((stat) => (
        <span class="sms-trust__stat"><b>{stat.value}</b> {stat.label}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .sms-reference {
    width: 100%;
    background: transparent;
    color: #22272f;
    padding-bottom: 0;
  }

  .sms-trust {
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
    background: transparent;
  }

  .sms-trust__inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 36px;
  }

  .sms-trust__label,
  .sms-trust__stat {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: #596579;
    text-align: center;
  }

  .sms-trust__label {
    color: #7f8898;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .sms-trust__stat b {
    color: #22272f;
    font-weight: 750;
  }

  @media (max-width: 1024px) {
    .sms-trust__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 28px;
      padding: 22px 0;
    }
    .sms-trust__label { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {
    .sms-trust__inner { width: min(100% - 32px, 1240px); }
  }
</style>
