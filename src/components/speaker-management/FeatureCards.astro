---
// Stacking Cards section — matches home-new/AISection.astro pattern
// Dark bg with bg-2.webp, sticky stacking cards for key features
// Content sourced from: SpeakerProfiles, SessionScheduling, AudienceInteraction, InstaRecap

interface FeatureCard {
  eyebrow?: string;
  title: string;
  desc: string;
  image: string;
  alt: string;
  animated: boolean;
  width: number;
  height: number;
}

const featureCards: FeatureCard[] = [
  {
    eyebrow: "One connected workflow",
    title: "The lineup changes. Everything downstream has to keep up.",
    desc: "A keynote moves to a different stage. A panellist drops out two days before. A workshop fills up. EventHex keeps the speaker record, the session, the published agenda, and the attendee's phone as one connected thing — change it once and everywhere it appears updates with it.",
    image: "/feature-images/speaker-management/session-timeline-v2.svg",
    alt: "EventHex connected speaker and agenda workflow",
    animated: true,
    width: 701,
    height: 729,
  },
  {
    title: "Set up the lineup",
    desc: "Keep rich speaker profiles with name, bio, designation, company, photo and social links, then use AI LinkedIn autofill to fill details from a profile URL. Add categories, speaker settings, badges, delivery logs and bulk operations from one place.",
    image: "/feature-images/speaker-management/speaker-dashboard-v2.svg",
    alt: "EventHex Speaker Dashboard with AI LinkedIn Import",
    animated: true,
    width: 669,
    height: 705,
  },
  {
    title: "Build the agenda",
    desc: "See every session on a colour-coded grid by day and stage, drag sessions into new slots, nest breakouts under parent sessions, assign moderator and panellist roles, and restrict sessions to specific ticket types when needed.",
    image: "/feature-images/speaker-management/session-timeline-v2.svg",
    alt: "EventHex Session Timeline View with Multi-Stage Scheduling",
    animated: true,
    width: 701,
    height: 729,
  },
  {
    title: "Your attendees get the agenda in their pocket — signal or not",
    desc: "The schedule and speaker list stay cached in the attendee mobile app, so they keep working when the venue wifi does not. Attendees save the sessions they want and get a reminder by push and WhatsApp before each one starts. Live transcription and translation run during the talk, while live polls and Q&A open from a QR code with no app or account required.",
    image: "/feature-images/speaker-management/live-engagement-v2.svg",
    alt: "EventHex Live Engagement Tools with Polls and Q&A",
    animated: true,
    width: 606,
    height: 765,
  },
  {
    title: "Speakers leave with something to post",
    desc: "After a session, AI session recap turns the recording into a summary with key takeaways, drafts a LinkedIn and an X post, and generates a shareable poster. Send it to your speakers and they promote the event for you while it is still fresh. Recordings can come from a live capture, an uploaded file, or a YouTube link.",
    image: "/feature-images/speaker-management/instarecap-v2.svg",
    alt: "EventHex InstaRecap AI Transcription and Summary Dashboard",
    animated: true,
    width: 603,
    height: 746,
  },
];
---

<section class="smf-shell">
  <div class="smf-section">
    <!-- Header -->
    <div class="smf-header">
      <div class="smf-eyebrow">
        <span class="smf-eyebrow-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>
        </span>
        <span class="smf-subtitle">From setup to session recap</span>
      </div>
      <h2 class="smf-title">
        Speaker workflows that keep the <span class="smf-highlight">agenda</span
        ><br />& audience connected
      </h2>
    </div>

    <!-- Stacking Cards -->
    <div class="smf-cards" id="smf-stacking-cards">
      {
        featureCards.map((card, i) => (
          <div
            class="smf-card"
            data-card-index={i}
            style={`--card-index: ${i};`}
          >
            <div class="smf-card-content">
              {card.eyebrow && <span class="smf-card-eyebrow">{card.eyebrow}</span>}
              <h2 class="smf-card-title">{card.title}</h2>
              <p class="smf-card-desc">{card.desc}</p>
              <a href="/book-a-demo/" class="smf-card-btn">
                Explore More
              </a>
            </div>
            <div
              class:list={[
                "smf-card-image",
                card.animated && "smf-card-image--animated",
              ]}
            >
              <img
                src={card.image}
                alt={card.alt}
                width={card.width}
                height={card.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        ))
      }
      <div class="smf-stack-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style is:global>
  .smf-shell {
    width: 100%;
    background-color: #000;
    background-image:
      linear-gradient(180deg, #0d0a2c 0%, transparent 320px),
      radial-gradient(circle at 12% 30%, rgba(70, 130, 255, 0.28) 0%, transparent 55%);
    background-repeat: no-repeat;
    background-size: 100% 100%, 120% 120%;
    animation: smf-mesh-move 30s linear infinite;
  }

  @keyframes smf-mesh-move {
    0%, 100% { background-position: 0 0, 0% 0%; }
    50% { background-position: 0 0, 8% 10%; }
  }

  .smf-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4px 0 30px;
  }

  .smf-header {
    position: sticky;
    top: 69px;
    z-index: 20;
    isolation: isolate;
    width: 82%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 24px 0;
  }
  .smf-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -1px;
    bottom: -28px;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(13, 10, 44, 0.99) 0%,
      rgba(7, 11, 27, 0.98) 72%,
      rgba(7, 11, 27, 0) 100%
    );
  }
  .smf-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 6px 16px -6px rgba(0, 0, 0, 0.35);
  }
  .smf-eyebrow-icon {
    display: flex;
    width: 16px;
    height: 16px;
  }
  .smf-eyebrow-icon svg {
    width: 100%;
    height: 100%;
  }
  .smf-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.48px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    margin: 0;
  }
  .smf-title {
    font-family: var(--font-heading);
    font-size: 46px;
    font-weight: 500;
    color: #fff;
    margin: 0;
    line-height: 1.15;
  }
  .smf-highlight {
    color: #afa3ff;
  }

  /* Stacking cards — sticky scroll */
  .smf-cards {
    --smf-stack-top: 300px;
    width: 100%;
    padding: 80px 0 50px;
    position: relative;
  }
  .smf-stack-spacer { height: 190px; }
  .smf-card {
    position: sticky;
    top: calc(var(--smf-stack-top) + var(--card-index) * 20px);
    z-index: var(--card-index);
    display: flex;
    align-items: stretch;
    background:
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255, 255, 255, 0.16) 0%, transparent 70%),
      radial-gradient(circle at 12% 8%, rgba(90, 130, 255, 0.18) 0%, transparent 40%),
      #0a0a0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    height: 500px;
    margin-bottom: 60px;
    box-shadow: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .smf-card-content {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
    gap: 16px;
  }
  .smf-card-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 500;
    color: #e7e4fa;
    margin: 0;
    line-height: 1.2;
  }
  .smf-card-eyebrow {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-bottom: 2px;
    padding: 7px 13px;
    border: 1px solid rgba(175, 163, 255, .28);
    border-radius: 999px;
    background: rgba(175, 163, 255, .1);
    color: #afa3ff;
    font: 600 12px/1.2 var(--font-body);
    letter-spacing: .02em;
  }
  .smf-card:first-child {
    background:
      radial-gradient(circle at 82% 12%, rgba(109, 92, 235, .24), transparent 34%),
      radial-gradient(circle at 8% 92%, rgba(66, 173, 218, .13), transparent 28%),
      #090a10;
  }
  .smf-card:first-child .smf-card-title span { color: #afa3ff; }
  .smf-card-desc {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    line-height: 1.65;
  }
  .smf-card-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 12px 26px;
    text-decoration: none;
    transition:
      transform 0.3s,
      background 0.3s;
    margin-top: 8px;
  }
  .smf-card-btn:hover {
    transform: scale(1.05);
    background: rgba(255, 255, 255, 0.1);
  }
  .smf-card-image {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    margin: 16px 16px 16px 0;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .smf-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: high-quality;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  /* Subtle float animation for featured card image */
  .smf-card-image--animated img {
    animation: smf-float 4s ease-in-out infinite;
  }
  @keyframes smf-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 1024px) {
    .smf-section {
      padding: 20px 20px 30px;
    }
    .smf-header {
      width: 94%;
    }
    .smf-subtitle {
      font-size: 15px;
    }
    .smf-title {
      font-size: 40px;
      line-height: 1em;
    }
    .smf-cards { --smf-stack-top: 292px; }
    .smf-card {
      height: 450px;
    }
    .smf-card-content {
      flex-basis: 50%;
    }
    .smf-card-title {
      font-size: 28px;
    }
    .smf-card-desc {
      font-size: 16px;
    }
  }

  @media (max-width: 767px) {
    .smf-section {
      padding: 16px 20px 30px;
    }
    .smf-header {
      width: 100%;
    }
    .smf-title {
      font-size: 30px;
    }
    .smf-cards { --smf-stack-top: 320px; padding-top: 80px; }
    .smf-card {
      flex-direction: column;
      height: 520px;
    }
    .smf-card-content {
      flex: 0 0 50%;
      padding: 20px 20px 0;
    }
    .smf-card-image {
      margin: 12px;
      padding: 16px;
    }
    .smf-card-title {
      font-size: 24px;
    }
    .smf-card-desc {
      font-size: 15px;
    }
    .smf-cards {
      padding-bottom: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smf-shell, .smf-card-image--animated img { animation: none; }
  }
</style>
