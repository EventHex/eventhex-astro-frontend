---
import SharedFaq from "../shared/FaqSection.astro";

const faqs = [
  { q: "Does EventHex handle automated speaker communication?", a: "Yes. Each speaker gets a confirmation email from a template you control, with their badge attached if you want it. You can resend to one speaker or all of them at once, and a delivery log shows what was opened, bounced or failed. Attendees separately get push and WhatsApp reminders before sessions they saved." },
  { q: "Can I manage speaker bios and session information together?", a: "Yes. A speaker's bio, photo, company, designation and social links live on their profile, and assigning them to a session links the two — so their profile page on your event website lists every session they are speaking at, and each session lists its speakers." },
  { q: "How does EventHex handle panel coordination?", a: "Assign several speakers to one session and give each a role — moderator, panellist, or a label you create. Roles show on the agenda and on speaker profiles, so attendees know who is running the discussion." },
  { q: "Can I run multiple tracks and stages?", a: "Yes. Create as many stages as you need and schedule sessions in parallel across them. The timeline shows every stage side by side per day, breakouts nest under a parent session, and attendees can filter the agenda by stage or track. Note that EventHex does not currently block you from double-booking a speaker — the timeline shows overlaps, but it will let you save one." },
  { q: "What happens when a session time or room changes?", a: "Change it once. The event website and the attendee app update, and you can send a notification describing the change. That notification goes to everyone registered for the event rather than only the people who saved that session." },
  { q: "Do attendees need to download an app?", a: "Not to take part. Polls and Q&A open from a QR code with no app and no account. The mobile app adds a saved agenda, offline access, reminders and session recaps for attendees who want it." },
  { q: "What do speakers get afterwards?", a: "A summary of their session with key takeaways, a drafted LinkedIn and X post, and a shareable poster. Sessions can also be transcribed and translated for attendees who were not in the room." },
  { q: "Can I collect and review talk submissions?", a: "Yes. Publish a call for papers with your own topics and submission form, assign reviewers, score against a rubric, and push accepted abstracts straight into the program as sessions." },
];
---

<SharedFaq
  faqs={faqs}
  eyebrow="Need a custom setup?"
  title="Frequently Asked Questions"
  description="We help event teams shape speaker onboarding, approvals, reminder flows, and live engagement around how their conference operations actually run."
/>
