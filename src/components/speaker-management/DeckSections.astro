---
interface Props {
  section: "problem" | "ai" | "use-cases";
}

const { section } = Astro.props;

const useCasesTabs = [
  {
    id: "multi-track",
    label: "Multi-track conferences",
    title: "Coordinate complex agendas, faster",
    description: "Manage complex schedules, multiple stages, and thousands of attendees in one unified workspace.",
    checklist: [
      "Visual timeline builder",
      "Drag-and-drop rescheduling",
      "Instant conflict detection"
    ],
    image: "/feature-images/speaker-management/use-case-multi-track.jpg",
    imageAlt: "EventHex visual timeline for a multi-day event program",
    visualLabel: "Multi-track timeline"
  },
  {
    id: "panel-heavy",
    label: "Panel-heavy summits",
    title: "Manage moderators and panellists",
    description: "Per-session roles so moderators and panellists are labelled correctly everywhere they appear.",
    checklist: [
      "Assign granular session roles",
      "Automated speaker communications",
      "Real-time panel balancing"
    ],
    image: "/feature-images/speaker-management/use-case-panel-speakers.jpg",
    imageAlt: "EventHex session workspace showing keynote, respondent, and speaker roles",
    visualLabel: "Speaker roles mapped"
  },
  {
    id: "academic",
    label: "Academic conferences",
    title: "From submission to publication",
    description: "Abstract collection, reviewer rubrics and accepted papers pushed directly into the program.",
    checklist: [
      "Custom scoring rubrics",
      "Blind peer review workflows",
      "One-click acceptance to agenda"
    ],
    image: "/feature-images/speaker-management/cfp-portal-rubric.jpg",
    imageAlt: "EventHex research-paper scoring rubric for reviewers",
    visualLabel: "Review rubric ready"
  },
  {
    id: "recurring",
    label: "Recurring events",
    title: "Intelligence from past events",
    description: "Returning attendees get session recommendations based on what they attended last time.",
    checklist: [
      "Historical attendance tracking",
      "Smart session recommendations",
      "Persistent speaker profiles"
    ],
    image: "/feature-images/speaker-management/use-case-recurring-event.jpg",
    imageAlt: "EventHex recurring event and previous-edition setup",
    visualLabel: "Previous edition linked"
  }
];
---

{section === "problem" && (
  <section class="smd-problem" aria-label="The speaker management problem">
    <div class="smd-problem__inner">
      <div class="smd-problem__content">
      <span class="smd-problem__eyebrow animate-on-scroll" data-animation="fadeIn">One connected workflow</span>
      <h2 class="smd-problem__lead animate-on-scroll" data-animation="fadeInUp">
        The lineup changes. <span>Everything downstream has to keep up.</span>
      </h2>
      <div class="smd-problem__copy animate-on-scroll" data-animation="fadeInUp">
        <p>A keynote moves to a different stage. A panellist drops out two days before. A workshop fills up. In most teams that means a spreadsheet, a WhatsApp group, a re-export of the agenda, and an email nobody opens.</p>
        <p>EventHex keeps the speaker record, the session, the published agenda, and the attendee's phone as one connected thing — change it once and everywhere it appears updates with it.</p>
      </div>
      </div>
      <div class="smd-problem__visual animate-on-scroll" data-animation="fadeInUp" aria-label="EventHex connected speaker and agenda workflow">
        <div class="smd-problem__orb smd-problem__orb--one"></div>
        <div class="smd-problem__orb smd-problem__orb--two"></div>
        <div class="smd-problem__screen"><img src="/feature-images/speaker-management/session-timeline-v2.svg" alt="EventHex agenda timeline updating with speaker changes" loading="lazy" decoding="async" /></div>
        <div class="smd-problem__float"><img src="/feature-images/speaker-management/hero-mobile-speakers.png" alt="EventHex mobile speaker directory" loading="lazy" decoding="async" /></div>
        <div class="smd-problem__status smd-problem__status--top"><i></i><span>Speaker updated</span><strong>Live</strong></div>
        <div class="smd-problem__status smd-problem__status--bottom"><i></i><span>Agenda synced</span><strong>Everywhere</strong></div>
      </div>
    </div>
  </section>
)}

{section === "ai" && (
  <section class="smd-ai" aria-labelledby="smd-ai-title">
    <div class="smd-ai__inner">
      <div class="smd-ai__left">
        <h2 id="smd-ai-title" class="smd-ai__title animate-on-scroll" data-animation="fadeInUp">
          <span class="smd-ai__title-line">describe the agenda</span>
          <span class="smd-ai__title-line">and EventHex builds it</span>
        </h2>
        <p class="smd-ai__copy animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 100ms">
          Tell the EventHex assistant who is speaking and when, and it creates the speakers, creates the sessions, and assigns each speaker to the right slot. You can do it inside EventHex, or from ChatGPT and Claude through the EventHex Copilot connector — useful when the schedule arrives as a document and you would rather not retype it. Review what it proposes before anything is saved.
        </p>

        <div class="smd-ai__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 200ms">
          <a href="/book-a-demo/" class="smd-ai__btn smd-ai__btn--dark">Get Started Free &rarr;</a>
          <a href="/ai-event-copilot/" class="smd-ai__btn smd-ai__btn--light">Explore Solution &rarr;</a>
        </div>
      </div>

      <div class="smd-ai__right animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 300ms">
        <div class="smd-ai__showcase" role="img" aria-label="EventHex agenda list and session builder working together">
          <div class="smd-ai__shot smd-ai__shot--list">
            <img src="/feature-images/speaker-management/ai-agenda-list.jpg" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="smd-ai__shot smd-ai__shot--builder">
            <img src="/feature-images/speaker-management/ai-session-builder.jpg" alt="" loading="lazy" decoding="async" />
          </div>

          <span class="smd-ai__status">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
            Agenda generated
          </span>
          <span class="smd-ai__publish">Review &amp; publish</span>
          <svg class="smd-ai__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
        </div>
      </div>
    </div>
  </section>
)}

{section === "use-cases" && (
  <>
    <section class="smd-agent-suites" aria-labelledby="smd-agent-title">
      <div class="smd-agent-suites__inner">
        <header class="smd-agent__header">
          <h2 id="smd-agent-title" class="smd-agent__title animate-on-scroll" data-animation="fadeInUp">
            <span class="smd-agent__title-line">Built for the events that</span>
            <span class="smd-agent__title-line">are hardest to coordinate</span>
          </h2>
          <p class="smd-agent__subtitle animate-on-scroll" data-animation="fadeInUp">
            Manage complex schedules, multiple stages, and thousands of attendees in one unified workspace.
          </p>
        </header>

        <div class="smd-agent__tabs animate-on-scroll" data-animation="fadeInUp" role="tablist">
          {useCasesTabs.map((tab, index) => (
            <button 
              class={`smd-agent__tab ${index === 0 ? 'smd-agent__tab--active' : ''}`}
              role="tab" 
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              data-target={tab.id}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <div class="smd-agent__box animate-on-scroll" data-animation="fadeInUp">
          {useCasesTabs.map((tab, index) => (
            <div 
              class={`smd-agent__panel ${index === 0 ? 'smd-agent__panel--active' : ''}`}
              id={`panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${tab.id}`}
              data-panel={tab.id}
            >
              <div class="smd-agent__left">
                <h3
                  class="smd-agent__panel-title"
                  set:html={tab.id === "multi-track"
                    ? "Coordinate complex<br/>agendas, faster"
                    : tab.title}
                />
                <p class="smd-agent__panel-desc">{tab.description}</p>
                
                <div class="smd-agent__replaces">
                  <span class="smd-agent__replaces-label">REPLACES</span>
                  <span class="smd-agent__replaces-icons">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                  </span>
                </div>

                <ul class="smd-agent__checklist">
                  {tab.checklist.map(item => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="smd-agent__right">
                <div class="smd-agent__showcase">
                  <img src={tab.image} alt={tab.imageAlt} loading="lazy" decoding="async" />
                  <span class:list={["smd-agent__visual-label", `smd-agent__visual-label--${tab.id}`]}>
                    {tab.id === "multi-track" && (
                      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="13" rx="2"></rect><path d="M2.5 8h15M7.5 8v8.5M12.5 8v8.5"></path></svg>
                    )}
                    {tab.id === "panel-heavy" && (
                      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="7" cy="7" r="2.5"></circle><circle cx="14" cy="8" r="2"></circle><path d="M2.5 16c.4-3 2-4.5 4.5-4.5s4.1 1.5 4.5 4.5M11.5 12.5c.7-.8 1.5-1.2 2.6-1.2 2 0 3.1 1.4 3.4 3.8"></path></svg>
                    )}
                    {tab.id === "academic" && (
                      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="3" width="12" height="14" rx="2"></rect><path d="M7 7h6M7 10h4M7 13l1.5 1.5L12 11"></path></svg>
                    )}
                    {tab.id === "recurring" && (
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.1 6.8A6.5 6.5 0 1 1 3.5 12"></path><path d="M4 3.5v3.8h3.8M10 6.5v4l2.7 1.6"></path></svg>
                    )}
                    {tab.visualLabel}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const suite = document.querySelector('.smd-agent-suites');
        if (!suite) return;

        const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>('.smd-agent__tab'));
        const panels = Array.from(suite.querySelectorAll<HTMLElement>('.smd-agent__panel'));
        let rotationId: number | undefined;

        const activateTab = (tab: HTMLButtonElement) => {
          const targetId = tab.getAttribute('data-target');

          tabs.forEach(item => {
            item.classList.remove('smd-agent__tab--active');
            item.setAttribute('aria-selected', 'false');
          });

          panels.forEach(panel => {
            panel.classList.remove('smd-agent__panel--active');
          });

          tab.classList.add('smd-agent__tab--active');
          tab.setAttribute('aria-selected', 'true');
          const activePanel = suite.querySelector<HTMLElement>(`#panel-${targetId}`);
          activePanel?.classList.add('smd-agent__panel--active');
        };

        const stopRotation = () => {
          if (rotationId === undefined) return;
          window.clearInterval(rotationId);
          rotationId = undefined;
        };

        const startRotation = () => {
          stopRotation();
          if (tabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          rotationId = window.setInterval(() => {
            const currentIndex = tabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true');
            activateTab(tabs[(currentIndex + 1) % tabs.length]);
          }, 4000);
        };

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            activateTab(tab);
            startRotation();
          });
        });

        suite.addEventListener('mouseenter', stopRotation);
        suite.addEventListener('mouseleave', startRotation);
        suite.addEventListener('focusin', stopRotation);
        suite.addEventListener('focusout', event => {
          if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) {
            startRotation();
          }
        });
        document.addEventListener('visibilitychange', () => {
          document.hidden ? stopRotation() : startRotation();
        });

        startRotation();
      });
    </script>
  </>
)}

<style>
  .smd-problem,
  .smd-ai,
  .smd-use { background: transparent; color: #22272f; }
  .smd-problem { padding: 112px 24px; }
  .smd-problem__inner {
    width: min(1120px, 100%); margin: 0 auto; display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(48px, 8vw, 112px); align-items: start;
  }
  .smd-problem__lead,
  .smd-ai__title,
  .smd-use__title {
    margin: 0; font-family: var(--font-heading); font-size: clamp(42px, 5vw, 64px);
    font-weight: 650; line-height: 1.05; letter-spacing: -.045em;
  }
  .smd-problem__lead span,
  .smd-ai__title span,
  .smd-use__title span { color: #a3aab8; }
  .smd-problem__copy { padding-top: 8px; }
  .smd-problem__copy p,
  .smd-ai__copy,
  .smd-use__item p { font-family: var(--font-body); color: #596579; line-height: 1.7; }
  .smd-problem__copy p { margin: 0 0 22px; font-size: 18px; }

  .smd-ai { padding: 48px 24px; display: flex; justify-content: center; background: transparent; }
  .smd-ai__inner {
    width: min(1120px, 100%); padding: 48px 48px;
    border: none;
    background: transparent;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 36px;
    align-items: center;
  }
  .smd-ai__left { min-width: 0; max-width: 560px; }
  .smd-ai__title {
    margin: 0; font-family: var(--font-heading); font-size: clamp(32px, 3.5vw, 42px);
    font-weight: 650; line-height: 1.1; letter-spacing: -.03em;
    display: flex; flex-direction: column;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .smd-ai__title strong { margin-bottom: -4px; font-weight: inherit; }
  .smd-ai__title span { font-weight: 500; font-size: 0.95em; }
  .smd-ai__title-line { display: block; white-space: nowrap; }
  
  .smd-ai__copy { margin: 16px 0 32px; font-size: 15px; color: #374151; line-height: 1.5; font-weight: 500; }
  
  .smd-ai__right {
    width: 100%; max-width: 500px; justify-self: end;
  }
  .smd-ai__showcase {
    position: relative; isolation: isolate; width: 100%; height: clamp(320px, 32vw, 350px);
    overflow: hidden; border: 1px solid rgba(255, 255, 255, .9); border-radius: 24px;
    background: linear-gradient(155deg, #fff8dc 0%, #fffdf4 48%, #ffffff 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .55);
  }
  .smd-ai__showcase::before {
    content: ""; position: absolute; inset: auto 6% -24% 10%; z-index: -1;
    height: 65%; border-radius: 50%; background: rgba(230, 232, 238, .72); filter: blur(24px);
  }
  .smd-ai__shot {
    position: absolute; overflow: hidden; aspect-ratio: 1117 / 837;
    border: 1px solid #e0e4ec; border-radius: 12px;
    background: #fff; box-shadow: 0 14px 30px rgba(17, 24, 39, .14);
  }
  .smd-ai__shot img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .smd-ai__shot--list { top: 30px; left: 20px; width: 77%; z-index: 1; }
  .smd-ai__shot--builder { right: 18px; bottom: 24px; width: 70%; z-index: 2; }
  .smd-ai__status,
  .smd-ai__publish {
    position: absolute; z-index: 5; display: inline-flex; align-items: center;
    border-radius: 11px; font-family: var(--font-body); font-size: 13px; font-weight: 700;
    box-shadow: 0 8px 22px rgba(42, 66, 158, .18);
  }
  .smd-ai__status {
    top: 16px; left: 16px; gap: 8px; padding: 11px 15px;
    border: 1px solid #dce4ff; background: #f0f4ff; color: #4163ed;
  }
  .smd-ai__status svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; }
  .smd-ai__publish { right: 16px; bottom: 16px; padding: 12px 16px; background: #4163ed; color: #fff; }
  .smd-ai__cursor {
    position: absolute; right: 20px; bottom: 50px; z-index: 6; width: 23px; height: 27px;
    fill: #182033; stroke: #fff; stroke-width: 1.2; filter: drop-shadow(0 2px 3px rgba(17, 24, 39, .24));
  }
  
  .smd-ai__actions { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
  .smd-ai__btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 20px; border-radius: 6px; font-family: var(--font-body);
    font-size: 13.5px; font-weight: 600; text-decoration: none; transition: all 0.2s ease;
  }
  .smd-ai__btn--dark { background: #27272a; color: #ffffff; }
  .smd-ai__btn--dark:hover { background: #18181b; }
  .smd-ai__btn--light { background: #f3f4f6; color: #374151; border: 1px solid #e5e7eb; }
  .smd-ai__btn--light:hover { background: #e5e7eb; }

  .smd-agent-suites { padding: 112px 24px; background: #fff; }
  .smd-agent-suites__inner { width: min(1080px, 100%); margin: 0 auto; }
  
  .smd-agent__header { text-align: center; margin-bottom: 32px; display: flex; flex-direction: column; align-items: center; }
  .smd-agent__badge {
    color: #6366f1;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-family: monospace;
  }
  .smd-agent__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    max-width: 800px;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .smd-agent__title-line {
    display: block;
  }
  .smd-agent__subtitle {
    font-size: 17.5px;
    color: #6b7280;
    max-width: none;
    margin: 0;
    line-height: 1.5;
    font-weight: 500;
    white-space: nowrap;
  }

  .smd-agent__tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 6px;
    background: #f1f3f7;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    flex-wrap: wrap;
  }
  .smd-agent__tab {
    background: transparent;
    border: 1px solid transparent;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }
  .smd-agent__tab:hover {
    background: rgba(255, 255, 255, 0.65);
    color: #334155;
  }
  .smd-agent__tab--active {
    background: #ffffff !important;
    color: #3b82f6 !important;
    border-color: #dbe4f0 !important;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
  }

  .smd-agent__box {
    background: transparent;
    padding: 0;
    border: none;
    box-shadow: none;
  }

  .smd-agent__panel {
    --smd-panel-tint: #fff8dc;
    --smd-panel-border: #f0dfa6;
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 52px 64px;
    border: 1px solid var(--smd-panel-border);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--smd-panel-tint) 0%, #ffffff 72%);
    animation: agentFadeIn 0.4s ease forwards;
  }
  .smd-agent__panel:nth-child(2) {
    --smd-panel-tint: #edf7ff;
    --smd-panel-border: #d4e7f7;
  }
  .smd-agent__panel:nth-child(3) {
    --smd-panel-tint: #f3efff;
    --smd-panel-border: #e2d8fa;
  }
  .smd-agent__panel:nth-child(4) {
    --smd-panel-tint: #eefbf4;
    --smd-panel-border: #d4efdf;
  }
  @keyframes agentFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .smd-agent__panel--active {
    display: grid;
  }

  .smd-agent__panel-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 42px);
    font-weight: 500;
    color: #1f2937;
    line-height: 1.1;
    margin: 0 0 18px;
    letter-spacing: -0.03em;
  }
  .smd-agent__panel-desc {
    font-size: 16px;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 32px;
    font-weight: 500;
  }

  .smd-agent__replaces {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .smd-agent__replaces-label {
    font-size: 11px;
    font-weight: 700;
    color: #9ca3af;
    letter-spacing: 0.12em;
  }
  .smd-agent__replaces-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #9ca3af;
