  /* ClickUp-inspired Hero Design System for Speaker Setup */
  .smp-clickup-hero {
    padding: clamp(90px, 10vw, 140px) 24px;
    background: #fff;
  }
  .smp-clickup-hero__inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }
  .smp-clickup-hero__header {
    text-align: center;
    margin-bottom: 64px;
  }
  .smp-clickup-hero__header h2 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1.1;
    background: linear-gradient(135deg, #222 0%, #333 40%, #888 100%);
