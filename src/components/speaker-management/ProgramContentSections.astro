    font-size: 9px;
  }
  .smp-agenda__schedule {
    position: relative;
    background-image: repeating-linear-gradient(0deg, transparent 0 42px, rgba(255, 255, 255, .07) 42px 43px);
  }
  .smp-agenda__session {
    position: absolute;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 150px;
    padding: 7px 10px;
    border: 1px solid rgba(92, 138, 255, .28);
    border-radius: 7px;
    background: rgba(92, 138, 255, .08);
  }
  .smp-agenda__session small { color: #a8b6ff; font-size: 9px; }
  .smp-agenda__session strong { font-size: 10px; font-weight: 500; }
  .smp-agenda__session--keynote { top: 12px; width: 78%; }
  .smp-agenda__session--panel { top: 70px; left: 46px; width: 70%; border-color: rgba(164, 92, 255, .3); background: rgba(164, 92, 255, .08); }
  .smp-agenda__session--break { top: 128px; width: 54%; border-style: dashed; opacity: .72; }
  .smp-agenda__now {
    position: absolute;
    left: 4px;
    top: 52px;
    z-index: 2;
    width: calc(100% - 8px);
    height: 1px;
    background: #7d8dff;
  }
  .smp-agenda__now::before {
    content: "";
    position: absolute;
    left: -2px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7d8dff;
  }

  .smp-agenda__tree { padding: 16px 18px; }
  .smp-agenda__tree-root,
  .smp-agenda__tree-branch > div {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .smp-agenda__tree-root > i,
  .smp-agenda__tree-branch > div > i {
    width: 9px;
    height: 9px;
    border: 2px solid #7d8dff;
    border-radius: 50%;
    background: #10111a;
    box-shadow: none;
  }
  .smp-agenda__tree-root span,
  .smp-agenda__tree-branch span { display: flex; flex: 1; align-items: center; justify-content: space-between; gap: 8px; }
  .smp-agenda__tree strong { font-size: 11px; font-weight: 500; }
  .smp-agenda__tree-branch {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 18px 0 0 4px;
    padding-left: 28px;
  }
  .smp-agenda__tree-branch::before {
    content: "";
    position: absolute;
    left: 0;
    top: -11px;
    bottom: 10px;
    width: 18px;
    border-left: 1px solid rgba(125, 141, 255, .38);
    border-bottom: 1px solid rgba(125, 141, 255, .38);
    border-radius: 0 0 0 12px;
  }
  .smp-agenda__tree-branch > div::before {
    content: "";
    position: absolute;
    left: 0;
    width: 22px;
    border-top: 1px solid rgba(125, 141, 255, .38);
  }
  .smp-agenda__tree-branch .is-break > i { border-color: #38bdf8; border-radius: 2px; }

  .smp-agenda__tracks { padding: 13px 14px 10px; }
  .smp-agenda__tracks-head,
  .smp-agenda__tracks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .smp-agenda__tracks-head span { padding-bottom: 9px; color: rgba(255, 255, 255, .42); font-size: 9px; text-align: center; }
  .smp-agenda__tracks-grid { height: 128px; }
  .smp-agenda__tracks-grid > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 6px;
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 8px;
    background-image: repeating-linear-gradient(0deg, transparent 0 31px, rgba(255, 255, 255, .05) 31px 32px);
  }
  .smp-agenda__tracks-grid i { display: block; height: 48px; border-radius: 5px; background: rgba(92, 138, 255, .14); border: 1px solid rgba(92, 138, 255, .28); }
  .smp-agenda__tracks-grid i.is-violet { background: rgba(164, 92, 255, .14); border-color: rgba(164, 92, 255, .28); }
  .smp-agenda__tracks-grid i.is-cyan { background: rgba(56, 189, 248, .12); border-color: rgba(56, 189, 248, .26); }
  .smp-agenda__tracks-grid i.is-short { height: 30px; }
  .smp-agenda__tracks-grid i.is-tall { height: 66px; }
  .smp-agenda__tracks-axis { display: flex; justify-content: space-between; padding-top: 7px; color: rgba(255, 255, 255, .35); font-size: 8px; }

  .smp-agenda__roles,
  .smp-agenda__gate { max-width: 410px; }
  .smp-agenda__roles { overflow: hidden; }
  .smp-agenda__roles svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .smp-agenda__roles path { fill: none; stroke: rgba(125, 141, 255, .28); stroke-width: 1; stroke-dasharray: 4 5; }
  .smp-agenda__role-core {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 116px;
    padding: 12px 16px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(125, 141, 255, .28);
    border-radius: 10px;
    background: #0d0e14;
    box-shadow: none;
    text-align: center;
  }
  .smp-agenda__role-core strong { font-size: 12px; font-weight: 500; }
  .smp-agenda__role { position: absolute; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .smp-agenda__role i { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(125,141,255,.32); border-radius: 50%; background: #171b2a; color: #dce1ff; font-size: 9px; font-style: normal; }
  .smp-agenda__role b { color: rgba(255,255,255,.54); font-size: 8px; font-weight: 500; }
  .smp-agenda__role--one { left: 9%; top: 12%; }
  .smp-agenda__role--two { right: 9%; top: 12%; }
  .smp-agenda__role--two i { border-color: rgba(164,92,255,.32); background: #20172b; }
  .smp-agenda__role--three { left: 50%; bottom: 5%; transform: translateX(-50%); }
  .smp-agenda__role--three i { border-color: rgba(56,189,248,.3); background: #122229; }

  .smp-agenda__gate { display: grid; grid-template-columns: 120px 1fr; grid-template-rows: 1fr auto; align-items: center; gap: 8px 24px; padding: 18px 24px; }
  .smp-agenda__capacity { position: relative; grid-row: 1 / 3; display: grid; place-items: center; width: 110px; height: 110px; border-radius: 50%; background: conic-gradient(#5c8aff 0 52%, #a45cff 52% 70%, rgba(255,255,255,.08) 70%); }
  .smp-agenda__capacity::before { content: ""; position: absolute; width: 82px; height: 82px; border-radius: 50%; background: #090a11; }
  .smp-agenda__capacity span { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 3px; }
  .smp-agenda__capacity strong { font-size: 26px; font-weight: 500; }
  .smp-agenda__capacity small { color: rgba(255,255,255,.4); font-size: 10px; }
  .smp-agenda__gate-copy { display: flex; flex-direction: column; gap: 8px; }
  .smp-agenda__gate-copy strong { font-size: 13px; font-weight: 500; }
  .smp-agenda__passes { display: flex; gap: 7px; }
  .smp-agenda__passes span { padding: 6px 9px; border: 1px solid rgba(255,255,255,.1); border-radius: 6px; color: rgba(255,255,255,.38); font-size: 8px; }
  .smp-agenda__passes span.is-on { border-color: rgba(125,141,255,.5); background: rgba(92,138,255,.12); color: #b9ccff; }

  /* Minimal agenda symbols: one quiet idea per card, without dashboard chrome. */
  .smp-agenda__symbol {
    position: relative;
    width: min(260px, 100%);
    height: 126px;
    color: #7d8dff;
  }
  .smp-agenda__symbol i,
  .smp-agenda__symbol b,
  .smp-agenda__symbol span { position: absolute; display: block; }

  .smp-agenda__symbol--timeline span {
    left: 8%; right: 8%; top: 58%; height: 1px;
    background: rgba(255,255,255,.18);
  }
  .smp-agenda__symbol--timeline i {
    top: calc(58% - 6px); width: 12px; height: 12px;
    border: 1px solid rgba(125,141,255,.55); border-radius: 50%;
    background: #08090d;
  }
  .smp-agenda__symbol--timeline i:nth-of-type(1) { left: 8%; }
  .smp-agenda__symbol--timeline i:nth-of-type(2) { left: calc(50% - 6px); }
  .smp-agenda__symbol--timeline i:nth-of-type(3) { right: 8%; }
  .smp-agenda__symbol--timeline i.is-active {
    width: 18px; height: 18px; top: calc(58% - 9px);
    border-color: #7d8dff; background: #7d8dff;
    box-shadow: 0 0 0 5px rgba(125,141,255,.1);
  }
  .smp-agenda__symbol--timeline b {
    left: calc(50% - 42px); top: 18%; width: 84px; height: 24px;
    border: 1px solid rgba(125,141,255,.32); border-radius: 7px;
    background: rgba(125,141,255,.07);
  }

  .smp-agenda__symbol--branch span {
    left: 16%; right: 16%; bottom: 28%; height: 42%;
    border-top: 1px solid rgba(255,255,255,.16);
    border-left: 1px solid rgba(255,255,255,.16);
    border-right: 1px solid rgba(255,255,255,.16);
    border-radius: 8px 8px 0 0;
  }
  .smp-agenda__symbol--branch i {
    width: 14px; height: 14px; bottom: calc(28% - 7px);
    border: 1px solid rgba(125,141,255,.5); border-radius: 4px;
    background: #08090d;
  }
  .smp-agenda__symbol--branch i:nth-of-type(2) { left: calc(16% - 7px); }
  .smp-agenda__symbol--branch i:nth-of-type(3) { left: calc(50% - 7px); }
  .smp-agenda__symbol--branch i:nth-of-type(4) { right: calc(16% - 7px); }
  .smp-agenda__symbol--branch i.is-root {
    left: calc(50% - 11px); top: 8%; bottom: auto; width: 22px; height: 22px;
    border-radius: 50%; border-color: #7d8dff; background: rgba(125,141,255,.12);
  }
  .smp-agenda__symbol--branch::before {
    content: ""; position: absolute; left: 50%; top: 30%; height: 20%;
    border-left: 1px solid rgba(255,255,255,.16);
  }

  .smp-agenda__symbol--tracks {
    display: flex; align-items: flex-end; justify-content: center; gap: 18px;
  }
  .smp-agenda__symbol--tracks > span {
    position: relative; width: 48px; height: 108px;
    border-left: 1px solid rgba(255,255,255,.12);
    border-right: 1px solid rgba(255,255,255,.12);
  }
  .smp-agenda__symbol--tracks i {
    left: 7px; right: 7px; height: 32px; border-radius: 5px;
    border: 1px solid rgba(125,141,255,.28); background: rgba(125,141,255,.08);
  }
  .smp-agenda__symbol--tracks span i:first-child { top: 8px; }
  .smp-agenda__symbol--tracks span i:last-child { bottom: 8px; }
  .smp-agenda__symbol--tracks span:nth-child(2) i { border-color: rgba(164,92,255,.28); background: rgba(164,92,255,.08); }
  .smp-agenda__symbol--tracks span:nth-child(3) i { border-color: rgba(56,189,248,.25); background: rgba(56,189,248,.07); }

  .smp-agenda__symbol--roles span {
    left: calc(50% - 25px); top: calc(50% - 25px); width: 50px; height: 50px;
    border: 1px solid rgba(125,141,255,.38); border-radius: 12px;
    background: rgba(125,141,255,.07);
  }
  .smp-agenda__symbol--roles i {
    width: 22px; height: 22px; border: 1px solid rgba(255,255,255,.2);
    border-radius: 50%; background: #0c0d12;
  }
  .smp-agenda__symbol--roles i:nth-of-type(1) { left: 10%; top: 12%; }
  .smp-agenda__symbol--roles i:nth-of-type(2) { right: 10%; top: 12%; }
  .smp-agenda__symbol--roles i:nth-of-type(3) { left: calc(50% - 11px); bottom: 2%; }
  .smp-agenda__symbol--roles b {
    inset: 22px 34px 12px; border-bottom: 1px dashed rgba(255,255,255,.14);
    border-left: 1px dashed rgba(255,255,255,.14);
    border-right: 1px dashed rgba(255,255,255,.14);
    border-radius: 0 0 50% 50%;
  }

  .smp-agenda__symbol--gate span {
    left: 24%; top: 14%; width: 88px; height: 88px; border-radius: 50%;
    background: conic-gradient(#7d8dff 0 68%, rgba(255,255,255,.1) 68%);
  }
  .smp-agenda__symbol--gate span::after {
    content: ""; position: absolute; inset: 9px; border-radius: 50%; background: #08090d;
  }
  .smp-agenda__symbol--gate i {
    right: 17%; width: 46px; height: 18px; border-radius: 5px;
    border: 1px solid rgba(125,141,255,.3); background: rgba(125,141,255,.06);
  }
  .smp-agenda__symbol--gate i:nth-of-type(1) { top: 34%; }
  .smp-agenda__symbol--gate i:nth-of-type(2) { top: 58%; opacity: .55; }
  .smp-agenda__symbol--gate b {
    left: calc(24% + 37px); top: calc(14% + 37px); width: 14px; height: 14px;
    border-radius: 50%; background: #7d8dff; z-index: 1;
  }

  /* Realistic product panels inspired by the supplied tabbed UI reference. */
  .smp-agenda__product {
    position: relative;
    width: 100%;
    max-width: 310px;
    height: 220px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 14px 14px 0 0;
    background: linear-gradient(145deg, #111218, #090a0e 65%);
    box-shadow: 0 18px 42px rgba(0,0,0,.22);
    color: rgba(255,255,255,.78);
    font-family: var(--font-body);
  }
  .smp-agenda__product::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, #38bdf8, #7c6cff 55%, #d85aa8);
  }
  .smp-agenda__product--wide { max-width: 430px; }
  .smp-agenda__product-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 0 13px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
  }
  .smp-agenda__product-bar > span { display: flex; gap: 5px; }
  .smp-agenda__product-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,.13);
  }
  .smp-agenda__product-bar small { color: rgba(255,255,255,.42); font-size: 9px; }
  .smp-agenda__product-tabs {
    display: flex;
    gap: 5px;
    padding: 9px 11px 8px;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }
  .smp-agenda__product-tabs span {
    padding: 5px 9px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: rgba(255,255,255,.38);
    font-size: 8px;
  }
  .smp-agenda__product-tabs span.is-active {
    border-color: rgba(125,141,255,.28);
    background: rgba(125,141,255,.1);
    color: #c5ccff;
  }
  .smp-agenda__schedule-list { padding: 7px 11px; }
  .smp-agenda__schedule-list > div {
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    padding: 5px 7px;
    border-bottom: 1px solid rgba(255,255,255,.065);
  }
  .smp-agenda__schedule-list > div.is-accent {
    border: 1px solid rgba(125,141,255,.22);
    border-radius: 7px;
    background: linear-gradient(90deg, rgba(92,138,255,.1), rgba(164,92,255,.06));
  }
  .smp-agenda__schedule-list time { color: #a8b6ff; font-size: 9px; }
  .smp-agenda__schedule-list span,
  .smp-agenda__outline span,
  .smp-agenda__people span,
  .smp-agenda__access-list span { display: flex; flex-direction: column; gap: 3px; }
  .smp-agenda__schedule-list strong,
  .smp-agenda__outline strong,
  .smp-agenda__people strong,
  .smp-agenda__access-list strong { font-size: 9px; font-weight: 500; }
  .smp-agenda__schedule-list small,
  .smp-agenda__outline small,
  .smp-agenda__people small,
  .smp-agenda__access-list small { color: rgba(255,255,255,.34); font-size: 7.5px; }

  .smp-agenda__outline { padding: 10px 14px; }
  .smp-agenda__outline > div {
    position: relative;
    display: grid;
    grid-template-columns: 10px 1fr auto;
    align-items: center;
    gap: 8px;
    min-height: 31px;
  }
  .smp-agenda__outline > div > i {
    width: 8px;
    height: 8px;
    border: 1px solid #7d8dff;
    border-radius: 50%;
  }
  .smp-agenda__outline > div > small { letter-spacing: .04em; text-transform: uppercase; }
  .smp-agenda__outline > div.is-child { padding-left: 24px; }
  .smp-agenda__outline > div.is-child::before {
    content: "";
    position: absolute;
    left: 4px;
    top: -6px;
    width: 15px;
    height: 22px;
    border-left: 1px solid rgba(255,255,255,.13);
    border-bottom: 1px solid rgba(255,255,255,.13);
    border-radius: 0 0 0 5px;
  }
  .smp-agenda__outline > div.is-break > i { border-radius: 2px; border-color: #38bdf8; }

  .smp-agenda__stage-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
    height: 142px;
    padding: 9px 11px 12px;
  }
  .smp-agenda__stage-board > span {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 6px;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 7px;
    background: rgba(255,255,255,.018);
  }
  .smp-agenda__stage-board i {
    display: block;
    height: 45px;
    border: 1px solid rgba(92,138,255,.25);
    border-radius: 5px;
    background: rgba(92,138,255,.09);
  }
  .smp-agenda__stage-board span:nth-child(2) i { border-color: rgba(164,92,255,.25); background: rgba(164,92,255,.09); }
  .smp-agenda__stage-board span:nth-child(3) i { border-color: rgba(56,189,248,.22); background: rgba(56,189,248,.07); }
  .smp-agenda__stage-board span i:last-child { height: 57px; }

  .smp-agenda__people,
  .smp-agenda__access-list { padding: 8px 13px; }
  .smp-agenda__people > div,
  .smp-agenda__access-list > div {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    border-bottom: 1px solid rgba(255,255,255,.065);
  }
  .smp-agenda__people > div > i {
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border: 1px solid rgba(125,141,255,.28);
    border-radius: 50%;
    background: rgba(125,141,255,.08);
    color: #c5ccff;
    font-size: 7px;
    font-style: normal;
  }
  .smp-agenda__people span,
  .smp-agenda__access-list span { flex: 1; }
  .smp-agenda__people b {
    padding: 4px 7px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 5px;
    color: rgba(255,255,255,.45);
    font-size: 7px;
    font-weight: 500;
  }
  .smp-agenda__access-list > div > i {
    position: relative;
    width: 24px;
    height: 13px;
    border-radius: 999px;
    background: rgba(255,255,255,.1);
  }
  .smp-agenda__access-list > div > i::after {
    content: "";
    position: absolute;
    left: 2px;
    top: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255,255,255,.38);
  }
  .smp-agenda__access-list > div > i.is-on { background: rgba(125,141,255,.3); }
  .smp-agenda__access-list > div > i.is-on::after { left: 13px; background: #a8b6ff; }
  .smp-agenda__access-list > b {
    display: block;
    height: 3px;
    margin-top: 11px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
  }
  .smp-agenda__access-list > b > i {
    display: block;
    width: 70%;
    height: 100%;
    background: linear-gradient(90deg, #5c8aff, #a45cff);
  }


  .smp-content--speaker-value { padding-top: 48px; }
  .smp-content--speaker-value .smp-spotlight {
    gap: clamp(44px, 7vw, 88px);
    padding: clamp(42px, 7vw, 82px);
    border: 1px solid #ececf2;
    border-radius: 22px;
    background:
      radial-gradient(circle at 95% 5%, rgba(123, 104, 238, .14), transparent 32%),
      #f7f7f9;
    box-shadow: none;
  }
  .smp-content--speaker-value .smp-spotlight__copy p {
    color: #656572;
    font-size: 17px;
    line-height: 1.7;
  }
  .smp-content--speaker-value .smp-recap {
    border-color: #e7e7ee;
    border-radius: 14px;
    box-shadow: 0 24px 70px rgba(32, 32, 44, .12);
    transform: rotate(1.25deg);
    transition: transform .35s ease;
  }
  .smp-content--speaker-value .smp-spotlight:hover .smp-recap { transform: rotate(0deg) translateY(-5px); }
  @media (max-width: 960px) {
    .sc-bento-row {
      flex-direction: column;
    }
    .sc-bento-row:nth-child(even) {
      flex-direction: column-reverse;
    }
    .sc-bento-content--alt {
      border-right: none;
    }
    .sc-bento-visual {
      border-right: none;
      border-bottom: 1px solid #ececf2;
      min-height: 400px;
    }
    .sc-bento-row--three .sc-bento-card {
      border-right: none;
      border-bottom: 1px solid #ececf2;
    }
    .sc-bento-row--three .sc-bento-card:last-child {
