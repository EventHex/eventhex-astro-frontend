  }
  .smp-setup-card__content a {
    color: #6366f1;
    text-decoration: none;
  }
  @media (max-width: 992px) {
    .smp-setup-grid { grid-template-columns: 1fr; }
    .smp-setup-notch { display: none; }
    .smp-setup-card {
      min-height: 0;
      border-left: 0;
      border-top: 1px solid var(--surface-card-border, #e8ecf2);
    }
    .smp-setup-card--first { border-top: 0; }
  }

