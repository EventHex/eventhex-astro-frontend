  .smp-content--workflow .smp-steps > li:nth-child(2) { --smp-workflow-tint: #edf7ff; --smp-workflow-border: #d4e7f7; }
  .smp-content--workflow .smp-steps > li:nth-child(3) { --smp-workflow-tint: #f3efff; --smp-workflow-border: #e2d8fa; }
  .smp-content--workflow .smp-steps > li:nth-child(4) { --smp-workflow-tint: #eefbf4; --smp-workflow-border: #d4efdf; }
  .smp-content--workflow .smp-steps > li:nth-child(5) { --smp-workflow-tint: #fff0f7; --smp-workflow-border: #f4d6e5; }

  .smp-content--workflow .smp-steps details[open] summary {
