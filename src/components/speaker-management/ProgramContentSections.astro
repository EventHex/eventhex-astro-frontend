---
interface Props {
  section: "setup" | "agenda" | "cfp" | "event-day" | "speaker-value";
}

const { section } = Astro.props;

const setupCards = [
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`, title: "Complete speaker profiles", body: "Keep every bio, role, company, photo and social link together, ready to publish wherever your audience sees the lineup." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`, title: "Faster speaker onboarding", body: "Paste a LinkedIn URL for AI autofill or import a spreadsheet to create dozens of accurate profiles in one go." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`, title: "A lineup organized your way", body: "Group keynotes, panellists and presenters with custom categories, then drag them into the exact order you want." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`, title: "Communication that stays on track", body: 'Send branded confirmations with an optional <a href="/badge-certificate-designer/">speaker badge</a>, track delivery and opens, and resend in bulk when needed.' },
];

const agendaCards = [
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`, title: "Visual timeline", body: "See every session on a colour-coded grid by day and stage, and drag one to a new slot." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12h-8"></path><path d="M21 6H8"></path><path d="M21 18h-8"></path><path d="M12 12H8V3"></path><path d="M12 18H8"></path><path d="M8 6H3"></path></svg>`, title: "Sub-sessions and breaks", body: 'Nest breakouts under a parent session and mark breaks so they stay out of the recording pipeline. See the full <a href="/session-management/">session and agenda tools</a>.' },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>`, title: "Multi-stage and tracks", body: "Run parallel stages and group the agenda by your own track taxonomy." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`, title: "Per-session speaker roles", body: "Mark who is moderating and who is on the panel, using role labels you control." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path></svg>`, title: "Ticket-restricted sessions", body: "Limit a session to specific ticket types, and cap how many people can book it." },
];

const eventCards = [
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg>`, title: "Works offline", body: 'The schedule and speaker list stay cached in the <a href="/event-mobile-app/">attendee mobile app</a>, so they keep working when the venue wifi does not.' },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>`, title: "Reminders that reach them", body: 'Attendees save the sessions they want and get a reminder by push and <a href="/whatsapp-event-concierge/">WhatsApp</a> before each one starts.' },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`, title: "Live translation", body: "Live transcription and translation run during the talk, in the language they choose." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>`, title: "No app needed to join in", body: '<a href="/live-polling-qa/">Live polls and Q&amp;A</a> open from a QR code — no app to install, no account to create.' },
];

const steps = [
  { 
    title: "Publish your call for papers",
    desc: "Publish a call for papers and collect abstracts through a submission form you design, with your own topics.",
    bullets: ["Customizable submission forms", "Define your own topics", "Easy abstract collection"],
    image: "/feature-images/speaker-management/cfp-portal-call-settings.jpg",
    alt: "EventHex call for abstracts setup panel"
  },
  { 
    title: "Review and score",
    desc: "Reviewers score submissions against a rubric you set, assigned automatically or by hand.", 
    bullets: ["Custom scoring rubrics", "Automatic or manual assignment", "Streamlined review process"],
    image: "/feature-images/speaker-management/cfp-portal-rubric.jpg",
    alt: "EventHex abstract review rubric and scoring criteria"
  },
  { 
    title: "Accept and export",
    desc: "Accept the ones you want and export the rest for your records.", 
    bullets: ["One-click acceptance", "Export data easily", "Maintain complete records"],
    image: "/feature-images/speaker-management/cfp-portal-submissions.jpg",
    alt: "EventHex abstract submissions, decisions, and export workspace"
  },
  { 
    title: "Auto-create sessions",
    desc: "Push accepted abstracts straight into the program — EventHex creates the sessions for you.", 
    bullets: ["Seamless data transfer", "Automatic session creation", "Saves time and effort"],
    image: "/feature-images/speaker-management/cfp-portal-sessions.jpg",
    alt: "EventHex sessions created in the agenda workspace"
  },
  { 
    title: "Publish the agenda",
    desc: "Speakers, sessions and the full agenda go live on your event website.", 
    bullets: ["Instant publishing", "Live on event website", "Engage your attendees"],
    image: "/feature-images/speaker-management/cfp-portal-published-agenda.jpg",
    alt: "Published Festival program on an EventHex event website"
  },
];
---

{section === "setup" && (
  <section class="smp-clickup-hero">
    <div class="smp-clickup-hero__inner">
      <header class="smp-clickup-hero__header">
        <h2>Set up the lineup</h2>
      </header>
      
      <div class="smp-setup-grid">
        {setupCards.slice(0, -1).map((_, index) => (
          <div
            class="smp-setup-notch"
            style={`left: ${((index + 1) / setupCards.length) * 100}%`}
            aria-hidden="true"
          >
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path>
            </svg>
          </div>
        ))}
        {setupCards.map((card, index) => (
          <div class:list={["smp-setup-card", { "smp-setup-card--first": index === 0 }]}>
            <div class="smp-setup-card__icon" set:html={card.icon} />
            <div class="smp-setup-card__content">
              <h3>{card.title}</h3>
              <p set:html={card.body} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{section === "agenda" && (
  <section class="smp-content smp-content--agenda">
    <div class="smp-content__inner">
      <header class="smp-content__header">
        <h2>Build the agenda</h2>
      </header>
      <div class="smp-agenda-grid">
        {agendaCards.map((card, index) => (
          <article class="smp-content__card">
            {[1, 2, 4].includes(index) && (
              <>
                <span class="smp-agenda__petal smp-agenda__petal--top" aria-hidden="true">
                  <svg width="28" height="28" viewBox="-14 -14 28 28">
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path>
                  </svg>
                </span>
                <span class="smp-agenda__petal smp-agenda__petal--bottom" aria-hidden="true">
                  <svg width="28" height="28" viewBox="-14 -14 28 28">
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path>
                  </svg>
                </span>
              </>
            )}
            <div class="smp-content__card-text">
              <h3>{card.title}</h3>
              <p set:html={card.body} />
            </div>
            <div class="smp-agenda__visual">
              {index === 0 && (
                <div class="smp-agenda__product" aria-hidden="true">
                  <div class="smp-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Agenda</small></div>
                  <div class="smp-agenda__product-tabs"><span class="is-active">Day 1</span><span>Day 2</span><span>Day 3</span></div>
                  <div class="smp-agenda__schedule-list">
                    <div><time>09:00</time><span><strong>Opening keynote</strong><small>Main stage · 45 min</small></span></div>
                    <div class="is-accent"><time>10:15</time><span><strong>Product panel</strong><small>Growth stage · 60 min</small></span></div>
                    <div><time>11:30</time><span><strong>Networking break</strong><small>All venues · 30 min</small></span></div>
                  </div>
                </div>
              )}
              {index === 1 && (
                <div class="smp-agenda__product" aria-hidden="true">
                  <div class="smp-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Session structure</small></div>
                  <div class="smp-agenda__product-tabs"><span class="is-active">Sessions</span><span>Breaks</span></div>
                  <div class="smp-agenda__outline">
                    <div><i></i><strong>Future of events</strong><small>10:30</small></div>
                    <div class="is-child"><i></i><strong>Enterprise track</strong><small>Room A</small></div>
                    <div class="is-child"><i></i><strong>Creator track</strong><small>Room B</small></div>
                    <div class="is-break"><i></i><strong>Coffee break</strong><small>11:20</small></div>
                  </div>
                </div>
              )}
              {index === 2 && (
                <div class="smp-agenda__product" aria-hidden="true">
                  <div class="smp-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Stage board</small></div>
                  <div class="smp-agenda__product-tabs"><span class="is-active">Main</span><span>Growth</span><span>Lab</span></div>
                  <div class="smp-agenda__stage-board">
                    <span><i></i><i></i></span><span><i></i><i></i></span><span><i></i><i></i></span>
                  </div>
                </div>
              )}
              {index === 3 && (
                <div class="smp-agenda__product smp-agenda__product--wide" aria-hidden="true">
                  <div class="smp-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Session team</small></div>
                  <div class="smp-agenda__product-tabs"><span>Speakers</span><span class="is-active">Roles</span></div>
                  <div class="smp-agenda__people">
                    <div><i>MC</i><span><strong>Maya Chen</strong><small>Moderator</small></span><b>Host</b></div>
                    <div><i>AK</i><span><strong>Alex Kim</strong><small>Product leader</small></span><b>Speaker</b></div>
                    <div><i>JL</i><span><strong>Jordan Lee</strong><small>Founder</small></span><b>Panellist</b></div>
                  </div>
                </div>
              )}
              {index === 4 && (
                <div class="smp-agenda__product smp-agenda__product--wide" aria-hidden="true">
                  <div class="smp-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Booking access</small></div>
                  <div class="smp-agenda__product-tabs"><span class="is-active">Tickets</span><span>Capacity</span></div>
                  <div class="smp-agenda__access-list">
                    <div><span><strong>VIP pass</strong><small>42 booked</small></span><i class="is-on"></i></div>
                    <div><span><strong>Conference pass</strong><small>38 booked</small></span><i class="is-on"></i></div>
                    <div><span><strong>Day ticket</strong><small>Not allowed</small></span><i></i></div>
                    <b><i></i></b>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{section === "cfp" && (
  <section class="smp-content smp-content--clickup smp-content--workflow">
    <div class="smp-content__inner smp-content__inner--narrow">
      <header class="smp-workflow__header">
        <div class="smp-workflow__heading">
          <h2>From call for papers to published program</h2>
        </div>
      </header>
      <ol class="smp-steps">
        {steps.map((step, index) => (
          <li>
            <details open={index === 0}>
              <summary tabindex="-1">
                <span>0{index + 1}</span>
                <div class="smp-step__content">
                  <h3 class="smp-step__title">{step.title}</h3>
                  <p set:html={step.desc} class="smp-step__desc" />
                  {step.bullets && (
                    <ul class="smp-step__bullets">
                      {step.bullets.map(bullet => (
                        <li><i aria-hidden="true">✦</i> {bullet}</li>
                      ))}
                    </ul>
                  )}
                </div>
                <button
                  type="button"
                  class="smp-workflow__arrow"
                  aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" />
                  </svg>
                </button>
              </summary>
              <div class="smp-workflow__visual">
                <img src={step.image} alt={step.alt} loading="lazy" decoding="async" />
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{section === "cfp" && (
  <script>
    document.querySelectorAll<HTMLDetailsElement>(".smp-content--workflow details").forEach((item, _, all) => {
      const summary = item.querySelector("summary");
      const trigger = item.querySelector<HTMLButtonElement>(".smp-workflow__arrow");

      summary?.addEventListener("click", (event) => {
        event.preventDefault();
        item.open = !item.open;
      });

      item.addEventListener("toggle", () => {
        trigger?.setAttribute("aria-expanded", String(item.open));
        trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} workflow step`);
        if (!item.open) return;
        all.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  </script>
)}

{section === "event-day" && (
  <section class="smp-clickup-hero">
    <div class="smp-clickup-hero__inner">
      <header class="smp-clickup-hero__header">
        <h2>Your attendees get the agenda<br />in their pocket signal or not</h2>
      </header>
      <div class="smp-setup-grid">
        {eventCards.slice(0, -1).map((_, index) => (
          <div
            class="smp-setup-notch"
            style={`left: ${((index + 1) / eventCards.length) * 100}%`}
            aria-hidden="true"
          >
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path>
            </svg>
          </div>
        ))}
        {eventCards.map((card, index) => (
          <article class:list={["smp-setup-card", { "smp-setup-card--first": index === 0 }]}>
            <span class="smp-setup-card__icon" set:html={card.icon} />
            <div class="smp-setup-card__content">
              <h3>{card.title}</h3>
              <p set:html={card.body} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{section === "speaker-value" && (
  <section class="smp-content smp-content--clickup smp-content--speaker-value">
    <div class="smp-content__inner">
      <div class="smp-spotlight">
        <div class="smp-spotlight__copy">
          <span>After the session</span>
          <h2>Speakers leave with something to post</h2>
          <p>After a session, <a href="/ai-session-recap/">AI session recap</a> turns the recording into a summary with key takeaways, drafts a LinkedIn and an X post, and generates a shareable poster. Send it to your speakers and they promote the event for you — while it is still fresh. Recordings can come from a live capture, an uploaded file, or a YouTube link.</p>
        </div>
        <div class="smp-recap" aria-label="Example session recap">
          <div class="smp-recap__bar"><i></i><i></i><i></i><span>Session recap</span></div>
          <div class="smp-recap__body">
            <h3>Key takeaways</h3>
            <p>• Hiring ahead of revenue broke three of four teams surveyed.</p>
            <p>• Onboarding under two weeks correlated with retention.</p>
            <p>• Documentation debt compounds faster than technical debt.</p>
            <h3>Drafted LinkedIn post</h3>
            <blockquote>“Three things I learned speaking at #EventHexSummit today…”</blockquote>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .smp-content { padding: 96px 24px; background: transparent; color: #22272f; }
  .smp-content--tinted { background: transparent; }
  .smp-content--showcase { padding-top: 112px; }
  .smp-content__inner { width: min(1200px, 100%); margin: 0 auto; }
  .smp-content__inner--narrow { width: min(880px, 100%); }
  .smp-content__header { max-width: 850px; margin: 0 auto 52px; text-align: center; }
  .smp-content__header > span,
  .smp-spotlight__copy > span { display: block; margin-bottom: 16px; color: #375dfb; font: 750 12px/1.2 var(--font-body); letter-spacing: .13em; text-transform: uppercase; }
  .smp-content__header h2,
  .smp-spotlight h2 { 
    margin: 0; font-family: var(--font-heading); font-size: clamp(38px, 4.5vw, 56px); font-weight: 650; line-height: 1.08; letter-spacing: -.04em; 
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .smp-content__grid { display: grid; border-top: 1px solid #e3e8f1; border-bottom: 1px solid #e3e8f1; }
  .smp-content__grid--five { grid-template-columns: repeat(5, 1fr); }
  .smp-content__grid--four { grid-template-columns: repeat(4, 1fr); }
  .smp-content__card { min-width: 0; padding: 32px 26px 38px; border-left: 1px solid #e3e8f1; }
  .smp-content__card:first-child { border-left: 0; }
  .smp-content__icon { display: block; margin-bottom: 40px; color: #375dfb; font: 750 12px/1 var(--font-body); letter-spacing: .12em; }
  .smp-content__card h3 { margin: 0; font-family: var(--font-heading); font-size: 21px; line-height: 1.25; }
  .smp-content__card p,
  .smp-spotlight__copy p { margin: 18px 0 0; color: #596579; font: 400 15px/1.6 var(--font-body); }
  .smp-content a { color: #375dfb; text-decoration-color: rgba(55,93,251,.35); text-underline-offset: 3px; }
  .smp-content--showcase .smp-content__header { max-width: 920px; margin-bottom: 62px; }
  .smp-content--showcase .smp-content__header > span { color: #6941ff; }
  .smp-content--showcase .smp-content__header h2 {
    font-size: clamp(48px, 5.4vw, 72px);
    background: linear-gradient(100deg, #24272f 46%, #9a9ca3 78%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .smp-showcase-grid {
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    border: 0;
  }
  .smp-showcase-grid .smp-content__card {
    grid-column: span 2;
    padding: 16px 16px 26px;
    border: 0;
    border-radius: 12px;
    background: #f6f7f9;
  }
  .smp-showcase-grid .smp-content__card:nth-last-child(-n+2) { grid-column: span 3; }
  .smp-content__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 278px;
    margin-bottom: 24px;
    overflow: hidden;
    border-radius: 8px;
    background: radial-gradient(circle at 50% 45%, rgba(99, 74, 255, .24), transparent 45%), #090a0f;
  }
  .smp-content__visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform .45s ease;
  }
  .smp-showcase-grid .smp-content__card:hover .smp-content__visual img { transform: scale(1.025); }
