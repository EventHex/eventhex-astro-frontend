    grid-template-columns: 34px 1fr;
    height: calc(100% - 38px);
  }
  .smp-agenda__times {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    border-right: 1px solid rgba(255, 255, 255, .08);
