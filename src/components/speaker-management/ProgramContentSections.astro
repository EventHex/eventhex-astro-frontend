  .smp-spotlight { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(46px, 8vw, 110px); align-items: center; padding: clamp(48px, 7vw, 88px); border: 1px solid #dfe6ff; border-radius: 30px; background: radial-gradient(circle at 88% 12%, rgba(75,200,222,.22), transparent 32%), linear-gradient(135deg,#f6f8ff,#eef3ff 52%,#f6fdff); }
  .smp-spotlight__copy p { font-size: 17px; }
