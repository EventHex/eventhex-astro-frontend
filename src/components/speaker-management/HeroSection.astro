---
// Speaker-management hero with a more distinct split layout than the home page hero
---

<section class="smh-hero ds-stage">
  <div class="smh-hero__shell">
    <div class="smh-hero__grid">
      <div class="smh-hero__content">
        <div class="smh-hero__badge animate-on-scroll" data-animation="fadeInDown">
          <span class="smh-hero__badge-dot"></span>
          <span>Speaker Management</span>
        </div>

        <h1 class="smh-hero__title ds-h1 animate-on-scroll" data-animation="fadeInUp">
          <span class="smh-hero__title-line">Speaker management</span>
          <span class="smh-hero__title-line">software that builds</span>
          <span class="smh-hero__title-line"><span class="ds-hl">your agenda,</span> not just</span>
          <span class="smh-hero__title-line">your contact list</span>
        </h1>

        <p class="smh-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Paste a LinkedIn URL to add a speaker, drop them onto a multi-stage timeline,
          and let every attendee know the moment the schedule moves — all from one workspace.
        </p>

        <div class="smh-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          <span class="smh-hero__point">AI LinkedIn import</span>
          <span class="smh-hero__point">Visual multi-stage timeline</span>
          <span class="smh-hero__point">Live polls, Q&amp;A and AI recap</span>
        </div>

        <div class="smh-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a href="/book-a-demo/" class="smh-hero__btn ds-btn">Get a Free Demo</a>
          <a href="#spk-bento" class="smh-hero__btn ds-btn--ghost">See how it works</a>
        </div>

      </div>

      <div class="smh-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="smh-hero__visual-card">
          <div class="smh-hero__visual-inner">
            <img
              src="/feature-images/speaker-management/hero-visual.svg"
              alt="Speaker management dashboard showing speaker profiles, session scheduling, and live engagement tools"
              class="smh-hero__img"
              width="978"
              height="887"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .smh-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 120px;
  }

  .smh-hero__shell {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0;
    background: none;
  }

  .smh-hero__grid {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }

  .smh-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    text-align: left;
  }

  .smh-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: normal;
    color: var(--ds-blue);
    text-transform: uppercase;
  }

  .smh-hero__badge-dot {
    display: none;
  }

  .smh-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    width: 100%;
    max-width: 620px;
    font-size: 52px;
    font-weight: 500;
    line-height: 58px;
    letter-spacing: -2.1px;
    color: var(--ds-ink);
  }

  .smh-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .smh-hero__desc {
    margin: 0;
    width: 100%;
    max-width: 560px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.25px;
    color: var(--ds-body);
  }

  .smh-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .smh-hero__point {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding: 0 0 0 16px;
    border-radius: 0;
    background: transparent;
    border: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--ds-sub);
    box-shadow: none;
  }

  .smh-hero__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .smh-hero__cta {
    display: flex;
    gap: 14px;
    padding-top: 6px;
  }

  .smh-hero__btn {
    min-height: 48px;
  }

  .smh-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .smh-hero__trust-item {
    position: relative;
    padding-left: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--ds-muted);
  }

  .smh-hero__trust-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .smh-hero__visual {
    position: relative;
    z-index: 3;
  }

  .smh-hero__visual-card {
    position: relative;
    padding: 0;
    border-radius: var(--ds-r-lg);
    border: 1px solid var(--ds-line-strong);
    background: var(--ds-white);
    box-shadow: var(--ds-shadow-hero);
    overflow: hidden;
  }

  .smh-hero__visual-inner {
    position: relative;
    overflow: hidden;
    padding: 28px;
    background: linear-gradient(135deg, var(--ds-cat-sky-bg), var(--ds-surface-tab) 45%, var(--ds-white));
  }

  .smh-hero__img {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: contain;
    height: auto;
    animation: smhHeroFloat 6s ease-in-out infinite;
  }

  @keyframes smhHeroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }

  @media (max-width: 1120px) {
    .smh-hero {
      padding: 140px 20px 56px;
    }

    .smh-hero__shell {
      padding: 0;
    }

    .smh-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: 32px;
      padding: 0;
    }

    .smh-hero__desc {
      max-width: 520px;
    }

    .smh-hero__title {
      font-size: 46px;
      line-height: 52px;
      letter-spacing: -1.5px;
    }
  }

  @media (max-width: 960px) {
    .smh-hero {
      padding: 130px 20px 48px;
    }

    .smh-hero__shell {
      padding: 0;
    }

    .smh-hero__grid {
      grid-template-columns: 1fr;
      gap: 34px;
      padding: 0;
    }

    .smh-hero__content {
      align-items: center;
      text-align: center;
    }

    .smh-hero__title,
    .smh-hero__desc {
      max-width: 760px;
    }

    .smh-hero__visual {
      width: min(760px, 100%);
      margin: 0 auto;
    }

    .smh-hero__desc {
      max-width: 720px;
    }

    .smh-hero__trust,
    .smh-hero__points,
    .smh-hero__cta {
      justify-content: center;
    }

    .smh-hero__title {
      font-size: 42px;
      line-height: 1.1em;
    }
  }

  @media (max-width: 767px) {
    .smh-hero {
      margin-top: -80px;
      padding: 120px 18px 44px;
    }

    .smh-hero__shell {
      padding: 0;
    }

    .smh-hero__grid {
      padding: 0 0 30px;
    }

    .smh-hero__visual-inner {
      padding: 18px;
    }

    .smh-hero__title {
      font-size: 38px;
      line-height: 1.2em;
      letter-spacing: 0;
    }

    .smh-hero__desc {
      font-size: 15px;
      line-height: 1.7;
    }

    .smh-hero__badge {
      font-size: 16px;
      line-height: 1.1em;
    }

    .smh-hero__point {
      font-size: 13px;
      padding: 8px 12px;
    }

    .smh-hero__cta {
      width: 100%;
      flex-direction: column;
    }

    .smh-hero__btn {
      width: 100%;
    }

    .smh-hero__trust {
      gap: 10px;
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .smh-hero__title {
      font-size: 33px;
      line-height: 1.15em;
    }
  }
</style>
