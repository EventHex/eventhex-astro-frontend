  @media(max-width:900px){.emaj-split,.emaj-split--reverse{grid-template-columns:1fr}.emaj-copy{max-width:none}.emaj-product-shot{order:2}.emaj-module-grid{grid-template-columns:1fr 1fr}.emaj-module:nth-child(2){border-right:0}.emaj-module:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.12)}}
  @media(max-width:767px){.emaj-section,.emaj-modules,.emaj-audience{padding:58px 20px}.emaj-mini-grid,.emaj-module-grid,.emaj-audience-grid{grid-template-columns:1fr}.emaj-module{min-height:220px;border-right:0;border-bottom:1px solid rgba(255,255,255,.12)}.emaj-module h3{margin-top:34px}.emaj-chip{right:8px}.emaj-flow{gap:5px}.emaj-flow span{font-size:10px}.emaj-person{grid-template-columns:38px 1fr}.emaj-person em{display:none}}
  @media(prefers-reduced-motion:reduce){.emaj-section *,.emaj-modules *{animation:none!important;transition:none!important}}
</style>

<style>
  .emaj-modules { padding:clamp(40px,4.5vw,60px) 24px clamp(82px,9vw,116px); background:transparent!important; color:#182230; }
  .emaj-modules .emaj-inner { width:min(1120px,100%); }
  .emaj-modules .emaj-heading { max-width:none; margin:0; padding:0 24px clamp(20px,2.4vw,32px); }
