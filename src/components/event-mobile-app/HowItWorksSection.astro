---
const steps = [
  {
    id: "brief",
    num: "01",
    title: "Submit the app brief",
    desc: "Provide the identity, descriptions, contact, logo, and feature graphic.",
    bullets: ["Add the app identity", "Upload store-ready artwork", "Share contact details"],
    image: "/images/event-mobile-app/app/app-request-details.png",
    imageWidth: 672,
    imageHeight: 471,
    alt: "EventHex Request an App form with app name, short description, and contact details",
  },
  {
    id: "configure",
    num: "02",
    title: "Configure the experience",
    desc: "Choose the theme, home shortcuts, banner, profile fields, interests, and enabled modules.",
    bullets: ["Match your event brand", "Arrange home shortcuts", "Enable the right modules"],
    image: "/images/event-mobile-app/app/app-configuration.png",
    imageWidth: 1020,
    imageHeight: 570,
    alt: "EventHex attendee mobile app configuration with login, branding, design, and home settings",
  },
  {
    id: "review",
    num: "03",
    title: "Follow review status",
    desc: "Track pending, accepted, waiting-for-review, rejected, or store-rejected outcomes.",
    bullets: ["See the current status", "Keep review notes together", "Know when action is needed"],
    image: "/images/event-mobile-app/app/app-publication-overview.png",
    imageWidth: 1020,
    imageHeight: 570,
    alt: "EventHex dedicated mobile app request overview for Google Play and the App Store",
  },
  {
    id: "stores",
    num: "04",
    title: "Add store destinations",
    desc: "Use Android and iOS URLs after publication; approval and timing remain subject to each store.",
    bullets: ["Add the iOS destination", "Add the Android destination", "Share download links"],
    image: "/images/event-mobile-app/app/app-store-versions.png",
    imageWidth: 1020,
    imageHeight: 570,
    alt: "EventHex mobile app version settings with Android and iOS version and store URL columns",
  },
];
---

<section class="emahw-full">
  <div class="emahw-full__inner">
    <header class="emahw-full__header animate-on-scroll" data-animation="fadeInUp">
      <h2>Track the app from brief to store publication</h2>
    </header>

    <div class="emahw-tabs" role="tablist" aria-label="App publication steps">
      {steps.map((step, index) => (
        <button class:list={["emahw-tab", { "is-active": index === 0 }]} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`emahw-panel-${step.id}`} id={`emahw-tab-${step.id}`} data-workflow-tab={step.id}>{step.title}</button>
      ))}
    </div>

    <div class="emahw-panels">
      {steps.map((step, index) => (
        <article class:list={["emahw-panel", { "is-active": index === 0 }]} id={`emahw-panel-${step.id}`} role="tabpanel" aria-labelledby={`emahw-tab-${step.id}`} data-workflow-panel={step.id} hidden={index !== 0}>
          <div class="emahw-copy">
            <span class="emahw-label">Step {step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
            <ul>{step.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </div>
          <div class="emahw-visual">
            <img src={step.image} width={step.imageWidth} height={step.imageHeight} alt={step.alt} loading="lazy" decoding="async" />
            <span>Publication workflow</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector(".emahw-full");
    if (!section) return;
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-workflow-tab]"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>("[data-workflow-panel]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let isVisible = false;
    let autoTabTimer: number | undefined;
    const activate = (tab: HTMLButtonElement) => {
      const target = tab.dataset.workflowTab;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        const active = panel.dataset.workflowPanel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };
    const stopAutoTabs = () => {
      if (autoTabTimer === undefined) return;
      window.clearInterval(autoTabTimer);
      autoTabTimer = undefined;
    };
    const startAutoTabs = () => {
      stopAutoTabs();
      if (reducedMotion || !isVisible || section.matches(":hover") || section.contains(document.activeElement)) return;
      autoTabTimer = window.setInterval(() => {
        const activeIndex = tabs.findIndex((tab) => tab.classList.contains("is-active"));
        const nextTab = tabs[(activeIndex + 1) % tabs.length];
        activate(nextTab);
        nextTab.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      }, 5000);
    };
    tabs.forEach((tab, index) => {
      tab.tabIndex = index === 0 ? 0 : -1;
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const next = event.key === "ArrowRight" ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
        tabs[next].focus();
        activate(tabs[next]);
      });
    });
    section.addEventListener("pointerenter", stopAutoTabs);
    section.addEventListener("pointerleave", startAutoTabs);
    section.addEventListener("focusin", stopAutoTabs);
    section.addEventListener("focusout", () => window.setTimeout(startAutoTabs, 0));
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      isVisible ? startAutoTabs() : stopAutoTabs();
    }, { threshold: 0.35 });
    visibilityObserver.observe(section);
  });
</script>

<style is:global>
  .emahw-full { width: 100%; padding: 64px 24px 112px; background: #fff; color: #111827; }
  .emahw-full__inner { width: min(1080px, 100%); margin: 0 auto; }
  .emahw-full__header { max-width: 920px; margin: 0 auto 32px; text-align: center; }
  .emahw-full__header h2, .emahw-copy h3 { font-family: var(--font-heading); font-size: clamp(40px, 4.1vw, 52px); font-weight: 500; line-height: 1.115; letter-spacing: -2.1px; background: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .emahw-full__header h2 { margin: 0 auto; }
  .emahw-tabs { display: flex; justify-content: center; gap: 4px; width: fit-content; max-width: 100%; margin: 0 auto 40px; padding: 6px; border: 1px solid #e5e7eb; border-radius: 999px; background: #f1f3f7; }
  .emahw-tab { padding: 8px 16px; border: 1px solid transparent; border-radius: 999px; background: transparent; color: #64748b; font: 600 13px/1.4 var(--font-body); cursor: pointer; white-space: nowrap; transition: .2s ease; }
  .emahw-tab:hover { background: rgba(255,255,255,.65); color: #334155; }
  .emahw-tab.is-active { border-color: #dbe4f0; background: #fff; color: #3b82f6; box-shadow: 0 2px 8px rgba(30,41,59,.08); }
  .emahw-panels { min-height: 520px; }
  .emahw-panel { display: none; grid-template-columns: minmax(0,.86fr) minmax(0,1.14fr); gap: 54px; align-items: center; padding: 52px 64px; border: 1px solid #f0dfa6; border-radius: 28px; background: linear-gradient(135deg,#fff8dc,#fff 72%); overflow: hidden; }
  .emahw-panel:nth-child(2) { border-color: #d4e7f7; background: linear-gradient(135deg,#edf7ff,#fff 72%); }
  .emahw-panel:nth-child(3) { border-color: #e2d8fa; background: linear-gradient(135deg,#f3efff,#fff 72%); }
  .emahw-panel:nth-child(4) { border-color: #d4efdf; background: linear-gradient(135deg,#eefbf4,#fff 72%); }
  .emahw-panel.is-active { display: grid; animation: emahwPanelIn .42s ease both; }
  .emahw-copy { max-width: 430px; }
  .emahw-label { display: block; margin-bottom: 18px; color: #375dfb; font: 700 12px/1.4 var(--font-body); letter-spacing: .1em; text-transform: uppercase; }
  .emahw-copy h3 { margin: 0 0 16px; }
  .emahw-copy p { margin: 0; color: #667085; font: 400 16px/1.6 var(--font-body); }
  .emahw-copy ul { display: grid; gap: 10px; margin: 26px 0 0; padding: 0; list-style: none; }
  .emahw-copy li { position: relative; padding-left: 24px; color: #344054; font: 600 14px/1.4 var(--font-body); }
  .emahw-copy li::before { content: '✓'; position: absolute; left: 0; color: #16a36a; }
  .emahw-visual { position: relative; min-height: 380px; display: flex; align-items: center; justify-content: center; padding: 58px 24px 26px; border: 1px solid rgba(206,218,236,.9); border-radius: 24px; background: rgba(255,255,255,.72); box-shadow: 0 24px 50px rgba(31,52,128,.1); }
  .emahw-visual img { display: block; max-width: 100%; max-height: 360px; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 18px 26px rgba(31,52,128,.18)); animation: emahwVisualFloat 5s ease-in-out infinite; }
  .emahw-visual span { position: absolute; top: 18px; left: 18px; padding: 9px 13px; border: 1px solid #bfe6d5; border-radius: 12px; background: #eafaf3; color: #15805b; font: 700 12px var(--font-body); box-shadow: 0 10px 22px rgba(31,52,128,.08); }
  @keyframes emahwPanelIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes emahwVisualFloat { 50% { transform: translateY(-7px); } }
  @media (max-width: 900px) { .emahw-panel { grid-template-columns: 1fr; padding: 44px; gap: 36px; } .emahw-copy { max-width: none; } }
  @media (max-width: 767px) {
    .emahw-full { padding: 32px 20px 58px; }
    .emahw-full__header h2, .emahw-copy h3 { font-size: 38px; line-height: 1.2; letter-spacing: -1.2px; }
    .emahw-tabs { justify-content: flex-start; width: 100%; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; }
    .emahw-tabs::-webkit-scrollbar { display: none; }
    .emahw-tab { flex: 0 0 auto; scroll-snap-align: start; }
    .emahw-panels { min-height: 0; }
    .emahw-panel { padding: 30px 22px; border-radius: 22px; }
    .emahw-visual { min-height: 300px; padding: 58px 12px 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .emahw-full * { animation: none !important; transition: none !important; } }
</style>
