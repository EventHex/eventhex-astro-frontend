---
const cards = [
  { eyebrow: "Personal event day", title: "Keep the saved agenda close", desc: "Browse the programme by day, open session details, save sessions, and return to the selected agenda during the event.", image: "/images/live-polling-qa/app/attendee-mobile-app.png", alt: "EventHex attendee mobile-app workspace with agenda access", tint: "agenda", pill: "Saved sessions ready" },
  { eyebrow: "Organizer updates", title: "Put important changes inside the app", desc: "Publish concise event notifications through the configured mobile channel so updates sit alongside the programme and event content.", image: "/images/live-polling-qa/app/mobile-app-updates.png", alt: "EventHex mobile app showing organizer updates for attendees", tint: "updates", pill: "Update published" },
  { eyebrow: "Resilience where implemented", title: "Use supported locally stored event data", desc: "Supported event, session, speaker, sponsor, profile, and networking views can use locally stored data. Network-dependent actions may still need connectivity.", image: "/images/live-polling-qa/app/mobile-app-analytics.png", alt: "EventHex mobile-app analytics workspace showing attendee activity", tint: "resilience", pill: "Supported views available" },
];
---

<section class="emac-full">
  <div class="emac-full__inner">
    <header class="emac-full__header animate-on-scroll" data-animation="fadeInUp">
      <span class="emac-full__tag">During the event</span>
      <h2 class="emac-full__title">Guide the day without <span>overpromising connectivity</span></h2>
      <p class="emac-full__desc">Keep saved sessions, organizer updates, and supported cached information within the attendee experience—and test offline-critical views on the release build.</p>
    </header>

    <div class="emac-full__grid animate-on-scroll" data-animation="fadeInUp">
      {cards.map((card, index) => (
        <article class:list={["emac-full__row", { "emac-full__row--reverse": index % 2 === 1 }]}>
          <div class="emac-full__cell emac-full__visual">
            <div class={`emac-full__stage emac-full__stage--${card.tint}`}>
              <img src={card.image} width="1263" height="697" alt={card.alt} loading="lazy" decoding="async" />
              <span class="emac-full__status"><i></i>{card.pill}</span>
            </div>
          </div>
          <div class="emac-full__cell emac-full__content">
            <span class="emac-full__eyebrow">{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .emac-full { width:100%; padding:88px 24px 96px; background:transparent; }
  .emac-full__inner { width:min(1120px,100%); margin:0 auto; }
  .emac-full__header { max-width:900px; margin:0 auto 58px; text-align:center; }
  .emac-full__tag { display:block; margin-bottom:16px; color:#375dfb; font:700 12px/1.4 var(--font-body); letter-spacing:.12em; text-transform:uppercase; }
  .emac-full__title { margin:0; color:#182230; font:500 clamp(38px,4.6vw,56px)/1.08 var(--font-heading); letter-spacing:-.035em; }
  .emac-full__title span { background:linear-gradient(98deg,#434a58,#a1a5ad); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .emac-full__desc { max-width:760px; margin:18px auto 0; color:#667085; font:400 17px/1.6 var(--font-body); }
  .emac-full__grid { overflow:hidden; border:1px solid #e5e7eb; border-radius:18px; background:rgba(255,255,255,.25); }
  .emac-full__row { position:relative; display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid #e5e7eb; }
  .emac-full__row:last-child { border-bottom:0; }
  .emac-full__cell { min-width:0; padding:56px; display:flex; flex-direction:column; justify-content:center; }
  .emac-full__row .emac-full__cell:first-child { border-right:1px solid #e5e7eb; }
  .emac-full__row--reverse .emac-full__visual { order:2; border-right:0!important; }
  .emac-full__row--reverse .emac-full__content { order:1; border-right:1px solid #e5e7eb; }
  .emac-full__visual { align-items:center; }
  .emac-full__stage { position:relative; width:100%; min-height:330px; display:flex; align-items:flex-end; justify-content:center; padding:54px 24px 0; border-radius:22px; overflow:hidden; }
  .emac-full__stage--agenda { background:linear-gradient(180deg,#fff0bd,#fff8df 48%,#f5f6f9); }
  .emac-full__stage--updates { background:linear-gradient(180deg,#d6f3e3,#eaf9f0 48%,#f5f6f9); }
  .emac-full__stage--resilience { background:linear-gradient(180deg,#dfe5ff,#eef1ff 48%,#f5f6f9); }
  .emac-full__stage img { display:block; max-width:100%; max-height:300px; width:auto; height:auto; object-fit:contain; border:1px solid #dfe4ec; border-radius:14px; box-shadow:0 18px 36px rgba(31,52,128,.14); animation:emacShotFloat 6s ease-in-out infinite; transition:transform .45s ease,box-shadow .45s ease; }
  .emac-full__stage:hover img { transform:translateY(-6px) scale(1.02); box-shadow:0 26px 52px rgba(31,52,128,.2); animation-play-state:paused; }
  .emac-full__status { position:absolute; top:18px; right:18px; display:flex; align-items:center; gap:8px; padding:10px 13px; border:1px solid #d4ddea; border-radius:12px; background:rgba(255,255,255,.95); color:#344054; font:700 12px var(--font-body); box-shadow:0 12px 24px rgba(31,52,128,.1); }
  .emac-full__status i { width:8px; height:8px; border-radius:50%; background:#14b87a; box-shadow:0 0 0 4px rgba(20,184,122,.12); }
  .emac-full__eyebrow { color:#5d3ec8; font:700 13px/1.4 var(--font-body); letter-spacing:.1em; text-transform:uppercase; }
  .emac-full__content h3 { margin:22px 0 18px; max-width:440px; color:#182230; font:500 clamp(34px,4vw,48px)/1.05 var(--font-heading); letter-spacing:-.035em; }
  .emac-full__content p { margin:0; color:#5f6b7c; font:400 17px/1.65 var(--font-body); }
  @keyframes emacShotFloat { 50% { transform:translateY(-7px); } }
  @media(max-width:900px){.emac-full__cell{padding:38px}.emac-full__stage{min-height:280px}.emac-full__content h3{font-size:38px}}
  @media(max-width:700px){.emac-full{padding:64px 18px 72px}.emac-full__header{margin-bottom:38px}.emac-full__title{font-size:34px}.emac-full__desc{font-size:15px}.emac-full__row{grid-template-columns:1fr}.emac-full__row .emac-full__cell:first-child,.emac-full__row--reverse .emac-full__content{border-right:0}.emac-full__row--reverse .emac-full__visual,.emac-full__row--reverse .emac-full__content{order:initial}.emac-full__visual{border-bottom:1px solid #e5e7eb}.emac-full__cell{padding:26px}.emac-full__stage{min-height:250px;padding:54px 12px 0}.emac-full__content{padding:34px 26px 40px}.emac-full__content h3{font-size:32px}.emac-full__content p{font-size:15px}}
  @media(prefers-reduced-motion:reduce){.emac-full *{animation:none!important;transition:none!important}}
</style>
