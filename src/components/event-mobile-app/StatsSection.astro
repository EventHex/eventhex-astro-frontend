---
const stats = [
  { value: "Define", label: "Brand + listing" },
  { value: "Configure", label: "Home + modules" },
  { value: "Request", label: "Dedicated app" },
  { value: "Publish", label: "Store links after review" },
];
---

<section class="emas-reference" aria-label="Event mobile app workflow">
  <div class="emas-trust">
    <div class="emas-trust__inner">
      <span class="emas-trust__label">Shape The Attendee Experience</span>
      {stats.map((stat) => (
        <span class="emas-trust__stat"><b>{stat.value}</b> {stat.label}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .emas-reference {
    width: 100%;
    padding: 0;
    background: transparent;
    color: #22272f;
  }

  .emas-trust {
    border-top: 1px solid #e8edf5;
    border-bottom: 1px solid #e8edf5;
    background: transparent;
  }

  .emas-trust__inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 36px;
  }

  .emas-trust__label,
  .emas-trust__stat {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: #596579;
    text-align: center;
  }

  .emas-trust__label {
    color: #7f8898;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .emas-trust__stat b {
    color: #22272f;
    font-weight: 750;
  }

  @media (max-width: 1024px) {
    .emas-trust__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 28px;
      padding: 22px 0;
    }

    .emas-trust__label { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {
    .emas-trust__inner { width: min(100% - 32px, 1120px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .emas-trust__inner { animation: none !important; }
  }
</style>
