---
const useCases = [
  {
    id: "exhibitions",
    label: "Exhibitions and trade shows",
    description: "Invite people from a previous edition, then narrow follow-up by the current event's ticket or form groups.",
    checklist: ["Previous-edition audiences", "Current-event ticket groups", "Current-event form groups"],
    image: "/feature-images/solutions/event-marketing-audience-builder.jpg",
    imageAlt: "EventHex audience builder using event and registration data",
    visualLabel: "Audience ready",
  },
  {
    id: "conferences",
    label: "Conferences and associations",
    description: "Build a focused invitation or programme campaign for the right attendee segment.",
    checklist: ["Focused invitations", "Programme campaigns", "Attendee segments"],
    image: "/feature-images/solutions/event-marketing-email-campaigns.jpg",
    imageAlt: "EventHex email campaign workspace for an event audience",
    visualLabel: "Email campaign",
  },
  {
    id: "corporate",
    label: "Corporate and technology events",
    description: "Separate internal, partner, guest, or ticket-based audiences before the message is scheduled.",
    checklist: ["Internal audiences", "Partner and guest audiences", "Ticket-based audiences"],
    image: "/feature-images/solutions/event-marketing-whatsapp-campaigns.jpg",
    imageAlt: "EventHex WhatsApp campaign workspace for selected attendees",
    visualLabel: "WhatsApp campaign",
  },
  {
    id: "agencies",
    label: "Event agencies",
    description: "Work with audiences across organizer events while keeping each campaign's event, sender, and status visible.",
    checklist: ["Cross-event audiences", "Connected sender visibility", "Campaign status in one view"],
    image: "/feature-images/solutions/event-marketing-audience-builder.jpg",
    imageAlt: "EventHex cross-event audience selection workspace",
    visualLabel: "Cross-event audience",
  },
];
const related = [
  ["Event Notifications", "Configure operational alerts and updates that follow event actions and timing.", "/event-notifications/"],
  ["WhatsApp Concierge", "Give attendees conversational event help through WhatsApp flows.", "/whatsapp-event-concierge/"],
  ["Social Advocacy", "Help attendees share branded event posters and links with their networks.", "/social-advocacy/"],
  ["Event Registration", "Shape the registration path and forms that campaign traffic reaches.", "/event-registration/"],
];
---

<section class="emb-bento-section ds-stage" aria-labelledby="emb-results-title">
  <div class="emb-bento-container">
    <div class="emb-bento-header animate-on-scroll" data-animation="fadeInUp"><h2 id="emb-results-title">Move From the Summary to the <span class="ds-hl">Recipient Behind It</span></h2><p>See the overall campaign state, then open the delivery detail that needs attention.</p></div>
    <div class="emb-bento-grid animate-on-scroll" data-animation="fadeInUp">

      <div class="emb-bento-row">
        <div class="emb-bento-cell emb-bento-visual">
          <div class="emb-bento-shot-stage emb-bento-shot-stage--yellow emb-bento-shot-stage--overview">
            <img class="emb-portal-shot emb-portal-shot--primary" src="/feature-images/solutions/event-marketing-email-campaign-hero.jpg" alt="EventHex email campaign overview with completed, failed, and scheduled totals" width="900" height="340" loading="lazy" decoding="async" />
            <img class="emb-portal-shot emb-portal-shot--secondary" src="/feature-images/solutions/event-marketing-email-campaigns.jpg" alt="EventHex Email Campaigns workspace with campaign filters and status controls" width="1117" height="837" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="emb-bento-cell emb-bento-content"><span class="emb-bento-eyebrow">Campaign overview</span><h3>Review the campaign before opening the detail</h3><p>See audience totals and the campaign's current delivery and engagement summary in one view.</p><p>Email shows available sent, delivered, opened, clicked, bounced, complaint, and failed signals. WhatsApp shows available sent, delivered, read, and failed status.</p></div>
      </div>

      <div class="emb-bento-row emb-bento-row--reverse">
        <div class="emb-bento-cell emb-bento-content"><span class="emb-bento-eyebrow">Recipient detail</span><h3>Inspect the person behind each status</h3><p>Open individual dispatch status and available event timestamps, then retry failed recipients or resend from the campaign workspace.</p><p>The recipient view keeps channel, message state, and the latest delivery event together.</p></div>
        <div class="emb-bento-cell emb-bento-visual">
          <div class="emb-bento-shot-stage emb-bento-shot-stage--green emb-bento-shot-stage--recipient">
            <img class="emb-portal-shot emb-portal-shot--primary" src="/feature-images/solutions/event-marketing-audience-builder.jpg" alt="EventHex campaign audience builder with event and people-segment sources" width="1117" height="837" loading="lazy" decoding="async" />
            <img class="emb-portal-shot emb-portal-shot--secondary" src="/feature-images/solutions/event-marketing-audience-panel.jpg" alt="EventHex audience detail showing recipient filters and estimated reach" width="770" height="754" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>

      <div class="emb-bento-row">
        <div class="emb-bento-cell emb-bento-visual">
          <div class="emb-bento-shot-stage emb-bento-shot-stage--blue emb-bento-shot-stage--operations">
            <img class="emb-portal-shot emb-portal-shot--primary" src="/feature-images/solutions/event-marketing-email-campaigns.jpg" alt="EventHex Email Campaigns list with search and delivery-status filters" width="1117" height="837" loading="lazy" decoding="async" />
            <img class="emb-portal-shot emb-portal-shot--secondary" src="/feature-images/solutions/event-marketing-whatsapp-campaigns.jpg" alt="EventHex WhatsApp Campaigns list with search and delivery-status filters" width="1117" height="837" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="emb-bento-cell emb-bento-content"><span class="emb-bento-eyebrow">Campaign operations</span><h3>Keep the list usable after the first send</h3><p>Search, filter, inspect, cancel an eligible scheduled send, refresh campaign counts, and retry failed recipient dispatches.</p><p>Permanent bounces, complaints, and unsubscribes are excluded from later marketing email sends.</p></div>
      </div>

      <div class="emb-bento-row emb-bento-row--reverse">
        <div class="emb-bento-cell emb-bento-content"><span class="emb-bento-eyebrow">Connected senders</span><h3>Send as your organization</h3><p>Marketing campaigns use the organization's connected email identity or official WhatsApp Business account.</p><p>Sender, channel, audience, timing, and campaign status remain visible in the same operational workflow.</p></div>
        <div class="emb-bento-cell emb-bento-visual">
          <div class="emb-bento-shot-stage emb-bento-shot-stage--pink emb-bento-shot-stage--senders">
            <img class="emb-portal-shot emb-portal-shot--primary" src="/feature-images/solutions/event-marketing-email-campaigns.jpg" alt="EventHex organization workspace for email campaigns" width="1117" height="837" loading="lazy" decoding="async" />
            <img class="emb-portal-shot emb-portal-shot--secondary" src="/feature-images/solutions/event-marketing-whatsapp-campaigns.jpg" alt="EventHex organization workspace for WhatsApp campaigns" width="1117" height="837" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="emuc-suites" aria-labelledby="emuc-title">
  <div class="emuc-suites__inner">
    <header class="emuc-header">
      <h2 id="emuc-title" class="emuc-title animate-on-scroll" data-animation="fadeInUp">Use Event History Without Making Every <span class="ds-hl">Campaign Look the Same</span></h2>
      <p class="emuc-subtitle animate-on-scroll" data-animation="fadeInUp">Start from the audience and message each event actually needs.</p>
    </header>

    <div class="emuc-tabs animate-on-scroll" data-animation="fadeInUp" role="tablist" aria-label="Event marketing use cases">
      {useCases.map((useCase, index) => (
        <button
          class:list={["emuc-tab", { "emuc-tab--active": index === 0 }]}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`emuc-panel-${useCase.id}`}
          id={`emuc-tab-${useCase.id}`}
          data-target={useCase.id}
        >
          {useCase.label}
        </button>
      ))}
    </div>

    <div class="emuc-box animate-on-scroll" data-animation="fadeInUp">
      {useCases.map((useCase, index) => (
        <article
          class:list={["emuc-panel", { "emuc-panel--active": index === 0 }]}
          id={`emuc-panel-${useCase.id}`}
          role="tabpanel"
          aria-labelledby={`emuc-tab-${useCase.id}`}
          data-panel={useCase.id}
        >
          <div class="emuc-panel__content">
            <h3>{useCase.label}</h3>
            <p>{useCase.description}</p>
            <span class="emuc-panel__eyebrow">Campaign focus</span>
            <ul>
              {useCase.checklist.map((item) => (
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>{item}</li>
              ))}
            </ul>
          </div>
          <div class="emuc-panel__visual">
            <div class="emuc-showcase">
              <img src={useCase.image} alt={useCase.imageAlt} loading="lazy" decoding="async" />
              <span class="emuc-showcase__label">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14v9H3zM3 7l7 4.5L17 7"></path></svg>
                {useCase.visualLabel}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="emr-journeys ds-stage" aria-labelledby="emr-journeys-title">
  <div class="emr-journeys__shell">
    <header class="emr-journeys__heading animate-on-scroll" data-animation="fadeInUp">
      <h2 id="emr-journeys-title"><span class="emr-journeys__title-line emr-journeys__title-line--plain">Campaigns Connect to More</span><span class="emr-journeys__title-line ds-hl">Than One Attendee Journey</span></h2>
      <p>Use Event Marketing for planned promotional outreach. Continue to the dedicated workflow when the job changes.</p>
    </header>
    <div class="emr-journeys__grid">
      {related.map(([title, copy, href], index) => (
        <article class="emr-journeys__card animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
          <div class="emr-journeys__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d={index === 0 ? "M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" : index === 1 ? "M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z" : index === 2 ? "M18 8a3 3 0 1 0-3-3M6 15a3 3 0 1 0 3 3M18 19a3 3 0 1 0-3-3M8.6 13.5l6.8 3M15.4 7.5l-6.8 3" : "M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"}></path>
            </svg>
          </div>
          <h3><a href={href}>{title}</a></h3>
          <p>{copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const suite = document.querySelector<HTMLElement>(".emuc-suites");
    if (!suite) return;

    const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>(".emuc-tab"));
    const panels = Array.from(suite.querySelectorAll<HTMLElement>(".emuc-panel"));
    let rotationId: number | undefined;

    const activateTab = (tab: HTMLButtonElement) => {
      const targetId = tab.dataset.target;
      tabs.forEach((item) => {
        item.classList.remove("emuc-tab--active");
        item.setAttribute("aria-selected", "false");
      });
      panels.forEach((panel) => panel.classList.remove("emuc-panel--active"));
      tab.classList.add("emuc-tab--active");
      tab.setAttribute("aria-selected", "true");
      suite.querySelector<HTMLElement>(`#emuc-panel-${targetId}`)?.classList.add("emuc-panel--active");
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };
    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateTab(tabs[(current + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => { activateTab(tab); startRotation(); }));
    suite.addEventListener("mouseenter", stopRotation);
    suite.addEventListener("mouseleave", startRotation);
    suite.addEventListener("focusin", stopRotation);
    suite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) startRotation();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? stopRotation() : startRotation());
    startRotation();
  });
</script>

<style>
  /* v5: stage + glass alternating bento, tabs, glass journeys. */
  .emb-bento-section { padding: var(--ds-section-y) var(--ds-gutter); }
  .emb-bento-container { max-width: var(--ds-container); margin: 0 auto; }
  .emb-bento-header { max-width: 850px; margin: 0 auto 56px; text-align: center; }
  .emb-bento-header h2 { margin: 0; font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--ds-ink); }
  .emb-bento-header p { max-width: 650px; margin: 14px auto 0; color: var(--ds-body); font: 400 18px/1.6 var(--ds-font-body); }
  .emb-bento-grid { display: flex; flex-direction: column; gap: 20px; }
  .emb-bento-row { display: grid; grid-template-columns: 1fr 1fr; background: var(--ds-glass-fill); border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); overflow: hidden; }
  .emb-bento-cell { display: flex; flex-direction: column; justify-content: center; padding: 3rem; }
  .emb-bento-visual { align-items: center; }
  .emb-bento-shot-stage { position: relative; isolation: isolate; width: 100%; height: clamp(300px,30vw,360px); border-radius: var(--ds-r-lg); overflow: hidden; }
  .emb-bento-shot-stage--yellow { background: linear-gradient(180deg,var(--ds-warning-soft),var(--ds-warning-soft) 45%,var(--ds-surface)); }
  .emb-bento-shot-stage--green { background: linear-gradient(180deg,var(--ds-cat-teal-bg),var(--ds-surface-tab) 45%,var(--ds-surface)); }
  .emb-bento-shot-stage--blue { background: linear-gradient(180deg,var(--ds-surface-tint),var(--ds-surface-tab) 45%,var(--ds-surface)); }
  .emb-bento-shot-stage--pink { background: linear-gradient(180deg,var(--ds-cat-red-bg),var(--ds-surface-tab) 45%,var(--ds-surface)); }
  .emb-portal-shot { position: absolute; display: block; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); object-fit: cover; object-position: left top; background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .emb-portal-shot--primary { top: 22px; left: 5%; z-index: 1; width: 76%; height: auto; }
  .emb-portal-shot--secondary { right: 5%; bottom: 18px; z-index: 2; width: 64%; height: auto; }
  .emb-bento-shot-stage--overview .emb-portal-shot--primary { top: 38px; width: 90%; }
  .emb-bento-shot-stage--overview .emb-portal-shot--secondary { width: 56%; }
  .emb-bento-shot-stage--recipient .emb-portal-shot--primary { width: 80%; }
  .emb-bento-shot-stage--recipient .emb-portal-shot--secondary { width: 50%; }
  .emb-bento-shot-stage--operations .emb-portal-shot--primary,
  .emb-bento-shot-stage--senders .emb-portal-shot--primary { width: 72%; }
  .emb-bento-shot-stage--operations .emb-portal-shot--secondary,
  .emb-bento-shot-stage--senders .emb-portal-shot--secondary { width: 72%; }
  .emb-bento-eyebrow { display: block; margin-bottom: 1rem; color: var(--ds-indigo); font: 500 .875rem/1.2 var(--ds-font-body); text-transform: uppercase; letter-spacing: .05em; }
  .emb-bento-content h3 { margin: 0 0 1.25rem; color: var(--ds-ink); font-family: var(--ds-font-heading); font-size: var(--ds-h3); font-weight: 500; line-height: 1.15; letter-spacing: -0.025em; }
  .emb-bento-content p { margin: 0 0 1rem; color: var(--ds-body); font: 400 1.0625rem/1.55 var(--ds-font-body); }
  .emb-bento-content p:last-child { margin-bottom: 0; }

  /* Tabbed use-case pattern. */
  .emuc-suites { padding: var(--ds-section-y) var(--ds-gutter); background: var(--ds-white); color: var(--ds-ink); }
  .emuc-suites__inner { width: min(1080px,100%); margin: 0 auto; }
  .emuc-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 32px; text-align: center; }
  .emuc-title { max-width: 880px; margin: 0 0 16px; color: var(--ds-ink); font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; }
  .emuc-subtitle { margin: 0; color: var(--ds-body); font: 400 18px/1.6 var(--ds-font-body); }
  .emuc-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; width: fit-content; max-width: 100%; margin: 0 auto 40px; padding: 6px; border: 1px solid var(--ds-line-strong); border-radius: 999px; background: var(--ds-surface-tab); }
  .emuc-tab { padding: 8px 18px; border: 1px solid transparent; border-radius: 999px; color: var(--ds-cat-slate); background: transparent; cursor: pointer; font: 500 13.5px/1.2 var(--ds-font-body); transition: background .2s ease,color .2s ease,box-shadow .2s ease; }
  .emuc-tab:hover { color: var(--ds-ink-2); background: color-mix(in srgb, var(--ds-white) 65%, transparent); }
  .emuc-tab--active { border-color: var(--ds-line-strong); color: var(--ds-blue); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .emuc-box { background: transparent; }
  .emuc-panel { --emuc-panel-tint:var(--ds-warning-soft); --emuc-panel-border:var(--ds-line-strong); display: none; grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: center; gap: 64px; padding: 52px 64px; border: 1px solid var(--emuc-panel-border); border-radius: var(--ds-r-xl); background: linear-gradient(135deg,var(--emuc-panel-tint),var(--ds-white) 72%); animation: emuc-fade-in .4s ease forwards; }
  .emuc-panel:nth-child(2) { --emuc-panel-tint:var(--ds-surface); --emuc-panel-border:var(--ds-cat-sky-bg); }
  .emuc-panel:nth-child(3) { --emuc-panel-tint:var(--ds-surface-tab); --emuc-panel-border:var(--ds-surface-tint); }
  .emuc-panel:nth-child(4) { --emuc-panel-tint:var(--ds-surface); --emuc-panel-border:var(--ds-line-strong); }
  .emuc-panel--active { display: grid; }
  @keyframes emuc-fade-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
  .emuc-panel__content h3 { margin: 0 0 18px; color: var(--ds-ink); font-family: var(--ds-font-heading); font-size: var(--ds-h3); font-weight: 500; line-height: 1.15; letter-spacing: -0.025em; }
  .emuc-panel__content > p { margin: 0 0 28px; color: var(--ds-body); font: 400 16px/1.6 var(--ds-font-body); }
  .emuc-panel__eyebrow { display: block; margin-bottom: 16px; color: var(--ds-label); font: 500 11px/1.2 var(--ds-font-body); letter-spacing: .12em; text-transform: uppercase; }
  .emuc-panel__content ul { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .emuc-panel__content li { display: flex; align-items: flex-start; gap: 10px; color: var(--ds-muted); font: 500 14.5px/1.4 var(--ds-font-body); }
  .emuc-panel__content li svg { flex: 0 0 14px; width: 14px; height: 14px; margin-top: 2px; fill: none; stroke: var(--ds-blue); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .emuc-panel__visual { min-width: 0; }
  .emuc-showcase { position: relative; display: flex; flex-direction: column; gap: 12px; }
  .emuc-showcase > img { display: block; width: 100%; aspect-ratio: 1117/837; object-fit: contain; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .emuc-showcase__label { display: inline-flex; align-items: center; justify-content: center; gap: 7px; color: var(--ds-muted); font: 500 13px/1.2 var(--ds-font-body); }
  .emuc-showcase__label svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* Related-workflow glass cards. */
  .emr-journeys { padding: var(--ds-section-y) var(--ds-gutter); }
  .emr-journeys__shell { max-width: var(--ds-container); margin: 0 auto; }
  .emr-journeys__heading { padding: 0 0 clamp(36px,4vw,56px); text-align: center; }
  .emr-journeys__heading h2 { margin: 0 auto; color: var(--ds-ink); font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; }
  .emr-journeys__heading h2 .emr-journeys__title-line { display: block; }
  .emr-journeys__heading p { max-width: 650px; margin: 14px auto 0; color: var(--ds-body); font: 400 18px/1.6 var(--ds-font-body); }
  .emr-journeys__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 20px; }
  .emr-journeys__card { min-height: 250px; padding: 28px; background: var(--ds-glass-fill); border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .emr-journeys__icon { display: inline-flex; width: 30px; height: 30px; margin-bottom: 28px; color: var(--ds-blue); }
  .emr-journeys__icon svg { width: 100%; height: 100%; }
  .emr-journeys__card h3 { max-width: 230px; margin: 0 0 14px; color: var(--ds-ink); font-family: var(--ds-font-heading); font-size: 21px; font-weight: 500; line-height: 1.15; }
  .emr-journeys__card h3 a { color: inherit; text-decoration: none; }
  .emr-journeys__card p { margin: 0; color: var(--ds-body); font: 400 15px/1.5 var(--ds-font-body); }
  @media (max-width: 900px) {
    .emb-bento-row { display: flex; flex-direction: column; }
    .emb-bento-cell { padding: 2.25rem 1.5rem; }
    .emb-bento-content { order: 1; }
    .emb-bento-visual { order: 2; padding-top: 0; }
    .emuc-panel { grid-template-columns: 1fr; gap: 48px; padding: 48px; }
    .emr-journeys__grid { grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 640px) {
    .emb-bento-cell { padding: 1.75rem 1.1rem; }
    .emb-bento-content p { font-size: 1rem; }
    .emuc-tabs { width: 100%; flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; border-radius: 20px; scrollbar-width: none; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
    .emuc-tabs::-webkit-scrollbar { display: none; }
    .emuc-tab { flex: 0 0 auto; padding-inline: 14px; white-space: nowrap; scroll-snap-align: start; }
    .emuc-panel { gap: 38px; padding: 32px 24px; border-radius: var(--ds-r-lg); }
    .emr-journeys__grid { grid-template-columns: 1fr; }
    .emr-journeys__card { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .emuc-panel { animation: none; } }
</style>
