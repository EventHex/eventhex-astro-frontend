<section id="em-channel-choice" class="emg-flow-section">
  <div class="emg-flow-header">
    <h2 class="emg-flow-title animate-on-scroll" data-animation="fadeInUp">
      <span class="emg-flow-title__line">Choose How Each Audience</span>
      <span class="emg-flow-title__line">Should Hear From You</span>
    </h2>
    <p class="emg-flow-subtitle animate-on-scroll" data-animation="fadeInUp">
      <span class="emg-flow-subtitle__line">Start with the campaign goal and audience. Then build the message</span>
      <span class="emg-flow-subtitle__line">in the channel that fits the outreach.</span>
    </p>
  </div>

  <div class="emg-flow-quad">
    <article class="emg-flow-quad__cell animate-on-scroll" data-animation="fadeInUp">
      <h3 class="emg-flow-quad__title">Email campaigns</h3>
      <p class="emg-flow-quad__text">Create an editable email, write the subject, add personalization, attach supporting files, and preview the message before review.</p>
    </article>
    <div class="emg-flow-quad__cell emg-flow-quad__cell--media animate-on-scroll" data-animation="fadeInRight">
      <div class="emg-flow-composite">
        <img
          class="emg-flow-capture emg-flow-capture--primary"
          src="/feature-images/solutions/event-marketing-email-campaigns.jpg"
          alt="EventHex Email Campaigns portal showing campaign filters and creation controls"
          width="1117"
          height="837"
          loading="lazy"
          decoding="async"
        />
        <img
          class="emg-flow-capture emg-flow-capture--secondary"
          src="/feature-images/solutions/event-marketing-audience-builder.jpg"
          alt="EventHex audience selection workflow for an email campaign"
          width="1117"
          height="837"
          loading="lazy"
          decoding="async"
        />
        <span class="emg-flow-composite__status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Preview ready</span>
        <span class="emg-flow-composite__action">Continue to review</span>
      </div>
    </div>
    <div class="emg-flow-quad__cell emg-flow-quad__cell--media animate-on-scroll" data-animation="fadeInLeft">
      <div class="emg-flow-composite">
        <img
          class="emg-flow-capture emg-flow-capture--primary"
          src="/feature-images/solutions/event-marketing-whatsapp-campaigns.jpg"
          alt="EventHex WhatsApp Campaigns portal showing campaign filters and creation controls"
          width="1117"
          height="837"
          loading="lazy"
          decoding="async"
        />
        <img
          class="emg-flow-capture emg-flow-capture--secondary emg-flow-capture--audience"
          src="/feature-images/solutions/event-marketing-audience-panel.jpg"
          alt="EventHex audience selection workflow for a WhatsApp campaign"
          width="770"
          height="754"
          loading="lazy"
          decoding="async"
        />
        <span class="emg-flow-composite__status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Template approved</span>
        <span class="emg-flow-composite__action">Preview message</span>
      </div>
    </div>
    <article class="emg-flow-quad__cell animate-on-scroll" data-animation="fadeInUp">
      <h3 class="emg-flow-quad__title">WhatsApp campaigns</h3>
      <p class="emg-flow-quad__text">Choose an approved WhatsApp template, map its variables, add supported media, and review the final message before sending.</p>
    </article>
    <span class="emg-flow-quad__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path></svg>
    </span>
  </div>
  <p class="emg-content-note">Use campaigns for planned promotional outreach. For trigger-based operational alerts, continue to <a href="/event-notifications/">Event Notifications</a>. For attendee conversations, continue to <a href="/whatsapp-event-concierge/">WhatsApp Concierge</a>.</p>
</section>

<section class="emg-dark-band" aria-labelledby="emg-audience-title">
  <div class="emg-heading">
    <h2 id="emg-audience-title" class="emg-heading__title animate-on-scroll" data-animation="fadeInUp">Build the Audience From People Already Connected to Your Events</h2>
  </div>
  <div class="emg-grid-section">
    <div class="emg-cap">
      <article class="emg-cap__cell animate-on-scroll" data-animation="fadeInUp">
        <h3 class="emg-cap__label">Current-event registrants</h3><p class="emg-cap__desc">Reach all registrants or narrow the audience to selected tickets and registration forms.</p>
        <div class="emg-cap__visual"><div class="emg-cap__card"><span class="emg-cap__card-head">Leadership Summit 2026</span><div class="emg-cap__field"><span>All access pass</span><i></i></div><div class="emg-cap__field"><span>Partner pass</span><i></i></div><div class="emg-cap__field emg-cap__field--add"><span>932 unique recipients</span></div></div></div>
      </article>
      <article class="emg-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay="60">
        <span class="emg-cap__petal emg-cap__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
        <span class="emg-cap__petal emg-cap__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
        <h3 class="emg-cap__label">Previous-event audiences</h3><p class="emg-cap__desc">Choose registrants from other events in the organizer workspace for the next relevant invitation.</p>
        <div class="emg-cap__visual"><div class="emg-cap__stack"><div class="emg-cap__ticket"><span>Leadership Summit 2025</span><small>1,204</small></div><div class="emg-cap__ticket is-active"><span>Partner Forum 2025</span><small>486</small></div><div class="emg-cap__ticket"><span>Product Week 2024</span><small>728</small></div></div></div>
      </article>
      <article class="emg-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay="120">
        <span class="emg-cap__petal emg-cap__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
        <span class="emg-cap__petal emg-cap__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
        <h3 class="emg-cap__label">People segments</h3><p class="emg-cap__desc">Use available lifecycle segments such as first-time, returning, loyal, lapsed, or no-show-prone people.</p>
        <div class="emg-cap__visual"><div class="emg-cap__chips"><span class="is-active">Returning</span><span>First-time</span><span>Loyal</span><span>Lapsed</span><span>No-show prone</span></div></div>
      </article>
      <article class="emg-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay="180">
        <h3 class="emg-cap__label">Saved audiences and exclusions</h3><p class="emg-cap__desc">Reuse a saved audience, exclude people already registered, and check unique email or phone counts before review.</p>
        <div class="emg-cap__visual"><div class="emg-cap__card"><span class="emg-cap__card-head">Audience rules</span><div class="emg-cap__field"><span>Saved: GCC partners</span><i></i></div><div class="emg-cap__field"><span>Exclude: already registered</span><i></i></div></div></div>
      </article>
      <article class="emg-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay="240">
        <span class="emg-cap__petal emg-cap__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
        <h3 class="emg-cap__label">One connected campaign workflow</h3><p class="emg-cap__desc">Choose the audience, channel, message, timing, and then follow recipient status from the same workspace.</p>
        <div class="emg-cap__visual"><div class="emg-cap__chips"><span>Audience</span><span>Channel</span><span>Message</span><span class="is-active">Review</span><span>Schedule</span><span>Monitor</span></div></div>
      </article>
    </div>
  </div>
</section>

<style>
  /* Event Registration comparison-section pattern. */
  .emg-flow-section { display: flex; flex-direction: column; align-items: center; padding: clamp(72px,9vw,112px) 24px; background: #fff; }
  .emg-flow-header { display: flex; flex-direction: column; align-items: center; max-width: 1100px; margin-bottom: 24px; text-align: center; }
  .emg-flow-title { margin: 0 0 12px; font: 500 clamp(28px,4.2vw,48px)/1.1 var(--font-heading); letter-spacing: -.04em; background: linear-gradient(98deg,var(--heading-dark) 43.06%,#8f8f8f 91.81%); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .emg-flow-title__line, .emg-flow-subtitle__line { display: block; }
  .emg-flow-subtitle { max-width: 640px; margin: 0; color: var(--subheading-gray); font: 400 18px/1.5 var(--font-body); }
  .emg-flow-quad { position: relative; display: grid; grid-template: 1fr 1fr / 1fr 1fr; width: 100%; max-width: 1180px; margin: 24px auto; }
  .emg-flow-quad__cross { position: absolute; left: 50%; top: 50%; z-index: 1; width: 18px; height: 18px; transform: translate(-50%,-50%); line-height: 0; pointer-events: none; }
  .emg-flow-quad__cell { display: flex; flex-direction: column; justify-content: center; min-height: 260px; padding: 56px 48px; border-right: 1px solid #eef0f3; border-bottom: 1px solid #eef0f3; }
  .emg-flow-quad__cell:nth-child(2n) { border-right: 0; }
  .emg-flow-quad__cell:nth-child(n+3) { border-bottom: 0; }
  .emg-flow-quad__title { margin: 0 0 16px; color: var(--heading-dark); font: 600 clamp(24px,2.6vw,32px)/1.1 var(--font-heading); letter-spacing: -.03em; }
  .emg-flow-quad__text { max-width: 40ch; margin: 0; color: var(--subheading-gray); font: 400 16px/1.6 var(--font-body); }
  .emg-flow-quad__cell--media { align-items: center; min-height: 360px; padding: 18px 22px; overflow: hidden; }
  .emg-flow-composite { position: relative; width: 100%; height: 320px; overflow: visible; }
  .emg-flow-capture { position: absolute; display: block; object-fit: cover; object-position: top left; border: 1px solid rgba(209,214,226,.92); border-radius: 12px; background: #fff; box-shadow: 0 16px 34px rgba(31,41,72,.14); }
  .emg-flow-capture--primary { top: 42px; left: 20px; z-index: 1; width: 74%; height: 62%; }
  .emg-flow-capture--secondary { right: 18px; bottom: 20px; z-index: 2; width: 64%; height: 52%; }
  .emg-flow-capture--audience { object-position: top center; }
  .emg-flow-composite__status, .emg-flow-composite__action { position: absolute; z-index: 5; display: inline-flex; align-items: center; white-space: nowrap; border-radius: 10px; font: 700 11px/1 var(--font-body); box-shadow: 0 10px 24px rgba(31,41,72,.16); }
  .emg-flow-composite__status { top: 14px; left: 14px; gap: 7px; padding: 9px 11px; border: 1px solid #cfead9; color: #18864b; background: #effbf4; }
  .emg-flow-composite__status svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .emg-flow-composite__action { right: 14px; bottom: 14px; padding: 10px 13px; color: #fff; background: #4b65f6; }
  .emg-content-note { max-width: 850px; margin: 10px auto 0; color: var(--subheading-gray); font: 400 14px/1.6 var(--font-body); text-align: center; }
  .emg-content-note a { color: var(--brand-blue); font-weight: 650; }

  /* Event Registration dark capability-grid pattern. */
  .emg-dark-band { position: relative; overflow: hidden; padding: clamp(64px,8vw,96px) 0 clamp(70px,8vw,100px); background: radial-gradient(130% 42% at 50% 0%,rgba(92,138,255,.22),rgba(124,108,255,.1) 45%,transparent 72%),#000; }
  .emg-heading { max-width: 920px; margin: 0 auto; padding: 0 24px 8px; text-align: center; }
  .emg-heading__title { margin: 0; font: 500 clamp(36px,5vw,56px)/1.1 var(--font-heading); letter-spacing: -.03em; background: linear-gradient(100deg,#fff,#f2f0ff 26%,#c9c2ff 52%,#a79aff 74%,#7d8dff); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .emg-grid-section { max-width: 1140px; margin: 0 auto; padding: clamp(40px,5vw,72px) 24px 0; }
  .emg-cap { display: grid; grid-template-columns: repeat(6,1fr); border: 1px solid #3b3a47; border-radius: 16px; overflow: hidden; }
  .emg-cap__cell { position: relative; grid-column: span 2; display: flex; flex-direction: column; min-height: 420px; padding: 36px 32px; border-right: 1px solid #3b3a47; border-bottom: 1px solid #3b3a47; }
  .emg-cap__cell:nth-child(n+4) { grid-column: span 3; border-bottom: 0; }
  .emg-cap__cell:nth-child(3), .emg-cap__cell:nth-child(5) { border-right: 0; }
  .emg-cap__petal { position: absolute; left: 0; z-index: 2; width: 28px; height: 28px; line-height: 0; pointer-events: none; }
  .emg-cap__petal--top { top: 0; transform: translate(-50%,-50%); }
  .emg-cap__petal--bottom { bottom: 0; transform: translate(-50%,50%); }
  .emg-cap__label { margin: 0 0 14px; color: #fff; font: 700 15px/1.2 var(--font-heading); letter-spacing: -.01em; }
  .emg-cap__desc { max-width: 34ch; margin: 0; color: rgba(255,255,255,.62); font: 400 .9375rem/1.38 var(--font-body); }
  .emg-cap__visual { display: flex; align-items: flex-end; justify-content: center; flex: 1; margin-top: 32px; }
  .emg-cap__card, .emg-cap__ticket, .emg-cap__chips span { border: 1px solid rgba(255,255,255,.12); border-radius: 12px; background: rgba(255,255,255,.04); }
  .emg-cap__card { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 290px; padding: 16px; border-radius: 16px; }
  .emg-cap__card-head { color: rgba(255,255,255,.55); font: 400 12px/1.2 var(--font-body); }
  .emg-cap__field { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 9px; color: rgba(255,255,255,.86); background: rgba(255,255,255,.05); font: 400 13px/1.2 var(--font-body); }
  .emg-cap__field i { width: 32%; height: 6px; border-radius: 99px; background: rgba(255,255,255,.14); }
  .emg-cap__field--add { justify-content: center; border: 1px dashed rgba(255,255,255,.2); color: #a8b6ff; background: transparent; }
  .emg-cap__stack { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 300px; }
  .emg-cap__ticket { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 14px; color: rgba(255,255,255,.86); font: 400 13px/1.2 var(--font-body); }
  .emg-cap__ticket small { color: rgba(255,255,255,.5); }
  .emg-cap__ticket.is-active { border-color: rgba(150,170,255,.5); background: rgba(120,140,255,.14); }
  .emg-cap__chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .emg-cap__chips span { padding: 7px 12px; border-radius: 99px; color: rgba(255,255,255,.72); font: 400 12.5px/1.2 var(--font-body); }
  .emg-cap__chips span.is-active { border-color: rgba(150,170,255,.55); color: #fff; background: rgba(120,140,255,.16); }
  @media (max-width: 900px) {
    .emg-cap__cell { grid-column: span 3; }
    .emg-cap__cell:nth-child(3) { border-right: 1px solid #3b3a47; }
    .emg-cap__cell:nth-child(even) { border-right: 0; }
    .emg-cap__cell:nth-child(n+4) { grid-column: span 3; }
  }
  @media (max-width: 768px) {
    .emg-flow-section { padding-inline: 18px; }
    .emg-flow-quad { grid-template-columns: 1fr; }
    .emg-flow-quad__cross { display: none; }
    .emg-flow-quad__cell { min-height: 0; padding: 32px 20px; border-right: 0; border-bottom: 1px solid #eef0f3; }
    .emg-flow-quad__cell:nth-child(3) { order: 4; border-bottom: 0; }
    .emg-flow-quad__cell:nth-child(4) { order: 3; border-bottom: 1px solid #eef0f3; }
    .emg-flow-quad__cell--media { padding: 16px 20px 32px; }
    .emg-flow-composite { height: 285px; }
    .emg-cap { grid-template-columns: 1fr; }
    .emg-cap__cell, .emg-cap__cell:nth-child(n+4) { grid-column: 1; min-height: 380px; border-right: 0; border-bottom: 1px solid #3b3a47; }
    .emg-cap__cell:last-child { border-bottom: 0; }
    .emg-cap__petal { display: none; }
  }
</style>

