    .enx-builder__right {
      max-width: 560px;
    }

    .enx-builder__right {
      justify-self: start;
    }

    .enx-faq__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .enx-faq__sidebar {
      position: static;
    }

    .enx-faq__heading {
