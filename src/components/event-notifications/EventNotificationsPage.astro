      radial-gradient(circle 300px at 97% 36%, rgba(255, 182, 213, 0.2), transparent 100%),
      radial-gradient(circle 340px at 94% 88%, rgba(130, 170, 255, 0.18), transparent 100%),
      radial-gradient(circle 300px at 5% 92%, rgba(255, 224, 150, 0.16), transparent 100%),
