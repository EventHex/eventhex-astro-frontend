              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Quick Answers
        </span>
        <h2 class="enx-faq__heading" id="enx-faq-title">
          Questions about EventHex event notifications
        </h2>
        <p class="enx-faq__intro">
          Answers based on the current notification, attendee-app, and reminder implementation.
        </p>
        <a href="/contact-en/" class="enx-faq__cta">
