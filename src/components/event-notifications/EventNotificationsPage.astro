  .enx-bento__points li {
    position: relative;
    padding-left: 22px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: #475467;
  }

  .enx-bento__points li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-blue);
