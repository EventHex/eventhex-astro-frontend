---
// Event notifications feature page (EventHex Â· /event-notifications/).
// Section patterns follow the Event Registration and Speaker Management references:
// split hero + workflow rail + spotlight panels + choice cards + bento bands +
// delivery journey + category grid + lifecycle cards + destination links +
// split FAQ + dark closing CTA.
// Copy is taken from the approved event-notifications content deck.

interface Props {
  faqs: Array<[string, string]>;
}

const { faqs } = Astro.props;

const workflow = [
  { label: "Draft", text: "Write the alert" },
  { label: "Classify", text: "Set type and priority" },
  { label: "Target", text: "Choose the audience" },
  { label: "Schedule", text: "Pick the send time" },
  { label: "Deliver", text: "Send through push" },
  { label: "Review", text: "Check send status" },
];

const builderFields = [
  {
    label: "Notification type",
    text: "Choose general, event reminder, event update, event cancelled, announcement, or another available system type.",
  },
  { label: "Priority", text: "Mark the message low, normal, high, or urgent." },
  { label: "Optional image", text: "Add a valid image URL for a richer push notification." },
  { label: "Sound", text: "Use the available default, notification, or alert sound setting." },
];

const audienceOptions = [
  {
    label: "Event audience",
    text: "Send to registered event attendees with push notifications enabled. Best for event-wide updates and reminders.",
  },
  {
    label: "Focused audience",
    text: "Choose specific users or an available user segment when the alert is not for everyone. Push delivery still requires a valid device token and attendee permission.",
  },
];

const sendMoments = [
  {
    label: "Scheduled notifications",
    text: "The processor checks ready scheduled notifications and moves them through sending to sent or failed.",
  },
  {
    label: "Draft control",
    text: "Prepare the copy and audience before the notification enters the send queue.",
  },
  {
    label: "Immediate send",
    text: "Send an eligible saved notification when the event team needs to act now.",
  },
  { label: "Cancel before send", text: "Cancel a notification that has not already been sent." },
];

type StepImage = {
  src: string;
  alt: string;
  width: number;
  height: number;
};

type DeliveryStep = {
  label: string;
  text: string;
  art: string;
  image: StepImage;
};

const deliverySteps: DeliveryStep[] = [
  {
    label: "Resolve recipients",
    text: "Find matching users or ticket registrations with push enabled.",
    art: "audience",
    image: {
      src: "/images/event-notifications/app/push-resolve-recipients.webp",
      alt: "EventHex registration list holding the attendee records a push alert is resolved from",
      width: 960,
      height: 519,
    },
  },
  {
    label: "Collect active tokens",
    text: "Use the device tokens stored for those recipients.",
    art: "tokens",
    image: {
      src: "/images/event-notifications/app/push-active-devices.webp",
      alt: "EventHex app analytics audience view showing the devices attendees open the event app on",
      width: 936,
      height: 623,
    },
  },
  {
    label: "Send the push",
    text: "Pass the title, body, image, type, priority, and data to Firebase.",
    art: "send",
    image: {
      src: "/images/event-notifications/app/push-send-alert.webp",
      alt: "EventHex notification composer with a title, type, priority, target audience, and message filled in",
      width: 668,
      height: 486,
    },
  },
  {
    label: "Clean invalid tokens",
    text: "Remove invalid FCM tokens returned by the delivery service.",
    art: "cleanup",
    image: {
      src: "/images/event-notifications/app/push-delivery-response.webp",
      alt: "EventHex notification log listing each recipient with its delivery status and a resend action",
      width: 936,
      height: 444,
    },
  },
  {
    label: "Store the result",
    text: "Record targeted, sent, failed, delivery-rate, and status fields from the push attempt.",
    art: "result",
    image: {
      src: "/images/event-notifications/app/push-job-result.webp",
      alt: "EventHex notification log summary counting total, delivered, opened, failed, and bounced sends",
      width: 936,
      height: 414,
    },
  },
];

// Every row opens the same attendee-app Notification Settings screen, framed on
// its own category card so each visual explains the copy beside it.
const appControls = [
  {
    label: "New messages",
    text: "Notify an attendee when a new direct message arrives.",
    shotAlt:
      "EventHex attendee-app notification settings with Message Notifications enabled",
  },
  {
    label: "Connection requests",
    text: "Alert an attendee to a new networking request.",
    shotAlt:
      "EventHex attendee-app notification settings with Connection Request Notifications enabled",
  },
  {
    label: "Meeting requests",
    text: "Send an alert when a meeting request arrives.",
    shotAlt:
      "EventHex attendee-app notification settings with Meeting Request Notifications enabled",
  },
  {
    label: "Session reminders",
    text: "Notify attendees before a saved or upcoming session starts.",
    shotAlt:
      "EventHex attendee-app notification settings with Session Reminder Notifications enabled",
  },
];

const networkingAlerts = [
  {
    label: "Message notifications",
    text: "Let attendees know a conversation has a new message.",
    image: {
      src: "/images/event-notifications/app/reminder-message-notifications.webp",
      alt: "EventHex attendee-app notification settings with Message Notifications switched on",
      width: 303,
      height: 250,
    },
  },
  {
    label: "Connection-request notifications",
    text: "Surface new requests without forcing attendees to keep the app open.",
    image: {
      src: "/images/event-notifications/app/reminder-connection-requests.webp",
      alt: "EventHex attendee-app notification settings with Connection Request Notifications switched on",
      width: 303,
      height: 250,
    },
  },
  {
    label: "Meeting-request notifications",
    text: "Alert participants when a meeting request needs attention.",
    image: {
      src: "/images/event-notifications/app/reminder-meeting-requests.webp",
      alt: "EventHex attendee-app notification settings with Meeting Request Notifications switched on",
      width: 304,
      height: 250,
    },
  },
  {
    label: "Upcoming meeting reminders",
    text: "The meeting lifecycle processor can send a reminder shortly before an accepted meeting.",
    image: {
      src: "/images/event-notifications/app/reminder-session-reminders.webp",
      alt: "EventHex attendee-app notification settings with Session Reminder Notifications switched on",
      width: 303,
      height: 229,
    },
  },
];

const reminderChannels = [
  {
    channel: "email" as const,
    eyebrow: "Email",
    label: "Email reminder path",
    text: "Use an event-aware subject and body with attendee and event variables. Available through the configured event-reminder service.",
    points: [
      "Event-aware subject and body",
      "Attendee and event variables",
      "Configured event-reminder service",
    ],
  },
  {
    channel: "whatsapp" as const,
    eyebrow: "WhatsApp",
    label: "WhatsApp reminder path",
    text: "Use the selected WhatsApp template for a configured reminder time. Requires the corresponding WhatsApp template and channel setup.",
    points: [
      "Selected WhatsApp template",
      "Configured reminder time",
      "Template and channel setup",
    ],
  },
];

const lifecycle = [
  {
    label: "Before the event",
    title: "Prepare the event-start reminder",
    text: "Prepare event-start reminders and essential arrival information for registered attendees.",
    art: "calendar",
    visualLabel: "Reminder scheduled",
    points: [
      "Event-start reminder copy",
      "Email and WhatsApp reminder paths",
      "Scheduled send time",
    ],
    image: {
      src: "/images/event-notifications/app/lifecycle-before-event.webp",
      alt: "EventHex email campaigns view with an event-start reminder campaign already completed",
      width: 936,
      height: 340,
    },
  },
  {
    label: "Agenda changes",
    title: "Push the change while it still matters",
    text: "Push a clear update when a time, room, or session detail changes.",
    art: "agenda",
    visualLabel: "Update queued",
    points: [
      "Room and time-change alerts",
      "Event update notification type",
      "Urgent priority for last-minute moves",
    ],
    image: {
      src: "/images/event-notifications/app/lifecycle-agenda-changes.webp",
      alt: "EventHex agenda and sessions view where a session time, room, and stage can change",
      width: 936,
      height: 414,
    },
  },
  {
    label: "Networking",
    title: "Keep attendee conversations moving",
    text: "Surface new messages, connection requests, meeting requests, and meeting reminders.",
    art: "network",
    visualLabel: "App categories on",
    points: [
      "Message notifications",
      "Connection and meeting requests",
      "Upcoming meeting reminders",
    ],
    image: {
      src: "/images/event-notifications/app/lifecycle-networking.webp",
      alt: "EventHex attendee-app notification settings listing the message, connection, meeting, and session reminder categories",
      width: 917,
      height: 482,
    },
  },
  {
    label: "During the event",
    title: "Send a focused operational alert",
    text: "Send a focused announcement or urgent operational alert to the relevant audience.",
    art: "announce",
    visualLabel: "Announcement sent",
    points: [
      "Event-wide announcements",
      "Focused audience targeting",
      "Targeted, sent, and failed status",
    ],
    image: {
      src: "/images/event-notifications/app/lifecycle-during-event.webp",
      alt: "EventHex notification composer holding an urgent announcement message ready to send",
      width: 668,
      height: 288,
    },
  },
];

const destinations = [
  {
    label: "Event Marketing",
    text: "Build planned email and WhatsApp promotion campaigns.",
    href: "/event-marketing/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  },
  {
    label: "WhatsApp Concierge",
    text: "Give attendees event-aware help inside a conversation.",
    href: "/whatsapp-event-concierge/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.2 7.5L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>`,
  },
  {
    label: "Event Registration",
    text: "Configure the attendee records and confirmations that feed event operations.",
    href: "/event-registration/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`,
  },
  {
    label: "Event Mobile App",
    text: "Explore the attendee surface that receives push and in-app alerts.",
    href: "/event-mobile-app/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18.5h2"/></svg>`,
  },
];
---

<div class="enx-page">
  <!-- 01 Hero -->
  <section class="enx-hero" id="hero">
    <div class="enx-hero__grid">
      <div class="enx-hero__copy">
        <span class="enx-eyebrow animate-on-scroll" data-animation="fadeInDown"
          >Event notification software</span
        >
        <h1 class="enx-hero__title animate-on-scroll" data-animation="fadeInUp">
          Keep attendees informed before and during the event
        </h1>
        <p class="enx-hero__lead animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Create scheduled or immediate push announcements, control the audience, and configure
          attendee-app alerts for messages, connections, meetings, and sessions. EventHex keeps each
          notification tied to the event workflow that created it.
        </p>
        <ul class="enx-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 900ms">
          <li>Scheduled push announcements</li>
          <li>Audience controls</li>
          <li>Attendee-app reminders</li>
        </ul>
        <div class="enx-hero__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1000ms">
          <a class="enx-btn enx-btn--primary" href="/book-a-demo/"
            >Book a Demo <span aria-hidden="true">&rarr;</span></a
          >
          <a class="enx-btn enx-btn--ghost" href="#workflow">See the notification workflow</a>
        </div>
      </div>

      <div class="enx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="enx-hero__visual-card">
          <div class="enx-hero__visual-inner">
            <figure class="enx-hero__shot">
              <img
                src="/images/event-notifications/app/notification-categories.png"
                alt="EventHex attendee-app notification settings with switches for message, connection request, meeting request, and session reminder alerts"
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </figure>

            <div class="enx-hero__chip enx-hero__chip--live">
              <span></span> Attendee app alerts
            </div>
            <div class="enx-hero__chip enx-hero__chip--stat">
              <b>4</b>
              <small>alert categories</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Workflow rail -->
  <section class="enx-rail" id="workflow" aria-label="Draft, target, schedule, send, and review">
    <div class="enx-rail__inner">
      {
        workflow.map((step) => (
          <span class="enx-rail__item">
            <b>{step.label}</b> {step.text}
          </span>
        ))
      }
    </div>
  </section>

  <!-- 03 Spotlight: message builder -->
  <section class="enx-builder" id="notification-builder" aria-labelledby="enx-builder-title">
    <div class="enx-builder__inner">
      <div class="enx-builder__left">
        <span class="enx-eyebrow animate-on-scroll" data-animation="fadeIn">A focused message builder</span>
        <h2 class="enx-builder__title animate-on-scroll" data-animation="fadeInUp" id="enx-builder-title">
          <span class="enx-builder__title-line">Create the alert</span>
          <span class="enx-builder__title-line">attendees need now</span>
        </h2>
        <p class="enx-builder__copy animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 100ms">
          Give each notification a clear title and message, then add the operational context the
          delivery service needs.
        </p>

        <ul class="enx-builder__fields animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 180ms">
          {
            builderFields.map((item) => (
              <li>
                <strong>{item.label}</strong>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>

        <div class="enx-builder__actions animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 260ms">
          <a class="enx-builder__btn enx-builder__btn--dark" href="/book-a-demo/">Book a Demo &rarr;</a>
          <a class="enx-builder__btn enx-builder__btn--light" href="#workflow">See the workflow &rarr;</a>
        </div>
      </div>

      <div class="enx-builder__right animate-on-scroll" data-animation="fadeInUp" style="--anim-delay: 300ms">
        <figure class="enx-shot enx-shot--builder">
          <img
            src="/images/event-notifications/app/notification-builder.png"
            alt="EventHex notification builder with title, notification type, priority, target audience, and message fields"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Type and priority are set on the message, and the target audience selects who receives
            it.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 04 Spotlight: audience -->
  <section class="enx-section enx-soft" id="audience" aria-labelledby="enx-audience-title">
    <div class="enx-wrap">
      <div class="enx-head enx-head--center">
        <span class="enx-eyebrow animate-on-scroll" data-animation="fadeIn">Send to the intended audience</span>
        <h2 class="enx-title animate-on-scroll" data-animation="fadeInUp" id="enx-audience-title">
          Choose who should receive the notification
        </h2>
        <p class="enx-lead animate-on-scroll" data-animation="fadeInUp">
          Target the alert from the attendee records available to the notification service.
        </p>
      </div>

      <div class="enx-quad">
        <article
          class="enx-quad__cell enx-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <span class="enx-quad__index">01</span>
          <h3 class="enx-quad__title">{audienceOptions[0].label}</h3>
          <p class="enx-quad__text">{audienceOptions[0].text}</p>
        </article>

        <div
          class="enx-quad__cell enx-quad__cell--media animate-on-scroll"
          data-animation="fadeInRight"
        >
          <div class="enx-quad__composite">
            <img
              class="enx-quad__screen"
              src="/images/appointments-meetings/app/registered-attendee-directory.png"
              alt="EventHex registration list holding the attendee records an event-wide notification is sent to"
              width="1263"
              height="698"
              loading="lazy"
              decoding="async"
            />
            <span class="enx-quad__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Registered attendees
            </span>
            <span class="enx-quad__action">All attendees</span>
            <img
              class="enx-quad__cursor"
              src="/feature-images/event-registration/cursor.svg"
              alt=""
              aria-hidden="true"
            />
          </div>
        </div>

        <div
          class="enx-quad__cell enx-quad__cell--media animate-on-scroll"
          data-animation="fadeInLeft"
        >
          <div class="enx-quad__composite">
            <img
              class="enx-quad__screen"
              src="/images/event-notifications/app/audience-targeting.png"
              alt="EventHex notification targeting controls for all users, a role, a plan, an organisation, or specific users"
              width="656"
              height="369"
              loading="lazy"
              decoding="async"
            />
            <span class="enx-quad__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Segment selected
            </span>
            <span class="enx-quad__action">Specific users</span>
            <img
              class="enx-quad__cursor"
              src="/feature-images/event-registration/cursor.svg"
              alt=""
              aria-hidden="true"
            />
          </div>
        </div>

        <article
          class="enx-quad__cell enx-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <span class="enx-quad__index">02</span>
          <h3 class="enx-quad__title">{audienceOptions[1].label}</h3>
          <p class="enx-quad__text">{audienceOptions[1].text}</p>
        </article>

        <span class="enx-quad__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e6eaf3" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e6eaf3" transform="scale(1,-1)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e6eaf3" transform="rotate(90)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e6eaf3" transform="rotate(-90)" />
          </svg>
        </span>
      </div>

      <p class="enx-note animate-on-scroll" data-animation="fadeIn">
        The broader All audience option also exists. For event operations, keep each message scoped to
        the relevant event or explicit user set.
      </p>
    </div>
  </section>

  <!-- 05 Dark band bento: send moment -->
  <section class="enx-band" id="timing" aria-labelledby="enx-timing-title">
    <div class="enx-band__heading">
      <span class="enx-band__pill animate-on-scroll" data-animation="fadeIn">
        <span class="enx-band__pill-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="13" r="8" stroke="#4F8CFF" stroke-width="1.7"></circle>
            <path
              d="M12 9.2V13l2.7 1.9"
              stroke="#B08BFF"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path d="M9.4 3.4h5.2" stroke="#B08BFF" stroke-width="1.7" stroke-linecap="round"></path>
          </svg>
        </span>
        Use the right send moment
      </span>
      <h2 class="enx-band__title animate-on-scroll" data-animation="fadeInUp" id="enx-timing-title">
        Send now or prepare the update in advance
      </h2>
      <p class="enx-band__lead animate-on-scroll" data-animation="fadeInUp">
        Keep the message in draft, schedule it for a future time, or send an eligible notification
        immediately.
      </p>
    </div>

    <div class="enx-band__grid-wrap">
      <div class="enx-moments">
        <article
          class="enx-moments__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="0"
        >
          <h3 class="enx-moments__label">{sendMoments[0].label}</h3>
          <p class="enx-moments__desc">{sendMoments[0].text}</p>
          <div class="enx-moments__visual" aria-hidden="true">
            <div class="enx-queue">
              <div class="enx-queue__row is-on">
                <span>Room change</span>
                <b>Scheduled</b>
                <small>2:15 PM</small>
              </div>
              <div class="enx-queue__row">
                <span>Doors open reminder</span>
                <b>Draft</b>
                <small>No send time</small>
              </div>
              <div class="enx-queue__row">
                <span>Keynote moved</span>
                <b>Sent</b>
                <small>Today, 09:05</small>
              </div>
            </div>
          </div>
        </article>

        <article
          class="enx-moments__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="80"
        >
          <span class="enx-moments__petal enx-moments__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="enx-moments__petal enx-moments__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="enx-moments__label">{sendMoments[1].label}</h3>
          <p class="enx-moments__desc">{sendMoments[1].text}</p>
          <div class="enx-moments__visual" aria-hidden="true">
            <div class="enx-compose">
              <span class="enx-compose__head">
                <span>Notification draft</span>
                <span class="enx-compose__tag">Not queued</span>
              </span>
              <div class="enx-compose__field">
                <span>Title</span>
                <i></i>
              </div>
              <div class="enx-compose__field">
                <span>Audience</span>
                <i></i>
              </div>
              <div class="enx-compose__field enx-compose__field--add">
                <span>+ Add an image</span>
              </div>
            </div>
          </div>
        </article>

        <article
          class="enx-moments__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="160"
        >
          <h3 class="enx-moments__label">{sendMoments[2].label}</h3>
          <p class="enx-moments__desc">{sendMoments[2].text}</p>
          <div class="enx-moments__visual" aria-hidden="true">
            <div class="enx-push">
              <span class="enx-push__head">
                <span class="enx-push__mark"></span>
                <span>Push preview</span>
              </span>
              <span class="enx-push__title">Room change</span>
              <span class="enx-push__body">
                Product Strategy now starts at 14:30 in Hall B.
              </span>
              <span class="enx-push__action">Send now</span>
            </div>
          </div>
        </article>

