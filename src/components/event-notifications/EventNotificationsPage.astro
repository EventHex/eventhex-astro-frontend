  }

  .enx-hero__chip--live span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.13);
  }

  .enx-hero__chip--stat {
