          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="enx-faq__list">
        {
          faqs.map(([question, answer], index) => (
            <details
              class="enx-faq__item animate-on-scroll"
              data-animation="fadeInUp"
              data-delay={String(index * 60)}
              data-enx-faq-item
            >
              <summary class="enx-faq__question">
                <strong>{question}</strong>
                <span class="enx-faq__icon" aria-hidden="true" />
              </summary>
              <div class="enx-faq__answer">
                <p>{answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
