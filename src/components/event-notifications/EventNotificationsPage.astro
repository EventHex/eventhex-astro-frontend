  .enx-bento__cell--visual {
    order: 1;
    align-items: center;
  }

  .enx-bento__cell--content {
    order: 2;
  }

  .enx-bento__row--reverse .enx-bento__cell--visual {
    order: 2;
  }

  .enx-bento__row--reverse .enx-bento__cell--content {
    order: 1;
  }

  .enx-bento__row:not(.enx-bento__row--reverse) .enx-bento__cell--visual,
  .enx-bento__row--reverse .enx-bento__cell--content {
    border-right: 1px solid var(--enx-line);
  }

  .enx-bento__cross {
    bottom: 0;
    transform: translate(-50%, 50%);
