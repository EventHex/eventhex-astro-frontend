      will-change: auto;
    }

    .enx-usecases__panel--active {
      animation: none;
    }

    .enx-step:hover,
    .enx-path__cta:hover {
      transform: none;
    }

    .enx-links__card h3 a,
    .enx-btn,
    .enx-path__cta,
    .enx-step,
    .enx-faq__item,
    .enx-faq__cta,
    .enx-faq__icon,
    .enx-faq__icon::after {
      transition: none;
    }
  }
</style>

<script>
  // Lifecycle use-case tabs: roving focus, arrow-key navigation, gentle rotation.
  const enxUseCases = document.querySelector<HTMLElement>("[data-enx-usecases]");

  if (enxUseCases) {
    const enxUseCaseTabs = Array.from(
      enxUseCases.querySelectorAll<HTMLButtonElement>("[data-usecase-target]"),
    );
    const enxUseCasePanels = Array.from(
      enxUseCases.querySelectorAll<HTMLElement>("[data-usecase-panel]"),
    );
    const enxUseCaseReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let enxUseCaseRotation: number | undefined;

    const activateEnxUseCase = (tab: HTMLButtonElement) => {
      const target = tab.dataset.usecaseTarget;

      enxUseCaseTabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle("enx-usecases__tab--active", isActive);
        item.setAttribute("aria-selected", String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });

      enxUseCasePanels.forEach((panel) => {
        panel.classList.toggle(
          "enx-usecases__panel--active",
          panel.dataset.usecasePanel === target,
        );
      });
    };

    const stopEnxUseCaseRotation = () => {
      if (enxUseCaseRotation === undefined) return;
      window.clearInterval(enxUseCaseRotation);
      enxUseCaseRotation = undefined;
    };

    const startEnxUseCaseRotation = () => {
      stopEnxUseCaseRotation();
      if (enxUseCaseTabs.length < 2 || enxUseCaseReduced.matches) return;

      enxUseCaseRotation = window.setInterval(() => {
        const currentIndex = enxUseCaseTabs.findIndex(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        activateEnxUseCase(enxUseCaseTabs[(currentIndex + 1) % enxUseCaseTabs.length]);
      }, 5000);
    };

    enxUseCaseTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activateEnxUseCase(tab);
        startEnxUseCaseRotation();
      });

      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        const nextTab =
          enxUseCaseTabs[(index + offset + enxUseCaseTabs.length) % enxUseCaseTabs.length];
        nextTab.focus();
        activateEnxUseCase(nextTab);
      });
    });

    enxUseCases.addEventListener("mouseenter", stopEnxUseCaseRotation);
    enxUseCases.addEventListener("mouseleave", startEnxUseCaseRotation);
    enxUseCases.addEventListener("focusin", stopEnxUseCaseRotation);
    enxUseCases.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !enxUseCases.contains(event.relatedTarget)) {
        startEnxUseCaseRotation();
      }
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopEnxUseCaseRotation();
      else startEnxUseCaseRotation();
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startEnxUseCaseRotation);
    } else {
      startEnxUseCaseRotation();
    }
  }
</script>

<script>
  // Networking-alert stacking band: keeps the first card clear of the sticky
  // header, then slides that header away once the last card sticks.
  function initEnxStack() {
    const shell = document.querySelector<HTMLElement>(".enx-stack-shell");
    const header = shell?.querySelector<HTMLElement>(".enx-stack__header");
    const cards = shell?.querySelector<HTMLElement>(".enx-stack__cards");
    const items = shell?.querySelectorAll<HTMLElement>(".enx-stack__card");
    const lastCard = items?.[items.length - 1];
    if (!shell || !header || !cards || !lastCard) return;

    const sizeStack = () => {
      const stickyTop = Number.parseFloat(getComputedStyle(header).top) || 0;
      const offset = Math.round(stickyTop + header.offsetHeight + 12);
      cards.style.setProperty("--enx-stack-top", `${offset}px`);
    };
    sizeStack();
    window.addEventListener("resize", sizeStack, { passive: true });
    window.addEventListener("load", sizeStack);
    document.fonts?.ready.then(sizeStack).catch(() => {});

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let queued = 0;
    const paint = () => {
      queued = 0;
      const stickTop = Number.parseFloat(getComputedStyle(lastCard).top) || 0;
      const release = Math.min(0, lastCard.getBoundingClientRect().top - stickTop);
      header.style.setProperty("--enx-release-y", `${release}px`);
      header.style.transform = `translateY(${release}px)`;
    };
    const onScroll = () => {
      if (queued) return;
      queued = requestAnimationFrame(paint);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    paint();
  }

  function initEnxBand() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const bands = Array.from(document.querySelectorAll<HTMLElement>(".enx-band")).filter(
      (band) => band.dataset.bleedReady !== "true",
    );
    if (bands.length === 0) return;

    let viewportHeight = window.innerHeight || 1;
    let ticking = false;

    // One shared scroll listener drives every band so the page keeps a single rAF loop.
    const state = bands.map((band) => {
      band.dataset.bleedReady = "true";
      return { band, bandTop: 0, lastProgress: -1 };
    });

    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      state.forEach((entry) => {
        entry.bandTop = entry.band.getBoundingClientRect().top + window.scrollY;
      });
    };

    const update = () => {
      ticking = false;
      state.forEach((entry) => {
        const travelled = viewportHeight - (entry.bandTop - window.scrollY);
        const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * 0.7)));
        const rounded = Math.round(progress * 100) / 100;
        if (rounded === entry.lastProgress) return;
        entry.lastProgress = rounded;
        entry.band.style.setProperty("--band-p", String(rounded));
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const onResize = () => {
      measure();
      state.forEach((entry) => {
        entry.lastProgress = -1;
      });
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initEnxBand);
  else initEnxBand();

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initEnxStack);
  else initEnxStack();
</script>

<script>
  // Attendee-app control rows: one category open at a time, with the circular
  // toggle carrying the accessible expanded state.
  document
    .querySelectorAll<HTMLDetailsElement>(".enx-appflow__steps details")
    .forEach((item, _, all) => {
      const summary = item.querySelector("summary");
      const trigger = item.querySelector<HTMLButtonElement>(".enx-appflow__arrow");
      const label =
        item.querySelector(".enx-appflow__step-title")?.textContent?.trim() ?? "notification category";

      summary?.addEventListener("click", (event) => {
        event.preventDefault();
        item.open = !item.open;
      });

      item.addEventListener("toggle", () => {
        trigger?.setAttribute("aria-expanded", String(item.open));
        trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} ${label}`);
        if (!item.open) return;
        all.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
</script>

<script>
  // Height-animated FAQ with one open answer at a time, matching the Event Registration FAQ.
  const enxFaqItems = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-enx-faq-item]"),
  );
  const enxFaqAnimations = new WeakMap<HTMLDetailsElement, Animation[]>();
  const enxFaqReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const animateEnxFaq = (item: HTMLDetailsElement, shouldOpen: boolean) => {
    const summary = item.querySelector<HTMLElement>(".enx-faq__question");
    const answer = item.querySelector<HTMLElement>(".enx-faq__answer");
    if (!summary || !answer) return;

    const startHeight = item.getBoundingClientRect().height;
    enxFaqAnimations.get(item)?.forEach((animation) => animation.cancel());

    if (shouldOpen) item.open = true;
    const styles = window.getComputedStyle(item);
    const closedHeight =
      summary.getBoundingClientRect().height +
      parseFloat(styles.paddingTop) +
      parseFloat(styles.paddingBottom) +
      parseFloat(styles.borderTopWidth) +
      parseFloat(styles.borderBottomWidth);
    const endHeight = shouldOpen ? item.getBoundingClientRect().height : closedHeight;

    item.dataset.faqExpanded = String(shouldOpen);

    if (enxFaqReducedMotion.matches) {
      item.open = shouldOpen;
      return;
    }

    const itemAnimation = item.animate(
      { height: [`${startHeight}px`, `${endHeight}px`] },
      { duration: 280, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
    );
    const answerAnimation = answer.animate(
      shouldOpen
        ? { opacity: [0, 1], transform: ["translateY(-6px)", "translateY(0)"] }
        : { opacity: [1, 0], transform: ["translateY(0)", "translateY(-6px)"] },
      { duration: shouldOpen ? 240 : 180, easing: "ease-out", fill: "both" },
    );

    enxFaqAnimations.set(item, [itemAnimation, answerAnimation]);
    itemAnimation.addEventListener(
      "finish",
      () => {
        item.open = shouldOpen;
        answerAnimation.cancel();
        enxFaqAnimations.delete(item);
      },
      { once: true },
    );
  };

  enxFaqItems.forEach((item) => {
    item.dataset.faqExpanded = String(item.open);
    item.querySelector(".enx-faq__question")?.addEventListener("click", (event) => {
      event.preventDefault();
      const shouldOpen = item.dataset.faqExpanded !== "true";

      if (shouldOpen) {
        enxFaqItems.forEach((other) => {
          if (other !== item && other.dataset.faqExpanded === "true") {
            animateEnxFaq(other, false);
          }
        });
      }

      animateEnxFaq(item, shouldOpen);
    });
  });
</script>
