    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(
        ellipse 700px 500px at -5% -10%,
        rgba(55, 93, 251, 0.14),
        rgba(55, 93, 251, 0.06) 40%,
        rgba(55, 93, 251, 0) 75%
      ),
      radial-gradient(
        ellipse 800px 600px at 100% 105%,
        rgba(255, 116, 184, 0.24),
        rgba(255, 116, 184, 0.1) 45%,
        rgba(255, 116, 184, 0) 78%
      ),
      #fff;
  }

  /* Fades the bleeding hero visual into the page edge. */
  .enx-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 2;
    width: 220px;
    max-width: 30vw;
