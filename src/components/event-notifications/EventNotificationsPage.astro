                </span>
              )}
              <span class="enx-links__icon" aria-hidden="true" set:html={item.icon} />
              <h3><a href={item.href}>{item.label}</a></h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 14 FAQ -->
  <section class="enx-faq" id="faq" aria-labelledby="enx-faq-title">
    <div class="enx-faq__inner">
      <div class="enx-faq__sidebar animate-on-scroll" data-animation="fadeInLeft">
