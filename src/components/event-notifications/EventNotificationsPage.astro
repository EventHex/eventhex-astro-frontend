    background: #e2f7ea;
    color: #128c5a;
  }

  .enx-reminder__avatar svg {
    width: 17px;
    height: 17px;
  }

  .enx-reminder__from {
    display: grid;
    gap: 1px;
    min-width: 0;
    line-height: 1.25;
  }

  .enx-reminder__from b {
