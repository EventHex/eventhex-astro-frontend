---
---
<section class="cdd-hero">
  <div class="cdd-hero__shell">
    <div class="cdd-hero__grid">
      <div class="cdd-hero__content">
        <div class="cdd-hero__badge animate-on-scroll" data-animation="fadeInDown">
          <span>Centralized event dashboard</span>
        </div>
        <h1 class="cdd-hero__title animate-on-scroll" data-animation="fadeInUp">
          Manage multiple events from one centralized dashboard
        </h1>
        <p class="cdd-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          See conferences, exhibitions, corporate events, and recurring editions in one
          portfolio view\u2014then find what needs attention, compare results, reuse proven
          setup, and open the right event workspace.
        </p>
        <div class="cdd-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          <span class="cdd-hero__point">Portfolio-wide attention signals</span>
          <span class="cdd-hero__point">Cross-event comparison</span>
          <span class="cdd-hero__point">Selective event cloning</span>
        </div>
        <div class="cdd-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a href="/book-a-demo/" class="cdd-hero__btn cdd-hero__btn--primary">Book a Demo</a>
          <a href="#cdd-rail" class="cdd-hero__btn cdd-hero__btn--secondary">Explore dashboard features</a>
        </div>
      </div>
      <div class="cdd-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="cdd-hero__visual-card">
          <div class="cdd-hero__visual-inner">
            <img
              src="/feature-images/centralized-dashboard/event-portfolio-visual.svg"
              alt="EventHex organization dashboard showing multiple events with status, registration counts, and revenue"
              class="cdd-hero__img"
              width="773"
              height="573"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cdd-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, #375dfb24, #375dfb0f 40%, #375dfb00 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, #ff74b83d, #ff74b81a 45%, #ff74b800 78%),
      #fff;
  }
  .cdd-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, #fff0, #ffffff73 70%, #ffffffbf);
    pointer-events: none;
    z-index: 2;
  }
  .cdd-hero__shell { position: relative; z-index: 1; width: 100%; padding: 0; background: none; }
  .cdd-hero__grid {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }
  .cdd-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; text-align: left; }
  .cdd-hero__badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 0;
    font-family: var(--font-body); font-size: 16px; font-weight: 500; line-height: 24px;
    color: var(--brand-blue); text-transform: uppercase;
  }
  .cdd-hero__title {
    margin: 0; font-family: var(--font-heading); width: 100%; max-width: 620px;
    font-size: 52px; font-weight: 500; line-height: 58px; letter-spacing: -2.1px;
    background: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%);
    background-clip: text; -webkit-background-clip: text; color: transparent;
  }
  .cdd-hero__desc {
    margin: 0; width: 100%; max-width: 560px;
    font-family: var(--font-body); font-size: 18px; font-weight: 400; line-height: 24px;
    letter-spacing: -0.25px; color: var(--subheading-gray);
  }
  .cdd-hero__points { display: flex; flex-wrap: wrap; gap: 10px; }
  .cdd-hero__point {
    display: inline-flex; align-items: center; position: relative; padding: 0 0 0 16px;
    font-family: var(--font-body); font-size: 14px; font-weight: 500; line-height: 20px; color: #475467;
  }
  .cdd-hero__point::before {
    content: ""; position: absolute; left: 0; top: 7px; width: 6px; height: 6px;
    border-radius: 50%; background: #10b981;
  }
  .cdd-hero__cta { display: flex; gap: 14px; padding-top: 6px; }
  .cdd-hero__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 12px 32px; border-radius: 10px; text-decoration: none;
    font-family: var(--font-body); font-size: 15px; font-weight: 600; line-height: 24px; letter-spacing: -0.48px;
    transition: transform 0.3s, box-shadow 0.3s, background 0.3s, border-color 0.3s;
  }
  .cdd-hero__btn--primary { color: #fff; background: var(--heading-dark); box-shadow: none; }
  .cdd-hero__btn--primary:hover { transform: translateY(-2px); background: #000; }
  .cdd-hero__btn--secondary { color: var(--heading-dark); background: rgba(255,255,255,0.9); border: 1px solid #dce4ff; }
  .cdd-hero__btn--secondary:hover { transform: translateY(-2px); border-color: #c5d2ff; box-shadow: 0 10px 24px rgba(34,39,47,0.06); }
  .cdd-hero__visual { position: relative; margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px)); z-index: 3; }
  .cdd-hero__visual-card {
    position: relative; padding: 14px; border-radius: 22px 0 0 22px;
    border: 1px solid rgba(255,255,255,0.62); border-right: none;
    background: linear-gradient(180deg, #ffffff9e, #ffffff47), #ffffff57;
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .cdd-hero__visual-inner {
    position: relative; border-radius: 16px 0 0 16px; overflow: hidden; padding: 28px;
    background: linear-gradient(135deg, #d9ecfa, #eef6fc 45%, #fff);
  }
  .cdd-hero__img { display: block; width: 100%; max-height: 520px; object-fit: contain; height: auto; animation: cddHeroFloat 6s ease-in-out infinite; }
  @keyframes cddHeroFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @media (max-width: 1120px) {
    .cdd-hero { padding: 140px 20px 56px; }
    .cdd-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 32px; }
    .cdd-hero__desc { max-width: 520px; }
    .cdd-hero__title { font-size: 46px; line-height: 52px; letter-spacing: -1.5px; }
  }
  @media (max-width: 960px) {
    .cdd-hero { padding: 130px 20px 48px; }
    .cdd-hero::after { display: none; }
    .cdd-hero__grid { grid-template-columns: 1fr; gap: 34px; }
    .cdd-hero__content { align-items: center; text-align: center; }
    .cdd-hero__title, .cdd-hero__desc { max-width: 760px; }
    .cdd-hero__visual { width: min(760px, 100%); margin: 0 auto; }
    .cdd-hero__visual-card { border-radius: 22px; border-right: 1px solid rgba(255,255,255,0.62); }
    .cdd-hero__visual-inner { border-radius: 16px; }
    .cdd-hero__points, .cdd-hero__cta { justify-content: center; }
    .cdd-hero__title { font-size: 42px; line-height: 1.1em; }
  }
  @media (max-width: 767px) {
    .cdd-hero { margin-top: -80px; padding: 120px 18px 44px; }
    .cdd-hero__grid { padding: 0 0 30px; }
    .cdd-hero__visual-card { padding: 10px; border-radius: 18px; }
    .cdd-hero__visual-inner { padding: 18px; border-radius: 14px; }
    .cdd-hero__title { font-size: 38px; line-height: 1.2em; letter-spacing: 0; }
    .cdd-hero__desc { font-size: 15px; line-height: 1.7; }
    .cdd-hero__badge { font-size: 16px; line-height: 1.1em; }
    .cdd-hero__cta { width: 100%; flex-direction: column; }
    .cdd-hero__btn { width: 100%; }
  }
  @media (max-width: 420px) { .cdd-hero__title { font-size: 33px; line-height: 1.15em; } }
</style>
