---
// Trust strip: Registration erg-trust-strip pattern.
// Setup grids: Speaker smp-setup-grid divided-card pattern.
// Two-option comparison: Registration erg-flow-quad pattern.
---

<!-- Workflow rail: Registration trust-strip pattern -->
<section class="cdd-trust-strip" id="cdd-rail" aria-label="Multi-event workflow">
  <div class="cdd-trust-strip__inner">
    <span class="cdd-trust-strip__label">One multi-event workflow</span>
    <span class="cdd-trust-strip__stat"><b>See</b> All events</span>
    <span class="cdd-trust-strip__stat"><b>Prioritize</b> Needs attention</span>
    <span class="cdd-trust-strip__stat"><b>Compare</b> Performance</span>
    <span class="cdd-trust-strip__stat"><b>Reuse</b> Proven setup</span>
    <span class="cdd-trust-strip__stat"><b>Assign</b> Team access</span>
    <span class="cdd-trust-strip__stat"><b>Open</b> Event workspace</span>
  </div>
</section>

<!-- Portfolio view: Speaker setup-grid pattern -->
<section class="cdd-setup">
  <div class="cdd-setup__inner">
    <header class="cdd-setup__header animate-on-scroll" data-animation="fadeInUp">
      <span>Your full event portfolio</span>
      <h2>See every event without flattening the work inside it</h2>
      <p>Use the organization dashboard for portfolio visibility, then open each event's dedicated workspace for registration, content, speakers, check-in, and other event-specific work.</p>
    </header>
    <div class="cdd-setup-grid">
      <div class="cdd-setup-notch" style="left: 25%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-notch" style="left: 50%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-notch" style="left: 75%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-card cdd-setup-card--first animate-on-scroll" data-animation="fadeInUp">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Live, upcoming, and completed</h3>
          <p>Scan the portfolio by status and date.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Registration and attendance</h3>
          <p>Review the current counts available for each event.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Revenue by currency</h3>
          <p>Keep different event currencies visible without adding unlike values together.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Open the event</h3>
          <p>Move from the portfolio row into the event workspace that owns the detail.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Attention signals: Speaker setup-grid pattern, tinted -->
<section class="cdd-setup cdd-setup--alt">
  <div class="cdd-setup__inner">
    <header class="cdd-setup__header animate-on-scroll" data-animation="fadeInUp">
      <span>Know where to act</span>
      <h2>Let the dashboard surface the event that needs attention next</h2>
      <p>Use the available portfolio spotlight and attention states to move beyond a static event list.</p>
    </header>
    <div class="cdd-setup-grid">
      <div class="cdd-setup-notch" style="left: 25%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-notch" style="left: 50%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-notch" style="left: 75%" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path></svg>
      </div>
      <div class="cdd-setup-card cdd-setup-card--first animate-on-scroll" data-animation="fadeInUp">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Upcoming milestones</h3>
          <p>See event timing in the wider calendar.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Needs-attention signals</h3>
          <p>Identify events with available operational conditions that require review.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Portfolio spotlight</h3>
          <p>Bring the most relevant event context forward.</p>
        </div>
      </div>
      <div class="cdd-setup-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
        <div class="cdd-setup-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
        </div>
        <div class="cdd-setup-card__content">
          <h3>Direct handoff</h3>
          <p>Open the event and resolve the underlying setup or performance issue.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Audience insight: Registration two-option comparison pattern -->
<section class="cdd-flow">
  <div class="cdd-flow-header">
    <span class="cdd-flow-eyebrow animate-on-scroll" data-animation="fadeInUp">Audience across events</span>
    <h2 class="cdd-flow-title animate-on-scroll" data-animation="fadeInUp">Separate total registrations from the people behind them</h2>
    <p class="cdd-flow-subtitle animate-on-scroll" data-animation="fadeInUp">Portfolio counts can include the same attendee across multiple editions. EventHex provides unique-person and returning-attendee context for a clearer view of reach and repeat participation.</p>
  </div>
  <div class="cdd-flow-quad">
    <div class="cdd-flow-quad__cell cdd-flow-quad__cell--copy animate-on-scroll" data-animation="fadeInUp">
      <h3 class="cdd-flow-quad__title">Unique people</h3>
      <p class="cdd-flow-quad__text">Review the deduplicated audience measure available across the selected portfolio data.</p>
      <span class="cdd-flow-quad__tag">Best for portfolio reach</span>
    </div>
    <div class="cdd-flow-quad__cell cdd-flow-quad__cell--media animate-on-scroll" data-animation="fadeInUp" data-delay="60">
      <div class="cdd-flow-composite" aria-hidden="true">
        <div class="cdd-flow-mock cdd-flow-mock--primary">
          <span class="cdd-flow-mock__bar"><i></i><i></i><i></i></span>
          <strong>Audience reach</strong>
          <div class="cdd-flow-mock__row"><span>Unique people</span><b>12,480</b></div>
          <div class="cdd-flow-mock__row"><span>Total registrations</span><b>15,920</b></div>
          <div class="cdd-flow-mock__row"><span>Editions</span><b>6 events</b></div>
        </div>
        <div class="cdd-flow-mock cdd-flow-mock--secondary">
          <strong>Deduplicated</strong>
          <div class="cdd-flow-mock__barline"><i style="width: 78%"></i></div>
          <small>78% unique across editions</small>
        </div>
        <span class="cdd-flow-composite__status"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg>Deduplicated</span>
        <span class="cdd-flow-composite__action">View reach</span>
      </div>
    </div>
    <div class="cdd-flow-quad__cell cdd-flow-quad__cell--media animate-on-scroll" data-animation="fadeInUp" data-delay="120">
      <div class="cdd-flow-composite" aria-hidden="true">
        <div class="cdd-flow-mock cdd-flow-mock--primary">
          <span class="cdd-flow-mock__bar"><i></i><i></i><i></i></span>
          <strong>Repeat participation</strong>
          <div class="cdd-flow-mock__row"><span>Returning attendees</span><b>3,440</b></div>
          <div class="cdd-flow-mock__row"><span>Return rate</span><b>28%</b></div>
          <div class="cdd-flow-mock__row"><span>Top series</span><b>Annual summit</b></div>
        </div>
        <div class="cdd-flow-mock cdd-flow-mock--secondary">
          <strong>Loyalty signal</strong>
          <div class="cdd-flow-mock__barline"><i style="width: 46%"></i></div>
          <small>28% returned this edition</small>
        </div>
        <span class="cdd-flow-composite__status"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg>Matched attendees</span>
        <span class="cdd-flow-composite__action">View loyalty</span>
      </div>
    </div>
    <div class="cdd-flow-quad__cell cdd-flow-quad__cell--copy animate-on-scroll" data-animation="fadeInUp" data-delay="180">
      <h3 class="cdd-flow-quad__title">Returning attendees</h3>
      <p class="cdd-flow-quad__text">See repeat participation across events where identities can be matched.</p>
      <span class="cdd-flow-quad__tag">Best for loyalty and series planning</span>
    </div>
    <span class="cdd-flow-quad__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(-90)"></path></svg>
    </span>
  </div>
  <p class="cdd-content-note animate-on-scroll" data-animation="fadeIn">Identity matching depends on the attendee data available across events; it is not a universal identity graph.</p>
</section>

<style>
  /* Trust strip: copied from erg-trust-strip, renamed cdd-trust-strip. */
  .cdd-trust-strip { border-top: 1px solid var(--surface-card-border, #e8edf5); border-bottom: 1px solid var(--surface-card-border, #e8edf5); padding: 1.5rem 24px; background: #fff; }
  .cdd-trust-strip__inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1rem 2.25rem; }
  .cdd-trust-strip__label { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--label-gray, #7f8898); }
  .cdd-trust-strip__stat { font-family: var(--font-body); font-size: 0.9375rem; font-weight: 400; color: var(--subheading-gray, #596579); white-space: nowrap; }
  .cdd-trust-strip__stat b { color: var(--heading-dark, #22272f); font-weight: 700; }

  /* Setup grids: copied from smp-setup-grid divided-card treatment, renamed cdd-setup. */
  .cdd-setup { padding: clamp(90px, 10vw, 140px) 24px; background: #fff; }
  .cdd-setup--alt { background: #f7f9fc; border-top: 1px solid #e8edf5; border-bottom: 1px solid #e8edf5; }
  .cdd-setup__inner { width: min(1200px, 100%); margin: 0 auto; }
  .cdd-setup__header { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .cdd-setup__header > span { display: block; margin-bottom: 16px; color: var(--brand-blue, #375dfb); font-family: var(--font-body); font-size: 12px; font-weight: 750; letter-spacing: 0.13em; text-transform: uppercase; }
  .cdd-setup__header h2 { margin: 0 0 16px; font-family: var(--font-heading); font-size: clamp(36px, 5vw, 56px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; background: linear-gradient(135deg, #222 0%, #333 40%, #888 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .cdd-setup__header p { margin: 0; font-family: var(--font-body); font-size: 17px; line-height: 1.65; color: var(--subheading-gray, #596579); }
  .cdd-setup-grid { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 1200px; margin: 0 auto; border-top: 1px solid var(--surface-card-border, #e8ecf2); }
  .cdd-setup-card { position: relative; display: block; min-height: 320px; padding: 28px; border-left: 1px solid var(--surface-card-border, #e8ecf2); }
  .cdd-setup-card--first { border-left: 0; }
  .cdd-setup-notch { position: absolute; top: 0; width: 28px; height: 28px; transform: translate(-50%, -50%); pointer-events: none; line-height: 0; z-index: 2; }
  .cdd-setup-card__icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin-bottom: 28px; color: var(--brand-blue, #375dfb); }
  .cdd-setup-card__icon svg { width: 100%; height: 100%; }
  .cdd-setup-card__content h3 { min-height: 2.5em; margin: 0 0 28px; font-family: var(--font-heading); font-size: 21px; font-weight: 600; color: var(--heading-dark, #22272f); line-height: 1.25; }
  .cdd-setup-card__content p { margin: 14px 0 0; font-family: var(--font-body); font-size: 15px; color: var(--body-gray, #525866); line-height: 1.4; }

  /* Flow comparison: copied from erg-flow-section / erg-flow-quad, renamed cdd-flow. */
  .cdd-flow { padding: 40px 24px; background: #fff; display: flex; flex-direction: column; align-items: center; }
  .cdd-flow-header { text-align: center; max-width: 1100px; margin-bottom: 24px; display: flex; flex-direction: column; align-items: center; }
  .cdd-flow-eyebrow { display: block; margin-bottom: 16px; color: var(--brand-blue, #375dfb); font-family: var(--font-body); font-size: 12px; font-weight: 750; letter-spacing: 0.13em; text-transform: uppercase; }
  .cdd-flow-title { font-family: var(--font-heading); font-size: clamp(28px, 4.2vw, 48px); font-weight: 500; background: linear-gradient(98deg, var(--heading-dark, #1e1d24) 43.06%, #8f8f8f 91.81%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; line-height: 1.1; margin: 0 0 12px; letter-spacing: -0.04em; }
  .cdd-flow-subtitle { font-family: var(--font-body); font-size: 18px; color: var(--subheading-gray, #555); line-height: 1.5; margin: 0; max-width: 640px; }
  .cdd-flow-quad { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; width: 100%; max-width: 1180px; margin: 24px auto; }
  .cdd-flow-quad__cross { position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; transform: translate(-50%, -50%); line-height: 0; pointer-events: none; z-index: 1; }
  .cdd-flow-quad__cell { display: flex; flex-direction: column; justify-content: center; min-height: 260px; padding: 56px 48px; border-right: 1px solid #eef0f3; border-bottom: 1px solid #eef0f3; }
  .cdd-flow-quad__cell:nth-child(2n) { border-right: none; }
  .cdd-flow-quad__cell:nth-child(n + 3) { border-bottom: none; }
  .cdd-flow-quad__title { font-family: var(--font-heading); font-size: clamp(24px, 2.6vw, 32px); font-weight: 700; color: var(--heading-dark, #1e1d24); line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 16px; }
  .cdd-flow-quad__text { font-family: var(--font-body); font-size: 16px; color: var(--subheading-gray, #555); line-height: 1.6; margin: 0 0 16px; max-width: 40ch; }
  .cdd-flow-quad__tag { display: inline-block; align-self: flex-start; padding: 6px 12px; border-radius: 999px; background: #e9f8f5; color: #0c6e5f; font-family: var(--font-body); font-size: 13px; font-weight: 600; }
  .cdd-flow-quad__cell--media { align-items: center; min-height: 360px; padding: 18px 22px; overflow: hidden; }
  .cdd-flow-composite { position: relative; width: 100%; min-height: 320px; overflow: visible; }
  .cdd-flow-mock { position: absolute; display: flex; flex-direction: column; gap: 8px; padding: 14px; border: 1px solid rgba(209, 214, 226, 0.92); border-radius: 12px; background: #fff; box-shadow: 0 16px 34px rgba(31, 41, 72, 0.14); font-family: var(--font-body); }
  .cdd-flow-mock--primary { top: 42px; left: 20px; z-index: 1; width: 74%; }
  .cdd-flow-mock--secondary { right: 18px; bottom: 34px; z-index: 2; width: 56%; }
  .cdd-flow-mock__bar { display: flex; gap: 5px; }
  .cdd-flow-mock__bar i { width: 8px; height: 8px; border-radius: 50%; background: #ccd4e0; }
  .cdd-flow-mock strong { font-size: 13px; color: #111827; }
  .cdd-flow-mock__row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border-radius: 8px; background: #f6f8fc; font-size: 12px; color: #596579; }
  .cdd-flow-mock__row b { color: #111827; }
  .cdd-flow-mock__barline { height: 6px; border-radius: 999px; background: #edf1f7; overflow: hidden; }
  .cdd-flow-mock__barline i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #4b65f6, #8f7bff); }
  .cdd-flow-mock small { font-size: 11.5px; color: #7b8497; }
  .cdd-flow-composite__status, .cdd-flow-composite__action { position: absolute; z-index: 5; display: inline-flex; align-items: center; white-space: nowrap; border-radius: 10px; font-family: var(--font-body); font-size: 11px; font-weight: 700; line-height: 1; box-shadow: 0 10px 24px rgba(31, 41, 72, 0.16); }
  .cdd-flow-composite__status { top: 14px; left: 14px; gap: 7px; padding: 9px 11px; border: 1px solid #cfead9; background: #effbf4; color: #18864b; }
  .cdd-flow-composite__status svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .cdd-flow-composite__action { right: 14px; bottom: 14px; padding: 10px 13px; background: #4b65f6; color: #fff; }
  .cdd-content-note { margin: 8px auto 0; max-width: 720px; text-align: center; color: #7b8497; font-family: var(--font-body); font-size: 14px; }

  @media (max-width: 992px) {
    .cdd-setup-grid { grid-template-columns: 1fr; }
    .cdd-setup-notch { display: none; }
    .cdd-setup-card { min-height: 0; border-left: 0; border-top: 1px solid var(--surface-card-border, #e8ecf2); }
    .cdd-setup-card--first { border-top: 0; }
    .cdd-setup-card__content h3 { min-height: 0; }
  }
  @media (max-width: 768px) {
    .cdd-flow-quad { grid-template-columns: 1fr; }
    .cdd-flow-quad__cross { display: none; }
    .cdd-flow-quad__cell { min-height: 0; padding: 32px 20px; border-right: none; border-bottom: 1px solid #eef0f3; }
    .cdd-flow-quad__cell:nth-child(3) { order: 4; border-bottom: none; }
    .cdd-flow-quad__cell:nth-child(4) { order: 3; border-bottom: 1px solid #eef0f3; }
    .cdd-flow-quad__cell--media { padding: 16px 20px 32px; }
    .cdd-flow { padding: 60px 16px; }
    .cdd-setup { padding: 48px 18px; }
  }
</style>
