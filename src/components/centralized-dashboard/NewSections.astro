---
const { part = "a" } = Astro.props;
const base = "/feature-images/centralized-dashboard/v5/";
---

{part === "a" && (
  <!-- People across events -->
  <div class="cdx ds-night">
    <section class="cdx__in" aria-labelledby="cdx-people-title">
      <div class="cdx__copy animate-on-scroll" data-animation="fadeInUp">
        <span class="cdx__eyebrow">People across events</span>
        <h2 id="cdx-people-title" class="cdx__h2">Everyone Across Your Events, <span class="ds-hl-dark">Counted Once</span></h2>
        <p class="cdx__p">The People page unifies attendees by email and phone, so a person who joined three events is one row, not three. Each person sits in a segment: first timer, returning, loyal, lapsed or no-show prone. Search by name, email or phone and open anyone to see their history.</p>
      </div>
      <div class="cdx__media animate-on-scroll" data-animation="fadeInUp" data-delay="80">
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <video class="cdd-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800"
            poster={`${base}people-poster.webp`}
            aria-label="Demo: the People page with 11,620 people in five loyalty segments, then the Loyal segment selected to list the people registered for three or more events">
            <source src={`${base}people.webm`} type="video/webm" />
            <source src={`${base}people.mp4`} type="video/mp4" />
          </video>
        </div>
      </div>
    </section>
  </div>
)}

{part === "b" && (
  <!-- Registration trends -->
  <div class="cdx cdx--band ds-stage">
    <section class="cdx__in cdx__in--flip" aria-labelledby="cdx-trend-title">
      <div class="cdx__media animate-on-scroll" data-animation="fadeInUp">
        <div class="ds-shot">
          <img src={`${base}org-trend.webp`} width="2260" height="720" loading="lazy" decoding="async"
            alt="Registration trends chart across the last 12 months for all events of the organization" />
        </div>
      </div>
      <div class="cdx__copy animate-on-scroll" data-animation="fadeInUp" data-delay="80">
        <span class="cdx__eyebrow">Registration trends</span>
        <h2 id="cdx-trend-title" class="cdx__h2">See Registrations <span class="ds-hl">Month by Month</span></h2>
        <p class="cdx__p">One chart plots registrations across every event in the organization, for the last 12 months, the last 24 months or all time, right above the comparison table. Spot your busy seasons before you plan the next edition.</p>
      </div>
    </section>
  </div>
)}

{part === "c" && (
  <!-- Selective clone -->
  <div class="cdx ds-stage">
    <section class="cdx__in" aria-labelledby="cdx-clone-title">
      <div class="cdx__copy animate-on-scroll" data-animation="fadeInUp">
        <span class="cdx__eyebrow">Selective clone</span>
        <h2 id="cdx-clone-title" class="cdx__h2">Know Exactly What a Clone <span class="ds-hl">Carries Over</span></h2>
        <p class="cdx__p">Pick from 22 modules, from tickets, forms and discount coupons to speakers, sponsors, exhibitors and team members. The new event is titled "Copy of" the original, starts inactive, and begins with registration data at zero, so nothing goes live by accident.</p>
      </div>
      <div class="cdx__media animate-on-scroll" data-animation="fadeInUp" data-delay="80">
        <div class="ds-shot cdx__tall">
          <img src={`${base}clone-modules.webp`} width="1640" height="1740" loading="lazy" decoding="async"
            alt="Clone Event dialog for Meridian Health Congress 2027 with the note about the Copy of title, inactive start and reset registration data, and module cards for tickets, forms and discount coupons" />
        </div>
      </div>
    </section>
  </div>
)}

{part === "d" && (
  <!-- Per-event dashboard -->
  <div class="cdx ds-night">
    <section class="cdx__in cdx__in--flip" aria-labelledby="cdx-event-title">
      <div class="cdx__media animate-on-scroll" data-animation="fadeInUp">
        <div class="ds-shot">
          <img src={`${base}event-dash-widgets.webp`} width="2660" height="775" loading="lazy" decoding="async"
            alt="Event dashboard widgets: registration breakdown, registrations by ticket and peak registration hour" />
        </div>
      </div>
      <div class="cdx__copy animate-on-scroll" data-animation="fadeInUp" data-delay="80">
        <span class="cdx__eyebrow">Event dashboard</span>
        <h2 id="cdx-event-title" class="cdx__h2">Every Event Keeps <span class="ds-hl-dark">Its Own Dashboard</span></h2>
        <p class="cdx__p">Open an event and its dashboard shows registrations today and in total, ticket revenue, the registration timeline, latest registrations, a split by ticket and the peak registration hour. Use Manage widgets to choose what each event shows.</p>
      </div>
    </section>
  </div>
)}

<style is:global>
  .cdx { position: relative; margin: 40px clamp(16px, 3.5vw, 56px); border-radius: var(--ds-r-2xl); overflow: hidden; }
  .cdx.ds-stage { background: var(--ds-g4-stage); }
  .cdx--band { margin-inline: 0; border-radius: 0; }
  .cdx__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; max-width: var(--ds-container); margin: 0 auto; padding: clamp(64px, 8vw, 110px) var(--ds-gutter); box-sizing: content-box; }
  .cdx__in--flip { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .cdx__copy { display: flex; flex-direction: column; gap: 18px; }
  .cdx__eyebrow { font-size: 14px; font-weight: 500; color: var(--ds-blue); }
  .ds-night .cdx__eyebrow { color: var(--ds-on-night-accent); }
  .cdx__h2 { margin: 0; font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--ds-ink); }
  .ds-night .cdx__h2 { color: var(--ds-on-night); }
  .cdx__h2 .ds-hl, .cdx__h2 .ds-hl-dark { -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .cdx__h2 .ds-hl { background-image: var(--ds-g1-text); }
  .cdx__h2 .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .cdx__p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--ds-body); }
  .ds-night .cdx__p { color: var(--ds-on-night-body); }
  .cdd-page-bg.cdd-page-bg .cdx.ds-night .cdx__h2 { color: var(--ds-on-night); }
  .cdd-page-bg.cdd-page-bg .cdx.ds-night .cdx__p { color: var(--ds-on-night-body); }
  .cdx__media { min-width: 0; }
  .ds-night .cdx .ds-shot, .cdx.ds-night .ds-shot { border-color: var(--ds-glass-dark-edge); }
  .cdx__tall { max-height: 640px; }
  .cdx__tall img { width: 100%; height: 640px; object-fit: cover; object-position: 50% 0%; display: block; }
  @media (max-width: 900px) {
    .cdx { margin-inline: 12px; border-radius: var(--ds-r-xl); }
    .cdx--band { margin-inline: 0; border-radius: 0; }
    .cdx__in, .cdx__in--flip { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .cdx__in--flip .cdx__copy { order: -1; }
    .cdx__tall img { height: 420px; }
  }
</style>
