---
import LottiePlayer from "../LottiePlayer.astro";
// CTA Section — dark gradient card with trust signals (matching speaker-management pattern)
---

<section class="et-cta">
  <div class="et-cta__card ds-band">
        <div class="et-cta__grid">
      <div class="et-cta__content">
        <span class="et-cta__eyebrow animate-on-scroll" data-animation="fadeIn">Launch Your Ticketing Flow</span>
        <h2 class="et-cta__title animate-on-scroll" data-animation="fadeInUp">Ready to Sell Tickets Without the <span class="ds-hl-dark">Friction?</span></h2>
        <p class="et-cta__desc animate-on-scroll" data-animation="fadeInUp">Join hundreds of organizers who sell tickets, manage payments, and handle check-ins — all from one platform built for events.</p>
        <div class="et-cta__proof-row animate-on-scroll" data-animation="fadeInUp">
          <span class="et-cta__proof-pill">0% platform fee option</span>
          <span class="et-cta__proof-pill">QR check-in ready</span>
          <span class="et-cta__proof-pill">Free onboarding support</span>
        </div>
        <div class="et-cta__buttons">
          <a href="/book-a-demo/" class="ds-btn--light">
            Book a Free Demo
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
      <div class="et-cta__visual animate-on-scroll" data-animation="fadeInRight">
        <LottiePlayer src="/animations/event-ticketing-cta.json" class="et-cta__lottie" />
      </div>
    </div>
  </div>
</section>


<style is:global>
  .et-cta { max-width: calc(var(--ds-container) + var(--ds-gutter) * 2); margin: 0 auto; padding: 0 var(--ds-gutter); margin-block: var(--ds-section-y); box-sizing: border-box; }
  .et-cta__card { position: relative; border-radius: var(--ds-r-2xl); padding: 56px 40px; overflow: hidden; }
  .et-cta__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .et-cta__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 560px; }
  .et-cta__eyebrow { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px; background: var(--ds-glass-dark-fill); border: 1px solid var(--ds-glass-dark-edge); font-family: var(--ds-font-body); font-size: 13px; font-weight: 500; line-height: 18px; color: var(--ds-on-night-body); }
  .et-cta__title { font-family: var(--ds-font-heading); font-size: clamp(28px, 3vw, 40px); font-weight: 500; line-height: 1.15; letter-spacing: -0.03em; color: var(--ds-on-night); margin: 0; }
  .et-cta__desc { font-family: var(--ds-font-body); font-size: 18px; line-height: 1.6; color: var(--ds-on-night-body); margin: 0; }
  .et-cta__proof-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .et-cta__proof-pill { display: inline-flex; align-items: center; padding: 9px 12px; border-radius: 999px; background: var(--ds-glass-dark-fill); border: 1px solid var(--ds-glass-dark-edge); font-family: var(--ds-font-body); font-size: 13px; font-weight: 500; line-height: 18px; color: var(--ds-on-night-body); }
  .et-cta__buttons { display: flex; gap: 12px; }
  .et-cta__visual { display: flex; align-items: center; justify-content: flex-end; }
  .et-cta__lottie { width: 100%; max-width: 460px; }

  @media (max-width: 1024px) {
    .et-cta__card { padding: 48px 24px; }
    .et-cta__grid { gap: 30px; }
    .et-cta__desc { font-size: 16px; }
  }
  @media (max-width: 767px) {
    .et-cta__card { padding: 40px 20px; border-radius: 26px; }
    .et-cta__grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .et-cta__content { align-items: center; text-align: center; }
    .et-cta__proof-row, .et-cta__buttons { justify-content: center; }
    .et-cta__desc { font-size: 15px; }
    .et-cta__buttons { flex-direction: column; width: 100%; }
    .et-cta__buttons a { width: 100%; box-sizing: border-box; }
    .et-cta__visual { order: -1; }
    .et-cta__lottie { max-width: 320px; }
  }
</style>
