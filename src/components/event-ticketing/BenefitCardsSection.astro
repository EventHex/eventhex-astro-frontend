---
// Benefits Section — centered 3-col glassmorphism cards on dark bg
// Pattern from speaker-management CoordinationTools

interface BenefitCard {
  title: string;
  desc: string;
  image: string;
}

interface Props {
  title: string;
  rows: BenefitCard[][];
}

const { title, rows } = Astro.props;
const cards = rows.flat();
// highlight the key phrase of the heading without changing its words
const hl = (t: string) => t.replace("Best Event Ticketing Solution", '<span class="ds-hl">Best Event Ticketing Solution</span>');
---

<section class="etbn-section ds-stage">
  <div class="etbn-inner">
    <div class="etbn-header">
      <span class="etbn-tag animate-on-scroll" data-animation="fadeIn">Why EventHex</span>
      <h2 class="etbn-title animate-on-scroll" data-animation="fadeInUp" set:html={hl(title)}></h2>
      <p class="etbn-desc animate-on-scroll" data-animation="fadeInUp">
        Everything you need to sell tickets, manage attendees, and run on-site check-in — in one platform.
      </p>
    </div>

    <div class="etbn-grid">
      {cards.map((card) => (
        <div class="etbn-card animate-on-scroll" data-animation="fadeInUp">
          <div class="etbn-card__icon">
            <img src={card.image} alt="" width="48" height="48" loading="lazy" />
          </div>
          <h3 class="etbn-card__title">{card.title}</h3>
          <p class="etbn-card__desc">{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .etbn-section { width: 100%; margin: 0; padding: var(--ds-section-y) 0; }
  .etbn-inner { max-width: calc(var(--ds-container) + var(--ds-gutter) * 2); margin: 0 auto; padding: 0 var(--ds-gutter); display: flex; flex-direction: column; align-items: center; gap: 48px; box-sizing: border-box; }
  .etbn-header { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 680px; }
  .etbn-tag { font-family: var(--ds-font-body); font-size: 14px; font-weight: 500; line-height: 18px; color: var(--ds-blue); }
  .etbn-title { font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--ds-ink); margin: 0; }
  .etbn-desc { font-family: var(--ds-font-body); font-size: 18px; line-height: 1.6; color: var(--ds-body); margin: 0; }
  .etbn-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; width: 100%; }
  .etbn-card { background: var(--ds-glass-fill); border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); padding: 32px 28px; display: flex; flex-direction: column; gap: 14px; }
  .etbn-card__icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--ds-blue) 12%, transparent); border-radius: var(--ds-r-md); }
  .etbn-card__icon img { width: 32px; height: 32px; object-fit: contain; }
  .etbn-card__title { font-family: var(--ds-font-heading); font-size: var(--ds-h3-sm); font-weight: 500; letter-spacing: -0.025em; line-height: 1.2; color: var(--ds-ink); margin: 0; }
  .etbn-card__desc { font-family: var(--ds-font-body); font-size: 16px; line-height: 1.6; color: var(--ds-body); margin: 0; }
  @media (max-width: 1024px) { .etbn-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .etbn-grid { grid-template-columns: minmax(0, 1fr); } .etbn-desc { font-size: 16px; } }
</style>
