---
// New sections for shipped features the page did not mention (from the Ticketing canvas Proposed board).
const base = "/feature-images/event-ticketing/v5";
---

<section class="etp-section ds-stage" id="tax-and-invoices">
  <div class="etp-grid etp-grid--wide-left">
    <div class="ds-glass etp-glass animate-on-scroll" data-animation="fadeInLeft">
      <div class="ds-shot">
        <video class="eth-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="1050"
          poster={`${base}/tk-tax-setup-poster.webp`}
          aria-label="Tax and discounts for the Member ticket: Tax Configuration is switched on, a GST rule of 18 percent is added, and the checkout preview shows $290 plus $52.20 GST for a $342.20 total, with the B2B option and I need a Tax Invoice form">
          <source src={`${base}/tk-tax-setup.webm`} type="video/webm" />
          <source src={`${base}/tk-tax-setup.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="etp-copy">
      <span class="ds-eyebrow">Tax ready</span>
      <h2 class="ds-h2 etp-h2 animate-on-scroll" data-animation="fadeInUp">Tax Lines and <span class="ds-hl">Business Invoices</span> on Every Ticket</h2>
      <p class="ds-body">Add tax rules per ticket, inclusive or on top of the price, and buyers see the breakdown before they pay. Turn on the B2B option and companies can ask for a tax invoice with their company name and tax ID.</p>
      <a class="etp-link" href="/invoicing-gst/">Invoicing &amp; GST</a>
    </div>
  </div>
</section>

<section class="etp-section ds-night" id="orders-refunds-finance">
  <div class="etp-grid etp-grid--wide-right">
    <div class="etp-copy">
      <span class="ds-eyebrow">After the sale</span>
      <h2 class="ds-h2 etp-h2 animate-on-scroll" data-animation="fadeInUp">Every Order, Refund and <span class="ds-hl-dark">Payout in One Place</span></h2>
      <p class="ds-body">Each purchase lands in Orders with the buyer, ticket, discount, total and payment status. Refund in full or in part, cancel an order, and send or download the receipt. Export the list whenever finance asks.</p>
      <p class="ds-body">Finance shows what you collected, what was refunded, the gateway fees and the estimated payout, by gateway and by currency.</p>
    </div>
    <div class="ds-glass-dark etp-glass etp-glass--stack animate-on-scroll" data-animation="fadeInRight">
      <div class="ds-shot"><img src={`${base}/tk-orders.webp`} alt="Orders list: 1,018 orders, 36 today, 9 failed, USD 262,100.00 total, each with ticket, discount, amount, B2B flag, payment status and date" width="1600" height="1007" loading="lazy" /></div>
      <div class="ds-shot"><img src={`${base}/tk-finance.webp`} alt="Finance report: $262,100.00 gross collected from 982 orders, $1,220.00 refunded, $7,895.50 fees, $252,984.50 estimated net payout, by gateway and order status" width="1600" height="786" loading="lazy" /></div>
    </div>
  </div>
</section>

<section class="etp-section etp-section--plain" id="terms-and-consent">
  <div class="etp-grid etp-grid--wide-right">
    <div class="etp-copy">
      <span class="ds-eyebrow">Clear consent</span>
      <h2 class="ds-h2 etp-h2 animate-on-scroll" data-animation="fadeInUp">Terms and Consent <span class="ds-hl">Before Anyone Pays</span></h2>
      <p class="ds-body">Ask buyers to accept your terms and give consent at checkout, each with your own wording, per ticket. Gateway keys are stored encrypted, and attendees can delete their account.</p>
    </div>
    <div class="ds-shot etp-consent animate-on-scroll" data-animation="fadeInRight"><img src={`${base}/consent.webp`} alt="Terms and policies for the Member ticket: require terms acceptance with a custom message, and require consent with a consent letter" width="1200" height="946" loading="lazy" /></div>
  </div>
</section>

<style is:global>
  .etp-section { padding: var(--ds-section-y) var(--ds-gutter); box-sizing: border-box; }
  .etp-section--plain { background: var(--ds-white); }
  .etp-grid { max-width: var(--ds-container); margin: 0 auto; display: grid; gap: 56px; align-items: center; }
  .etp-grid--wide-left { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  .etp-grid--wide-right { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  .etp-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .etp-h2 { margin: 0; }
  .etp-glass { padding: 28px; min-width: 0; }
  .etp-glass--stack { display: flex; flex-direction: column; gap: 18px; }
  .etp-link { font-family: var(--ds-font-body); font-size: 15px; font-weight: 500; color: var(--ds-blue); text-decoration: none; }
  .etp-link::after { content: " \2192"; }
  .etp-link:hover { text-decoration: underline; }
  .etp-consent { min-width: 0; }
  .etp-consent img { display: block; width: 100%; height: auto; }
  @media (max-width: 960px) {
    .etp-grid, .etp-grid--wide-left, .etp-grid--wide-right { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .etp-glass { padding: 16px; }
  }
</style>
