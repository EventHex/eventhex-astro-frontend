---
import LottiePlayer from "../LottiePlayer.astro";

// Hero — speaker-management pattern: split layout, lottie animation, floating info cards

interface Props {
  eyebrow: string;
  titleHtml: string;
  description: string;
  ctaText: string;
  ctaHref: string;
  image: string;
  imageAlt: string;
}

const { eyebrow, titleHtml, description, ctaText, ctaHref, image, imageAlt } = Astro.props;
---

<section class="eth-hero ds-stage">
  <div class="eth-hero__shell">
    <div class="eth-hero__grid">

      <div class="eth-hero__content">
        <div class="eth-hero__badge animate-on-scroll" data-animation="fadeInDown">
          <span>{eyebrow}</span>
        </div>

        <h1 class="eth-hero__title animate-on-scroll" data-animation="fadeInUp" set:html={titleHtml}></h1>

        <p class="eth-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          {description}
        </p>

        <div class="eth-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a href={ctaHref} class="ds-btn">{ctaText}</a>
          <a href="#ticket-workflows" class="ds-btn--ghost">Explore Features</a>
        </div>

        <div class="eth-hero__trust animate-on-scroll" data-animation="fadeIn" style="--anim-duration: 1250ms">
          <span class="eth-hero__trust-item">4.8/5 organizer rating</span>
          <span class="eth-hero__trust-item">Trusted by 400+ events</span>
        </div>
      </div>

      <div class="eth-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="eth-hero__visual-card">
          <LottiePlayer src="/animations/event-ticketing-hero.json" class="eth-hero__lottie" />
        </div>
      </div>

    </div>
  </div>

</section>

<section class="eth-trust-strip">
  <div class="eth-trust-strip__inner">
    <span class="eth-trust-strip__item">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="currentColor" opacity=".15"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      0% platform fee option
    </span>
    <span class="eth-trust-strip__item">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="currentColor" opacity=".15"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      QR scan + badge printing
    </span>
    <span class="eth-trust-strip__item">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="currentColor" opacity=".15"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Real-time ticket analytics
    </span>
  </div>
</section>


<style is:global>
  .eth-hero { position: relative; overflow: hidden; padding: clamp(40px, 6vw, 80px) var(--ds-gutter) clamp(40px, 5vw, 64px); }
  .eth-hero__shell { position: relative; z-index: 1; width: 100%; }
  .eth-hero__grid { max-width: var(--ds-container); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .eth-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .eth-hero__badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--ds-font-body); font-size: 14px; font-weight: 500; color: var(--ds-blue); }
  .eth-hero__title { margin: 0; font-family: var(--ds-font-heading); font-size: var(--ds-h1); font-weight: 500; line-height: 1.08; letter-spacing: -0.035em; color: var(--ds-ink); }
  .eth-hero__title b { font-weight: inherit; }
  .eth-hero__desc { margin: 0; max-width: 580px; font-family: var(--ds-font-body); font-size: 18px; line-height: 1.6; color: var(--ds-body); }
  .eth-hero__cta { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }
  .eth-hero__trust { display: flex; flex-wrap: wrap; gap: 20px; }
  .eth-hero__trust-item { position: relative; padding-left: 16px; font-family: var(--ds-font-body); font-size: 14px; font-weight: 500; line-height: 20px; color: var(--ds-muted); }
  .eth-hero__trust-item::before { content: ""; position: absolute; left: 0; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: var(--ds-success); }
  .eth-hero__visual { position: relative; }
  .eth-hero__visual-card { position: relative; padding: 20px 0 20px; }
  .eth-hero__lottie { width: 100%; max-width: 520px; margin: 0 auto; }
  .eth-hero__lottie svg { width: 100% !important; height: auto !important; }

  .eth-trust-strip { background: var(--ds-white); border-bottom: 1px solid var(--ds-line); padding: 20px var(--ds-gutter); }
  .eth-trust-strip__inner { max-width: var(--ds-container); margin: 0 auto; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 16px 40px; }
  .eth-trust-strip__item { display: inline-flex; align-items: center; gap: 8px; font-family: var(--ds-font-body); font-size: 15px; font-weight: 500; line-height: 1.2; color: var(--ds-ink); color: var(--ds-ink); }
  .eth-trust-strip__item svg { flex-shrink: 0; color: var(--ds-blue); }

  @media (max-width: 960px) {
    .eth-hero__grid { grid-template-columns: minmax(0, 1fr); gap: 34px; }
    .eth-hero__content { align-items: center; text-align: center; }
    .eth-hero__trust, .eth-hero__cta { justify-content: center; }
  }
  @media (max-width: 767px) {
    .eth-hero__desc { font-size: 16px; }
    .eth-hero__cta { width: 100%; flex-direction: column; }
    .eth-hero__cta a { width: 100%; box-sizing: border-box; }
    .eth-hero__trust { gap: 10px; justify-content: center; }
    .eth-trust-strip__item { white-space: normal; }
  }
</style>
