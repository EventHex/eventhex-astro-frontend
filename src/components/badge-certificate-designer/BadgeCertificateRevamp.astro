---
const steps = [['01','Choose','Badge or certificate'],['02','Target','Audience'],['03','Design','Layout'],['04','Merge','Attendee data'],['05','Review','Preview'],['06','Deliver','Print or send']];
const badgeOutputSteps = [
  { title: 'Select the badge', description: 'Choose the saved badge design you want to use for this event-day print run.', bullets: ['Reuse a saved badge layout', 'Keep event branding consistent', 'Start from the approved design'], image: 'badge-library.png' },
  { title: 'Filter registrations', description: 'Narrow the attendee list by ticket, participant type, or the registrations you intend to print.', bullets: ['Target tickets or participant types', 'Print only selected registrations', 'Keep each audience organized'], image: 'ticket-audience-settings.png' },
  { title: 'Merge badge fields', description: 'Fill the active layout with each attendee’s identity, event, ticket, and registration data.', bullets: ['Personalize attendee identity', 'Merge event and ticket details', 'Populate registration answers'], image: 'badge-user-fields.png' },
  { title: 'Download or print', description: 'Review the personalized output, then download or print the badges and track production.', bullets: ['Preview personalized badges', 'Download print-ready output', 'Track completed production'], image: 'badge-preview.png' },
];
const fields = [['01','Attendee identity','Name, photo, designation, company, logo, and contact details.'],['02','Event details','Event name, location, dates, banner, and logo.'],['03','Ticket context','Ticket name, number, and configured ticket dates.'],['04','Exhibitor context','Booth number and exhibitor category where available.'],['05','Registration answers','Common and custom questions from the event form builder.'],['06','Custom content','Text or image elements when the value is not data-bound.']];
const useCases = [
  { id: 'conferences', label: 'Conferences', title: 'Give every attendee the right event identity', description: 'Create role-aware badges for attendees, speakers, sponsors, and staff without rebuilding the layout for each group.', image: 'badge-user-fields.png', fields: ['Ticket and participant-type targeting', 'Names, titles, companies, and QR codes', 'One branded system across every role'] },
  { id: 'exhibitions', label: 'Exhibitions', title: 'Make exhibitors and visitors easy to identify', description: 'Keep access, booth, and company information clear while preserving one consistent exhibition brand.', image: 'badge-event-fields.png', fields: ['Booth and exhibitor details', 'Distinct visitor and vendor designs', 'Scan-ready identification at the venue'] },
  { id: 'associations', label: 'Associations', title: 'Recognize members, chapters, and contributors', description: 'Use membership and registration data to create badges and certificates for each audience you serve.', image: 'certificate-library.png', fields: ['Member-specific identity fields', 'Certificates for speakers and contributors', 'Reusable layouts for recurring programs'] },
  { id: 'corporate', label: 'Corporate events', title: 'Keep internal and guest roles unmistakable', description: 'Adapt the audience rule for employees, partners, VIPs, and visitors while keeping production centralized.', image: 'saved-audience.png', fields: ['Clear access and audience labels', 'Event and company branding', 'Bulk-ready output for event day'] },
  { id: 'tech', label: 'Tech conferences', title: 'Support complex programs with clear credentials', description: 'Create distinct outputs for attendees, mentors, judges, speakers, and sponsors from the same event data.', image: 'registration-form-builder.png', fields: ['Role-specific designs and information', 'Registration-answer data merge', 'Fast updates without layout duplication'] },
  { id: 'multi-day', label: 'Multi-day events', title: 'Carry the right access details across every day', description: 'Use ticket dates and participant rules to produce credentials that remain useful throughout the program.', image: 'ticket-audience-settings.png', fields: ['Ticket and date-aware content', 'Consistent identity across venues', 'Certificates after the event'] },
];
const faqs = [
  ['Can we use registration form answers on a badge?','Yes. The builder can load common and custom form fields alongside attendee, event, ticket, booth, and exhibitor fields. Output depends on the data being present.'],
  ['Can different ticket types use different designs?','Yes. Badges and certificates support common or specific ticket and participant-type targeting. A specific rule must include at least one selected audience.'],
  ['Can a badge contain a QR code?','Yes. The QR element supports size, color, padding, and margin controls. Test the final printed QR with the exact scanner and media.'],
  ['Can we print badges in bulk?','The CMS supports selecting registrations and producing badge outputs with print/download counting. Test the exact printer workflow before the event.'],
  ['How can attendees receive certificates?','Verified paths include CMS download/generation, customized email workflows, attendee-app download, and share-token links where enabled.'],
  ['Are there more than 100 templates or guaranteed printer compatibility?','Those claims were not verified. Choose the actual layout and test the exact printer, driver, browser, and stock.'],
];
---
<div class="bcr-page">
  <section class="bcr-hero">
    <div class="bcr-hero__grid">
      <div class="bcr-hero__copy">
        <span class="bcr-hero__eyebrow">Event badge designer and certificate generator</span>
        <h1>Design each badge and certificate once then fill it with the right attendee data</h1>
        <p>Build branded layouts from event, ticket, participant, and registration fields, then use the output workflow that fits event-day identification or post-event recognition.</p>
        <div class="bcr-actions">
          <a class="bcr-hero__btn" href="/book-a-demo/">See it with your event <span>→</span></a>
          <a class="bcr-hero__btn bcr-hero__btn--outline" href="#workflow">Explore the workflow</a>
        </div>
        <div class="bcr-hero__trust"><span>Data-aware layouts</span><span>Print-ready output</span></div>
      </div>
      <div class="bcr-hero__visual">
        <div class="bcr-hero__visual-card">
          <div class="bcr-hero__visual-inner">
            <img class="bcr-app-shot bcr-app-shot--hero" src="/images/badge-certificate-designer/app/badge-editor-fields.png" alt="EventHex badge editor showing attendee fields, QR controls, canvas, and badge settings" width="1360" height="838" loading="eager" decoding="async"/>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="bcr-rail" id="workflow"><span class="bcr-rail__label">One reusable data merge</span><ol>{steps.map(s=><li><strong>{s[1]}</strong><span>{s[2]}</span></li>)}</ol></section>
  <section class="bcr-dark">
    <div class="bcr-dark__shell">
      <header><span class="bcr-kicker">Visual layout controls</span><h2>Build the canvas from the elements the event actually uses</h2><p>Place identity, branding, QR codes, and data fields with the controls your production workflow needs.</p></header>
      <div class="bcr-stack">
        <span class="bcr-stack__notch bcr-stack__notch--1" aria-hidden="true"></span><span class="bcr-stack__notch bcr-stack__notch--2" aria-hidden="true"></span><span class="bcr-stack__notch bcr-stack__notch--3" aria-hidden="true"></span>
        <article><span class="bcr-stack__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg></span><h3>Text and typography</h3><p>Set hierarchy with editable text, font, color, and alignment.</p></article>
        <article><span class="bcr-stack__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span><h3>Images and backgrounds</h3><p>Use event logos, participant photos, and backgrounds.</p></article>
        <article><span class="bcr-stack__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M16 16h2v2h3v3h-5zM12 3v4M3 12h4M12 17v4M17 12h4"/></svg></span><h3>QR code and scan testing</h3><p>Control size, color, padding, and margin before printing.</p></article>
        <article><span class="bcr-stack__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/></svg></span><h3>Shapes, layers, dimensions, history</h3><p>Adjust canvas dimensions, zoom, layering, and history.</p></article>
      </div>
    </div>
  </section>
  <section class="bcr-fields" data-bcr-fields>
    <div class="bcr-heading"><span class="bcr-kicker">Data-aware layouts</span><h2>Place identity, event, ticket, and registration answers <span>where they belong</span></h2><p>One layout can combine verified event data with the custom fields your audience supplied.</p></div>
    <div class="bcr-grid">{fields.map((f,i)=><article style={`--field-delay:${i * 70}ms`}><h3>{f[1]}</h3><p>{f[2]}</p><div class:list={["bcr-field-visual",`bcr-field-visual--${i + 1}`]} aria-hidden="true">
      {i === 0 && <div class="bcr-mini-profile"><span class="bcr-mini-avatar">AM</span><span><strong>Alex Morgan</strong><small>Product Designer</small></span><i>Verified</i></div>}
      {i === 1 && <div class="bcr-mini-event"><span><small>EVENT</small><strong>EventHex Summit</strong></span><span><small>DATE</small><strong>18 Sep 2026</strong></span></div>}
      {i === 2 && <div class="bcr-mini-ticket"><span>ALL ACCESS</span><strong>Ticket #EH-2048</strong><i></i></div>}
      {i === 3 && <div class="bcr-mini-booth"><span class="bcr-mini-booth__pin">B12</span><span><small>EXHIBITOR</small><strong>Northstar Labs</strong></span><i>Technology</i></div>}
      {i === 4 && <div class="bcr-mini-answer"><span><small>Dietary preference</small><strong>Vegetarian</strong></span><i></i><i></i></div>}
      {i === 5 && <div class="bcr-mini-blocks"><span>Text</span><span>Image</span><span class="is-active">Custom</span></div>}
    </div></article>)}</div>
  </section>
  <section class="bcr-choice">
    <header><span class="bcr-kicker">Apply the right design</span><h2>One layout for everyone, or a design for a defined audience</h2><p>Choose the badge rule that matches how people participate in your event.</p></header>
    <div class="bcr-choice__grid">
      <article class="bcr-choice__copy"><span>Broad audience</span><h3>Common design</h3><p>Apply one consistent badge across all tickets or participant types for a unified event-wide format.</p></article>
      <div class="bcr-choice__media">
        <div class="bcr-choice__composite">
          <img class="bcr-choice__screen bcr-choice__screen--primary" src="/images/badge-certificate-designer/app/badge-user-fields.png" alt="EventHex common badge editor with attendee fields available to every ticket" width="1124" height="838" loading="lazy" decoding="async"/>
          <img class="bcr-choice__screen bcr-choice__screen--secondary" src="/images/badge-certificate-designer/app/badge-library.png" alt="EventHex badge library showing reusable badge designs" width="1360" height="838" loading="lazy" decoding="async"/>
          <span class="bcr-choice__status">✓ One design, every attendee</span><span class="bcr-choice__action">Use common design</span>
        </div>
      </div>
      <div class="bcr-choice__media">
        <div class="bcr-choice__composite">
          <img class="bcr-choice__screen bcr-choice__screen--primary" src="/images/badge-certificate-designer/app/badge-specific-ticket-settings.png" alt="EventHex badge settings configured for a specific ticket audience" width="1124" height="838" loading="lazy" decoding="async"/>
          <img class="bcr-choice__screen bcr-choice__screen--secondary" src="/images/badge-certificate-designer/app/ticket-audience-settings.png" alt="EventHex ticket and participant audience settings" width="1124" height="838" loading="lazy" decoding="async"/>
          <span class="bcr-choice__status">✓ Ticket or participant rule</span><span class="bcr-choice__action">Target audience</span>
        </div>
      </div>
      <article class="bcr-choice__copy"><span>Targeted audience</span><h3>Specific design</h3><p>Choose one or more tickets or participant types when each role needs its own badge layout.</p></article>
      <span class="bcr-choice__cross" aria-hidden="true"></span>
    </div>
    <small>Specific designs require at least one selected ticket or participant type. Confirm precedence when multiple eligible designs exist.</small>
  </section>
  <section class="bcr-output">
    <div class="bcr-output__inner">
      <header class="bcr-output__header">
        <span class="bcr-kicker">Event-day badges</span>
        <h2>Turn selected registrations into personalized, print-ready badges</h2>
        <p>Move from the saved badge design to filtered attendee output and operational print tracking.</p>
      </header>
      <ol class="bcr-output__steps">
        {badgeOutputSteps.map((step, index) => (
          <li>
            <details>
              <summary tabindex="-1">
                <span class="bcr-output__number">0{index + 1}</span>
                <div class="bcr-output__content"><h3>{step.title}</h3><p>{step.description}</p><ul>{step.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul></div>
                <span class="bcr-output__toggle" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5" /></svg></span>
              </summary>
              <div class="bcr-output__visual">
                <img src={`/images/badge-certificate-designer/app/${step.image}`} alt={`EventHex badge workflow: ${step.title}`} width="1124" height="838" loading="lazy" decoding="async"/>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="bcr-certificate">
    <div class="bcr-certificate__intro"><div class="bcr-certificate__sticky"><span class="bcr-certificate__eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15 8.5 17l.7-4-3-2.8 4.1-.6L12 6l1.7 3.6 4.1.6-3 2.8.7 4z"/><path d="M5 3h14v18H5z"/></svg>Post-event certificates</span><h2>Generate recognition <span>for eligible attendees</span></h2><p>Use the certificate layout and audience mapping to create personalized files, then deliver them through a verified channel.</p><a href="/book-a-demo/">Book a Demo <span>→</span></a></div></div>
    <div class="bcr-certificate__cards">
      <article class="bcr-certificate__step"><header><b>01</b><div><h3>Choose eligibility</h3><p>Map the certificate to the tickets or participant types that should receive it.</p></div></header><div class="bcr-certificate__visual"><img src="/images/badge-certificate-designer/app/certificate-settings.png" alt="EventHex certificate settings workspace for choosing certificate eligibility" width="910" height="632" loading="lazy" decoding="async"/></div></article>
      <article class="bcr-certificate__step"><header><b>02</b><div><h3>Generate personalized output</h3><p>Merge the saved design with each eligible attendee’s event data.</p></div></header><div class="bcr-certificate__visual"><img src="/images/badge-certificate-designer/app/badge-preview.png" alt="EventHex design preview used to verify personalized output" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
      <article class="bcr-certificate__step"><header><b>03</b><div><h3>Download in bulk</h3><p>Prepare the eligible certificates together for a controlled post-event workflow.</p></div></header><div class="bcr-certificate__visual"><img src="/images/badge-certificate-designer/app/certificate-library.png" alt="EventHex certificate library where generated certificate designs are managed" width="1360" height="838" loading="lazy" decoding="async"/></div></article>
      <article class="bcr-certificate__step"><header><b>04</b><div><h3>Send or self-serve</h3><p>Deliver through configured email, attendee-app download, or secure share links.</p></div></header><div class="bcr-certificate__visual"><img src="/images/badge-certificate-designer/app/email-campaigns.png" alt="EventHex email campaign workspace for certificate delivery" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
    </div>
  </section>
  <section class="bcr-email" data-bcr-email>
    <div class="bcr-email__inner">
      <header class="bcr-email__header"><span class="bcr-email__eyebrow"><i aria-hidden="true">✦</i>From eligibility to delivery</span><h2>Certificate communication that keeps every <span>recipient connected</span></h2></header>
      <div class="bcr-email__cards">
        <article class="bcr-email__card" style="--email-card-index:0"><div class="bcr-email__copy"><b>01 · Delivery channel</b><h3>Choose when certificate email belongs in the workflow</h3><p>Enable certificate email only when this delivery route fits the attendee journey and intended audience.</p><a href="/book-a-demo/">Explore communication</a></div><div class="bcr-email__visual"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/email-campaigns.png" alt="EventHex email campaign workspace for enabling certificate communication" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
        <article class="bcr-email__card" style="--email-card-index:1"><div class="bcr-email__copy"><b>02 · Message subject</b><h3>Give every certificate a clear arrival</h3><p>Write a concise subject that identifies the event and tells the recipient their certificate is ready.</p><a href="/book-a-demo/">Explore communication</a></div><div class="bcr-email__visual"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/registration-form-builder.png" alt="EventHex form workspace showing attendee fields available for personalized messages" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
        <article class="bcr-email__card" style="--email-card-index:2"><div class="bcr-email__copy"><b>03 · Email content</b><h3>Customize the message around the achievement</h3><p>Store the event context, recognition, and next step each attendee needs independently from the design.</p><a href="/book-a-demo/">Explore communication</a></div><div class="bcr-email__visual"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/email-notification-log.png" alt="EventHex email notification log used to review delivered certificate messages" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
        <article class="bcr-email__card" style="--email-card-index:3"><div class="bcr-email__copy"><b>04 · Controlled send</b><h3>Release certificates to the right people</h3><p>Confirm eligibility and contact data so each personalized certificate reaches its intended recipient.</p><a href="/book-a-demo/">Explore communication</a></div><div class="bcr-email__visual"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/saved-audience.png" alt="EventHex saved audience workspace for confirming certificate recipients" width="1124" height="838" loading="lazy" decoding="async"/></div></article>
        <div class="bcr-email__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>
  <section class="bcr-quality"><header><h2>Run a Finished-File and Print Sample Before Bulk Production</h2><p>Confirm names, images, spacing, and QR scannability with real data.</p></header><div class="bcr-quality__grid"><article class="bcr-quality__copy"><h3>Badge Print Test</h3><p>Verify dimensions, dynamic text length, QR readability, printer path, media, and repeat-print policy.</p></article><div class="bcr-quality__visual" aria-label="Badge print test preview"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/badge-preview.png" alt="EventHex badge preview used for print and QR verification" width="1124" height="838" loading="lazy" decoding="async"/></div><div class="bcr-quality__visual bcr-quality__visual--certificate" aria-label="Certificate file test preview"><img class="bcr-app-shot" src="/images/badge-certificate-designer/app/certificate-settings.png" alt="EventHex certificate settings used before generating final files" width="910" height="632" loading="lazy" decoding="async"/></div><article class="bcr-quality__copy"><h3>Certificate File Test</h3><p>Verify fonts, page dimensions, long names, image quality, eligibility, download, share, and message delivery.</p></article><span class="bcr-quality__cross" aria-hidden="true">✦</span></div></section>
  <section class="bcr-links">
    <div class="bcr-links__inner">
      <header><h2>Connect Design <span>to Event Operations</span></h2></header>
      <div class="bcr-links__grid">
        <a href="/event-registration/"><span class="bcr-links__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg></span><h3>Event Registration</h3><p>Collect identity and custom fields.</p></a>
        <a href="/event-check-in/"><span class="bcr-links__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg></span><h3>Event Check-in</h3><p>Validate arrivals alongside badge printing.</p></a>
        <a href="/event-mobile-app/"><span class="bcr-links__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 5h6M10 18h4"/></svg></span><h3>Event Mobile App</h3><p>Give eligible attendees mobile access.</p></a>
        <a href="/event-notifications/"><span class="bcr-links__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg></span><h3>Event Notifications</h3><p>Plan operational messages separately.</p></a>
      </div>
    </div>
  </section>
  <section class="bcr-use" aria-labelledby="bcr-use-title"><div class="bcr-use__inner">
    <header><h2 id="bcr-use-title"><span>Built for every role that</span><span>needs its own event identity</span></h2><p>Change the audience rule and data—not the whole production system.</p></header>
    <div class="bcr-use__tabs" role="tablist" aria-label="Event types">{useCases.map((item,index)=><button class:list={["bcr-use__tab",{"is-active":index===0}]} type="button" role="tab" aria-selected={index===0?"true":"false"} aria-controls={`bcr-use-panel-${item.id}`} id={`bcr-use-tab-${item.id}`} tabindex={index===0?0:-1} data-bcr-use-tab={item.id}>{item.label}</button>)}</div>
    <div class="bcr-use__panels">{useCases.map((item,index)=><article class:list={["bcr-use__panel",{"is-active":index===0}]} id={`bcr-use-panel-${item.id}`} role="tabpanel" aria-labelledby={`bcr-use-tab-${item.id}`} data-bcr-use-panel={item.id} hidden={index!==0}><div class="bcr-use__copy"><h3>{item.title}</h3><p>{item.description}</p><span class="bcr-use__label">BUILT WITH</span><ul>{item.fields.map(field=><li><span aria-hidden="true">✓</span>{field}</li>)}</ul></div><div class="bcr-use__visual"><img class="bcr-app-shot" src={`/images/badge-certificate-designer/app/${item.image}`} alt={`EventHex product workspace supporting ${item.label.toLowerCase()} badge and certificate workflows`} width="1124" height="838" loading="lazy" decoding="async"/></div></article>)}</div>
  </div></section>
  <section class="bcr-faq"><aside><span class="bcr-kicker">Quick Answers</span><h2>Badge and Certificate<br />Questions, Answered.</h2><p>Find clear answers before building your layouts.</p><a class="bcr-btn bcr-btn--dark" href="/book-a-demo/">Book a Demo <span>→</span></a></aside><div class="bcr-faq__list">{faqs.map((f,i)=><details class="bcr-faq__item" data-bcr-faq open={i===0}><summary><strong>{f[0]}</strong><i aria-hidden="true"></i></summary><div class="bcr-faq__answer"><p>{f[1]}</p></div></details>)}</div></section>
</div>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.bcr-output details').forEach((item, _, all) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const useSection = document.querySelector<HTMLElement>('.bcr-use');
  if (useSection) {
    const tabs = Array.from(useSection.querySelectorAll<HTMLButtonElement>('[data-bcr-use-tab]'));
    const panels = Array.from(useSection.querySelectorAll<HTMLElement>('[data-bcr-use-panel]'));
    const activate = (tab: HTMLButtonElement) => {
      const target = tab.dataset.bcrUseTab;
      tabs.forEach((item) => { const active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { const active = panel.dataset.bcrUsePanel === target; panel.classList.toggle('is-active', active); panel.hidden = !active; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => { if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return; event.preventDefault(); const next = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length; activate(tabs[next]); tabs[next].focus(); });
    });
  }
  const badgeFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-bcr-faq]'));
  badgeFaqItems.forEach((item) => item.addEventListener('toggle', () => {
    if (!item.open) return;
    badgeFaqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));
  const fieldsBand = document.querySelector<HTMLElement>('[data-bcr-fields]');
  if (fieldsBand && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reveal = new IntersectionObserver(([entry]) => {
