<script>
  // FAQ: one open at a time
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-ewb-faq]'));
  faqItems.forEach((item) => item.addEventListener('toggle', () => {
    if (!item.open) return;
    faqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));

  // Tab groups: connected data and domain
  const tabGroup = (tabSel: string, panelSel: string, key: string) => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(tabSel));
    const panels = Array.from(document.querySelectorAll<HTMLElement>(panelSel));
    const activate = (tab: HTMLButtonElement) => {
      const target = tab.dataset[key];
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset[key === 'connectedTab' ? 'connectedPanel' : 'domainPanel'] === target));
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  };
  tabGroup('[data-connected-tab]', '[data-connected-panel]', 'connectedTab');
  tabGroup('[data-domain-tab]', '[data-domain-panel]', 'domainTab');

  // Demo loops play only while on screen; reduced motion gets controls and no autoplay
  const loops = Array.from(document.querySelectorAll<HTMLVideoElement>('.ewb-loop'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) {
    loops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    loops.forEach((video) => observer.observe(video));
  }

  // Highlight the hero step the demo is showing
  const heroVideo = document.querySelector<HTMLVideoElement>('.ewb-hero .ewb-loop');
  const heroSteps = Array.from(document.querySelectorAll<HTMLLIElement>('.ewb-steps li'));
  if (heroVideo && heroSteps.length === 3) {
    const sync = () => {
      const d = heroVideo.duration || 1;
      const idx = Math.min(2, Math.floor((heroVideo.currentTime / d) * 3));
      heroSteps.forEach((li, i) => li.classList.toggle('is-current', i === idx));
    };
    heroVideo.addEventListener('timeupdate', sync);
    sync();
  }
</script>

