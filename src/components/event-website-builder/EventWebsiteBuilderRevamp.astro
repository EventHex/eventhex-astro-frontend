---
import NewSections from "./NewSections.astro";

interface Props { faqs: string[][]; }
const { faqs } = Astro.props;
const V = "/feature-images/event-website-builder/v5/";

const aiSteps = [
  { eyebrow: "01 · Describe the look", title: "Say what you want", body: "Type the feel in plain words, or start from Minimal & editorial, Bold tech conference or Elegant gala. Keep your brand kit, pick one, or let AI create a new kit.", img: "ai-describe.webp", pos: "50% 30%", alt: "Design with AI for the Meridian home page: the look described in words, the Editorial Journal kit picked and 3 designs requested" },
  { eyebrow: "02 · Compare designs", title: "Pick from up to three", body: "Each design is built from your real speakers, sessions and tickets. Switch between them in one click and see each one on the page.", img: "ai-designs-compare.webp", pos: "50% 40%", alt: "AI design 3 for Meridian: dates panel on the left and the call for abstracts up front, with design options 1, 2 and 3 to switch between" },
  { eyebrow: "03 · Keep it or undo", title: "Edit, then publish", body: "The design lands in your private draft. Change any text or section, undo it, or try another. Nothing goes live until you publish.", img: "ai-applied-undo.webp", pos: "50% 100%", alt: "New design applied to the Meridian draft, with Undo and Try another" },
];
const sectionActions = ["Try another layout", "Make it bolder", "More minimal", "Rewrite the text", "Brand-new design"];
const blockNames = ["Heading", "Text", "Image", "Icon", "Button", "Divider", "Agenda", "Gallery", "Countdown", "Form"];
const capabilities = [
  { title: "Layout containers", body: "Compose with container, grid and repeater structures when a standard section is not enough." },
  { title: "Content blocks", body: "Add heading, text, image, icon, button, divider, agenda, gallery, countdown or form blocks.", chips: blockNames },
  { title: "Layer tree", body: "Select, reorder, nest, or remove the current page's sections and supported children." },
  { title: "Section variants", body: "Choose from registered visual variants for each semantic section." },
  { title: "Schema limits", body: "Keep the site inside defined page, node, command-batch, and tree-depth limits.", chips: ["Up to 50 pages", "Up to 80 sections per page"] },
];
const connectedSources = [
  { id: "details", label: "Event details", title: "Update the essentials once", description: "Keep dates, venue details and core event information aligned between the workspace and every connected website section.", points: ["Dates and venue", "Event identity", "Shared website fields"], image: "ascend-studio-pages-and-preview.webp", alt: "Ascend Impact Summit in the builder: the page list on the left and the live event website preview on the right" },
  { id: "speakers", label: "Speakers", title: "Publish the lineup from one roster", description: "Turn the speaker profiles your programme team already maintains into polished, consistent website content.", points: ["Profiles and headshots", "Roles and biographies", "Programme assignments"], image: "meridian-site-desktop-speakers.webp", alt: "Meridian Health Congress website: the faculty listed with photos, roles and affiliations" },
  { id: "sessions", label: "Sessions", title: "Your programme, already assembled", description: "Present the live programme without rebuilding session titles, times, rooms or speaker relationships for the website.", points: ["Agenda times", "Tracks and rooms", "Speaker connections"], image: "pulse-site-desktop-programme.webp", alt: "Pulse Tech Expo website: Main Stage programme with times, session titles and descriptions from the event programme" },
  { id: "tickets", label: "Tickets", title: "Keep registration choices current", description: "Show the ticket options configured by your registration team so visitors always see the right path to attend.", points: ["Ticket names", "Pricing and availability", "Registration actions"], image: "site-checkout.webp", alt: "Meridian checkout on the event website: Virtual Pass USD 120, Student / Resident USD 95, Non-member USD 390, Member USD 290" },
  { id: "sponsors", label: "Sponsors & exhibitors", title: "Give every partner the right visibility", description: "Reuse approved sponsor and exhibitor information across directories, logo walls and featured website sections.", points: ["Partner profiles", "Tiers and categories", "Logos and links"], image: "pulse-site-desktop-speakers.webp", alt: "Pulse Tech Expo website: Voices on the stage, speakers and partners presented on the event site" },
  { id: "gallery", label: "Gallery & forms", title: "Connect every supporting experience", description: "Bring approved media and event forms into the site while keeping their source content in the event workspace.", points: ["Image collections", "Embedded forms", "Calls to action"], image: "ascend-site-register.webp", alt: "Ascend Impact Summit website registration form built from the event's form" },
];
const audiencePages = [
  { number: "01", title: "Home", body: "Orient every visitor with the event story, essential details and the clearest next action.", image: "ascend-studio-pages-and-preview.webp", alt: "Ascend Home page in the builder: header, hero, announcement, stats, overview, bento grid, speakers, agenda, process, tickets and call to action" },
  { number: "02", title: "Agenda", body: "Give programme questions a dedicated destination that can be created and added to the site menu.", image: "ascend-site-desktop-programme.webp", alt: "Ascend Impact Summit programme: three days, seven sessions" },
  { number: "03", title: "Speakers", body: "Introduce the people on a focused page, then shape its typography, spacing, header and footer consistently.", image: "pulse-site-desktop-speakers.webp", alt: "Pulse Tech Expo speakers: Voices on the stage" },
  { number: "04", title: "Register", body: "Complete the journey with a direct registration destination and readable page structure for every audience.", image: "site-register-member.webp", alt: "Meridian registration page for the Member ticket, $290, with Quick Register" },
];
const designCards = [
  { title: "Set the visual foundation", body: "Choose surface, ink, primary, accent, and supporting colors so every page starts from the same palette.", pos: "0% 10%", alt: "Style kit colours: primary, accent, surface and text", h: 170 },
  { title: "Make hierarchy unmistakable", body: "Choose heading and body families from the supported catalog, then give every page a consistent reading rhythm.", pos: "0% 40%", alt: "Style kit fonts for headings and body", h: 170 },
  { title: "Give every section a rhythm", body: "Control radius, density, section rhythm, and layout gaps so pages stay balanced as content changes.", pos: "0% 70%", alt: "Style kit shape and spacing controls", h: 170 },
];
const revisions = ["Private draft", "Saved revisions", "Edit conflict check", "Undo & redo", "Restore"];
const seo = ["Search title", "Search description", "Search terms & social copy", "Language switcher", "Translate missing copy", "Preferred domain"];
const publishSteps = [
  { n: "01", title: "Edit the private draft", desc: "Change any section or text; your live website stays untouched." },
  { n: "02", title: "Preview on desktop, tablet and mobile", desc: "Check the same draft at every device width before it goes out." },
  { n: "03", title: "Publish, then Update", desc: "Publish in one click; after edits the button turns to Update." },
  { n: "04", title: "Restore any earlier version", desc: "Open version history and restore the version your team approves." },
];
const owners = [
  { href: "/session-management/", title: "Session Management", body: "Build the programme used by agenda sections and session pages." },
  { href: "/speaker-management/", title: "Speaker Management", body: "Maintain the speaker profiles presented across the event site." },
  { href: "/event-registration/", title: "Event Registration", body: "Configure the form or checkout behind website registration actions." },
  { href: "/event-analytics/", title: "Event Analytics", body: "Review registration and website-adjacent event outcomes." },
];
---

<main class="ewb-page">
  <!-- 1. HERO -->
  <section class="ewb-hero ds-stage">
    <div class="ewb-hero__grid">
      <div class="ewb-stack ewb-hero__copy">
        <span class="ds-eyebrow">AI Event Website Builder</span>
        <h1 class="ds-h1">Design your event website with AI <span class="ds-hl">in 3 minutes</span></h1>
        <p class="ds-lead">Describe the look you want. Design with AI builds the page from your event's own speakers, sessions and tickets, shows you up to three designs, and you publish when it's right. Every section stays editable.</p>
        <div class="ewb-btnrow"><a class="ds-btn" href="/book-a-demo/">Design with AI</a><a class="ds-btn--ghost" href="#ewb-ai">See how it works <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="ewb-hero__visual">
        <div class="ds-browser">
          <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <video class="ewb-loop" autoplay muted loop playsinline preload="auto" width="1280" height="800" poster={V + "hero-ai-design-poster.webp"} aria-label="Animated demo: in the Meridian Health Congress website, the organiser opens Design with AI, describes the look, compares the designs AI returns and applies one to the live preview">
            <source src={V + "hero-ai-design.webm"} type="video/webm" />
            <source src={V + "hero-ai-design.mp4"} type="video/mp4" />
          </video>
        </div>
        <ol class="ewb-steps" aria-label="What the demo shows"><li>Describe the look</li><li>Compare designs</li><li>Apply and keep editing</li></ol>
      </div>
    </div>
  </section>
  <div class="ewb-chips ds-glass">
    <span><i></i>Up to 3 AI designs per request</span>
    <span><i></i>Filled with your live event data</span>
    <span><i></i>Edit or undo anything</span>
    <span><i></i>Publish in one click</span>
  </div>

  <!-- 2. AI SECTION -->
  <section id="ewb-ai" class="ewb-sec" aria-labelledby="ewb-ai-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <span class="ds-eyebrow">Design with AI</span>
        <h2 class="ds-h2" id="ewb-ai-title">Describe it. Compare designs. <span class="ds-hl">Publish.</span></h2>
        <p class="ds-lead ewb-head__p">No template hunting and no blank page. AI plans the layout, designs every section around your event and checks the result, usually in a minute or two.</p>
      </header>
      <div class="ds-stage ewb-stagebox ewb-grid3">
        {aiSteps.map((s) => (
          <article class="ds-glass ewb-card">
            <span class="ds-eyebrow">{s.eyebrow}</span>
            <h3 class="ds-h3 ds-h3--sm">{s.title}</h3>
            <p class="ds-body ewb-card__p">{s.body}</p>
            <div class="ds-shot ds-shot--crop" style={`--ds-pos:${s.pos};height:230px`}><img src={V + s.img} alt={s.alt} width="2880" height="1800" loading="lazy" decoding="async" /></div>
          </article>
        ))}
      </div>
      <div class="ds-glass ewb-strip">
        <div class="ewb-strip__t"><h3 class="ds-h3 ds-h3--sm">Redesign one section with AI</h3><p class="ds-small">Not happy with the agenda or the hero? Ask AI for just that section.</p></div>
        <div class="ewb-pills">{sectionActions.map((a) => <span class="ewb-pill">{a}</span>)}</div>
      </div>
    </div>
  </section>

  <!-- 3. A -->
  <NewSections section="A" />

  <!-- 4. BUILD WITH THE EVENT MODEL -->
  <section id="workspace" class="ewb-sec ds-night ewb-sec--model" aria-labelledby="ewb-model-title">
    <div class="ewb-in">
      <header class="ewb-head"><h2 class="ds-h2" id="ewb-model-title">Build with the <span class="ds-hl-dark">event model</span></h2></header>
      <div class="ds-glass-dark ewb-model">
        <div class="ds-shot">
          <video class="ewb-loop" autoplay muted loop playsinline preload="none" width="1280" height="800" poster={V + "ascend-live-data-section-poster.webp"} aria-label="Animated demo: in the Ascend Impact Summit website, Add a section, choose Agenda, and the preview fills with Ascend's real sessions from event management">
            <source src={V + "ascend-live-data-section.webm"} type="video/webm" />
            <source src={V + "ascend-live-data-section.mp4"} type="video/mp4" />
          </video>
        </div>
        <div class="ewb-stack">
          <span class="ds-eyebrow">Event sections</span>
          <p class="ds-body">Add hero, overview, speakers, agenda, tickets, sponsors, exhibitors, gallery, location, forms, FAQ and CTA sections.</p>
          <div class="ds-shot"><img src={V + "add-section-library-speakers.webp"} alt="Add a section dialog with Speakers selected and layout previews filled with the real Meridian faculty" width="2880" height="1800" loading="lazy" decoding="async" /></div>
        </div>
      </div>
      <div class="ewb-grid5">
        {capabilities.map((c) => (
          <article class="ds-glass-dark ewb-card ewb-card--cap">
            <h3 class="ds-h3 ds-h3--sm">{c.title}</h3>
            <p class="ds-small">{c.body}</p>
            {c.chips && <div class="ewb-chiplist">{c.chips.map((chip) => <span>{chip}</span>)}</div>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. REUSE THE EVENT DATA -->
  <section class="ewb-sec" aria-labelledby="ewb-connected-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <span class="ds-eyebrow">One source of truth</span>
        <h2 class="ds-h2" id="ewb-connected-title">Reuse the event data your<br />team is <span class="ds-hl">already managing</span></h2>
        <p class="ds-lead ewb-head__p">Bind supported sections and repeaters to EventHex datasets so the website and event workspace share the same source.</p>
        <div class="ewb-tabs" role="tablist" aria-label="Connected event data">
          {connectedSources.map((s, i) => <button class:list={["ewb-tab", { "is-active": i === 2 }]} type="button" role="tab" aria-selected={i === 2 ? "true" : "false"} aria-controls={`ewb-connected-${s.id}`} id={`ewb-connected-tab-${s.id}`} tabindex={i === 2 ? 0 : -1} data-connected-tab={s.id}>{s.label}</button>)}
        </div>
      </header>
      <div class="ds-stage ewb-stagebox">
        {connectedSources.map((s, i) => (
          <article class:list={["ewb-panel", { "is-active": i === 2 }]} id={`ewb-connected-${s.id}`} role="tabpanel" aria-labelledby={`ewb-connected-tab-${s.id}`} data-connected-panel={s.id}>
            <div class="ds-glass ewb-row">
              <div class="ewb-stack">
                <h3 class="ds-h3">{s.title}</h3>
                <p class="ds-body">{s.description}</p>
                <span class="ewb-label">CONNECTED CONTENT</span>
                <ul class="ewb-ticks ewb-ticks--one">{s.points.map((p) => <li><i aria-hidden="true">✓</i>{p}</li>)}</ul>
              </div>
              <div class="ds-shot"><img src={V + s.image} alt={s.alt} width="2880" height="1800" loading="lazy" decoding="async" /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. GIVE EACH QUESTION A CLEAR PAGE -->
  <section class="ewb-sec ds-stage" aria-labelledby="ewb-pages-title">
    <div class="ewb-in ewb-pages">
      <div class="ewb-stack ewb-pages__intro">
        <span class="ds-eyebrow">Clear audience journeys</span>
        <h2 class="ds-h2" id="ewb-pages-title">Give each question a <span class="ds-hl">clear page</span></h2>
        <p class="ds-lead">Keep a home page plus enabled event and custom pages with readable destinations and menu settings.</p>
        <a class="ds-btn ewb-pages__cta" href="/book-a-demo/">Explore Website Builder <span aria-hidden="true">→</span></a>
      </div>
      <div class="ewb-grid2">
        {audiencePages.map((p) => (
          <article class="ds-glass ewb-card ewb-card--page">
            <h3 class="ds-h3 ds-h3--sm">{p.number} {p.title}</h3>
            <p class="ds-small">{p.body}</p>
            <div class="ds-shot ds-shot--crop" style="--ds-pos:0% 0%;height:200px"><img src={V + p.image} alt={p.alt} width="2880" height="1800" loading="lazy" decoding="async" /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. D -->
  <NewSections section="D" />

  <!-- 8. B -->
  <NewSections section="B" />

  <!-- 9. VISUAL SYSTEM -->
  <section class="ewb-sec ds-night ewb-sec--visual" aria-labelledby="ewb-design-system-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <span class="ds-eyebrow">From palette to section refinement</span>
        <h2 class="ds-h2" id="ewb-design-system-title">Build a visual system that keeps every page <span class="ds-hl-dark">connected</span></h2>
      </header>
      <div class="ds-glass-dark ewb-row">
        <div class="ewb-stack">
          <span class="ds-eyebrow">One coherent visual system</span>
          <h3 class="ds-h3">Every page should feel like the same event.</h3>
          <p class="ds-body">Set the shared palette, typography, spacing, effects, and style recipe once, then refine individual sections without losing the thread.</p>
          <a class="ds-btn--light ewb-btn-start" href="/book-a-demo/">Explore More <span aria-hidden="true">→</span></a>
        </div>
        <div class="ds-shot"><img src={V + "pulse-style-kit-packs.webp"} alt="Style kit in the Pulse Tech Expo website: Midnight Luxe selected for the dark expo site, with Editorial Journal and Swiss Modernist alongside" width="2880" height="1800" loading="lazy" decoding="async" /></div>
      </div>
      <div class="ewb-grid4">
        {designCards.map((c) => (
          <article class="ds-glass-dark ewb-card">
            <h3 class="ds-h3 ds-h3--sm">{c.title}</h3>
            <p class="ds-small">{c.body}</p>
            <div class="ds-shot ds-shot--crop" style={`--ds-pos:${c.pos};height:${c.h}px`}><img src={V + "style-kit-edit.webp"} alt={c.alt} width="2880" height="1800" loading="lazy" decoding="async" /></div>
          </article>
        ))}
        <article class="ds-glass-dark ewb-card">
          <h3 class="ds-h3 ds-h3--sm">Refine without losing the system</h3>
          <p class="ds-small">Apply Editorial Journal, Swiss Modernist, Midnight Luxe or Signal Dark, then adjust the selected section or block without rebuilding the whole site.</p>
          <div class="ds-shot ds-shot--crop" style="--ds-pos:0% 20%;height:140px"><img src={V + "style-kit-packs.webp"} alt="Style kit list: Your brand kit, Editorial Journal, Swiss Modernist, Midnight Luxe" width="2880" height="1800" loading="lazy" decoding="async" /></div>
        </article>
      </div>
    </div>
  </section>

  <!-- 10. DEVICES -->
  <section class="ewb-sec" aria-labelledby="ewb-device-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <span class="ds-eyebrow">Design across devices</span>
        <h2 class="ds-h2" id="ewb-device-title">Review the same draft on <span class="ds-hl">desktop, tablet, and mobile</span></h2>
        <p class="ds-lead ewb-head__p">Switch the live draft canvas between supported device widths and adjust responsive properties on individual blocks where available.</p>
      </header>
      <div class="ds-stage ewb-stagebox ewb-devices">
        <article class="ds-glass ewb-card">
          <span class="ds-eyebrow">Reusable block</span>
          <h3 class="ds-h3 ds-h3--sm">Device preview</h3>
          <p class="ds-body ewb-card__p">Review desktop, tablet, and 390-pixel mobile canvas widths from the Studio toolbar.</p>
          <div class="ds-shot">
            <video class="ewb-loop" autoplay muted loop playsinline preload="none" width="1280" height="800" poster={V + "pulse-devices-poster.webp"} aria-label="Animated demo: the Pulse Tech Expo page in the builder switches from desktop to tablet to mobile">
              <source src={V + "pulse-devices.webm"} type="video/webm" />
              <source src={V + "pulse-devices.mp4"} type="video/mp4" />
            </video>
          </div>
        </article>
        <article class="ds-glass ewb-card">
          <span class="ds-eyebrow">Reusable block</span>
          <h3 class="ds-h3 ds-h3--sm">Responsive controls</h3>
          <p class="ds-body ewb-card__p">Set supported mobile/tablet columns and visibility on the selected block.</p>
          <div class="ewb-phones">
            <div class="ds-shot"><img src={V + "ascend-site-mobile-hero.webp"} alt="Ascend Impact Summit site on a phone" width="780" height="1688" loading="lazy" decoding="async" /></div>
            <div class="ds-shot"><img src={V + "meridian-site-mobile-hero.webp"} alt="Meridian Health Congress site on a phone" width="780" height="1688" loading="lazy" decoding="async" /></div>
          </div>
        </article>
      </div>
      <p class="ds-small ewb-note">A preview is a review aid—not a guarantee across every browser, device, content length, form state, or third-party embed. Test the published route before campaign launch.</p>
    </div>
  </section>

  <!-- 11. REVISIONS -->
  <section class="ewb-sec ds-stage" aria-labelledby="ewb-revisions-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <span class="ds-eyebrow">Safe iteration</span>
        <h2 class="ds-h2" id="ewb-revisions-title">Keep unpublished work private and every<br />saved change <span class="ds-hl">revision-aware</span></h2>
      </header>
      <div class="ds-glass ewb-row">
        <div class="ds-shot"><img src={V + "pulse-version-history.webp"} alt="Version history in the Pulse Tech Expo website: current version, earlier edits and Website created, each with Restore this version" width="2880" height="1800" loading="lazy" decoding="async" /></div>
        <div class="ewb-stack">
          <span class="ds-eyebrow">Safe by default</span>
          <h3 class="ds-h3">Revise freely without changing the live website</h3>
          <p class="ds-body">The workflow separates editable draft state from the published website. Save intentional milestones and restore the version your team approves.</p>
          <ul class="ewb-ticks">{revisions.map((r) => <li><i aria-hidden="true">✓</i>{r}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. LISTING + TRANSLATIONS -->
  <section class="ewb-sec" aria-labelledby="ewb-listing-title">
    <div class="ewb-in ewb-listing">
      <div class="ewb-stack">
        <span class="ds-eyebrow">Search and language readiness</span>
        <h2 class="ds-h2" id="ewb-listing-title">Review listing details and <span class="ds-hl">missing translations before publish</span></h2>
        <p class="ds-lead">Set page-level search and social sharing details and work through configured event languages.</p>
        <ul class="ewb-ticks">{seo.map((s) => <li><i aria-hidden="true">✓</i>{s}</li>)}</ul>
      </div>
      <div class="ewb-grid2">
        <div class="ds-shot ewb-zoom"><img src={V + "ascend-page-settings-search-sharing.webp"} alt="Ascend page settings: page title and URL, Show in site menu, and Search and sharing with title and description" width="2880" height="1800" loading="lazy" decoding="async" /></div>
        <div class="ds-shot ewb-zoom"><img src={V + "ascend-languages-panel.webp"} alt="Ascend languages panel: Arabic and English, Translate website, Translate new content automatically and Header language switcher" width="2880" height="1800" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </section>

  <!-- 13. C -->
  <NewSections section="C" />

  <!-- 14. DRAFT TO PUBLISHED -->
  <section class="ewb-sec ds-night" aria-labelledby="ewb-publish-title">
    <div class="ewb-in">
      <header class="ewb-head"><h2 class="ds-h2" id="ewb-publish-title">From private draft to <span class="ds-hl-dark">published website</span></h2></header>
      <div class="ds-glass-dark ewb-row">
        <ol class="ewb-steplist">{publishSteps.map((s) => <li class="ds-body"><b>{s.n} {s.title}</b> · {s.desc}</li>)}</ol>
        <div class="ds-shot"><img src={V + "publish-update-state.webp"} alt="The builder toolbar with the Update button after the draft changed, next to Preview and Design with AI" width="2880" height="1800" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </section>

  <!-- 15. ADDRESS -->
  <section class="ewb-sec ewb-domain" aria-labelledby="ewb-domain-title">
    <div class="ewb-in">
      <header class="ewb-head">
        <h2 class="ds-h2" id="ewb-domain-title">Choose the address your<br /><span class="ds-hl">audience will remember</span></h2>
        <p class="ds-lead ewb-head__p">Launch on an EventHex event subdomain or connect and verify a custom domain.</p>
        <div class="ewb-tabs" role="tablist" aria-label="Domain options">
          <button class="ewb-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ewb-domain-eventhex" id="ewb-tab-eventhex" data-domain-tab="eventhex">Event subdomain</button>
          <button class="ewb-tab" type="button" role="tab" aria-selected="false" aria-controls="ewb-domain-custom" id="ewb-tab-custom" data-domain-tab="custom">Custom domain</button>
        </div>
      </header>
      <div class="ds-stage ewb-stagebox">
        <article class="ewb-panel is-active" id="ewb-domain-eventhex" role="tabpanel" aria-labelledby="ewb-tab-eventhex" data-domain-panel="eventhex">
          <div class="ds-glass ewb-row">
            <div class="ewb-stack">
              <h3 class="ds-h3">Launch on a managed event address</h3>
              <p class="ds-body">Choose an available EventHex event-site subdomain, then manage its active and default state from the event workspace.</p>
