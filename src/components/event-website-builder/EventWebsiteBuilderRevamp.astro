<script>
  const websiteFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-ewb-faq]'));
  websiteFaqItems.forEach((item) => item.addEventListener('toggle', () => {
    if (!item.open) return;
    websiteFaqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));
  const domainTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-domain-tab]'));
  const domainPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-domain-panel]'));
  domainTabs.forEach((tab) => tab.addEventListener('click', () => {
    const target = tab.dataset.domainTab;
    domainTabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
    });
    domainPanels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.domainPanel === target));
  }));
  const connectedTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-connected-tab]'));
  const connectedPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-connected-panel]'));
  const activateConnectedTab = (tab: HTMLButtonElement) => {
    const target = tab.dataset.connectedTab;
    connectedTabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });
    connectedPanels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.connectedPanel === target));
  };
  connectedTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateConnectedTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const next = connectedTabs[(index + direction + connectedTabs.length) % connectedTabs.length];
      activateConnectedTab(next);
      next.focus();
    });
  });
  const publishSteps = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-publish-step]'));
  publishSteps.forEach((step) => step.addEventListener('toggle', () => {
    if (!step.open) return;
    publishSteps.forEach((other) => { if (other !== step) other.open = false; });
  }));
  const designSystemSection = document.querySelector<HTMLElement>('.ewb-design-system');
  const designSystemHeader = designSystemSection?.querySelector<HTMLElement>('.ewb-design-system__header');
  const designSystemCards = designSystemSection?.querySelectorAll<HTMLElement>('.ewb-design-system__card');
  const finalDesignSystemCard = designSystemCards?.[designSystemCards.length - 1];
  if (designSystemHeader && finalDesignSystemCard) {
    let designSystemFrame = 0;
    const syncDesignSystemRelease = () => {
      designSystemFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalDesignSystemCard).top) || 0;
      const releaseOffset = Math.min(0, finalDesignSystemCard.getBoundingClientRect().top - stickyTop);
      designSystemHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueDesignSystemRelease = () => {
      if (designSystemFrame) return;
      designSystemFrame = requestAnimationFrame(syncDesignSystemRelease);
    };
    window.addEventListener('scroll', queueDesignSystemRelease, { passive: true });
    window.addEventListener('resize', queueDesignSystemRelease, { passive: true });
    syncDesignSystemRelease();
  }
</script>

