---
interface Props { faqs: string[][]; }
const { faqs } = Astro.props;

const capabilities = [
  { title: "Event sections", body: "Add hero, overview, speakers, agenda, tickets, sponsors, exhibitors, gallery, location, forms, FAQ and CTA sections.", kind: "sections" },
  { title: "Layout containers", body: "Compose with container, stack, grid, box and repeater structures when a standard section is not enough.", kind: "containers" },
  { title: "Content blocks", body: "Add text, image, video, button, icon, badge, divider, spacer, field, map or registered component blocks.", kind: "blocks" },
  { title: "Layer tree", body: "Select, reorder, nest, or remove the current page's sections and supported children.", kind: "layers" },
  { title: "Section variants", body: "Choose from registered visual variants for each semantic section.", kind: "variants" },
  { title: "Schema limits", body: "Keep the site inside defined page, node, command-batch, and tree-depth limits.", kind: "limits" },
];
const connectedSources = [
  { id: "details", label: "Event details", title: "Update the essentials once", description: "Keep dates, venue details and core event information aligned between the workspace and every connected website section.", points: ["Dates and venue", "Event identity", "Shared website fields"], image: "/feature-images/event-website-builder-v4/website-builder-studio-draft.png", alt: "EventHex Website Builder event details connected to a live website" },
  { id: "speakers", label: "Speakers", title: "Publish the lineup from one roster", description: "Turn the speaker profiles your programme team already maintains into polished, consistent website content.", points: ["Profiles and headshots", "Roles and biographies", "Programme assignments"], image: "/feature-images/speaker-management/speaker-setup-dashboard.png", alt: "EventHex speaker workspace with profiles and programme assignments" },
  { id: "sessions", label: "Sessions", title: "Your programme, already assembled", description: "Present the live programme without rebuilding session titles, times, rooms or speaker relationships for the website.", points: ["Agenda times", "Tracks and rooms", "Speaker connections"], image: "/images/event-website-builder/app/website-builder-connected-content.png", alt: "EventHex Website Builder showing connected event sections beside a live event website preview" },
  { id: "tickets", label: "Tickets", title: "Keep registration choices current", description: "Show the ticket options configured by your registration team so visitors always see the right path to attend.", points: ["Ticket names", "Pricing and availability", "Registration actions"], image: "/feature-images/event-registration/approval-ticket-list.png", alt: "EventHex registration ticket list connected to an event website" },
  { id: "sponsors", label: "Sponsors & exhibitors", title: "Give every partner the right visibility", description: "Reuse approved sponsor and exhibitor information across directories, logo walls and featured website sections.", points: ["Partner profiles", "Tiers and categories", "Logos and links"], image: "/feature-images/event-website-builder-v4/audience-journeys/page-design-controls.png", alt: "EventHex Website Builder page design controls for sponsor and exhibitor content" },
  { id: "gallery", label: "Gallery & forms", title: "Connect every supporting experience", description: "Bring approved media and event forms into the site while keeping their source content in the event workspace.", points: ["Image collections", "Embedded forms", "Calls to action"], image: "/images/live-polling-qa/app/forms-workspace.png", alt: "EventHex forms workspace connected to an event website" },
];
const designControls = [
  { title: "Palette", body: "Set surface, ink, primary, accent, and supporting colors.", image: "/feature-images/event-website-builder-v4/design-stack/palette.png", alt: "EventHex Website Builder palette and site-wide color controls" },
  { title: "Typography", body: "Choose heading and body families from the supported catalog.", image: "/feature-images/event-website-builder-v4/design-stack/typography.png", alt: "EventHex Website Builder typography controls and live page preview" },
  { title: "Shape and spacing", body: "Control radius, density, section rhythm, and layout gaps.", image: "/feature-images/event-website-builder-v4/design-stack/shape-and-spacing.png", alt: "EventHex Website Builder shape and spacing controls" },
  { title: "Effects", body: "Use supported shadows and visual treatments.", image: "/feature-images/event-website-builder-v4/design-stack/effects.png", alt: "EventHex Website Builder effects controls and live preview" },
  { title: "Website styles", body: "Apply one of the four current V4 recipes—Signal, Folio, Mainstage, or Forum—while preserving content.", image: "/feature-images/event-website-builder-v4/design-stack/website-styles.png", alt: "EventHex Website Builder curated website style templates" },
  { title: "Section-level refinement", body: "Adjust the selected section or block without rebuilding the whole site.", image: "/feature-images/event-website-builder-v4/design-stack/section-level-refinement.png", alt: "EventHex Website Builder controls for refining an individual hero section" },
];
const revisions = ["Private draft", "Saved revisions", "Conflict guard", "Undo & redo", "Compare revisions", "Restore"];
const seo = ["Search title", "Search description", "Search terms & social copy", "Language switcher", "Translate missing copy", "Preferred domain"];
const audiencePages = [
  { number: "01", title: "Home", body: "Orient every visitor with the event story, essential details and the clearest next action.", image: "/feature-images/event-website-builder-v4/audience-journeys/sections-and-home.png", alt: "EventHex Website Builder showing the Home page section list and live website preview", badge: "Home · 9 sections" },
  { number: "02", title: "Agenda", body: "Give programme questions a dedicated destination that can be created and added to the site menu.", image: "/feature-images/event-website-builder-v4/audience-journeys/event-page-destinations.png", alt: "EventHex Website Builder menu and navigation panel with Agenda and other event page destinations", badge: "Menu ready" },
  { number: "03", title: "Speakers", body: "Introduce the people on a focused page, then shape its typography, spacing, header and footer consistently.", image: "/feature-images/event-website-builder-v4/audience-journeys/page-design-controls.png", alt: "EventHex Website Builder design controls for page typography, spacing, effects, header and footer", badge: "Site styles connected" },
  { number: "04", title: "Register", body: "Complete the journey with a direct registration destination and readable page structure for every audience.", image: "/feature-images/event-website-builder-v4/audience-journeys/add-page-dialog.png", alt: "EventHex Website Builder dialog for adding a new event or blank page", badge: "Clear destination" },
];
---

<main class="ewb-page">
  <section class="ewb-hero">
    <div class="ewb-wrap ewb-hero__grid">
      <div class="ewb-hero__copy animate-on-scroll" data-animation="fadeInUp">
        <span class="ewb-eyebrow">Event Website Builder V4</span>
        <h1>Build your event website from the work <span>already in EventHex</span></h1>
        <p>Compose a branded, multi-page site with event-native sections, connected data, responsive controls, AI-assisted design and a private draft-to-publish workflow.</p>
        <div class="ewb-actions"><a class="ewb-btn" href="/book-a-demo/">Build your website</a><a class="ewb-link" href="#workspace">Explore the workflow <span>→</span></a></div>
      </div>
      <div class="ewb-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="ewb-browser"><div class="ewb-browser__bar"><i></i><i></i><i></i><span>Private draft</span></div><img src="/feature-images/event-website-builder-v4/website-builder-studio-draft.png" alt="EventHex Website Builder Studio showing a private event website draft and editable section list" width="910" height="696" loading="eager" /></div>
        <span class="ewb-float ewb-float--one">9 editable sections</span><span class="ewb-float ewb-float--two">Draft saved</span>
      </div>
    </div>
  </section>

  <section class="ewb-proof" aria-label="Website builder capabilities"><div class="ewb-wrap"><span><b>Multi-page</b> event sites</span><span><b>Connected</b> event data</span><span><b>Private</b> draft review</span><span><b>Explicit</b> publishing</span></div></section>

  <section id="workspace" class="ewb-section ewb-open"><div class="ewb-wrap">
    <header class="ewb-heading"><h2>Build with the event model</h2></header>
    <div class="ewb-cap-grid">{capabilities.map(({ title, body, kind }, i) => <article class={`ewb-cap ewb-cap--${kind} animate-on-scroll`} data-animation="fadeInUp" data-delay={i * 60}><h3>{title}</h3><p>{body}</p><div class="ewb-cap__visual" aria-hidden="true">
      {kind === "sections" && <div class="ewb-mini-sections"><i>Hero</i><i>Speakers</i><i>Agenda</i><i>Tickets</i></div>}
      {kind === "containers" && <div class="ewb-mini-containers"><span><i></i><i></i></span><span><i></i><i></i><i></i></span></div>}
      {kind === "blocks" && <div class="ewb-mini-blocks"><i>Text</i><i>Image</i><i>Video</i><i>Button</i><i>Map</i><i>Form</i></div>}
      {kind === "layers" && <div class="ewb-mini-layers"><i>Home</i><i>Hero</i><i>Registration</i><i>FAQ</i></div>}
      {kind === "variants" && <div class="ewb-mini-variants"><i><b></b><b></b></i><i><b></b><b></b></i><i><b></b><b></b></i></div>}
      {kind === "limits" && <div class="ewb-mini-limits"><span><b>Pages</b><em>12 / 20</em><i style="--fill:60%"></i></span><span><b>Nodes</b><em>84 / 100</em><i style="--fill:84%"></i></span><span><b>Tree depth</b><em>4 / 6</em><i style="--fill:66%"></i></span></div>}
    </div></article>)}</div>
  </div></section>

  <section class="ewb-section ewb-connected" aria-labelledby="ewb-connected-title"><div class="ewb-wrap">
    <header class="ewb-connected__header"><span class="ewb-eyebrow">One source of truth</span><h2 id="ewb-connected-title"><span>Reuse the event data your</span><span>team is already managing</span></h2><p>Bind supported sections and repeaters to EventHex datasets so the website and event workspace share the same source.</p></header>
    <div class="ewb-connected__tabs" role="tablist" aria-label="Connected event data">
      {connectedSources.map((source, index) => <button class:list={["ewb-connected__tab", { "is-active": index === 2 }]} type="button" role="tab" aria-selected={index === 2 ? "true" : "false"} aria-controls={`ewb-connected-${source.id}`} id={`ewb-connected-tab-${source.id}`} tabindex={index === 2 ? 0 : -1} data-connected-tab={source.id}>{source.label}</button>)}
    </div>
    <div class="ewb-connected__panels">
      {connectedSources.map((source, index) => <article class:list={["ewb-connected__panel", { "is-active": index === 2 }]} id={`ewb-connected-${source.id}`} role="tabpanel" aria-labelledby={`ewb-connected-tab-${source.id}`} data-connected-panel={source.id}>
        <div class="ewb-connected__copy"><h3>{source.title}</h3><p>{source.description}</p><span class="ewb-connected__label">CONNECTED CONTENT</span><ul>{source.points.map((point) => <li><i aria-hidden="true">✓</i>{point}</li>)}</ul></div>
        <div class="ewb-connected__visual" aria-label={`${source.label} website preview`}>
          <img class="ewb-product-shot" src={source.image} alt={source.alt} width="1138" height="878" loading="lazy" decoding="async" />
        </div>
      </article>)}
    </div>
  </div></section>

  <section class="ewb-section ewb-pages" aria-labelledby="ewb-pages-title"><div class="ewb-wrap ewb-pages__layout">
    <div class="ewb-pages__intro"><div class="ewb-pages__sticky"><span class="ewb-pages__eyebrow">Clear audience journeys</span><h2 id="ewb-pages-title">Give each question a clear page</h2><p>Keep a home page plus enabled event and custom pages with readable destinations and menu settings.</p><a class="ewb-pages__cta" href="/book-a-demo/">Explore Website Builder <span aria-hidden="true">→</span></a></div></div>
    <div class="ewb-pages__cards">{audiencePages.map((page, index) => <article class="ewb-page-card" style={`--page-index:${index}`}><header class="ewb-page-card__header"><span class="ewb-page-card__number">{page.number}</span><div><h3>{page.title}</h3><p>{page.body}</p></div></header><div class="ewb-page-card__visual"><div class="ewb-page-card__shot"><img src={page.image} alt={page.alt} width="910" height="696" loading="lazy" decoding="async" /><span><i aria-hidden="true">✓</i>{page.badge}</span></div></div></article>)}</div>
  </div></section>

  <section class="ewb-dark ewb-design-system" aria-labelledby="ewb-design-system-title"><div class="ewb-wrap">
    <header class="ewb-design-system__header">
      <span class="ewb-design-system__eyebrow"><i aria-hidden="true">✦</i>A coherent design system</span>
      <h2 id="ewb-design-system-title"><span class="ewb-design-system__title-line">Control the site-wide look, then refine <span class="ewb-design-system__highlight">individual</span></span><span class="ewb-design-system__title-line">sections</span></h2>
    </header>
    <div class="ewb-design-system__cards">
      {designControls.map((control, index) => <article class="ewb-design-system__card" style={`--stack-index:${index};--stack-accent:${["#728cff", "#a68cff", "#69aee7", "#f0a072", "#8d82ef", "#60bfa9"][index]}`}>
        <div class="ewb-design-system__copy">
          <span class="ewb-design-system__label">Reusable block · 0{index + 1}</span>
          <h3>{control.title}</h3>
          <p>{control.body}</p>
          <a href="/book-a-demo/">Explore in EventHex <span aria-hidden="true">→</span></a>
        </div>
        <div class="ewb-design-system__visual">
          <img src={control.image} alt={control.alt} width="910" height="698" loading="lazy" decoding="async" />
          <span class="ewb-design-system__status"><i aria-hidden="true"></i>Live design preview</span>
        </div>
      </article>)}
      <div class="ewb-design-system__spacer" aria-hidden="true"></div>
    </div>
  </div></section>

  <section class="ewb-section ewb-device-spotlight" aria-labelledby="ewb-device-title">
    <div class="ewb-device-spotlight__header"><span class="ewb-eyebrow">Design across devices</span><h2 id="ewb-device-title">Review the same draft on desktop, tablet, and mobile</h2><p>Switch the live draft canvas between supported device widths and adjust responsive properties on individual blocks where available.</p></div>
    <div class="ewb-device-spotlight__quad">
      <article class="ewb-device-spotlight__cell ewb-device-spotlight__copy"><span>Reusable block</span><h3>Device preview</h3><p>Review desktop, tablet, and 390-pixel mobile canvas widths from the Studio toolbar.</p><b>Visual review</b></article>
      <div class="ewb-device-spotlight__cell ewb-device-spotlight__media"><div class="ewb-device-composite"><img class="ewb-device-composite__screen ewb-device-composite__screen--primary" src="/feature-images/event-website-builder-v4/website-builder-studio-draft.png" alt="EventHex Website Builder desktop draft preview" width="910" height="696" loading="lazy" /><img class="ewb-device-composite__screen ewb-device-composite__screen--secondary" src="/feature-images/event-website-builder-v4/audience-journeys/page-design-controls.png" alt="EventHex Website Builder tablet preview and page design controls" width="910" height="696" loading="lazy" /><span class="ewb-device-composite__status">✓ Desktop · Tablet · 390px</span><span class="ewb-device-composite__action">Review layout</span></div></div>
      <div class="ewb-device-spotlight__cell ewb-device-spotlight__media"><div class="ewb-device-composite ewb-device-composite--controls"><img class="ewb-device-composite__screen ewb-device-composite__screen--primary" src="/feature-images/event-website-builder-v4/website-builder-design-controls.png" alt="EventHex responsive website design controls" width="910" height="696" loading="lazy" /><img class="ewb-device-composite__screen ewb-device-composite__screen--secondary" src="/feature-images/event-website-builder-v4/design-stack/section-level-refinement.png" alt="EventHex section-level responsive refinement controls" width="910" height="698" loading="lazy" /><span class="ewb-device-composite__status">✓ Targeted adjustment</span><span class="ewb-device-composite__action">Apply to block</span></div></div>
      <article class="ewb-device-spotlight__cell ewb-device-spotlight__copy"><span>Reusable block</span><h3>Responsive controls</h3><p>Set supported mobile/tablet columns and visibility on the selected block.</p><b>Targeted adjustment</b></article>
      <span class="ewb-device-spotlight__cross" aria-hidden="true">✦</span>
    </div>
    <div class="ewb-device-spotlight__cue"><span>Decision cue</span><p>A preview is a review aid—not a guarantee across every browser, device, content length, form state, or third-party embed. Test the published route before campaign launch.</p></div>
  </section>

  <section class="ewb-section ewb-ai"><div class="ewb-wrap"><div class="ewb-ai__intro"><div class="ewb-ai__sticky"><span class="ewb-ai__eyebrow">✦ AI-assisted design</span><h2>Generate or refine <span>a design</span></h2><p>Describe the desired experience, review the candidate, and save only after the page structure and editable blocks are acceptable.</p><a href="/ai-event-copilot/">Explore AI Event Copilot <span>→</span></a></div></div><div class="ewb-ai__cards"><article><header><b>01</b><div><h3>Create or refine</h3><p>Choose a page, section, block or shared site style.</p></div></header><div class="ewb-ai__visual"><img class="ewb-product-shot" src="/images/event-website-builder/app/ai-design-generator.png" alt="EventHex AI designer prompting for a new event website direction beside the live draft" width="1138" height="878" loading="lazy" decoding="async" /><i>Describe a direction</i></div></article><article><header><b>02</b><div><h3>Review the candidate</h3><p>Inspect planned sections, editable blocks, warnings and preview.</p></div></header><div class="ewb-ai__visual"><img class="ewb-product-shot" src="/feature-images/event-website-builder-v4/website-builder-design-controls.png" alt="EventHex Website Builder design controls and candidate preview" width="910" height="696" loading="lazy" decoding="async" /><i>Review before saving</i></div></article><article><header><b>03</b><div><h3>Accept or discard</h3><p>Save as a new private draft revision or leave the draft unchanged.</p></div></header><div class="ewb-ai__visual"><img class="ewb-product-shot" src="/feature-images/event-website-builder-v4/website-builder-studio-draft.png" alt="EventHex private website draft with editable sections and live preview" width="910" height="696" loading="lazy" decoding="async" /><i>Draft protected</i></div></article></div></div></section>

  <section class="ewb-section ewb-revisions"><div class="ewb-wrap">
    <header class="ewb-revisions__header animate-on-scroll" data-animation="fadeInUp"><span class="ewb-eyebrow">Safe iteration</span><h2>Keep unpublished work private and every saved change <span>revision-aware</span></h2></header>
    <div class="ewb-revisions__bento animate-on-scroll" data-animation="fadeInUp">
      <span class="ewb-revisions__notch ewb-revisions__notch--top" aria-hidden="true"></span><span class="ewb-revisions__notch ewb-revisions__notch--bottom" aria-hidden="true"></span>
      <div class="ewb-revisions__visual">
        <div class="ewb-revision-stage" role="img" aria-label="EventHex private draft and saved revision history">
          <div class="ewb-revision-window"><header><i></i><i></i><i></i><span>Website revisions</span></header><div class="ewb-revision-window__body"><aside><b>Current website</b><span class="is-current">Private draft</span><span>Published site</span></aside><div class="ewb-revision-history"><span>REVISION HISTORY</span><article class="is-active"><i></i><div><strong>Homepage refined</strong><small>Current private draft · Just now</small></div><em>Active</em></article><article><i></i><div><strong>Connected agenda added</strong><small>Saved revision · 18 min ago</small></div></article><article><i></i><div><strong>Brand styles updated</strong><small>Saved revision · Yesterday</small></div></article></div></div></div>
          <span class="ewb-revision-float ewb-revision-float--top"><b>✓ Draft saved</b><small>Published site unchanged</small></span><span class="ewb-revision-float ewb-revision-float--bottom"><i></i><b>Conflict guard active</b></span>
          <div class="ewb-revision-actions" aria-hidden="true"><span>↶ Undo</span><span>Compare</span><span>Restore</span></div>
        </div>
      </div>
      <div class="ewb-revisions__content"><span class="ewb-revisions__eyebrow">Safe by default</span><h3>Revise freely without changing the live website</h3><p>The V4 workflow separates editable draft state from the published website. Save intentional milestones, compare earlier work and restore the version your team approves.</p><ul>{revisions.map((item) => <li><i>✓</i>{item}</li>)}</ul></div>
    </div>
  </div></section>

  <section class="ewb-section"><div class="ewb-wrap ewb-split"><div><span class="ewb-eyebrow">Search and language readiness</span><h2>Review listing details and missing translations before publish</h2><p>Set page-level search and social sharing details and work through configured event languages.</p><div class="ewb-mini-list">{seo.map(item => <span><i>✓</i>{item}</span>)}</div></div><div class="ewb-browser ewb-browser--seo"><div class="ewb-browser__bar"><i></i><i></i><i></i><span>SEO controls</span></div><img src="/feature-images/event-website-builder-v4/website-builder-seo-controls.png" alt="EventHex Website Builder SEO panel for search, social sharing and page metadata" width="910" height="696" loading="lazy" /></div></div></section>

  <section class="ewb-dark ewb-publish"><div class="ewb-wrap"><header class="ewb-heading"><h2>From private draft to<br />published website</h2></header><ol class="ewb-publish-track"><li><details data-publish-step open><summary><span>01</span><div><h3>Validate structure</h3><p>Check registered blocks, connected data, pages, slugs and site limits.</p></div><i aria-hidden="true"></i></summary><div class="ewb-publish__detail"><img src="/feature-images/event-website-builder-v4/website-builder-studio-draft.png" alt="EventHex Website Builder structure validation view" width="910" height="696" loading="lazy" /></div></details></li><li><details data-publish-step><summary><span>02</span><div><h3>Resolve blockers</h3><p>Fix required image descriptions, button labels, safe links, FAQ answers and contrast.</p></div><i aria-hidden="true"></i></summary><div class="ewb-publish__detail"><img src="/feature-images/event-website-builder-v4/website-builder-seo-controls.png" alt="EventHex Website Builder readiness and SEO controls" width="910" height="696" loading="lazy" /></div></details></li><li><details data-publish-step><summary><span>03</span><div><h3>Review warnings</h3><p>Check empty pages, missing search details, image or text gaps and form selection.</p></div><i aria-hidden="true"></i></summary><div class="ewb-publish__detail"><img src="/feature-images/event-website-builder-v4/website-builder-site-wide-design.png" alt="EventHex Website Builder site-wide design review" width="910" height="696" loading="lazy" /></div></details></li><li><details data-publish-step><summary><span>04</span><div><h3>Publish explicitly</h3><p>Promote only the approved revision after review passes.</p></div><i aria-hidden="true"></i></summary><div class="ewb-publish__detail"><img src="/images/event-website-builder/app/draft-publishing-controls.png" alt="EventHex private draft publishing controls" width="1138" height="620" loading="lazy" /></div></details></li></ol></div></section>

  <section class="ewb-section ewb-domain"><div class="ewb-wrap"><header class="ewb-heading"><h2><span>Choose the address your</span><span>audience will remember</span></h2><p>Launch on an EventHex event subdomain or connect and verify a custom domain.</p></header><div class="ewb-domain__tabs" role="tablist" aria-label="Domain options"><button class="is-active" role="tab" aria-selected="true" aria-controls="ewb-domain-eventhex" id="ewb-tab-eventhex" data-domain-tab="eventhex">Event subdomain</button><button role="tab" aria-selected="false" aria-controls="ewb-domain-custom" id="ewb-tab-custom" data-domain-tab="custom">Custom domain</button></div><div class="ewb-domain__panels"><article class="is-active" id="ewb-domain-eventhex" role="tabpanel" aria-labelledby="ewb-tab-eventhex" data-domain-panel="eventhex"><div><h3>Launch on a managed event address</h3><p>Choose an available EventHex event-site subdomain, then manage its active and default state from the event workspace.</p><ul><li>Availability check</li><li>Managed event route</li><li>Active and default controls</li></ul></div><div class="ewb-domain__visual" aria-hidden="true"><span>Event website address</span><strong>your-event.eventhex.ai</strong><i>Available</i><button tabindex="-1">Use this address</button></div></article><article id="ewb-domain-custom" role="tabpanel" aria-labelledby="ewb-tab-custom" data-domain-panel="custom"><div><h3>Bring your own event domain</h3><p>Add the organizer’s domain, configure the required DNS record, and wait for verification before relying on it.</p><ul><li>DNS configuration required</li><li>Domain verification</li><li>Preferred search address</li></ul></div><div class="ewb-domain__visual" aria-hidden="true"><span>Custom domain</span><strong>events.yourbrand.com</strong><i>Awaiting DNS verification</i><button tabindex="-1">Check verification</button></div></article></div><p class="ewb-note">Test redirects, HTTPS, search tags and every published page on the final host.</p></div></section>

