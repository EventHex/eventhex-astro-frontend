---
const featureCards = [
  {
    eyebrow: "Visual builder",
    title: "Drag, drop, publish — your event website in minutes",
    desc: "Our visual builder gives you pre-built event sections — agenda, speakers, registration, sponsors, venue — ready to customize with your brand and content.",
    items: [
      "Drag-and-drop layout builder",
      "Pre-built event content sections",
      "One-click publish to custom domain",
    ],
    visual: "builder",
    pill: "Drag to reorder",
  },
  {
    eyebrow: "Conversion engine",
    title: "Websites designed to drive registrations and ticket sales",
    desc: "Every template is conversion-optimized with embedded ticket widgets, strategic CTAs, countdown timers, and A/B testing.",
    items: [
      "Inline registration — no redirects",
      "Dynamic countdown timers",
      "A/B headline and CTA testing",
    ],
    visual: "convert",
    pill: "Conversion optimized",
  },
  {
    eyebrow: "Brand control",
    title: "Full brand customization without design skills",
    desc: "Upload your logo, set your colors and fonts, and adjust layouts using intuitive controls. Every page reflects your event brand.",
    items: [
      "Logo, colors, and font customization",
      "40+ professional templates",
      "Responsive across all devices",
    ],
    visual: "brand",
    pill: "Brand controls",
  },
  {
    eyebrow: "Multi-event",
    title: "Manage multiple event websites from one dashboard",
    desc: "Duplicate templates, share brand assets, and maintain consistency across all your events with team collaboration and role-based permissions.",
    items: [
      "Clone templates for recurring events",
      "Shared brand asset library",
      "Team editing with role permissions",
    ],
    visual: "multi",
    pill: "Multi-event dashboard",
  },
];
---

<section class="ewbf-shell">
  <div class="ewbf-section">
    <div class="ewbf-header">
      <span class="ewbf-subtitle">Everything you need to build, customize, and launch event websites</span>
      <h2 class="ewbf-title">
        Everything You Need to <span class="ewbf-highlight">Build, Launch, and Optimize</span><br />
        Event Websites
      </h2>
    </div>

    <div class="ewbf-cards" id="ewbf-stacking-cards">
      {featureCards.map((card, index) => (
        <div class="ewbf-card" data-card-index={index} style={`--card-index: ${index}; top: calc(20px + ${index * 20}px);`}>
          <div class="ewbf-card-content">
            <span class="ewbf-card-eyebrow">{card.eyebrow}</span>
            <h3 class="ewbf-card-title">{card.title}</h3>
            <p class="ewbf-card-desc">{card.desc}</p>
            <ul class="ewbf-card-items">
              {card.items.map((item) => <li>{item}</li>)}
            </ul>
            <a href="/book-a-demo/" class="ewbf-card-btn">Explore More</a>
          </div>

          <div class={`ewbf-card-visual ewbf-card-visual--${card.visual}`}>
            <div class={`ewbf-shot ewbf-shot--${card.visual}`}>
              <img
                src={`/images/ewb/${card.visual}.webp`}
                alt={`${card.eyebrow} — EventHex event website builder`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="ewbf-visual-pill">{card.pill}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .ewbf-shell {
    width: 100%;
    background-color: #000;
    background-image: url('https://cms.eventhex.ai/wp-content/uploads/2024/12/bg-2.webp');
    background-position: center left;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .ewbf-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 80px 0 30px;
  }

  .ewbf-header {
    width: 72%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
  }

  .ewbf-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.48px;
    color: #fff;
    margin: 0;
  }

  .ewbf-title {
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 400;
    color: #fff;
    margin: 0;
    line-height: 1.15;
  }

  .ewbf-highlight { color: #AFA3FF; }

  .ewbf-cards {
    width: 100%;
    padding: 30px 0 0;
    position: relative;
    padding-bottom: 50px;
  }

  .ewbf-card {
    position: sticky;
    display: flex;
    align-items: stretch;
    background: var(--dark-card-bg, rgba(18, 15, 40, 0.88));
    border: 1px solid rgba(172, 161, 241, 0.51);
    border-radius: 20px;
    overflow: hidden;
    height: 500px;
    margin-bottom: 60px;
    transition: transform 0.3s ease;
  }

  .ewbf-card-content {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
    gap: 16px;
  }

  .ewbf-card-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(175, 163, 255, 0.12);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #afa3ff;
  }

  .ewbf-card-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 500;
    color: var(--accent-purple, #AFA3FF);
    margin: 0;
    line-height: 1.2;
  }

  .ewbf-card-desc {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    color: #fff;
    margin: 0;
    line-height: 1.65;
  }

  .ewbf-card-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ewbf-card-items li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  .ewbf-card-items li::before {
    content: "";
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(135deg, #22c55e, #38bdf8);
  }

  .ewbf-card-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: #0A0D14;
    background: var(--accent-btn-purple, #D4CAFE);
    border-radius: 10px;
    padding: 10px 24px;
    text-decoration: none;
    transition: transform 0.3s, background 0.3s;
    margin-top: 8px;
  }

  .ewbf-card-btn:hover { transform: scale(1.05); }

  .ewbf-card-visual {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
    background: radial-gradient(circle at top, rgba(255, 255, 255, 0.08), transparent 52%);
  }

  /* ===== Real product screenshots framed in a window, with subtle zoom/pan ===== */
  .ewbf-shot {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 34px 70px -34px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .ewbf-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  /* Portrait panels (builder / brand) */
  .ewbf-shot--builder,
  .ewbf-shot--brand { width: 300px; max-width: 80%; height: 430px; }
  /* Landscape captures (convert / multi) */
  .ewbf-shot--convert,
  .ewbf-shot--multi { width: 480px; max-width: 96%; height: 300px; }

  /* Builder: slow pan down the section list */
  .ewbf-shot--builder img { object-position: top center; transform-origin: center top; animation: ewbf-pan 16s ease-in-out infinite; }
  @keyframes ewbf-pan {
    0%, 100% { transform: scale(1.06) translateY(0); }
    50% { transform: scale(1.06) translateY(-7%); }
  }
  /* Brand: slow zoom toward the colour swatches */
  .ewbf-shot--brand img { object-position: top center; transform-origin: 32% 60%; animation: ewbf-zoom 15s ease-in-out infinite; }
  @keyframes ewbf-zoom {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.13); }
  }
  /* Convert: slow zoom toward the ticket / price */
  .ewbf-shot--convert img { object-position: left top; transform-origin: 16% 32%; animation: ewbf-zoom-soft 14s ease-in-out infinite; }
  @keyframes ewbf-zoom-soft {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.09); }
  }
  /* Multi: slow zoom out to reveal the events grid */
  .ewbf-shot--multi img { object-position: center; transform-origin: center; animation: ewbf-zoom-out 16s ease-in-out infinite; }
  @keyframes ewbf-zoom-out {
    0%, 100% { transform: scale(1.12); }
    50% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ewbf-shot img { animation: none !important; transform: scale(1.02); }
  }

  .ewbf-visual-pill {
    position: absolute;
    right: 32px;
    bottom: 36px;
    display: inline-flex;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: #183465;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 18px 36px -24px rgba(18, 34, 74, 0.45);
  }

  @media (max-width: 1024px) {
    .ewbf-section { padding: 60px 20px 30px; }
    .ewbf-header { width: 80%; }
    .ewbf-subtitle { font-size: 16px; }
    .ewbf-title { font-size: 40px; line-height: 1em; }
    .ewbf-card { height: 450px; }
    .ewbf-card-content { flex-basis: 50%; }
    .ewbf-card-title { font-size: 28px; }
    .ewbf-card-desc { font-size: 16px; }
  }

  @media (max-width: 767px) {
    .ewbf-section { padding: 50px 20px 30px; }
    .ewbf-header { width: 100%; }
    .ewbf-title { font-size: 30px; }
    .ewbf-card { flex-direction: column; height: 620px; }
    .ewbf-card-content { flex: 0 0 55%; padding: 20px 20px 0; }
    .ewbf-card-visual { min-height: 260px; padding: 12px; }
    .ewbf-card-title { font-size: 24px; }
    .ewbf-card-desc { font-size: 15px; }
    .ewbf-cards { padding-bottom: 40px; }
  }
</style>
