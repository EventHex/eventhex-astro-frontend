---
// Split product hero adapted from Speaker Management.
---

<section class="aech-hero">
  <div class="aech-hero__grid">
    <div class="aech-hero__content">
      <span class="aech-hero__badge animate-on-scroll" data-animation="fadeInDown">
        AI agent for event management
      </span>
      <h1 class="aech-hero__title animate-on-scroll" data-animation="fadeInUp">
        Meet the AI event copilot that works from your event
      </h1>
      <p class="aech-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
        Ask a question, inspect event records, prepare content, or carry out supported organizer tasks from one EventHex conversation. Copilot works with the event you select and keeps important changes under your control.
      </p>
      <div class="aech-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
        <span>Ask in plain English</span>
        <span>Move from answer to action</span>
        <span>Keep the control point</span>
      </div>
      <div class="aech-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
        <a href="/book-a-demo/" class="aech-hero__btn aech-hero__btn--primary">Book a Demo</a>
        <a href="#aec-capabilities" class="aech-hero__btn aech-hero__btn--secondary">See what Copilot can do</a>
      </div>
    </div>

    <div class="aech-hero__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="aech-hero__visual-card">
        <div class="aech-hero__visual-inner">
          <div class="aech-hero__prompt" aria-hidden="true">
            <span>✦</span>
            <strong>Ask Copilot</strong>
            <p>Show the agenda and speaker status</p>
          </div>
          <figure class="aech-hero__shot aech-hero__shot--dashboard">
            <img
              src="/feature-images/speaker-management/session-scheduling-dashboard.png"
              alt="Populated EventHex agenda for the Festival event"
              width="762"
              height="696"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
          <figure class="aech-hero__shot aech-hero__shot--registrations">
            <img
              src="/feature-images/speaker-management/speaker-setup-dashboard.png"
              alt="Populated EventHex speaker records for the Festival event"
              width="762"
              height="696"
              loading="eager"
              decoding="async"
            />
          </figure>
          <div class="aech-hero__result" aria-hidden="true">
            <i></i>
            <span><strong>Event context connected</strong>Agenda and speaker records ready</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aech-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, #375dfb24, #375dfb0f 40%, #375dfb00 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, #ff74b82b, #ff74b812 45%, #ff74b800 78%),
      #fff;
  }
  .aech-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, #fff0, #ffffff73 70%, #ffffffbf);
    pointer-events: none;
  }
  .aech-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(280px, 542px) minmax(0, 490px);
    align-items: center;
    gap: 48px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .aech-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .aech-hero__badge {
    color: var(--brand-blue);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .aech-hero__title {
    max-width: 620px;
    margin: 0;
    background: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%);
    background-clip: text;
    color: transparent;
    font-family: var(--font-heading);
    font-size: 52px;
    font-weight: 500;
    line-height: 58px;
    letter-spacing: -2.1px;
  }
  .aech-hero__desc {
    max-width: 560px;
    margin: 0;
    color: var(--subheading-gray);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 24px;
  }
  .aech-hero__points { display: flex; flex-wrap: wrap; gap: 10px 18px; }
  .aech-hero__points span {
    position: relative;
    padding-left: 16px;
    color: #475467;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
  }
  .aech-hero__points span::before {
    content: "";
    position: absolute;
    top: 7px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }
  .aech-hero__cta { display: flex; gap: 14px; padding-top: 4px; }
  .aech-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 32px;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform .25s ease, background .25s ease, border-color .25s ease;
  }
  .aech-hero__btn:hover { transform: translateY(-2px); }
  .aech-hero__btn--primary { color: #fff; background: var(--heading-dark); }
  .aech-hero__btn--primary:hover { background: #000; }
  .aech-hero__btn--secondary { border: 1px solid #dce4ff; color: var(--heading-dark); background: #ffffffe6; }
  .aech-hero__btn--secondary:hover { border-color: #c5d2ff; }
  .aech-hero__visual { position: relative; z-index: 3; margin-right: calc(-1 * (max(0px, (100vw - 1168px) / 2) + 24px)); }
  .aech-hero__visual-card {
    position: relative;
    padding: 14px;
    border: 1px solid #ffffff9e;
    border-right: 0;
    border-radius: 22px 0 0 22px;
    background: linear-gradient(180deg, #ffffff9e, #ffffff47), #ffffff57;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .aech-hero__visual-inner {
    position: relative;
    overflow: hidden;
    border-radius: 16px 0 0 16px;
    min-height: 470px;
    background: linear-gradient(135deg, #d9ecfa, #eef6fc 45%, #fff);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .aech-hero__shot {
    position: absolute;
    overflow: hidden;
    margin: 0;
    border: 1px solid #dce3ee;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 16px 42px #2d426824;
  }
  .aech-hero__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  .aech-hero__shot--dashboard {
    top: 72px;
    left: 28px;
    z-index: 1;
    width: min(80%, 405px);
    aspect-ratio: 762 / 696;
  }
  .aech-hero__shot--registrations {
    top: 54px;
    right: -24px;
    z-index: 2;
    width: min(58%, 285px);
    height: 142px;
  }
  .aech-hero__prompt {
    position: absolute;
    top: 22px;
    left: 18px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 36px);
    padding: 10px 13px;
    border: 1px solid #dce3ee;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 28px #2d426824;
    color: #26304a;
    font-family: var(--font-body);
  }
  .aech-hero__prompt > span { display: grid; place-items: center; flex: 0 0 27px; width: 27px; height: 27px; border-radius: 8px; color: #fff; background: var(--brand-blue); font-size: 14px; }
  .aech-hero__prompt strong { flex: 0 0 auto; font-size: 11px; }
  .aech-hero__prompt p { overflow: hidden; margin: 0; color: #667085; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
  .aech-hero__result {
    position: absolute;
    bottom: 22px;
    left: 20px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    border: 1px solid #dce3ee;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 28px #2d426824;
    color: #687286;
    font: 10px/1.35 var(--font-body);
  }
  .aech-hero__result i { flex: 0 0 8px; width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px #10b9811f; }
  .aech-hero__result span { display: flex; flex-direction: column; }
  .aech-hero__result strong { color: #26304a; font-size: 11px; }

  @media (min-width: 1280px) {
    .aech-hero__visual {
      justify-self: end;
      width: 550px;
      margin-right: -24px;
    }
    .aech-hero__visual-card {
      border-right: 1px solid #ffffff9e;
      border-radius: 22px;
    }
    .aech-hero__visual-inner { border-radius: 16px; }
    .aech-hero__shot--registrations {
      top: 48px;
      right: 18px;
      width: min(64%, 330px);
      height: 166px;
    }
    .aech-hero__shot--registrations img {
      transform: scale(1.1);
      transform-origin: left top;
    }
  }

  @media (max-width: 960px) {
    .aech-hero { padding: 130px 20px 52px; }
    .aech-hero::after { display: none; }
    .aech-hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .aech-hero__content { align-items: center; text-align: center; }
    .aech-hero__title, .aech-hero__desc { max-width: 760px; }
    .aech-hero__points, .aech-hero__cta { justify-content: center; }
    .aech-hero__visual { width: min(760px, 100%); margin: 0 auto; }
    .aech-hero__visual-card { border-right: 1px solid #ffffff9e; border-radius: 22px; }
    .aech-hero__visual-inner { border-radius: 16px; }
  }
  @media (max-width: 767px) {
    .aech-hero { margin-top: -80px; padding: 120px 16px 44px; }
    .aech-hero__title { font-size: 38px; line-height: 1.12; letter-spacing: -1.2px; }
    .aech-hero__desc { font-size: 15px; line-height: 1.65; }
    .aech-hero__points span { font-size: 13px; }
    .aech-hero__cta { flex-direction: column; width: 100%; }
    .aech-hero__btn { width: 100%; }
    .aech-hero__visual-card { padding: 9px; border-radius: 18px; }
    .aech-hero__visual-inner { min-height: 360px; border-radius: 12px; }
    .aech-hero__shot--dashboard { top: 62px; left: 14px; width: 80%; }
    .aech-hero__shot--registrations { top: 48px; right: -18px; width: 58%; height: 96px; }
    .aech-hero__prompt { top: 16px; left: 12px; }
    .aech-hero__result { bottom: 16px; left: 12px; }
  }
  @media (max-width: 420px) {
    .aech-hero__title { font-size: 33px; }
    .aech-hero__visual-inner { min-height: 330px; }
    .aech-hero__prompt p { max-width: 132px; }
    .aech-hero__result { padding: 8px 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aech-hero__btn { transition: none; }
  }
</style>
