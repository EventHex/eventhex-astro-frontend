  .aecp-lifecycle {
    padding: 80px 5% 48px;
    background: transparent;
  }
  .aecp-lifecycle__container { max-width: 1200px; margin: 0 auto; }
  .aecp-lifecycle__header { margin-bottom: 60px; }
  .aecp-lifecycle__grid {
    position: relative;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    background: transparent;
  }
  .aecp-lifecycle__notch {
    position: absolute;
    left: 50%;
    z-index: 2;
    width: 28px;
    height: 28px;
    line-height: 0;
    pointer-events: none;
  }
  .aecp-lifecycle__notch--top { top: 0; transform: translate(-50%, -50%); }
  .aecp-lifecycle__notch--bottom { bottom: 0; transform: translate(-50%, 50%); }
  .aecp-lifecycle__row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #e5e7eb;
  }
  .aecp-lifecycle__row:last-child { border-bottom: 0; }
  .aecp-lifecycle__cell { display: flex; flex-direction: column; justify-content: center; padding: 4rem; }
  .aecp-lifecycle__row .aecp-lifecycle__visual { border-right: 1px solid #e5e7eb; }
  .aecp-lifecycle__row--reverse .aecp-lifecycle__content { grid-column: 1; grid-row: 1; }
  .aecp-lifecycle__row--reverse .aecp-lifecycle__visual { grid-column: 2; grid-row: 1; border-right: 0; }
  .aecp-lifecycle__row--reverse .aecp-lifecycle__content { border-right: 1px solid #e5e7eb; }
  .aecp-lifecycle__visual { align-items: center; background: transparent; }
  .aecp-lifecycle__stage { position: relative; isolation: isolate; width: 100%; padding: 32px 18px; border-radius: 22px; }
  .aecp-lifecycle__stage--1 { background: linear-gradient(180deg, #fdefb8 0%, #fdf7dd 45%, #f5f6f9 100%); }
  .aecp-lifecycle__stage--2 { background: linear-gradient(180deg, #cdf3de 0%, #e6f8ee 45%, #f5f6f9 100%); }
  .aecp-lifecycle__stage--3 { background: linear-gradient(180deg, #dbe1fb 0%, #eceffd 45%, #f5f6f9 100%); }
  .aecp-lifecycle__stage--4 { background: linear-gradient(180deg, #fbdde4 0%, #fdecf0 45%, #f5f6f9 100%); }
  .aecp-lifecycle__stage img { display: block; width: 100%; border: 1px solid #dfe4ec; border-radius: 14px; animation: aecp-lifecycle-breathe 7s ease-in-out infinite; will-change: transform; }
  .aecp-lifecycle__row:nth-child(even) .aecp-lifecycle__stage img { animation-delay: -3.5s; }
  .aecp-lifecycle__float {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 14px;
    border: 1px solid rgba(206, 215, 232, .9);
    border-radius: 12px;
    color: #111827;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 14px 34px rgba(30, 45, 88, .2);
    font-family: var(--font-body);
    line-height: 1.15;
    animation: aecp-lifecycle-float 4.8s ease-in-out infinite;
    backdrop-filter: blur(10px);
  }
  .aecp-lifecycle__float b { font-size: .78rem; font-weight: 700; white-space: nowrap; }
  .aecp-lifecycle__float small { display: block; color: #7b8497; font-size: .65rem; white-space: nowrap; }
  .aecp-lifecycle__float i { width: 9px; height: 9px; border-radius: 50%; background: #19b874; box-shadow: 0 0 0 5px rgba(25, 184, 116, .13); }
  .aecp-lifecycle__float--top { top: 12px; right: 3px; align-items: flex-start; flex-direction: column; gap: 3px; }
  .aecp-lifecycle__float--bottom { bottom: 12px; left: 3px; animation-delay: -2.4s; }
  .aecp-lifecycle__visual:hover .aecp-lifecycle__stage img { animation-play-state: paused; transform: scale(1.018); }
  .aecp-lifecycle__content > span { display: block; margin-bottom: 1rem; color: #5b21b6; font: 600 .875rem/1.2 var(--font-body); letter-spacing: .05em; text-transform: uppercase; }
  .aecp-lifecycle__content h3 { margin: 0 0 1.25rem; color: #111827; font: 500 2.25rem/1.02 var(--font-heading); letter-spacing: -.02em; }
  .aecp-lifecycle__content p { margin: 0; color: #4b5563; font: 1.125rem/1.45 var(--font-body); }
  .aecp-lifecycle__cross { position: absolute; bottom: 0; left: 50%; z-index: 2; width: 28px; height: 28px; line-height: 0; transform: translate(-50%, 50%); pointer-events: none; }
  .aecp-lifecycle__row:last-child .aecp-lifecycle__cross { display: none; }
  @keyframes aecp-lifecycle-breathe { 0%, 100% { transform: translateY(3px) scale(.985); } 50% { transform: translateY(-3px) scale(1); } }
  @keyframes aecp-lifecycle-float { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -9px, 0); } }

