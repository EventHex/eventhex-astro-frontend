    <p>Go deeper when you need the full workflow, configuration,<br />and controls for a specific event job.</p>
  </header>
  <nav class="aecp-related__grid" aria-label="Related EventHex features">
    {[1, 2, 3, 4].map((notch) => (
      <span class:list={["aecp-related__notch", `aecp-related__notch--${notch}`]} aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #dfe4ec)"></path></svg>
      </span>
    ))}
    {related.map(([title, href, text], index) => (
      <article class="aecp-related__card animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
        {index === 2 && (
          <span class="aecp-related__cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #dfe4ec)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #dfe4ec)" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #dfe4ec)" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #dfe4ec)" transform="rotate(-90)"></path>
            </svg>
          </span>
        )}
        <span class="aecp-related__icon" aria-hidden="true">
          {index === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"></path><circle cx="12" cy="12" r="3"></circle></svg>}
          {index === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg>}
          {index === 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18M8 14h3M8 17h6"></path></svg>}
          {index === 3 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13 13 20 4 11V4h7l9 9Z"></path><circle cx="8.5" cy="8.5" r="1"></circle></svg>}
