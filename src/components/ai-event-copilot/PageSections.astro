---
const prompts = [
  { q: "What still needs attention before launch?", a: "Review tickets, sessions, speakers, website, registration form, badge setup, and campaigns as a readiness checklist." },
  { q: "How many attendees have checked in?", a: "See registered and checked-in totals, the check-in rate, ticket breakdown, and recent arrivals." },
  { q: "Find VIP attendees who have not checked in.", a: "Search attendees by ticket, check-in state, approval, payment, date, name, email, or phone." },
  { q: "Show recent paid or failed orders.", a: "Filter event orders by payment status, ticket, attendee name, or email." },
  { q: "Which exhibitors captured the most leads?", a: "Compare exhibitor lead totals, priority mix, and active booth members." },
  { q: "How are registrations and revenue trending?", a: "Turn supported event metrics into a focused answer, chart, or summary." },
];

const process = [
  { step: "01", title: "Ask in plain language", text: "Describe the question or outcome in the same language your event team already uses.", bullets: ["Typed requests", "Voice notes when supported", "Specific questions or outcomes"], image: "/feature-images/ai-event-copilot/portal/dashboard.png", alt: "EventHex organizer dashboard for Athar 2026" },
  { step: "02", title: "Anchor it to the right event", text: "Copilot uses the event you selected, the organizer page you are viewing, and the relevant records available to you.", bullets: ["Selected event context", "Current organizer page", "Relevant event records"], image: "/feature-images/ai-event-copilot/portal/event-setup.png", alt: "Event settings in the EventHex organizer portal" },
  { step: "03", title: "Let Copilot do the supported work", text: "It reads the right event area, prepares the result, or calls the supported EventHex tool for the request.", bullets: ["Read the right event area", "Prepare a structured result", "Call a supported tool"], image: "/feature-images/ai-event-copilot/portal/sessions.png", alt: "Session workspace in the EventHex organizer portal" },
  { step: "04", title: "Review the important decision", text: "Refine drafts when details are missing and confirm destructive or event-wide changes before they run.", bullets: ["Review proposed values", "Refine missing details", "Confirm higher-impact changes"], image: "/feature-images/ai-event-copilot/portal/registrations.png", alt: "Registration workspace in the EventHex organizer portal" },
  { step: "05", title: "Continue from the result", text: "See the answer or completed action, open the affected workflow, and continue the event-scoped conversation.", bullets: ["Open the affected workflow", "Return through conversation history", "Ask the next event question"], image: "/feature-images/ai-event-copilot/portal/analytics.png", alt: "Analytics workspace in the EventHex organizer portal" },
];

const continuity = [
  ["01", "Use event-aware starters", "Begin with suggestions shaped by the selected event and current organizer page.", "/feature-images/ai-event-copilot/portal/dashboard.png", "EventHex organizer dashboard"],
  ["02", "Type, speak, or mention", "Send a typed request, transcribe a voice note, or mention a specific event record when supported.", "/feature-images/ai-event-copilot/portal/speakers.png", "Speaker records in the EventHex organizer portal"],
  ["03", "Watch the work", "For multi-step requests, follow the plan and tool activity while the response is prepared.", "/feature-images/ai-event-copilot/portal/sessions.png", "Session records in the EventHex organizer portal"],
  ["04", "Return to conversations", "Use event-scoped threads and history to continue related work without starting from a blank chat.", "/feature-images/ai-event-copilot/portal/analytics.png", "Event analytics in the EventHex organizer portal"],
];

const lifecycle = [
  { phase: "Prepare", title: "Before launch", text: "Audit setup, inspect tickets, prepare sessions, build forms, create coupons, and draft promotion copy.", image: "/feature-images/ai-event-copilot/portal/event-setup.png", alt: "EventHex event setup workspace", status: "Setup and readiness" },
  { phase: "Monitor", title: "As registrations grow", text: "Search attendees, review orders, compare registration signals, and export the audience segment you need.", image: "/feature-images/ai-event-copilot/portal/registrations.png", alt: "EventHex attendee registration workspace", status: "Attendees and orders" },
  { phase: "Operate", title: "On event day", text: "Check live attendance, find a registration, review exhibitors, and create or inspect a session poll.", image: "/feature-images/ai-event-copilot/portal/dashboard.png", alt: "EventHex live event overview dashboard", status: "Live event activity" },
  { phase: "Review", title: "After the event", text: "Review the event data, exhibitor lead activity, poll results, and the operational questions your team needs to answer next.", image: "/feature-images/ai-event-copilot/portal/analytics.png", alt: "EventHex event analytics workspace", status: "Results and reporting" },
];

const audiences = [
  { id: "exhibitions", title: "Exhibitions", text: "Move between exhibitor directories, booth lead activity, attendee search, tickets, and live check-in questions.", checklist: ["Exhibitor and attendee records", "Lead-capture activity", "Tickets and live check-in"], image: "/feature-images/ai-event-copilot/portal/dashboard.png", alt: "Event overview in EventHex" },
  { id: "conferences", title: "Conferences and Tech Events", text: "Coordinate agenda records, speakers, polls, registrations, ticket setup, and operational reporting.", checklist: ["Agenda and speaker records", "Session engagement tools", "Registration reporting"], image: "/feature-images/ai-event-copilot/portal/sessions.png", alt: "Conference session management in EventHex" },
  { id: "associations", title: "Associations", text: "Support recurring member events with focused attendee, form, agenda, coupon, and order tasks.", checklist: ["Attendee and form tasks", "Agenda and coupon setup", "Order review"], image: "/feature-images/ai-event-copilot/portal/registrations.png", alt: "Attendee registration management in EventHex" },
  { id: "corporate", title: "Corporate Events and Agencies", text: "Give teams one conversational route into supported workflows while keeping each event separately scoped.", checklist: ["Event-scoped workflows", "Supported organizer actions", "Separate event context"], image: "/feature-images/ai-event-copilot/portal/speakers.png", alt: "Speaker management in EventHex" },
];

const related = [
  ["AI Platform", "/ai-platform/", "Forms, networking, photo, and recap tools"],
  ["Event Analytics", "/event-analytics/", "Dashboards and reporting workflows"],
  ["Session Management", "/session-management/", "Agenda, speakers, schedules, and conflicts"],
  ["Event Ticketing", "/event-ticketing/", "Ticket setup, inventory, delivery, and rules"],
  ["AI Form Builder", "/ai-form-builder/", "Build forms from a plain-language start"],
];
---

<section class="aecp-comparison" id="aec-event-aware">
  <header class="aecp-heading animate-on-scroll" data-animation="fadeInUp">
    <span>Event-aware by design</span>
    <h2>Go Beyond a Generic Chat Window</h2>
    <p>EventHex Copilot combines conversation with supported tools for the event your team is managing.</p>
  </header>
  <div class="aecp-comparison__grid">
    <article class="aecp-comparison__copy animate-on-scroll" data-animation="fadeInUp">
      <span class="aecp-comparison__tag">Useful for general ideas</span>
      <h3>A generic AI chat</h3>
      <p>Works from the context you paste in, then leaves your team to find the record, open the right screen, and carry out the next step.</p>
    </article>
    <div class="aecp-comparison__media animate-on-scroll" data-animation="fadeInRight">
      <div class="aecp-comparison__composite">
        <img class="aecp-comparison__screen aecp-comparison__screen--primary" src="/feature-images/ai-event-copilot/portal/event-setup.png" alt="EventHex event setup workspace" width="1117" height="837" loading="lazy" decoding="async" />
        <img class="aecp-comparison__screen aecp-comparison__screen--secondary" src="/feature-images/ai-event-copilot/portal/sessions.png" alt="EventHex session management workspace" width="1117" height="837" loading="lazy" decoding="async" />
        <img class="aecp-comparison__screen aecp-comparison__screen--detail" src="/feature-images/ai-event-copilot/portal/speakers.png" alt="EventHex speaker management workspace" width="1117" height="837" loading="lazy" decoding="async" />
        <span class="aecp-comparison__status">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
          Gather context manually
        </span>
        <span class="aecp-comparison__action">Paste into chat</span>
        <img class="aecp-comparison__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
      </div>
    </div>
    <div class="aecp-comparison__media aecp-comparison__media--accent animate-on-scroll" data-animation="fadeInLeft">
      <div class="aecp-comparison__composite">
        <img class="aecp-comparison__screen aecp-comparison__screen--primary" src="/feature-images/ai-event-copilot/portal/dashboard.png" alt="EventHex event overview dashboard" width="1117" height="837" loading="lazy" decoding="async" />
        <img class="aecp-comparison__screen aecp-comparison__screen--secondary" src="/feature-images/ai-event-copilot/portal/analytics.png" alt="EventHex event analytics workspace" width="1117" height="837" loading="lazy" decoding="async" />
        <img class="aecp-comparison__screen aecp-comparison__screen--detail" src="/feature-images/ai-event-copilot/portal/registrations.png" alt="EventHex registration records workspace" width="1117" height="837" loading="lazy" decoding="async" />
        <span class="aecp-comparison__status">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
          Selected event context
        </span>
        <span class="aecp-comparison__action">Continue in EventHex</span>
        <img class="aecp-comparison__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
      </div>
    </div>
    <article class="aecp-comparison__copy aecp-comparison__copy--accent animate-on-scroll" data-animation="fadeInUp">
      <span class="aecp-comparison__tag">Built for organizer workflows</span>
      <h3>EventHex Copilot</h3>
      <p>Works within an event you can access, uses the relevant EventHex tool, and can return a chart, table, draft, checklist, download, or action result.</p>
    </article>
    <span class="aecp-comparison__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28">
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e5eb"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e5eb" transform="scale(1,-1)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e5eb" transform="rotate(90)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e1e5eb" transform="rotate(-90)"></path>
      </svg>
    </span>
  </div>
  <p class="aecp-note">Move across supported organizer workflows without choosing a different assistant for each job.</p>
</section>

<section class="aecp-dark" id="aec-capabilities">
  <header class="aecp-capabilities-heading">
    <span class="aecp-capabilities-heading__eyebrow">Ask the event, not the dashboard</span>
    <h2 class="animate-on-scroll" data-animation="fadeInUp">
      Start with the Question <span>Your Team Is Already Asking</span>
    </h2>
    <p>Copilot routes each request to the relevant event area and returns the answer in a useful format.</p>
  </header>
  <div class="aecp-grid-section">
    <div class="aecp-prompt-grid">
      {prompts.map((prompt, index) => (
        <article class="aecp-prompt animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
          {(index === 1 || index === 2) && (
            <>
              <span class="aecp-prompt__petal aecp-prompt__petal--top" aria-hidden="true">
                <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
              </span>
              <span class="aecp-prompt__petal aecp-prompt__petal--bottom" aria-hidden="true">
                <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg>
              </span>
            </>
          )}
          <span class="aecp-prompt__number">{String(index + 1).padStart(2, "0")}</span>
          <h3>“{prompt.q}”</h3>
          <p>{prompt.a}</p>
          <div class="aecp-prompt__visual" aria-hidden="true">
            {index === 0 && (
              <div class="aecp-cap-checklist">
                <strong>Launch readiness</strong>
                <span><i></i>Tickets<b>Ready</b></span>
                <span><i></i>Sessions<b>Review</b></span>
                <span><i></i>Speakers<b>Ready</b></span>
              </div>
            )}
            {index === 1 && (
              <div class="aecp-cap-progress">
                <strong>Live attendance</strong>
                <span>Registered</span><i><b></b></i>
                <span>Checked in</span><i><b></b></i>
              </div>
            )}
            {index === 2 && (
              <div class="aecp-cap-filters">
                <strong>Attendee search</strong>
                <div><span>VIP</span><span class="is-active">Not checked in</span><span>Search</span></div>
              </div>
            )}
            {index === 3 && (
              <div class="aecp-cap-orders">
                <strong>Recent orders</strong>
                <span><i></i>Order status<b>Paid</b></span>
                <span><i></i>Order status<b class="is-failed">Failed</b></span>
              </div>
            )}
            {index === 4 && (
              <div class="aecp-cap-leads">
                <strong>Exhibitor leads</strong>
                <span><i style="--bar: 88%"></i></span>
                <span><i style="--bar: 68%"></i></span>
                <span><i style="--bar: 46%"></i></span>
              </div>
            )}
            {index === 5 && (
              <div class="aecp-cap-trend">
                <strong>Registration trend</strong>
                <svg viewBox="0 0 260 104" preserveAspectRatio="none">
                  <path d="M0 87 C35 80 46 62 73 68 S116 48 142 52 S178 26 201 34 S232 13 260 17"></path>
                </svg>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="aecp-workflow">
  <div class="aecp-workflow__inner">
    <header class="aecp-workflow__header animate-on-scroll" data-animation="fadeInUp">
      <div class="aecp-workflow__heading">
        <h2>Keep the Conversation Moving Until the Work Is Done</h2>
      </div>
    </header>
    <ol class="aecp-workflow__steps">
      {process.map((item, index) => (
        <li>
          <details open={index === 0}>
            <summary tabindex="-1">
              <span class="aecp-workflow__number">{item.step}</span>
              <div class="aecp-workflow__copy">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <ul>{item.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul>
              </div>
              <button type="button" class="aecp-workflow__arrow" aria-label={`${index === 0 ? "Collapse" : "Expand"} ${item.title}`} aria-expanded={index === 0 ? "true" : "false"}>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
              </button>
            </summary>
            <div class="aecp-workflow__visual">
              <img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1117" height="837" />
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="aecp-sticky" id="aec-supported-work">
  <div class="aecp-sticky__inner">
    <header class="aecp-sticky__header">
      <span>One Copilot across event operations</span>
      <h2>Supported Work, Useful Results, and the Right Control Point</h2>
    </header>
    <div class="aecp-sticky__cards">
      <article class="aecp-sticky__card">
        <div class="aecp-sticky__copy">
          <span>Supported event work</span>
          <h3>Use one Copilot across the event areas that create the most admin</h3>
          <p>The request stays conversational, while the underlying job remains tied to a specific EventHex workflow.</p>
        </div>
        <div class="aecp-sticky-collage">
          <figure class="aecp-sticky-shot aecp-sticky-shot--primary">
            <img src="/feature-images/ai-event-copilot/portal/sessions.png" alt="EventHex session management workspace" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
          <figure class="aecp-sticky-shot aecp-sticky-shot--secondary">
            <img src="/feature-images/ai-event-copilot/portal/speakers.png" alt="EventHex speaker management workspace" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
        </div>
      </article>

      <article class="aecp-sticky__card">
        <div class="aecp-sticky__copy">
          <span>Answers built for the next decision</span>
          <h3>Get more than a wall of chat text</h3>
          <p>Copilot can match the response format to the job, so the important part is easier to inspect and use.</p>
        </div>
        <div class="aecp-sticky-collage">
          <figure class="aecp-sticky-shot aecp-sticky-shot--primary">
            <img src="/feature-images/ai-event-copilot/portal/dashboard.png" alt="EventHex event overview dashboard" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
          <figure class="aecp-sticky-shot aecp-sticky-shot--secondary">
            <img src="/feature-images/ai-event-copilot/portal/analytics.png" alt="EventHex analytics workspace" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
        </div>
      </article>

      <article class="aecp-sticky__card">
        <div class="aecp-sticky__copy">
          <span>Control that follows the action</span>
          <h3>Move quickly without hiding the important decision</h3>
          <p>Copilot uses different control points for an answer, a complete instruction, an incomplete draft, and a higher-impact change.</p>
        </div>
        <div class="aecp-sticky-collage">
          <figure class="aecp-sticky-shot aecp-sticky-shot--primary">
            <img src="/feature-images/ai-event-copilot/portal/event-setup.png" alt="EventHex event settings workspace" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
          <figure class="aecp-sticky-shot aecp-sticky-shot--secondary">
            <img src="/feature-images/ai-event-copilot/portal/registrations.png" alt="EventHex registration records workspace" loading="lazy" decoding="async" width="1117" height="837" />
          </figure>
        </div>
      </article>
      <div class="aecp-sticky__spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="aecp-access">
  <div class="aecp-access__inner">
    <div class="aecp-access__intro animate-on-scroll" data-animation="fadeInLeft">
      <span class="aecp-access__eyebrow">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5 16 5v4.2c0 4-2.6 6.7-6 8.3-3.4-1.6-6-4.3-6-8.3V5l6-2.5Z"></path><path d="m7.4 10 1.7 1.7 3.6-3.8"></path></svg>
        Built for ongoing event work
      </span>
      <h2>Start Faster, Point to <em>the Right Record</em>, and Return to the Thread</h2>
      <p>The organizer experience supports the small interaction details that make a Copilot useful beyond one prompt.</p>
      <a href="/book-a-demo/">See Copilot in action <span aria-hidden="true">→</span></a>
    </div>
    <div class="aecp-access__cards">
      {continuity.map(([num, title, text, image, alt], index) => (
        <article class="aecp-access__card" style={`--access-index: ${index}`}>
          <div class="aecp-access__card-header">
            <i>{num}</i>
            <div><h3>{title}</h3><p>{text}</p></div>
          </div>
          <div class="aecp-access__visual">
            <img src={image} alt={alt} loading="lazy" width="1117" height="837" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="aecp-lifecycle">
  <div class="aecp-lifecycle__container">
    <header class="aecp-heading aecp-lifecycle__header animate-on-scroll" data-animation="fadeInUp">
      <span>Before, during, and after the event</span>
      <h2>Bring Copilot into the Moments Where Context Switching Costs the Most</h2>
      <p>Use the same organizer conversation for a focused job at each stage of the event.</p>
    </header>
    <div class="aecp-lifecycle__grid animate-on-scroll" data-animation="fadeInUp">
      <span class="aecp-lifecycle__notch aecp-lifecycle__notch--top" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg>
      </span>
      <span class="aecp-lifecycle__notch aecp-lifecycle__notch--bottom" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg>
      </span>
      {lifecycle.map((item, index) => (
        <article class:list={["aecp-lifecycle__row", { "aecp-lifecycle__row--reverse": index % 2 === 1 }]}>
          <div class="aecp-lifecycle__cell aecp-lifecycle__visual">
            <div class:list={["aecp-lifecycle__stage", `aecp-lifecycle__stage--${index + 1}`]}>
              <img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1117" height="837" />
              <span class="aecp-lifecycle__float aecp-lifecycle__float--top"><b>{item.status}</b><small>EventHex Copilot</small></span>
              <span class="aecp-lifecycle__float aecp-lifecycle__float--bottom"><i></i><b>{item.phase}</b></span>
            </div>
          </div>
          <div class="aecp-lifecycle__cell aecp-lifecycle__content">
            <span>{item.phase}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
          <span class="aecp-lifecycle__cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
            </svg>
          </span>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="aecp-audiences">
  <div class="aecp-audiences__inner">
    <header class="aecp-audiences__header animate-on-scroll" data-animation="fadeInUp">
      <span>For teams with a lot of event context to hold</span>
      <h2><span>One Copilot Model.</span><span>Different Event Operations.</span></h2>
      <p>The event changes; the need to find the right record, understand it, and take the next step does not.</p>
    </header>
    <div class="aecp-audiences__tabs" role="tablist" aria-label="Event team types">
      {audiences.map((audience, index) => (
        <button type="button" role="tab" id={`aecp-tab-${audience.id}`} aria-controls={`aecp-panel-${audience.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-aecp-audience-tab={audience.id}>{audience.title}</button>
      ))}
    </div>
    <div class="aecp-audiences__panels">
      {audiences.map((audience, index) => (
        <article class:list={["aecp-audiences__panel", index === 0 && "is-active"]} role="tabpanel" id={`aecp-panel-${audience.id}`} aria-labelledby={`aecp-tab-${audience.id}`} hidden={index !== 0} data-aecp-audience-panel={audience.id}>
          <div class="aecp-audiences__copy">
            <h3>{audience.title}</h3>
            <p>{audience.text}</p>
            <span>Works across</span>
            <ul>{audience.checklist.map((item) => <li><i aria-hidden="true">✓</i>{item}</li>)}</ul>
          </div>
          <div class="aecp-audiences__showcase">
            <img src={audience.image} alt={audience.alt} loading="lazy" width="1117" height="837" />
            <span>EventHex organizer workspace</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="aecp-related">
  <header class="aecp-heading animate-on-scroll" data-animation="fadeInUp">
    <span>Explore the connected workflow</span>
