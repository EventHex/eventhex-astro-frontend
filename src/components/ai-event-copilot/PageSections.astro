</section>

<script>
  const copilotStickySection = document.querySelector<HTMLElement>('.aecp-sticky');
  const copilotStickyHeader = copilotStickySection?.querySelector<HTMLElement>('.aecp-sticky__header');
  const copilotStickyCards = copilotStickySection?.querySelectorAll<HTMLElement>('.aecp-sticky__card');
  const copilotFinalStickyCard = copilotStickyCards?.[copilotStickyCards.length - 1];

  if (copilotStickyHeader && copilotFinalStickyCard) {
    let frame = 0;
    const syncHeaderRelease = () => {
      frame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(copilotFinalStickyCard).top) || 0;
      const releaseOffset = Math.min(0, copilotFinalStickyCard.getBoundingClientRect().top - stickyTop);
      copilotStickyHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueHeaderRelease = () => {
      if (frame) return;
      frame = requestAnimationFrame(syncHeaderRelease);
    };
    window.addEventListener('scroll', queueHeaderRelease, { passive: true });
    window.addEventListener('resize', queueHeaderRelease, { passive: true });
    syncHeaderRelease();
  }

  const copilotDarkBand = document.querySelector<HTMLElement>('.aecp-dark');
  if (copilotDarkBand && copilotDarkBand.dataset.bleedReady !== 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    copilotDarkBand.dataset.bleedReady = 'true';
    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let bandFrame = 0;
    let lastProgress = -1;

    const measureBand = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = copilotDarkBand.getBoundingClientRect().top + window.scrollY;
    };
    const updateBand = () => {
      bandFrame = 0;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.round(Math.min(1, Math.max(0, travelled / (viewportHeight * .7))) * 100) / 100;
      if (progress === lastProgress) return;
      lastProgress = progress;
      copilotDarkBand.style.setProperty('--band-p', String(progress));
    };
    const queueBandUpdate = () => {
      if (bandFrame) return;
      bandFrame = requestAnimationFrame(updateBand);
    };
    const resetBand = () => {
      measureBand();
      lastProgress = -1;
      queueBandUpdate();
    };

    measureBand();
    updateBand();
    window.addEventListener('scroll', queueBandUpdate, { passive: true });
    window.addEventListener('resize', resetBand);
    window.addEventListener('load', resetBand);
  }

  const copilotWorkflow = document.querySelector<HTMLElement>('.aecp-workflow');
  if (copilotWorkflow && copilotWorkflow.dataset.workflowReady !== 'true') {
    copilotWorkflow.dataset.workflowReady = 'true';
    const details = Array.from(copilotWorkflow.querySelectorAll<HTMLDetailsElement>('details'));
    details.forEach((detail) => {
      const summary = detail.querySelector('summary');
      const trigger = detail.querySelector<HTMLButtonElement>('.aecp-workflow__arrow');

      summary?.addEventListener('click', (event) => {
        event.preventDefault();
        detail.open = !detail.open;
      });
      detail.addEventListener('toggle', () => {
        trigger?.setAttribute('aria-expanded', String(detail.open));
        trigger?.setAttribute('aria-label', `${detail.open ? 'Collapse' : 'Expand'} workflow step`);
        if (!detail.open) return;
        details.forEach((other) => {
          if (other !== detail) other.open = false;
        });
      });
    });
  }

  const copilotAudiences = document.querySelector<HTMLElement>('.aecp-audiences');
  if (copilotAudiences && copilotAudiences.dataset.tabsReady !== 'true') {
    copilotAudiences.dataset.tabsReady = 'true';
    const tabs = Array.from(copilotAudiences.querySelectorAll<HTMLButtonElement>('[data-aecp-audience-tab]'));
    const panels = Array.from(copilotAudiences.querySelectorAll<HTMLElement>('[data-aecp-audience-panel]'));
    let rotation = 0;

    const activateAudience = (id: string, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.aecpAudienceTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.aecpAudiencePanel === id;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    };

    const stopRotation = () => window.clearInterval(rotation);
    const startRotation = () => {
      stopRotation();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      rotation = window.setInterval(() => {
        const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
        const next = tabs[(current + 1) % tabs.length];
        if (next?.dataset.aecpAudienceTab) activateAudience(next.dataset.aecpAudienceTab);
      }, 6500);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (tab.dataset.aecpAudienceTab) activateAudience(tab.dataset.aecpAudienceTab);
        startRotation();
      });
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        const next = tabs[nextIndex];
        if (next?.dataset.aecpAudienceTab) activateAudience(next.dataset.aecpAudienceTab, true);
      });
    });
    copilotAudiences.addEventListener('mouseenter', stopRotation);
    copilotAudiences.addEventListener('mouseleave', startRotation);
    copilotAudiences.addEventListener('focusin', stopRotation);
    copilotAudiences.addEventListener('focusout', startRotation);
    startRotation();
  }
</script>

