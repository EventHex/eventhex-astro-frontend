---
const stages = [
  { value: "Ask", label: "Event questions" },
  { value: "Inspect", label: "Records and readiness" },
  { value: "Prepare", label: "Drafts and structured outputs" },
  { value: "Act", label: "Supported organizer tasks" },
  { value: "Continue", label: "Event-scoped conversations" },
];
---

<section class="aecs-reference" aria-label="One Copilot, five ways to move event work forward">
  <div class="aecs-trust__inner">
    {stages.map((stage) => (
      <a class="aecs-trust__stat" href="#aec-capabilities">
        <b>{stage.value}</b>
        <span>{stage.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .aecs-reference {
    width: 100%;
    padding: 58px 24px;
    border-top: 1px solid var(--surface-card-border);
    color: var(--heading-dark);
    background: #fff;
  }
  .aecs-trust__inner {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    max-width: 1180px;
    margin: 0 auto;
  }
  .aecs-trust__stat {
    display: flex;
    min-width: 0;
    min-height: 74px;
    padding: 8px 24px;
    border-right: 1px solid var(--surface-card-border);
    flex-direction: column;
    justify-content: center;
    color: var(--body-light);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.3;
    text-decoration: none;
  }
  .aecs-trust__stat:first-child { padding-left: 24px; }
  .aecs-trust__stat:last-child { border-right: 0; }
  .aecs-trust__stat b {
    display: block;
    margin-bottom: 4px;
    color: var(--heading-dark);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.15;
  }
  .aecs-trust__stat:hover b { color: var(--brand-blue); }

  @media (max-width: 960px) {
    .aecs-reference { padding-block: 34px; }
    .aecs-trust__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aecs-trust__stat { border-bottom: 1px solid var(--surface-card-border); }
    .aecs-trust__stat:nth-child(2n) { border-right: 0; }
    .aecs-trust__stat:last-child { border-right: 1px solid var(--surface-card-border); border-bottom: 0; }
  }

  @media (max-width: 640px) {
    .aecs-reference { padding: 26px 16px; }
    .aecs-trust__inner { grid-template-columns: 1fr; }
    .aecs-trust__stat,
    .aecs-trust__stat:nth-child(2n),
    .aecs-trust__stat:last-child {
      min-height: 66px;
      padding-inline: 16px;
      border-right: 0;
      border-bottom: 1px solid var(--surface-card-border);
    }
    .aecs-trust__stat:last-child { border-bottom: 0; }
  }
</style>
