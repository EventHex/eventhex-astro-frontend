---
/**
 * Shared Lottie player with lazy loading (IntersectionObserver) + reduced-motion.
 * Uses lottie-web SVG renderer for .json files, @lottiefiles/dotlottie-web for .lottie files.
 *
 * Usage:
 *   <LottiePlayer src="/animations/foo.json" class="my-lottie" />
 *   <LottiePlayer src="/animations/bar.lottie" class="my-lottie" />
 */
interface Props {
  /** Path to .json or .lottie Lottie file served from public/ */
  src: string;
  /** Extra class(es) forwarded to the container <div> */
  class?: string;
  /** Load immediately without waiting for intersection (for above-the-fold) */
  eager?: boolean;
  /** Render JSON animations to canvas instead of generating a large SVG DOM */
  renderer?: "svg" | "canvas";
  /** Wait for visibility plus user interaction before loading the animation */
  defer?: boolean;
  /** Extra data-* attributes forwarded to the container */
  [key: `data-${string}`]: string;
}

const { src, class: className, eager, renderer = "svg", defer, ...rest } = Astro.props;
const isDotLottie = src.endsWith(".lottie");
---

{isDotLottie ? (
  <canvas class:list={["lottie-container", className]} data-lottie-src={src} {...(eager ? {"data-lottie-eager": ""} : {})} {...(defer ? {"data-lottie-defer": ""} : {})} {...rest}></canvas>
) : (
  <div class:list={["lottie-container", className]} data-lottie-src={src} data-lottie-renderer={renderer} {...(eager ? {"data-lottie-eager": ""} : {})} {...(defer ? {"data-lottie-defer": ""} : {})} {...rest}></div>
)}

<script>
  let lottieLib: Promise<typeof import("lottie-web/build/player/lottie_svg")> | null = null;
  function getLottie() {
    if (!lottieLib) lottieLib = import("lottie-web/build/player/lottie_svg");
    return lottieLib;
  }

  let canvasLottieLib: Promise<typeof import("lottie-web")> | null = null;
  function getCanvasLottie() {
    if (!canvasLottieLib) canvasLottieLib = import("lottie-web");
    return canvasLottieLib;
  }

  let dotLottieLib: Promise<typeof import("@lottiefiles/dotlottie-web")> | null = null;
  function getDotLottie() {
    if (!dotLottieLib) dotLottieLib = import("@lottiefiles/dotlottie-web");
    return dotLottieLib;
  }

  function loadLottie(el: HTMLElement, prefersReducedMotion: boolean) {
    const src = el.dataset.lottieSrc;
    if (src && !el.dataset.lottieInit) {
      el.dataset.lottieInit = "1";

      if (src.endsWith(".lottie") && el instanceof HTMLCanvasElement) {
        getDotLottie().then(({ DotLottie }) => {
          new DotLottie({
            canvas: el,
            src,
            loop: true,
            autoplay: !prefersReducedMotion,
          });
        });
      } else {
        const renderer = el.dataset.lottieRenderer === "canvas" ? "canvas" : "svg";
        Promise.all([
          renderer === "canvas" ? getCanvasLottie() : getLottie(),
          fetch(src).then((r) => r.json()),
        ]).then(([lottie, animationData]) => {
          const animation = lottie.default.loadAnimation({
            container: el,
            renderer,
            loop: true,
            autoplay: !prefersReducedMotion,
            animationData,
          });
          animation.addEventListener("DOMLoaded", () => el.classList.add("is-lottie-ready"));
        });
      }
    }
  }

  function initLottie() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    document
      .querySelectorAll<HTMLElement>("[data-lottie-src][data-lottie-defer]:not([data-lottie-observed])")
      .forEach((el) => {
        el.dataset.lottieObserved = "1";
        if (prefersReducedMotion) return;

        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();

          let started = false;
          const events = ["pointerdown", "keydown", "touchstart", "scroll"];
          const start = () => {
            if (started) return;
            started = true;
            events.forEach((event) => window.removeEventListener(event, start));
            window.clearTimeout(fallbackTimer);
            loadLottie(el, false);
          };
          events.forEach((event) => window.addEventListener(event, start, { passive: true, once: true }));
          const fallbackTimer = window.setTimeout(start, 10000);
        }, { rootMargin: "0px" });

        observer.observe(el);
      });

    // Eager: start lottie import immediately + load in parallel
    const eagerEls = document.querySelectorAll<HTMLElement>(
      "[data-lottie-src][data-lottie-eager]",
    );
    if (eagerEls.length) {
      const hasJson = Array.from(eagerEls).some((el) => !el.dataset.lottieSrc?.endsWith(".lottie"));
      const hasDot = Array.from(eagerEls).some((el) => el.dataset.lottieSrc?.endsWith(".lottie"));
      if (hasJson) getLottie();
      if (hasDot) getDotLottie();
      eagerEls.forEach((el) => loadLottie(el, prefersReducedMotion));
    }

    // Lazy: load on intersection
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadLottie(entry.target as HTMLElement, prefersReducedMotion);
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "200px" },
    );

    document
      .querySelectorAll<HTMLElement>("[data-lottie-src]:not([data-lottie-eager]):not([data-lottie-defer])")
      .forEach((el) => observer.observe(el));
  }

  initLottie();
  document.addEventListener("astro:after-swap", initLottie);
</script>
