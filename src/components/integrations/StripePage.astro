<script>
  const stripeFaqs = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-stx-faq]"));
  stripeFaqs.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      stripeFaqs.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const operationsSection = document.querySelector<HTMLElement>("#stripe-operations");
  const operationsHeader = operationsSection?.querySelector<HTMLElement>(".stx-section-heading");
  const operationCards = operationsSection?.querySelectorAll<HTMLElement>(".stx-state-row");
  const finalOperationCard = operationCards?.[operationCards.length - 1];

  if (operationsHeader && finalOperationCard) {
    let operationsFrame = 0;
    let stackFrame = 0;
    const syncOperationsRelease = () => {
      operationsFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalOperationCard).top) || 0;
      const releaseOffset = Math.min(0, finalOperationCard.getBoundingClientRect().top - stickyTop);
      operationsHeader.style.setProperty("--stx-ops-release-y", `${releaseOffset}px`);
      operationsHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const syncOperationsStack = () => {
      stackFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(operationCards[0]).top) || 0;
      operationCards.forEach((card) => {
        const distance = card.getBoundingClientRect().top - stickyTop;
        const progress = Math.max(0, Math.min(1, 1 - distance / 180));
        card.style.setProperty("--stack-progress", progress.toFixed(3));
      });
    };
    const queueOperationsRelease = () => {
      if (operationsFrame) return;
      operationsFrame = requestAnimationFrame(syncOperationsRelease);
    };
    const queueOperationsStack = () => {
      if (stackFrame) return;
      stackFrame = requestAnimationFrame(syncOperationsStack);
    };

    window.addEventListener("scroll", queueOperationsRelease, { passive: true });
    window.addEventListener("resize", queueOperationsRelease, { passive: true });
    window.addEventListener("scroll", queueOperationsStack, { passive: true });
    window.addEventListener("resize", queueOperationsStack, { passive: true });
    syncOperationsRelease();
    syncOperationsStack();
  }

  const commerceTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-commerce-tab]"));
  const commercePanels = Array.from(document.querySelectorAll<HTMLElement>("[data-commerce-panel]"));
  const commerceSection = document.querySelector<HTMLElement>("#stripe-commerce");
  let commerceRotationId: number | undefined;

  const activateCommerceTab = (tab: HTMLButtonElement) => {
    const activeIndex = tab.dataset.commerceTab;
    commerceTabs.forEach((item) => {
      const isActive = item === tab;
      item.classList.toggle("is-active", isActive);
      item.setAttribute("aria-selected", String(isActive));
    });
    commercePanels.forEach((panel) => {
      const isActive = panel.dataset.commercePanel === activeIndex;
      panel.hidden = !isActive;
      panel.classList.toggle("is-active", isActive);
    });
  };

  const stopCommerceRotation = () => {
    if (commerceRotationId === undefined) return;
    window.clearInterval(commerceRotationId);
    commerceRotationId = undefined;
  };

  const startCommerceRotation = () => {
    stopCommerceRotation();
    if (commerceTabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    commerceRotationId = window.setInterval(() => {
      const currentIndex = commerceTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      activateCommerceTab(commerceTabs[(currentIndex + 1) % commerceTabs.length]);
    }, 4000);
  };

  commerceTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      activateCommerceTab(tab);
      startCommerceRotation();
    });
  });

  commerceSection?.addEventListener("mouseenter", stopCommerceRotation);
  commerceSection?.addEventListener("mouseleave", startCommerceRotation);
  commerceSection?.addEventListener("focusin", stopCommerceRotation);
  commerceSection?.addEventListener("focusout", (event) => {
    if (!(event.relatedTarget instanceof Node) || !commerceSection.contains(event.relatedTarget)) {
      startCommerceRotation();
    }
  });
  document.addEventListener("visibilitychange", () => {
    document.hidden ? stopCommerceRotation() : startCommerceRotation();
  });
  startCommerceRotation();

  const caseSteps = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-stx-case]"));
  caseSteps.forEach((item) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".stx-case-step__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} case study`);
      if (!item.open) return;
      caseSteps.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

