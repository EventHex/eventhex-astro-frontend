---
const lifecycle = [
  { label: "Configure", detail: "Credentials" },
  { label: "Price", detail: "Event currency" },
  { label: "Provider handoff", detail: "" },
  { label: "Confirm", detail: "Payment result" },
  { label: "Deliver", detail: "Ticket outcome" },
  { label: "Review", detail: "Refund and finance" },
];

const heroScreens = [
  { src: "/images/platform-analytics-dashboard.jpg", alt: "EventHex Platform Analytics dashboard with event and check-in trends", width: 1262, height: 697 },
  { src: "/images/stripe-analytics-overview.png", alt: "EventHex Revenue Analytics overview with subscription and growth metrics", width: 1262, height: 697 },
  { src: "/images/stripe-analytics-revenue.png", alt: "EventHex Revenue Analytics detail with subscriber growth trends", width: 1262, height: 697 },
];

const setupSteps = [
  { title: "Choose the gateway", copy: "Select Stripe in the supported payment settings." },
  { title: "Add credentials", copy: "Enter the supported publishable and secret-key values; saved secrets are not displayed back in normal settings responses." },
  { title: "Confirm event currency", copy: "Choose an event currency supported by the active Stripe path and your account." },
  { title: "Test the paid journey", copy: "Run the event's own checkout and confirmation path before launch." },
];

const paymentStates = [
  { title: "Gateway", copy: "Identify Stripe as the order's payment path.", href: "#stripe-setup", image: "/images/platform-analytics-dashboard.jpg", alt: "EventHex platform analytics showing the connected payment gateway", width: 1262, height: 697 },
  { title: "Amount and currency", copy: "Keep the value beside the event order.", href: "#stripe-finance", image: "/images/stripe-payment-dashboard.png", alt: "EventHex payment dashboard showing order amount and currency", width: 728, height: 700 },
  { title: "Captured or pending", copy: "Separate completed payment from a state that still needs attention.", href: "#stripe-operations", image: "/images/stripe-analytics-overview.png", alt: "EventHex analytics overview showing captured and pending payment state", width: 1262, height: 697 },
  { title: "Failure context", copy: "Keep an unsuccessful attempt distinct from a successful order.", href: "#stripe-boundary", image: "/images/stripe-analytics-revenue.png", alt: "EventHex revenue analytics showing payment failure context", width: 1262, height: 697 },
  { title: "Refund history", copy: "See returned value and the remaining refundable amount.", href: "#stripe-refunds", image: "/images/stripe-revenue-analytics.jpg", alt: "EventHex revenue analytics showing refund history", width: 989, height: 633 },
  { title: "Buyer and tickets", copy: "Trace the payment back to the registration it belongs to.", href: "#stripe-commerce", image: "/images/revenue-analytics-source.jpg", alt: "EventHex analytics showing buyer and ticket revenue context", width: 1262, height: 697 },
];

const useCases = [
  { title: "International conferences", copy: "Connect the event's Stripe path without separating payments from ticket orders.", image: "/images/platform-analytics-dashboard.jpg", alt: "EventHex platform analytics for international conference events", width: 1262, height: 697 },
  { title: "Corporate events", copy: "Use paid tickets or access products with the organization's supported setup.", image: "/images/revenue-analytics-source.jpg", alt: "EventHex revenue analytics for corporate events", width: 1262, height: 697 },
  { title: "Associations", copy: "Keep member-event payments and refund history tied to the registration.", image: "/images/stripe-platform-analytics.png", alt: "EventHex registration analytics for association events", width: 790, height: 492 },
  { title: "Event agencies", copy: "Choose event- or organization-level configuration based on the client account model.", image: "/images/stripe-analytics-overview.png", alt: "EventHex portfolio analytics for event agencies", width: 1262, height: 697 },
];

const adjacentFeatures = [
  { title: "Event Payment Processing", copy: "Compare the supported gateway paths and event-level finance workflow.", href: "/event-payment-processing/", image: "/images/stripe-payment-dashboard.png", alt: "EventHex payment processing dashboard", width: 728, height: 700, tone: "blue" },
  { title: "Event Ticketing", copy: "Configure ticket price, capacity, sale windows, approvals, and discounts.", href: "/event-ticketing/", image: "/images/stripe-flow-checkout.jpg", alt: "EventHex ticket checkout configuration", width: 790, height: 492, tone: "violet" },
  { title: "Event Registration", copy: "Choose the form or checkout journey that creates the order.", href: "/event-registration/", image: "/images/stripe-flow-configure.jpg", alt: "EventHex event registration configuration", width: 790, height: 492, tone: "mint" },
  { title: "Invoicing and tax", copy: "Collect billing details and create an order-linked invoice with configured tax lines.", href: "/invoicing-gst/", image: "/images/stripe-revenue-analytics.jpg", alt: "EventHex invoice and revenue analytics", width: 989, height: 633, tone: "gold" },
];

const faqs = [
  { q: "Can we use our existing Stripe account?", a: "Yes, EventHex supports Stripe credentials at event or organization level. Confirm which model fits your account structure during setup." },
  { q: "How should we review payment costs?", a: "Review the EventHex plan, any configured platform fee, and the Stripe charges that apply to your account and market before launch." },
  { q: "Can organizers issue refunds?", a: "Authorized organizers can request full or partial refunds through the supported Stripe path, up to the remaining refundable amount." },
  { q: "Which currencies and payment methods are available?", a: "They depend on the connected Stripe account, event currency, market, and provider configuration. Validate the target checkout before launch." },
  { q: "How does payment confirmation reach EventHex?", a: "The active Stripe confirmation and webhook paths update the event order so the ticket workflow can continue." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<main class="stx-page">
  <section class="stx-hero">
    <div class="stx-hero__grid">
      <div class="stx-hero__content">
        <span class="stx-eyebrow animate-on-scroll" data-animation="fadeInDown">Stripe integration for events</span>
        <h1 class="animate-on-scroll" data-animation="fadeInUp">Connect Stripe to your event ticket checkout</h1>
        <p class="stx-lead animate-on-scroll" data-animation="fadeInUp">Use a supported Stripe account for paid registration, keep the Stripe handoff tied to the EventHex order, and manage payment and refund state from the event workflow.</p>
        <div class="stx-hero__actions animate-on-scroll" data-animation="fadeInUp">
          <a class="stx-button stx-button--primary" href="/book-a-demo/">
            Book a Demo
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a class="stx-button stx-button--secondary" href="#stripe-flow">See the Stripe flow</a>
        </div>
        <ul class="stx-proof animate-on-scroll" data-animation="fadeInUp">
          <li>Stripe account</li>
          <li>Order-linked status</li>
          <li>Full or partial refunds</li>
        </ul>
      </div>

      <div class="stx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="stx-hero__visual-card">
          <div class="stx-hero__visual-inner">
            <div class="stx-hero__visual-stage" aria-label="Animated EventHex analytics screenshots">
              {heroScreens.map((shot, index) => (
                <figure class={`stx-hero__shot stx-hero__shot--${index + 1}`}>
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    width={shot.width}
                    height={shot.height}
                    loading="eager"
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                  />
                </figure>
              ))}
              <span class="stx-hero__visual-badge">Platform analytics</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stx-lifecycle" id="stripe-flow" aria-label="What happens after Stripe is selected">
    <ol class="stx-lifecycle__inner">
      {lifecycle.map((item, index) => (
        <li class="stx-lifecycle__stat animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          <b>{item.label}</b>{item.detail && <span>{item.detail}</span>}
        </li>
      ))}
    </ol>
  </section>

  <section class="stx-scope">
    <header class="stx-scope__header animate-on-scroll" data-animation="fadeInUp">
      <span>Connection scope</span>
      <h2>Use Stripe at the level that matches your event portfolio</h2>
      <p>EventHex can resolve a supported Stripe configuration from the event or the organization before checkout begins.</p>
    </header>

    <div class="stx-scope__quad">
      <article class="stx-scope__cell stx-scope__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Event-level connection</h3>
        <p>Use Stripe credentials for one event when its account, market, or commercial setup differs.</p>
      </article>

      <div class="stx-scope__cell stx-scope__cell--media animate-on-scroll" data-animation="fadeInRight">
        <div class="stx-scope__visual stx-scope__visual--event">
          <img src="/images/platform-analytics-dashboard.jpg" alt="EventHex Platform Analytics dashboard for a specific event" width="1262" height="697" loading="lazy" decoding="async" />
          <span>Specific event</span>
        </div>
      </div>

      <div class="stx-scope__cell stx-scope__cell--media animate-on-scroll" data-animation="fadeInLeft">
        <div class="stx-scope__visual stx-scope__visual--organization">
          <img src="/images/stripe-analytics-overview.png" alt="EventHex Revenue Analytics overview for an organization portfolio" width="1262" height="697" loading="lazy" decoding="async" />
          <span>Repeat portfolio</span>
        </div>
      </div>

      <article class="stx-scope__cell stx-scope__cell--copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Organization-level connection</h3>
        <p>Reuse the organization's supported Stripe configuration across events that select Organization Payment.</p>
      </article>

      <span class="stx-scope__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path>
        </svg>
      </span>
    </div>

    <p class="stx-note">Public and secret keys are write-only or masked after save; exact account requirements remain provider-specific.</p>
  </section>

  <section class="stx-section stx-setup">
    <div class="stx-shell">
      <header class="stx-section-heading animate-on-scroll" data-animation="fadeInUp"><span>Organizer setup</span><h2>Connect the account before tickets go on sale</h2></header>
      <div class="stx-setup__grid">
        {["1", "2", "3"].map((notch) => (
          <span class={`stx-setup__notch stx-setup__notch--${notch}`} aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path>
            </svg>
          </span>
        ))}
        {setupSteps.map((step, index) => (
          <article class="animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 70)}>
            <div class="stx-setup__icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path><path d="M7 15h2"></path>
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="8" cy="15" r="4"></circle><path d="M11 12l8-8"></path><path d="M15 4l2 2"></path><path d="M17 6l2 2"></path>
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"></path><path d="M12 6v12"></path>
                </svg>
              )}
              {index === 3 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16 9"></path>
                </svg>
              )}
            </div>
            <div class="stx-setup__content"><h3>{step.title}</h3><p>{step.copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="stx-section stx-handoff">
    <div class="stx-shell">
      <header class="stx-section-heading animate-on-scroll" data-animation="fadeInUp">
        <span>Paid attendee journey</span><h2>Keep Stripe connected to the ticket order</h2>
        <p>The event configuration determines the gateway; the buyer continues through the Stripe path tied to that order.</p>
      </header>
      <div class="stx-handoff__grid animate-on-scroll" data-animation="fadeInUp">
        <article class="stx-handoff__order"><span>Order context</span><h3>Keep buyer, ticket, amount, currency, and recorded tax context together.</h3><div class="stx-order-flow" aria-hidden="true"><i>Order</i><b>→</b><i>Stripe</i><b>→</b><i>Result</i></div><div class="stx-handoff__visual stx-handoff__visual--order"><div class="stx-handoff__frame"><div class="stx-handoff__frame-bar"><span><i></i><i></i><i></i></span><small>Order metrics</small></div><img src="/images/stripe-order-context.jpg" alt="EventHex order metrics for the connected payment" width="938" height="168" loading="lazy" /></div></div></article>
        <article><span>Provider handoff</span><p>EventHex creates the Stripe checkout session for the order and sends the buyer to the provider-hosted payment step.</p><div class="stx-handoff__visual"><div class="stx-handoff__frame"><div class="stx-handoff__frame-bar"><span><i></i><i></i><i></i></span><small>Provider handoff</small></div><img src="/images/stripe-provider-handoff.jpg" alt="EventHex payment trend view for the Stripe handoff" width="458" height="333" loading="lazy" /></div></div></article>
        <article><span>Confirmation</span><p>Confirmation and webhook paths update the EventHex order with the provider result.</p><div class="stx-handoff__visual"><div class="stx-handoff__frame"><div class="stx-handoff__frame-bar"><span><i></i><i></i><i></i></span><small>Payment result</small></div><img src="/images/stripe-payment-result.jpg" alt="EventHex payment result analytics after confirmation" width="456" height="333" loading="lazy" /></div></div></article>
        <article><span>Ticket continuation</span><p>Use the confirmed order for registration outcome, ticket delivery, and invoice handling.</p><div class="stx-handoff__visual stx-handoff__visual--ticket"><div class="stx-handoff__frame"><div class="stx-handoff__frame-bar"><span><i></i><i></i><i></i></span><small>Ticket outcome</small></div><img src="/images/stripe-ticket-continuation.jpg" alt="EventHex ticket continuation metrics linked to the order" width="460" height="168" loading="lazy" /></div></div></article>
        <span class="stx-handoff__cross" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="rotate(90)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="rotate(-90)"></path>
          </svg>
        </span>
      </div>
    </div>
  </section>

  <section class="stx-section stx-market">
    <div class="stx-shell stx-market__grid">
      <div class="stx-market__copy">
        <div class="stx-market__sticky animate-on-scroll" data-animation="fadeInUp"><span class="stx-eyebrow">International event payments</span><h2>Use Stripe where the event and account setup align</h2><p>Stripe can be a strong fit for international conference and corporate ticket sales, but actual currency and payment-method availability comes from the connected account and market.</p></div>
      </div>
      <div class="stx-market__list">
        <article class="animate-on-scroll" data-animation="fadeInUp">
          <div class="stx-market__header"><span>01</span><div><h3>Conference ticket sales</h3><p>Run the supported paid checkout for a conference using its configured event currency.</p></div></div>
          <div class="stx-market__visual stx-market__visual--conference"><img src="/images/platform-analytics-dashboard.jpg" alt="EventHex Platform Analytics dashboard for conference ticket sales" width="1262" height="697" loading="lazy" /><svg class="stx-market__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div>
        </article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <div class="stx-market__header"><span>02</span><div><h3>Agency portfolios</h3><p>Use organization settings where the same Stripe account supports multiple client events.</p></div></div>
          <div class="stx-market__visual stx-market__visual--agency"><img src="/images/stripe-analytics-overview.png" alt="EventHex Revenue Analytics overview for agency portfolios" width="1262" height="697" loading="lazy" /><svg class="stx-market__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div>
        </article>
        <article class="animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <div class="stx-market__header"><span>03</span><div><h3>Cross-border buyers</h3><p>Confirm the account's supported currencies and methods before promising them on the event page.</p></div></div>
          <div class="stx-market__visual stx-market__visual--buyers"><img src="/images/stripe-analytics-revenue.png" alt="EventHex Revenue Analytics detail for cross-border ticket buyers" width="1262" height="697" loading="lazy" /><svg class="stx-market__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div>
        </article>
      </div>
    </div>
  </section>

<section id="stripe-operations" class="stx-section stx-operations">
    <div class="stx-shell">
      <header class="stx-section-heading animate-on-scroll" data-animation="fadeInUp">
        <span class="stx-ops-eyebrow">
          <span class="stx-ops-eyebrow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>
          </span>
          <span>Operations after checkout</span>
        </span>
        <h2>Give the event team a payment record it can act on</h2>
      </header>
      <div class="stx-state-grid">
        {paymentStates.map((item, index) => (
          <article class:list={["stx-state-row", { "stx-state-row--reverse": index % 2 === 1 }]} style={`--card-index: ${index};`}>
            <div class="stx-state-cell stx-state-visual"><div class="stx-state-shot"><img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" /></div></div>
            <div class="stx-state-cell stx-state-content"><h3>{item.title}</h3><p>{item.copy}</p><a class="stx-state-explore" href={item.href}>Explore More <span aria-hidden="true">↗</span></a></div>
            <span class="stx-state-cross" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
              </svg>
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="stripe-refunds" class="stx-section stx-refunds">
    <div class="stx-shell">
      <header class="stx-refunds__heading animate-on-scroll" data-animation="fadeInUp"><span>Organizer-managed refunds</span><h2>Handle a Stripe refund from the order context</h2><p>Authorized organizers can request a full or partial refund through the supported provider path.</p></header>
      <div class="stx-refunds__grid">
        <span class="stx-refunds__petal stx-refunds__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>
        <span class="stx-refunds__petal stx-refunds__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>
        <span class="stx-refunds__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="rotate(-90)"></path></svg></span>
        <article class="stx-refund-row animate-on-scroll" data-animation="fadeInUp" data-delay="0"><div class="stx-refund-cell stx-refund-cell--visual"><div class="stx-refund-shot-stage stx-refund-shot-stage--full"><img src="/images/stripe-order-context.jpg" alt="EventHex order context for a full refund" width="989" height="633" loading="lazy" decoding="async" /><span class="stx-refund-float stx-refund-float--top"><b>Refund eligible</b><small>Order balance verified</small></span><span class="stx-refund-float stx-refund-float--bottom"><i></i><b>Full amount</b></span></div></div><div class="stx-refund-cell stx-refund-cell--content"><span class="stx-refund-eyebrow">Full refund</span><h3>Return the remaining eligible paid amount</h3><p>Issue the full refund from the connected order context while keeping the original payment and its event record together.</p></div></article>
