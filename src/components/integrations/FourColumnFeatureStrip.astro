---
interface Props {
  heading: string;
  /** title, body, optional href (renders the card as a link), optional icon name */
  items: [string, string, string?, string?][];
  eyebrow?: string;
  id?: string;
}
const { heading, items, eyebrow, id } = Astro.props;
// Key phrase of the heading: the last line (after <br />) or, for one-line headings, the last two words.
const withHl = (h: string) => {
  if (h.includes("ds-hl")) return h;
  const parts = h.split(/<br\s*\/?>/);
  if (parts.length > 1) { const last = parts.pop(); return [...parts, `<span class="ds-hl">${last}</span>`].join("<br />"); }
  const words = h.split(" ");
  if (words.length < 4) return h;
  return `${words.slice(0, -2).join(" ")} <span class="ds-hl">${words.slice(-2).join(" ")}</span>`;
};
const headingHtml = withHl(heading);
const icons: Record<string, string> = {
  device: '<rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M12 18h.01"></path>',
  bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path>',
  globe: '<circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect>',
  code: '<path d="m9 8-4 4 4 4"></path><path d="m15 8 4 4-4 4"></path>',
  hub: '<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>',
  form: '<rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h4"></path>',
  check: '<circle cx="12" cy="12" r="9"></circle><path d="m8.4 12.2 2.4 2.4 4.8-4.8"></path>',
};
// Default order so a caller that only passes [title, body] pairs keeps the original icons.
const fallback = ["device", "bell", "globe", "grid"];
---

<section class="integration-four" {id}>
  <div class="integration-four__inner">
    <header class="integration-four__header">
      {eyebrow ? <span class="integration-four__eyebrow">{eyebrow}</span> : null}
      <h2 set:html={headingHtml}></h2>
    </header>
    <div class="integration-four__grid">
      <span class="integration-four__notch integration-four__notch--1" aria-hidden="true"><svg viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)"></path></svg></span>
      <span class="integration-four__notch integration-four__notch--2" aria-hidden="true"><svg viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)"></path></svg></span>
      <span class="integration-four__notch integration-four__notch--3" aria-hidden="true"><svg viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)"></path></svg></span>
      {items.map(([title, body, href, icon], index) => {
        const glyph = icons[icon ?? fallback[index % fallback.length]] ?? icons[fallback[index % fallback.length]];
        const classes = ["integration-four__card", { "integration-four__card--first": index === 0, "integration-four__card--link": Boolean(href) }];
        const inner = (
          <>
            <span class="integration-four__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={glyph}></svg></span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </>
        );
        return href
          ? <a class:list={classes} href={href}>{inner}</a>
          : <article class:list={classes}>{inner}</article>;
      })}
    </div>
  </div>
</section>

<style is:global>
  .integration-four{box-sizing:border-box;width:100%;padding:clamp(90px,10vw,140px) 24px;background:var(--ds-g4-stage)}.integration-four *{box-sizing:border-box}.integration-four__inner{width:min(1200px,100%);margin:0 auto}.integration-four__header{margin-bottom:56px;text-align:center}.integration-four__eyebrow{display:block!important;margin-bottom:16px;color:var(--ds-blue);font:500 14px/1.3 var(--font-body);letter-spacing:.01em}.integration-four__header h2{max-width:960px;margin:0 auto;color:var(--ds-ink);font-family:var(--font-heading);font-size:var(--ds-h2);font-weight:500;letter-spacing:-.035em;line-height:1.1}.integration-four__grid{position:relative;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:16px}.integration-four__notch{display:none}.integration-four__card{display:block!important;min-height:300px!important;padding:28px!important;border:1px solid var(--ds-glass-edge)!important;border-radius:var(--ds-r-xl);background:var(--ds-glass-fill)!important;box-shadow:var(--ds-glass-shadow);-webkit-backdrop-filter:var(--ds-glass-blur);backdrop-filter:var(--ds-glass-blur)}.integration-four__card--link{color:inherit!important;text-decoration:none!important;transition:transform .2s ease,box-shadow .2s ease}.integration-four__card--link:hover{transform:translateY(-3px)}.integration-four__card--link:focus-visible{outline:2px solid var(--ds-blue)!important;outline-offset:2px}.integration-four__icon{display:inline-flex!important;width:30px!important;height:30px!important;margin-bottom:28px!important;align-items:center;justify-content:center;color:var(--ds-blue)!important}.integration-four__icon svg{display:block!important;width:100%!important;height:100%!important;stroke:var(--ds-blue)!important}.integration-four__card h3{min-height:2.3em;margin:0 0 20px;color:var(--ds-ink);font-family:var(--font-heading);font-size:21px;font-weight:500;line-height:1.2}.integration-four__card p{margin:14px 0 0;color:var(--ds-body);font-family:var(--font-body);font-size:15px;line-height:1.5}@media(max-width:992px){.integration-four__grid{grid-template-columns:1fr!important}.integration-four__card{min-height:0!important}}@media(max-width:767px){.integration-four{padding:72px 16px}.integration-four__header{margin-bottom:36px}.integration-four__header h2{font-size:clamp(30px,9vw,36px)}.integration-four__card{padding:26px 22px!important}.integration-four__card h3{min-height:0;margin-bottom:12px}}
</style>
