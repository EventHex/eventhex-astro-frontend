---
interface Props { left: string[]; right: string[]; note: string }
const { left, right, note } = Astro.props;
---
<div class="wh-wrap">
  <div class="wh-choice-grid">
    {[left, right].map(([title, desc, cue]) => <article class="wh-choice animate-on-scroll" data-animation="fadeInUp"><h3>{title}</h3><p>{desc}</p><span class="wh-choice__cue">{cue}</span></article>)}
  </div>
  <p class="wh-note">{note}</p>
</div>
