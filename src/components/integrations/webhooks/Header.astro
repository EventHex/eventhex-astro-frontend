---
interface Props { eyebrow: string; title: string; description?: string }
const { eyebrow, title, description } = Astro.props;
---
<header class="wh-head animate-on-scroll" data-animation="fadeInUp">
  <span class="wh-eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>
