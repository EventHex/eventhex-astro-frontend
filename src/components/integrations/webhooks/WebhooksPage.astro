---
import Header from "./Header.astro";
import IntegrationFaq from "../IntegrationFaq.astro";
import FourColumnFeatureStrip from "../FourColumnFeatureStrip.astro";
import UseCaseStack from "./UseCaseStack.astro";
import Choice from "./Choice.astro";
import Bento from "./Bento.astro";
import Spotlight from "./Spotlight.astro";
import TriggerBand from "./TriggerBand.astro";
import WebhookHeroVisual from "./WebhookHeroVisual.astro";
import DeliveryRecovery from "./DeliveryRecovery.astro";
import JobFocusSuite from "./JobFocusSuite.astro";
const setup = [
  ["Name the automation", "Give the trigger a label the event team can recognize."],
  ["Choose the event and trigger", "Bind it to the correct EventHex event and one verified trigger type."],
  ["Add the destination", "Enter the receiving URL and select GET, POST, PUT, or PATCH."],
  ["Activate and order", "Enable the trigger and use execution order when multiple actions share the same event."],
];
const faqs = [
  ["Which EventHex events can trigger a webhook?", "The current model supports post-registration, failed registration, attendee checked in, order completed, lead captured, and form submitted."],
  ["Can we control the HTTP request?", "Yes. The trigger supports GET, POST, PUT, or PATCH, custom headers, several authentication styles, and a mapped JSON payload."],
  ["How can the receiver verify EventHex?", "Configure a webhook secret to receive EventHex event, delivery, timestamp, and HMAC-SHA256 signature headers, then verify the timestamp-plus-raw-body value in the receiving system."],
  ["What happens when our endpoint fails?", "The delivery is logged and can enter the automatic backoff schedule at 1 minute, 5 minutes, 15 minutes, 1 hour, and 6 hours."],
  ["Is there a Zapier path?", "The API contains a REST-hook subscription flow, event selection, shaped samples, and create/find attendee actions. Confirm availability for the target Zapier connection before rollout."],
  ["Can we connect any destination?", "Use an endpoint that accepts the configured method, authentication, headers, and mapped payload. Validate that destination’s availability, security, and idempotency before rollout."],
];
const samplePayload = JSON.stringify({
  event: "attendee.checked_in",
  deliveryId: "del_01HZX8Q4W7",
  eventId: "evt_annual_summit_2026",
  attendee: {
    id: "att_12345",
    email: "attendee@example.com",
  },
  occurredAt: "2026-09-28T10:30:00Z",
}, null, 2);
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q,a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
---

<main class="wh-page">
  <section class="wh-hero" id="webhook-flow">
    <div class="wh-hero__grid">
      <div class="wh-hero__content animate-on-scroll" data-animation="fadeInUp">
        <span class="wh-hero__badge">Event webhooks and Zapier</span>
        <h1 class="wh-hero__title">Send selected EventHex events to the systems that need them</h1>
        <p class="wh-hero__desc">Choose a verified event trigger, configure the endpoint and payload, add authentication or an optional signature, and use delivery logs and retries when another system does not respond.</p>
        <div class="wh-hero__cta-row"><a class="wh-hero__btn" href="/book-a-demo/">Book a Demo <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a class="wh-hero__btn wh-hero__btn--outline" href="#trigger-types">See the webhook flow</a></div>
        <div class="wh-hero__trust"><span class="wh-hero__trust-item">6 verified trigger types</span><span class="wh-hero__trust-item">Configurable payload and auth</span><span class="wh-hero__trust-item">Signed delivery and retries</span></div>
      </div>
      <div class="wh-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="wh-hero__visual-card">
          <div class="wh-hero__visual-inner"><WebhookHeroVisual /></div>
        </div>
      </div>
    </div>
  </section>

  <nav class="wh-rail" aria-label="Webhook lifecycle"><span class="wh-rail__eyebrow">A CONNECTED WEBHOOK FLOW</span><div class="wh-wrap">{[["01 · Choose","Event trigger"],["02 · Scope","Eligible tickets"],["03 · Build","Payload fields"],["04 · Secure","Auth or signature"],["05 · Deliver","HTTP request"],["06 · Recover","Log and retry"]].map(([a,b]) => <div><b>{a}</b><span>{b}</span></div>)}</div></nav>

  <TriggerBand />

  <FourColumnFeatureStrip heading="Define what EventHex should call<br />and when" items={setup} />

  <section class="wh-scope-section" id="ticket-scope">
    <div class="wh-scope-header">
      <span class="wh-eyebrow">Limit the automation when the event needs it</span>
      <h2>Apply a webhook to selected ticket types—or leave it open to all</h2>
      <p>Choose the audience for each trigger. Keep sensitive workflows narrow, or let an event-wide automation run without an eligibility list.</p>
    </div>
    <div class="wh-scope-grid">
    <span class="wh-scope-notch wh-scope-notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e7eaf2"></path></svg></span>
    <span class="wh-scope-notch wh-scope-notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e7eaf2" transform="scale(1,-1)"></path></svg></span>
      <article class="wh-scope-copy">
        <h3>Selected tickets</h3>
        <p>Run only when the registration or order belongs to one of the eligible ticket types.</p>
        <span class="wh-scope-cue">Narrow scope</span>
      </article>
      <div class="wh-scope-media" aria-label="Selected ticket webhook scope preview">
        <div class="wh-scope-visual wh-scope-visual--selected">
          <div class="wh-scope-windowbar"><i></i><i></i><i></i><b>Webhook trigger</b></div>
          <div class="wh-scope-windowbody"><small>TICKET ELIGIBILITY</small><strong>Only these tickets</strong><div class="wh-scope-ticket is-active"><span class="wh-scope-check">✓</span><span>VIP Delegate</span><em>Selected</em></div><div class="wh-scope-ticket"><span class="wh-scope-check">✓</span><span>Workshop Pass</span><em>Selected</em></div><div class="wh-scope-ticket is-muted"><span></span><span>General Admission</span><em>Excluded</em></div></div>
          <span class="wh-scope-status">✓ Scoped to 2 tickets</span><span class="wh-scope-action">Save trigger</span>
        </div>
      </div>
      <div class="wh-scope-media" aria-label="All ticket webhook scope preview">
        <div class="wh-scope-visual wh-scope-visual--all">
          <div class="wh-scope-windowbar"><i></i><i></i><i></i><b>Webhook trigger</b></div>
          <div class="wh-scope-windowbody"><small>TICKET ELIGIBILITY</small><strong>Every ticket in this event</strong><div class="wh-scope-eventwide"><span>◎</span><div><b>Event-wide trigger</b><em>Eligibility list is empty</em></div><strong>ON</strong></div><div class="wh-scope-rule"></div><p>New ticket types are included automatically.</p></div>
          <span class="wh-scope-status">✓ Event-wide</span><span class="wh-scope-action">Apply to all</span>
        </div>
      </div>
      <article class="wh-scope-copy">
        <h3>All tickets</h3>
        <p>Leave the eligibility list empty when the trigger should apply across the event.</p>
        <span class="wh-scope-cue">Event-wide</span>
      </article>
    </div>
    <p class="wh-scope-note">Ticket eligibility is evaluated when the triggering data includes a registration and ticket context.</p>
  </section>

  <section class="wh-request" id="request">
    <div class="wh-request__inner">
      <header class="wh-request__head animate-on-scroll" data-animation="fadeInUp">
        <span class="wh-eyebrow">Control the request</span>
        <h2>Match the receiving system’s <span class="wh-request__gradient">endpoint contract</span></h2>
      </header>

      <div class="wh-rbento animate-on-scroll" data-animation="fadeInUp">
        <span class="wh-rbento__notch wh-rbento__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg></span>
        <span class="wh-rbento__notch wh-rbento__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg></span>

        <!-- Row 1: visual left, copy right -->
        <div class="wh-rbento__row">
          <div class="wh-rbento__cell wh-rbento__visual">
            <div class="wh-rbento__stage wh-rbento__stage--method">
              <div class="wh-rbento__window">
                <div class="wh-rbento__chrome"><i></i><i></i><i></i><b>Webhook trigger</b></div>
                <div class="wh-rbento__body">
                  <small>REQUEST CONFIGURATION</small>
                  <strong>Outbound request</strong>
                  <div class="wh-rbento__field">
                    <span class="wh-rbento__field-label">Method</span>
                    <span class="wh-rbento__control">POST<i class="wh-rbento__caret"></i></span>
                  </div>
                  <div class="wh-rbento__field">
                    <span class="wh-rbento__field-label">Custom headers</span>
                    <span class="wh-rbento__control">Content-Type<em>application/json</em></span>
                    <span class="wh-rbento__control">X-Event-Key<em class="wh-rbento__mask"></em></span>
                  </div>
                </div>
              </div>
              <span class="wh-rbento__pill wh-rbento__pill--top"><b>POST selected</b><small>Outbound request</small></span>
              <span class="wh-rbento__pill wh-rbento__pill--bottom"><i></i><b>2 headers sent</b></span>
            </div>
          </div>
          <div class="wh-rbento__cell wh-rbento__content">
            <span class="wh-rbento__eyebrow">Request shape</span>
            <h3>Choose the method and headers</h3>
            <p><strong>Method.</strong> Choose GET, POST, PUT, or PATCH for the outbound request.</p>
            <p><strong>Custom headers.</strong> Add the headers required by the destination.</p>
          </div>
          <span class="wh-rbento__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>
        </div>

        <!-- Row 2: copy left, visual right -->
        <div class="wh-rbento__row wh-rbento__row--reverse">
          <div class="wh-rbento__cell wh-rbento__content">
            <span class="wh-rbento__eyebrow">Endpoint access</span>
            <h3>Authenticate and target the right URL</h3>
            <p><strong>Authentication.</strong> Use no auth, header, query parameter, API key, or bearer-style credentials.</p>
            <p><strong>Destination URL.</strong> Send to the endpoint owned by your integration or automation platform.</p>
          </div>
          <div class="wh-rbento__cell wh-rbento__visual">
            <div class="wh-rbento__stage wh-rbento__stage--access">
              <div class="wh-rbento__window">
                <div class="wh-rbento__chrome"><i></i><i></i><i></i><b>Webhook trigger</b></div>
                <div class="wh-rbento__body">
                  <small>ENDPOINT CONTRACT</small>
                  <strong>Authentication</strong>
                  <div class="wh-rbento__field">
                    <span class="wh-rbento__field-label">Auth type</span>
                    <span class="wh-rbento__control">Bearer token<i class="wh-rbento__caret"></i></span>
                  </div>
                  <div class="wh-rbento__field">
                    <span class="wh-rbento__field-label">Destination URL</span>
                    <span class="wh-rbento__control wh-rbento__control--url">https://api.yourservice.com/hooks</span>
                  </div>
                </div>
              </div>
              <span class="wh-rbento__pill wh-rbento__pill--top"><b>Bearer token</b><small>Auth header attached</small></span>
              <span class="wh-rbento__pill wh-rbento__pill--bottom"><i></i><b>Endpoint reachable</b></span>
            </div>
          </div>
          <span class="wh-rbento__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>
        </div>
      </div>
    </div>
  </section>

  <DeliveryRecovery />

  <section class="wh-zapier" id="zapier">
    <div class="wh-zapier__container">
      <div class="wh-zapier__left">
        <div class="wh-zapier__sticky animate-on-scroll" data-animation="fadeInUp">
          <div class="wh-zapier__eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"></path></svg>
            Zapier path
          </div>
          <h2>Use the current EventHex Zapier surface <span class="wh-zapier__gradient">when a REST-hook workflow fits</span></h2>
          <p>The API can subscribe and unsubscribe a Zapier hook by creating the corresponding EventHex webhook trigger, and can return recent or static sample data for the supported trigger setup.</p>
          <a class="wh-zapier__cta" href="/book-a-demo/">Book a Demo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>
      </div>

      <div class="wh-zapier__right">
        <article class="wh-zapier-card animate-on-scroll" data-animation="fadeInUp">
          <div class="wh-zapier-card__header">
            <div class="wh-zapier-card__number">01</div>
            <div class="wh-zapier-card__text">
              <h3>Connect</h3>
              <p>Use the authenticated EventHex connection for the Zapier workflow.</p>
            </div>
          </div>
          <div class="wh-zapier-card__visual">
            <div class="wh-zapier-shot">
              <div class="wh-zapier-shot__window">
                <div class="wh-zapier-shot__chrome"><i></i><i></i><i></i><b>Zapier connection</b></div>
                <div class="wh-zapier-shot__body">
                  <small>CONNECTED ACCOUNT</small>
                  <strong>EventHex</strong>
                  <div class="wh-zapier-shot__row"><span>EventHex account</span><em>Connected</em></div>
                  <div class="wh-zapier-shot__row"><span>Zapier workspace</span><em>Linked</em></div>
                </div>
              </div>
              <span class="wh-zapier-shot__status wh-zapier-shot__status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Connected</span>
              <span class="wh-zapier-shot__action">Connect account</span>
              <svg class="wh-zapier-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="wh-zapier-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <div class="wh-zapier-card__header">
            <div class="wh-zapier-card__number">02</div>
            <div class="wh-zapier-card__text">
              <h3>Choose event</h3>
              <p>Load the events available to the connected organization.</p>
            </div>
          </div>
          <div class="wh-zapier-card__visual">
            <div class="wh-zapier-shot">
              <div class="wh-zapier-shot__window">
                <div class="wh-zapier-shot__chrome"><i></i><i></i><i></i><b>Select event</b></div>
                <div class="wh-zapier-shot__body">
                  <small>EVENT</small>
                  <strong>Choose the event</strong>
                  <div class="wh-zapier-shot__row is-active"><span class="wh-zapier-shot__radio"></span><span>Annual Summit 2026</span><em>Selected</em></div>
                  <div class="wh-zapier-shot__row is-muted"><span class="wh-zapier-shot__radio"></span><span>Product Launch</span><em>Available</em></div>
                </div>
              </div>
              <span class="wh-zapier-shot__status wh-zapier-shot__status--info"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Event selected</span>
              <span class="wh-zapier-shot__action">Select event</span>
              <svg class="wh-zapier-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="wh-zapier-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <div class="wh-zapier-card__header">
            <div class="wh-zapier-card__number">03</div>
            <div class="wh-zapier-card__text">
              <h3>Subscribe</h3>
              <p>Create the REST-hook trigger for the selected EventHex event and trigger type.</p>
            </div>
          </div>
          <div class="wh-zapier-card__visual">
            <div class="wh-zapier-shot">
              <div class="wh-zapier-shot__window">
                <div class="wh-zapier-shot__chrome"><i></i><i></i><i></i><b>REST hook</b></div>
                <div class="wh-zapier-shot__body">
                  <small>SUBSCRIPTION</small>
                  <strong>Trigger created</strong>
                  <div class="wh-zapier-shot__row"><span>Trigger type</span><em>Checked in</em></div>
                  <div class="wh-zapier-shot__row"><span>Subscription</span><em>Active</em></div>
                </div>
              </div>
              <span class="wh-zapier-shot__status wh-zapier-shot__status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Hook active</span>
              <span class="wh-zapier-shot__action">Create hook</span>
              <svg class="wh-zapier-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>

        <article class="wh-zapier-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <div class="wh-zapier-card__header">
            <div class="wh-zapier-card__number">04</div>
            <div class="wh-zapier-card__text">
              <h3>Test</h3>
              <p>Use shaped sample data so the Zap can configure downstream steps.</p>
            </div>
          </div>
          <div class="wh-zapier-card__visual">
            <div class="wh-zapier-shot">
              <div class="wh-zapier-shot__window">
                <div class="wh-zapier-shot__chrome"><i></i><i></i><i></i><b>Sample data</b></div>
                <div class="wh-zapier-shot__body">
                  <small>TEST PAYLOAD</small>
                  <strong>Shaped sample</strong>
                  <pre class="wh-zapier-shot__code">{samplePayload}</pre>
                </div>
              </div>
              <span class="wh-zapier-shot__status wh-zapier-shot__status--info"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Sample ready</span>
              <span class="wh-zapier-shot__action">Send test</span>
              <svg class="wh-zapier-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="wh-attendee-spotlight" id="attendee-actions">
    <div class="wh-attendee-spotlight__header">
      <h2>Bring attendees into the workflow</h2>
      <p>Use the supported attendee actions alongside trigger subscriptions.</p>
    </div>
    <div class="wh-attendee-spotlight__grid">
      <article class="wh-attendee-spotlight__copy">
        <h3>Create attendee</h3>
        <p>Create a minimal attendee record through the Zapier action, then run the same post-registration trigger path used by the product.</p>
        <span class="wh-attendee-spotlight__cue">Action</span>
      </article>
      <div class="wh-attendee-spotlight__media" role="img" aria-label="Create attendee action preview">
        <div class="wh-attendee-spotlight__mock wh-attendee-spotlight__mock--create">
          <div class="wh-attendee-spotlight__mockbar"><i></i><i></i><i></i><b>Create attendee</b></div>
          <div class="wh-attendee-spotlight__mockbody"><small>ATTENDEE ACTION</small><strong>Create a record</strong><div class="wh-attendee-spotlight__field"><span>Name</span><b>New attendee</b></div><div class="wh-attendee-spotlight__field"><span>Email</span><b>attendee@example.com</b></div><span class="wh-attendee-spotlight__success">Attendee created</span></div>
        </div>
      </div>
      <div class="wh-attendee-spotlight__media" role="img" aria-label="Find attendee action preview">
        <div class="wh-attendee-spotlight__mock wh-attendee-spotlight__mock--find">
          <div class="wh-attendee-spotlight__mockbar"><i></i><i></i><i></i><b>Find attendee</b></div>
          <div class="wh-attendee-spotlight__mockbody"><small>ATTENDEE SEARCH</small><strong>Find a matching record</strong><div class="wh-attendee-spotlight__search">attendee@example.com<span>⌕</span></div><div class="wh-attendee-spotlight__result"><span class="wh-attendee-spotlight__avatar">A</span><span><b>Attendee found</b><small>Annual Summit 2026</small></span><em>Matched</em></div></div>
        </div>
      </div>
      <article class="wh-attendee-spotlight__copy">
        <h3>Find attendee</h3>
        <p>Search for an attendee by email and event through the supported endpoint.</p>
        <span class="wh-attendee-spotlight__cue">Search</span>
      </article>
    </div>
    <p class="wh-attendee-spotlight__note">The current evidence does not support promising every EventHex action or every Zapier-connected app as a native integration.</p>
  </section>

  <UseCaseStack />

  <JobFocusSuite />

  <FourColumnFeatureStrip
    eyebrow="Connected integration options"
    heading="Choose the integration that already owns the job"
    items={[
      ["Developers", "Explore the broader EventHex API and technical integration surface.", "/developers/", "code"],
      ["HubSpot Integration", "Map EventHex contacts and event context into HubSpot through the dedicated connector.", "/integrations/hubspot/", "hub"],
      ["Event Registration", "Configure the forms and checkout flows that create registration triggers.", "/event-registration/", "form"],
      ["Event Check-In", "Operate the attendee-arrival workflow behind the checked-in trigger.", "/event-check-in/", "check"],
    ]}
  />

  <IntegrationFaq heading="Webhook &amp; Zapier<br />Questions, Answered." intro="Find quick answers about event triggers, request controls, verification, delivery failures, and Zapier workflows." faqs={faqs} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</main>

<style is:global>
