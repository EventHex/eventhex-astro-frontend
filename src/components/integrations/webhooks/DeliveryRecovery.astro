---
const tabs = [
  {
    id: "log",
    label: "Execution log",
    title: "Execution log",
    description: "Record trigger, event, action, status, timing, response, or error context.",
    chips: ["trigger", "event", "action", "status", "timing", "response", "error context"],
    visualLabel: "Delivery log",
  },
  {
    id: "stats",
    label: "Statistics",
    title: "Statistics",
    description: "Maintain execution, success, failure, and last-executed counts on the trigger.",
    chips: ["executions", "success", "failure", "last executed"],
    visualLabel: "Trigger statistics",
  },
  {
    id: "retry",
    label: "Retry schedule",
    title: "Retry schedule",
    description: "Use the shipped 1-minute, 5-minute, 15-minute, 1-hour, and 6-hour backoff sequence.",
    chips: ["1 minute", "5 minutes", "15 minutes", "1 hour", "6 hours"],
    visualLabel: "Backoff schedule",
  },
  {
    id: "delivery-id",
    label: "Delivery ID",
    title: "Delivery ID",
    description: "Reuse the delivery identifier across retries so the receiver can recognize the same delivery.",
    chips: ["delivery identifier", "reused across retries"],
    visualLabel: "Delivery identifier",
  },
];
---

<section class="wh-delivery" id="delivery" aria-labelledby="wh-delivery-title">
  <div class="wh-delivery__inner">
    <header class="wh-delivery__header animate-on-scroll" data-animation="fadeInUp">
      <span class="wh-eyebrow">Delivery and recovery</span>
      <h2 id="wh-delivery-title" class="wh-delivery__title">
        Keep failed endpoint calls visible and retry them on a defined schedule
      </h2>
      <p class="wh-delivery__subtitle">
        The initial delivery records its result and execution time. Failed webhook deliveries can enter
        the automatic retry schedule instead of disappearing after one request.
      </p>
    </header>

    <div class="wh-delivery__tabs animate-on-scroll" data-animation="fadeInUp" role="tablist" aria-label="Delivery and recovery">
      {tabs.map((tab, index) => (
        <button
          type="button"
          class:list={["wh-delivery__tab", { "wh-delivery__tab--active": index === 0 }]}
          role="tab"
          id={`wh-delivery-tab-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`wh-delivery-panel-${tab.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-target={tab.id}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="wh-delivery__box">
      {tabs.map((tab, index) => (
        <div
          class:list={["wh-delivery__panel", { "wh-delivery__panel--active": index === 0 }]}
          id={`wh-delivery-panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`wh-delivery-tab-${tab.id}`}
          data-panel={tab.id}
        >
          <div class="wh-delivery__left">
            <h3 class="wh-delivery__panel-title">{tab.title}</h3>
            <p class="wh-delivery__panel-desc">{tab.description}</p>
            <ul class="wh-delivery__chips">
              {tab.chips.map((chip) => <li class="wh-delivery__chip">{chip}</li>)}
            </ul>
          </div>

          <div class="wh-delivery__right">
            <div class="wh-delivery__showcase">
              <div class="wh-delivery__screen">
                {tab.id === "log" && (
                  <div class="wh-delivery__log" aria-hidden="true">
                    <div class="wh-delivery__log-head"><span>Delivery log</span><span>Status</span></div>
                    <div class="wh-delivery__log-row">
                      <span><b>delivery_024</b><small>POST &middot; 342 ms</small></span>
                      <em class="wh-delivery__pill wh-delivery__pill--ok">Delivered</em>
                    </div>
                    <div class="wh-delivery__log-row">
                      <span><b>delivery_023</b><small>POST &middot; retrying</small></span>
                      <em class="wh-delivery__pill wh-delivery__pill--warn">Retrying</em>
                    </div>
                    <div class="wh-delivery__log-row">
                      <span><b>delivery_022</b><small>POST &middot; error recorded</small></span>
                      <em class="wh-delivery__pill wh-delivery__pill--bad">Failed</em>
                    </div>
                  </div>
                )}

                {tab.id === "stats" && (
                  <div class="wh-delivery__stats" aria-hidden="true">
                    <div><small>Executions</small><strong>24</strong></div>
                    <div><small>Successful</small><strong>23</strong></div>
                    <div><small>Failed</small><strong>1</strong></div>
                    <p><i></i>Last executed counts on the trigger</p>
                  </div>
                )}

                {tab.id === "retry" && (
                  <ul class="wh-delivery__ladder" aria-hidden="true">
                    <li><i></i><b>1 minute</b></li>
                    <li><i></i><b>5 minutes</b></li>
                    <li><i></i><b>15 minutes</b></li>
                    <li><i></i><b>1 hour</b></li>
                    <li><i></i><b>6 hours</b></li>
                  </ul>
                )}

                {tab.id === "delivery-id" && (
                  <div class="wh-delivery__idcard" aria-hidden="true">
                    <div class="wh-delivery__idrow"><span>delivery_id</span><b>delivery_024</b></div>
                    <div class="wh-delivery__idrow"><span>attempt</span><b>4 of 5</b></div>
                    <div class="wh-delivery__idrow"><span>signature</span><b>HMAC-SHA256</b></div>
                    <p><i></i>Reused across retries</p>
                  </div>
                )}
              </div>
              <span class="wh-delivery__label">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <rect x="3" y="3" width="14" height="14" rx="3"></rect>
                  <path d="M7 10h6M7 7h4M7 13h3"></path>
                </svg>
                {tab.visualLabel}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wh-delivery {
    padding: 112px 24px;
    background: #fff;
  }
  .wh-delivery__inner {
    width: min(1080px, 100%);
    margin: 0 auto;
  }
  .wh-delivery__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 32px;
    text-align: center;
  }
  .wh-delivery__title {
    max-width: 800px;
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .wh-delivery__subtitle {
    max-width: 720px;
    margin: 0;
    color: #6b7280;
    font: 500 17.5px/1.5 var(--font-body);
  }

  .wh-delivery__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 6px;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: #f1f3f7;
  }
  .wh-delivery__tab {
    padding: 8px 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #64748b;
    font: 600 13.5px/1.3 var(--font-body);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .wh-delivery__tab:hover {
    background: rgba(255, 255, 255, 0.65);
    color: #334155;
  }
  .wh-delivery__tab:focus-visible {
    outline: 2px solid var(--brand-blue);
    outline-offset: 2px;
  }
  .wh-delivery__tab--active {
    border-color: #dbe4f0;
    background: #fff;
    color: #3b82f6;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
  }

  .wh-delivery__box {
    background: transparent;
  }
  .wh-delivery__panel {
    --wh-delivery-tint: #fff8dc;
    --wh-delivery-border: #f0dfa6;
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 52px 64px;
    border: 1px solid var(--wh-delivery-border);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--wh-delivery-tint) 0%, #fff 72%);
  }
  .wh-delivery__panel:nth-child(2) {
    --wh-delivery-tint: #edf7ff;
    --wh-delivery-border: #d4e7f7;
  }
  .wh-delivery__panel:nth-child(3) {
    --wh-delivery-tint: #f3efff;
    --wh-delivery-border: #e2d8fa;
  }
  .wh-delivery__panel:nth-child(4) {
    --wh-delivery-tint: #eefbf4;
    --wh-delivery-border: #d4efdf;
  }
  .wh-delivery__panel--active {
    display: grid;
    animation: wh-delivery-fade 0.4s ease forwards;
  }
  @keyframes wh-delivery-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wh-delivery__panel-title {
    margin: 0 0 18px;
    color: #1f2937;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 42px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .wh-delivery__panel-desc {
    margin: 0 0 26px;
    color: #4b5563;
    font: 500 16px/1.6 var(--font-body);
  }
  .wh-delivery__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wh-delivery__chip {
    padding: 7px 12px;
    border: 1px solid var(--wh-delivery-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #475569;
    font: 600 12.5px/1.2 var(--font-body);
  }

  .wh-delivery__right {
    min-width: 0;
  }
  .wh-delivery__showcase {
    position: relative;
    isolation: isolate;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 22px 48px rgba(31, 41, 55, 0.1);
  }
  .wh-delivery__showcase::before {
    content: "";
    position: absolute;
    inset: 10% 7% -8%;
    z-index: -1;
    border-radius: 12px;
    background: var(--wh-delivery-border);
    filter: blur(22px);
    opacity: 0.48;
  }
  .wh-delivery__screen {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    aspect-ratio: 1117 / 837;
    padding: 18px;
    overflow: hidden;
    border: 1px solid #e0e4ec;
    border-radius: 12px;
    background: #fff;
  }
  .wh-delivery__label {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border: 1px solid #cddcff;
    border-radius: 10px;
    background: #eef4ff;
    box-shadow: 0 8px 22px rgba(49, 88, 212, 0.16);
    color: #3158d4;
    font: 700 11px/1.2 var(--font-body);
  }
  .wh-delivery__label svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ===== MOCK SURFACES ===== */
  .wh-delivery__log {
    display: flex;
    flex-direction: column;
  }
  .wh-delivery__log-head,
  .wh-delivery__log-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 6px;
    border-bottom: 1px solid #eef1f6;
  }
  .wh-delivery__log-head {
    color: #9aa2b1;
    font: 700 9.5px/1.2 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wh-delivery__log-row:last-child {
    border-bottom: 0;
  }
  .wh-delivery__log-row > span {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .wh-delivery__log-row b {
    color: #1f2937;
    font: 650 13px/1.2 var(--font-body);
  }
  .wh-delivery__log-row small {
    color: #8b93a1;
    font: 500 10.5px/1.2 var(--font-body);
  }
  .wh-delivery__pill {
    padding: 5px 10px;
    border-radius: 999px;
    font: 650 10.5px/1.2 var(--font-body);
    font-style: normal;
    white-space: nowrap;
  }
  .wh-delivery__pill--ok {
    background: #eaf9f1;
    color: #138552;
  }
  .wh-delivery__pill--warn {
    background: #eef2ff;
    color: #3f5bd6;
  }
  .wh-delivery__pill--bad {
    background: #fdeeee;
    color: #b42318;
  }

  .wh-delivery__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .wh-delivery__stats > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border: 1px solid #e6eaf2;
    border-radius: 12px;
    background: #f8fafc;
  }
  .wh-delivery__stats small {
    color: #8b93a1;
    font: 700 9.5px/1.2 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wh-delivery__stats strong {
    color: #1f2937;
    font: 500 26px/1 var(--font-heading);
  }
  .wh-delivery__stats p,
  .wh-delivery__idcard p {
    display: flex;
    align-items: center;
    gap: 8px;
    grid-column: 1 / -1;
    margin: 4px 0 0;
    color: #6b7280;
    font: 500 11.5px/1.3 var(--font-body);
  }
  .wh-delivery__stats p i,
  .wh-delivery__idcard p i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #21b26f;
  }

  .wh-delivery__ladder {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wh-delivery__ladder li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid #e6eaf2;
    border-radius: 10px;
    background: #f8fafc;
  }
  .wh-delivery__ladder i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #dfe5f1;
  }
  .wh-delivery__ladder b {
    color: #334155;
    font: 650 12.5px/1.2 var(--font-body);
  }
  .wh-delivery__ladder li:last-child i {
    background: #375dfb;
    box-shadow: 0 0 0 4px rgba(55, 93, 251, 0.14);
  }

  .wh-delivery__idcard {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wh-delivery__idrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 13px;
    border: 1px solid #e6eaf2;
    border-radius: 10px;
    background: #f8fafc;
  }
  .wh-delivery__idrow span {
    color: #8b93a1;
    font: 600 10.5px/1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .wh-delivery__idrow b {
    color: #1f2937;
    font: 650 12.5px/1.2 var(--font-body);
  }
  .wh-delivery__idcard p {
    margin: 2px 0 0;
  }

  @media (max-width: 900px) {
    .wh-delivery__panel {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 48px;
    }
  }
  @media (max-width: 620px) {
    .wh-delivery {
      padding: 72px 20px;
    }
    .wh-delivery__title {
      font-size: clamp(26px, 8.3vw, 38px);
      overflow-wrap: anywhere;
    }
    .wh-delivery__subtitle {
      font-size: 16px;
    }
    .wh-delivery__tabs {
      justify-content: flex-start;
      flex-wrap: nowrap;
      width: 100%;
      overflow-x: auto;
      border-radius: 20px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .wh-delivery__tabs::-webkit-scrollbar {
      display: none;
    }
    .wh-delivery__tab {
      flex: 0 0 auto;
      padding-inline: 14px;
      white-space: nowrap;
    }
    .wh-delivery__panel {
      padding: 32px 24px;
      border-radius: 20px;
    }
    .wh-delivery__showcase {
      padding: 14px;
      border-radius: 18px;
    }
    .wh-delivery__screen {
      aspect-ratio: auto;
      padding: 14px;
    }
    .wh-delivery__label {
      top: 6px;
      left: 6px;
      padding: 7px 9px;
      font-size: 9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wh-delivery__panel--active {
      animation: none;
    }
  }
</style>

<script>
  function initWhDeliveryTabs() {
    const root = document.querySelector<HTMLElement>(".wh-delivery");
    if (!root || root.dataset.tabsReady === "true") return;
    root.dataset.tabsReady = "true";

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".wh-delivery__tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".wh-delivery__panel"));
    if (tabs.length === 0) return;

    let rotationId: number | undefined;

    const activate = (tab: HTMLButtonElement) => {
      const target = tab.dataset.target;
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle("wh-delivery__tab--active", isActive);
        item.setAttribute("aria-selected", String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.classList.toggle("wh-delivery__panel--active", panel.dataset.panel === target);
      });
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activate(tabs[(current + 1) % tabs.length]);
      }, 4000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activate(tab);
        startRotation();
      });
      tab.addEventListener("keydown", (event) => {
        let next = -1;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        if (next < 0) return;
        event.preventDefault();
        activate(tabs[next]);
        tabs[next].focus();
        startRotation();
      });
    });

    root.addEventListener("mouseenter", stopRotation);
    root.addEventListener("mouseleave", startRotation);
    root.addEventListener("focusin", stopRotation);
    root.addEventListener("focusout", (event) => {
      const related = event.relatedTarget;
      if (!(related instanceof Node) || !root.contains(related)) startRotation();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopRotation();
      else startRotation();
    });

    startRotation();
  }

  initWhDeliveryTabs();
  document.addEventListener("astro:page-load", initWhDeliveryTabs);
</script>
