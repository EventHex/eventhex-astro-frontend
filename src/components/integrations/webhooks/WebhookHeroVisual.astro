---
const steps = [
  ["EVENT", "Registration completed", "Event + attendee context", "Ready"],
  ["PAYLOAD", "Map destination fields", "email · ticket · event_id · source", "4 fields"],
  ["SECURITY", "Sign request body", "HMAC-SHA256 · timestamp", "Signed"],
  ["DELIVERY", "Endpoint responded", "POST · 342 ms · delivery_024", "200 OK"],
];
---
<div class="wh-hero__demo">
  <div class="wh-demo" role="img" aria-label="Animated EventHex webhook builder showing a post-registration event mapped, signed, and delivered successfully">
    <div class="wh-demo__top"><span class="wh-demo__mark">e</span><div><b>Webhook automation</b><small>Registration handoff</small></div><span class="wh-demo__live"><i></i>Active</span></div>
    <div class="wh-demo__body">
      <aside><small>TRIGGER</small><b>Post-registration</b><span>All tickets</span><div class="wh-demo__stats"><small>DELIVERIES</small><strong>24</strong><em>23 successful</em></div></aside>
      <div class="wh-demo__canvas">
        <div class="wh-demo__route" aria-hidden="true"><i></i><i></i><i></i></div>
        {steps.map(([label,title,meta,status],i) => <article style={`--step:${i}`}><span class:list={["wh-demo__icon", {"wh-demo__icon--success": i === 3}]}>{i === 3 ? "✓" : String(i+1).padStart(2,"0")}</span><div><small>{label}</small><b>{title}</b><em>{meta}</em></div><mark class:list={{"wh-demo__ok": i === 3}}>{status}</mark></article>)}
      </div>
    </div>
    <div class="wh-demo__toast"><span>✓</span><div><b>Webhook delivered</b><small>Response stored in execution log</small></div></div>
  </div>
</div>
<style is:global>
  .wh-demo{position:relative;padding:12px;border:1px solid #fff;border-radius:24px;background:#ffffffa8;box-shadow:0 30px 70px #1c2b4f29;backdrop-filter:blur(18px);font-family:var(--font-body)}.wh-demo__top{display:flex;align-items:center;gap:10px;padding:7px 8px 16px}.wh-demo__mark{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#375dfb;color:#fff;font-weight:800}.wh-demo__top div{display:flex;flex-direction:column}.wh-demo__top b{font-size:12px}.wh-demo__top small{color:#7b8290;font-size:10px}.wh-demo__live{margin-left:auto;padding:6px 9px;border:1px solid #cdebdc;border-radius:99px;color:#138552;background:#f1fbf6;font-size:10px;font-weight:700}.wh-demo__live i{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:#21b26f;animation:wh-pulse 1.8s infinite}.wh-demo__body{display:grid;grid-template-columns:122px 1fr;min-height:388px;border:1px solid #e2e7f0;border-radius:16px;overflow:hidden;background:#f4f7fd}.wh-demo aside{display:flex;flex-direction:column;padding:22px 15px;background:#121722;color:#fff}.wh-demo aside>small,.wh-demo__stats small{color:#8e97a8;font-size:8px;font-weight:750;letter-spacing:.1em}.wh-demo aside>b{margin:11px 0 7px;font-size:12px}.wh-demo aside>span{color:#aeb6c5;font-size:9px}.wh-demo__stats{margin-top:auto;padding-top:18px;border-top:1px solid #303746}.wh-demo__stats strong,.wh-demo__stats em{display:block}.wh-demo__stats strong{margin:6px 0 2px;font-size:26px}.wh-demo__stats em{color:#6ce0a2;font-size:9px;font-style:normal}.wh-demo__canvas{position:relative;display:grid;align-content:center;gap:12px;padding:22px}.wh-demo__canvas article{position:relative;z-index:1;display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:11px;padding:13px;border:1px solid #dfe5ef;border-radius:12px;background:#fff;box-shadow:0 5px 14px #1b2b530d;animation:wh-card-cycle 8s infinite;animation-delay:calc(var(--step)*1.5s)}.wh-demo__canvas article>div{display:flex;min-width:0;flex-direction:column}.wh-demo__canvas small{color:#9299a6;font-size:8px;font-weight:750;letter-spacing:.08em}.wh-demo__canvas b{margin:3px 0;font-size:11px}.wh-demo__canvas em{overflow:hidden;color:#7b8290;font-size:8px;font-style:normal;text-overflow:ellipsis;white-space:nowrap}.wh-demo__icon{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#edf1ff;color:#375dfb;font-size:9px;font-weight:800}.wh-demo__icon--success{background:#eaf9f1;color:#138552;font-size:13px}.wh-demo__canvas mark{padding:5px 7px;border-radius:6px;background:#f1f3f7;color:#68707e;font-size:8px;font-weight:700}.wh-demo__canvas .wh-demo__ok{background:#eaf9f1;color:#138552}.wh-demo__route{position:absolute;top:65px;bottom:65px;left:38px;width:2px;background:#d4dcff}.wh-demo__route i{position:absolute;left:-3px;width:8px;height:8px;border-radius:50%;background:#375dfb;box-shadow:0 0 0 4px #e5eaff;animation:wh-route 3s infinite}.wh-demo__route i:nth-child(2){animation-delay:1s}.wh-demo__route i:nth-child(3){animation-delay:2s}.wh-demo__toast{position:absolute;right:-16px;bottom:-22px;display:flex;align-items:center;gap:10px;padding:13px 16px;border:1px solid #dfe7e3;border-radius:13px;background:#fff;box-shadow:0 16px 34px #162a222b;animation:wh-toast 8s infinite}.wh-demo__toast>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#21b26f;color:#fff}.wh-demo__toast div{display:flex;flex-direction:column}.wh-demo__toast b{font-size:11px}.wh-demo__toast small{margin-top:2px;color:#7b8290;font-size:8px}@keyframes wh-pulse{50%{box-shadow:0 0 0 5px #21b26f29}}@keyframes wh-card-cycle{0%,18%,100%{border-color:#dfe5ef;transform:translateX(0)}6%,14%{border-color:#375dfb;box-shadow:0 8px 22px #375dfb29;transform:translateX(3px)}}@keyframes wh-route{0%{top:0;opacity:0}20%,80%{opacity:1}100%{top:100%;opacity:0}}@keyframes wh-toast{0%,65%,100%{opacity:0;transform:translateY(10px)}72%,92%{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.wh-demo *{animation:none!important}}@media(max-width:600px){.wh-demo__body{grid-template-columns:1fr}.wh-demo aside{min-height:90px}.wh-demo__stats{display:none}.wh-demo__canvas{padding:14px}.wh-demo__canvas article{grid-template-columns:30px 1fr}.wh-demo__canvas mark{display:none}.wh-demo__route{left:29px}.wh-demo__toast{right:8px;bottom:-26px}}
</style>
