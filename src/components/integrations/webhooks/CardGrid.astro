---
interface Props { items: string[][] }
const { items } = Astro.props;
---
<div class="wh-wrap wh-grid">
  {items.map(([title, desc], i) => <article class="wh-card animate-on-scroll" data-animation="fadeInUp" data-delay={String((i % 3) * 60)}><span>{String(i + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{desc}</p></article>)}
</div>
