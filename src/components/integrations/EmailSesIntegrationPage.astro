  /* Exact Event Registration confirmation-bento structure for Campaign Delivery Path. */
  .eml-transport{padding:80px 5%;background:transparent;max-width:none}
  .eml-transport-container{max-width:1200px;margin:0 auto}
  .eml-transport-header{text-align:center;margin-bottom:60px}
  .eml-transport-header h2{margin:0;font-family:var(--font-heading);font-size:clamp(32px,4vw,56px);font-weight:500;line-height:1.08;letter-spacing:-.03em;color:#22272f}
  .eml-transport-header h2 em{font-style:normal;background:linear-gradient(96deg,#5f6675,#9aa1ae);-webkit-background-clip:text;background-clip:text;color:transparent}
  .eml-transport-bento{position:relative;max-width:none;margin:0;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;background:transparent}
  .eml-bento-notch{position:absolute;left:50%;width:28px;height:28px;pointer-events:none;line-height:0;z-index:2}
  .eml-bento-notch svg,.eml-bento-cross svg{display:block}
  .eml-bento-notch--top{top:0;transform:translate(-50%,-50%)}
  .eml-bento-notch--bottom{bottom:0;transform:translate(-50%,50%)}
  .eml-transport-row{position:relative;display:grid;grid-template-columns:1fr 1fr;min-height:0;border-bottom:1px solid #e5e7eb}
  .eml-transport-row:last-child{border-bottom:0}
  .eml-transport-cell{display:flex;flex-direction:column;justify-content:center;padding:4rem}
  .eml-transport-row:not(.eml-transport-row--reverse) .eml-transport-cell:first-child,.eml-transport-row.eml-transport-row--reverse .eml-transport-cell:first-child{border-right:1px solid #e5e7eb}
  .eml-transport-copy{order:initial;background:transparent}
  .eml-transport-visual{align-items:center;background:transparent}
  .eml-transport-visual>*{max-width:100%;height:auto}
  .eml-transport-shot{position:relative;width:100%;padding:32px 18px;border-radius:22px;isolation:isolate;aspect-ratio:auto}
  .eml-bento-shot-stage--confirm{background:linear-gradient(180deg,#fdefb8 0%,#fdf7dd 45%,#f5f6f9 100%)}
  .eml-bento-shot-stage--embed{background:linear-gradient(180deg,#cdf3de 0%,#e6f8ee 45%,#f5f6f9 100%)}
  .eml-bento-shot-stage--invite{background:linear-gradient(180deg,#dbe1fb 0%,#eceffd 45%,#f5f6f9 100%)}
  .eml-bento-shot-stage--events{background:linear-gradient(180deg,#fbdde4 0%,#fdecf0 45%,#f5f6f9 100%)}
  .eml-product-shot{display:block;width:100%;height:auto;object-fit:initial;object-position:initial;border:1px solid #dfe4ec;border-radius:14px;box-shadow:none;animation:eml-product-shot-breathe 7s ease-in-out infinite;will-change:transform}
  .eml-transport-row:nth-child(even) .eml-product-shot{animation-delay:-3.5s}
  .eml-shot-float{position:absolute;z-index:2;display:flex;align-items:center;flex-direction:row;gap:9px;padding:11px 14px;border:1px solid rgba(206,215,232,.9);border-radius:12px;background:rgba(255,255,255,.96);color:#111827;box-shadow:0 14px 34px rgba(30,45,88,.2);font-family:var(--font-body);line-height:1.15;animation:eml-shot-card-float 4.8s ease-in-out infinite;backdrop-filter:blur(10px)}
  .eml-shot-float b{font-size:.78rem;font-weight:700;white-space:nowrap;color:#111827}
  .eml-shot-float small{display:block;color:#7b8497;font-size:.65rem;white-space:nowrap}
  .eml-shot-float i{width:9px;height:9px;margin:0;border-radius:50%;background:#19b874;box-shadow:0 0 0 5px rgba(25,184,116,.13)}
  .eml-shot-float--top{top:12px;right:3px;left:auto;align-items:flex-start;flex-direction:column;gap:3px}
  .eml-shot-float--bottom{right:auto;bottom:12px;left:3px;animation-delay:-2.4s}
  .eml-bento-shot-stage--invite .eml-shot-float--top,.eml-bento-shot-stage--events .eml-shot-float--top{animation-delay:-1.2s}
  .eml-transport-visual:hover .eml-product-shot{animation-play-state:paused;transform:scale(1.018)}
  .eml-bento-cross{position:absolute;bottom:0;left:50%;width:28px;height:28px;transform:translate(-50%,50%);pointer-events:none;line-height:0;z-index:2;color:inherit;background:transparent;border-radius:0;font-size:inherit}
  .eml-transport-row:last-child .eml-bento-cross{display:none}
  .eml-transport-eyebrow{display:block;margin-bottom:1rem;color:#5b21b6;font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
  .eml-transport-copy h3{margin:0 0 1.25rem;font-family:var(--font-heading);font-size:2.25rem;font-weight:500;line-height:1.02;letter-spacing:-.02em;color:#111827}
  .eml-transport-copy p{max-width:none;margin:0 0 1rem;font-size:1.125rem;line-height:1.45;color:#4b5563}
  .eml-transport-copy p:last-child{margin-bottom:0}
  @media (prefers-reduced-motion:reduce){.eml-product-shot,.eml-shot-float{animation:none;will-change:auto}.eml-transport-visual:hover .eml-product-shot{transform:none}}
  @media (max-width:900px){.eml-transport-row{display:flex;flex-direction:column}.eml-transport-cell{padding:3rem 1.5rem}.eml-transport-row .eml-transport-cell:first-child{border-right:0}.eml-transport-copy{order:1;border-bottom:1px solid #e5e7eb}.eml-transport-visual{order:2}}
  @media (max-width:767px){.eml-transport{padding:58px 20px}.eml-transport-header{margin-bottom:40px}.eml-transport-cell{padding:3rem 1.5rem}.eml-transport-shot{padding:24px 12px}}

