<script>
  const emlFaqItems = Array.from(document.querySelectorAll('[data-eml-faq]'));
  emlFaqItems.forEach((item) => item.addEventListener('toggle', () => {
    if (!(item instanceof HTMLDetailsElement) || !item.open) return;
    emlFaqItems.forEach((other) => { if (other !== item && other instanceof HTMLDetailsElement) other.open = false; });
  }));
  const emlPolicyItems = Array.from(document.querySelectorAll('[data-eml-policy]'));
  emlPolicyItems.forEach((item) => {
    if (!(item instanceof HTMLDetailsElement)) return;
    const summary = item.querySelector('summary');
    const trigger = item.querySelector('.eml-policy-arrow');
    summary?.addEventListener('click', (event) => {
      event.preventDefault();
      item.open = !item.open;
    });
    item.addEventListener('toggle', () => {
      trigger?.setAttribute('aria-expanded', String(item.open));
      trigger?.setAttribute('aria-label', `${item.open ? 'Collapse' : 'Expand'} suppression policy`);
      if (!item.open) return;
      emlPolicyItems.forEach((other) => {
        if (other !== item && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
  const emlUsecaseTabs = Array.from(document.querySelectorAll('[data-eml-usecase-tab]'));
  const emlUsecasePanels = Array.from(document.querySelectorAll('[data-eml-usecase-panel]'));
  const activateUsecase = (tab) => {
    const target = tab.getAttribute('data-eml-usecase-tab');
    emlUsecaseTabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.setAttribute('tabindex', active ? '0' : '-1');
    });
    emlUsecasePanels.forEach((panel) => {
      const active = panel.getAttribute('data-eml-usecase-panel') === target;
      panel.classList.toggle('is-active', active);
      if (panel instanceof HTMLElement) panel.hidden = !active;
    });
  };
  emlUsecaseTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateUsecase(tab));
    tab.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const last = emlUsecaseTabs.length - 1;
      const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? last : event.key === 'ArrowRight' ? (index + 1) % emlUsecaseTabs.length : (index - 1 + emlUsecaseTabs.length) % emlUsecaseTabs.length;
      const next = emlUsecaseTabs[nextIndex];
      if (next instanceof HTMLButtonElement) { activateUsecase(next); next.focus(); }
    });
  });
</script>

