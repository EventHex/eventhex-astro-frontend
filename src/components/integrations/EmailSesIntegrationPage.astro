---
interface Faq { question: string; answer: string }
interface Props { faqs: Faq[] }
const { faqs } = Astro.props;

const useCases = [
  { index: '01', title: 'Event agencies', copy: 'Create a recognizable sender for each client workflow and event portfolio.' },
  { index: '02', title: 'Associations', copy: 'Reuse a verified sender across recurring member campaigns while keeping transactional mail separate.' },
  { index: '03', title: 'Conferences', copy: 'Connect registration-aware audiences to a sender that has completed readiness checks.' },
  { index: '04', title: 'Exhibitions', copy: 'Send exhibitor and visitor campaigns from the organization identity used for the programme.' },
];

const connected = [
  ['Event Marketing', 'Build targeted email and WhatsApp campaigns from EventHex audience data.', '/event-marketing/'],
  ['Event Notifications', 'Orchestrate operational reminders and delivery status across channels.', '/event-notifications/'],
  ['Event Registration', 'Collect the attendee data used by transactional and campaign messages.', '/event-registration/'],
  ['WhatsApp Integration', 'Connect the account and approved template behind WhatsApp delivery.', '/whatsapp-event-concierge/'],
];
---

<div class="eml-page">
  <section class="eml-hero" id="hero">
    <div class="eml-hero__grid">
      <div class="eml-hero__content animate-on-scroll" data-animation="fadeInUp">
        <span class="eml-hero__badge">AWS SES email integration</span>
        <h1>Set up a verified sender for event email campaigns</h1>
        <p>Create a dedicated sending subdomain, let EventHex provision and verify the SES identity, set the from name and reply-to address, and review delivery events without mixing marketing with transactional email.</p>
        <div class="eml-hero__cta-row">
          <a href="/book-a-demo/" class="eml-btn">Book a Demo <span aria-hidden="true">→</span></a>
          <a href="#eml-choice" class="eml-btn eml-btn--outline">See sender setup</a>
        </div>
        <div class="eml-hero__trust"><span>Managed SES identity</span><span>Readiness checks</span></div>
      </div>
      <div class="eml-hero__visual animate-on-scroll" data-animation="fadeInRight"><div class="eml-hero__visual-card"><div class="eml-hero__visual-inner">
        <img class="eml-app-screenshot eml-app-screenshot--hero" src="/images/integrations/email/integration-overview-web-806.webp" alt="EventHex app integrations screen showing Marketing Email active" width="806" height="696" loading="eager" decoding="async" />
      </div></div></div>
    </div>
  </section>

  <section class="eml-rail" aria-label="From subdomain choice to delivery feedback"><div class="eml-rail__inner"><span><b>Choose</b> Sending subdomain</span><span><b>Verify</b> SES identity and DNS</span><span><b>Brand</b> From name and reply-to</span><span><b>Review</b> Delivery events</span></div></section>

  <section class="eml-flow" id="eml-choice">
    <div class="eml-section-head"><h2>Keep marketing email on its own <em>verified identity</em></h2><p>Separate the messages that operate your event from the campaigns that represent your organization.</p></div>
    <div class="eml-flow-quad">
      <article class="eml-flow-quad__cell"><span>Transactional email</span><h3>Keep the operational path dependable</h3><p>Use the platform's operational path for supported OTP, registration, ticket, approval, and certificate messages.</p></article>
      <div class="eml-flow-quad__cell eml-flow-quad__cell--media"><div class="eml-flow-composite" role="img" aria-label="Transactional event email path"><img class="eml-flow-screenshot" src="/images/event-notifications/app/email-notification-log.png" alt="EventHex notification log showing delivered transactional messages" width="960" height="540" loading="lazy" decoding="async" /><span class="eml-flow-status">✓ Operational path</span></div></div>
      <div class="eml-flow-quad__cell eml-flow-quad__cell--media"><div class="eml-flow-composite" role="img" aria-label="Marketing email sender identity"><img class="eml-flow-screenshot" src="/images/integrations/email/marketing-email-settings-crop-web-920.webp" alt="EventHex Marketing Email settings showing a verified campaign sender" width="920" height="698" loading="lazy" decoding="async" /><span class="eml-flow-status">✓ Verified sender</span></div></div>
      <article class="eml-flow-quad__cell"><span>Marketing email</span><h3>Give campaigns their own identity</h3><p>Use the organization's dedicated verified sender for campaigns and apply marketing suppression and unsubscribe handling.</p></article>
      <span class="eml-flow-cross" aria-hidden="true">✦</span>
    </div>
  </section>


  <section class="eml-workflow" id="setup"><div class="eml-workflow-container"><div class="eml-workflow-left"><div class="eml-workflow-sticky"><span class="eml-workflow-eyebrow">✦ Zero-touch provisioning workflow</span><h2>Choose the label; EventHex handles the <em>infrastructure sequence</em></h2><p>One managed flow takes a sending subdomain from selection to a tenant-associated identity.</p><a class="eml-workflow-cta" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a></div></div><div class="eml-workflow-right">
    <article class="eml-workflow-card"><div class="eml-workflow-card__header"><div class="eml-workflow-number">01</div><div><h3>Choose a sending subdomain</h3><p>Select the organization label used under the EventHex-managed sending root.</p></div></div><div class="eml-workflow-visual eml-workflow-visual--identity"><img src="/images/integrations/email/marketing-email-settings-web-806.webp" alt="EventHex marketing email settings for choosing an organization sending identity" width="806" height="696" loading="lazy" decoding="async" /><span class="eml-workflow-status">✓ Label selected</span></div></article>
    <article class="eml-workflow-card"><div class="eml-workflow-card__header"><div class="eml-workflow-number">02</div><div><h3>Create the SES identity</h3><p>EventHex creates or reuses the sending identity and records the sender address.</p></div></div><div class="eml-workflow-visual eml-workflow-visual--analytics"><img src="/images/integrations/email/app-platform-analytics-web-960.webp" alt="EventHex platform analytics workspace showing organization event data" width="960" height="540" loading="lazy" decoding="async" /><span class="eml-workflow-status">✓ Identity created</span></div></article>
    <article class="eml-workflow-card"><div class="eml-workflow-card__header"><div class="eml-workflow-number">03</div><div><h3>Publish DNS records</h3><p>Provision the required DKIM and MAIL FROM records for verification.</p></div></div><div class="eml-workflow-visual eml-workflow-visual--notifications"><img src="/images/integrations/email/app-platform-notifications-web-960.webp" alt="EventHex platform notifications workspace for verification updates" width="960" height="540" loading="lazy" decoding="async" /><span class="eml-workflow-status">✓ Verification updates</span></div></article>
    <article class="eml-workflow-card"><div class="eml-workflow-card__header"><div class="eml-workflow-number">04</div><div><h3>Associate the tenant</h3><p>Connect the identity and configuration set before the sender is marked ready.</p></div></div><div class="eml-workflow-visual eml-workflow-visual--whatsapp"><img src="/images/integrations/email/app-whatsapp-concierge-web-960.webp" alt="EventHex WhatsApp concierge workspace connected to an event organization" width="960" height="540" loading="lazy" decoding="async" /><span class="eml-workflow-status">✓ Tenant connected</span></div></article>
  </div></div></section>


  <section class="eml-readiness" id="readiness">
    <div class="eml-readiness__header">
      <div class="eml-readiness__eyebrow"><span aria-hidden="true">✦</span><span>Connection readiness</span></div>
      <h2>Know whether the sender is <em>ready,<br class="eml-readiness__break" /> waiting, paused, or needs repair</em></h2>
    </div>
    <div class="eml-readiness__cards">
      <article class="eml-readiness__card" style="--card-index: 0">
        <div class="eml-readiness__copy">
          <span class="eml-readiness__label">Verify the connection</span>
          <h3>See the organization sender at a glance.</h3>
          <p>Confirm which integrations are active before a campaign leaves EventHex. Marketing Email stays separate from the operational email path.</p>
          <a href="/book-a-demo/" class="eml-readiness__btn">Explore sender setup <span aria-hidden="true">→</span></a>
        </div>
        <figure class="eml-readiness__media">
          <img src="/images/integrations/email/integration-overview-web-806.webp" alt="EventHex integrations overview showing Marketing Email active alongside other organization connections" width="806" height="696" loading="lazy" decoding="async" />
        </figure>
      </article>
      <article class="eml-readiness__card" style="--card-index: 1">
        <div class="eml-readiness__copy">
          <span class="eml-readiness__label">Ready to send</span>
          <h3>Set the from name and reply-to your audience recognizes.</h3>
          <p>Once the dedicated domain is active, keep the sender defaults visible and editable for the team running event campaigns.</p>
          <a href="/book-a-demo/" class="eml-readiness__btn">Review sender defaults <span aria-hidden="true">→</span></a>
        </div>
        <figure class="eml-readiness__media">
          <img src="/images/integrations/email/marketing-email-settings-web-806.webp" alt="EventHex Marketing Email settings showing an active sender, from name and reply-to fields" width="806" height="696" loading="lazy" decoding="async" />
        </figure>
      </article>
      <div class="eml-readiness__spacer" aria-hidden="true"></div>
    </div>
  </section>

  <section class="eml-transport" id="delivery-path">
    <div class="eml-transport-container">
      <header class="eml-transport-header animate-on-scroll" data-animation="fadeInUp">
        <h2>Keep the Campaign Tied to the <em>Verified Organization Sender</em></h2>
      </header>

      <div class="eml-transport-bento animate-on-scroll" data-animation="fadeInUp">
        <span class="eml-bento-notch eml-bento-notch--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg>
        </span>
        <span class="eml-bento-notch eml-bento-notch--bottom" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg>
        </span>

        <article class="eml-transport-row">
          <div class="eml-transport-cell eml-transport-visual">
            <div class="eml-transport-shot eml-bento-shot-stage--confirm">
              <img class="eml-product-shot" src="/images/integrations/email/marketing-email-settings-web-806.webp" alt="EventHex Marketing Email settings showing the active organization sender and reply-to address" width="806" height="696" loading="lazy" decoding="async" />
              <span class="eml-shot-float eml-shot-float--top"><b>✓ Sender verified</b><small>Organization identity</small></span>
              <span class="eml-shot-float eml-shot-float--bottom"><i></i><b>Ready to send</b></span>
            </div>
          </div>
          <div class="eml-transport-cell eml-transport-copy">
            <span class="eml-transport-eyebrow">Verified source</span>
            <h3>Send from the Organization Identity</h3>
            <p>Use the dedicated sender only when its identity and tenant association are ready, so every delivery event stays attached to the right event workspace.</p>
          </div>
          <span class="eml-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>
        </article>

        <article class="eml-transport-row eml-transport-row--reverse">
          <div class="eml-transport-cell eml-transport-copy">
            <span class="eml-transport-eyebrow">Message context</span>
            <h3>Keep Reply Handling and Headers Intact</h3>
            <p>Apply the configured reply-to address and the MIME/SES path when attachments, unsubscribe headers, or tenant attribution are required.</p>
          </div>
          <div class="eml-transport-cell eml-transport-visual">
            <div class="eml-transport-shot eml-bento-shot-stage--embed">
              <img class="eml-product-shot" src="/images/integrations/email/integration-overview-crop-web-920.webp" alt="EventHex integrations overview showing the organization email connection" width="920" height="698" loading="lazy" decoding="async" />
              <span class="eml-shot-float eml-shot-float--top"><b>Reply-to preserved</b><small>Headers stay attached</small></span>
              <span class="eml-shot-float eml-shot-float--bottom"><i></i><b>Event-aware message</b></span>
            </div>
          </div>
          <span class="eml-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>
        </article>

        <article class="eml-transport-row">
          <div class="eml-transport-cell eml-transport-visual">
            <div class="eml-transport-shot eml-bento-shot-stage--invite">
              <img class="eml-product-shot" src="/images/integrations/email/app-platform-notifications-web-960.webp" alt="EventHex notification workspace showing organization-aware delivery messages" width="960" height="540" loading="lazy" decoding="async" />
              <span class="eml-shot-float eml-shot-float--top"><b>✓ No identity leak</b><small>Tenant sender enforced</small></span>
              <span class="eml-shot-float eml-shot-float--bottom"><i></i><b>Operational path separate</b></span>
            </div>
          </div>
          <div class="eml-transport-cell eml-transport-copy">
            <span class="eml-transport-eyebrow">Safe separation</span>
            <h3>Never Fall Back to Platform SMTP</h3>
            <p>Marketing campaigns stay on the verified organization sender instead of leaking a platform account into tenant communications.</p>
          </div>
          <span class="eml-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>
        </article>

        <article class="eml-transport-row eml-transport-row--reverse">
          <div class="eml-transport-cell eml-transport-copy">
            <span class="eml-transport-eyebrow">Delivery feedback</span>
            <h3>Record the Outcome Against the Message</h3>
            <p>Keep accepted, delivered, bounce, complaint, delay, and rendering events connected to the original campaign and recipient context.</p>
          </div>
          <div class="eml-transport-cell eml-transport-visual">
            <div class="eml-transport-shot eml-bento-shot-stage--events">
              <img class="eml-product-shot" src="/images/event-notifications/app/email-notification-log.png" alt="EventHex email notification log showing message delivery outcomes" width="1280" height="720" loading="lazy" decoding="async" />
              <span class="eml-shot-float eml-shot-float--top"><b>✓ Event recorded</b><small>Message context retained</small></span>
              <span class="eml-shot-float eml-shot-float--bottom"><i></i><b>Delivery status available</b></span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="eml-suppression" aria-labelledby="eml-suppression-title">
    <div class="eml-suppression-inner">
      <header class="eml-suppression-head">
        <h2 id="eml-suppression-title">Apply different suppression decisions to critical, transactional, and marketing email</h2>
      </header>
      <ol class="eml-policy-list">
        <li>
          <details data-eml-policy open>
            <summary tabindex="-1">
              <span>01</span>
              <div class="eml-policy-content">
                <h3>Critical</h3>
                <p>OTP and password-reset types are not blocked by the EventHex suppression list; the provider still handles invalid delivery.</p>
                <ul class="eml-policy-bullets">
                  <li><i aria-hidden="true">✦</i> OTP and password resets</li>
                  <li><i aria-hidden="true">✦</i> EventHex suppression bypass</li>
                  <li><i aria-hidden="true">✦</i> Provider delivery checks remain active</li>
                </ul>
              </div>
              <button type="button" class="eml-policy-arrow" aria-label="Collapse critical suppression policy" aria-expanded="true">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
              </button>
            </summary>
            <figure class="eml-policy-visual"><img src="/images/integrations/email/app-platform-notifications-web-960.webp" alt="EventHex operational notifications list used for critical messages" width="960" height="540" loading="lazy" decoding="async" /></figure>
          </details>
        </li>
        <li>
          <details data-eml-policy>
            <summary tabindex="-1">
              <span>02</span>
              <div class="eml-policy-content">
                <h3>Transactional</h3>
                <p>Suppress verified permanent hard bounces while allowing the operational policy for other reasons.</p>
                <ul class="eml-policy-bullets">
                  <li><i aria-hidden="true">✦</i> Permanent hard bounces suppressed</li>
                  <li><i aria-hidden="true">✦</i> Other reasons follow operational policy</li>
                  <li><i aria-hidden="true">✦</i> Transactional purpose stays distinct</li>
                </ul>
              </div>
              <button type="button" class="eml-policy-arrow" aria-label="Expand transactional suppression policy" aria-expanded="false">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
              </button>
            </summary>
            <figure class="eml-policy-visual"><img src="/images/event-notifications/app/email-notification-log.png" alt="EventHex email delivery event log used for transactional message review" width="1280" height="720" loading="lazy" decoding="async" /></figure>
          </details>
        </li>
        <li>
          <details data-eml-policy>
            <summary tabindex="-1">
              <span>03</span>
              <div class="eml-policy-content">
                <h3>Marketing</h3>
                <p>Suppress active bounce, complaint, unsubscribe, or manual records before campaign sending.</p>
                <ul class="eml-policy-bullets">
                  <li><i aria-hidden="true">✦</i> Bounce and complaint controls</li>
                  <li><i aria-hidden="true">✦</i> Unsubscribe records respected</li>
                  <li><i aria-hidden="true">✦</i> Manual suppression before sending</li>
                </ul>
              </div>
              <button type="button" class="eml-policy-arrow" aria-label="Expand marketing suppression policy" aria-expanded="false">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
              </button>
            </summary>
            <figure class="eml-policy-visual"><img src="/images/integrations/email/marketing-email-settings-web-806.webp" alt="EventHex Marketing Email sender settings used for campaign suppression decisions" width="806" height="696" loading="lazy" decoding="async" /></figure>
          </details>
        </li>
      </ol>
      <p class="eml-note">Suppression rules reduce harmful sends; they do not guarantee inbox placement.</p>
    </div>
  </section>
  <section class="eml-usecases" aria-labelledby="eml-usecases-title"><div class="eml-usecases-inner"><header class="eml-usecases-head"><h2 id="eml-usecases-title">Give every event portfolio a clearer <em>campaign identity</em></h2><p>Choose the sender setup that fits the way your organization communicates.</p></header><div class="eml-usecase-tabs" role="tablist" aria-label="Email sender use cases">{useCases.map((item, i) => <button type="button" class:list={["eml-usecase-tab", i === 0 && "is-active"]} role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`eml-usecase-panel-${i}`} id={`eml-usecase-tab-${i}`} tabindex={i === 0 ? 0 : -1} data-eml-usecase-tab={i}>{item.title}</button>)}</div><div class="eml-usecase-panels">{useCases.map((item, i) => <article class:list={["eml-usecase-panel", i === 0 && "is-active"]} role="tabpanel" id={`eml-usecase-panel-${i}`} aria-labelledby={`eml-usecase-tab-${i}`} data-eml-usecase-panel={i} hidden={i !== 0}><div class="eml-usecase-copy"><span class="eml-usecase-index">{item.index}</span><h3>{item.title}</h3><p>{item.copy}</p><div class="eml-usecase-replaces"><span>WORKS WITH</span><b>Email</b><b>WhatsApp</b><b>Notifications</b></div><ul><li>Dedicated organization sender</li><li>Tenant-aware delivery context</li><li>Clear campaign ownership</li></ul></div><div class="eml-usecase-showcase">{i === 0 && <img class="eml-usecase-screenshot" src="/images/integrations/email/marketing-email-settings-web-806.webp" alt="EventHex Marketing Email settings with the organization sender active for an event agency" width="806" height="696" loading="lazy" decoding="async" />}{i === 1 && <img class="eml-usecase-screenshot" src="/images/integrations/email/app-platform-analytics-web-960.webp" alt="EventHex event analytics workspace used alongside recurring association campaigns" width="960" height="540" loading="lazy" decoding="async" />}{i === 2 && <img class="eml-usecase-screenshot" src="/images/integrations/email/app-platform-notifications-web-960.webp" alt="EventHex notifications workspace showing conference communication activity" width="960" height="540" loading="lazy" decoding="async" />}{i === 3 && <img class="eml-usecase-screenshot" src="/images/integrations/email/app-whatsapp-concierge-web-960.webp" alt="EventHex communications workspace used for exhibition visitor messaging" width="960" height="540" loading="lazy" decoding="async" />}<span class="eml-suite-label">✓ Verified sender</span></div></article>)}</div></div></section>

  <section class="eml-boundary" aria-labelledby="eml-boundary-title">
    <div class="eml-boundary__header"><span class="eml-eyebrow">Keep the promise accurate</span><h2 id="eml-boundary-title">Sender infrastructure here; campaign strategy on <span>Event Marketing</span></h2></div>
    <div class="eml-boundary__quad">
      <article class="eml-boundary__cell eml-boundary__copy"><span>THIS INTEGRATION</span><h3>Provision and readiness</h3><p>Subdomain, SES identity, DNS, tenant association, readiness, sender defaults, delivery events, and suppression.</p></article>
      <div class="eml-boundary__cell eml-boundary__media"><div class="eml-boundary__visual eml-boundary__visual--identity"><img class="eml-boundary-screenshot" src="/images/integrations/email/integration-overview-crop-web-920.webp" alt="EventHex sender readiness and integration status" width="920" height="698" loading="lazy" decoding="async" /><span>✓ Identity verified</span></div></div>
      <div class="eml-boundary__cell eml-boundary__media"><div class="eml-boundary__visual eml-boundary__visual--campaign"><img class="eml-boundary-screenshot" src="/images/integrations/email/marketing-email-settings-crop-web-920.webp" alt="EventHex Event Marketing campaign sender setup" width="920" height="698" loading="lazy" decoding="async" /><span>↗ Explore campaign tools</span></div></div>
      <article class="eml-boundary__cell eml-boundary__copy"><span>EVENT MARKETING</span><h3>Audience and campaign operation</h3><p>Audience building, campaign content, scheduling, recipient workflow, and campaign performance review.</p><a href="/event-marketing/">Explore Event Marketing →</a></article>
      <span class="eml-boundary__cross" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)"></path></svg></span>
    </div>
  </section>
  <section class="eml-connected" aria-labelledby="eml-connected-title">
    <div class="eml-connected__heading">
