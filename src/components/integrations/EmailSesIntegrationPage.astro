  @keyframes eml-boundary-breathe{0%,100%{transform:translateY(4px) scale(.985) rotate(-.7deg)}50%{transform:translateY(-4px) scale(1) rotate(0)}}@keyframes eml-boundary-pulse{0%,100%{transform:scale(.96);opacity:.4}50%{transform:scale(1.04);opacity:.9}}
