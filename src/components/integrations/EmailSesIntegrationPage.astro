;justify-content:center;align-items:center;overflow:hidden}.eml-workflow-card:nth-child(1) .eml-workflow-visual{background:linear-gradient(180deg,#fff9dc 0%,#fffdf1 48%,#fff 100%)}.eml-workflow-card:nth-child(2) .eml-workflow-visual{background:linear-gradient(180deg,#e9f9f0 0%,#f5fcf8 48%,#fff 100%)}.eml-workflow-card:nth-child(3) .eml-workflow-visual{background:linear-gradient(180deg,#eef1ff 0%,#f8f9ff 48%,#fff 100%)}.eml-workflow-card:nth-child(4) .eml-workflow-visual{background:linear-gradient(180deg,#fdeff3 0%,#fff8fa 48%,#fff 100%)}.eml-workflow-visual img{max-width:100%;width:100%;max-height:280px;height:auto;border-radius:12px;object-fit:contain}.eml-workflow-status{position:absolute;top:34px;left:34px;padding:10px 13px;border-radius:10px;background:rgba(255,255,255,.96);border:1px solid #cfead9;color:#18864b;font-size:.75rem;font-weight:700;box-shadow:0 12px 26px rgba(30,45,88,.14)}@media (max-width:1024px){.eml-workflow-container{gap:44px}}@media (max-width:900px){.eml-workflow-container{display:block}.eml-workflow-left{margin-bottom:48px}.eml-workflow-sticky{position:static}.eml-workflow-card{position:relative!important;top:auto!important}.eml-workflow{padding:72px 24px}}@media (max-width:767px){.eml-workflow{padding:58px 20px}.eml-workflow-card{padding:24px;border-radius:20px}.eml-workflow-card__header{gap:12px}.eml-workflow-visual{padding:18px}.eml-workflow-sticky h2{font-size:36px}}
