  /* Match Event Registration section-heading scale, weight, and tracking. */
  .eml-section-head h2,
  .eml-spotlight h2,
  .eml-final-cta h2 {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  /* Registration dark-band heading treatment for the dark CTA. */
  .eml-final-cta h2 {
    background: linear-gradient(100deg, #ffffff 0%, #f2f0ff 26%, #c9c2ff 52%, #a79aff 74%, #7d8dff 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .eml-final-cta h2 em {
    color: inherit;
  }
  /* Connected destinations mirror the registration page's quiet,
     border-led use-case grid. */
  .eml-connected {
    width: 100%;
    max-width: none;
    padding: clamp(58px, 7vw, 92px) 24px clamp(78px, 9vw, 116px);
    background: linear-gradient(135deg, #f8faff 0%, #f1f4ff 52%, #f8fbff 100%);
  }
  .eml-connected .eml-section-head {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px clamp(26px, 3vw, 38px);
  }
  .eml-connected .eml-section-head h2 {
    max-width: none;
    margin: 0 auto;
    font-size: clamp(2.35rem, 4.6vw, 4rem);
    font-weight: 500;
  }
  .eml-connected-grid {
    max-width: 1180px;
    margin: 0 auto;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .eml-connected-grid a {
    min-height: 300px;
    padding: 38px 28px 30px;
    border: 0;
    border-left: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .eml-connected-grid a:first-child { border-left: 0; }
  .eml-connected-grid a:hover,
  .eml-connected-grid a:focus-visible {
    transform: none;
    box-shadow: none;
    background: rgba(255,255,255,.28);
  }
  .eml-connected-grid a > span {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    color: var(--blue);
    font-size: 1.55rem;
    line-height: 1;
  }
  .eml-connected-grid h3 {
    max-width: 230px;
    min-height: 2.3em;
    margin: 0 0 14px;
    font-size: 1.32rem;
    font-weight: 500;
    line-height: 1.15;
  }
  .eml-connected-grid p {
    min-height: 0;
    margin: 0;
    color: var(--muted);
    font-size: .96rem;
    line-height: 1.45;
  }
  .eml-connected-grid b {
    margin-top: auto;
    padding-top: 28px;
    font-size: .9rem;
  }
  @media (max-width: 960px) {
    .eml-connected-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eml-connected-grid a:nth-child(odd) { border-left: 0; }
    .eml-connected-grid a:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 767px) {
    .eml-connected { padding: 58px 16px 72px; }
    .eml-connected .eml-section-head { padding-inline: 0; }
    .eml-connected-grid { grid-template-columns: 1fr; }
    .eml-connected-grid a,
    .eml-connected-grid a:nth-child(n + 3) { border-left: 0; border-top: 1px solid var(--line); }
    .eml-connected-grid a:first-child { border-top: 0; }
    .eml-connected-grid a { min-height: 0; padding: 30px 4px; }
  }
