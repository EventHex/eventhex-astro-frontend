  .pni-token-card__visual { padding: 18px; border: 1px solid rgba(255,255,255,.86); border-radius: 20px; overflow: hidden; }
  .pni-token-card__visual--1 { background: linear-gradient(180deg,#fff9dc 0%,#fffdf1 48%,#fff 100%); }
