  <script>
    const caseSuite = document.querySelector('.pni-case-suites');
    if (caseSuite) {
      const caseTabs = Array.from(caseSuite.querySelectorAll('.pni-case__tab'));
      const casePanels = Array.from(caseSuite.querySelectorAll('.pni-case__panel'));
      const activateCase = (tab) => {
        const target = tab.getAttribute('data-target');
        caseTabs.forEach((item) => { item.classList.toggle('pni-case__tab--active', item === tab); item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });
        casePanels.forEach((panel) => panel.classList.toggle('pni-case__panel--active', panel.getAttribute('data-panel') === target));
      };
      caseTabs.forEach((tab) => tab.addEventListener('click', () => activateCase(tab)));
    }
    const faqItems = document.querySelectorAll('.pni-faq details');
    faqItems.forEach((item) => item.addEventListener('toggle', () => { if (item.open) faqItems.forEach((other) => { if (other !== item) other.removeAttribute('open'); }); }));
    const deliverySteps = document.querySelectorAll('.pni-delivery-steps details');
    deliverySteps.forEach((item) => {
      const summary = item.querySelector('summary');
      const trigger = item.querySelector('.pni-delivery-workflow__arrow');
      summary?.addEventListener('click', (event) => { event.preventDefault(); item.open = !item.open; });
      item.addEventListener('toggle', () => {
        trigger?.setAttribute('aria-expanded', String(item.open));
        if (!item.open) return;
        deliverySteps.forEach((other) => { if (other !== item) other.removeAttribute('open'); });
      });
    });
  </script>
</MarketingLayout>

