---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  faqs: [string, string][];
  faqSchema: Record<string, unknown>;
  softwareSchema: Record<string, unknown>;
}

const { title, description, canonical, faqs, faqSchema, softwareSchema } = Astro.props;

const lifecycle = [
  ["01", "Configure", "Service account"], ["02", "Register", "Device token"], ["03", "Respect", "User preference"],
  ["04", "Target", "One or many tokens"], ["05", "Send", "FCM payload"], ["06", "Review", "Success or failure"],
];
const scopes = [
  ["Event", "Associate the service-account configuration with a specific event.", "Event scope"],
  ["Organization", "Associate a configuration with the franchise or organization.", "Portfolio scope"],
  ["Global", "Maintain a platform-level configuration where the environment uses it.", "Platform scope"],
];
const credentials = [
  ["Project identity", "Project ID, configuration name, optional bundle ID, and active state."],
  ["Service account", "Private key ID, private key, client email, and client ID."],
  ["Google endpoints", "Authentication, token, certificate, and optional database URLs."],
  ["Safe responses", "Return masked or omitted secret values when the configuration is read back."],
];
const credentialIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M12 18h.01"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 7v5c0 4.6 3.4 7.8 8 9 4.6-1.2 8-4.4 8-9V7l-8-4Z"></path><path d="m9 12 2 2 4-4"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>',
];
const tokenSteps = [
  ["App obtains a token", "The attendee app receives the FCM token for the device."],
  ["EventHex registers it", "Store the token with device type, active state, and last-used time."],
  ["Refresh or reuse", "Update the existing record when the same token is registered again."],
  ["Unregister when needed", "Remove a token when the app or attendee signs out of the delivery path."],
];
const deliverySteps = [
  { title: "Notification", desc: "Send a title, body, and an optional absolute image URL.", image: "/images/event-notifications/app/push-active-devices.webp", alt: "Active attendee devices ready to receive a push notification" },
  { title: "Data payload", desc: "Attach supported navigation and event data alongside the visible message.", image: "/images/event-notifications/app/push-resolve-recipients.webp", alt: "EventHex resolving recipients for a supported push payload" },
  { title: "Android", desc: "Use the configured high-priority channel and default sound payload.", image: "/images/event-notifications/app/push-job-result.webp", alt: "Android push job result in EventHex" },
  { title: "Apple devices", desc: "Use the APNs payload with sound and badge values.", image: "/images/event-notifications/app/push-delivery-response.webp", alt: "Apple push delivery response in EventHex" },
];
const messageTypes = [
  ["User notification", "Open the notification area with the supported navigation payload."],
  ["General announcement", "Send a title and body as an app announcement."],
  ["New message", "Notify a user that a supported in-app message is waiting."],
  ["Reminder", "Use the applicable event workflow to create the notification content."],
  ["One or many attendees", "Send to active tokens stored for one user, one registration, or selected attendees."],
];
const buyerScenarios = [
  ["Conferences", "Support app announcements and attendee messages where the event app is deployed."],
  ["Exhibitions", "Reach selected registered users through their active app tokens."],
  ["Corporate events", "Use organization or event configuration according to the branded-app environment."],
  ["Event agencies", "Validate each client app's Firebase project, credentials, bundle, and token lifecycle before launch."],
];
const useCaseTabs = [
  { id: "conference", label: "Conferences", title: "Keep attendee delivery on track", description: "Support app announcements and attendee messages where the event app is deployed.", checklist: ["Active device tokens", "Supported notification payloads", "Per-token delivery results"], image: "/images/event-notifications/app/push-active-devices.webp", imageAlt: "Active attendee devices ready for push delivery", visualLabel: "Active devices ready" },
  { id: "exhibition", label: "Exhibitions", title: "Reach the right registered users", description: "Reach selected registered users through their active app tokens without losing delivery addressability.", checklist: ["Target one attendee or many", "Respect push preferences", "Reuse refreshed device tokens"], image: "/images/event-notifications/app/push-resolve-recipients.webp", imageAlt: "EventHex resolving selected recipients for push delivery", visualLabel: "Recipients resolved" },
  { id: "corporate", label: "Corporate events", title: "Match delivery to the app model", description: "Use organization or event configuration according to the branded-app environment.", checklist: ["Event or organization scope", "iOS and Android payloads", "Safe configuration responses"], image: "/images/event-notifications/app/push-job-result.webp", imageAlt: "EventHex push job result for a branded event app", visualLabel: "Delivery job complete" },
  { id: "agency", label: "Event agencies", title: "Validate every client app before launch", description: "Validate each client app's Firebase project, credentials, bundle, and token lifecycle before launch.", checklist: ["Firebase project identity", "Credential and bundle checks", "Invalid-token cleanup"], image: "/images/event-notifications/app/push-delivery-response.webp", imageAlt: "EventHex delivery response showing per-token push results", visualLabel: "Response reviewed" }
];
const links = [
  ["Event Notifications", "Plan and operate attendee messages across the available channels.", "/event-notifications/"],
  ["Event Mobile App", "Give attendees the app experience that receives supported mobile notifications.", "/event-mobile-app/"],
  ["Event Gamification", "Connect engagement and reward moments to the attendee experience.", "/event-gamification/"],
  ["WhatsApp Integration", "Configure the account and approved templates behind WhatsApp delivery.", "/integrations/whatsapp/"],
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  showFooterCta={true}
  footerCtaEyebrow="Trusted Event Platform"
  footerCtaTitle="Bring your Firebase and event-app setup to the demo"
  footerCtaSubtitle="Show us the app build, Firebase project, configuration scope, device platforms, notification purposes, and consent model. We’ll map the supported EventHex token and delivery workflow with you."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageAlt="EventHex event platform on laptop, tablet, and mobile"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <main class="pni-page">
    <section class="pni-hero" aria-labelledby="pni-hero-title">
      <div class="pni-hero__copy">
        <span class="pni-eyebrow">Firebase integration for event apps</span>
        <h1 id="pni-hero-title">Connect Firebase push delivery to the attendee app experience</h1>
        <p>Store the service-account configuration used by your EventHex environment, register attendee device tokens, respect push preferences, and send supported notification payloads to iOS and Android devices.</p>
        <div class="pni-actions"><a class="pni-button pni-button--dark" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a><a class="pni-button pni-button--outline" href="#lifecycle">See the delivery path</a></div>
        <div class="pni-proof"><span>Event, organization, or global config</span><span>Active device tokens</span><span>iOS and Android payloads</span></div>
      </div>
      <figure class="pni-hero__visual">
        <img src="/images/event-notifications/app/push-platform-notifications.webp" alt="EventHex Platform Notifications screen showing notification cards and delivery management controls" width="1298" height="697" loading="eager" decoding="async" />
        <figcaption>Platform notifications for the attendee app</figcaption>
      </figure>
    </section>

    <section class="pni-rail" id="lifecycle" aria-label="From Firebase credentials to token result"><div class="pni-rail__inner">{lifecycle.map(([, label, detail]) => <span class="pni-rail__item"><b>{label}</b> {detail}</span>)}</div></section>

    <section class="pni-section pni-section--choice pni-scope-section" id="configuration">
      <div class="pni-heading pni-scope-heading">
        <h2>Store Firebase credentials where the deployment model needs them</h2>
      </div>
      <div class="pni-scope-bento">
        {scopes.map(([name, text, cue], i) => (
          <article class:list={["pni-scope-row", i % 2 === 1 && "pni-scope-row--reverse"]}>
              <div class:list={["pni-scope-cell", "pni-scope-visual", `pni-scope-visual--${i + 1}`]} role="img" aria-label={`${name} Firebase configuration scope visual`}>
              <div class="pni-scope-stage">
                <img class="pni-section-app-shot" src={`/images/event-notifications/app/${["push-active-devices.webp", "push-resolve-recipients.webp", "push-job-result.webp"][i]}`} alt={`EventHex Firebase ${name.toLowerCase()} configuration interface`} width="1298" height="697" loading="lazy" decoding="async" />
                <span class="pni-scope-float pni-scope-float--top"><b>{i === 0 ? "Event ready" : i === 1 ? "Org linked" : "Global active"}</b><small>Firebase scope</small></span>
                <span class="pni-scope-float pni-scope-float--bottom"><i></i><b>{cue}</b></span>
              </div>
            </div>
            <div class="pni-scope-cell pni-scope-content">
              <span class="pni-index">0{i + 1}</span>
              <span class="pni-scope-eyebrow">{cue}</span>
              <h3>{name}</h3>
              <p>{text}</p>
            </div>
            {i < scopes.length - 1 && <span class="pni-scope-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path></svg></span>}
          </article>
        ))}
      </div>
    </section>

    <section class="pni-credential-feature" id="credentials">
      <div class="pni-credential-feature__inner">
        <header class="pni-credential-feature__header">
          <h2>Use the service-account data required by Firebase Admin</h2>
        </header>
        <div class="pni-credential-feature__grid">
          {[25, 50, 75].map((left) => (
            <span class="pni-credential-feature__notch" style={`left: ${left}%`} aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
            </span>
          ))}
          {credentials.map(([label, text], index) => (
            <article class="pni-credential-feature__card">
              <span class="pni-credential-feature__icon" set:html={credentialIcons[index]}></span>
              <div class="pni-credential-feature__content">
                <h3>{label}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pni-section pni-token-redesign" id="tokens">
      <div class="pni-token-redesign__container">
        <div class="pni-token-redesign__left">
          <div class="pni-token-redesign__sticky">
            <span class="pni-token-redesign__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Attendee device registration</span>
            <h2>Keep the current device token attached to the right attendee</h2>
            <p>Show the mobile-to-API mechanism without losing the device state that makes delivery addressable.</p>
            <a class="pni-token-redesign__cta" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="pni-token-redesign__right">
          {tokenSteps.map(([title, text], i) => (
            <article class="pni-token-card">
              <div class="pni-token-card__header">
                <span class="pni-token-card__number">0{i + 1}</span>
                <div class="pni-token-card__text"><h3>{title}</h3><p>{text}</p></div>
              </div>
              <div class:list={["pni-token-card__visual", `pni-token-card__visual--${i + 1}`]}>
                <div class="pni-token-product-shot">
                  <img src={`/images/event-notifications/app/${["push-active-devices.webp", "push-resolve-recipients.webp", "push-job-result.webp", "push-delivery-response.webp"][i]}`} alt={`${title} in the EventHex attendee notification workflow`} loading="lazy" />
                  <span class:list={["pni-token-product-shot__status", i === 0 || i === 2 || i === 3 ? "pni-token-product-shot__status--success" : ""]}><span aria-hidden="true">✓</span>{["Token received", "Attendee linked", "Token refreshed", "Ready to deliver"][i]}</span>
                  <span class="pni-token-product-shot__action">{["Register token", "Attach attendee", "Refresh record", "Deliver safely"][i]}</span>
                  <svg class="pni-token-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pni-preference-spotlight" id="preference">
      <div class="pni-preference-spotlight__header">
        <span class="pni-eyebrow">Respect the attendee setting</span>
        <h2>Send only when push notifications are enabled for the user</h2>
        <p>The attendee still controls operating-system permission; the EventHex preference is one gate in the delivery path.</p>
      </div>
      <div class="pni-preference-quad">
        <article class="pni-preference-quad__cell pni-preference-quad__cell--copy">
          <h3>Push enabled</h3>
          <p>When the attendee has enabled push notifications, the device remains eligible for supported delivery.</p>
        </article>
        <div class="pni-preference-quad__cell pni-preference-quad__cell--media pni-preference-quad__cell--media-left">
          <div class="pni-preference-composite" role="img" aria-label="Push enabled preference state">
            <div class="pni-preference-screen pni-preference-screen--primary"><img class="pni-section-app-shot" src="/images/event-notifications/app/push-platform-notifications.webp" alt="EventHex notification management screen showing active delivery controls" width="1298" height="697" loading="lazy" decoding="async" /><b>ON · Eligible</b></div>
            <span class="pni-preference-status">✓ Eligible to deliver</span>
            <span class="pni-preference-action">Use active token</span>
          </div>
        </div>
        <div class="pni-preference-quad__cell pni-preference-quad__cell--media pni-preference-quad__cell--media-right">
          <div class="pni-preference-composite" role="img" aria-label="Push disabled preference state">
            <div class="pni-preference-screen pni-preference-screen--secondary"><img class="pni-section-app-shot" src="/images/event-notifications/app/push-platform-notifications.webp" alt="EventHex notification management screen used to respect attendee push preferences" width="1298" height="697" loading="lazy" decoding="async" /><b>OFF · Skip delivery</b></div>
            <span class="pni-preference-status">✓ Gate applied</span>
            <span class="pni-preference-action">Skip delivery</span>
          </div>
        </div>
        <article class="pni-preference-quad__cell pni-preference-quad__cell--copy pni-preference-quad__cell--copy-last">
          <h3>Push disabled</h3>
          <p>When the attendee turns push off, respect that preference before the provider send path runs.</p>
        </article>
        <span class="pni-preference-quad__cross" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path></svg></span>
      </div>
    </section>

    <section class="pni-delivery-workflow" id="delivery">
      <div class="pni-delivery-workflow__inner">
        <header class="pni-delivery-workflow__header">
          <h2>Format the supported push for Android and iOS delivery paths</h2>
        </header>
        <ol class="pni-delivery-steps">
          {deliverySteps.map((step, index) => (
            <li>
              <details open={index === 0}>
                <summary tabindex="-1">
                  <span>0{index + 1}</span>
                  <div class="pni-delivery-step__content">
                    <h3 class="pni-delivery-step__title">{step.title}</h3>
                    <p class="pni-delivery-step__desc">{step.desc}</p>
                  </div>
                  <button type="button" class="pni-delivery-workflow__arrow" aria-label={`${index === 0 ? "Collapse" : "Expand"} ${step.title}`} aria-expanded={index === 0 ? "true" : "false"}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                  </button>
                </summary>
                <div class="pni-delivery-workflow__visual"><img src={step.image} alt={step.alt} loading="lazy" decoding="async" /></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="pni-agenda-section" id="message-types">
      <div class="pni-agenda-section__inner">
        <header class="pni-agenda-section__header">
          <span class="pni-eyebrow">Where push can support the app</span>
          <h2>Use the delivery layer for supported in-app notification purposes</h2>
        </header>
        <div class="pni-agenda-grid">
          {messageTypes.map(([title, text], index) => (
            <article class="pni-agenda-card">
              {[1, 2, 4].includes(index) && <><span class="pni-agenda-petal pni-agenda-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span><span class="pni-agenda-petal pni-agenda-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span></>}
              <div class="pni-agenda-card__text"><h3>{title}</h3><p>{text}</p></div>
              <div class="pni-agenda-visual" aria-hidden="true">
                <div class:list={["pni-agenda-product", index > 2 && "pni-agenda-product--wide"]}>
                  <div class="pni-agenda-product__bar"><span><i></i><i></i><i></i></span><small>{["Notification", "Payload data", "Delivery modes", "Reminder", "Audience targeting"][index]}</small></div>
                  <div class="pni-agenda-product__tabs"><span class="is-active">{["Inbox", "Data", "Android", "Event", "Recipients"][index]}</span><span>{["Open", "Route", "Apple", "Push", "Tokens"][index]}</span></div>
                  <div class:list={["pni-agenda-product__body", `pni-agenda-product__body--${index + 1}`]}>
                    {index === 0 && <><div><time>NOW</time><span><strong>Session room changed</strong><small>Track B · starts in 10 min</small></span></div><div class="is-accent"><time>NEW</time><span><strong>Message delivered</strong><small>Attendee inbox ready</small></span></div><div><time>OK</time><span><strong>Event reminder</strong><small>Delivered to active token</small></span></div></>}
                    {index === 1 && <><div><i></i><strong>title · body</strong><small>navigation data</small></div><div class="is-child"><i></i><strong>event_id</strong><small>supported route</small></div><div class="is-child"><i></i><strong>session_id</strong><small>attendee context</small></div></>}
                    {index === 2 && <><span><i></i><i></i></span><span><i></i><i></i></span><span><i></i><i></i></span></>}
                    {index === 3 && <><div><i>10:00</i><span><strong>Doors open</strong><small>Reminder queued</small></span><b>Ready</b></div><div><i>14:30</i><span><strong>Closing session</strong><small>Reminder queued</small></span><b>Ready</b></div></>}
                    {index === 4 && <><div><i>MC</i><span><strong>One attendee</strong><small>active token</small></span><b>ON</b></div><div><i>42</i><span><strong>Selected attendees</strong><small>active tokens</small></span><b>ON</b></div><div><i>+</i><span><strong>Refresh recipients</strong><small>reuse token records</small></span></div></>}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pni-case-suites" id="use-cases" aria-labelledby="pni-case-title">
      <div class="pni-case-suites__inner">
        <header class="pni-case__header"><span class="pni-eyebrow">Where mobile delivery matters</span><h2 id="pni-case-title" class="pni-case__title"><span>Fit push infrastructure to the app</span><span>and event operating model</span></h2></header>
        <div class="pni-case__tabs" role="tablist">
          {useCaseTabs.map((tab, index) => <button class:list={['pni-case__tab', index === 0 && 'pni-case__tab--active']} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`pni-case-panel-${tab.id}`} id={`pni-case-tab-${tab.id}`} data-target={tab.id}>{tab.label}</button>)}
        </div>
        <div class="pni-case__box">
          {useCaseTabs.map((tab, index) => <div class:list={['pni-case__panel', index === 0 && 'pni-case__panel--active']} id={`pni-case-panel-${tab.id}`} role="tabpanel" aria-labelledby={`pni-case-tab-${tab.id}`} data-panel={tab.id}>
            <div class="pni-case__left"><h3>{tab.title}</h3><p>{tab.description}</p><span class="pni-case__label">SUPPORTED PATH</span><ul>{tab.checklist.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul></div>
            <div class="pni-case__right"><div class="pni-case__showcase"><img src={tab.image} alt={tab.imageAlt} loading="lazy" decoding="async" /><span class="pni-case__visual-label">{tab.visualLabel}</span></div></div>
          </div>)}
        </div>
      </div>
    </section>

    <section class="pni-flow-section" id="boundary">
      <div class="pni-flow-header"><span class="pni-eyebrow">Delivery infrastructure, not campaign strategy</span><h2 class="pni-flow-title">Keep Firebase setup separate from notification orchestration</h2></div>
      <div class="pni-flow-quad">
        <article class="pni-flow-quad__cell"><h3 class="pni-flow-quad__title">This integration page</h3><p class="pni-flow-quad__text">Firebase configuration, device tokens, preference checks, payload transport, and provider send results.</p></article>
