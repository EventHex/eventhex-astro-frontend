---
import NewSections from "./NewSections.astro";
const workflow = [
  {
    title: "Create the organization record",
    desc: "Capture identity, contact, plan, and region before any events are created.",
    bullets: ["Client or chapter identity", "Plan context", "Region and support context"],
    shots: [
      { src: "/feature-images/white-label/v5/org-detail.webp", alt: "EventHex organization overview for Northgate Events Network: name, email, contact person, phone, white label Enabled, plan Business, status Active, period and renewal, with plan limits and usage below", width: 2340, height: 3120, pos: "0% 0%", crop: 280 },
    ],
  },
  {
    title: "Connect the people who need access",
    desc: "Invite organization admins first, then scope event teams and narrower event roles.",
    bullets: ["Organization admin", "Event team", "Event-level role"],
    shots: [
      { src: "/feature-images/white-label/v5/team.webp", alt: "Team tab of Northgate Events Network with a Franchise Admin and two Event Managers, each with email and joined date", width: 1740, height: 1210, pos: "0% 100%", crop: 280 },
    ],
  },
  {
    title: "Configure brand, domain, and payments",
    desc: "Apply supported brand fields, verify domain eligibility, and attach the approved payment relationship.",
    bullets: ["Logo and color settings", "Custom-domain verification", "Gateway or connected account"],
    shots: [
      { src: "/feature-images/white-label/v5/org-brand.webp", alt: "Organization Settings: name, address, contact, website, and the Organization Logo and Banner uploads", width: 1820, height: 1890, pos: "0% 100%", crop: 280 },
      { src: "/feature-images/white-label/v5/domain.webp", alt: "Event Custom Domain: events.northgate-events.example.com, verified, with Rename, Visit Site, QR Code and Remove", width: 2440, height: 610, pos: "0% 0%", crop: 280 },
    ],
  },
  {
    title: "Create events in the right workspace",
    desc: "The organization becomes the parent context for users, events, plan rules, and supported settings.",
    bullets: ["Correct organization boundary", "Inherited brand context", "Plan-aware capabilities"],
    shots: [
      { src: "/feature-images/white-label/v5/events.webp", alt: "Events tab of the organization: Pulse Tech Expo 2027, Meridian Health Congress 2027 (Hybrid) and Ascend Impact Summit 2026 with type, date, registrations and status", width: 1740, height: 1210, pos: "0% 100%", crop: 300 },
    ],
  },
  {
    title: "Review portfolio usage",
    desc: "Track counters that inform capacity, plan conversations, renewals, and support context.",
    bullets: ["Events and attendees", "Campaign usage", "AI and media fields"],
    shots: [
      { src: "/feature-images/white-label/v5/limits-usage.webp", alt: "Plan Limits next to Usage Overview with progress bars per resource", width: 1740, height: 940, pos: "0% 0%", crop: 300 },
    ],
  },
];

const flows = [
  {
    title: "Create the organization",
    text: "Each client, chapter, or business unit gets its own record with identity, contact, plan, and region, then one switch turns on the white-label experience.",
    status: "Organization created",
    action: "Add organization",
    shot: { src: "/feature-images/white-label/v5/edit-org.webp", alt: "EventHex Edit Organization form for Northgate Events Network with name, contact, email, phone, website, address and the Enable White Label (remove platform branding) checkbox ticked", width: 1600, height: 1800, pos: "0% 100%", crop: 330 },
  },
  {
    title: "Gate capabilities by plan",
    text: "Custom domains, white label, and event limits follow the plan an organization is on, and attendee mobile app settings are managed per organization.",
    status: "Plan-aware controls",
    action: "Edit plan",
    shot: { src: "/feature-images/white-label/v5/limits-usage.webp", alt: "EventHex Plan Limits and Usage Overview for the Business plan: events 3 of 25, attendees per event, speakers, sessions, sponsors, exhibitors, campaigns", width: 1740, height: 940, pos: "0% 0%", crop: 330 },
  },
];

const capabilities = [
  { title: "Organization directory", body: "Find the client, chapter, or business unit without flattening every event into one undifferentiated list.", shot: { src: "/feature-images/white-label/v5/directory.webp", alt: "Admin Console organizations list: four organizations with contact, plan, events, renewal and status", width: 2880, height: 1380, pos: "100% 0%", crop: 200 } },
  { title: "Scoped access", body: "Organization admins, event teams, platform admins, and event-level roles keep responsibilities separated.", chips: ["Org admin", "Event team", "Platform admin", "Scanner"], active: 1, shot: { src: "/feature-images/white-label/v5/team.webp", alt: "Team tab of the organization: three members with email, role (Franchise Admin, Event Manager) and joined date", width: 1740, height: 1210, pos: "0% 100%", crop: 200 } },
  { title: "Feature gates", body: "Control paid tickets, API access, white label, custom domains, and AI website generation by plan.", shot: { src: "/feature-images/white-label/v5/features.webp", alt: "Features: Custom Domain Yes, White Label Yes, API Access Yes, Paid Tickets Yes, Platform Fee 0%, Support Level priority", width: 1740, height: 310 } },
  { title: "Resource limits", body: "Apply configured limits to events, team members, attendees, campaigns, and other metered resources.", shot: { src: "/feature-images/white-label/v5/limits-usage.webp", alt: "Plan limits: max events 25, attendees per event 5000, speakers, sessions, sponsors, exhibitors, team members", width: 1740, height: 940, pos: "0% 0%", crop: 200 } },
  { title: "Usage counters", body: "Review events, attendees, content records, campaigns, and AI or media fields tied to the organization.", chips: ["Events", "Attendees", "Campaigns", "AI fields", "Media"], active: 2, shot: { src: "/feature-images/white-label/v5/limits-usage.webp", alt: "Usage Overview bars: events 3 of 25, attendees 1260 of 5000, WhatsApp and email campaigns per month", width: 1740, height: 940, pos: "100% 100%", crop: 200 } },
  { title: "Payment setup", body: "Keep supported gateway credentials and connected-account configuration attached to the owning organization.", shot: { src: "/feature-images/white-label/v5/payment.webp", alt: "Organization payment configuration: custom payment gateway switch and Stripe Connect bank account payouts", width: 1820, height: 1240, pos: "0% 0%", crop: 200 } },
];

const audiences = [
  { title: "Event agencies", body: "Manage client organizations and repeat programmes under distinct commercial relationships.", icon: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" },
  { title: "Associations", body: "Support chapters, committees, or regional teams while keeping portfolio oversight.", icon: "M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" },
  { title: "Enterprises", body: "Separate brands, business units, or markets without creating disconnected tooling.", icon: "M4 21V5h10v16M14 9h6v12M8 9h2M8 13h2M8 17h2" },
  { title: "Conference portfolios", body: "Operate recurring event series where each edition or region needs its own context.", icon: "M4 21v-9h16v9M7 12V5h10v7M9 8h2m2 0h2" },
  { title: "Exhibition groups", body: "Coordinate show brands, exhibitor records, and event teams across a portfolio.", icon: "M3 9l9-6 9 6v11H3zM9 20v-6h6v6" },
  { title: "Platform partners", body: "Define plan, payment, support, and capability responsibilities before launch.", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4" },
];
---

<section class="wlc-flow" id="wl-model" aria-labelledby="wl-model-title">
  <div class="wlc-flow__header">
    <h2 id="wl-model-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">Set Up Around <span class="ds-hl">Who Owns Each Event</span></h2>
    <p class="wlc-flow__subtitle animate-on-scroll" data-animation="fadeInUp">Create the organization, switch on white label, and let the plan decide what each one can use.</p>
  </div>

  <div class="wlc-quad">
    <article class="wlc-quad__cell wlc-quad__copy animate-on-scroll" data-animation="fadeInUp">
      <h3>{flows[0].title}</h3>
      <p>{flows[0].text}</p>
    </article>
    <div class="wlc-quad__cell wlc-quad__media animate-on-scroll" data-animation="fadeInRight">
      <div class="ds-shot ds-shot--crop wlc-shot" style={`--ds-pos: ${flows[0].shot.pos}; height: ${flows[0].shot.crop}px`}>
        <img src={flows[0].shot.src} alt={flows[0].shot.alt} width={flows[0].shot.width} height={flows[0].shot.height} loading="lazy" decoding="async" />
        </div>
        <p class="wlc-caption"><span>{flows[0].status}</span>{" "}<span>{flows[0].action}</span></p>
    </div>
    <div class="wlc-quad__cell wlc-quad__media animate-on-scroll" data-animation="fadeInLeft">
      <div class="ds-shot ds-shot--crop wlc-shot" style={`--ds-pos: ${flows[1].shot.pos}; height: ${flows[1].shot.crop}px`}>
          <img src={flows[1].shot.src} alt={flows[1].shot.alt} width={flows[1].shot.width} height={flows[1].shot.height} loading="lazy" decoding="async" />
        </div>
        <p class="wlc-caption"><span>{flows[1].status}</span>{" "}<span>{flows[1].action}</span></p>
    </div>
    <article class="wlc-quad__cell wlc-quad__copy animate-on-scroll" data-animation="fadeInUp">
      <h3>{flows[1].title}</h3>
      <p>{flows[1].text}</p>
    </article>
    <span class="wlc-quad__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28">
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)" transform="scale(1,-1)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)" transform="rotate(90)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line)" transform="rotate(-90)"></path>
      </svg>
    </span>
  </div>
  <p class="wlc-note">White label and custom domains are plan-gated. Confirm what your plan includes during the demo.</p>
</section>

<NewSections part="ab" />

<div class="wlc-dark-band ds-night">
  <div class="wlc-heading">
    <h2 class="animate-on-scroll" data-animation="fadeInUp">Keep Ownership, Access, and Usage <span class="ds-hl-dark">In One Context</span></h2>
    <p class="animate-on-scroll" data-animation="fadeInUp">White label is not only a logo field. The organization boundary carries teams, events, capabilities, metering, and account context.</p>
  </div>
  <section class="wlc-cap" aria-label="Platform boundaries">
    {capabilities.map((cap, index) => (
      <article class="wlc-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay={String((index % 3) * 60)}>
        <h3>{cap.title}</h3>
        <p>{cap.body}</p>
        <div class="wlc-cap__visual">
          {cap.chips && (
            <div class="wlc-cap__chips">
              {cap.chips.map((chip, i) => (<span class:list={[{ "is-active": i === cap.active }]}>{chip}</span>))}
            </div>
          )}
          <div class:list={["ds-shot", "wlc-shot", { "ds-shot--crop": cap.shot.crop }]} style={cap.shot.crop ? `--ds-pos: ${cap.shot.pos}; height: ${cap.shot.crop}px` : undefined}>
            <img src={cap.shot.src} alt={cap.shot.alt} width={cap.shot.width} height={cap.shot.height} loading="lazy" decoding="async" />
          </div>
        </div>
      </article>
    ))}
  </section>
</div>

<section class="wlc-workflow-section" aria-labelledby="wl-workflow-title">
  <div class="wlc-workflow-wrap">
    <header class="wlc-flow__header">
      <h2 id="wl-workflow-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">From Organization Record to <span class="ds-hl">Live Event Portfolio</span></h2>
    </header>

    <ol class="wlc-workflow">
      {workflow.map((step, index) => (
        <li>
          <details open={index === 0} data-wl-workflow-item>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
                <ul>
                  {step.bullets.map((bullet) => (
                    <li><i aria-hidden="true">&middot;</i>{bullet}</li>
                  ))}
                </ul>
              </div>
              <span class="wlc-workflow__chevron" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"></path></svg>
              </span>
            </summary>
            <div class:list={["wlc-workflow__visual", { "wlc-workflow__visual--two": step.shots.length > 1 }]}>
              {step.shots.map((shot) => (
                <div class="ds-shot ds-shot--crop wlc-shot" style={`--ds-pos: ${shot.pos}; height: ${shot.crop}px`}>
                  <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
                </div>
              ))}
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<NewSections part="c" />

<section class="wlc-use ds-stage" aria-labelledby="wl-audiences-title">
  <div class="wlc-use__shell">
    <h2 id="wl-audiences-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">Built for Every Kind of <span class="ds-hl">Distributed Event Business</span></h2>
    <div class="wlc-use__grid">
      {audiences.map((audience) => (
        <article class="wlc-use__card animate-on-scroll" data-animation="fadeInUp">
          <div class="wlc-use__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={audience.icon}></path></svg>
          </div>
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const whiteLabelWorkflowItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-wl-workflow-item]"));
  whiteLabelWorkflowItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      whiteLabelWorkflowItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<style>
  .wlc-flow { padding: clamp(56px, 7vw, 96px) 24px 24px; color: var(--ds-ink); }
  .wlc-flow__header { display: flex; flex-direction: column; align-items: center; max-width: 1100px; margin: 0 auto 24px; text-align: center; }
  .wlc-flow__title { margin: 0 0 12px; font-family: var(--font-heading); font-size: clamp(28px, 4.2vw, 48px); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; background-clip: text; -webkit-background-clip: text; }
  .wlc-flow__subtitle { max-width: 640px; margin: 0; color: var(--subheading-gray, var(--ds-sub)); font-family: var(--font-body); font-size: 18px; line-height: 1.5; }
  .wlc-note { margin: 24px auto 0; color: var(--ds-muted); text-align: center; font-family: var(--font-body); font-weight: 500; }

  .wlc-quad { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; width: 100%; max-width: 1180px; margin: 24px auto; }
  .wlc-quad__cross { position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; transform: translate(-50%, -50%); line-height: 0; pointer-events: none; z-index: 1; }
  .wlc-quad__cell { display: flex; flex-direction: column; justify-content: center; min-height: 260px; padding: 56px 48px; border-right: 1px solid var(--ds-surface-tab); border-bottom: 1px solid var(--ds-surface-tab); }
  .wlc-quad__cell:nth-child(2n) { border-right: none; }
  .wlc-quad__cell:nth-child(n + 3) { border-bottom: none; }
  .wlc-quad__copy h3 { margin: 0 0 16px; font-family: var(--font-heading); font-size: clamp(24px, 2.6vw, 32px); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; color: var(--heading-dark, var(--ds-night-2)); }
  .wlc-quad__copy p { max-width: 40ch; margin: 0; color: var(--subheading-gray, var(--ds-sub)); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  .wlc-shot { width: 100%; }
  .wlc-caption { display: flex; flex-wrap: wrap; gap: 8px 16px; width: 100%; margin: 12px 0 0; font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--ds-muted); }
  .wlc-caption span + span::before { content: "\00b7"; margin-right: 16px; }
  .wlc-cap__chips { margin-bottom: 14px; }
  .wlc-workflow__visual { display: grid; grid-template-columns: 1fr; gap: 16px; padding: 0 22px 22px 86px; }
  .wlc-workflow__visual--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .wlc-quad__media { align-items: center; min-height: 360px; padding: 18px 22px; overflow: hidden; }


  .wlc-dark-band { position: relative; overflow: hidden; margin: 40px clamp(16px, 3.5vw, 56px) 0; padding: clamp(64px, 8vw, 96px) 24px; border-radius: 28px; background-color: var(--ds-black); background-image: radial-gradient(130% 42% at 50% 0%, rgba(92, 138, 255, .22) 0%, rgba(124, 108, 255, .1) 45%, transparent 72%); background-repeat: no-repeat; }
  .wlc-heading { max-width: 900px; margin: 0 auto 48px; text-align: center; }
  .wlc-heading h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(32px, 4.4vw, 52px); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; background: linear-gradient(100deg, var(--ds-white) 0%, var(--ds-surface-tab) 26%, var(--ds-on-night-body) 52%, var(--ds-violet-soft) 74%, var(--ds-violet) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .wlc-heading h2 span { background: none; -webkit-text-fill-color: transparent; }
  .wlc-heading p { max-width: 640px; margin: 18px auto 0; color: var(--ds-label); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  .wlc-cap { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); max-width: 1180px; margin: 0 auto; border: 1px solid var(--ds-ink-2); border-radius: 16px; overflow: hidden; }
  .wlc-cap__cell { display: flex; flex-direction: column; min-height: 340px; padding: 36px 32px; border-right: 1px solid var(--ds-ink-2); border-bottom: 1px solid var(--ds-ink-2); }
  .wlc-cap__cell:nth-child(3n) { border-right: none; }
  .wlc-cap__cell:nth-child(n + 4) { border-bottom: none; }
  .wlc-cap__cell h3 { margin: 0 0 12px; color: var(--ds-white); font-family: var(--font-heading); font-size: 22px; font-weight: 600; line-height: 1.2; letter-spacing: -.02em; }
  .wlc-cap__cell p { margin: 0; color: var(--ds-label); font-family: var(--font-body); font-size: 15px; line-height: 1.6; }
  .wlc-cap__visual { margin-top: auto; padding-top: 28px; }
  .wlc-cap__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wlc-cap__chips span { padding: 7px 12px; border: 1px solid var(--ds-ink-2); border-radius: 999px; color: var(--ds-line-strong); font-family: var(--font-body); font-size: 12px; font-weight: 600; }
  .wlc-cap__chips span.is-active { border-color: var(--ds-cat-indigo); background: rgba(109, 130, 255, .18); color: var(--ds-white); }

  .wlc-workflow-section { padding: clamp(72px, 8vw, 108px) 24px; }
  .wlc-workflow-wrap { width: min(880px, 100%); margin: 0 auto; }
  .wlc-workflow-wrap .wlc-flow__header { margin-bottom: 40px; }
  .wlc-workflow { display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .wlc-workflow details { overflow: hidden; border: 1px solid var(--ds-line-strong); border-radius: 18px; background: var(--ds-white); transition: background .25s ease, border-color .25s ease; }
  .wlc-workflow details[open] { background: var(--ds-line); }
  .wlc-workflow summary { display: grid; grid-template-columns: 48px 1fr 30px; gap: 16px; align-items: start; padding: 22px; cursor: pointer; list-style: none; }
  .wlc-workflow summary::-webkit-details-marker { display: none; }
  .wlc-workflow summary > span:first-child { color: var(--ds-label); font-family: var(--font-heading); font-size: 20px; }
  .wlc-workflow h3 { margin: 0; font-family: var(--font-heading); font-size: 18px; line-height: 1.25; color: var(--ds-ink); }
  .wlc-workflow summary p { margin: 10px 0 0; color: var(--ds-muted); font-family: var(--font-body); font-size: 14px; line-height: 1.55; }
  .wlc-workflow summary ul { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 14px 0 0; padding: 0; list-style: none; }
  .wlc-workflow summary ul li { color: var(--ds-ink-2); font-family: var(--font-body); font-size: 12px; font-weight: 600; }
  .wlc-workflow summary ul i { margin-right: 4px; color: var(--ds-blue); font-style: normal; }
  .wlc-workflow__chevron { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--ds-white); color: var(--ds-ink); }
  .wlc-workflow__chevron svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s ease; }
  .wlc-workflow details[open] .wlc-workflow__chevron svg { transform: rotate(180deg); }

  .wlc-use { padding: 0 24px clamp(72px, 8vw, 108px); }
  .wlc-use__shell { width: min(1200px, 100%); margin: 0 auto; }
  .wlc-use__shell > .wlc-flow__title { margin: 0 auto 40px; text-align: center; }
  .wlc-use__shell > .wlc-flow__title span { background: none; -webkit-text-fill-color: transparent; }
  .wlc-use__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .wlc-use__card { padding: 32px; border: 1px solid var(--ds-line); border-radius: 24px; background: var(--ds-surface); }
  .wlc-use__icon { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 28px; border-radius: 10px; background: var(--ds-line); color: var(--ds-blue); }
  .wlc-use__icon svg { width: 20px; height: 20px; }
  .wlc-use__card h3 { margin: 0 0 10px; color: var(--heading-dark, var(--ds-night-2)); font: 700 1.25rem/1.25 var(--font-heading); }
  .wlc-use__card p { margin: 0; color: var(--subheading-gray, var(--ds-sub)); font-family: var(--font-body); line-height: 1.65; }

  @media (max-width: 1024px) {
    .wlc-cap { grid-template-columns: repeat(2, 1fr); }
    .wlc-cap__cell:nth-child(3n) { border-right: 1px solid var(--ds-ink-2); }
    .wlc-cap__cell:nth-child(2n) { border-right: none; }
    .wlc-cap__cell:nth-child(n + 4) { border-bottom: 1px solid var(--ds-ink-2); }
    .wlc-cap__cell:nth-child(n + 5) { border-bottom: none; }
    .wlc-use__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .wlc-quad { grid-template-columns: 1fr; grid-template-rows: auto; }
    .wlc-quad__cross { display: none; }
    .wlc-quad__cell { min-height: 0; padding: 32px 0; border-right: none; border-bottom: 1px solid var(--ds-surface-tab); }
    .wlc-quad__cell:nth-child(n + 3) { border-bottom: 1px solid var(--ds-surface-tab); }
    .wlc-quad__cell:nth-child(4) { order: 3; }
