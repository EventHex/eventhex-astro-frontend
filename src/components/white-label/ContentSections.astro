---
const setupCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    title: "Create the organization",
    body: "Store each client, chapter, or business unit with its identity, contact, plan, and region context.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path d="M12 2a10 10 0 0 0 0 20 2 2 0 0 0 0-4 2 2 0 0 1 0-4h4a4 4 0 0 0 4-4 10 10 0 0 0-8-2Z"></path></svg>`,
    title: "Set the brand surface",
    body: "Apply organization logo and color settings, then enable the white-label experience where the plan supports it.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-4"></path></svg>`,
    title: "Assign scoped teams",
    body: "Connect organization admins, event teams, and narrower event roles to the workspace they are permitted to operate.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path><path d="m9 16 2 2 4-4"></path></svg>`,
    title: "Launch and operate events",
    body: "Create events inside the right organization so brand, account, plan, and usage context stay connected.",
  },
];

const capabilityCards = [
  { title: "Organization directory", body: "Find the client, chapter, or business unit without flattening every event into one undifferentiated list." },
  { title: "Scoped access", body: "Organization admins, event teams, platform admins, and event-level roles keep responsibilities separated." },
  { title: "Feature gates", body: "Control paid tickets, API access, white label, custom domains, and AI website generation by plan." },
  { title: "Resource limits", body: "Apply configured limits to events, team members, attendees, campaigns, and other metered resources." },
  { title: "Usage counters", body: "Review events, attendees, content records, campaigns, and AI or media fields tied to the organization." },
  { title: "Payment setup", body: "Keep supported gateway credentials and connected-account configuration attached to the owning organization." },
];

const workflow = [
  {
    title: "Create the organization record",
    desc: "Capture identity, contact, plan, and region before any events are created.",
    bullets: ["Client or chapter identity", "Plan context", "Region and support context"],
    fields: [["Organization", "Northstar Events Network"], ["Model", "Agency and client"], ["Plan", "Growth + white label"]],
    status: "Record created",
  },
  {
    title: "Connect the people who need access",
    desc: "Invite organization admins first, then scope event teams and narrower event roles.",
    bullets: ["Organization admin", "Event team", "Event-level role"],
    fields: [["Admin", "Owner account"], ["Marketing", "Event website"], ["Scanner", "Check-in only"]],
    status: "Access scoped",
  },
  {
    title: "Configure brand, domain, and payments",
    desc: "Apply supported brand fields, verify domain eligibility, and attach the approved payment relationship.",
    bullets: ["Logo and color settings", "Custom-domain verification", "Gateway or connected account"],
    fields: [["Logo", "northstar.svg"], ["Domain", "events.northstar.example"], ["Gateway", "Organization account"]],
    status: "Configuration ready",
  },
  {
    title: "Create events in the right workspace",
    desc: "The organization becomes the parent context for users, events, plan rules, and supported settings.",
    bullets: ["Correct organization boundary", "Inherited brand context", "Plan-aware capabilities"],
    fields: [["Event", "Summit 2026"], ["Workspace", "Summit Co"], ["Access", "Client team"]],
    status: "Event connected",
  },
  {
    title: "Review portfolio usage",
    desc: "Track counters that inform capacity, plan conversations, renewals, and support context.",
    bullets: ["Events and attendees", "Campaign usage", "AI and media fields"],
    fields: [["Events", "12 active"], ["Attendees", "4,380 records"], ["Campaigns", "7,900 / 10,000"]],
    status: "Usage visible",
  },
];

const audiences = [
  { title: "Event agencies", body: "Manage client organizations and repeat programmes under distinct commercial relationships." },
  { title: "Associations", body: "Support chapters, committees, or regional teams while keeping portfolio oversight." },
  { title: "Enterprises", body: "Separate brands, business units, or markets without creating disconnected tooling." },
  { title: "Conference portfolios", body: "Operate recurring event series where each edition or region needs its own context." },
  { title: "Exhibition groups", body: "Coordinate show brands, exhibitor records, and event teams across a portfolio." },
  { title: "Platform partners", body: "Define plan, payment, support, and capability responsibilities before launch." },
];
---

<section class="wlc-section wlc-section--connected" id="wl-model" aria-labelledby="wl-model-title">
  <div class="wlc-section__inner">
    <header class="wlc-section__header">
      <span>Organization model</span>
      <h2 id="wl-model-title">Set up the platform around who owns each event relationship</h2>
    </header>

    <div class="wlc-connected">
      {setupCards.map((card) => (
        <article class="wlc-connected__card animate-on-scroll" data-animation="fadeInUp">
          <span class="wlc-connected__icon" set:html={card.icon} />
          <div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="wlc-section wlc-split-section" aria-labelledby="wl-brand-title">
  <div class="wlc-split">
    <div class="wlc-split__copy animate-on-scroll" data-animation="fadeInUp">
      <span>Brand and domains</span>
      <h2 id="wl-brand-title">Make the workspace start from the right organization identity</h2>
      <p>Organization brand fields drive supported surfaces. Custom-domain capability is plan-gated and is scoped to the event surface that will actually use it.</p>
      <ul class="wlc-checklist">
        <li>Organization logo and primary color</li>
        <li>Supported secondary and text-color settings</li>
        <li>Domain entitlement and DNS verification</li>
        <li>White-label gate by organization and plan</li>
      </ul>
    </div>

    <div class="wlc-split__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="wlc-product" role="img" aria-label="Organization brand settings, domain verification, and plan capability controls">
        <header>
          <div><i></i><i></i><i></i></div>
          <span>Organization settings</span>
          <b>White label</b>
        </header>

        <div class="wlc-product__identity">
          <div class="wlc-product__logo">N</div>
          <div>
            <small>Organization</small>
            <strong>Northstar Events Network</strong>
          </div>
          <span>Active</span>
        </div>

        <div class="wlc-product__row">
          <span>Logo</span>
          <strong>northstar-logo.svg</strong>
        </div>
        <div class="wlc-product__row">
          <span>Primary color</span>
          <strong>#171A21</strong>
        </div>
        <div class="wlc-product__domain">
          <span>Domain</span>
          <strong>events.northstar.example</strong>
          <div><i></i>Verified</div>
        </div>

        <div class="wlc-product__toggles">
          <span>Paid tickets <b>On</b></span>
          <span>API access <b>On</b></span>
          <span>Custom domains <b>Plan</b></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="wlc-section wlc-section--capabilities" aria-labelledby="wl-capabilities-title">
  <div class="wlc-section__inner">
    <header class="wlc-section__header">
      <span>Platform boundaries</span>
      <h2 id="wl-capabilities-title">Keep ownership, access, and usage in the same organization context</h2>
      <p>White label is not only a logo field. The organization boundary carries teams, events, capabilities, metering, and account context.</p>
    </header>

    <div class="wlc-capabilities">
      {capabilityCards.map((card, index) => (
        <article class="wlc-capabilities__card animate-on-scroll" data-animation="fadeInUp" data-delay={String((index % 3) * 60)}>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="wlc-section wlc-section--workflow" aria-labelledby="wl-workflow-title">
  <div class="wlc-section__inner wlc-section__inner--narrow">
    <header class="wlc-section__header">
      <span>Connected workflow</span>
      <h2 id="wl-workflow-title">From organization record to live event portfolio</h2>
    </header>

    <ol class="wlc-workflow">
      {workflow.map((step, index) => (
        <li>
          <details open={index === 0} data-wl-workflow-item>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
                <ul>
                  {step.bullets.map((bullet) => (
                    <li><i aria-hidden="true">&middot;</i>{bullet}</li>
                  ))}
                </ul>
              </div>
              <span class="wlc-workflow__chevron" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"></path></svg>
              </span>
            </summary>
            <div class="wlc-workflow__visual">
              {step.fields.map(([label, value]) => (
                <div><span>{label}</span><strong>{value}</strong></div>
              ))}
              <b>{step.status}</b>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="wlc-section wlc-section--audiences" aria-labelledby="wl-audiences-title">
  <div class="wlc-section__inner">
    <header class="wlc-section__header">
      <span>Distributed event businesses</span>
      <h2 id="wl-audiences-title">Use the organization model where brand and ownership matter</h2>
    </header>
    <div class="wlc-audiences">
      {audiences.map((audience) => (
        <article class="wlc-audiences__card animate-on-scroll" data-animation="fadeInUp">
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const whiteLabelWorkflowItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-wl-workflow-item]"));
  whiteLabelWorkflowItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      whiteLabelWorkflowItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<style>
  .wlc-section { padding: clamp(72px, 8vw, 108px) 24px; background: transparent; color: #22272f; }
  .wlc-section__inner { width: min(1200px, 100%); margin: 0 auto; }
  .wlc-section__inner--narrow { width: min(880px, 100%); }
  .wlc-section__header { max-width: 850px; margin: 0 auto 52px; text-align: center; }
  .wlc-section__header > span, .wlc-split__copy > span { display: block; margin-bottom: 16px; color: #375dfb; font-family: var(--font-body); font-size: 12px; font-weight: 750; line-height: 1.2; letter-spacing: .13em; text-transform: uppercase; }
  .wlc-section__header h2, .wlc-split__copy h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(38px, 4.5vw, 56px); font-weight: 650; line-height: 1.08; letter-spacing: -.04em; background: linear-gradient(to right, #111827 0%, #111827 60%, #9ca3af 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: transparent; }
  .wlc-section__header p { max-width: 690px; margin: 18px auto 0; color: #596579; font-family: var(--font-body); font-size: 16px; line-height: 1.6; }

  .wlc-connected { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #e3e8f1; border-bottom: 1px solid #e3e8f1; }
  .wlc-connected__card { position: relative; min-width: 0; padding: 32px 26px 38px; border-left: 1px solid #e3e8f1; }
  .wlc-connected__card:first-child { border-left: 0; }
  .wlc-connected__card:not(:first-child)::before, .wlc-connected__card:not(:first-child)::after { content: ""; position: absolute; left: -8px; width: 16px; height: 16px; border-radius: 50%; background: #fff; z-index: 1; }
  .wlc-connected__card:not(:first-child)::before { top: -8px; }
  .wlc-connected__card:not(:first-child)::after { bottom: -8px; }
  .wlc-connected__icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 26px; border: 1px solid #dfe7f5; border-radius: 11px; background: #fff; color: #375dfb; }
  .wlc-connected__icon svg { width: 21px; height: 21px; }
  .wlc-connected__card h3 { margin: 0; font-family: var(--font-heading); font-size: 20px; line-height: 1.25; }
  .wlc-connected__card p { margin: 14px 0 0; color: #596579; font-family: var(--font-body); font-size: 14px; line-height: 1.6; }

  .wlc-split-section { padding-top: 24px; }
  .wlc-split { width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(48px, 8vw, 112px); align-items: center; }
  .wlc-split__copy { max-width: 560px; }
  .wlc-split__copy p { margin: 20px 0 26px; color: #596579; font-family: var(--font-body); font-size: 16px; line-height: 1.7; }
  .wlc-checklist { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .wlc-checklist li { position: relative; padding-left: 24px; color: #354053; font-family: var(--font-body); font-size: 15px; font-weight: 500; }
  .wlc-checklist li::before { content: ""; position: absolute; left: 0; top: 7px; width: 7px; height: 7px; border-radius: 50%; background: #10b981; }

  .wlc-product { position: relative; border: 1px solid #dfe7f5; border-radius: 16px; background: #fff; box-shadow: 0 24px 58px rgba(29, 61, 179, .1); overflow: hidden; }
  .wlc-product header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid #e8edf5; background: #f8fafd; }
  .wlc-product header div { display: flex; gap: 4px; }
  .wlc-product header i { width: 7px; height: 7px; border-radius: 50%; background: #d9dfec; }
  .wlc-product header span { color: #596579; font-size: 11px; font-weight: 650; }
  .wlc-product header b { color: #375dfb; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .wlc-product__identity { display: grid; grid-template-columns: 42px 1fr auto; gap: 12px; align-items: center; padding: 18px; }
  .wlc-product__logo { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 11px; background: #171a21; color: #fff; font-family: var(--font-heading); font-size: 19px; }
  .wlc-product__identity small, .wlc-product__row span, .wlc-product__domain span { display: block; color: #7f8898; font-size: 10px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .wlc-product__identity strong { display: block; margin-top: 4px; font-family: var(--font-heading); font-size: 17px; color: #22272f; }
  .wlc-product__identity > span { padding: 5px 8px; border-radius: 999px; background: #e7f8f0; color: #12956a; font-size: 9px; font-weight: 700; }
  .wlc-product__row, .wlc-product__domain { margin: 0 18px; padding: 13px 0; border-top: 1px solid #e8edf5; }
  .wlc-product__row strong, .wlc-product__domain strong { display: block; margin-top: 6px; color: #22272f; font-family: var(--font-body); font-size: 13px; overflow-wrap: anywhere; }
  .wlc-product__domain > div { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; padding: 5px 8px; border-radius: 999px; background: #e7f8f0; color: #12956a; font-size: 10px; font-weight: 700; }
  .wlc-product__domain i { width: 6px; height: 6px; border-radius: 50%; background: #12956a; }
  .wlc-product__toggles { display: grid; gap: 7px; padding: 16px 18px 20px; }
  .wlc-product__toggles span { display: flex; align-items: center; justify-content: space-between; padding: 9px 11px; border: 1px solid #dfe7f5; border-radius: 7px; background: #fff; color: #354053; font-size: 12px; }
  .wlc-product__toggles b { color: #12956a; font-size: 10px; }

  .wlc-capabilities { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 2.5rem; row-gap: 3rem; }
  .wlc-capabilities__card h3, .wlc-audiences__card h3 { margin: 0; font-family: var(--font-heading); font-size: 20px; line-height: 1.25; color: #22272f; }
  .wlc-capabilities__card p, .wlc-audiences__card p { margin: 16px 0 0; color: #596579; font-family: var(--font-body); font-size: 15px; line-height: 1.6; }
  .wlc-capabilities__card { position: relative; padding-top: 20px; }
  .wlc-capabilities__card::before { content: ""; position: absolute; top: 0; left: 0; width: 34px; height: 2px; background: #d9dfec; }

  .wlc-workflow { display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .wlc-workflow details { overflow: hidden; border: 1px solid #e4e7ec; border-radius: 18px; background: #fff; transition: background .25s ease, border-color .25s ease; }
  .wlc-workflow details[open] { background: #e7ebf3; }
  .wlc-workflow summary { display: grid; grid-template-columns: 48px 1fr 30px; gap: 16px; align-items: start; padding: 22px; cursor: pointer; list-style: none; }
  .wlc-workflow summary::-webkit-details-marker { display: none; }
  .wlc-workflow summary > span:first-child { color: #7f8898; font-family: var(--font-heading); font-size: 20px; }
  .wlc-workflow h3 { margin: 0; font-family: var(--font-heading); font-size: 18px; line-height: 1.25; color: #22272f; }
  .wlc-workflow summary p { margin: 10px 0 0; color: #596579; font-family: var(--font-body); font-size: 14px; line-height: 1.55; }
  .wlc-workflow summary ul { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 14px 0 0; padding: 0; list-style: none; }
  .wlc-workflow summary ul li { color: #354053; font-family: var(--font-body); font-size: 12px; font-weight: 600; }
  .wlc-workflow summary ul i { margin-right: 4px; color: #375dfb; font-style: normal; }
  .wlc-workflow__chevron { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #fff; color: #22272f; }
  .wlc-workflow__chevron svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s ease; }
  .wlc-workflow details[open] .wlc-workflow__chevron svg { transform: rotate(180deg); }
  .wlc-workflow__visual { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 22px 22px 86px; }
  .wlc-workflow__visual > div { min-width: 0; padding: 12px; border-radius: 10px; background: #fff; }
  .wlc-workflow__visual span { display: block; color: #7f8898; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .wlc-workflow__visual strong { display: block; margin-top: 5px; color: #22272f; font-family: var(--font-body); font-size: 12px; overflow-wrap: anywhere; }
  .wlc-workflow__visual b { grid-column: 3; justify-self: end; padding: 6px 10px; border-radius: 999px; background: #dcecff; color: #2551d8; font-size: 10px; }

  .wlc-audiences { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .wlc-audiences__card { padding: 26px; border: 1px solid #e4e7ec; border-radius: 14px; background: #fff; }

  @media (max-width: 1024px) {
    .wlc-connected { grid-template-columns: repeat(2, 1fr); }
    .wlc-connected__card:nth-child(3) { border-left: 0; }
    .wlc-connected__card:nth-child(3)::before, .wlc-connected__card:nth-child(3)::after { display: none; }
    .wlc-capabilities { grid-template-columns: repeat(2, 1fr); }
    .wlc-split { grid-template-columns: 1fr; gap: 42px; }
    .wlc-audiences { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .wlc-section { padding: 56px 16px; }
    .wlc-section__header { margin-bottom: 34px; }
    .wlc-section__header h2, .wlc-split__copy h2 { font-size: 31px; }
    .wlc-connected, .wlc-capabilities, .wlc-audiences { grid-template-columns: 1fr; }
    .wlc-connected__card { border-left: 0; border-top: 1px solid #e3e8f1; padding: 24px 0; }
    .wlc-connected__card:first-child { border-top: 0; }
    .wlc-connected__card::before, .wlc-connected__card::after { display: none !important; }
    .wlc-product__identity { grid-template-columns: 42px 1fr; }
    .wlc-product__identity > span { grid-column: 2; justify-self: start; }
    .wlc-workflow summary { grid-template-columns: 34px 1fr; }
    .wlc-workflow__chevron { display: none; }
    .wlc-workflow__visual { grid-template-columns: 1fr; padding-left: 22px; }
    .wlc-workflow__visual b { grid-column: 1; justify-self: start; }
  }
</style>
