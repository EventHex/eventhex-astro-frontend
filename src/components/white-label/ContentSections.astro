---
const workflow = [
  {
    title: "Create the organization record",
    desc: "Capture identity, contact, plan, and region before any events are created.",
    bullets: ["Client or chapter identity", "Plan context", "Region and support context"],
    fields: [["Organization", "Northstar Events Network"], ["Model", "Agency and client"], ["Plan", "Growth + white label"]],
    status: "Record created",
  },
  {
    title: "Connect the people who need access",
    desc: "Invite organization admins first, then scope event teams and narrower event roles.",
    bullets: ["Organization admin", "Event team", "Event-level role"],
    fields: [["Admin", "Owner account"], ["Marketing", "Event website"], ["Scanner", "Check-in only"]],
    status: "Access scoped",
  },
  {
    title: "Configure brand, domain, and payments",
    desc: "Apply supported brand fields, verify domain eligibility, and attach the approved payment relationship.",
    bullets: ["Logo and color settings", "Custom-domain verification", "Gateway or connected account"],
    fields: [["Logo", "northstar.svg"], ["Domain", "events.northstar.example"], ["Gateway", "Organization account"]],
    status: "Configuration ready",
  },
  {
    title: "Create events in the right workspace",
    desc: "The organization becomes the parent context for users, events, plan rules, and supported settings.",
    bullets: ["Correct organization boundary", "Inherited brand context", "Plan-aware capabilities"],
    fields: [["Event", "Summit 2026"], ["Workspace", "Summit Co"], ["Access", "Client team"]],
    status: "Event connected",
  },
  {
    title: "Review portfolio usage",
    desc: "Track counters that inform capacity, plan conversations, renewals, and support context.",
    bullets: ["Events and attendees", "Campaign usage", "AI and media fields"],
    fields: [["Events", "12 active"], ["Attendees", "4,380 records"], ["Campaigns", "7,900 / 10,000"]],
    status: "Usage visible",
  },
];

const flows = [
  {
    title: "Create the organization",
    text: "Each client, chapter, or business unit gets its own record with identity, contact, plan, and region, then one switch turns on the white-label experience.",
    status: "Organization created",
    action: "Add organization",
    primary: ["/feature-images/white-label/organization-directory.png", "EventHex organization directory with plan and status for each client", 630, 298],
    secondary: ["/feature-images/white-label/organization-white-label-setting.png", "EventHex edit organization form with the Enable White Label option", 428, 450],
  },
  {
    title: "Gate capabilities by plan",
    text: "Custom domains, white label, and event limits follow the plan an organization is on, and attendee mobile app settings are managed per organization.",
    status: "Plan-aware controls",
    action: "Edit plan",
    primary: ["/feature-images/white-label/plan-feature-gates.png", "EventHex plan overview listing custom domain and white label as plan features", 450, 320],
    secondary: ["/feature-images/white-label/organization-mobile-app-settings.png", "EventHex organization attendee mobile app settings", 620, 245],
  },
];

const capabilities = [
  { title: "Organization directory", body: "Find the client, chapter, or business unit without flattening every event into one undifferentiated list.", rows: [["Northstar Events", "Professional"], ["Summit Co", "Enterprise"], ["Harbor Association", "Active"]] },
  { title: "Scoped access", body: "Organization admins, event teams, platform admins, and event-level roles keep responsibilities separated.", chips: ["Org admin", "Event team", "Platform admin", "Scanner"], active: 1 },
  { title: "Feature gates", body: "Control paid tickets, API access, white label, custom domains, and AI website generation by plan.", rows: [["White label", "On"], ["Custom domain", "On"], ["API access", "Plan"]] },
  { title: "Resource limits", body: "Apply configured limits to events, team members, attendees, campaigns, and other metered resources.", bars: [["Events", 48], ["Attendees", 72], ["Campaigns", 79]] },
  { title: "Usage counters", body: "Review events, attendees, content records, campaigns, and AI or media fields tied to the organization.", chips: ["Events", "Attendees", "Campaigns", "AI fields", "Media"], active: 2 },
  { title: "Payment setup", body: "Keep supported gateway credentials and connected-account configuration attached to the owning organization.", rows: [["Gateway", "Organization account"], ["Mode", "Connected"], ["Owner", "Northstar Events"]] },
];

const audiences = [
  { title: "Event agencies", body: "Manage client organizations and repeat programmes under distinct commercial relationships.", icon: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" },
  { title: "Associations", body: "Support chapters, committees, or regional teams while keeping portfolio oversight.", icon: "M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" },
  { title: "Enterprises", body: "Separate brands, business units, or markets without creating disconnected tooling.", icon: "M4 21V5h10v16M14 9h6v12M8 9h2M8 13h2M8 17h2" },
  { title: "Conference portfolios", body: "Operate recurring event series where each edition or region needs its own context.", icon: "M4 21v-9h16v9M7 12V5h10v7M9 8h2m2 0h2" },
  { title: "Exhibition groups", body: "Coordinate show brands, exhibitor records, and event teams across a portfolio.", icon: "M3 9l9-6 9 6v11H3zM9 20v-6h6v6" },
  { title: "Platform partners", body: "Define plan, payment, support, and capability responsibilities before launch.", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4" },
];
---

<section class="wlc-flow" id="wl-model" aria-labelledby="wl-model-title">
  <div class="wlc-flow__header">
    <h2 id="wl-model-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">Set Up Around Who Owns Each Event</h2>
    <p class="wlc-flow__subtitle animate-on-scroll" data-animation="fadeInUp">Create the organization, switch on white label, and let the plan decide what each one can use.</p>
  </div>

  <div class="wlc-quad">
    <article class="wlc-quad__cell wlc-quad__copy animate-on-scroll" data-animation="fadeInUp">
      <h3>{flows[0].title}</h3>
      <p>{flows[0].text}</p>
    </article>
    <div class="wlc-quad__cell wlc-quad__media animate-on-scroll" data-animation="fadeInRight">
      <div class="wlc-composite">
        <img class="wlc-composite__screen wlc-composite__screen--primary" src={flows[0].primary[0]} alt={flows[0].primary[1]} width={flows[0].primary[2]} height={flows[0].primary[3]} loading="lazy" />
        <img class="wlc-composite__screen wlc-composite__screen--detail" src={flows[0].secondary[0]} alt={flows[0].secondary[1]} width={flows[0].secondary[2]} height={flows[0].secondary[3]} loading="lazy" />
        <span class="wlc-composite__status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>{flows[0].status}</span>
        <span class="wlc-composite__action">{flows[0].action}</span>
      </div>
    </div>
    <div class="wlc-quad__cell wlc-quad__media animate-on-scroll" data-animation="fadeInLeft">
      <div class="wlc-composite">
        <img class="wlc-composite__screen wlc-composite__screen--primary" src={flows[1].primary[0]} alt={flows[1].primary[1]} width={flows[1].primary[2]} height={flows[1].primary[3]} loading="lazy" />
        <img class="wlc-composite__screen wlc-composite__screen--secondary" src={flows[1].secondary[0]} alt={flows[1].secondary[1]} width={flows[1].secondary[2]} height={flows[1].secondary[3]} loading="lazy" />
        <span class="wlc-composite__status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>{flows[1].status}</span>
        <span class="wlc-composite__action">{flows[1].action}</span>
      </div>
    </div>
    <article class="wlc-quad__cell wlc-quad__copy animate-on-scroll" data-animation="fadeInUp">
      <h3>{flows[1].title}</h3>
      <p>{flows[1].text}</p>
    </article>
    <span class="wlc-quad__cross" aria-hidden="true">
      <svg width="18" height="18" viewBox="-14 -14 28 28">
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="scale(1,-1)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(90)"></path>
        <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e2e8f2" transform="rotate(-90)"></path>
      </svg>
    </span>
  </div>
  <p class="wlc-note">White label and custom domains are plan-gated. Confirm what your plan includes during the demo.</p>
</section>

<div class="wlc-dark-band">
  <div class="wlc-heading">
    <h2 class="animate-on-scroll" data-animation="fadeInUp">Keep Ownership, Access, and Usage <span>In One Context</span></h2>
    <p class="animate-on-scroll" data-animation="fadeInUp">White label is not only a logo field. The organization boundary carries teams, events, capabilities, metering, and account context.</p>
  </div>
  <section class="wlc-cap" aria-label="Platform boundaries">
    {capabilities.map((cap, index) => (
      <article class="wlc-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay={String((index % 3) * 60)}>
        <h3>{cap.title}</h3>
        <p>{cap.body}</p>
        <div class="wlc-cap__visual">
          {cap.rows && (
            <div class="wlc-cap__card">
              {cap.rows.map(([label, value]) => (<div class="wlc-cap__row"><span>{label}</span><b>{value}</b></div>))}
            </div>
          )}
          {cap.chips && (
            <div class="wlc-cap__chips">
              {cap.chips.map((chip, i) => (<span class:list={[{ "is-active": i === cap.active }]}>{chip}</span>))}
            </div>
          )}
          {cap.bars && (
            <div class="wlc-cap__card">
              {cap.bars.map(([label, pct]) => (<div class="wlc-cap__bar-row"><span>{label}</span><div class="wlc-cap__bar"><i style={`width: ${pct}%`}></i></div></div>))}
            </div>
          )}
        </div>
      </article>
    ))}
  </section>
</div>

<section class="wlc-workflow-section" aria-labelledby="wl-workflow-title">
  <div class="wlc-workflow-wrap">
    <header class="wlc-flow__header">
      <h2 id="wl-workflow-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">From Organization Record to Live Event Portfolio</h2>
    </header>

    <ol class="wlc-workflow">
      {workflow.map((step, index) => (
        <li>
          <details open={index === 0} data-wl-workflow-item>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
                <ul>
                  {step.bullets.map((bullet) => (
                    <li><i aria-hidden="true">&middot;</i>{bullet}</li>
                  ))}
                </ul>
              </div>
              <span class="wlc-workflow__chevron" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"></path></svg>
              </span>
            </summary>
            <div class="wlc-workflow__visual">
              {step.fields.map(([label, value]) => (
                <div><span>{label}</span><strong>{value}</strong></div>
              ))}
              <b>{step.status}</b>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="wlc-use" aria-labelledby="wl-audiences-title">
  <div class="wlc-use__shell">
    <h2 id="wl-audiences-title" class="wlc-flow__title animate-on-scroll" data-animation="fadeInUp">Built for Every Kind of <span>Distributed Event Business</span></h2>
    <div class="wlc-use__grid">
      {audiences.map((audience) => (
        <article class="wlc-use__card animate-on-scroll" data-animation="fadeInUp">
          <div class="wlc-use__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={audience.icon}></path></svg>
          </div>
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const whiteLabelWorkflowItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-wl-workflow-item]"));
  whiteLabelWorkflowItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      whiteLabelWorkflowItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>

<style>
  .wlc-flow { padding: clamp(56px, 7vw, 96px) 24px 24px; color: #22272f; }
  .wlc-flow__header { display: flex; flex-direction: column; align-items: center; max-width: 1100px; margin: 0 auto 24px; text-align: center; }
  .wlc-flow__title { margin: 0 0 12px; font-family: var(--font-heading); font-size: clamp(28px, 4.2vw, 48px); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; background: linear-gradient(98deg, var(--heading-dark, #1e1d24) 43%, #8f8f8f 92%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .wlc-flow__subtitle { max-width: 640px; margin: 0; color: var(--subheading-gray, #555); font-family: var(--font-body); font-size: 18px; line-height: 1.5; }
  .wlc-note { margin: 24px auto 0; color: #667085; text-align: center; font-family: var(--font-body); font-weight: 500; }

  .wlc-quad { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; width: 100%; max-width: 1180px; margin: 24px auto; }
  .wlc-quad__cross { position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; transform: translate(-50%, -50%); line-height: 0; pointer-events: none; z-index: 1; }
  .wlc-quad__cell { display: flex; flex-direction: column; justify-content: center; min-height: 260px; padding: 56px 48px; border-right: 1px solid #eef0f3; border-bottom: 1px solid #eef0f3; }
  .wlc-quad__cell:nth-child(2n) { border-right: none; }
  .wlc-quad__cell:nth-child(n + 3) { border-bottom: none; }
  .wlc-quad__copy h3 { margin: 0 0 16px; font-family: var(--font-heading); font-size: clamp(24px, 2.6vw, 32px); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; color: var(--heading-dark, #1e1d24); }
  .wlc-quad__copy p { max-width: 40ch; margin: 0; color: var(--subheading-gray, #555); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  .wlc-quad__media { align-items: center; min-height: 360px; padding: 18px 22px; overflow: hidden; }

  .wlc-composite { position: relative; width: 100%; height: 320px; }
  .wlc-composite__screen { position: absolute; display: block; object-fit: cover; object-position: top left; border: 1px solid rgba(209, 214, 226, .92); border-radius: 12px; background: #fff; box-shadow: 0 16px 34px rgba(31, 41, 72, .14); }
  .wlc-composite__screen--primary { top: 42px; left: 20px; z-index: 1; width: 74%; height: 62%; }
  .wlc-composite__screen--secondary { right: 18px; bottom: 20px; z-index: 2; width: 64%; height: 52%; }
  .wlc-composite__screen--detail { right: 18px; bottom: 12px; z-index: 3; width: 34%; height: 64%; object-position: top center; }
  .wlc-composite__status, .wlc-composite__action { position: absolute; z-index: 5; display: inline-flex; align-items: center; white-space: nowrap; border-radius: 10px; font-family: var(--font-body); font-size: 11px; font-weight: 700; line-height: 1; box-shadow: 0 10px 24px rgba(31, 41, 72, .16); }
  .wlc-composite__status { top: 14px; left: 14px; gap: 7px; padding: 9px 11px; border: 1px solid #cfead9; background: #effbf4; color: #18864b; }
  .wlc-composite__status svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .wlc-composite__action { left: 14px; bottom: 14px; padding: 10px 13px; background: #4b65f6; color: #fff; }

  .wlc-dark-band { position: relative; overflow: hidden; margin: 40px clamp(16px, 3.5vw, 56px) 0; padding: clamp(64px, 8vw, 96px) 24px; border-radius: 28px; background-color: #000; background-image: radial-gradient(130% 42% at 50% 0%, rgba(92, 138, 255, .22) 0%, rgba(124, 108, 255, .1) 45%, transparent 72%); background-repeat: no-repeat; }
  .wlc-heading { max-width: 900px; margin: 0 auto 48px; text-align: center; }
  .wlc-heading h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(32px, 4.4vw, 52px); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; background: linear-gradient(100deg, #fff 0%, #f2f0ff 26%, #c9c2ff 52%, #a79aff 74%, #7d8dff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .wlc-heading h2 span { background: none; -webkit-text-fill-color: transparent; }
  .wlc-heading p { max-width: 640px; margin: 18px auto 0; color: #a8a8b8; font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  .wlc-cap { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); max-width: 1180px; margin: 0 auto; border: 1px solid #3b3a47; border-radius: 16px; overflow: hidden; }
  .wlc-cap__cell { display: flex; flex-direction: column; min-height: 340px; padding: 36px 32px; border-right: 1px solid #3b3a47; border-bottom: 1px solid #3b3a47; }
  .wlc-cap__cell:nth-child(3n) { border-right: none; }
  .wlc-cap__cell:nth-child(n + 4) { border-bottom: none; }
  .wlc-cap__cell h3 { margin: 0 0 12px; color: #fff; font-family: var(--font-heading); font-size: 22px; font-weight: 600; line-height: 1.2; letter-spacing: -.02em; }
  .wlc-cap__cell p { margin: 0; color: #a8a8b8; font-family: var(--font-body); font-size: 15px; line-height: 1.6; }
  .wlc-cap__visual { margin-top: auto; padding-top: 28px; }
  .wlc-cap__card { display: grid; gap: 8px; padding: 14px; border: 1px solid #3b3a47; border-radius: 12px; background: rgba(255, 255, 255, .04); }
  .wlc-cap__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 11px; border-radius: 8px; background: rgba(255, 255, 255, .05); color: #d6d6e2; font-family: var(--font-body); font-size: 12px; }
  .wlc-cap__row b { color: #8fb0ff; font-size: 11px; font-weight: 700; text-align: right; }
  .wlc-cap__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wlc-cap__chips span { padding: 7px 12px; border: 1px solid #3b3a47; border-radius: 999px; color: #c8c8d6; font-family: var(--font-body); font-size: 12px; font-weight: 600; }
  .wlc-cap__chips span.is-active { border-color: #6d82ff; background: rgba(109, 130, 255, .18); color: #fff; }
  .wlc-cap__bar-row { display: grid; grid-template-columns: 78px 1fr; align-items: center; gap: 10px; color: #d6d6e2; font-family: var(--font-body); font-size: 12px; }
  .wlc-cap__bar { height: 6px; border-radius: 999px; background: rgba(255, 255, 255, .1); overflow: hidden; }
  .wlc-cap__bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #6d82ff, #a79aff); }

  .wlc-workflow-section { padding: clamp(72px, 8vw, 108px) 24px; }
  .wlc-workflow-wrap { width: min(880px, 100%); margin: 0 auto; }
  .wlc-workflow-wrap .wlc-flow__header { margin-bottom: 40px; }
  .wlc-workflow { display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .wlc-workflow details { overflow: hidden; border: 1px solid #e4e7ec; border-radius: 18px; background: #fff; transition: background .25s ease, border-color .25s ease; }
  .wlc-workflow details[open] { background: #e7ebf3; }
  .wlc-workflow summary { display: grid; grid-template-columns: 48px 1fr 30px; gap: 16px; align-items: start; padding: 22px; cursor: pointer; list-style: none; }
  .wlc-workflow summary::-webkit-details-marker { display: none; }
  .wlc-workflow summary > span:first-child { color: #7f8898; font-family: var(--font-heading); font-size: 20px; }
  .wlc-workflow h3 { margin: 0; font-family: var(--font-heading); font-size: 18px; line-height: 1.25; color: #22272f; }
  .wlc-workflow summary p { margin: 10px 0 0; color: #596579; font-family: var(--font-body); font-size: 14px; line-height: 1.55; }
  .wlc-workflow summary ul { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 14px 0 0; padding: 0; list-style: none; }
  .wlc-workflow summary ul li { color: #354053; font-family: var(--font-body); font-size: 12px; font-weight: 600; }
  .wlc-workflow summary ul i { margin-right: 4px; color: #375dfb; font-style: normal; }
  .wlc-workflow__chevron { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #fff; color: #22272f; }
  .wlc-workflow__chevron svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s ease; }
  .wlc-workflow details[open] .wlc-workflow__chevron svg { transform: rotate(180deg); }
  .wlc-workflow__visual { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 22px 22px 86px; }
  .wlc-workflow__visual > div { min-width: 0; padding: 12px; border-radius: 10px; background: #fff; }
  .wlc-workflow__visual span { display: block; color: #7f8898; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .wlc-workflow__visual strong { display: block; margin-top: 5px; color: #22272f; font-family: var(--font-body); font-size: 12px; overflow-wrap: anywhere; }
  .wlc-workflow__visual b { grid-column: 3; justify-self: end; padding: 6px 10px; border-radius: 999px; background: #dcecff; color: #2551d8; font-size: 10px; }

  .wlc-use { padding: 0 24px clamp(72px, 8vw, 108px); }
  .wlc-use__shell { width: min(1200px, 100%); margin: 0 auto; }
  .wlc-use__shell > .wlc-flow__title { margin: 0 auto 40px; text-align: center; }
  .wlc-use__shell > .wlc-flow__title span { background: none; -webkit-text-fill-color: transparent; }
  .wlc-use__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .wlc-use__card { padding: 32px; border: 1px solid #e5eaf3; border-radius: 24px; background: #f8faff; }
  .wlc-use__icon { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 28px; border-radius: 10px; background: #e9eeff; color: #375dfb; }
  .wlc-use__icon svg { width: 20px; height: 20px; }
  .wlc-use__card h3 { margin: 0 0 10px; color: var(--heading-dark, #1e1d24); font: 700 1.25rem/1.25 var(--font-heading); }
  .wlc-use__card p { margin: 0; color: var(--subheading-gray, #555); font-family: var(--font-body); line-height: 1.65; }

  @media (max-width: 1024px) {
    .wlc-cap { grid-template-columns: repeat(2, 1fr); }
    .wlc-cap__cell:nth-child(3n) { border-right: 1px solid #3b3a47; }
    .wlc-cap__cell:nth-child(2n) { border-right: none; }
    .wlc-cap__cell:nth-child(n + 4) { border-bottom: 1px solid #3b3a47; }
