---
const { part = "ab" } = Astro.props;
const base = "/feature-images/white-label/v5/";
---

{part === "ab" && (
  <>
    <!-- Per-event branding -->
    <div class="wlx ds-night">
      <section class="wlx__in" aria-labelledby="wlx-brand-title">
        <div class="wlx__copy animate-on-scroll" data-animation="fadeInUp">
          <span class="wlx__eyebrow">Per-event branding</span>
          <h2 id="wlx-brand-title" class="wlx__h2">Your Brand on <span class="ds-hl-dark">Every Event</span></h2>
          <p class="wlx__p">On a white-label plan, switch on branding for an event and set your own brand title and logo. They replace the EventHex footer on the event website, registration forms and tickets, and carry onto printed badges.</p>
        </div>
        <div class="wlx__media animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <div class="ds-browser">
            <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <video class="wlx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800"
              poster={`${base}branding-poster.webp`}
              aria-label="Demo: the Branding card on Event Info, Enable Branding switched on and the Brand Title Northgate Events Network typed in, above the Override Brand Logo upload">
              <source src={`${base}branding.webm`} type="video/webm" />
              <source src={`${base}branding.mp4`} type="video/mp4" />
            </video>
          </div>
        </div>
      </section>
    </div>

    <!-- Custom domain -->
    <div class="wlx ds-stage">
      <section class="wlx__in wlx__in--flip" aria-labelledby="wlx-domain-title">
        <div class="wlx__media animate-on-scroll" data-animation="fadeInUp">
          <div class="ds-glass wlx__glass">
            <div class="ds-browser">
              <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
              <video class="wlx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800"
                poster={`${base}domain-poster.webp`}
                aria-label="Demo: the Custom Domains tab of an event, from the empty Add Domain form to events.northgate-events.example.com verified and switched on, with Rename, Visit Site, QR Code and Remove">
                <source src={`${base}domain.webm`} type="video/webm" />
                <source src={`${base}domain.mp4`} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
        <div class="wlx__copy animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <span class="wlx__eyebrow">Custom domain</span>
          <h2 id="wlx-domain-title" class="wlx__h2">Put Every Event on <span class="ds-hl">Your Own Domain</span></h2>
          <p class="wlx__p">Add a custom domain to an event website, check that it is verified, and switch it on or off whenever you need to. The EventHex subdomain stays available. Custom domains depend on the organization's plan.</p>
        </div>
      </section>
    </div>
  </>
)}

{part === "c" && (
  <div class="wlx wlx--white">
    <section class="wlx__in wlx__in--wide" aria-labelledby="wlx-pay-title">
      <div class="wlx__copy animate-on-scroll" data-animation="fadeInUp">
        <span class="wlx__eyebrow">Payouts</span>
        <h2 id="wlx-pay-title" class="wlx__h2">Let Each Organization <span class="ds-hl">Get Paid Directly</span></h2>
        <p class="wlx__p">Each organization can connect its own Stripe account for bank payouts, set up Razorpay Route for split payments, or add its own gateway keys. Its events can then choose the organization payment option at checkout setup.</p>
        <p class="wlx__link">See also <a href="/event-payment-processing/">Payment Processing</a>.</p>
      </div>
      <div class="wlx__media animate-on-scroll" data-animation="fadeInUp" data-delay="80">
        <div class="ds-shot">
          <img src={`${base}payment.webp`} width="1820" height="1240" loading="lazy" decoding="async"
            alt="Organization Settings payment configuration: Enable Custom Payment Gateway, Stripe Connect bank account payouts with Connect with Stripe, and Razorpay Route split payments" />
        </div>
      </div>
    </section>
  </div>
)}

<style is:global>
  .wlx { position: relative; margin: 40px clamp(16px, 3.5vw, 56px) 0; border-radius: var(--ds-r-2xl); overflow: hidden; }
  .wlx.ds-stage { background: var(--ds-g4-stage); }
  .wlx--white { margin-inline: 0; border-radius: 0; background: var(--ds-white); }
  .wlx__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; max-width: var(--ds-container); margin: 0 auto; padding: clamp(64px, 8vw, 110px) var(--ds-gutter); box-sizing: content-box; }
  .wlx__in--flip { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  .wlx__in--wide { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .wlx__copy { display: flex; flex-direction: column; gap: 18px; }
  .wlx__eyebrow { font-size: 14px; font-weight: 500; color: var(--ds-blue); }
  .ds-night .wlx__eyebrow { color: var(--ds-on-night-accent); }
  .wlx__h2 { margin: 0; font-family: var(--ds-font-heading); font-size: var(--ds-h2); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--ds-ink); }
  .ds-night .wlx__h2 { color: var(--ds-on-night); }
  .wlx__h2 .ds-hl, .wlx__h2 .ds-hl-dark { -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .wlx__h2 .ds-hl { background-image: var(--ds-g1-text); }
  .wlx__h2 .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .wlx__p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--ds-body); }
  .ds-night .wlx__p { color: var(--ds-on-night-body); }
  .wlx__link { margin: 0; font-size: 14px; color: var(--ds-muted); }
  .wlx__link a { color: var(--ds-blue); text-decoration: underline; text-underline-offset: 3px; }
  .wlx__media { min-width: 0; }
  .wlx__glass { padding: 28px; }
  .wlx-loop { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) {
    .wlx { margin-inline: 12px; border-radius: var(--ds-r-xl); }
    .wlx--white { margin-inline: 0; border-radius: 0; }
    .wlx__in, .wlx__in--flip, .wlx__in--wide { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .wlx__in--flip .wlx__copy { order: -1; }
    .wlx__glass { padding: 12px; }
  }
</style>

<script>
  const wlxLoops = Array.from(document.querySelectorAll<HTMLVideoElement>('.wlx-loop'));
  const wlxReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wlxReduced) {
    wlxLoops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const wlxObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    wlxLoops.forEach((video) => wlxObserver.observe(video));
  }
</script>
