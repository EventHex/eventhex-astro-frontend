---
const stats = [
  { value: "500+", label: "Events Run on EventHex" },
  { value: "15+", label: "Countries" },
  { value: "Per-org", label: "Scoped Records" },
  { value: "Plan-aware", label: "Capability Control" },
];
---

<section class="wlh-hero ds-stage">
  <div class="wlh-hero__grid">
    <div class="wlh-hero__content">
      <div class="wlh-hero__badge animate-on-scroll" data-animation="fadeInDown">
        <span class="wlh-hero__badge-dot"></span>
        <span>White-Label Event Platform</span>
      </div>

      <h1 class="wlh-hero__title animate-on-scroll" data-animation="fadeInUp">
        <span class="wlh-hero__title-line">Run white-label event</span>
        <span class="wlh-hero__title-line"><span class="ds-hl">organizations from one</span></span>
        <span class="wlh-hero__title-line"><span class="ds-hl">platform workspace</span></span>
      </h1>

      <p class="wlh-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
        Give clients, chapters, or business units their own organization identity and event workspace while your platform team manages access, plan controls, usage, domains, and supported payment setup.
      </p>

      <div class="wlh-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
        <span class="wlh-hero__point">Organization-level brand settings</span>
        <span class="wlh-hero__point">Scoped teams and event records</span>
        <span class="wlh-hero__point">Plan-aware capability control</span>
      </div>

      <div class="wlh-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
        <a href="/book-a-demo/" class="ds-btn">Get a Free Demo</a>
        <a href="#wl-model" class="ds-btn--ghost">See the organization model</a>
      </div>
    </div>

    <div class="wlh-hero__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="wlh-hero__visual-card">
        <div class="wlh-hero__visual-inner" role="img" aria-label="EventHex white-label organization workspace showing brand, domains, clients, and scoped access">
          <div class="wlh-workspace">
            <div class="wlh-workspace__head">
              <span><i></i>EventHex &middot; White Label</span>
              <b>Control</b>
            </div>

            <div class="wlh-workspace__brand">
              <div class="wlh-workspace__logo">N</div>
              <div>
                <strong>Northstar Events Network</strong>
                <small>Platform owner &middot; Agency</small>
              </div>
              <span class="wlh-workspace__tag">Live</span>
            </div>

            <div class="wlh-workspace__settings">
              <div>
                <small>Primary color</small>
                <span class="wlh-workspace__swatches"><i></i><i></i><i></i></span>
              </div>
              <div>
                <small>Domain</small>
                <strong>events.northstar.example</strong>
              </div>
            </div>

            <div class="wlh-workspace__orgs">
              <article>
                <span>S</span>
                <strong>Summit Co</strong>
                <small>Client &middot; Blue brand</small>
              </article>
              <article>
                <span>A</span>
                <strong>Association</strong>
                <small>Client &middot; Green brand</small>
              </article>
              <article>
                <span>E</span>
                <strong>Enterprise</strong>
                <small>Unit &middot; Regional team</small>
              </article>
            </div>

            <div class="wlh-workspace__foot">
              <span>Plans + roles</span>
              <b>Scoped</b>
            </div>
          </div>

          <span class="wlh-status wlh-status--verified">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
            Domain verified
          </span>
          <span class="wlh-status wlh-status--access">Access scoped</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="wlh-trust" aria-label="White-label platform results">
  <div class="wlh-trust__inner">
    <span class="wlh-trust__label">Trusted By Event Teams</span>
    {stats.map((stat) => (
      <span class="wlh-trust__stat"><b>{stat.value}</b> {stat.label}</span>
    ))}
  </div>
</section>

<style>
  .wlh-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, color-mix(in srgb, var(--ds-blue) 14%, transparent), color-mix(in srgb, var(--ds-blue) 6%, transparent) 40%, color-mix(in srgb, var(--ds-blue) 0%, transparent) 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, rgba(255, 116, 184, 0.24), rgba(255, 116, 184, 0.1) 45%, rgba(255, 116, 184, 0) 78%),
      var(--ds-white);
  }

  .wlh-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.45) 70%, rgba(255, 255, 255, 0.75));
    pointer-events: none;
    z-index: 2;
  }

  .wlh-hero__grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }

  .wlh-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    text-align: left;
  }

  .wlh-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--brand-blue);
    text-transform: uppercase;
  }

  .wlh-hero__badge-dot {
    display: none;
  }

  .wlh-hero__title {
    margin: 0;
    width: 100%;
    max-width: 620px;
    font-family: var(--font-heading);
    font-size: 52px;
    font-weight: 500;
    line-height: 58px;
    letter-spacing: -2.1px;
    background: linear-gradient(98deg, var(--heading-dark) 43.06%, var(--ds-label) 91.81%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .wlh-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .wlh-hero__desc {
    margin: 0;
    width: 100%;
    max-width: 560px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.25px;
    color: var(--subheading-gray);
  }

  .wlh-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .wlh-hero__point {
    position: relative;
    padding-left: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--ds-sub);
  }

  .wlh-hero__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .wlh-hero__cta {
    display: flex;
    gap: 14px;
    padding-top: 6px;
  }

  .wlh-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 32px;
    border-radius: 10px;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    transition: transform 0.3s, background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .wlh-hero__btn--primary {
    color: var(--ds-white);
    background: var(--heading-dark);
  }

  .wlh-hero__btn--primary:hover {
    transform: translateY(-2px);
    background: var(--ds-black);
  }

  .wlh-hero__btn--secondary {
    color: var(--heading-dark);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--ds-surface-tint);
  }

  .wlh-hero__btn--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--ds-on-night-body);
    box-shadow: 0 10px 24px rgba(34, 39, 47, 0.06);
  }

  .wlh-hero__visual {
    position: relative;
    margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px));
    z-index: 3;
  }

  .wlh-hero__visual-card {
    position: relative;
    padding: 14px;
    border-radius: 22px 0 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-right: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.28)), rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .wlh-hero__visual-inner {
    position: relative;
    min-height: 430px;
    border-radius: 16px 0 0 16px;
    overflow: hidden;
    padding: 28px;
    background: linear-gradient(135deg, var(--ds-cat-sky-bg), var(--ds-surface-tab) 45%, var(--ds-white));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .wlh-workspace {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 14px;
    height: 100%;
    padding: 20px 20px 88px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 14px;
    background: var(--ds-white);
    box-shadow: 0 24px 58px rgba(29, 61, 179, 0.12);
  }

  .wlh-workspace__head,
  .wlh-workspace__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ds-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wlh-workspace__head span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .wlh-workspace__head i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-blue);
  }

  .wlh-workspace__head b,
  .wlh-workspace__foot b {
    color: var(--brand-blue);
  }

  .wlh-workspace__brand {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .wlh-workspace__logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--ds-night-2);
    color: var(--ds-white);
    font-family: var(--font-heading);
    font-size: 21px;
  }

  .wlh-workspace__brand strong,
  .wlh-workspace__settings strong {
    display: block;
    color: var(--ds-ink);
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.2;
  }

  .wlh-workspace__brand small,
  .wlh-workspace__settings small,
  .wlh-workspace__orgs small {
    display: block;
    margin-top: 3px;
    color: var(--ds-label);
    font-size: 10px;
    line-height: 1.3;
  }

  .wlh-workspace__tag {
    padding: 5px 8px;
    border-radius: 999px;
    background: var(--ds-surface-tab);
    color: var(--ds-cat-green);
    font-size: 9px;
    font-weight: 700;
  }

  .wlh-workspace__settings {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 10px;
  }

  .wlh-workspace__settings > div {
    padding: 12px;
    border: 1px solid var(--ds-line);
    border-radius: 10px;
    background: var(--ds-surface);
  }

  .wlh-workspace__settings strong {
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .wlh-workspace__swatches {
    display: flex;
    gap: 5px;
    margin-top: 8px;
  }

  .wlh-workspace__swatches i {
    width: 16px;
    height: 16px;
    border-radius: 5px;
  }

  .wlh-workspace__swatches i:nth-child(1) { background: var(--ds-night-2); }
  .wlh-workspace__swatches i:nth-child(2) { background: var(--ds-blue); }
  .wlh-workspace__swatches i:nth-child(3) { background: var(--ds-success); }

  .wlh-workspace__orgs {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .wlh-workspace__orgs article {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 10px 11px;
    border: 1px solid var(--ds-line);
    border-radius: 10px;
    background: var(--ds-white);
  }

  .wlh-workspace__orgs span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--ds-line);
    color: var(--brand-blue);
    font-size: 12px;
    font-weight: 750;
  }

  .wlh-workspace__orgs article:nth-child(2) span {
    background: var(--ds-surface-tab);
    color: var(--ds-cat-green);
  }

  .wlh-workspace__orgs article:nth-child(3) span {
    background: var(--ds-surface-tab);
    color: var(--ds-cat-amber);
  }

  .wlh-workspace__orgs strong {
    color: var(--ds-ink);
    font-family: var(--font-heading);
    font-size: 13px;
  }

  .wlh-workspace__orgs small {
    margin: 0;
    text-align: right;
  }

  .wlh-workspace__foot {
    padding-top: 10px;
    border-top: 1px solid var(--ds-line);
  }

  .wlh-status {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    background: var(--ds-white);
    color: var(--ds-ink-2);
    box-shadow: 0 12px 30px rgba(29, 61, 179, 0.12);
    font-size: 10px;
    font-weight: 650;
  }

  .wlh-status svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--ds-cat-green);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wlh-status--verified {
    right: 18px;
    bottom: 70px;
  }

  .wlh-status--access {
    right: 34px;
    bottom: 24px;
    color: var(--brand-blue);
  }

  .wlh-trust {
    border-top: 1px solid var(--ds-line);
    border-bottom: 1px solid var(--ds-line);
  }

  .wlh-trust__inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 36px;
  }

  .wlh-trust__label,
  .wlh-trust__stat {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ds-muted);
  }

  .wlh-trust__label {
    color: var(--ds-label);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wlh-trust__stat b {
    color: var(--ds-ink);
    font-weight: 750;
  }

  @media (max-width: 1120px) {
    .wlh-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: 32px;
    }
    .wlh-hero__title {
      font-size: 44px;
      line-height: 50px;
    }
  }

  @media (max-width: 960px) {
    .wlh-hero {
      padding: 130px 20px 48px;
    }
    .wlh-hero::after {
      display: none;
    }
    .wlh-hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .wlh-hero__content {
      align-items: center;
    }
    .wlh-hero__points,
    .wlh-hero__cta {
      justify-content: center;
    }
    .wlh-hero__visual {
      margin-right: 0;
    }
    .wlh-hero__visual-card {
      border-radius: 22px;
      border-right: 1px solid rgba(255, 255, 255, 0.62);
    }
    .wlh-hero__visual-inner {
      border-radius: 16px;
    }
  }

  @media (max-width: 767px) {
    .wlh-hero {
      margin-top: -80px;
      padding: 112px 16px 40px;
    }
    .wlh-hero__title {
      font-size: 33px;
      line-height: 40px;
      letter-spacing: -0.8px;
    }
    .wlh-hero__title-line {
      white-space: normal;
    }
    .wlh-hero__cta {
      width: 100%;
      flex-direction: column;
    }
    .wlh-hero__btn {
      width: 100%;
    }
    .wlh-hero__visual-inner {
      min-height: 0;
      padding: 16px;
    }
    .wlh-workspace__settings {
      grid-template-columns: 1fr;
    }
    .wlh-workspace__orgs article {
      grid-template-columns: 30px 1fr;
    }
    .wlh-workspace__orgs small {
      grid-column: 2;
      text-align: left;
    }
    .wlh-status--verified {
      right: 10px;
      bottom: 82px;
    }
    .wlh-status--access {
      right: 22px;
      bottom: 38px;
    }
    .wlh-trust__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 24px;
      padding: 22px 0;
    }
    .wlh-trust__label {
      grid-column: 1 / -1;
    }
  }

  /* ===== EventHex design system v5 overrides ===== */
  .wlh-hero { background: var(--ds-g4-stage); }
  .wlh-hero::after { display: none; }
  .wlh-hero__badge { font-size: 14px; letter-spacing: .01em; }
  .wlh-hero__title { background: none; color: var(--ds-ink); letter-spacing: -0.035em; font-weight: 500; }
  .wlh-hero__title .ds-hl { background-image: var(--ds-g1-text); color: transparent; }
  .wlh-hero__visual-card { border-radius: var(--ds-r-xl) 0 0 var(--ds-r-xl); }
  /* status chips: calm inline row under the workspace instead of floating over it */
  .wlh-hero__visual-inner { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 10px; }
  .wlh-workspace { flex: 0 0 100%; padding-bottom: 20px; height: auto; }
  .wlh-status { position: static; box-shadow: none; border-color: var(--ds-line-strong); }
  @media (max-width: 960px) { .wlh-hero__title .ds-hl { display: inline; } }
</style>
