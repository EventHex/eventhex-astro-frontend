---
const stats = [
  { value: "500+", label: "Events Run on EventHex" },
  { value: "15+", label: "Countries" },
  { value: "Per-org", label: "Scoped Records" },
  { value: "Plan-aware", label: "Capability Control" },
];
---

<section class="wlh-hero ds-stage">
  <div class="wlh-hero__grid">
    <div class="wlh-hero__content">
      <div class="wlh-hero__badge animate-on-scroll" data-animation="fadeInDown">
        <span class="wlh-hero__badge-dot"></span>
        <span>White-Label Event Platform</span>
      </div>

      <h1 class="wlh-hero__title animate-on-scroll" data-animation="fadeInUp">
        <span class="wlh-hero__title-line">Run white-label event</span>
        <span class="wlh-hero__title-line"><span class="ds-hl">organizations from one</span></span>
        <span class="wlh-hero__title-line"><span class="ds-hl">platform workspace</span></span>
      </h1>

      <p class="wlh-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
        Give clients, chapters, or business units their own organization identity and event workspace while your platform team manages access, plan controls, usage, domains, and supported payment setup.
      </p>

      <div class="wlh-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
        <span class="wlh-hero__point">Organization-level brand settings</span>
        <span class="wlh-hero__point">Scoped teams and event records</span>
        <span class="wlh-hero__point">Plan-aware capability control</span>
      </div>

      <div class="wlh-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
        <a href="/book-a-demo/" class="ds-btn">Get a Free Demo</a>
        <a href="#wl-model" class="ds-btn--ghost">See the organization model</a>
      </div>
    </div>

    <div class="wlh-hero__visual animate-on-scroll" data-animation="fadeInRight">
      <div class="ds-browser wlh-browser">
        <div class="ds-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <video class="wlh-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="800"
          poster="/feature-images/white-label/v5/hero-org-setup-poster.webp"
          aria-label="Animated demo: the Admin Console organizations list, Edit Organization for Northgate Events Network, the Enable White Label checkbox being ticked, the organization overview with plan, limits and features, and the custom domain on an event">
          <source src="/feature-images/white-label/v5/hero-org-setup.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<section class="wlh-trust" aria-label="White-label platform results">
  <div class="wlh-trust__inner">
    <span class="wlh-trust__label">Trusted By Event Teams</span>
    {stats.map((stat) => (
      <span class="wlh-trust__stat"><b>{stat.value}</b> {stat.label}</span>
    ))}
  </div>
</section>

<script>
  // Play the hero loop only while it is on screen; keep it paused for reduced motion.
  const wlhLoops = Array.from(document.querySelectorAll<HTMLVideoElement>(".wlh-loop"));
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    wlhLoops.forEach((video) => { video.removeAttribute("autoplay"); video.pause(); video.controls = true; });
  } else if ("IntersectionObserver" in window) {
    const wlhObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    wlhLoops.forEach((video) => wlhObserver.observe(video));
  }
</script>

<style>
  .wlh-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, color-mix(in srgb, var(--ds-blue) 14%, transparent), color-mix(in srgb, var(--ds-blue) 6%, transparent) 40%, color-mix(in srgb, var(--ds-blue) 0%, transparent) 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, rgba(255, 116, 184, 0.24), rgba(255, 116, 184, 0.1) 45%, rgba(255, 116, 184, 0) 78%),
      var(--ds-white);
  }

  .wlh-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.45) 70%, rgba(255, 255, 255, 0.75));
    pointer-events: none;
    z-index: 2;
  }

  .wlh-hero__grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }

  .wlh-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    text-align: left;
  }

  .wlh-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--brand-blue);
    text-transform: uppercase;
  }

  .wlh-hero__badge-dot {
    display: none;
  }

  .wlh-hero__title {
    margin: 0;
    width: 100%;
    max-width: 620px;
    font-family: var(--font-heading);
    font-size: 52px;
    font-weight: 500;
    line-height: 58px;
    letter-spacing: -2.1px;
    background: linear-gradient(90deg, var(--ds-ink), var(--ds-ink));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .wlh-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .wlh-hero__desc {
    margin: 0;
    width: 100%;
    max-width: 560px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.25px;
    color: var(--subheading-gray);
  }

  .wlh-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .wlh-hero__point {
    position: relative;
    padding-left: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--ds-sub);
  }

  .wlh-hero__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ds-success);
  }

  .wlh-hero__cta {
    display: flex;
    gap: 14px;
    padding-top: 6px;
  }

  .wlh-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 32px;
    border-radius: 10px;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    transition: transform 0.3s, background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .wlh-hero__btn--primary {
    color: var(--ds-white);
    background: var(--heading-dark);
  }

  .wlh-hero__btn--primary:hover {
    transform: translateY(-2px);
    background: var(--ds-black);
  }

  .wlh-hero__btn--secondary {
    color: var(--heading-dark);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--ds-surface-tint);
  }

  .wlh-hero__btn--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--ds-on-night-body);
    box-shadow: 0 10px 24px rgba(34, 39, 47, 0.06);
  }

  .wlh-trust {
    border-top: 1px solid var(--ds-line);
    border-bottom: 1px solid var(--ds-line);
  }

  .wlh-trust__inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 36px;
  }

  .wlh-trust__label,
  .wlh-trust__stat {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ds-muted);
  }

  .wlh-trust__label {
    color: var(--ds-label);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wlh-trust__stat b {
    color: var(--ds-ink);
    font-weight: 750;
  }

  @media (max-width: 1120px) {
    .wlh-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: 32px;
    }
    .wlh-hero__title {
      font-size: 44px;
      line-height: 50px;
    }
  }

  @media (max-width: 960px) {
    .wlh-hero {
      padding: 130px 20px 48px;
    }
    .wlh-hero::after {
      display: none;
    }
    .wlh-hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .wlh-hero__content {
      align-items: center;
    }
    .wlh-hero__points,
    .wlh-hero__cta {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .wlh-hero {
      margin-top: -80px;
      padding: 112px 16px 40px;
    }
    .wlh-hero__title {
      font-size: 33px;
      line-height: 40px;
      letter-spacing: -0.8px;
    }
    .wlh-hero__title-line {
      white-space: normal;
    }
    .wlh-hero__cta {
      width: 100%;
      flex-direction: column;
    }
    .wlh-hero__btn {
      width: 100%;
    }
    .wlh-trust__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 24px;
      padding: 22px 0;
    }
    .wlh-trust__label {
      grid-column: 1 / -1;
    }
  }

  /* ===== EventHex design system v5 overrides ===== */
  .wlh-hero { background: var(--ds-g4-stage); }
  .wlh-hero::after { display: none; }
  .wlh-hero__badge { font-size: 14px; letter-spacing: .01em; }
  .wlh-hero__title { background: none; color: var(--ds-ink); letter-spacing: -0.035em; font-weight: 500; }
  .wlh-hero__title .ds-hl { background-image: var(--ds-g1-text); color: transparent; }
  .wlh-hero__visual { position: relative; z-index: 3; min-width: 0; }
  .wlh-loop { display: block; width: 100%; height: auto; background: var(--ds-surface); }
  @media (max-width: 960px) { .wlh-hero__title .ds-hl { display: inline; } }
</style>
