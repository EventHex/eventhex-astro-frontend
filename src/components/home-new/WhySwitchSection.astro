  noDownload: `<svg width="24" height="24" viewBox="0 0 511.02 511.02" fill="currentColor"><path d="M510.64,239.7l.38,30.79-.84,4.53c-9.44,125.57-109.67,225.4-235.18,235.17l-3.52.83-31.3-.44C99.16,501.7-7.45,381.11.41,241.36,8.36,99.81,129.59-7.57,270.35.42c129.3,7.34,232.13,110.82,240.3,239.28ZM268.96,345.14l85.99-85.9c8.33-8.32,6.55-22.01-1.17-29.43-7.91-7.61-20.25-8.06-28.76-.6l-48.14,47.96-.18-189.24c-.01-11.99-11.11-20.37-21.61-20.11-11.15.28-20.8,9.12-20.8,21.11l-.1,188.29-47.69-47.46c-8.54-8.14-21.29-7.9-29.48-.09-7.59,7.24-9.64,20.89-1.46,29.08l86.27,86.27c6.67,6.67,19.89,7.34,27.12.12ZM339.81,420.07c12.83,0,21.21-11.19,20.74-22.25-.48-11.05-9.35-20.28-21.32-20.28l-168.35.05c-12.28,0-20.88,11-20.39,22.07s9.28,20.45,21.29,20.45l168.04-.05Z"/></svg>`,
