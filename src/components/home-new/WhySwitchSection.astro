};

const items = [
  {
    icon: "timer",
    statLine1: "Live in Under",
    statLine2: "3 Minutes",
    desc: "Event, website, tickets, registration. Launched in one sitting. No agency, no implementation project.",
  },
  {
    icon: "dollar",
    statLine1: "Keep 100% of Ticket",
    statLine2: "Revenue",
    desc: "Your own Stripe, Razorpay, or Tap account. 0% platform fees. Every rupee, dirham, and dollar stays yours.",
  },
  {
    icon: "noDownload",
    statLine1: "Attendees Download",
    statLine2: "Nothing",
    desc: "Web app in the browser, concierge in WhatsApp. The event comes to them, not the other way around.",
  },
  {
    icon: "sparkle",
    statLine1: "One Copilot Runs",
    statLine2: "It All",
    desc: 'Ask in plain language: "How are VIP sales?" "Add a lunch break at 1." "Write the invite email." Done.',
  },
];
---

<section class="why-switch">
  <div class="why-switch__inner">
    <div class="why-switch__header">
      <h2 class="why-switch__title">Why event teams switch to <span class="why-switch__title-break">EventHex</span></h2>
    </div>
    <div class="why-switch__grid">
      <div class="why-switch__notch why-switch__notch--1" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
        </svg>
      </div>
      <div class="why-switch__notch why-switch__notch--2" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
        </svg>
      </div>
      <div class="why-switch__notch why-switch__notch--3" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
        </svg>
      </div>
      {items.map((item, i) => (
        <div class:list={["why-switch__col", i === 0 && "why-switch__col--first", i % 2 === 0 && "why-switch__col--row-start", i >= 2 && "why-switch__col--row2"]}>
          {i === 2 && (
            <span class="why-switch__cross" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" />
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" />
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" />
              </svg>
            </span>
          )}
          <span class="why-switch__icon" set:html={ICONS[item.icon]} />
          <h3 class="why-switch__stat">{item.statLine1} <span class="why-switch__stat-break">{item.statLine2}</span></h3>
          <p class="why-switch__desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-switch {
    background:
      radial-gradient(ellipse 75% 68% at 50% 40%, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.65) 38%, rgba(255, 255, 255, 0.28) 58%, transparent 78%),
      linear-gradient(to bottom, #fff 0, rgba(255, 255, 255, 0.85) 130px, rgba(255, 255, 255, 0.5) 260px, rgba(255, 255, 255, 0.18) 390px, transparent 500px),
      linear-gradient(to top, #fff 0, rgba(255, 255, 255, 0.7) 70px, rgba(255, 255, 255, 0.3) 130px, transparent 190px),
      radial-gradient(circle 380px at 3% 34%, rgba(175, 163, 255, 0.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 30%, rgba(255, 182, 213, 0.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 75%, rgba(130, 170, 255, 0.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 78%, rgba(255, 224, 150, 0.20) 0%, transparent 100%),
      #ffffff;
    padding: 0 24px;
  }
  .why-switch__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 88px 0 96px;
    position: relative;
  }
  .why-switch__header {
    margin-bottom: 64px;
    text-align: center;
  }
  .why-switch__title {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    background: linear-gradient(180deg, var(--heading-dark) 0%, #8A8F98 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }
  .why-switch__title-break {
    display: block;
  }
  .why-switch__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--surface-card-border);
  }
  .why-switch__col {
    position: relative;
    border-left: 1px solid var(--surface-card-border);
    padding: 28px;
  }
  .why-switch__cross {
    display: none;
  }
  .why-switch__col--first {
    border-left: none;
  }
  .why-switch__notch {
    position: absolute;
    top: 0;
    width: 28px;
    height: 28px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    line-height: 0;
    z-index: 2;
  }
  .why-switch__notch--1 { left: 25%; }
  .why-switch__notch--2 { left: 50%; }
  .why-switch__notch--3 { left: 75%; }
  .why-switch__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue);
    margin-bottom: 28px;
  }
  .why-switch__stat {
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 600;
    color: var(--heading-dark);
    line-height: 1.25;
    max-width: 230px;
    margin: 0 0 28px;
  }
  .why-switch__stat-break {
    display: block;
  }
  .why-switch__desc {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--body-gray);
    line-height: 1.4;
    margin: 14px 0 0;
  }

  @media (max-width: 1024px) {
    .why-switch__grid { grid-template-columns: repeat(2, 1fr); }
    .why-switch__notch--1,
    .why-switch__notch--3 { display: none; }
    .why-switch__col--row-start { border-left: none; }
    .why-switch__col--row2 { border-top: 1px solid var(--surface-card-border); }
    .why-switch__cross {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 28px;
      height: 28px;
      transform: translate(50%, -50%);
      pointer-events: none;
      line-height: 0;
      z-index: 2;
    }
  }

  @media (max-width: 820px) {
    .why-switch__title { font-size: 32px; }
  }

  @media (max-width: 640px) {
    .why-switch { padding: 0 20px; }
    .why-switch__inner { padding: 44px 0 52px; }
    .why-switch__title { font-size: 28px; }
    .why-switch__grid { grid-template-columns: 1fr; }
    .why-switch__col { border-left: none !important; border-top: 1px solid var(--surface-card-border); }
    .why-switch__col--first { border-top: none; }
    .why-switch__cross { display: none; }
    .why-switch__notch--2 { display: none; }
  }
</style>
