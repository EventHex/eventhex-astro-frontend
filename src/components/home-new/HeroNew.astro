    background: linear-gradient(to top, transparent 0%, rgba(190, 195, 230, 0.16) 12%, rgba(190, 195, 230, 0.24) 45%, rgba(190, 195, 230, 0.08) 75%, transparent 100%);
  }
  .beam-line::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -140px;
    width: 2px;
    height: 140px;
    transform: translateX(-50%);
    background: linear-gradient(to top, transparent, rgba(120, 170, 255, 0.7) 50%, transparent 100%);
    animation: beam-rise var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes beam-rise {
    0% { bottom: -140px; opacity: 0; }
    30% { opacity: 1; }
    80% { opacity: 1; }
    100% { bottom: 100%; opacity: 0; }
  }

  /* soft floating white dot particles */
  .particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.6);
    animation: particle-drift var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes particle-drift {
    0%, 100% { transform: translate(0, 0); opacity: 0.5; }
    50% { transform: translate(10px, -14px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle { animation: none; }
    .beam-line::after { animation: none; opacity: 0; }
  }

