---
// Source: Elementor Container ddefb0d (depth 0)
// Background: Untitled-design-11.webp, boxed 1140px, padding 60px 0
// Children:
//   a557308: button "Explore More" — hidden on all breakpoints
//   dfd01e5: heading "Your Countless Events Begin Here" — Manrope 48px/500, 50% width
//   9ca0129: loop-carousel — template 1267, 15px gap, dots #375DFB
// Template 1267 card structure:
//   featured image 250px tall
//   top meta row: category + date
//   title: Manrope 22px/30px/500
//   bottom meta row: authors taxonomy + linked arrow icon

interface WPPost {
  id: number;
  title: { rendered: string };
  link: string;
  date: string;
  _embedded?: {
    author?: Array<{ name: string }>;
    'wp:featuredmedia'?: Array<{ source_url: string; alt_text: string }>;
    'wp:term'?: Array<Array<{ name: string; taxonomy?: string }>>;
  };
}

const WP_URL = import.meta.env.WP_URL || 'https://cms.eventhex.ai';
let posts: WPPost[] = [];

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));

const getFirstTerm = (post: WPPost, taxonomy: string) =>
  post._embedded?.['wp:term']
    ?.flat()
    .find((term) => term.taxonomy === taxonomy)
    ?.name;

try {
  const res = await fetch(`${WP_URL}/wp-json/wp/v2/posts?per_page=6&_embed&_fields=id,title,link,date,slug,_embedded,_links`);
  if (res.ok) posts = await res.json();
} catch {}
---

<section class="blog-section" id="home-blog-carousel-root">
 <div class="blog-section__inner">
  <div class="blog-header">
    <h2 class="blog-title">Your Countless Events Begin Here</h2>
    <div class="blog-nav">
      <button type="button" class="blog-nav__btn" data-dir="prev" aria-label="Previous posts">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="blog-nav__btn" data-dir="next" aria-label="Next posts">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <div class="blog-grid" data-blog-track>
    {posts.map((post, index) => {
      const img = post._embedded?.['wp:featuredmedia']?.[0];
      const imageOverride = index === 0
        ? '/blog-images/badge-printing-system.webp'
        : index === 1
        ? '/blog-images/accessible-events.webp'
        : index === 2
        ? '/blog-images/registration-forms-friction.webp'
        : null;
      const category = getFirstTerm(post, 'category') ?? 'Uncategorized';
      const formattedDate = formatDate(post.date);
      const articleHref = `/blog/${post.slug}/`;

      return (
        <article class="blog-card">
          <a href={articleHref} class="blog-card__img">
            {(imageOverride || img) && (
              <img
                src={imageOverride || img!.source_url}
                alt={img?.alt_text || post.title.rendered}
                loading="lazy"
              />
            )}
          </a>

          <div class="blog-card__meta">
            <span class="blog-card__category">{category}</span>
            <span class="blog-card__meta-right">
              <span class="blog-card__dot"></span>
              <span class="blog-card__date">{formattedDate}</span>
            </span>
          </div>

          <h3 class="blog-card__title">
            <a href={articleHref} set:html={post.title.rendered} />
          </h3>
        </article>
      );
    })}
  </div>
 </div>
</section>

<style>
  .blog-section {
    width: 100%;
    padding: 60px 0 70px;
    position: relative;
    background:
      radial-gradient(ellipse 55% 50% at 50% 50%, rgba(255, 255, 255, 0.9) 0%, transparent 70%),
      linear-gradient(to bottom, #fff 0px, transparent 110px, transparent calc(100% - 110px), #fff 100%),
      radial-gradient(circle 380px at 3% 25%, rgba(175, 163, 255, 0.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 22%, rgba(255, 182, 213, 0.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 78%, rgba(130, 170, 255, 0.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 80%, rgba(255, 224, 150, 0.20) 0%, transparent 100%),
      #ffffff;
  }
  .blog-section__inner {
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .blog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 40px;
  }

  .blog-title {
    font-family: 'Creato Display', var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #000;
    margin: 0;
    max-width: 50%;
  }

  .blog-nav {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .blog-nav__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #E4E7EC;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #000;
    transition: background 0.2s, border-color 0.2s;
  }

  .blog-nav__btn:hover {
    background: #f5f6f8;
    border-color: #d0d5dd;
  }

  .blog-grid {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .blog-grid::-webkit-scrollbar {
    display: none;
  }

  .blog-card {
    color: inherit;
    min-width: 0;
    flex: 0 0 calc((100% - 64px) / 3);
    scroll-snap-align: start;
  }

  .blog-card__img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0;
  }

  .blog-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card__img img {
    transform: scale(1.04);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 20px 0 12px;
  }

  .blog-card__category {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: capitalize;
    color: #667085;
  }

  .blog-card__meta-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .blog-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: #375DFB;
    flex-shrink: 0;
  }

  .blog-card__date {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: #667085;
  }

  .blog-card__title {
    margin: 0;
  }

  .blog-card__title :global(a),
  .blog-card__title a {
    font-family: 'Creato Display', var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: #000;
    text-decoration: none;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .blog-section {
      padding: 50px 20px 60px;
    }
    .blog-section__inner {
      max-width: 100%;
    }

    .blog-title {
      font-size: 32px;
      line-height: 1.2em;
    }

    .blog-grid {
      gap: 24px;
    }

    .blog-card {
      flex: 0 0 calc((100% - 24px) / 2);
    }

    .blog-card__title :global(a),
    .blog-card__title a {
      font-size: 17px;
    }
  }

  @media (max-width: 767px) {
    .blog-section {
      padding: 40px 16px 50px;
    }
    .blog-section__inner {
      max-width: 100%;
    }

    .blog-header {
      flex-wrap: wrap;
    }

    .blog-title {
      font-size: 28px;
      line-height: 1.2em;
      max-width: 100%;
      letter-spacing: 0;
    }

    .blog-grid {
      gap: 20px;
    }

    .blog-card {
      flex: 0 0 85%;
    }

    .blog-card__title :global(a),
    .blog-card__title a {
      font-size: 16px;
      line-height: 1.35;
    }
  }
</style>

<script>
  const root = document.getElementById('home-blog-carousel-root');
  const track = root?.querySelector('[data-blog-track]') as HTMLElement | null;
  const prevBtn = root?.querySelector('.blog-nav__btn[data-dir="prev"]') as HTMLButtonElement | null;
  const nextBtn = root?.querySelector('.blog-nav__btn[data-dir="next"]') as HTMLButtonElement | null;

  if (track && prevBtn && nextBtn) {
    const scrollByCard = (dir: number) => {
      const card = track.querySelector('.blog-card') as HTMLElement | null;
      const cardWidth = card?.getBoundingClientRect().width ?? track.clientWidth / 3;
      const styles = window.getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '0');
      track.scrollBy({ left: dir * (cardWidth + gap), behavior: 'smooth' });
    };

    prevBtn.addEventListener('click', () => scrollByCard(-1));
    nextBtn.addEventListener('click', () => scrollByCard(1));
  }
</script>
