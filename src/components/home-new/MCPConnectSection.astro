<script>
  function initMcpPin() {
    const section = document.querySelector('[data-mcp-pin]');
    const track = document.querySelector('[data-mcp-track]');
    const mask = section ? section.querySelector('.mcp-track-mask') : null;
    if (!section || !track || !mask) return;

    const mq = window.matchMedia('(min-width: 1025px)');
    let maxTranslate = 0;
    let ticking = false;

    function measure() {
      if (!mq.matches) {
        section.style.height = '';
        track.style.transform = '';
        maxTranslate = 0;
        return;
      }
      const maskStyle = window.getComputedStyle(mask);
      const maskPadding = parseFloat(maskStyle.paddingLeft) + parseFloat(maskStyle.paddingRight);
      maxTranslate = Math.max(0, track.scrollWidth - (mask.clientWidth - maskPadding));
      section.style.height = `${window.innerHeight + maxTranslate}px`;
      onScroll();
    }

    function onScroll() {
      if (!mq.matches || maxTranslate <= 0) return;
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, -rect.top / maxTranslate));
        track.style.transform = `translateX(${-progress * maxTranslate}px)`;
        ticking = false;
      });
    }

    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);
    window.addEventListener('scroll', onScroll, { passive: true });
    if (mq.addEventListener) {
      mq.addEventListener('change', measure);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMcpPin);
  } else {
    initMcpPin();
  }
</script>

<script>
  function initMcpTyping() {
    const body = document.querySelector('.mcp-terminal__body');
    const card = body ? body.closest('.mcp-card') : null;
    const terminalEl = card ? card.querySelector('.mcp-terminal') : null;
    const promptEl = body ? body.querySelector('.mcp-terminal__prompt') : null;
    const resultEl = body ? body.querySelector('.mcp-terminal__result') : null;
    if (!body || !card || !terminalEl || !promptEl || !resultEl) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      terminalEl.classList.add('mcp-terminal--in');
      return;
    }

    const lines = Array.from(body.querySelectorAll('.mcp-terminal__line'));

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function wrapChars(node, skipSelectors) {
      const spans = [];
      Array.from(node.childNodes).forEach((child) => {
        if (child.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          for (const ch of child.textContent) {
            const span = document.createElement('span');
            span.className = 'tw-char';
            span.textContent = ch;
            frag.appendChild(span);
            spans.push(span);
          }
          node.replaceChild(frag, child);
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          if (skipSelectors.some((sel) => child.matches(sel))) return;
          spans.push(...wrapChars(child, skipSelectors));
        }
      });
      return spans;
    }

    async function typeSpans(spans, cursor, speed) {
      if (!spans.length) return;
      spans[0].parentNode.insertBefore(cursor, spans[0]);
      for (const span of spans) {
        span.classList.add('tw-visible');
        span.insertAdjacentElement('afterend', cursor);
        await sleep(speed + Math.random() * speed * 0.8);
      }
    }

    // Wrap every character once up front; loop iterations just toggle visibility.
    const promptSpans = wrapChars(promptEl, ['.mcp-terminal__caret']);
    const lineChecks = lines.map((line) => line.querySelector('.mcp-check'));
    const lineSpansList = lines.map((line) => wrapChars(line, ['.mcp-check']));
    const resultSpans = wrapChars(resultEl, []);
    const allCharSpans = [promptSpans, ...lineSpansList, resultSpans].flat();

    function resetAll() {
      allCharSpans.forEach((span) => span.classList.remove('tw-visible'));
      lineChecks.forEach((check) => check && check.classList.remove('tw-visible'));
    }

    async function runSequence(cursor) {
      await typeSpans(promptSpans, cursor, 16);
      await sleep(450);

      for (let i = 0; i < lines.length; i++) {
        const check = lineChecks[i];
        if (check) check.classList.add('tw-visible');
        await typeSpans(lineSpansList[i], cursor, 10);
        await sleep(300);
      }

      await sleep(200);
      await typeSpans(resultSpans, cursor, 12);
    }

    async function runLoop() {
      const cursor = document.createElement('span');
      cursor.className = 'tw-cursor';
      while (true) {
        resetAll();
        if (promptSpans.length) promptSpans[0].parentNode.insertBefore(cursor, promptSpans[0]);
        await sleep(500);
        await runSequence(cursor);
        await sleep(1800);
      }
    }

    requestAnimationFrame(() => {
      terminalEl.classList.add('mcp-terminal--in');
    });
    terminalEl.addEventListener(
      'transitionend',
      () => {
        runLoop();
      },
      { once: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMcpTyping);
  } else {
    initMcpTyping();
  }
</script>

<script>
  function initWaBubbles() {
    const phone = document.querySelector('.wa-phone');
    const bubbles = phone ? Array.from(phone.querySelectorAll('.wa-bubble')) : [];
    if (!phone || !bubbles.length) return;

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function wrapChars(node, skipSelectors) {
      const spans = [];
      Array.from(node.childNodes).forEach((child) => {
        if (child.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          for (const ch of child.textContent) {
            const span = document.createElement('span');
            span.className = 'tw-char';
            span.textContent = ch;
            frag.appendChild(span);
            spans.push(span);
          }
          node.replaceChild(frag, child);
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          if (skipSelectors.some((sel) => child.matches(sel))) return;
          spans.push(...wrapChars(child, skipSelectors));
        }
      });
      return spans;
    }

    async function typeSpans(spans, speed) {
      for (const span of spans) {
        span.classList.add('tw-visible');
        await sleep(speed + Math.random() * speed * 0.6);
      }
    }

    const bubbleData = bubbles.map((bubble) => ({
      bubble,
      timeEl: bubble.querySelector('.wa-bubble__time'),
      ticketEl: bubble.querySelector('.wa-ticket'),
      spans: wrapChars(bubble, ['.wa-bubble__time', '.wa-ticket']),
    }));
    const allSpans = bubbleData.flatMap((b) => b.spans);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      phone.classList.add('wa-phone--visible');
      bubbles.forEach((bubble) => bubble.classList.add('wa-visible'));
      allSpans.forEach((span) => span.classList.add('tw-visible'));
      bubbleData.forEach(({ timeEl, ticketEl }) => {
        if (timeEl) timeEl.classList.add('wa-time-visible');
        if (ticketEl) ticketEl.classList.add('wa-ticket-visible');
      });
      return;
    }

    let started = false;

    function resetAll() {
      bubbles.forEach((bubble) => bubble.classList.remove('wa-visible'));
      allSpans.forEach((span) => span.classList.remove('tw-visible'));
      bubbleData.forEach(({ timeEl, ticketEl }) => {
        if (timeEl) timeEl.classList.remove('wa-time-visible');
        if (ticketEl) ticketEl.classList.remove('wa-ticket-visible');
      });
    }

    async function runLoop() {
      while (true) {
        resetAll();
        phone.classList.add('wa-phone--visible');
        await sleep(650);

        for (const { bubble, spans, timeEl, ticketEl } of bubbleData) {
          bubble.classList.add('wa-visible');
          await sleep(200);
          await typeSpans(spans, 14);
          if (ticketEl) {
            await sleep(150);
            ticketEl.classList.add('wa-ticket-visible');
          }
          await sleep(150);
          if (timeEl) timeEl.classList.add('wa-time-visible');
          await sleep(450);
        }

        await sleep(2200);
        phone.classList.remove('wa-phone--visible');
        await sleep(650);
      }
    }

    // Observe the (un-transformed, un-clipped) visual pane rather than the phone
    // itself: the phone starts translated fully outside its card's overflow:hidden
    // clip box for the slide-in effect, so IntersectionObserver — which clips the
    // target's rect through ancestor overflow — would report 0% intersection for
    // it forever, no matter how far the card scrolls into view.
    const observeTarget = phone.closest('.wa-card__visual') || phone;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            runLoop();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(observeTarget);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWaBubbles);
  } else {
    initWaBubbles();
  }
</script>

<script>
  function initAttPhone() {
    const phone = document.querySelector('.att-phone');
    const ticket = phone ? phone.querySelector('.att-ticket') : null;
    const highlights = phone ? phone.querySelector('.att-highlights-viewport') : null;
    const daysEl = phone ? phone.querySelector('.att-cd-days') : null;
    const hoursEl = phone ? phone.querySelector('.att-cd-hours') : null;
    const minsEl = phone ? phone.querySelector('.att-cd-mins') : null;
    const secsEl = phone ? phone.querySelector('.att-cd-secs') : null;
    if (!phone || !ticket || !highlights || !daysEl || !hoursEl || !minsEl || !secsEl) return;

    const START = { days: 12, hours: 8, mins: 44, secs: 50 };

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function renderCountdown(t) {
      daysEl.textContent = String(t.days);
      hoursEl.textContent = String(t.hours).padStart(2, '0');
      minsEl.textContent = String(t.mins).padStart(2, '0');
      secsEl.textContent = String(t.secs).padStart(2, '0');
    }

    function tick(t) {
      t.secs--;
      if (t.secs < 0) {
        t.secs = 59;
        t.mins--;
        if (t.mins < 0) {
          t.mins = 59;
          t.hours--;
          if (t.hours < 0) {
            t.hours = 23;
            t.days--;
          }
        }
      }
      renderCountdown(t);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      phone.classList.add('att-phone--in');
      ticket.classList.add('att-ticket--in');
      highlights.classList.add('att-highlights--in');
      renderCountdown(START);
      return;
    }

    function resetAll() {
      phone.classList.remove('att-phone--in');
      ticket.classList.remove('att-ticket--in');
      highlights.classList.remove('att-highlights--in');
      renderCountdown(START);
    }

    async function runLoop() {
      while (true) {
        resetAll();
        await sleep(350);

        phone.classList.add('att-phone--in');
        await sleep(650);

        ticket.classList.add('att-ticket--in');
        highlights.classList.add('att-highlights--in');

        const t = { ...START };
        for (let i = 0; i < 60; i++) {
          await sleep(150);
          tick(t);
        }

        await sleep(1800);
      }
    }

    let started = false;
    // Observe the (un-transformed, un-clipped) visual pane rather than the phone
    // itself: the phone starts translated fully outside its card's overflow:hidden
    // clip box for the slide-in effect, so IntersectionObserver — which clips the
    // target's rect through ancestor overflow — would report 0% intersection for
    // it forever, no matter how far the card scrolls into view.
    const observeTarget = phone.closest('.web-card__visual') || phone;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            runLoop();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(observeTarget);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAttPhone);
  } else {
    initAttPhone();
  }
</script>
