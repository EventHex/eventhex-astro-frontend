---
// Single-slide testimonial carousel, styled after brighthub.casethemes.net/fintech-saas-one-page
// "Built for Growth, Proven by Customers" section: one testimonial visible at a time, rest in carousel.

const testimonials = [
  {
    eventName: "Youth Business Conclave",
    quote: "Eventhex.ai is a game changer in the event tech space. We had first-hand experience using their platform for the Youth Business Conclave. Personally, I was impressed by their UI/UX capabilities. We highly recommend this team to anyone looking for an innovative event tech solution!",
    logo: "/feature-images/testimonials/youth-business-conclave.svg",
    logoAlt: "Youth Business Conclave logo",
    avatar: "https://cms.eventhex.ai/wp-content/uploads/2025/01/Rifath-Rahman.jpeg",
    name: "Rifath Rahman",
    role: "President, SOLID Business Club",
  },
  {
    eventName: "Gulf Indian Trade Expo",
    quote: "EventHex.ai revolutionized the way we managed the Gulf Indian Trade Expo. Its efficiency allowed us to focus on creating a world-class experience for our participants and exhibitors. We highly recommend EventHex.ai to anyone looking for reliable and professional event management solutions!",
    logo: "/feature-images/testimonials/gulf-indian-trade-expo.webp",
    logoAlt: "Gulf Indian Trade Expo logo",
    avatar: "https://cms.eventhex.ai/wp-content/uploads/2025/01/Noushad-EP.jpeg",
    name: "Noushad EP",
    role: "Founder &amp; Chairman, Business Kerala",
  },
  {
    eventName: "Wellbeing at Work UK",
    quote: "We approached EventHex knowing teething problems might arise with a newer platform, but after a successful two-event trial, we're eager to sign a two-year partnership. The standout feature isn't just the tech—it's the amazing support team, with rapid problem-solving, intuitive user experience, and a growth mindset that treats clients as true partners. I happily recommend EventHex.",
    logo: "/feature-images/testimonials/wellbeing-at-work.svg",
    logoAlt: "Wellbeing at Work UK logo",
    logoBlack: true,
    avatar: "https://cms.eventhex.ai/wp-content/uploads/2026/03/Amy.png",
    name: "Amy Carey",
    role: "Wellbeing at work UK",
  },
];
---

<section class="testimonials-shell">
  <div class="testimonials-container">
    <div class="testimonials-intro">
      <div class="trusted-eyebrow">
        <span class="trusted-eyebrow__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>
        </span>
        <span class="trusted-eyebrow__label">Trusted by Event Organizers</span>
      </div>
      <a
        class="g2-rating"
        href="https://www.g2.com/sellers/eventhex-ai"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="G2 4.7/5 — EventHex reviews"
      >
        <span class="g2-rating__mark" aria-hidden="true">G2</span>
        <strong>4.7/5</strong>
      </a>
    </div>

    <div class="t-carousel" id="ai-testimonials-carousel">
      <div class="t-carousel-viewport">
        <div class="t-carousel-track" data-t-track>
          {testimonials.map((t) => (
            <article class="t-slide">
              <p class="t-quote">&ldquo;{t.quote}&rdquo;</p>
              <div class="t-meta">
                <img src={t.logo} alt={t.logoAlt} class:list={["t-logo", { "t-logo--black": t.logoBlack }]} loading="lazy" />
                <img src={t.avatar} alt={t.name} class="t-avatar" loading="lazy" />
                <div class="t-author-info">
                  <h4 class="t-author-name">{t.name}</h4>
                  <p class="t-author-role" set:html={t.role}></p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="t-controls">
        <div class="t-dots" data-t-dots>
          {testimonials.map((_, i) => (
            <button type="button" class="t-dot" data-index={i} aria-label={`Go to testimonial ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-shell {
    width: 100%;
    background:
      radial-gradient(ellipse 65% 55% at 50% 55%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.5) 45%, transparent 72%),
      linear-gradient(to bottom, #fff 0, rgba(255, 255, 255, 0.7) 70px, rgba(255, 255, 255, 0.3) 130px, transparent 190px),
      linear-gradient(to top, #fff 0, rgba(255, 255, 255, 0.7) 70px, rgba(255, 255, 255, 0.3) 130px, transparent 190px),
      radial-gradient(circle 380px at 3% 25%, rgba(175, 163, 255, 0.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 22%, rgba(255, 182, 213, 0.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 78%, rgba(130, 170, 255, 0.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 80%, rgba(255, 224, 150, 0.20) 0%, transparent 100%),
      #ffffff;
  }

  .testimonials-container {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .testimonials-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    margin-bottom: 48px;
  }
  .trusted-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #eef0f3;
  }
  .trusted-eyebrow__icon { display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; }
  .trusted-eyebrow__icon svg { width: 100%; height: 100%; }
  .g2-rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #475467;
    font-size: 14px;
    text-decoration: none;
  }
  .g2-rating:hover { color: #1d2939; }
  .g2-rating__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: #c93620;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .trusted-eyebrow__label { font-family: var(--font-body); font-size: 15px; font-weight: 500; color: #14151a; }

  .t-carousel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .t-carousel-viewport {
    width: 100%;
    overflow: hidden;
  }

  .t-carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.4s ease;
  }

  .t-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 0 0 100%;
    min-width: 0;
  }

  .t-quote {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.3px;
    color: #14151a;
    margin: 0 0 32px;
    max-width: 760px;
  }
  .t-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .t-logo { height: 26px; width: auto; flex-shrink: 0; }
  .t-logo--black { filter: brightness(0); }
  .t-avatar { width: 48px; height: 48px; border-radius: 14px; object-fit: cover; flex-shrink: 0; }
  .t-author-info { display: flex; flex-direction: column; gap: 4px; text-align: left; }
  .t-author-name { font-family: var(--font-body); font-size: 16px; font-weight: 600; color: #14151a; margin: 0; }
  .t-author-role { font-family: var(--font-body); font-size: 13px; font-weight: 400; color: #667085; margin: 0; }

  .t-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .t-dots { display: flex; align-items: center; gap: 8px; }
  .t-dot {
    box-sizing: content-box;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: #E4E7EC;
    cursor: pointer;
    transition: background 0.2s ease, width 0.2s ease;
  }
  .t-dot.is-active {
    background: #375DFB;
    width: 18px;
    border-radius: 999px;
  }

  @media (max-width: 1024px) {
    .testimonials-container { padding: 40px 20px; }
    .t-quote { font-size: 26px; }
  }

  @media (max-width: 640px) {
    .t-quote { font-size: 22px; }
    .t-meta { flex-wrap: wrap; }
    .t-author-info { text-align: center; align-items: center; }
  }
</style>

<script>
  const root = document.getElementById('ai-testimonials-carousel');
  const track = root?.querySelector('[data-t-track]') as HTMLElement | null;
  const dots = root?.querySelectorAll<HTMLButtonElement>('[data-t-dots] .t-dot');

  if (track && dots && dots.length) {
    let index = 0;
    const AUTOPLAY_MS = 4000;
    let timer: ReturnType<typeof setInterval> | null = null;

    const goTo = (i: number) => {
      index = (i + dots.length) % dots.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, di) => dot.classList.toggle('is-active', di === index));
    };

    const startAutoplay = () => {
      if (timer) return;
      timer = setInterval(() => goTo(index + 1), AUTOPLAY_MS);
    };

    const stopAutoplay = () => {
      if (!timer) return;
      clearInterval(timer);
      timer = null;
    };

    dots.forEach((dot, di) => dot.addEventListener('click', () => {
      goTo(di);
      stopAutoplay();
      startAutoplay();
    }));

    root?.addEventListener('mouseenter', stopAutoplay);
    root?.addEventListener('mouseleave', startAutoplay);

    goTo(0);
    startAutoplay();
  }
</script>
