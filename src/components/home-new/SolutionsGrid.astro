---
// Solutions grid — SOLAAX-reference card wall, recreated with EventHex content
// Cards surface 5 of EventHex's features in a mailmodo-style overlapping card fan.
---

<section class="solutions-section" id="key-features">
  <div class="solutions-inner">
  <div class="solutions-box">
    <div class="solutions-head">
      <div class="solutions-eyebrow">
        <span class="solutions-eyebrow__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>
        </span>
        <span class="solutions-eyebrow__label">Key Features</span>
      </div>
      <h2 class="solutions-title">Countless Events,<br/>One AI-Powered Platform</h2>
      <div class="solutions-nav" id="solutions-nav">
        <button class="solutions-tab solutions-tab--active" data-tab="0">Pre-Event</button>
        <button class="solutions-tab" data-tab="1">Event Day</button>
        <button class="solutions-tab" data-tab="2">Post-Event</button>
      </div>
    </div>

    <div class="solutions-grid solutions-grid--active" data-tab="0">

      <!-- 1. Event Website Builder -->
      <a href="/event-website-builder/" class="sol-card">
        <div class="sol-visual sol-visual--glass">
          <img src="/feature-images/solutions/event-builder-laptop-mockup.svg" alt="Event website builder" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Event Website Builder</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Publish a branded event website with AI in minutes — custom domain included.</p>
          </div>
        </div>
      </a>

      <!-- 2. Event Ticketing -->
      <a href="/event-ticketing/" class="sol-card">
        <div class="sol-visual sol-visual--pink">
          <img src="/feature-images/solutions/event-ticketing-mockup.svg" alt="Event ticketing dashboard on a laptop" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Event Ticketing</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Sell out with multi-tier tickets, coupons, and QR delivery — 0% platform fees.</p>
          </div>
        </div>
      </a>

      <!-- 3. Event Registration -->
      <a href="/event-registration/" class="sol-card">
        <div class="sol-visual sol-visual--blue">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Sponsor-Management.svg" alt="Event registration dashboard" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Event Registration</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Custom forms, attendee types, approvals, and waitlists — capture every registration without a single spreadsheet.</p>
          </div>
        </div>
      </a>

      <!-- 4. Call for Papers -->
      <a href="/call-for-papers/" class="sol-card">
        <div class="sol-visual sol-visual--yellow">
          <img src="/feature-images/solutions/ai-form-builder-mockup.svg" alt="Call for papers submission portal" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Call for Papers</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Collect, review, and score submissions with a full peer-review workflow.</p>
          </div>
        </div>
      </a>

      <!-- 5. Event Marketing -->
      <a href="/event-marketing/" class="sol-card">
        <div class="sol-visual sol-visual--violet">
          <img src="/feature-images/solutions/event-marketing-mockup.svg" alt="Event marketing campaign" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Event Marketing</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Fill seats with built-in email &amp; WhatsApp campaigns and audience segments.</p>
          </div>
        </div>
      </a>

    </div>

    <div class="solutions-grid" data-tab="1">

      <!-- 1. Centralized Dashboard -->
      <a href="/centralized-dashboard/" class="sol-card">
        <div class="sol-visual sol-visual--yellow">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/CentralizedDashboard.svg" alt="Centralized dashboard" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Centralized Dashboard</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Command All Your Event from a Single Dashboard</p>
          </div>
        </div>
      </a>

      <!-- 2. Attendee App -->
      <a href="/event-mobile-app/" class="sol-card">
        <div class="sol-visual sol-visual--glass">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Attendee-App.svg" alt="Event mobile app for attendees" loading="lazy" class="mock-laptop-img mock-laptop-img--attendee-app" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Attendee App</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Give attendees a branded mobile app with live agendas, networking, notifications, and event content.</p>
          </div>
        </div>
      </a>

      <!-- 3. AI Smart-Connect -->
      <a href="/enhance-networking-ai-smart-connect/" class="sol-card">
        <div class="sol-visual sol-visual--violet">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/AI-Smart-Connect.svg" alt="AI smart-connect networking" loading="lazy" class="mock-laptop-img mock-laptop-img--smart-connect" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">AI Smart-Connect</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Deliver Personalized Networking Opportunities for Attendees Based on Shared Interests</p>
          </div>
        </div>
      </a>

      <!-- 4. Speaker Management -->
      <a href="/speaker-management/" class="sol-card">
        <div class="sol-visual sol-visual--blue">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Speaker-Management.svg" alt="Speaker management" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Speaker Management</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Organize all speaker-related information with ease</p>
          </div>
        </div>
      </a>

      <!-- 5. Session Management -->
      <a href="/session-management/" class="sol-card">
        <div class="sol-visual sol-visual--yellow">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/SessionManagement.svg" alt="Session management" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Session Management</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Coordinate all sessions from a single dashboard</p>
          </div>
        </div>
      </a>

    </div>

    <div class="solutions-grid" data-tab="2">

      <!-- 1. AI Photo Gallery -->
      <a href="/ai-photo-gallery/" class="sol-card">
        <div class="sol-visual sol-visual--blue">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/AI-Photo-Distributor.svg" alt="AI photo gallery" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">AI Photo Gallery</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Let attendees find every event photo they appear in by uploading a selfie.</p>
          </div>
        </div>
      </a>

      <!-- 2. Event Analytics -->
      <a href="/event-analytics/" class="sol-card">
        <div class="sol-visual sol-visual--yellow">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Smart-Analytics.svg" alt="" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Event Analytics</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Track registrations, attendance, revenue, engagement, and sponsor ROI in real time.</p>
          </div>
        </div>
      </a>

      <!-- 3. AI Session Recap -->
      <a href="/ai-session-recap/" class="sol-card">
        <div class="sol-visual sol-visual--glass">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/AI-Note-Maker.svg" alt="" loading="lazy" class="mock-laptop-img mock-laptop-img--note-maker" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">AI Session Recap</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Auto-transcribe sessions and deliver summaries, takeaways, and highlights.</p>
          </div>
        </div>
      </a>

      <!-- 4. Attendee Retargeting -->
      <a href="/event-marketing/" class="sol-card">
        <div class="sol-visual sol-visual--violet">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Attendee.svg" alt="" loading="lazy" class="mock-laptop-img mock-laptop-img--attendee-retargeting" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Attendee Retargeting</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Use Past Event Data to Effectively Re-campaign for the next</p>
          </div>
        </div>
      </a>

      <!-- 5. Instant Feedback -->
      <a href="/live-polling-qa/" class="sol-card">
        <div class="sol-visual sol-visual--pink">
          <img src="https://cms.eventhex.ai/wp-content/uploads/2025/03/Instant-Feedback.svg" alt="" loading="lazy" class="mock-laptop-img" />
          <div class="sol-overlay-text">
            <h3 class="sol-label sol-label--overlay">Instant Feedback</h3>
            <p class="sol-desc sol-desc--hover-only sol-desc--overlay">Capitalize on Attendee Reviews to Note Areas for Improvement</p>
          </div>
        </div>
      </a>

    </div>
  </div>
  </div>
</section>

<style>
  .solutions-section {
    width: 100%;
    overflow-x: hidden;
    scroll-margin-top: 88px;
    padding: 48px 0 104px;
    background-color: #0d0a2c;
    background-image:
      /* Fade the bottom nebula glow back to flat base color so the AISection seam below stays hidden */
      linear-gradient(180deg, transparent 55%, #0d0a2c 100%),
      /* Ease in from the previous section's fade-to-black so the seam stays hidden */
      linear-gradient(180deg, #000 0%, transparent 260px),
      /* Same nebula mesh as DashboardSection's dark-section, continuing the gradient look */
      radial-gradient(at 0% 100%, hsl(186 100% 48% / 0.45) 0px, transparent 46%),
      radial-gradient(at 15% 85%, hsl(192 100% 50% / 0.25) 0px, transparent 42%),
      radial-gradient(at 88% 12%, hsl(265 90% 58% / 0.28) 0px, transparent 45%),
      radial-gradient(at 55% 45%, hsl(250 70% 25% / 0.25) 0px, transparent 55%);
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .solutions-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2px;
  }
  .solutions-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #eef0f3;
    box-shadow: 0 6px 16px -6px rgba(20, 12, 53, 0.15);
    transform: translateY(8px);
  }
  .solutions-eyebrow__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
  }
  .solutions-eyebrow__icon svg { width: 100%; height: 100%; }
  .solutions-eyebrow__label {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: #14151a;
  }
  .solutions-box {
    background:
      radial-gradient(circle 380px at 10% 320px, rgba(175, 163, 255, 0.45) 0%, transparent 100%),
      radial-gradient(circle 260px at 92% 8%, rgba(255, 182, 213, 0.4) 0%, transparent 100%),
      radial-gradient(circle 300px at 90% 88%, rgba(130, 170, 255, 0.35) 0%, transparent 100%),
      #ffffff;
    border-radius: 20px;
    padding: 64px 32px;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.45);
  }
  .solutions-head {
    width: 60%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    margin: 0 auto 92px;
  }
  .solutions-title {
    font-family: var(--font-heading);
    background: linear-gradient(135deg, #000000 0%, #6b6b6b 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 46px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    transform: translateY(8px);
  }
  .solutions-nav {
    display: flex;
    justify-content: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(20, 12, 53, 0.1);
    border-radius: 50px;
    padding: 4px;
    width: fit-content;
    margin-top: 10px;
    transform: translateY(21px);
  }
  .solutions-tab {
    background: transparent;
    border: none;
    border-radius: 50px;
    padding: 10px 32px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: #4D5A6B;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(.4,0,.2,1);
    white-space: nowrap;
  }
  .solutions-tab:hover { background: rgba(55, 93, 251, 0.08); }
  .solutions-tab--active {
    background: var(--brand-blue) !important;
    color: #fff !important;
    box-shadow: 0 2px 8px rgba(55, 93, 251, 0.3);
  }
  .solutions-grid {
    display: none;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
  }
  .solutions-grid--active {
    display: flex;
    animation: solutionsPanelIn 560ms cubic-bezier(.22, 1, .36, 1) both;
  }

  @keyframes solutionsPanelIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.985);
      filter: blur(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* Glassmorphism frame around each card's gradient box */
  .sol-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: 270px;
    aspect-ratio: 5 / 6.8;
    padding: 10px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.28)),
      rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      0 18px 46px -28px rgba(20, 12, 53, 0.52);
    transition: transform 420ms cubic-bezier(.2, .8, .2, 1), box-shadow 420ms ease, border-color 420ms ease;
  }

  .sol-card:hover {
    z-index: 10;
    transform: translateY(-30px) rotate(var(--rot, 0deg)) scale(1.08);
    border-color: rgba(255, 255, 255, 0.88);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 34px 42px -28px rgba(20, 12, 53, 0.44),
      0 14px 22px -18px rgba(55, 93, 251, 0.34);
  }

  @media (prefers-reduced-motion: reduce) {
    .solutions-grid--active {
      animation: none;
    }
  }

  /* Event Builder card: new mockup image sits smaller and higher than the default */
  .sol-card:nth-child(1) .mock-laptop-img {
    width: 78%;
    transform: translateY(-28px);
  }

  /* Fanned deck, same offsets/rotations as the mailmodo reference: cards pulled toward
     center by alternating left/right position shifts, each tilted a few degrees. */
  .sol-card:nth-child(1) { left: 150px; }
  .sol-card:nth-child(2) { left: 75px; }
  .sol-card:nth-child(4) { right: 75px; }
  .sol-card:nth-child(5) { right: 150px; }

  /* Rotation gives the "rising/tilted" fan look — no scroll-driven entrance, cards sit in place. */
  .sol-card { transform: rotate(var(--rot, 0deg)); }
  .sol-card:nth-child(1) { --rot: 6deg; }
  .sol-card:nth-child(2) { --rot: -4deg; }
  .sol-card:nth-child(4) { --rot: 4deg; }
  .sol-card:nth-child(5) { --rot: -6deg; }

  .sol-visual {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 16px;
    min-height: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #f5f8ff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.86),
      0 20px 16px 0 rgba(20, 12, 53, 0.05),
      0 8px 6px 0 rgba(20, 12, 53, 0.04),
      0 2px 2px 0 rgba(20, 12, 53, 0.03);
  }

  .sol-visual::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.8) 58%, rgba(255, 255, 255, 0.96) 100%);
  }

  .sol-visual--glass {
    background: linear-gradient(135deg, #d9ecfa 0%, #eef6fc 45%, #ffffff 100%);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 8px 32px rgba(20, 12, 53, 0.12);
  }

  /* pink top fading to white bottom */
  .sol-visual--pink {
    background: linear-gradient(180deg, #F9E2F7 0%, #ffffff 100%);
  }

  /* blue top fading to white bottom */
  .sol-visual--blue {
    background: linear-gradient(180deg, #cfe0ff 0%, #ffffff 100%);
  }

  /* yellow top fading to white bottom */
  .sol-visual--yellow {
    background: linear-gradient(180deg, #fdf6d9 0%, #ffffff 70%);
  }

  /* violet top fading to white bottom */
  .sol-visual--violet {
    background: linear-gradient(180deg, #e0d4f7 0%, #ffffff 100%);
  }

  /* Event Ticketing card: nudge image up */
  .sol-card:nth-child(2) .mock-laptop-img {
    transform: translateY(-28px);
  }

  /* AI Form Builder / Event Marketing cards: wider image */
  .sol-card:nth-child(4) .mock-laptop-img,
  .sol-card:nth-child(5) .mock-laptop-img {
    width: 80%;
  }
  .sol-label {
    color: #14151a;
    font-size: clamp(14px, 1.15vw, 17px);
    font-weight: 600;
    text-align: left;
    margin: 0 0 6px;
    padding-left: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Title+desc share one bottom-anchored box so a longer desc pushes the pair
     up as a unit instead of the two independently-positioned overlays colliding. */
  .sol-overlay-text {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sol-label--overlay {
    margin: 0;
    padding: 0;
    background: none;
    color: var(--heading-dark);
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 500;
    text-align: left;
  }

  .sol-desc {
    margin: 0;
    text-align: left;
    padding: 0 0 10px 8px;
    color: #5b5b5b;
    font-size: 12px;
    line-height: 1.4;
  }

  /* Event Builder card: description hidden by default, only shown on hover */
  .sol-desc--hover-only {
    display: none;
    padding: 10px 8px;
  }

  /* Desc sits inside the gradient box, below the title, shown only on hover */
  .sol-desc--overlay {
    padding: 0;
  }
  .sol-card:hover .sol-desc--hover-only {
    display: block;
  }

  /* ---- 1. Events & Activities (Figma design) ---- */
  .sol-icon--badge {
    width: 28px; height: 28px;
    background: #12213a;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
  }
  .sol-icon--badge svg { width: 16px; height: 16px; }
  .mock-laptop-img {
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    object-fit: contain;
    transform: translateY(-14px);
    transition: transform 0.3s ease, scale 0.3s ease;
  }
  /* Make room for the full description on hover: shrink the image and lift it further up */
  .sol-card:hover .mock-laptop-img {
    transform: translateY(-34px) scale(0.82);
  }
  .mock-laptop-img--attendee-app {
    width: 86%;
  }
  .mock-laptop-img--smart-connect {
    width: 86%;
  }
  .mock-laptop-img--note-maker {
    width: 86%;
  }
  .mock-laptop-img--attendee-retargeting {
    width: 86%;
  }
  .sol-card--figma .sol-label { text-align: center; }

  /* ---- Phone frame (shared) ---- */
  .mock-phone {
    width: 100%; max-width: 168px; aspect-ratio: 9 / 17.5;
    background: #f4f6f5; border-radius: 22px; border: 5px solid #1a1a1a;
    padding: 10px 10px 14px; display: flex; flex-direction: column;
    box-shadow: 0 26px 44px -12px rgba(0,0,0,.6); position: relative; overflow: hidden;
  }
  .mock-phone--dark { background: #0e1b14; color: #eef2ef; }
  .mock-statusbar { display: flex; justify-content: space-between; font-size: 9px; color: #6b756f; margin-bottom: 6px; }
  .mock-phone--dark .mock-statusbar { color: #9fb0a7; }
  .mock-statusbar-icons { letter-spacing: 2px; }

  /* ---- 6. Attendee App ---- */
  .mock-app-head { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
  .mock-app-logo { height: 12px; width: auto; filter: brightness(0) invert(1); }
  .mock-app-name { font-size: 11px; font-weight: 700; }
  .mock-app-banner {
    position: relative; height: 70px; border-radius: 10px; background-size: cover; background-position: center;
