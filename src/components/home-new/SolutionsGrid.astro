<script>
(function(){
  var nav = document.getElementById('solutions-nav');
  if (!nav) return;
  var tabs = Array.from(nav.querySelectorAll('.solutions-tab'));
  var panels = Array.from(document.querySelectorAll('.solutions-grid[data-tab]'));
  var activeIndex = tabs.findIndex(function(tab){
    return tab.classList.contains('solutions-tab--active');
  });
  var timer;
  var AUTO_ADVANCE_MS = 10000;

  if (activeIndex < 0) activeIndex = 0;

  function showTab(index){
    if (!tabs.length) return;
    activeIndex = (index + tabs.length) % tabs.length;
    var activeTab = tabs[activeIndex];
    var activeTabId = activeTab.getAttribute('data-tab');

    tabs.forEach(function(tab){
      tab.classList.toggle('solutions-tab--active', tab === activeTab);
    });
    panels.forEach(function(panel){
      var selected = panel.getAttribute('data-tab') === activeTabId;
      panel.classList.toggle('solutions-grid--active', selected);
      if (selected) panel.scrollLeft = 0;
    });
  }

  function stopAuto(){
    clearInterval(timer);
  }

  function startAuto(){
    stopAuto();
    if (tabs.length < 2) return;
    timer = setInterval(function(){
      showTab(activeIndex + 1);
    }, AUTO_ADVANCE_MS);
  }

  nav.addEventListener('click', function(e){
    var btn = e.target.closest('.solutions-tab');
    if (!btn) return;
    stopAuto();
    showTab(tabs.indexOf(btn));
    startAuto();
  });

  startAuto();
})();
</script>

<script>
(function(){
  var box = document.querySelector('.solutions-box');
  if (!box || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  box.style.willChange = 'transform';
  var naturalTop = 0;
  var ticking = false;
  function measure(){
    // Baseline position with no transform applied, so scroll math never reads its own output back.
    box.style.transform = 'none';
    naturalTop = box.getBoundingClientRect().top + window.scrollY;
  }
  function update(){
    var vh = window.innerHeight;
    var centerInViewport = naturalTop + box.offsetHeight / 2 - window.scrollY;
    var raw = (centerInViewport - vh / 2) * 0.15;
    var max = 70;
    var offset = Math.max(-max, Math.min(max, raw));

    // Zoom-in-on-scroll: box starts small as it enters from below, scales up to
    // full size as it's scrolled further into view (top reaches 40% of viewport).
    var boxTop = naturalTop - window.scrollY;
    var zoomProgress = Math.max(0, Math.min(1, (vh - boxTop) / (vh * 0.6)));
    var scale = 0.7 + 0.3 * zoomProgress;

    box.style.transform = 'translateY(' + offset + 'px) scale(' + scale + ')';
    ticking = false;
  }
  function onScroll(){
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }
  function onResize(){
    measure();
    update();
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onResize);
  measure();
  update();
})();
</script>
