  }

  /* Mobile */
  @media (max-width: 767px) {
    .ai-section { padding: 16px 20px 30px; }
    .ai-header-inner { width: 100%; }
    .ai-title { font-size: 30px; }
    .ai-title-line { white-space: normal; }
    .stacking-cards { --stack-top-base: 280px; }
    .stacking-card { flex-direction: column; height: 560px; }
    .card-content { flex: 0 0 52%; padding: 20px 20px 0; gap: 10px; }
    .card-visual { margin: 12px; padding: 16px; }
    .card-title { font-size: 26px; }
    .card-desc { font-size: 15px; }
    .card-stats { gap: 24px; margin-top: 12px; }
    .card-stat__num { font-size: 22px; }
    .visual-highlight { width: 90%; padding: 14px 16px; }
    .visual-highlight p { font-size: 13px; }
    .stacking-cards { padding-bottom: 40px; }
