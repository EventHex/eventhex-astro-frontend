    background: rgba(255, 255, 255, 0.09);
  }
  .skeleton-block span:first-child { width: 60%; }
  .skeleton-block span:nth-child(2) { width: 90%; }
  .skeleton-block span:last-child { width: 75%; }

  .visual-highlight {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 78%;
    display: flex;
    align-items: center;
    gap: 14px;
    background: #0a0a10;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: 0 0 60px rgba(255, 255, 255, 0.1), 0 0 40px rgba(120, 140, 255, 0.15), 0 20px 40px rgba(0, 0, 0, 0.6);
  }
  .visual-highlight__icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
  }
  .visual-highlight__icon svg { width: 16px; height: 16px; }
  .visual-highlight p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .ai-section { padding: 20px 20px 30px; }
    .ai-header-inner { width: 94%; }
    .ai-title { font-size: 34px; line-height: 1em; }
    .stacking-cards { --stack-top-base: 270px; }
    .stacking-card { height: 450px; }
    .card-content { flex-basis: 50%; }
    .card-title { font-size: 30px; }
    .card-desc { font-size: 16px; }
    .card-btn { font-size: 14px; }
    .card-stats { gap: 28px; }
