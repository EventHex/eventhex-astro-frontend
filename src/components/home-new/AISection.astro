    title: "AI Website & Form Builder",
    desc: "Describe your event and get a full website, registration form, and SEO metadata — voice-powered form filling included.",
    image: "https://cms.eventhex.ai/wp-content/uploads/2025/01/AI-website.png",
    visualImage: "/feature-images/ai/ai-website-builder.webp",
    stats: [{ n: "No-Code", l: "Live in minutes" }, { n: "100%", l: "Mobile responsive" }],
    highlight: "No dev team? No problem — drag, drop, publish your event site in minutes.",
    href: "/ai-form-builder/",
  },
  {
