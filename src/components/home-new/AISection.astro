---

<section class="ai-section-shell">
  <div class="ai-section">
    <!-- Header area (b4813e6) — sticky bar once scrolled to top, cards pile up beneath it -->
    <div class="ai-header">
      <div class="ai-header-inner">
        <div class="ai-eyebrow">
          <span class="ai-eyebrow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>
          </span>
          <span class="ai-eyebrow__label">AI Features</span>
        </div>
        <h2 class="ai-title">
          <span class="ai-title-line">Simply The Best <span class="ai-title-highlight">AI-Powered</span></span>
          <span class="ai-title-line">Event Management Software</span>
        </h2>
      </div>
    </div>

    <!-- Stacking Cards (bb3f883) — GSAP ScrollTrigger sticky cards -->
    <div class="stacking-cards" id="ai-stacking-cards">
      {aiCards.map((card, i) => (
        <div
          class="stacking-card"
          data-card-index={i}
          style={`--card-index: ${i};`}
        >
          <div class="card-content">
            <span class="card-tag"><span class="card-tag__dot" set:html={BOX_ICON} />{card.tag}</span>
            <h3 class="card-title">{card.title}</h3>
            <p class="card-desc">{card.desc}</p>
            <a href={card.href} class="card-btn">Explore More</a>
            <div class="card-stats">
              {card.stats.map((s) => (
                <div class="card-stat">
                  <span class="card-stat__num">{s.n}</span>
                  <span class="card-stat__label">{s.l}</span>
                </div>
              ))}
            </div>
          </div>
          {card.visualImage ? (
            <div class="card-visual card-visual--image">
              <img src={card.visualImage} alt={card.title} loading="lazy" />
            </div>
          ) : (
            <div class="card-visual">
              <div class="visual-skeleton">
                {Array.from({ length: 6 }).map(() => (
                  <div class="skeleton-block"><span></span><span></span><span></span></div>
                ))}
              </div>
              <div class="visual-highlight">
                <span class="visual-highlight__icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 13.8 9 21 12 13.8 15 12 22 10.2 15 3 12 10.2 9 12 2Z"/></svg>
                </span>
                <p>{card.highlight}</p>
              </div>
            </div>
          )}
        </div>
      ))}
      <!-- Real sibling (not padding — sticky elements need an actual box here to get
           "room" to stick) so the last card settles briefly before releasing. -->
      <div class="stack-hold-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
(function () {
  var header = document.querySelector('.ai-header');
  var cards = document.querySelectorAll('.stacking-card');
  var lastCard = cards[cards.length - 1];
  if (!header || !lastCard) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var released = false;

  function release() {
    var beforeTop = header.getBoundingClientRect().top;
    header.style.position = 'static';
    var naturalTop = header.getBoundingClientRect().top;
    header.style.position = '';
    header.style.top = (beforeTop - naturalTop) + 'px';
    header.classList.add('ai-header--released');
    released = true;
  }

  function restore() {
    header.classList.remove('ai-header--released');
    header.style.top = '';
    released = false;
  }

  var ticking = false;
  function update() {
    var offset = parseFloat(getComputedStyle(lastCard).top) || 0;
    var cardTop = lastCard.getBoundingClientRect().top;
    var shouldRelease = cardTop < offset - 0.5;
    if (shouldRelease && !released) release();
    else if (!shouldRelease && released) restore();
    ticking = false;
  }
  function onScroll() {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

<style>
  .ai-section-shell {
    width: 100%;
    background-color: #000;
    background-image:
      /* Fade in from the SolutionsGrid section's bg color above so the seam stays hidden */
      linear-gradient(180deg, #0d0a2c 0%, transparent 320px),
      radial-gradient(circle at 12% 30%, rgba(70, 130, 255, 0.28) 0%, transparent 55%);
    background-repeat: no-repeat;
    background-size: 100% 100%, 120% 120%;
    animation: aiMeshMove 30s linear infinite;
  }
  @keyframes aiMeshMove {
    0% { background-position: 0 0, 0% 0%; }
    50% { background-position: 0 0, 8% 10%; }
    100% { background-position: 0 0, 0% 0%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-section-shell { animation: none; }
  }

  .ai-section {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4px 0 30px;
  }

  /* b4813e6 header. Sticks below the site's own sticky navbar (69px) once scrolled
     there, so the stacking cards below pile up underneath it. Once the last card
     finishes its brief settle (see .stack-hold-spacer), a small script swaps this to
     position:relative at the exact matching pixel so it scrolls away together with
     the last card instead of staying pinned through leftover dead scroll space. */
  .ai-header {
    position: sticky;
    top: 69px;
    z-index: 20;
    isolation: isolate;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 24px 0;
  }
  .ai-header.ai-header--released {
    position: relative;
  }
  .ai-header-inner {
    width: 82%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
  }
  .ai-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 6px 16px -6px rgba(0, 0, 0, 0.35);
  }
  .ai-eyebrow__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
  }
  .ai-eyebrow__icon svg { width: 100%; height: 100%; }
  .ai-eyebrow__label {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: #fff;
  }
  .ai-title {
    font-family: var(--font-heading);
    font-size: 46px;
    font-weight: 500;
    color: #fff;
    margin: 0;
    line-height: 1.15;
  }
  .ai-title-line {
    display: block;
    white-space: nowrap;
  }
  .ai-title-highlight {
    color: #AFA3FF;
  }

  /* Stacking cards — sticky scroll pile.
     --stack-top-base clears the site navbar (69px) + this section's own sticky
     header, so cards stack right below both instead of climbing over them. */
  .stacking-cards {
    --stack-top-base: 300px;
    width: 100%;
    padding: 80px 0 0;
    position: relative;
    padding-bottom: 50px;
  }
  /* A real element (not padding — padding gives sticky children no "room" to hold)
     so the last card gets a brief, deliberate settle before it releases. */
  .stack-hold-spacer {
    height: 190px;
  }
  .stacking-card {
    position: sticky;
    top: calc(var(--stack-top-base) + var(--card-index) * 20px);
    z-index: var(--card-index);
    display: flex;
    align-items: stretch;
    background:
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255, 255, 255, 0.16) 0%, transparent 70%),
      radial-gradient(circle at 12% 8%, rgba(90, 130, 255, 0.18) 0%, transparent 40%),
      #0a0a0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    height: 500px;
    margin-bottom: 60px;
    transition: transform 0.3s ease;
  }
  .card-content {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 40px;
    gap: 14px;
  }
  .card-tag {
