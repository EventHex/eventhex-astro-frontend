    .egx-use-panel__visual img { animation: none; }
  }

  /* Registration-page hero design language, adapted for gamification. */
  .egx-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background: radial-gradient(ellipse 700px 500px at -5% -10%,#375dfb24,#375dfb0f 40%,#375dfb00 75%),radial-gradient(ellipse 800px 600px at 100% 105%,#ff74b83d,#ff74b81a 45%,#ff74b800 78%),#fff !important;
  }
  .egx-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 2;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right,#fff0,#ffffff73 70%,#ffffffbf);
    pointer-events: none;
  }
  .egx-hero__grid {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1080px;
    display: grid;
    grid-template-columns: minmax(260px,542px) minmax(0,490px);
    gap: 48px;
    align-items: center;
  }
  .egx-hero__copy { display:flex;flex-direction:column;align-items:flex-start;gap:20px; }
  .egx-hero .egx-kicker { margin:0;font-size:16px;font-weight:500;text-transform:uppercase; }
  .egx-hero h1 { width:100%;font-size:60px;line-height:66px;letter-spacing:-2.1px; }
  .egx-hero__copy>p { width:100%;max-width:none;margin:0;color:#555;font-size:18px;font-weight:400;line-height:24px;letter-spacing:-.25px; }
  .egx-actions { display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin:0;padding-top:8px; }
  .egx-btn { gap:6px;padding:12px 20px;border:1px solid transparent;border-radius:12px;background:#182230;color:#fff;font-size:15px;font-weight:650;line-height:22px;letter-spacing:-.3px;transition:transform .3s,background .3s,border-color .3s; }
  .egx-btn span { font-size:24px;font-weight:400;line-height:16px; }
  .egx-btn:hover { transform:translateY(-2px);background:#000; }
  .egx-btn--secondary { border-color:rgba(16,24,40,.22);background:transparent;color:#182230;box-shadow:none; }
  .egx-btn--secondary:hover { border-color:#182230;background:transparent; }
  .egx-proof { gap:18px;margin:0;padding-top:4px;color:#182230;font-size:16px;font-weight:400; }
  .egx-proof li::before { width:6px;height:6px;margin-right:10px;background:#10b981;vertical-align:2px; }
  .egx-hero__visual { position:relative;margin-right:calc(-1 * (max(0px,(100vw - 1128px) / 2) + 24px)); }
  .egx-composite { min-height:430px;max-width:none;margin:0;padding:46px 34px;border:1px solid rgba(255,255,255,.62);border-right:0;border-radius:22px 0 0 22px;background:linear-gradient(135deg,#d9ecfa,#eef6fc 45%,#fff);box-shadow:0 18px 55px rgba(44,61,95,.08); }
  .egx-composite__active { right:26px;bottom:40px;width:88%;aspect-ratio:1.79;border-radius:14px; }
  .egx-composite__rear { left:18px;top:28px;width:38%;aspect-ratio:1.05; }
  .egx-composite__pill--status { right:24px;top:28px; }
  .egx-composite__pill--action { left:18px;bottom:20px; }
  @media(max-width:1120px){.egx-hero__grid{grid-template-columns:minmax(0,1fr) minmax(0,460px);gap:32px}.egx-hero h1{font-size:46px;line-height:52px;letter-spacing:-1.5px}}
  @media(max-width:960px){.egx-hero{padding:130px 20px 48px}.egx-hero::after{display:none}.egx-hero__grid{grid-template-columns:1fr;gap:32px;text-align:center}.egx-hero__copy{align-items:center}.egx-hero__copy>p{max-width:520px}.egx-actions,.egx-proof{justify-content:center}.egx-hero__visual{margin-right:0}.egx-composite{border-right:1px solid rgba(255,255,255,.62);border-radius:22px}}
  @media(max-width:767px){.egx-hero{margin-top:-80px;padding:112px 16px 40px;text-align:left}.egx-hero__grid{text-align:left}.egx-hero__copy{align-items:flex-start}.egx-hero__copy>p{max-width:100%}.egx-proof{justify-content:flex-start}.egx-hero h1{font-size:34px;line-height:40px;letter-spacing:-.8px}.egx-actions{width:100%;flex-direction:column;align-items:stretch}.egx-btn{width:100%}.egx-composite{min-height:340px;padding:28px 18px}.egx-composite__active{right:14px;bottom:34px;width:92%}.egx-composite__rear{left:12px;top:20px}.egx-composite__pill--status{right:12px;top:18px}.egx-composite__pill--action{left:12px;bottom:12px}}

  /* Registration confirmation bento design, adapted for attendee progress. */
  .egx-progress { padding:80px 5%;background:transparent !important; }
  .egx-progress__inner { width:100%;max-width:1200px;margin:0 auto; }
  .egx-progress__heading { max-width:none;margin:0 0 60px;text-align:center; }
  .egx-progress__heading .egx-kicker { margin-bottom:16px; }
  .egx-progress__heading h2 { max-width:1000px;margin:0 auto;background:linear-gradient(90deg,#202938 20%,#9a9da4 100%);background-clip:text;-webkit-background-clip:text;color:transparent;-webkit-text-fill-color:transparent;font-size:clamp(32px,4vw,56px);font-weight:500;line-height:1.08;letter-spacing:-.03em; }
  .egx-progress__workspace { position:relative;display:grid;grid-template-columns:1fr 1fr;min-height:0;overflow:hidden;border:1px solid #e5e7eb;border-radius:16px;background:transparent; }
  .egx-progress__visual,.egx-progress__copy { min-width:0;padding:4rem; }
  .egx-progress__visual { position:relative;display:flex;align-items:center;justify-content:center;min-height:610px;overflow:hidden;border-right:1px solid #e5e7eb;background:transparent; }
  .egx-progress__visual::before { content:"";position:absolute;inset:64px;border-radius:22px;background:linear-gradient(180deg,#fdefb8 0%,#fdf7dd 45%,#f5f6f9 100%);filter:none; }
  .egx-progress__visual figure { position:relative;width:100%;margin:0;overflow:hidden;border:1px solid #dfe4ec;border-radius:14px;background:#fff;box-shadow:none;transform:none;animation:egxProgressBreathe 7s ease-in-out infinite;will-change:transform; }
  .egx-progress__visual img { display:block;width:100%;height:auto;object-fit:cover;object-position:top left; }
  .egx-progress__status,.egx-progress__points { z-index:3;padding:11px 14px;border:1px solid rgba(206,215,232,.9);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 14px 34px rgba(30,45,88,.2);font-size:.78rem;animation:egxProgressFloat 4.8s ease-in-out infinite; }
  .egx-progress__status { top:76px;left:auto;right:52px; }
  .egx-progress__points { right:auto;bottom:76px;left:52px;animation-delay:-2.4s; }
  .egx-progress__copy { display:flex;flex-direction:column;justify-content:center;background:transparent; }
  .egx-progress__label { margin-bottom:1rem;color:#5b21b6;font-size:.875rem;font-weight:600;letter-spacing:.05em; }
  .egx-progress__copy>h3 { max-width:none;margin:0 0 1.25rem;color:#111827;font-size:2.25rem;font-weight:500;line-height:1.02;letter-spacing:-.02em; }
  .egx-progress__copy>p { margin:0 0 1rem;color:#4b5563;font-size:1.125rem;line-height:1.45; }
  .egx-progress__copy ol { margin-top:8px; }
  .egx-progress__copy li { padding:14px 0;border-top:1px solid #e5e7eb; }
  .egx-progress__copy li>span { width:30px;height:30px; }
  .egx-progress__copy h4 { font-size:15px; }
  .egx-progress__copy li p { font-size:12px; }
  .egx-progress__notch,.egx-progress__cross { position:absolute;left:50%;z-index:4;width:28px;height:28px;pointer-events:none; }
  .egx-progress__notch::before,.egx-progress__cross::before,.egx-progress__cross::after { content:"";position:absolute;inset:7px 0;border-radius:50%;background:#e5e7eb; }
  .egx-progress__notch::after,.egx-progress__cross::after { transform:rotate(90deg); }
  .egx-progress__notch--top { top:0;transform:translate(-50%,-50%); }
  .egx-progress__notch--bottom { bottom:0;transform:translate(-50%,50%); }
  .egx-progress__cross { bottom:0;transform:translate(-50%,50%); }
  @keyframes egxProgressBreathe{0%,100%{transform:translateY(3px) scale(.985)}50%{transform:translateY(-3px) scale(1)}}
  @keyframes egxProgressFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-9px,0)}}
  @media(max-width:900px){.egx-progress__workspace{grid-template-columns:1fr}.egx-progress__copy{order:1;border-bottom:1px solid #e5e7eb}.egx-progress__visual{order:2;min-height:520px;border-right:0}.egx-progress__notch,.egx-progress__cross{display:none}}
