  @keyframes egx-leaderboard-float { 50% { transform: translateY(-10px); } }
  .egx-leaderboard-spacer { height: 190px; }
  @media (max-width: 1024px) {
    .egx-dark__inner { padding: 20px 20px 30px; }
    .egx-heading--dark h2 { font-size: 40px; line-height: 1; }
    .egx-leaderboard-cards { --egx-stack-top: 292px; }
    .egx-leaderboard-stage { height: 450px; }
