  /* Match the event-registration page's heading type scale and dark-band ink. */
  .egx-page {
    --egx-section-title-size: clamp(2.125rem, 5vw, 3.75rem);
    --egx-section-title-line: 1.08;
    --egx-section-title-tracking: -0.04em;
    background:
      radial-gradient(ellipse 75% 68% at 50% 40%, rgba(255,255,255,.94) 0%, rgba(255,255,255,.65) 38%, rgba(255,255,255,.28) 58%, transparent 78%),
      linear-gradient(to bottom, #fff 0, rgba(255,255,255,.85) 130px, rgba(255,255,255,.5) 260px, rgba(255,255,255,.18) 390px, transparent 500px),
      linear-gradient(to top, #fff 0, rgba(255,255,255,.7) 70px, rgba(255,255,255,.3) 130px, transparent 190px),
      radial-gradient(circle 380px at 3% 34%, rgba(175,163,255,.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 30%, rgba(255,182,213,.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 75%, rgba(130,170,255,.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 78%, rgba(255,224,150,.2) 0%, transparent 100%),
      #fff;
    background-attachment: fixed;
  }
  .egx-page > section:not(.egx-actions-dark):not(.egx-dark) {
    background: transparent !important;
  }
  .egx-page h1 {
    font-family: var(--font-heading);
    font-size: 60px;
    font-weight: 500;
    line-height: 66px;
    letter-spacing: -2.1px;
  }
  .egx-hero .egx-kicker {
    color: var(--blue);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: normal;
  }
  .egx-hero h1 {
    background: linear-gradient(98deg, var(--ink) 43.06%, #8f8f8f 91.81%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .egx-hero__copy > p {
    color: #555;
  }
  .egx-page h2 {
    font-family: var(--font-heading);
    font-size: var(--egx-section-title-size);
    font-weight: 500;
    line-height: var(--egx-section-title-line);
    letter-spacing: var(--egx-section-title-tracking);
  }
  .egx-page h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .egx-actions-dark h2,
  .egx-dark h2 {
    background: linear-gradient(100deg, #fff 0%, #f2f0ff 26%, #c9c2ff 52%, #a79aff 74%, #7d8dff 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0;
  }
  .egx-actions-dark h3,
  .egx-dark h3 {
    color: #fff;
  }

  /* Large, readable organizer-control cards inspired by the Copilot feature stack. */
  .egx-leaderboard-stage {
    grid-template-columns: 1fr;
    gap: 48px;
    padding: clamp(32px, 5vw, 64px);
  }
  .egx-leaderboard-copy {
    max-width: none;
  }
  .egx-leaderboard-copy > h3 {
    max-width: 700px;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.025em;
  }
  .egx-leaderboard-copy > p {
    max-width: 720px;
    margin: 18px 0 34px;
    font-size: 17px;
  }
  .egx-leaderboard-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    padding: 0;
  }
  .egx-leaderboard-controls article,
  .egx-leaderboard-controls article:nth-child(n) {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    width: 100%;
    min-height: 148px;
    margin: 0;
    padding: 24px;
    border: 1px solid rgba(153,171,232,.24);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(27,38,75,.94), rgba(9,15,36,.96));
    box-shadow: 0 18px 42px rgba(0,0,0,.22);
  }
  .egx-leaderboard-controls article:hover {
    transform: translateY(-4px);
    border-color: rgba(141,162,255,.58);
  }
  .egx-leaderboard-controls article > span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(141,162,255,.36);
    border-radius: 12px;
    background: rgba(141,162,255,.12);
    color: #aebcff;
    font-size: 12px;
  }
  .egx-leaderboard-controls h4 {
    margin: 2px 0 8px;
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }
  .egx-leaderboard-controls p {
    margin: 0;
    color: #aeb7c8;
    font-size: 14px;
    line-height: 1.55;
  }
  .egx-leaderboard-visual {
    min-height: 560px;
    border-right: 1px solid rgba(255,255,255,.12);
    border-radius: 20px;
  }
  @media (max-width: 720px) {
    .egx-leaderboard-stage {
      gap: 34px;
      padding: 24px 18px;
    }
    .egx-leaderboard-controls {
      grid-template-columns: 1fr;
    }
    .egx-leaderboard-controls article,
    .egx-leaderboard-controls article:nth-child(n) {
      min-height: 132px;
      padding: 20px;
    }
    .egx-leaderboard-visual {
      min-height: 360px;
    }
  }

  /* Registration-style FAQ: intro first, then a rounded accordion stack. */
  .egx-faq {
    width: 100%;
    padding: 80px 24px;
  }
  .egx-faq .egx-shell {
    width: min(1140px, 100%);
  }
  .egx-faq__grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }
  .egx-faq aside {
    position: sticky;
    top: 6rem;
  }
  .egx-faq aside .egx-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    padding: 8px 16px;
    border: 1px solid #e4e7ec;
    border-radius: 999px;
    color: #000;
    font-family: var(--font-body);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
  }
  .egx-faq aside .egx-kicker::before {
    content: "↗";
  }
  .egx-faq aside h2 {
    margin: 0 0 20px;
    color: #000;
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -1px;
  }
  .egx-faq aside > p {
    margin: 0 0 28px;
    color: #667085;
    font-size: 1rem;
    line-height: 1.6;
  }
  .egx-faq aside .egx-btn {
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    box-shadow: none;
    font-size: .9375rem;
    font-weight: 500;
  }
  .egx-faq__grid > div {
    display: flex;
    flex-direction: column;
    gap: 16px;
    counter-reset: gamification-faq;
  }
  .egx-faq details {
    counter-increment: gamification-faq;
    padding: 4px 28px;
    overflow: hidden;
    border: 1px solid #e4e7ec;
    border-radius: 20px;
    background: #fff;
    transition: background .25s ease, border-color .25s ease;
  }
  .egx-faq details[open] {
    border-color: #e4e7ec;
    background: #e4e7ec;
  }
  .egx-faq summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0 16px 24px;
    color: #000;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: normal;
  }
  .egx-faq summary::before {
    content: counter(gamification-faq) ". ";
    position: absolute;
    left: 0;
  }
  .egx-faq summary > span {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-left: auto;
  }
  .egx-faq summary > span::before,
  .egx-faq summary > span::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: #000;
    transform: translate(-50%, -50%);
  }
  .egx-faq summary > span::before {
    width: 14px;
    height: 2px;
  }
  .egx-faq summary > span::after {
    width: 2px;
    height: 14px;
  }
  .egx-faq details[open] summary > span::after {
    opacity: 0;
  }
  .egx-faq details > p {
    max-width: 640px;
    margin: 0;
    padding: 0 0 24px;
    color: #000;
    font-size: .9375rem;
    line-height: 1.7;
  }
  @media (max-width: 1024px) {
    .egx-faq__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
