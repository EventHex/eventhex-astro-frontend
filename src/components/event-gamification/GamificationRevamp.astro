<script>
  function initGamificationDraw() {
    const section = document.querySelector<HTMLElement>(".egx-draw");
    if (!section || section.dataset.drawReady === "true") return;
    section.dataset.drawReady = "true";
    const steps = Array.from(section.querySelectorAll<HTMLElement>("[data-draw-step]"));
    steps.forEach(step => step.querySelector<HTMLButtonElement>(".egx-draw-step__toggle")?.addEventListener("click", () => {
      const opening = !step.classList.contains("is-open");
      steps.forEach(item => {
        const open = item === step && opening;
        item.classList.toggle("is-open", open);
        item.querySelector<HTMLButtonElement>(".egx-draw-step__toggle")?.setAttribute("aria-expanded", String(open));
        const body = item.querySelector<HTMLElement>(".egx-draw-step__body");
        if (body) body.hidden = !open;
      });
    }));
  }
  function initGamificationUseTabs() {
    const section = document.querySelector<HTMLElement>(".egx-use");
    if (!section || section.dataset.tabsReady === "true") return;
    section.dataset.tabsReady = "true";
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>(".egx-use-tab"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>(".egx-use-panel"));
    const select = (tab: HTMLButtonElement) => {
      const target = tab.dataset.useTab;
      tabs.forEach(item => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach(panel => {
        const active = panel.dataset.usePanel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", event => {
        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[nextIndex]);
        tabs[nextIndex].focus();
      });
    });
  }
  function initGamificationRewardTabs() {
    const section = document.querySelector<HTMLElement>(".egx-choice");
    if (!section || section.dataset.tabsReady === "true") return;
    section.dataset.tabsReady = "true";
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>(".egx-choice-tab"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>(".egx-choice-panel"));
    const select = (tab: HTMLButtonElement) => {
      const target = tab.dataset.rewardTab;
      tabs.forEach(item => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach(panel => {
        const active = panel.dataset.rewardPanel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", event => {
        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[nextIndex]);
        tabs[nextIndex].focus();
      });
    });
  }
  function initGamificationActionsBleed() {
    const section = document.querySelector<HTMLElement>(".egx-actions-dark");
    if (!section || section.dataset.bleedReady === "true") return;
    section.dataset.bleedReady = "true";
    const update = () => {
      const rect = section.getBoundingClientRect();
      const start = window.innerHeight * .92;
      const end = window.innerHeight * .35;
      const progress = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
      section.style.setProperty("--band-p", progress.toFixed(3));
    };
    let frame = 0;
    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => { frame = 0; update(); });
    };
    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
  }
  initGamificationDraw();
  initGamificationUseTabs();
  initGamificationRewardTabs();
  initGamificationActionsBleed();
  document.addEventListener("astro:page-load", initGamificationDraw);
  document.addEventListener("astro:page-load", initGamificationUseTabs);
  document.addEventListener("astro:page-load", initGamificationRewardTabs);
  document.addEventListener("astro:page-load", initGamificationActionsBleed);
</script>
