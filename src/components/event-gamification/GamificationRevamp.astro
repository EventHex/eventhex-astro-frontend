---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;

const actions = [
  ["Complete a profile", "Recognize profile setup or profile-picture completion."],
  ["Build connections", "Reward a first connection or defined connection milestones."],
  ["Use event messaging", "Recognize a sent message or AI chat action."],
  ["Contribute or view photos", "Connect gallery participation to points."],
  ["Engage with content", "Reward a session rating, live Q&A, or speaker bookmark."],
  ["Return to the event", "Use the supported active-user trigger for recurring participation."],
];
const progress = [
  ["See active challenges", "Display eligible challenges for this event and time window."],
  ["Complete an action", "Record progress against the matching action key."],
  ["Receive points", "Update the attendee total after validated completion."],
  ["Review history", "Show where points came from and the resulting progress."],
];
const progressFeatures = [
  { eyebrow: "01 · AVAILABLE NOW", title: "See active challenges", desc: "Display eligible challenges for this event and time window.", image: "/images/event-gamification/app/gamification-features-live.png", alt: "EventHex attendee gamification features available in the live event workspace", tint: "#fdefb8", chip: "Challenge active", meta: "Available in the event app" },
  { eyebrow: "02 · ACTION RECORDED", title: "Complete an action", desc: "Record progress against the matching action key.", image: "/images/event-gamification/app/attendee-app-modules-live.png", alt: "EventHex attendee app modules showing connected activity", tint: "#dff5e9", chip: "Action verified", meta: "Progress recorded" },
  { eyebrow: "03 · POINTS UPDATED", title: "Receive points", desc: "Update the attendee total after validated completion.", image: "/images/event-gamification/app/attendee-engagement-analytics.png", alt: "EventHex attendee engagement analytics showing participation and points progress", tint: "#e1e8ff", chip: "+100 points", meta: "Total updated" },
  { eyebrow: "04 · HISTORY READY", title: "Review history", desc: "Show where points came from and the resulting progress.", image: "/images/event-gamification/app/platform-analytics-live.png", alt: "EventHex platform analytics used to review attendee and event progress", tint: "#f7e3ef", chip: "History ready", meta: "Every point explained" },
];
const leaderboard = [
  ["Show or hide", "Control whether the event leaderboard is visible."],
  ["Display top ranks", "Choose the supported top-10, 20, 50, or 100 view."],
  ["Tie-break rule", "Use first-to-score, recent activity, or alphabetical ordering."],
  ["Anonymous mode", "Hide attendee identity when the event requires it."],
  ["Refresh policy", "Configure real-time, hourly, or daily update behavior."],
  ["Manual adjustment", "Add or remove points with a recorded reason."],
];
const leaderboardCards = [
  {
    eyebrow: "Organizer control",
    title: "Shape a leaderboard that fits your event",
    desc: "Set whether rankings are visible, choose how many positions appear, and keep every leaderboard decision inside one connected organizer workflow.",
    image: "/images/event-gamification/app/gamification-features-live.png",
    alt: "EventHex organizer controls for gamification features and leaderboard visibility",
    controls: leaderboard.slice(0, 2),
  },
  {
    title: "Keep rankings fair, timely, and appropriate for the audience",
    desc: "Choose the tie-break rule, protect attendee identity with anonymous mode, and decide how frequently positions refresh during the event.",
    image: "/images/event-gamification/app/gamification-settings.png",
    alt: "EventHex gamification settings for challenges, leaderboard, rewards, and points history",
    controls: leaderboard.slice(2, 5),
  },
  {
    title: "Review performance and make accountable adjustments",
    desc: "See engagement activity alongside rank and points, then add or remove points with a recorded reason when an organizer needs to intervene.",
    image: "/images/event-gamification/app/attendee-engagement-analytics.png",
    alt: "EventHex attendee engagement analytics used to review leaderboard performance",
    controls: leaderboard.slice(5),
  },
];
const rewardModes = [
  { id: "position", tab: "Position rewards", eyebrow: "01 · TOP FINISHERS", title: "Reward the people who finish on top", description: "Attach a prize name, description, value, or coupon to a leaderboard position.", image: "/images/event-gamification/app/gamification-settings.png", alt: "EventHex gamification settings with leaderboard, reward, and attendee mobile-app controls", tint: "#fff8dc", line: "#f0dfa6", best: "Best for ranked outcomes" },
  { id: "milestone", tab: "Milestone rewards", eyebrow: "02 · BROADER PARTICIPATION", title: "Celebrate progress beyond the podium", description: "Unlock a named reward when an attendee reaches the configured points threshold.", image: "/images/event-gamification/app/attendee-engagement-analytics.png", alt: "EventHex attendee engagement analytics for reviewing participation milestones", tint: "#edf7ff", line: "#d4e7f7", best: "Best for progress goals" },
];
const drawSteps = [
  { title: "Name the draw", desc: "Give the prize moment a clear identity attendees and organizers can recognize.", points: ["Draw name and description", "Event-specific prize moment", "Clear organizer context"], image: "/images/event-gamification/app/events-overview-live.png", alt: "EventHex events overview used to select the event context for a prize draw" },
  { title: "Set the prize", desc: "Store the reward details before the draw opens.", points: ["Prize name", "Optional description", "Fulfillment stays with the organizer"], image: "/images/event-gamification/app/gamification-feature-settings.png", alt: "EventHex gamification feature settings with reward controls enabled" },
  { title: "Choose the threshold", desc: "Define the minimum point total required for entry.", points: ["Points-based eligibility", "Only qualifying attendees", "One connected event score"], image: "/images/event-gamification/app/gamification-app-module.png", alt: "EventHex attendee gamification module used for points-based participation" },
  { title: "Pick the winner", desc: "Run the server-side selection once the open draw is ready.", points: ["Validated eligible pool", "Single draw action", "Winner selected from qualifiers"], image: "/images/event-gamification/app/attendee-app-modules-live.png", alt: "EventHex attendee app modules used to manage the eligible event audience" },
  { title: "Record the outcome", desc: "Keep the result and useful draw context together.", points: ["Winner record", "Eligible attendee count", "Draw date and time"], image: "/images/event-gamification/app/platform-analytics-live.png", alt: "EventHex platform analytics for reviewing recorded event outcomes" },
];
const useCases = [
  { id: "conferences", label: "Conferences", title: "Reward the moments that move the room", description: "Connect networking, questions, and session feedback to one visible participation goal.", points: ["Session feedback", "Audience questions", "New connections"], image: "/images/event-gamification/app/attendee-engagement-analytics.png", alt: "EventHex attendee analytics showing engagement across conference activities" },
  { id: "associations", label: "Associations", title: "Recognize participation across the community", description: "Give members a consistent reason to take part in recurring activities throughout the programme.", points: ["Profile completion", "Member connections", "Session ratings"], image: "/images/event-gamification/app/attendee-mobile-app-features.png", alt: "EventHex attendee mobile-app features for community participation" },
  { id: "exhibitions", label: "Exhibitions", title: "Guide attendees towards valuable actions", description: "Encourage the app, content, and networking activity that helps attendees explore the event.", points: ["Gallery activity", "Attendee messages", "Profile discovery"], image: "/images/event-gamification/app/attendee-app-modules.png", alt: "EventHex attendee app modules configured for exhibition engagement" },
  { id: "corporate", label: "Corporate events", title: "Turn learning into active participation", description: "Support learning and community goals with challenges that reinforce the programme, not distract from it.", points: ["Session attendance", "Live Q&A", "Peer connections"], image: "/images/event-gamification/app/gamification-features-live.png", alt: "EventHex gamification controls configured for corporate-event participation" },
  { id: "tech", label: "Tech conferences", title: "Connect every programme touchpoint", description: "Bring sessions, questions, profiles, and networking into one challenge journey for technical audiences.", points: ["Speaker bookmarks", "Technical questions", "Networking actions"], image: "/images/event-gamification/app/platform-analytics-live.png", alt: "EventHex platform analytics covering conference programme activity" },
  { id: "hybrid", label: "Hybrid events", title: "Keep one challenge open to every attendee", description: "Use mobile actions shared across the attendee experience so in-person and remote audiences can participate.", points: ["Mobile app activity", "Session feedback", "Attendee connections"], image: "/images/event-gamification/app/events-overview-live.png", alt: "EventHex multi-event overview supporting hybrid event participation" },
];
---

<main class="egx-page">
  <section class="egx-hero" id="hero">
    <div class="egx-shell egx-hero__grid">
      <div class="egx-hero__copy">
        <span class="egx-kicker">Event gamification software</span>
        <h1>Turn the attendee actions you value into a connected event challenge</h1>
        <p>Reward meaningful app activity with configurable points, show progress and rank, and keep challenges, leaderboards, rewards, and draws tied to the event.</p>
        <div class="egx-actions"><a class="egx-btn egx-btn--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">›</span></a><a class="egx-btn egx-btn--secondary" href="#workflow">See the workflow <span aria-hidden="true">›</span></a></div>
        <ul class="egx-proof"><li>Real app actions</li><li>Clear earning rules</li><li>Visible progress</li></ul>
      </div>
      <div class="egx-hero__visual" aria-label="EventHex gamification configuration workflow">
        <div class="egx-composite">
          <figure class="egx-composite__rear">
            <img src="/images/event-gamification/app/gamification-app-module.png" alt="EventHex attendee app module card with Gamification enabled" width="294" height="280" loading="eager" />
          </figure>
          <figure class="egx-composite__active">
            <img src="/images/event-gamification/app/gamification-settings.png" alt="EventHex gamification settings alongside the attendee mobile-app preview" width="1263" height="698" loading="eager" />
          </figure>
          <span class="egx-composite__pill egx-composite__pill--status"><i></i> Gamification enabled</span>
          <span class="egx-composite__pill egx-composite__pill--action">Choose attendee features</span>
        </div>
      </div>
    </div>
  </section>

  <section class="egx-rail" aria-label="Event gamification earning loop"><div class="egx-rail__inner"><span><b>Choose an action</b> attendees already take</span><span><b>Set rules &amp; award</b> points</span><span><b>Show progress &amp; rank</b> attendees</span><span><b>Rewards &amp; draws</b> in one workflow</span></div></section>

  <section class="egx-problem" aria-labelledby="connected-game-title">
    <div class="egx-shell egx-problem__grid">
      <div class="egx-problem__copy">
        <span class="egx-kicker">Connected gamification</span>
        <h2 id="connected-game-title">Make the game part of the event—<span>not another disconnected platform</span></h2>
        <p>Use actions attendees already complete inside the event app, then connect every validated action to points, progress, rank, and the configured outcome. Challenge rules stay tied to supported event-app actions and one attendee record.</p>
        <div class="egx-problem__actions">
          <a class="egx-problem__primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="egx-problem__secondary" href="#workflow">Explore the workflow <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="egx-problem__visual" role="img" aria-label="EventHex attendee app modules and gamification feature settings">
        <figure class="egx-problem__shot egx-problem__shot--modules"><img src="/images/event-gamification/app/attendee-app-modules.png" alt="EventHex attendee app modules configuration" width="1263" height="698" loading="lazy" decoding="async" /></figure>
        <figure class="egx-problem__shot egx-problem__shot--settings"><img src="/images/event-gamification/app/gamification-feature-settings.png" alt="EventHex gamification challenge, leaderboard, and reward settings" width="1104" height="600" loading="lazy" decoding="async" /></figure>
        <span class="egx-problem__status"><i aria-hidden="true">✓</i> Event app connected</span>
        <span class="egx-problem__action">Configure &amp; launch</span>
        <svg class="egx-problem__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
      </div>
    </div>
  </section>

  <section class="egx-actions-dark" id="actions" aria-labelledby="actions-title">
    <header class="egx-actions-dark__heading"><span>Supported attendee actions</span><h2 id="actions-title">Build challenges around <em>interactions already inside the event app</em></h2><p>Use stable app-action triggers that the current mobile experience can complete.</p></header>
    <div class="egx-actions-dark__grid-wrap"><div class="egx-action-grid">
      {actions.map(([title, desc], i) => <article class="egx-action-card animate-on-scroll" data-animation="fadeInUp" data-delay={i * 60}>
        {(i === 1 || i === 2) && <><span class="egx-action-card__petal egx-action-card__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span><span class="egx-action-card__petal egx-action-card__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span></>}
        <span class="egx-action-card__number">{String(i + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{desc}</p>
        <div class="egx-action-card__visual" aria-hidden="true">
          {i === 0 ? <div class="egx-action-checklist"><strong>Profile challenge</strong><span><i></i>Basic details<b>Ready</b></span><span><i></i>Profile photo<b>+100</b></span><span><i></i>Completion<b>Verified</b></span></div>
          : i === 1 ? <div class="egx-action-progress"><strong>Connection goal</strong><span>Connections made</span><i><b></b></i><span>Milestone progress</span><i><b></b></i></div>
          : i === 2 ? <div class="egx-action-filters"><strong>Messaging actions</strong><div><span>Message</span><span class="is-active">AI chat</span><span>Reward</span></div></div>
          : i === 3 ? <div class="egx-action-gallery"><strong>Gallery activity</strong><span><i></i>Photo contributed<b>+40</b></span><span><i></i>Gallery viewed<b>+15</b></span></div>
          : i === 4 ? <div class="egx-action-bars"><strong>Content engagement</strong><span><i style="--bar:88%"></i></span><span><i style="--bar:68%"></i></span><span><i style="--bar:46%"></i></span></div>
          : <div class="egx-action-trend"><strong>Recurring participation</strong><svg viewBox="0 0 260 104" preserveAspectRatio="none"><path d="M0 87 C35 80 46 62 73 68 S116 48 142 52 S178 26 201 34 S232 13 260 17"></path></svg></div>}
        </div>
      </article>)}
    </div></div>
  </section>

  <section class="egx-workflow" id="workflow" aria-labelledby="workflow-title">
    <div class="egx-workflow__container">
      <div class="egx-workflow__left"><div class="egx-workflow__sticky">
        <div class="egx-workflow__eyebrow">Challenge rules</div>
        <h2 id="workflow-title">Configure what counts, when it counts, and how often</h2>
        <p>Start with one supported action, then shape the earning rule around the event programme.</p>
        <a class="egx-workflow__cta" href="/book-a-demo/">Map your challenge <span aria-hidden="true">→</span></a>
      </div></div>
      <div class="egx-workflow__right">
        <article class="egx-rule-card"><div class="egx-rule-card__header"><div class="egx-rule-card__number">01</div><div><h3>Choose the features</h3><p>Enable the challenge, leaderboard, reward, points, and history experiences your attendees need.</p></div></div><div class="egx-rule-card__visual"><div class="egx-rule-shot"><img src="/images/event-gamification/app/gamification-feature-settings.png" alt="EventHex settings for attendee gamification features" width="1075" height="600" loading="lazy" /><span class="egx-rule-shot__status">Features selected</span><span class="egx-rule-shot__action">Save changes</span><i class="egx-rule-shot__cursor" aria-hidden="true"></i></div></div></article>
        <article class="egx-rule-card"><div class="egx-rule-card__header"><div class="egx-rule-card__number">02</div><div><h3>Choose the mode</h3><p>Use a single challenge or allow recurring completion for the same supported action.</p></div></div><div class="egx-rule-card__visual"><figure class="egx-product-shot"><img src="/images/event-gamification/app/gamification-app-module.png" alt="EventHex attendee app module with gamification enabled" width="294" height="280" loading="lazy" /></figure></div></article>
        <article class="egx-rule-card"><div class="egx-rule-card__header"><div class="egx-rule-card__number">03</div><div><h3>Define completion</h3><p>Set the required action count and the points awarded after validated completion.</p></div></div><div class="egx-rule-card__visual"><figure class="egx-product-shot"><img src="/images/event-gamification/app/attendee-mobile-app-features.png" alt="EventHex attendee mobile-app configuration where supported challenge actions are managed" width="580" height="600" loading="lazy" /></figure></div></article>
        <article class="egx-rule-card"><div class="egx-rule-card__header"><div class="egx-rule-card__number">04</div><div><h3>Set availability and limits</h3><p>Add optional dates and tracks, then use daily caps and cooldowns for recurring challenges.</p></div></div><div class="egx-rule-card__visual"><figure class="egx-product-shot"><img src="/images/event-gamification/app/events-overview-live.png" alt="EventHex event overview showing event dates, status, and event context" width="1263" height="698" loading="lazy" /></figure></div></article>
      </div>
    </div>
  </section>

  <section class="egx-progress" aria-labelledby="progress-title">
    <div class="egx-progress__inner">
      <header class="egx-progress__heading">
        <h2 id="progress-title">Show what is available, what is complete, and how points were earned</h2>
      </header>
      <div class="egx-progress__bento">
        {progressFeatures.map((item, i) => <article class:list={["egx-progress__row", { "egx-progress__row--reverse": i % 2 === 1 }]}>
          <div class="egx-progress__cell egx-progress__visual" style={`--progress-tint:${item.tint}`}>
            <div class="egx-progress__stage">
              <img src={item.image} alt={item.alt} width="1263" height="698" loading="lazy" decoding="async" />
              <span class="egx-progress__float egx-progress__float--top"><b>{item.chip}</b><small>{item.meta}</small></span>
              <span class="egx-progress__float egx-progress__float--bottom"><i></i><b>{item.title}</b></span>
            </div>
          </div>
          <div class="egx-progress__cell egx-progress__copy">
            <span class="egx-progress__label">{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="egx-choice" aria-labelledby="rewards-title">
    <div class="egx-choice__inner">
      <header class="egx-choice__header"><span class="egx-kicker">Rewards</span><h2 id="rewards-title">Recognize both top finishers<br />and milestone progress</h2><p>Configure the reward model that fits the event, then surface it in the attendee experience.</p></header>
      <div class="egx-choice-tabs" role="tablist" aria-label="Reward models">{rewardModes.map((item, index) => <button class:list={["egx-choice-tab", { "is-active": index === 0 }]} type="button" role="tab" id={`reward-tab-${item.id}`} aria-controls={`reward-panel-${item.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-reward-tab={item.id}>{item.tab}</button>)}</div>
      <div class="egx-choice-panels">{rewardModes.map((item, index) => <article class:list={["egx-choice-panel", { "is-active": index === 0 }]} id={`reward-panel-${item.id}`} role="tabpanel" aria-labelledby={`reward-tab-${item.id}`} data-reward-panel={item.id} hidden={index !== 0} style={`--reward-tint:${item.tint};--reward-line:${item.line}`}><div class="egx-choice-panel__copy"><span>{item.eyebrow}</span><h3>{item.title}</h3><p>{item.description}</p><b>{item.best}</b></div><figure class="egx-reward-preview"><img src={item.image} alt={item.alt} width="1263" height="698" loading="lazy" /></figure></article>)}</div>
      <p class="egx-choice__note">Reward fulfillment, availability, tax, and terms remain the organizer's responsibility.</p>
    </div>
  </section>

  <section class="egx-dark" aria-labelledby="leaderboard-title">
    <div class="egx-dark__inner">
      <header class="egx-heading egx-heading--dark">
        <span class="egx-dark__tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2-2.9 2.5-5Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1-1.5-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg>Leaderboard controls</span>
        <h2 id="leaderboard-title"><span>Make competition visible on the</span><span>organizer's <em>terms</em></span></h2>
      </header>
      <div class="egx-leaderboard-cards">
        {leaderboardCards.map((card, i) => <article class="egx-leaderboard-stage" style={`--card-index:${i}`}>
          <div class="egx-leaderboard-copy">
            {card.eyebrow && <span class="egx-dark__card-tag">{card.eyebrow}</span>}
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
            <div class="egx-leaderboard-controls">
              {card.controls.map(([title]) => <span>{title}</span>)}
            </div>
            <a href="/book-a-demo/">Explore More</a>
          </div>
          <div class="egx-leaderboard-visual"><img src={card.image} alt={card.alt} width="1263" height="698" loading="lazy" /></div>
        </article>)}
        <div class="egx-leaderboard-spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="egx-draw" aria-labelledby="draw-title"><div class="egx-draw__inner"><header class="egx-draw__heading"><span class="egx-kicker">Points-threshold draw</span><h2 id="draw-title">Give Eligible Attendees <em>Another Path to a Reward</em></h2><p>Create the prize, qualify attendees by points, select a winner, and keep the outcome recorded in one connected workflow.</p></header><div class="egx-draw__steps">{drawSteps.map((step, i) => <article class:list={["egx-draw-step", { "is-open": i === 0 }]} style={`--draw-hue:${i === 0 ? "#fff9df" : i === 1 ? "#eef9f2" : i === 2 ? "#eef2ff" : i === 3 ? "#fff0f3" : "#f3efff"};--draw-line:${i === 0 ? "#efdca0" : i === 1 ? "#cfe9d9" : i === 2 ? "#d4dcfa" : i === 3 ? "#efd3da" : "#ddd2f1"}`} data-draw-step><button type="button" class="egx-draw-step__toggle" aria-expanded={i === 0 ? "true" : "false"}><span>{String(i + 1).padStart(2, "0")}</span><strong>{step.title}</strong><small>{step.desc}</small><i aria-hidden="true"></i></button><div class="egx-draw-step__body" hidden={i !== 0}><div><p>{step.desc}</p><ul>{step.points.map(point => <li><span aria-hidden="true">✦</span>{point}</li>)}</ul></div><figure class="egx-draw-step__visual"><img src={step.image} alt={step.alt} width="1263" height="698" loading="lazy" /></figure></div></article>)}</div></div></section>

