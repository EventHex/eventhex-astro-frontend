    .egx-leaderboard-visual { margin: 12px; padding: 16px; }
    .egx-leaderboard-spacer { height: 100px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .egx-dark, .egx-leaderboard-visual img { animation: none; }
  }

  /* Real EventHex product screenshots, framed with the speaker-management visual treatment. */
  .egx-composite__rear { animation: egx-shot-drift 5.4s ease-in-out infinite; }
  .egx-composite__active { animation: egx-shot-float 4.8s ease-in-out infinite; }
  .egx-composite__active::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 25%, rgba(255,255,255,.24) 48%, transparent 70%);
    transform: translateX(-125%);
    animation: egx-shot-sheen 6s ease-in-out infinite;
  }
  @keyframes egx-shot-float { 50% { transform: translateY(-8px); } }
  @keyframes egx-shot-drift { 50% { transform: translate(5px, -5px) rotate(.4deg); } }
  @keyframes egx-shot-sheen { 0%, 55% { transform: translateX(-125%); } 82%, 100% { transform: translateX(125%); } }

  .egx-product-shot {
    position: relative;
    width: 100%;
    height: 270px;
    margin: 0;
    padding: 14px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.9);
