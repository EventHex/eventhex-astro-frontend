  /* Speaker-management stacking-card design system, adapted for leaderboard controls. */
  .egx-dark {
    width: 100%;
    padding: 4px 0 30px;
    overflow: visible;
    background-color: #000;
    background-image:
      linear-gradient(180deg, #0d0a2c 0%, transparent 320px),
      radial-gradient(circle at 12% 30%, rgba(70, 130, 255, .28) 0%, transparent 55%);
    background-repeat: no-repeat;
    background-size: 100% 100%, 120% 120%;
    animation: egx-leaderboard-mesh 30s linear infinite;
  }
  @keyframes egx-leaderboard-mesh {
    0%, 100% { background-position: 0 0, 0 0; }
    50% { background-position: 0 0, 8% 10%; }
  }
  .egx-dark::before { display: none; }
  .egx-dark__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
  }
  .egx-dark .egx-heading {
    position: sticky;
    top: 69px;
    z-index: 20;
    isolation: isolate;
    width: min(94%, 1050px);
    max-width: none;
    margin: 0;
    padding: 24px 0;
  }
  .egx-dark .egx-heading::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -1px;
    bottom: -28px;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(180deg, rgba(13,10,44,.99), rgba(7,11,27,.98) 72%, rgba(7,11,27,0));
  }
  .egx-dark__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding: 6px 16px 6px 12px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 6px 16px -6px rgba(0,0,0,.35);
    color: #fff;
    font: 500 15px/24px var(--font-body);
    backdrop-filter: blur(16px);
  }
  .egx-dark__tag svg { width: 16px; height: 16px; }
  .egx-heading--dark h2 {
    color: #fff;
    background: none;
    -webkit-text-fill-color: currentColor;
    font-size: 46px;
    line-height: 1.15;
    letter-spacing: 0;
  }
  .egx-heading--dark h2 > span { display: block; }
  .egx-heading--dark h2 em { color: #afa3ff; font-style: normal; }
  .egx-leaderboard-cards {
    --egx-stack-top: 300px;
    position: relative;
    width: 100%;
    padding: 80px 0 50px;
  }
  .egx-leaderboard-stage {
    position: sticky;
    top: calc(var(--egx-stack-top) + var(--card-index) * 20px);
    z-index: var(--card-index);
    display: flex;
    gap: 0;
    align-items: stretch;
    width: 100%;
    height: 500px;
    min-height: 0;
    margin: 0 0 60px;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 20px;
    background:
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255,255,255,.16), transparent 70%),
      radial-gradient(circle at 12% 8%, rgba(90,130,255,.18), transparent 40%),
      #0a0a0f;
    box-shadow: none;
  }
  .egx-leaderboard-stage:first-child {
    background: radial-gradient(circle at 82% 12%, rgba(109,92,235,.24), transparent 34%), radial-gradient(circle at 8% 92%, rgba(66,173,218,.13), transparent 28%), #090a10;
  }
  .egx-leaderboard-copy {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 40px;
  }
  .egx-dark__card-tag {
    align-self: flex-start;
    padding: 7px 13px;
    border: 1px solid rgba(175,163,255,.28);
    border-radius: 999px;
    background: rgba(175,163,255,.1);
    color: #afa3ff;
    font: 600 12px/1.2 var(--font-body);
  }
  .egx-leaderboard-copy > h3 {
    max-width: none;
    color: #e7e4fa;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
  }
  .egx-leaderboard-copy > p {
    max-width: none;
    margin: 0;
    color: rgba(255,255,255,.55);
    font-size: 17px;
    line-height: 1.65;
  }
  .egx-leaderboard-controls { display: flex; flex-wrap: wrap; gap: 7px; padding: 0; }
  .egx-leaderboard-controls > span {
    padding: 6px 9px;
    border: 1px solid rgba(175,163,255,.2);
    border-radius: 999px;
    color: #bdb5ef;
    font: 500 11px/1.2 var(--font-body);
  }
  .egx-leaderboard-copy > a {
