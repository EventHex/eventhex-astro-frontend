---
const captureOptions = [
  ["Record Live", "Start recording and transcription for a selected agenda session."],
  ["Upload Session Audio", "Add an existing recording and map it to the correct session."],
  ["Import YouTube Captions", "Use captions exposed by a YouTube URL, or upload audio when captions are unavailable."],
  ["Use a Virtual Recording", "Connect the meeting-bot workflow where it is configured for the event."],
  ["Track Processing", "Follow each recap from queued and transcribing through processed or failed."],
];

const featureCards = [
  {
    eyebrow: "One event-native workflow",
    title: "The Recap Stays Connected to the Session Attendees Already Know",
    text: "Keep each recording, transcript, speaker, and generated output attached to its agenda session. Attendees move from the event program into live or processed recap content on web and mobile.",
    image: "/feature-images/speaker-management/instarecap-v2.svg",
    alt: "EventHex InstaRecap session recap shown on attendee mobile screens",
    width: 603,
    height: 746,
  },
  {
    eyebrow: "Personalized attendee takeaways",
    title: "One Session Record, Made More Relevant for Each Attendee",
    text: "Use available attendee profile context to shape supported takeaways and social drafts while keeping the shared summary and referenced resources grounded in the captured session.",
    image: "/feature-images/ai/instasnap-ai.webp",
    alt: "EventHex AI recap experience with attendee-focused session content",
    width: 640,
    height: 522,
  },
  {
    eyebrow: "Event-day operations",
    title: "Give the AV Team a Focused Path to Session Capture",
    text: "Create an AV Team URL, QR code, and access code, scope access to permitted sessions or stages, and let the crew run supported recording and transcription without opening the organizer workspace.",
    image: "/feature-images/session-management/engagement-visual.svg",
    alt: "EventHex session controls for event-day teams",
    width: 674,
    height: 705,
  },
];

const useCases = [
  ["Exhibitions and Trade Shows", "Turn stage talks, product sessions, and expert panels into recaps delegates can revisit."],
  ["Conferences and Tech Events", "Connect agenda sessions, speakers, live transcription, takeaways, resources, and attendee access."],
  ["Association Events", "Create a session knowledge library for members while keeping access aligned with the event."],
  ["Corporate Events and Agencies", "Use one operating model across client programs while configuring each event separately."],
];

const faqs = [
  ["What is an AI session recap?", "An AI session recap turns captured session material into structured content such as a transcript, short and detailed summaries, key takeaways, referenced resources, and supported social drafts. EventHex keeps these outputs connected to the event’s agenda session."],
  ["Can InstaRecap work during a live event session?", "Yes. EventHex supports live recording and transcription flows. Attendees can view live transcription and, as generated content becomes available, live overview, takeaways, resources, and configured translations."],
  ["Can we upload a recording after the session?", "Yes. Organizers can upload session audio, monitor processing, and map or remap the recording to the correct session."],
  ["Can EventHex use a YouTube video as the source?", "EventHex can import exposed captions from a valid YouTube URL. If captions are unavailable, the organizer can upload the audio instead."],
  ["Can organizers edit an AI-generated recap?", "Organizers can edit the transcript and regenerate individual outputs, including summaries, takeaways, resources, social drafts, and available translations."],
  ["What can attendees see in a session recap?", "Depending on the event settings and processing state, attendees can use Overview, Summary, Takeaways, Resources, and Social views. Organizers choose which recap tabs are visible."],
  ["Does InstaRecap support translated session content?", "Organizers can enable translation and choose up to four target languages for the event. Attendees can switch to available translated live transcription and processed recap content."],
  ["Where can attendees open the recap?", "EventHex provides a web/PWA recap experience and supports InstaRecap views in the attendee mobile app. The exact available actions depend on the event configuration and app surface."],
  ["Can attendees share takeaways and social content?", "When the organizer enables the relevant controls, attendees can copy or share supported takeaways and social drafts, personalize available social content, and generate takeaway posters."],
  ["Can the AV team run transcription without organizer access?", "Organizers can create a dedicated AV Team access URL, QR code, and code, then scope that access to permitted sessions or stages."],
  ["What does the organizer dashboard report?", "The InstaRecap dashboard includes transcribed-session and hour totals, recap users over time, recent processed sessions and users, regenerated takeaways, and generated LinkedIn and X post counts."],
  ["How is InstaRecap different from an AI meeting notetaker?", "InstaRecap is built around an event’s sessions, speakers, attendees, access settings, and event-day workflow. It combines live transcription with a multi-session attendee recap experience, personalized takeaways, share-ready outputs, and organizer reporting instead of leaving each session as an isolated set of meeting notes."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<div class="asrv-page">
  <section class="asrv-hero">
    <div class="asrv-hero__grid">
      <div class="asrv-hero__content">
        <span class="asrv-hero__badge animate-on-scroll" data-animation="fadeInDown">AI Session Recap</span>
        <h1 class="asrv-hero__title animate-on-scroll" data-animation="fadeInUp">Turn Live Event Sessions Into AI Recaps Attendees Can Use</h1>
        <p class="asrv-hero__desc animate-on-scroll" data-animation="fadeInUp">Capture a live session or add a recording. InstaRecap creates live transcription, reviewable summaries, personalized takeaways, referenced resources, and share-ready content—connected to the agenda and available to attendees on web and mobile.</p>
        <div class="asrv-hero__cta-row animate-on-scroll" data-animation="fadeInUp">
          <a href="/book-a-demo/" class="asrv-hero__btn">See It With Your Event <span aria-hidden="true">→</span></a>
          <a href="#asrv-live-processed" class="asrv-hero__btn asrv-hero__btn--outline">See How It Works</a>
        </div>
        <div class="asrv-hero__trust animate-on-scroll" data-animation="fadeIn">
          <span class="asrv-hero__trust-item">Live and recorded sessions</span>
          <span class="asrv-hero__trust-item">Web and mobile recap</span>
        </div>
      </div>
      <div class="asrv-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="asrv-hero__visual-card"><div class="asrv-hero__visual-inner"><img src="/feature-images/speaker-management/instarecap-v2.svg" alt="EventHex InstaRecap transforming a session into attendee recap content" width="603" height="746" loading="eager" /></div></div>
      </div>
    </div>
  </section>

  <section class="asrv-trust-strip" aria-label="InstaRecap workflow">
    <div class="asrv-trust-strip__inner">
      <span class="asrv-trust-strip__stat"><b>Capture</b> Live or Recorded</span>
      <span class="asrv-trust-strip__stat"><b>Transcribe</b> Session Audio</span>
      <span class="asrv-trust-strip__stat"><b>Review</b> Every Output</span>
      <span class="asrv-trust-strip__stat"><b>Share</b> Web and Mobile</span>
    </div>
  </section>

  <section id="asrv-live-processed" class="asrv-flow-section">
    <div class="asrv-flow-header"><h2 class="asrv-flow-title animate-on-scroll" data-animation="fadeInUp">Live Now, Structured After Processing</h2><p class="asrv-flow-subtitle animate-on-scroll" data-animation="fadeInUp">Two attendee moments, connected to the same agenda session.</p></div>
    <div class="asrv-flow-quad">
      <article class="asrv-flow-quad__cell animate-on-scroll" data-animation="fadeInUp"><span class="asrv-flow-kicker">During the session</span><h3 class="asrv-flow-quad__title">Follow the Session in Real Time</h3><p class="asrv-flow-quad__text">Show live transcription and, as content becomes available, live overview, takeaways, resources, and configured translations.</p></article>
      <div class="asrv-flow-quad__cell asrv-flow-quad__cell--media animate-on-scroll" data-animation="fadeInRight"><div class="asrv-flow-composite asrv-flow-composite--live"><img class="asrv-flow-product-shot" src="/feature-images/ai-event-copilot/portal/sessions.png" alt="EventHex organizer session screen with Add Audio and Record Live controls" width="1117" height="837" loading="lazy" decoding="async" /></div></div>
      <div class="asrv-flow-quad__cell asrv-flow-quad__cell--media animate-on-scroll" data-animation="fadeInLeft"><div class="asrv-flow-composite asrv-flow-composite--processed"><img class="asrv-flow-product-shot" src="/feature-images/ai-session-recap/attendee-recap-summary.webp" alt="EventHex processed attendee session recap summary" width="2880" height="1560" loading="lazy" decoding="async" /></div></div>
      <article class="asrv-flow-quad__cell animate-on-scroll" data-animation="fadeInUp"><span class="asrv-flow-kicker">After the session</span><h3 class="asrv-flow-quad__title">Return to a Structured Recap</h3><p class="asrv-flow-quad__text">Open the processed transcript, quick brief, detailed summary, takeaways, resources, social drafts, and recap PDF.</p></article>
      <span class="asrv-flow-quad__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" />
        </svg>
      </span>
    </div>
    <p class="asrv-flow-note">Generated content depends on captured session material and processing status. Organizers can review and regenerate individual outputs.</p>
  </section>

  <div class="asrv-dark-band">
    <div class="asrv-dark-heading"><h2>Start With the Source <span>Your Event Already Has</span></h2></div>
    <section class="asrv-grid-section" id="asrv-capture-options"><div class="asrv-cap">
      {captureOptions.map(([title, text], index) => (
        <article class="asrv-cap__cell animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          {(index === 1 || index === 2 || index === 4) && (
            <>
              <span class="asrv-cap__petal asrv-cap__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" /></svg></span>
              <span class="asrv-cap__petal asrv-cap__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)" /></svg></span>
            </>
          )}
          <h3 class="asrv-cap__label">{title}</h3><p class="asrv-cap__desc">{text}</p>
          <div class="asrv-cap__visual" aria-hidden="true">
            {index === 0 && <div class="asrv-cap__record"><i></i><span>Session ready</span><b>Start recording</b></div>}
            {index === 1 && <div class="asrv-cap__file"><span>WAV</span><div><b>main-stage-session.wav</b><i><em></em></i></div></div>}
            {index === 2 && <div class="asrv-cap__url"><small>YouTube URL</small><span>youtube.com/watch?v=...</span><b>Import captions</b></div>}
            {index === 3 && <div class="asrv-cap__stack"><span>Meeting bot <b>Connected</b></span><span>Agenda session <b>Mapped</b></span><span>Transcript <b>Ready</b></span></div>}
            {index === 4 && <div class="asrv-cap__states"><span>Queued</span><span>Transcribing</span><span class="is-active">Processed</span></div>}
          </div>
        </article>
      ))}
    </div></section>
    <div class="asrv-dark-cta animate-on-scroll" data-animation="fadeInUp"><h2>One Capture Workflow, Connected to the Session From the Start</h2><a href="/book-a-demo/">See InstaRecap in EventHex</a></div>
  </div>

  <section class="asrv-bento-section" id="asrv-recap-workspace">
    <div class="asrv-bento-container">
      <div class="asrv-bento-header animate-on-scroll" data-animation="fadeInUp"><span>Organizer and attendee experience</span><h2>Review the Recap, Then Make It Useful Beyond the Session</h2></div>
      <div class="asrv-bento-grid animate-on-scroll" data-animation="fadeInUp">
        <span class="asrv-bento-notch asrv-bento-notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" /></svg></span>
        <span class="asrv-bento-notch asrv-bento-notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)" /></svg></span>
        <div class="asrv-bento-row">
          <div class="asrv-bento-cell asrv-bento-visual"><div class="asrv-bento-shot-stage asrv-bento-shot-stage--review"><img class="asrv-bento-product-shot" src="/feature-images/ai-session-recap/futuretech-recap-summary.png" alt="EventHex FutureTech Event detailed session summary" width="1536" height="1024" loading="lazy" decoding="async" /></div></div>
          <div class="asrv-bento-cell asrv-bento-content"><span class="asrv-bento-eyebrow">Organizer workbench</span><h3>Review Every Output Without Rebuilding the Session</h3><p>Edit the transcript, open the quick brief or detailed summary, and regenerate summaries, takeaways, resources, translations, or social drafts individually.</p><p>Map, remap, or remove a recording while keeping processing status visible.</p></div>
          <span class="asrv-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)" /></svg></span>
        </div>
        <div class="asrv-bento-row asrv-bento-row--reverse">
          <div class="asrv-bento-cell asrv-bento-content"><span class="asrv-bento-eyebrow">Attendee recap library</span><h3>Help Attendees Find the Session They Want to Revisit</h3><p>Start with the event program, then search and filter sessions before opening Overview, Summary, Takeaways, Resources, or Social.</p><p>Live and processed sessions remain part of the same web and mobile recap journey.</p></div>
          <div class="asrv-bento-cell asrv-bento-visual"><div class="asrv-bento-shot-stage asrv-bento-shot-stage--library"><img class="asrv-bento-product-shot" src="/feature-images/ai-session-recap/futuretech-recap-library.png" alt="EventHex FutureTech Event session recap library" width="1625" height="968" loading="lazy" decoding="async" /></div></div>
          <span class="asrv-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)" /></svg></span>
        </div>
        <div class="asrv-bento-row">
          <div class="asrv-bento-cell asrv-bento-visual"><div class="asrv-bento-shot-stage asrv-bento-shot-stage--takeaways"><img class="asrv-bento-product-shot" src="/feature-images/ai-session-recap/futuretech-recap-takeaways.png" alt="EventHex FutureTech Event English key takeaways" width="1536" height="1024" loading="lazy" decoding="async" /></div></div>
          <div class="asrv-bento-cell asrv-bento-content"><span class="asrv-bento-eyebrow">Grounded and personalized</span><h3>Turn What Was Said Into Takeaways Attendees Can Use</h3><p>Create shared summaries, takeaways, and referenced resources from captured session material, then use available attendee profile context for supported personalization.</p><p>Organizers choose which recap tabs and attendee actions are available.</p></div>
          <span class="asrv-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)" /></svg></span>
        </div>
        <div class="asrv-bento-row asrv-bento-row--reverse">
          <div class="asrv-bento-cell asrv-bento-content"><span class="asrv-bento-eyebrow">Translation and sharing</span><h3>Carry the Session Into the Attendee’s Language and Channels</h3><p>Choose up to four target languages for available live transcription and processed content.</p><p>Prepare LinkedIn and X drafts, supported takeaway posters, and a session recap PDF; sharing and personalization follow organizer controls.</p></div>
          <div class="asrv-bento-cell asrv-bento-visual"><div class="asrv-bento-shot-stage asrv-bento-shot-stage--share"><img class="asrv-bento-product-shot" src="/feature-images/ai-session-recap/futuretech-recap-social.png" alt="EventHex FutureTech Event English social post drafts" width="1536" height="1024" loading="lazy" decoding="async" /></div></div>
          <span class="asrv-bento-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)" /></svg></span>
        </div>
      </div>
    </div>
  </section>

  <section class="asrv-feature-shell" id="asrv-event-workflow">
    <div class="asrv-feature-section">
      <div class="asrv-feature-header"><div class="asrv-feature-eyebrow"><span class="asrv-feature-eyebrow__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"/><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"/></svg></span><span>From agenda to attendee recap</span></div><h2>Session Workflows That Keep the Event and Audience Connected</h2></div>
      <div class="asrv-feature-cards">
        {featureCards.map((card, index) => (
          <article class="asrv-feature-card" style={`--card-index:${index}`}>
            <div class="asrv-feature-card__content"><span>{card.eyebrow}</span><h3>{card.title}</h3><p>{card.text}</p><a href="/book-a-demo/">Explore more</a></div>
            <div class="asrv-feature-card__image"><img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" /></div>
          </article>
        ))}
        <div class="asrv-feature-spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="asrv-use-cases" id="asrv-event-types">
    <div class="asrv-use-heading"><span>Built for Content-Rich Event Programs</span><h2>Give Every Session Format a<br />Useful Second Life</h2></div>
    <div class="asrv-use-grid">
      {[1, 2, 3].map((position) => (<span class={`asrv-use-notch asrv-use-notch--${position}`} aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" /></svg></span>))}
      {useCases.map(([title, text], index) => (
        <article class="asrv-use-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          {index === 2 && <span class="asrv-use-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" /><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" /></svg></span>}
          <div class="asrv-use-card__icon" aria-hidden="true">
            {index === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-9h16v9M7 12V5h10v7M9 8h2m2 0h2M8 16h2m4 0h2" /></svg>}
            {index === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>}
            {index === 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2" /></svg>}
            {index === 3 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20M6 15h4" /></svg>}
          </div>
          <h3>{title}</h3><p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="asrv-faq" id="faq">
    <div class="asrv-faq__inner">
      <div class="asrv-faq__sidebar animate-on-scroll" data-animation="fadeInLeft"><span class="asrv-faq__eyebrow">Quick answers</span><h2 class="asrv-faq__heading">AI Session Recap Questions, Answered.</h2><p class="asrv-faq__intro">Capture, review, attendee access, translation, sharing, AV workflow, and reporting.</p><a href="/contact-en/" class="asrv-faq__cta">Talk to our team <span aria-hidden="true">→</span></a></div>
      <div class="asrv-faq__list">{faqs.map(([question, answer], index) => (<details class="asrv-faq__item animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 30)} data-asrv-faq open={index === 0}><summary class="asrv-faq__question"><strong>{question}</strong><span class="asrv-faq__icon" aria-hidden="true"></span></summary><div class="asrv-faq__answer"><p>{answer}</p></div></details>))}</div>
    </div>
  </section>
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script>
  const recapFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-asrv-faq]"));
  recapFaqItems.forEach((item) => item.addEventListener("toggle", () => {
    if (!item.open) return;
    recapFaqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));

  const recapBand = document.querySelector<HTMLElement>(".asrv-dark-band");
