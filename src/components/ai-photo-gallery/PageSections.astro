---
const intakeCapabilities = [
  { title: "Upload from the Workspace", description: "Add photo batches in the organizer workspace and send them into the selected event and folder." },
  { title: "Import from Google Drive", description: "Preview a public Drive folder, include its subfolders, identify duplicates, and start a server-side import." },
  { title: "Organize with Folders", description: "Create, rename, order, and move photos between event folders." },
  { title: "Review Upload History", description: "Follow batch progress, skipped duplicates, and failed files from the organizer workspace." },
  { title: "Follow Face Indexing", description: "Keep the processing context and face-indexing status tied to each event photo batch." },
];

const storyCards = [
  {
    id: "apg-matching",
    eyebrow: "How selfie photo matching works",
    title: "Turn One Selfie Into a Personal Event Photo Collection",
    description: "Attendees provide a clear selfie. EventHex compares it with face groups indexed from that event and opens matching photos in My Photos. They can return later or enable alerts as new batches arrive.",
    image: "/feature-images/ai-photo-gallery/selfie-match-visual.svg",
    alt: "Selfie search opening an attendee's personal event photo collection",
    width: 775,
    height: 812,
  },
  {
    id: "apg-access",
    eyebrow: "Access that fits the event",
    title: "Choose Who Can Enter the Gallery and What They Need to Provide",
    description: "Choose a public or attendee-only gallery, optional WhatsApp verification, selected profile fields, and anonymous selfie search when event settings allow it. Access and matching rules stay at event level.",
    image: "/feature-images/ai-photo-gallery/privacy-controls-visual.svg",
    alt: "Event gallery access and photo permission settings",
    width: 1142,
    height: 930,
  },
  {
    id: "apg-personal-gallery",
    eyebrow: "A gallery built around the attendee",
    title: "Give Each Person More Than a Folder of Files",
    description: "My Photos holds each attendee's matches. Photos Together shows people captured together, while detected-people views and personal links open a selected person's photos.",
    image: "/feature-images/ai-photo-gallery/hero-visual.svg",
    alt: "Personal gallery with My Photos, Photos Together, and people views",
    width: 1137,
    height: 927,
  },
  {
    id: "apg-alerts",
    eyebrow: "Photo alerts when the gallery changes",
    title: "Let Attendees Know When Another Photo of Them Appears",
    description: "When notifications are enabled, attendees can opt in to WhatsApp alerts. A new match brings them back to their updated personal gallery.",
    image: "/feature-images/ai-photo-gallery/cta-visual.svg",
    alt: "Photo alert returning an attendee to an updated personal gallery",
    width: 819,
    height: 822,
  },
];

const eventTypes = [
  {
    id: "exhibitions",
    label: "Exhibitions and Trade Shows",
    description: "Organize venue and stage folders, help delegates find themselves, and include sponsor placements in the gallery.",
    highlights: ["Venue and stage folders", "Delegate selfie matching", "Sponsor placements in the gallery"],
    image: "/feature-images/ai-platform/lifecycle-during-photos.jpg",
    imageAlt: "EventHex Manage Photos workspace with event folders and gallery upload controls",
    width: 1117,
    height: 837,
    visualLabel: "Gallery folders organized",
  },
  {
    id: "conferences",
    label: "Conferences and Tech Events",
    description: "Connect speaker identities, highlights, attendee matches, and share-ready moments.",
    highlights: ["Speaker identities", "Attendee photo matches", "Share-ready highlights"],
    image: "/feature-images/ai/instasnap-ai.webp",
    imageAlt: "EventHex InstaSnap attendee selfie matching and personal gallery experience",
    width: 640,
    height: 522,
    visualLabel: "Attendee matches ready",
  },
  {
    id: "associations",
    label: "Association Events",
    description: "Give members a familiar personal gallery while retaining attendee-only access when needed.",
    highlights: ["Personal member galleries", "Attendee-only access", "Event-level gallery controls"],
    image: "/feature-images/ai-photo-gallery/privacy-controls-visual.svg",
    imageAlt: "EventHex event gallery access and privacy controls",
    width: 1142,
    height: 930,
    visualLabel: "Member access configured",
  },
  {
    id: "corporate",
    label: "Corporate Events and Agencies",
    description: "Reuse the workflow across client events while configuring each gallery at event level.",
    highlights: ["Reusable client workflows", "Event-level configuration", "Gallery branding controls"],
    image: "/feature-images/ai-photo-gallery/sponsor-frames-visual.svg",
    imageAlt: "EventHex event gallery sponsor and branding controls",
    width: 1035,
    height: 1022,
    visualLabel: "Client gallery branded",
  },
];

const connectedFeatures = [
  ["AI Platform", "See how InstaSnap fits into the wider EventHex AI toolkit.", "/ai-platform/"],
  ["Event Mobile App", "Explore the supported attendee app experience around event moments.", "/event-mobile-app/"],
  ["Event Registration", "Collect the attendee information used across the event journey.", "/event-registration/"],
  ["Event Notifications", "Review the wider communication layer for event audiences.", "/event-notifications/"],
];
---

<section class="apg-choice" id="apg-discovery">
  <div class="apg-shell">
    <header class="apg-section-heading animate-on-scroll" data-animation="fadeInUp">
      <span class="apg-kicker">A faster way to find the right moments</span>
      <h2>Keep the Event Gallery. Add a Personal Way Into It.</h2>
      <p>Different attendees want different views. EventHex can keep the wider event story available while helping each person find the photos that include them.</p>
    </header>

    <div class="apg-choice__grid">
      <article class="apg-choice__copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Browse Moments</h3>
        <p>Explore the event's available photos, highlights, folders, and people when the organizer makes those views available.</p>
      </article>
      <div class="apg-choice__media apg-choice__media--moments animate-on-scroll" data-animation="fadeInRight">
        <div class="apg-portal-composite apg-portal-composite--moments">
          <img class="apg-portal-composite__screen apg-portal-composite__screen--primary" src="/feature-images/ai-platform/lifecycle-during-photos.jpg" alt="EventHex Manage Photos workspace with gallery folders and upload controls" width="1117" height="837" loading="lazy" decoding="async" />
          <img class="apg-portal-composite__screen apg-portal-composite__screen--secondary" src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex AI Gallery analytics dashboard" width="1117" height="837" loading="lazy" decoding="async" />
          <span class="apg-portal-composite__status">Organizer gallery</span>
        </div>
      </div>
      <div class="apg-choice__media apg-choice__media--selfie animate-on-scroll" data-animation="fadeInLeft">
        <div class="apg-portal-composite apg-portal-composite--selfie">
          <img class="apg-portal-composite__attendee" src="/feature-images/ai/instasnap-ai.webp" alt="EventHex InstaSnap selfie matching flow and attendee photo gallery" width="640" height="522" loading="lazy" decoding="async" />
          <img class="apg-portal-composite__screen apg-portal-composite__screen--detail" src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex face recognition and matched-photo analytics" width="1117" height="837" loading="lazy" decoding="async" />
          <span class="apg-portal-composite__status">AI photo matching</span>
        </div>
      </div>
      <article class="apg-choice__copy animate-on-scroll" data-animation="fadeInUp">
        <h3>Search with a Selfie</h3>
        <p>Take or upload one clear selfie and open a personal collection of the matching event photos.</p>
      </article>
      <span class="apg-choice__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)"></path>
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path>
        </svg>
      </span>
    </div>
    <p class="apg-choice__note">The organizer decides whether the wider gallery is public, attendee-only, all photos, or highlights only.</p>
  </div>
</section>

<section class="apg-intake" id="apg-photo-intake">
  <div class="apg-shell">
    <header class="apg-intake__heading animate-on-scroll" data-animation="fadeInUp">
      <span class="apg-kicker apg-kicker--dark">Photo intake for event teams</span>
      <h2>Bring Photographer Batches Into a Gallery Your Team Can Operate</h2>
      <p>Keep uploads moving during or after the event without losing the folder, batch, or processing context behind them.</p>
    </header>
    <div class="apg-intake__grid">
      {intakeCapabilities.map((capability, index) => (
        <article class="apg-intake__card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
          {index !== 0 && index !== 3 && (
            <span class="apg-intake__petal apg-intake__petal--top" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
            </span>
          )}
          {index !== 0 && index !== 3 && (
            <span class="apg-intake__petal apg-intake__petal--bottom" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg>
            </span>
          )}
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <div class="apg-intake__visual" aria-hidden="true">
            {index === 0 && (
              <div class="apg-intake__surface apg-intake__upload">
                <span class="apg-intake__surface-head">Workspace upload</span>
                <div class="apg-intake__field"><span>Event folder</span><i></i></div>
                <div class="apg-intake__field"><span>Photo batch</span><i></i></div>
                <div class="apg-intake__field apg-intake__field--active"><span>+ Add photos</span></div>
              </div>
            )}
            {index === 1 && (
              <div class="apg-intake__chips">
                <span>Public folder</span><span>Subfolders</span><span>Duplicates</span><span class="is-active">Preview import</span>
              </div>
            )}
            {index === 2 && (
              <div class="apg-intake__stack">
                <div class="apg-intake__stack-row"><span>Stage</span><small>Folder</small></div>
                <div class="apg-intake__stack-row is-active"><span>Networking</span><small>Folder</small></div>
                <div class="apg-intake__stack-row"><span>Uncategorized</span><small>Default</small></div>
              </div>
            )}
            {index === 3 && (
              <div class="apg-intake__surface apg-intake__history">
                <span class="apg-intake__surface-head">Upload history</span>
                <div class="apg-intake__progress"><span>Browser batch</span><div><i></i></div></div>
                <div class="apg-intake__progress"><span>Drive import</span><div><i></i></div></div>
              </div>
            )}
            {index === 4 && (
              <div class="apg-intake__stack">
                <div class="apg-intake__stack-row"><span>Processing</span><small>Queued</small></div>
                <div class="apg-intake__stack-row is-active"><span>Face indexing</span><small>In progress</small></div>
                <div class="apg-intake__stack-row"><span>Gallery</span><small>Ready</small></div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="apg-story" id="apg-photo-journey" aria-labelledby="apg-story-title">
  <div class="apg-story__inner">
    <header class="apg-story__header animate-on-scroll" data-animation="fadeInUp">
      <span class="apg-story__eyebrow">From selfie search to an updated personal gallery</span>
      <h2 id="apg-story-title">A Photo Journey That Stays Tied to the Event</h2>
    </header>
    <div class="apg-story__grid animate-on-scroll" data-animation="fadeInUp">
      <span class="apg-story__notch apg-story__notch--top" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg>
      </span>
      <span class="apg-story__notch apg-story__notch--bottom" aria-hidden="true">
        <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg>
      </span>
      {storyCards.map((card, index) => (
        <article id={card.id} class:list={["apg-story__row", index % 2 === 1 && "apg-story__row--reverse"]}>
          <div class="apg-story__visual">
            <div class="apg-story__stage">
              <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="apg-story__content">
            <span>{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
          {index < storyCards.length - 1 && (
            <span class="apg-story__cross" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
              </svg>
            </span>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<section class="apg-evidence" aria-label="Gallery curation, contribution, sharing, and branding">
  <div class="apg-evidence__section">
    <header class="apg-evidence__header">
      <div class="apg-evidence__eyebrow">
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" fill="#4F8CFF"></path><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"></path></svg>
        </span>
        From library controls to attendee-ready moments
      </div>
      <h2>
        <span>Shape What People <strong>See</strong>, Add,</span>
        <span>Download, and Share</span>
      </h2>
    </header>

    <div class="apg-evidence__cards" id="apg-evidence-stacking-cards">
      <article class="apg-evidence__card" id="apg-curation" style="--card-index: 0;">
        <div class="apg-evidence__copy">
          <span>Curate the event story</span>
          <h3>Decide What Belongs in Moments Before the Audience Starts Browsing</h3>
          <p>Show all available photos or only organizer-marked highlights. Expose folder navigation when useful, name people and speakers, and let search and pagination keep larger collections practical to browse.</p>
          <a href="/book-a-demo/">Explore More</a>
        </div>
        <div class="apg-evidence__media">
          <figure class="apg-evidence-shot apg-evidence-shot--primary">
            <img src="/feature-images/ai-platform/lifecycle-during-photos.jpg" alt="EventHex Manage Photos workspace for organizing event gallery uploads" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
          <figure class="apg-evidence-shot apg-evidence-shot--secondary">
            <img src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex AI Gallery organizer dashboard with gallery controls and analytics" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
        </div>
      </article>

      <article class="apg-evidence__card" id="apg-contributions" style="--card-index: 1;">
        <div class="apg-evidence__copy">
          <span>Attendee-contributed photos</span>
          <h3>Add the Audience's Perspective Without Giving Up Organizer Control</h3>
          <p>Keep contributions in review so an organizer can approve or decline them, or publish accepted uploads directly. Set a per-attendee contribution limit, including an unlimited option, from the event's photo settings.</p>
          <a href="/book-a-demo/">Explore More</a>
        </div>
        <div class="apg-evidence__media apg-evidence__media--contributions">
          <figure class="apg-evidence-shot apg-evidence-shot--primary">
            <img src="/feature-images/ai-platform/hero-ai-gallery.jpg" alt="EventHex AI Gallery portal with attendee contribution and gallery management navigation" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
          <figure class="apg-evidence-shot apg-evidence-shot--secondary">
            <img src="/feature-images/ai-platform/lifecycle-during-photos.jpg" alt="EventHex photo management workspace for reviewing event photo batches" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
        </div>
      </article>

      <article class="apg-evidence__card" id="apg-sharing" style="--card-index: 2;">
        <div class="apg-evidence__copy">
          <span>Share-ready event moments</span>
          <h3>Help Attendees Move from Finding a Photo to Sharing It</h3>
          <p>Select matched photos, generate or rewrite a caption using event context, edit the copy, and use available device sharing options. A direct link can also open a personal collection or a selected person's photos.</p>
          <a href="/book-a-demo/">Explore More</a>
        </div>
        <div class="apg-evidence__media apg-evidence__media--sharing">
          <figure class="apg-evidence-shot apg-evidence-shot--primary">
            <img src="/feature-images/ai/instasnap-ai.webp" alt="EventHex InstaSnap attendee selfie matching and personal photo gallery experience" width="640" height="522" loading="lazy" decoding="async" />
          </figure>
          <figure class="apg-evidence-shot apg-evidence-shot--secondary">
            <img src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex AI Gallery dashboard tracking matched photos and downloads" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
        </div>
      </article>

      <article class="apg-evidence__card" id="apg-branding" style="--card-index: 3;">
        <div class="apg-evidence__copy">
          <span>Brand and sponsor controls</span>
          <h3>Put the Event Identity Where Attendees Already Want to Look</h3>
          <p>Use an image or text watermark, then preview its position, scale, and opacity before attendees download. Configured partner spotlights can appear in Moments, My Photos, or both at a chosen frequency.</p>
          <a href="/book-a-demo/">Explore More</a>
        </div>
        <div class="apg-evidence__media apg-evidence__media--branding">
          <figure class="apg-evidence-shot apg-evidence-shot--primary">
            <img src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex AI Gallery portal with watermark, monetization, and gallery settings navigation" width="1117" height="837" loading="lazy" decoding="async" />
          </figure>
          <figure class="apg-evidence-shot apg-evidence-shot--secondary">
            <img src="/feature-images/ai/instasnap-ai.webp" alt="Branded EventHex InstaSnap gallery experience for attendees" width="640" height="522" loading="lazy" decoding="async" />
          </figure>
        </div>
      </article>
      <div class="apg-evidence__spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="apg-events" id="apg-event-types" aria-labelledby="apg-events-title">
  <div class="apg-events__inner">
    <header class="apg-events__header">
      <span class="apg-events__badge animate-on-scroll" data-animation="fadeInUp">Built for photo-heavy event journeys</span>
      <h2 id="apg-events-title" class="apg-events__title animate-on-scroll" data-animation="fadeInUp">
        <span class="apg-events__title-line">Give Every Event Community</span>
        <span class="apg-events__title-line">a Gallery Path That Fits</span>
      </h2>
      <p class="apg-events__subtitle animate-on-scroll" data-animation="fadeInUp">Use the same photo operations and configure access, curation, contribution, and branding for the audience in front of you.</p>
    </header>

    <div class="apg-events__tabs animate-on-scroll" data-animation="fadeInUp" role="tablist" aria-label="Event gallery use cases">
      {eventTypes.map((eventType, index) => (
        <button
          class={`apg-events__tab ${index === 0 ? "apg-events__tab--active" : ""}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`apg-events-panel-${eventType.id}`}
          id={`apg-events-tab-${eventType.id}`}
          data-apg-event-target={eventType.id}
        >
          {eventType.label}
        </button>
      ))}
    </div>

    <div class="apg-events__box animate-on-scroll" data-animation="fadeInUp">
      {eventTypes.map((eventType, index) => (
        <div
          class={`apg-events__panel ${index === 0 ? "apg-events__panel--active" : ""}`}
          id={`apg-events-panel-${eventType.id}`}
          role="tabpanel"
          aria-labelledby={`apg-events-tab-${eventType.id}`}
          data-apg-event-panel={eventType.id}
        >
          <div class="apg-events__left">
            <h3 class="apg-events__panel-title">{eventType.label}</h3>
            <p class="apg-events__panel-description">{eventType.description}</p>
            <span class="apg-events__fit-label">GALLERY FIT</span>
            <ul class="apg-events__checklist">
              {eventType.highlights.map((highlight) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {highlight}
                </li>
              ))}
            </ul>
          </div>

          <div class="apg-events__right">
            <div class="apg-events__showcase">
              <img src={eventType.image} alt={eventType.imageAlt} width={eventType.width} height={eventType.height} loading="lazy" decoding="async" />
              <span class={`apg-events__visual-label apg-events__visual-label--${eventType.id}`}>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4.5h14v11H3z"></path><path d="m5.5 13 3-3 2.2 2.2 1.8-1.8 2 2M13.8 7.5h.1"></path></svg>
                {eventType.visualLabel}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="apg-links" id="apg-connected-workflows">
  <div class="apg-shell">
    <header class="apg-section-heading animate-on-scroll" data-animation="fadeInUp">
      <span class="apg-kicker">Explore the connected workflow</span>
      <h2>Connect the Gallery to the Rest of the Attendee Journey</h2>
      <p>Go deeper when you need the AI platform, event app, registration, or notifications around InstaSnap.</p>
    </header>
    <div class="apg-links__grid">
      {[1, 2, 3].map((notch) => (
        <span class={`apg-links__notch apg-links__notch--${notch}`} aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e8ecf2)"></path></svg>
        </span>
      ))}
      {connectedFeatures.map(([title, description, href], index) => (
        <a class="apg-links__card animate-on-scroll" data-animation="fadeInUp" href={href}>
          {index === 2 && (
