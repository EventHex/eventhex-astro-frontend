<script>
  const intakeBand = document.querySelector<HTMLElement>('.apg-intake');
  if (intakeBand && intakeBand.dataset.bleedReady !== 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    intakeBand.dataset.bleedReady = 'true';
    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let frame = 0;
    let last = -1;

    const measureBand = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = intakeBand.getBoundingClientRect().top + window.scrollY;
    };
    const updateBand = () => {
      frame = 0;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * 0.7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === last) return;
      last = rounded;
      intakeBand.style.setProperty('--band-p', String(rounded));
    };
    const queueBand = () => {
      if (frame) return;
      frame = requestAnimationFrame(updateBand);
    };
    const resizeBand = () => {
      measureBand();
      last = -1;
      queueBand();
    };

    measureBand();
    updateBand();
    window.addEventListener('scroll', queueBand, { passive: true });
    window.addEventListener('resize', resizeBand, { passive: true });
  }

  const evidenceSection = document.querySelector<HTMLElement>('.apg-evidence');
  const evidenceHeader = evidenceSection?.querySelector<HTMLElement>('.apg-evidence__header');
  const evidenceCards = evidenceSection?.querySelectorAll<HTMLElement>('.apg-evidence__card');
  const finalEvidenceCard = evidenceCards?.[evidenceCards.length - 1];

  if (evidenceHeader && finalEvidenceCard) {
    let evidenceFrame = 0;
    const syncEvidenceRelease = () => {
      evidenceFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalEvidenceCard).top) || 0;
      const releaseOffset = Math.min(0, finalEvidenceCard.getBoundingClientRect().top - stickyTop);
      evidenceHeader.style.setProperty('--apg-evidence-release-y', `${releaseOffset}px`);
      evidenceHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueEvidenceRelease = () => {
      if (evidenceFrame) return;
      evidenceFrame = requestAnimationFrame(syncEvidenceRelease);
    };

    window.addEventListener('scroll', queueEvidenceRelease, { passive: true });
    window.addEventListener('resize', queueEvidenceRelease, { passive: true });
    syncEvidenceRelease();
  }

  const eventSuite = document.querySelector<HTMLElement>('.apg-events');
  if (eventSuite && eventSuite.dataset.tabsReady !== 'true') {
    eventSuite.dataset.tabsReady = 'true';
    const eventTabs = Array.from(eventSuite.querySelectorAll<HTMLButtonElement>('.apg-events__tab'));
    const eventPanels = Array.from(eventSuite.querySelectorAll<HTMLElement>('.apg-events__panel'));
    let eventRotationId: number | undefined;

    const activateEventTab = (tab: HTMLButtonElement) => {
      const targetId = tab.dataset.apgEventTarget;
      eventTabs.forEach((item) => {
        item.classList.remove('apg-events__tab--active');
        item.setAttribute('aria-selected', 'false');
      });
      eventPanels.forEach((panel) => panel.classList.remove('apg-events__panel--active'));

      tab.classList.add('apg-events__tab--active');
      tab.setAttribute('aria-selected', 'true');
      eventSuite.querySelector<HTMLElement>(`[data-apg-event-panel="${targetId}"]`)?.classList.add('apg-events__panel--active');
    };

    const stopEventRotation = () => {
      if (eventRotationId === undefined) return;
      window.clearInterval(eventRotationId);
      eventRotationId = undefined;
    };
    const startEventRotation = () => {
      stopEventRotation();
      if (eventTabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      eventRotationId = window.setInterval(() => {
        const currentIndex = eventTabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
        activateEventTab(eventTabs[(currentIndex + 1) % eventTabs.length]);
      }, 4000);
    };

    eventTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activateEventTab(tab);
        startEventRotation();
      });
    });
    eventSuite.addEventListener('mouseenter', stopEventRotation);
    eventSuite.addEventListener('mouseleave', startEventRotation);
    eventSuite.addEventListener('focusin', stopEventRotation);
    eventSuite.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !eventSuite.contains(event.relatedTarget)) startEventRotation();
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stopEventRotation() : startEventRotation());
    startEventRotation();
  }
</script>

