---
const stages = [
  { value: "Upload & organize", label: "Browser, Drive, and folders" },
  { value: "Match", label: "Selfie and event faces" },
  { value: "Notify", label: "Photo alerts" },
  { value: "Discover & share", label: "Personal galleries and captions" },
];
---

<section class="apg-stats" aria-label="AI photo gallery workflow">
  <div class="apg-stats__trust">
    <div class="apg-stats__inner">
      <span class="apg-stats__label">One connected photo journey</span>
      {stages.map((stage) => (
        <span class="apg-stats__stat"><b>{stage.value}</b> {stage.label}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .apg-stats { width: 100%; background: transparent; }
  .apg-stats__trust { padding: 1.5rem; border-top: 1px solid var(--surface-card-border); }
  .apg-stats__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .apg-stats__label, .apg-stats__stat {
    font-family: var(--font-body);
  }
  .apg-stats__label { color: var(--label-gray); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .apg-stats__stat { color: var(--subheading-gray); font-size: 0.9375rem; font-weight: 400; white-space: nowrap; }
  .apg-stats__stat b { color: var(--heading-dark); font-weight: 700; }
  @media (max-width: 767px) { .apg-stats__inner { justify-content: center; text-align: center; } }
</style>
