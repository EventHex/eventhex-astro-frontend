---
const heroPoints = [
  "Selfie-based photo discovery",
  "Organizer-controlled access",
  "Branded downloads and sharing",
];
---

<section class="apg-hero" id="apg-hero">
  <div class="apg-hero__shell">
    <div class="apg-hero__grid">
      <div class="apg-hero__content">
        <div class="apg-hero__badge animate-on-scroll" data-animation="fadeInDown">
          <span class="apg-hero__badge-dot"></span>
          <span>InstaSnap by EventHex · AI event photo gallery</span>
        </div>

        <h1 class="apg-hero__title animate-on-scroll" data-animation="fadeInUp">
          Take Every Attendee Straight to the Event Photos They Are Part&nbsp;Of
        </h1>

        <p class="apg-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
          Upload the event gallery, let each attendee search with a selfie, and give them a personal collection they can view, download, and share. EventHex keeps photo intake, face matching, access, alerts, and branding in one event workflow.
        </p>

        <div class="apg-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms">
          {heroPoints.map((point) => <span class="apg-hero__point">{point}</span>)}
        </div>

        <div class="apg-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
          <a href="/book-a-demo/" class="apg-hero__btn apg-hero__btn--primary">Book a Demo</a>
          <a href="#apg-photo-journey" class="apg-hero__btn apg-hero__btn--secondary">See how InstaSnap works</a>
        </div>
      </div>

      <div class="apg-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="apg-hero__visual-card">
          <div class="apg-hero__visual-inner">
            <img
              src="/feature-images/ai-photo-gallery/hero-visual.svg"
              alt="EventHex InstaSnap workspace showing event photo intake and a personal matched gallery"
              class="apg-hero__img"
              width="1137"
              height="927"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .apg-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(ellipse 700px 500px at -5% -10%, #375dfb24, #375dfb0f 40%, #375dfb00 75%),
      radial-gradient(ellipse 800px 600px at 100% 105%, #ff74b83d, #ff74b81a 45%, #ff74b800 78%),
      #fff;
  }
  .apg-hero::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 2;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, #fff0, #ffffff73 70%, #ffffffbf);
    pointer-events: none;
  }
  .apg-hero__shell { position: relative; z-index: 1; width: 100%; padding: 0; background: none; }
  .apg-hero__grid {
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    align-items: center;
    gap: 48px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
  }
  .apg-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; text-align: left; }
  .apg-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    color: var(--brand-blue);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: normal;
    text-transform: uppercase;
  }
  .apg-hero__badge-dot { display: none; }
  .apg-hero__title {
    width: 100%;
    margin: 0;
    background: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%);
    background-clip: text;
    color: transparent;
    font-family: var(--font-heading);
    font-size: 60px;
    font-weight: 500;
    line-height: 66px;
    letter-spacing: -2.1px;
    -webkit-background-clip: text;
  }
  .apg-hero__desc {
    width: 100%;
    max-width: 560px;
    margin: 0;
    color: var(--subheading-gray);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.25px;
  }
  .apg-hero__points { display: flex; flex-wrap: wrap; column-gap: 18px; row-gap: 6px; padding-top: 4px; }
  .apg-hero__point {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 0 0 16px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--heading-dark);
    box-shadow: none;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
  }
  .apg-hero__point::before {
    content: "";
    position: absolute;
    top: 7px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }
  .apg-hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; padding-top: 8px; }
  .apg-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 650;
    line-height: 22px;
    letter-spacing: -0.3px;
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s, background 0.3s, border-color 0.3s;
  }
  .apg-hero__btn--primary { background: var(--heading-dark); color: #fff; box-shadow: none; }
  .apg-hero__btn--primary:hover { transform: translateY(-2px); background: #000; box-shadow: none; }
  .apg-hero__btn--secondary { border-color: rgba(16, 24, 40, 0.22); background: transparent; color: var(--heading-dark); }
  .apg-hero__btn--secondary:hover { transform: translateY(-2px); border-color: var(--heading-dark); background: transparent; box-shadow: none; }
  .apg-hero__visual { position: relative; z-index: 3; margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px)); }
  .apg-hero__visual-card {
    position: relative;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-right: 0;
    border-radius: 22px 0 0 22px;
    background: linear-gradient(180deg, #ffffff9e, #ffffff47), #ffffff57;
    backdrop-filter: blur(16px);
  }
  .apg-hero__visual-inner {
    position: relative;
    overflow: hidden;
    padding: 32px;
    border-radius: 16px 0 0 16px;
    background: linear-gradient(135deg, #d9ecfa, #eef6fc 45%, #fff);
    backdrop-filter: blur(18px);
  }
  .apg-hero__img { display: block; width: 100%; height: auto; max-height: 520px; object-fit: contain; }
  @media (max-width: 1120px) {
    .apg-hero { padding: 140px 20px 56px; }
    .apg-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 32px; }
    .apg-hero__desc { max-width: 520px; }
    .apg-hero__title { font-size: 46px; line-height: 52px; letter-spacing: -1.5px; }
  }
  @media (max-width: 960px) {
    .apg-hero { padding: 130px 20px 48px; }
    .apg-hero::after { display: none; }
    .apg-hero__grid { grid-template-columns: 1fr; gap: 32px; text-align: center; }
    .apg-hero__content { align-items: center; text-align: center; }
    .apg-hero__desc { max-width: 520px; }
    .apg-hero__visual { width: min(760px, 100%); margin: 0 auto; }
    .apg-hero__visual-card { border-right: 1px solid rgba(255, 255, 255, 0.62); border-radius: 22px; }
    .apg-hero__visual-inner { border-radius: 16px; }
    .apg-hero__points, .apg-hero__cta { justify-content: center; }
  }
  @media (max-width: 767px) {
    .apg-hero { margin-top: -80px; padding: 112px 16px 40px; }
    .apg-hero__grid { padding: 0; text-align: left; }
    .apg-hero__content { align-items: flex-start; text-align: left; }
    .apg-hero__desc { max-width: 100%; }
    .apg-hero__visual-card { border-radius: 22px; }
    .apg-hero__visual-inner { border-radius: 16px; }
    .apg-hero__title { font-size: 34px; line-height: 40px; letter-spacing: -0.8px; }
    .apg-hero__points { justify-content: flex-start; }
    .apg-hero__cta { width: 100%; flex-direction: column; align-items: stretch; justify-content: flex-start; }
    .apg-hero__btn { width: 100%; }
  }
</style>
