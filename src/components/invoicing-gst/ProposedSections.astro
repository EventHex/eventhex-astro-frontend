---
// New sections for shipped features the page did not mention (from the Invoicing canvas Proposed board).
const base = "/feature-images/invoicing-gst/v5";
---

<section class="igp-section ds-night" id="b2b-receipts">
  <div class="igp-grid igp-grid--text-first">
    <div class="igp-copy">
      <span class="ds-eyebrow">On every order</span>
      <h2 class="ds-h2 igp-h2 animate-on-scroll" data-animation="fadeInUp">Spot the Business Buyers and <span class="ds-hl-dark">Send Their Receipt</span></h2>
      <p class="ds-body">Orders shows a B2B flag next to each purchase, so finance can see at once who asked for a tax invoice. Open the order to see the company name and tax ID, then download the receipt or email it to the buyer from the row menu.</p>
    </div>
    <div class="ds-glass-dark igp-glass igp-glass--pair animate-on-scroll" data-animation="fadeInRight">
      <div class="ds-shot">
        <video class="igt-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="1110"
          poster={`${base}/inv-orders-poster.webp`}
          aria-label="Orders with the B2B Enabled column: the row menu for Omar Farouk offers Download Receipt and Email Receipt, then his order opens with company Northwind Clinics Ltd, tax ID 29ABCDE1234F1Z5, a $261.00 subtotal, GST (18%) $46.98 and a $307.98 grand total">
          <source src={`${base}/inv-orders.webm`} type="video/webm" />
          <source src={`${base}/inv-orders.mp4`} type="video/mp4" />
        </video>
      </div>
      <div class="ds-shot"><img src={`${base}/drawer.webp`} alt="Order drawer for Omar Farouk with company Northwind Clinics Ltd, tax ID 29ABCDE1234F1Z5, coupon MEMBER10, subtotal $261.00, GST (18%) $46.98 and a $307.98 grand total" width="920" height="2110" loading="lazy" /></div>
    </div>
  </div>
</section>

<section class="igp-section ds-stage" id="live-invoice-preview">
  <div class="igp-grid igp-grid--wide-left">
    <div class="ds-glass igp-glass animate-on-scroll" data-animation="fadeInLeft"><div class="ds-shot"><img src={`${base}/billing.webp`} alt="Invoice and Billing settings with a live Invoice Preview showing your company name, INV-00001, date, currency and Bill To" width="2240" height="920" loading="lazy" /></div></div>
    <div class="igp-copy">
      <span class="ds-eyebrow">See it as you set it</span>
      <h2 class="ds-h2 igp-h2 animate-on-scroll" data-animation="fadeInUp">Watch the <span class="ds-hl">Invoice Take Shape</span> While You Edit</h2>
      <p class="ds-body">Change the prefix, starting number, Bill To label or title and a live preview of the invoice updates beside the fields, with your company name, address and logo. Turn on automatic sending to email each invoice to the buyer.</p>
    </div>
  </div>
</section>

<section class="igp-section igp-section--plain" id="tax-line-at-checkout">
  <div class="igp-grid igp-grid--text-first">
    <div class="igp-copy">
      <span class="ds-eyebrow">Tax shown before they pay</span>
      <h2 class="ds-h2 igp-h2 animate-on-scroll" data-animation="fadeInUp">Buyers See the <span class="ds-hl">Tax Line</span> at Checkout</h2>
      <p class="ds-body">When a ticket has a tax rule, the checkout adds the named tax line, for example GST (18%), and the new total before the buyer continues. The same breakdown is kept on the order.</p>
      <a class="igp-link" href="/event-payment-processing/">Payment Processing</a>
    </div>
    <div class="ds-shot igp-consent animate-on-scroll" data-animation="fadeInRight"><img src={`${base}/checkout.webp`} alt="Checkout with Business Details and the order summary showing GST (18%) plus $52.20 and a $342.20 total" width="2480" height="1680" loading="lazy" /></div>
  </div>
</section>

<style is:global>
  .igp-section { padding: var(--ds-section-y) var(--ds-gutter); box-sizing: border-box; }
  .igp-section--plain { background: var(--ds-white); }
  .igp-grid { max-width: var(--ds-container); margin: 0 auto; display: grid; gap: 56px; align-items: center; }
  .igp-grid--wide-left { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  .igp-grid--text-first { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  .igp-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .igp-h2 { margin: 0; }
  .igt-page .igp-section.ds-night h2.igp-h2 { color: var(--ds-on-night); -webkit-text-fill-color: currentColor; }
  .igp-glass { padding: 28px; min-width: 0; }
  .igp-glass--pair { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr); gap: 18px; align-items: start; }
  .igp-glass .ds-shot img, .igp-glass .ds-shot video { display: block; width: 100%; height: auto; }
  .igp-link { font-family: var(--ds-font-body); font-size: 15px; font-weight: 500; color: var(--ds-blue); text-decoration: none; }
  .igp-link::after { content: " \2192"; }
  .igp-link:hover { text-decoration: underline; }
  .igp-consent { min-width: 0; }
  .igp-consent img { display: block; width: 100%; height: auto; }
  @media (max-width: 960px) {
    .igp-grid, .igp-grid--wide-left, .igp-grid--text-first { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .igp-glass { padding: 16px; }
    .igp-glass--pair { grid-template-columns: minmax(0, 1fr); }
  }
</style>
