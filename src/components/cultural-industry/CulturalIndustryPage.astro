  .ci-faq{width:100%;padding:80px 24px;background:#fff}.ci-faq__inner{display:grid;grid-template-columns:360px 1fr;gap:64px;align-items:start;max-width:1140px;margin:auto}.ci-faq__sidebar{position:sticky;top:6rem;align-self:start}.ci-faq__eyebrow{display:inline-flex;align-items:center;gap:6px;margin-bottom:20px;padding:8px 16px;border:1px solid #e4e7ec;border-radius:999px;color:#000;font:500 .8125rem/1 var(--font-body)}.ci-faq__sidebar h2{margin:0 0 20px;color:#000;font:500 44px/1.1 'Creato Display',var(--font-heading);letter-spacing:-1px}.ci-faq__sidebar>p{margin:0 0 28px;color:var(--body-light);font:400 1rem/1.6 var(--font-body)}.ci-faq__cta{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:999px;background:#171a21;color:#fff;font:500 .9375rem/1 var(--font-body);text-decoration:none;transition:background .2s ease,transform .2s ease}.ci-faq__cta:hover{background:#000;transform:translateY(-1px)}.ci-faq__list{display:flex;flex-direction:column;gap:16px;counter-reset:cultural-faq}.ci-faq__item{counter-increment:cultural-faq;overflow:hidden;padding:4px 28px;border:1px solid #e4e7ec;border-radius:20px;background:#fff;transition:background .25s ease,border-color .25s ease}.ci-faq__item[open]{border-color:#e4e7ec;background:#e4e7ec}.ci-faq__question{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0;color:#000;font:500 1.0625rem/1.4 'Creato Display',var(--font-heading);cursor:pointer;list-style:none}.ci-faq__question::-webkit-details-marker{display:none}.ci-faq__question strong{font-weight:500}.ci-faq__question strong:before{content:counter(cultural-faq) '. '}.ci-faq__icon{position:relative;flex-shrink:0;width:18px;height:18px;transition:transform .28s cubic-bezier(.22,1,.36,1)}.ci-faq__icon:before,.ci-faq__icon:after{content:"";position:absolute;top:50%;left:50%;background:#000;transform:translate(-50%,-50%)}.ci-faq__icon:before{width:14px;height:2px}.ci-faq__icon:after{width:2px;height:14px;transition:opac