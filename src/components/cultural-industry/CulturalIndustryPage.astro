<script>
  const exclusive = (selector: string) => {
    const items = Array.from(document.querySelectorAll<HTMLDetailsElement>(selector));
    items.forEach(item => item.addEventListener("toggle", () => { if (item.open) items.forEach(other => { if (other !== item) other.open = false; }); }));
  };
  exclusive("[data-ci-faq-item]");
  const workflowItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-ci-workflow-item]"));
  workflowItems.forEach((item) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".ci-workflow__arrow");
    summary?.addEventListener("click", (event) => { event.preventDefault(); item.open = !item.open; });
    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} workflow step`);
      if (item.open) workflowItems.forEach((other) => { if (other !== item) other.open = false; });
    });
  });

  const useCaseSuite = document.querySelector<HTMLElement>("#use-cases");
  if (useCaseSuite) {
    const tabs = Array.from(useCaseSuite.querySelectorAll<HTMLButtonElement>("[data-ci-use-target]"));
    const panels = Array.from(useCaseSuite.querySelectorAll<HTMLElement>("[data-ci-use-panel]"));
    let rotationId: number | undefined;

    const activateUseCase = (tab: HTMLButtonElement, focus = false) => {
      const target = tab.dataset.ciUseTarget;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("ci-use-cases__tab--active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle("ci-use-panel--active", panel.dataset.ciUsePanel === target));
      if (focus) tab.focus();
    };

    const stopRotation = () => {
      if (rotationId === undefined) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    };
    const startRotation = () => {
      stopRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rotationId = window.setInterval(() => {
        const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateUseCase(tabs[(current + 1) % tabs.length]);
      }, 5000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => { activateUseCase(tab); startRotation(); });
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        activateUseCase(tabs[(index + offset + tabs.length) % tabs.length], true);
      });
    });
    useCaseSuite.addEventListener("mouseenter", stopRotation);
    useCaseSuite.addEventListener("mouseleave", startRotation);
    useCaseSuite.addEventListener("focusin", stopRotation);
    useCaseSuite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !useCaseSuite.contains(event.relatedTarget)) startRotation();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? stopRotation() : startRotation());
    startRotation();
  }
</script>

