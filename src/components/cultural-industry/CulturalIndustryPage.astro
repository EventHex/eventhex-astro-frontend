---
import FeatureCards from "../speaker-management/FeatureCards.astro";

interface Props { faqs: Array<[string, string]>; }
const { faqs } = Astro.props;

const operatingSteps = [
  ["Curate", "Programme + artists"], ["Publish", "Website + schedule"],
  ["Ticket", "Passes + rules"], ["Guide", "App + updates"],
  ["Welcome", "QR check-in"], ["Remember", "Photos + follow-up"],
];
const attendeeWorkflowCards = [
  {
    eyebrow: "One connected attendee path",
    title: "Discover the event and choose the right way in",
    desc: "Publish the festival story, programme, and ticket entry points, then let attendees select the configured pass or ticket that fits their visit.",
    image: "/feature-images/event-website-builder-v4/audience-journeys/event-page-destinations.png",
    alt: "EventHex event website page destinations for a cultural event",
    animated: true,
    width: 910,
    height: 696,
  },
  {
    title: "Prepare attendees before they arrive",
    desc: "Deliver tickets, confirmations, and the supported operational information attendees need before the cultural event begins.",
    image: "/feature-images/event-registration/confirmation-delivery.png",
    alt: "EventHex registration confirmation delivery settings",
    animated: true,
    width: 762,
    height: 696,
  },
  {
    title: "Navigate the programme from the attendee app",
    desc: "Keep the programme and attendee experience available during the event so people can move between the sessions and activities configured for them.",
    image: "/feature-images/solutions/attendee-app-phones.png",
    alt: "EventHex attendee mobile app showing event information",
    animated: true,
    width: 470,
    height: 512,
  },
  {
    title: "Arrive through the configured entry flow",
    desc: "Validate tickets and QR codes at the relevant cultural event entrance using the EventHex check-in workflow.",
    image: "/feature-images/event-check-in/scan-engine-visual.svg",
    alt: "EventHex QR scanning and event entry workflow",
    animated: true,
    width: 578,
    height: 476,
  },
  {
    title: "Remember the event through approved photo discovery",
    desc: "Use the configured photo-discovery experience and supported post-event communication after the cultural event.",
    image: "/feature-images/ai-photo-gallery/selfie-match-visual.svg",
    alt: "EventHex attendee selfie matching for event photo discovery",
    animated: true,
    width: 775,
    height: 812,
  },
];
const eventDay = [
  ["Programme visibility", "Keep scheduled activities and updates available.", ["Publish the live cultural programme", "Keep times and locations current", "Give attendees one schedule to follow"], "/images/cultural-industry/app/session-management-web-960.webp", "EventHex session management showing a scheduled cultural programme", 960, 600],
  ["Ticket validation", "Scan event QR codes at configured arrival points.", ["Validate configured tickets", "Keep arrival status current", "Support the event entrance team"], "/feature-images/event-registration/registration-to-checkin.png", "EventHex registration-to-check-in workflow", 762, 696],
  ["Audience announcements", "Send supported app notifications to selected attendees.", ["Choose the relevant audience", "Publish supported app updates", "Keep operational messages connected"], "/images/cultural-industry/app/attendee-app-updates-web-960.webp", "EventHex attendee app updates workspace with publishing controls", 960, 600],
  ["Photo discovery", "Let attendees find approved gallery images through the configured flow.", ["Use approved event galleries", "Configure the discovery flow", "Keep follow-up within the event experience"], "/images/cultural-industry/app/photo-discovery-settings-web-960.webp", "EventHex photo discovery settings and access controls", 960, 600],
];
const useCases = [
  {
    id: "festivals",
    label: "Cultural festivals",
    title: "Connect every festival touchpoint",
    description: "Connect programme, passes, app, notifications, arrival, and photos in one coordinated event workflow.",
    checklist: ["Build multi-stage programmes", "Keep passes and attendee updates connected", "Coordinate arrival and photo discovery"],
    image: "/images/cultural-industry/use-cases/timeline-view-web-960.webp",
    alt: "EventHex multi-stage timeline for coordinating a cultural festival programme",
    width: 960,
    height: 450,
    visualLabel: "Festival programme connected",
  },
  {
    id: "exhibitions",
    label: "Art exhibitions",
    title: "Guide every exhibition visit",
    description: "Run attendee registration, sessions or talks, partners, and event-day access from the same event setup.",
    checklist: ["Publish the exhibition entry path", "Schedule talks and partner moments", "Manage visitor access on event day"],
    image: "/images/cultural-industry/use-cases/website-embed-web-760.webp",
    alt: "EventHex registration embedded in a cultural event website",
    width: 760,
    height: 694,
    visualLabel: "Visitor journey published",
  },
  {
    id: "heritage",
    label: "Heritage events",
    title: "Prepare visitors before arrival",
    description: "Publish programme and visitor information with configured tickets and timely audience updates.",
    checklist: ["Configure visitor registration", "Publish programme and access details", "Send operational updates before arrival"],
    image: "/images/cultural-industry/use-cases/event-registration-dashboard-web-512.webp",
    alt: "EventHex registration dashboard for managing heritage event visitors",
    width: 512,
    height: 459,
    visualLabel: "Visitor information ready",
  },
  {
    id: "community",
    label: "Community celebrations",
    title: "Keep a lighter event easy to run",
    description: "Use a focused website, registration, communication, and check-in workflow without unnecessary complexity.",
    checklist: ["Share a simple event destination", "Keep registration and updates together", "Support fast event-day entry"],
    image: "/feature-images/event-check-in/operations-visual.svg",
    alt: "EventHex event operations view for coordinating community celebration entry",
    width: 407,
    height: 248,
    visualLabel: "Event-day flow active",
  },
];
const featureLinks = [
  ["Session Management", "Build the event programme.", "/session-management/"],
  ["Event Ticketing", "Configure passes and access rules.", "/event-ticketing/"],
  ["Event Mobile App", "Guide the attendee experience.", "/event-mobile-app/"],
  ["AI Photo Gallery", "Support photo discovery.", "/ai-photo-gallery/"],
];
---

<main class="ci-page">
  <!-- Event Registration: .erg-hero -->
  <section class="ci-hero" id="hero">
    <div class="ci-hero__grid">
      <div class="ci-hero__content">
        <span class="ci-hero__badge animate-on-scroll" data-animation="fadeInDown">Cultural Events</span>
        <h1 class="ci-hero__title animate-on-scroll" data-animation="fadeInUp">Connect festival programme, tickets, audiences, and event day</h1>
        <p class="ci-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration:800ms">Run cultural festivals, art exhibitions, heritage events, and community celebrations with sessions, ticketing, an attendee app, communication, supported engagement, photo discovery, and check-in.</p>
        <div class="ci-hero__cta-row animate-on-scroll" data-animation="fadeInUp" style="--anim-duration:1100ms">
          <a href="/book-a-demo/" class="ci-hero__btn">See it with your event <span aria-hidden="true">→</span></a>
          <a href="#event-model" class="ci-hero__btn ci-hero__btn--outline">See the operating model</a>
        </div>
        <div class="ci-hero__trust animate-on-scroll" data-animation="fadeIn"><span>Programme and ticketing</span><span>Audience communication</span><span>Photo discovery</span></div>
      </div>
      <div class="ci-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="ci-hero__visual-card"><div class="ci-hero__visual-inner"><picture><source media="(max-width:767px)" srcset="/images/cultural-industry/app/attendee-app-modules-web-640.webp"/><source media="(max-width:1100px)" srcset="/images/cultural-industry/app/attendee-app-modules-web-960.webp"/><img src="/images/cultural-industry/app/attendee-app-modules-web-1200.webp" alt="EventHex attendee app modules for sessions, entry passes, networking, and event photos" width="1200" height="750" loading="eager" decoding="async" fetchpriority="high"/></picture></div></div>
      </div>
    </div>
  </section>

  <!-- Event Registration: .erg-trust-strip -->
  <section class="ci-trust-strip" id="operating-map" aria-label="One connected event path from programme planning to post-event follow-up">
    <div class="ci-trust-strip__inner">{operatingSteps.map(([label, detail]) => <span class="ci-trust-strip__stat"><b>{label}</b> {detail}</span>)}</div>
  </section>

  <!-- Event Registration: #erg-spotlight / .erg-flow-quad -->
  <section class="ci-flow-section" id="event-model" aria-labelledby="ci-model-title">
    <header class="ci-flow-header"><p class="ci-eyebrow">Choose the right event model</p><h2 id="ci-model-title" class="ci-flow-title animate-on-scroll" data-animation="fadeInUp"><span>Community-led or programme-led.</span><span>Choose the shape that fits.</span></h2><p class="ci-flow-subtitle">Start with one model, then add only the modules the event actually needs.</p></header>
    <div class="ci-flow-quad">
      <article class="ci-flow-quad__cell ci-flow-quad__cell--copy animate-on-scroll" data-animation="fadeInUp"><span class="ci-index">01 · Primary model</span><h3>Community-led event</h3><p>Build registration, communications, participation, and follow-up around the people attending.</p></article>
      <div class="ci-flow-quad__cell ci-flow-quad__cell--media animate-on-scroll" data-animation="fadeInRight"><div class="ci-flow-composite"><img class="ci-flow-composite__screen ci-flow-composite__screen--primary" src="/feature-images/event-registration/single-registration-form.png" alt="EventHex single registration form for an attendee" width="760" height="480" loading="lazy" decoding="async"/><img class="ci-flow-composite__screen ci-flow-composite__screen--secondary" src="/feature-images/event-registration/single-ticket-list.png" alt="EventHex ticket list for a single-registration flow" width="760" height="480" loading="lazy" decoding="async"/><span class="ci-flow-composite__status">People-first workflow</span><span class="ci-flow-composite__action">Register</span></div></div>
      <div class="ci-flow-quad__cell ci-flow-quad__cell--media animate-on-scroll" data-animation="fadeInLeft"><div class="ci-flow-composite"><img class="ci-flow-composite__screen ci-flow-composite__screen--primary" src="/feature-images/event-registration/checkout-select-tickets.png" alt="EventHex multi-ticket checkout selection" width="1180" height="540" loading="lazy" decoding="async"/><img class="ci-flow-composite__screen ci-flow-composite__screen--secondary" src="/feature-images/event-registration/checkout-attendee-details.png" alt="EventHex checkout attendee details step" width="1180" height="540" loading="lazy" decoding="async"/><span class="ci-flow-composite__status">Programme-first workflow</span><span class="ci-flow-composite__action">Continue</span></div></div>
      <article class="ci-flow-quad__cell ci-flow-quad__cell--copy animate-on-scroll" data-animation="fadeInUp"><span class="ci-index">02 · Alternate model</span><h3>Programme-led event</h3><p>Add submissions, speakers, sessions, or exhibitors when the format needs more structure.</p></article>
      <span class="ci-flow-quad__cross" aria-hidden="true">
        <svg width="18" height="18" viewBox="-14 -14 28 28">
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e5e7eb)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e5e7eb)" transform="scale(1,-1)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e5e7eb)" transform="rotate(90)" />
          <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border, #e5e7eb)" transform="rotate(-90)" />
        </svg>
      </span>
    </div>
  </section>

  <!-- Speaker Management: ProgramContentSections .smp-content--agenda -->
  <section class="ci-agenda" id="core-workflow" aria-labelledby="ci-core-title">
    <div class="ci-agenda__inner">
      <header class="ci-agenda__header animate-on-scroll" data-animation="fadeInUp">
        <p class="ci-eyebrow">Connected experience</p>
        <h2 id="ci-core-title">Keep every part of the cultural event working together</h2>
      </header>
      <div class="ci-agenda-grid">
        <article class="ci-agenda-card animate-on-scroll" data-animation="fadeInUp">
          <div class="ci-agenda-card__text"><h3>Festival programme</h3><p>Build activities with rooms, times, capacity, speakers, performers, and the programme records EventHex supports.</p></div>
          <div class="ci-agenda__visual"><div class="ci-agenda__product" aria-hidden="true"><div class="ci-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Festival agenda</small></div><div class="ci-agenda__product-tabs"><span class="is-active">Day 1</span><span>Day 2</span><span>Day 3</span></div><div class="ci-agenda__schedule-list"><div><time>09:00</time><span><strong>Opening performance</strong><small>Main stage · 45 min</small></span></div><div class="is-accent"><time>10:15</time><span><strong>Artist conversation</strong><small>Gallery stage · 60 min</small></span></div><div><time>11:30</time><span><strong>Community workshop</strong><small>Studio · 30 min</small></span></div></div></div></div>
        </article>
        <article class="ci-agenda-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="ci-agenda__petal ci-agenda__petal--top" aria-hidden="true">◆</span><span class="ci-agenda__petal ci-agenda__petal--bottom" aria-hidden="true">◆</span>
          <div class="ci-agenda-card__text"><h3>Tickets and passes</h3><p>Configure ticket types, capacity, sale windows, purchase limits, discounts, add-ons, and delivery.</p></div>
          <div class="ci-agenda__visual"><div class="ci-agenda__product" aria-hidden="true"><div class="ci-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Pass structure</small></div><div class="ci-agenda__product-tabs"><span class="is-active">Passes</span><span>Rules</span></div><div class="ci-agenda__outline"><div><i></i><strong>Festival access</strong><small>3 days</small></div><div class="is-child"><i></i><strong>Weekend pass</strong><small>All areas</small></div><div class="is-child"><i></i><strong>Day pass</strong><small>Selected day</small></div><div class="is-break"><i></i><strong>Workshop add-on</strong><small>Limited</small></div></div></div></div>
        </article>
        <article class="ci-agenda-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <span class="ci-agenda__petal ci-agenda__petal--top" aria-hidden="true">◆</span><span class="ci-agenda__petal ci-agenda__petal--bottom" aria-hidden="true">◆</span>
          <div class="ci-agenda-card__text"><h3>Audience experience</h3><p>Use the attendee app, notifications, supported challenges, polls, and networking where they fit.</p></div>
          <div class="ci-agenda__visual"><div class="ci-agenda__product" aria-hidden="true"><div class="ci-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Audience modules</small></div><div class="ci-agenda__product-tabs"><span class="is-active">App</span><span>Updates</span><span>Engage</span></div><div class="ci-agenda__stage-board"><span><i></i><i></i></span><span><i></i><i></i></span><span><i></i><i></i></span></div></div></div>
        </article>
        <article class="ci-agenda-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <div class="ci-agenda-card__text"><h3>Event-day coordination</h3><p>Keep organisers, programme teams, communications, and entry operations working from the same event setup.</p></div>
          <div class="ci-agenda__visual"><div class="ci-agenda__product ci-agenda__product--wide" aria-hidden="true"><div class="ci-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Event team</small></div><div class="ci-agenda__product-tabs"><span>Teams</span><span class="is-active">Roles</span></div><div class="ci-agenda__people"><div><i>EO</i><span><strong>Event owner</strong><small>Event setup</small></span><b>Owner</b></div><div><i>PG</i><span><strong>Programme team</strong><small>Schedule</small></span><b>Editor</b></div><div><i>EN</i><span><strong>Entry team</strong><small>Check-in</small></span><b>Operator</b></div></div></div></div>
        </article>
        <article class="ci-agenda-card animate-on-scroll" data-animation="fadeInUp" data-delay="240">
          <span class="ci-agenda__petal ci-agenda__petal--top" aria-hidden="true">◆</span>
          <div class="ci-agenda-card__text"><h3>Photo discovery and follow-up</h3><p>Use configured photo discovery and supported event communication after the cultural event.</p></div>
          <div class="ci-agenda__visual"><div class="ci-agenda__product ci-agenda__product--wide" aria-hidden="true"><div class="ci-agenda__product-bar"><span><i></i><i></i><i></i></span><small>Follow-up access</small></div><div class="ci-agenda__product-tabs"><span class="is-active">Gallery</span><span>Audience</span></div><div class="ci-agenda__access-list"><div><span><strong>Attendee discovery</strong><small>Configured access</small></span><i class="is-on"></i></div><div><span><strong>Contributed photos</strong><small>Approval enabled</small></span><i class="is-on"></i></div><div><span><strong>Public gallery</strong><small>Review separately</small></span><i></i></div><b><i></i></b></div></div></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Event Registration: exact .erg-access-redesign structure -->
  <section class="ci-access" id="operating-view" aria-labelledby="ci-ops-title">
    <div class="ci-access__container">
      <div class="ci-access__left">
        <div class="ci-access__sticky animate-on-scroll" data-animation="fadeInUp">
          <div class="ci-access__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Team coordination</div>
          <h2 id="ci-ops-title">Coordinate the moments<br/>that shape the<br/><span>experience</span></h2>
          <p>Give each team a clear job while keeping the attendee and event record connected.</p>
          <a class="ci-access__cta" href="/book-a-demo/">Book a Demo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>
      </div>
      <div class="ci-access__right">
        <article class="ci-access-card animate-on-scroll" data-animation="fadeInUp">
          <div class="ci-access-card__header"><div class="ci-access-card__number">01</div><div class="ci-access-card__text"><h3>Event owner</h3><p>Set the event, audience, approval, access, programme, and reporting decisions.</p></div></div>
          <div class="ci-access-card__visual ci-access-card__visual--approval"><div class="ci-approval-stack"><img class="ci-approval-stack__tickets" src="/feature-images/event-registration/approval-ticket-list.png" alt="EventHex ticket list for a cultural event registration workflow" width="760" height="430" loading="lazy" decoding="async"/><img class="ci-approval-stack__setting" src="/feature-images/event-registration/approval-setting.png" alt="EventHex approval setting for attendee registrations" width="760" height="430" loading="lazy" decoding="async"/><span class="ci-product-shot__status ci-product-shot__status--approval"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Approval required</span><span class="ci-product-shot__action">Review &amp; approve</span><svg class="ci-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div>
        </article>
        <article class="ci-access-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <div class="ci-access-card__header"><div class="ci-access-card__number">02</div><div class="ci-access-card__text"><h3>Registration and finance teams</h3><p>Coordinate approval and payment rules when the cultural event uses paid booking.</p></div></div>
          <div class="ci-access-card__visual ci-access-card__visual--product"><div class="ci-product-shot ci-product-shot--payment"><img src="/feature-images/event-registration/hold-payment-settings.png" alt="EventHex paid booking and checkout configuration" width="760" height="500" loading="lazy" decoding="async"/><span class="ci-product-shot__status ci-product-shot__status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Payment secured</span><span class="ci-product-shot__action">Approve &amp; charge</span><svg class="ci-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div>
        </article>
        <article class="ci-access-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <div class="ci-access-card__header"><div class="ci-access-card__number">03</div><div class="ci-access-card__text"><h3>Audience and communications teams</h3><p>Keep private passes off the public page and share direct access only with the intended audience.</p></div></div>
          <div class="ci-access-card__visual ci-access-card__visual--product"><div class="ci-product-shot ci-product-shot--private"><img src="/feature-images/event-registration/private-ticket-settings.png" alt="EventHex private ticket management for selected cultural event audiences" width="760" height="480" loading="lazy" decoding="async"/><span class="ci-product-shot__status"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 9V7a3.5 3.5 0 0 1 7 0v2M5 9h10v8H5z"></path></svg>Link-only access</span><span class="ci-product-shot__action">Copy private link</span><svg class="ci-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div>
        </article>
        <article class="ci-access-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
          <div class="ci-access-card__header"><div class="ci-access-card__number">04</div><div class="ci-access-card__text"><h3>Entry and operations teams</h3><p>Apply the purchase limits, sale windows, and ticket-specific rules configured for each pass.</p></div></div>
          <div class="ci-access-card__visual ci-access-card__visual--product"><div class="ci-product-shot ci-product-shot--rules"><img src="/feature-images/event-registration/ticket-specific-rules.png" alt="EventHex ticket purchase limits and sale-period settings" width="800" height="620" loading="lazy" decoding="async"/><span class="ci-product-shot__status ci-product-shot__status--success"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>Rules active</span><span class="ci-product-shot__action">Save rules</span><svg class="ci-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg></div></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Speaker Management: exact FeatureCards stacking workflow -->
  <FeatureCards
    id="attendee-journey"
    cards={attendeeWorkflowCards}
    subtitle="Audience experience"
    titleLineOne="Connect the moments attendees"
    highlight="actually"
    titleLineTwo="move through"
  />

  <!-- Speaker Management: ProgramContentSections workflow accordion -->
  <section class="ci-workflow" id="event-day" aria-labelledby="ci-day-title">
    <div class="ci-workflow__inner">
      <header class="ci-workflow__header">
        <h2 id="ci-day-title">Keep event-day actions tied to the same event record</h2>
      </header>
      <ol class="ci-steps">
        {eventDay.map(([title, copy, bullets, image, alt, width, height], index) => (
          <li>
            <details open={index === 0} data-ci-workflow-item>
              <summary tabindex="-1">
                <span>0{index + 1}</span>
                <div class="ci-step__content">
                  <h3>{title}</h3>
                  <p>{copy}</p>
                  <ul>{bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul>
                </div>
                <button type="button" class="ci-workflow__arrow" aria-label={`${index === 0 ? "Collapse" : "Expand"} ${title}`} aria-expanded={index === 0 ? "true" : "false"}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </button>
              </summary>
              <div class="ci-step-visual"><img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async"/></div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Event Registration: exact confirmations bento grid -->
  <section class="ci-scope" id="configuration" aria-labelledby="ci-boundary-title">
    <div class="ci-scope__inner">
      <header class="ci-scope__header animate-on-scroll" data-animation="fadeInUp">
        <h2 id="ci-boundary-title">Keep EventHex responsibility separate from <span>specialist requirements</span></h2>
      </header>
      <div class="ci-scope__grid animate-on-scroll" data-animation="fadeInUp">
