---
interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

const workflow = [
  ["Describe", "What the Form Needs"],
  ["Generate", "A Draft Field Set"],
  ["Arrange", "Questions and Layout"],
  ["Preview", "The Attendee View"],
  ["Publish", "Registration or Public Form"],
  ["Review", "Responses and Exports"],
];

const aiSteps = [
  {
    title: "Describe the Form",
    copy: "Name the event task and the information you want from each respondent.",
  },
  {
    title: "Generate the Fields",
    copy: "EventHex selects suitable standard or custom field types and drafts relevant options where needed.",
  },
  {
    title: "Check the Questions",
    copy: "Review labels, required fields, choice options, and the information the form will collect.",
  },
  {
    title: "Refine in the Builder",
    copy: "Add, remove, edit, resize, or reorder fields before opening the attendee preview.",
  },
];

const useCases = [
  {
    eyebrow: "Registration",
    title: "Ticket Registration Forms",
    copy: "Add shared event questions and ticket-specific questions to the registration journey.",
    image: "/feature-images/event-registration/single-registration-form.png",
    alt: "EventHex ticket registration form",
    width: 760,
    height: 480,
    stage: "describe",
    top: "Ticket form",
    topDetail: "Registration questions",
    bottom: "Ready to review",
  },
  {
    eyebrow: "Checkout",
    title: "Multi-Ticket Checkout",
    copy: "Collect buyer information once, then ask the right questions for each attendee and ticket.",
    image: "/feature-images/event-registration/checkout-attendee-details.png",
    alt: "EventHex multi-ticket checkout attendee details",
    width: 1180,
    height: 540,
    stage: "generate",
    top: "Buyer details",
    topDetail: "Collected once",
    bottom: "Attendee questions",
  },
  {
    eyebrow: "Standalone",
    title: "Standalone Event Forms",
    copy: "Create a public form for applications, enquiries, surveys, or other event workflows that need their own link.",
    image: "/feature-images/ai-platform/form-builder-preview.jpg",
    alt: "Attendee preview of a standalone EventHex form",
    width: 1117,
    height: 837,
    stage: "check",
    top: "Public form",
    topDetail: "Attendee preview",
    bottom: "Share by link",
  },
  {
    eyebrow: "Feedback",
    title: "Event Feedback Forms",
    copy: "Build NPS, rating, choice, and open-text questions, then connect the responses to the event's feedback workflow.",
    image: "/feature-images/ai-platform/form-builder-add-field.jpg",
    alt: "EventHex form field palette with NPS and rating fields",
    width: 1117,
    height: 837,
    stage: "refine",
    top: "NPS + rating",
    topDetail: "Feedback fields",
    bottom: "Responses connected",
  },
];

const fieldGroups = [
  ["Attendee and Company Details", "Use name, email, phone, company, job title, country, website, and profile fields."],
  ["Answers and Selections", "Use short or long text, dropdown, checkbox, and multi-select questions with the options your event needs."],
  ["Dates, Times, and Numbers", "Ask for structured values that are easier to validate and review."],
  ["Files and Images", "Collect supported uploads for applications, profiles, or event materials."],
  ["NPS, Ratings, and Guidance", "Add feedback scores or information text that explains the next part of the form."],
];

const registrationModes = [
  {
    id: "single-registration",
    label: "Single Registration",
    title: "Single Registration",
    copy: "Ask shared questions across ticket forms, then add questions that appear only for a selected ticket.",
    scope: "One attendee. One focused registration.",
    checklist: [
      "Shared event questions across ticket forms",
      "Ticket-specific questions for the selected ticket",
      "One focused registration journey per attendee",
    ],
    image: "/feature-images/event-registration/single-registration-form.png",
    alt: "Single Registration form showing shared and ticket-specific questions",
    visualLabel: "Registration scope",
    width: 760,
    height: 480,
  },
  {
    id: "multi-ticket-checkout",
    label: "Multi-Ticket Checkout",
    title: "Multi-Ticket Checkout",
    copy: "Collect shared buyer details once and collect ticket-specific information for each attendee in the order.",
    scope: "One buyer. The right questions per attendee.",
    checklist: [
      "Shared buyer details collected once",
      "Ticket-specific information for each attendee",
      "The right questions for every ticket in the order",
    ],
    image: "/feature-images/event-registration/checkout-attendee-details.png",
    alt: "Multi-ticket checkout showing buyer details and attendee questions",
    visualLabel: "Checkout scope",
    width: 1180,
    height: 540,
  },
];

const related = [
  {
    title: "Draft the Field Set With AI",
    copy: "Describe the information you need and let EventHex create a reviewable field draft inside the visual builder.",
    bullets: ["Typed form description", "Supported field types and choice options", "Organizer review before publishing"],
    href: "/ai-platform/",
    linkLabel: "Explore AI Platform",
    image: "/feature-images/ai-platform/form-builder-describe.jpg",
    alt: "EventHex AI form builder prompt for describing the required fields",
    width: 1117,
    height: 837,
  },
  {
    title: "Choose the Registration Context",
    copy: "Use Single Registration or multi-ticket Checkout so shared details and ticket-specific questions appear in the right place.",
    bullets: ["Shared questions across ticket forms", "Ticket-specific questions for a selected ticket", "Buyer details collected once in Checkout"],
    href: "/event-registration/",
    linkLabel: "Explore Event Registration",
    image: "/feature-images/event-registration/single-registration-form.png",
    alt: "EventHex Single Registration form with shared and ticket-specific questions",
    width: 760,
    height: 480,
  },
  {
    title: "Apply the Ticket-Level Rules",
    copy: "Keep each question aligned with the ticket types, availability, pricing, and attendee rules configured for the event.",
    bullets: ["Ticket types and availability", "Pricing and ticket-level rules", "Questions scoped to the right attendee"],
    href: "/event-ticketing/",
    linkLabel: "Explore Event Ticketing",
    image: "/feature-images/event-registration/ticket-specific-rules.png",
    alt: "EventHex ticket-specific registration rules",
    width: 800,
    height: 620,
  },
  {
    title: "Place and Publish the Form",
    copy: "Preview the attendee experience, publish when ready, and continue through registration, a public link, QR code, or the event website.",
    bullets: ["Attendee-facing preview", "Public link and QR sharing", "Selected form on the EventHex website"],
    href: "/event-website-builder/",
    linkLabel: "Explore Website Builder",
    image: "/feature-images/event-registration/website-embed.png",
    alt: "EventHex registration form embedded on an event website",
    width: 762,
    height: 696,
  },
];
---

<div class="afb-page">
  <section class="afb-hero ds-stage" id="top">
    <div class="afb-hero__grid">
      <div class="afb-hero__content">
        <span class="afb-hero__badge animate-on-scroll" data-animation="fadeInDown">AI Event Form Builder</span>
        <h1 class="afb-hero__title ds-h1 animate-on-scroll" data-animation="fadeInUp">
          Build Event Forms From a Prompt—<span class="ds-hl">Then Make Them Fit Your Event</span>
        </h1>
        <p class="afb-hero__copy animate-on-scroll" data-animation="fadeInUp">
          Describe the information you need. EventHex drafts the fields inside the same visual builder used for ticket registration, standalone forms, and event feedback. Review every question, preview the attendee experience, and publish when it is ready.
        </p>
        <ul class="afb-hero__proof animate-on-scroll" data-animation="fadeIn">
          <li>AI-generated field draft</li>
          <li>Organizer-reviewed before publish</li>
          <li>Registration and standalone forms</li>
        </ul>
        <div class="afb-hero__actions animate-on-scroll" data-animation="fadeInUp">
          <a class="ds-btn afb-button" href="/book-a-demo/">
            Book a Demo
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
          </a>
          <a class="ds-btn--ghost afb-button" href="#ai-draft">See the builder flow</a>
        </div>
      </div>

      <div class="afb-hero__visual animate-on-scroll" data-animation="fadeIn">
        <div class="afb-hero__visual-card">
          <div class="afb-hero__visual-inner">
            <div class="afb-hero-collage" role="group" aria-label="EventHex AI Form Builder from prompt to editable field draft">
              <figure class="afb-hero-shot afb-hero-shot--builder">
                <img
                  src="/feature-images/ai-platform/form-builder-generated.jpg"
                  alt="EventHex visual form builder with shared and ticket-specific fields"
                  width="1117"
                  height="837"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <figcaption>Editable Field Draft</figcaption>
              </figure>
              <figure class="afb-hero-shot afb-hero-shot--prompt">
                <img
                  src="/feature-images/ai-platform/form-builder-describe.jpg"
                  alt="EventHex AI prompt for generating form fields"
                  width="1117"
                  height="837"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>Describe the Form</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="afb-rail" aria-label="Connected form workflow">
    <div class="afb-rail__inner">
      <span class="afb-rail__label">Connected workflow</span>
      {workflow.map(([title, copy], index) => (
        <span class="afb-rail__stat" aria-label={`${String(index + 1).padStart(2, "0")} ${title}: ${copy}`}>
          <b>{String(index + 1).padStart(2, "0")}</b> {title}
        </span>
      ))}
    </div>
  </section>

  <section class="afb-use" id="ai-draft">
    <div class="afb-shell">
      <header class="afb-heading animate-on-scroll" data-animation="fadeInUp">
        <h2 class="ds-h2">Tell EventHex What to Collect. <span class="ds-hl">Start Editing the Result.</span></h2>
        <p>The AI step creates a field draft from your description. The organizer decides what stays, what changes, and what gets published.</p>
      </header>
      <div class="afb-use__grid">
        {[25, 50, 75].map((left) => (
          <span class="afb-grid-notch" style={`left:${left}%`} aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--afb-line)"></path></svg>
          </span>
        ))}
        {aiSteps.map((step, index) => (
          <article class="afb-use__card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
            <div class="afb-use__icon" aria-hidden="true">
              {index === 0 && <svg viewBox="0 0 24 24"><path d="M4 21v-9h16v9M7 12V5h10v7M8 16h8" /></svg>}
              {index === 1 && <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 10h16M8 14h3M15 14h2" /></svg>}
              {index === 2 && <svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg>}
              {index === 3 && <svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2" /></svg>}
            </div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="afb-bento-section ds-stage" id="event-use-cases">
    <div class="afb-bento-container">
      <header class="afb-bento-header animate-on-scroll" data-animation="fadeInUp">
        <h2 class="ds-h2">Use One Builder Across Registration, Feedback, and <span class="ds-hl">Follow-Up</span></h2>
        <p>Build questions where they belong instead of moving form data between disconnected tools.</p>
      </header>
      <div class="afb-bento-grid animate-on-scroll" data-animation="fadeInUp">
        <span class="afb-bento-notch afb-bento-notch--top" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg>
        </span>
        <span class="afb-bento-notch afb-bento-notch--bottom" aria-hidden="true">
          <svg width="28" height="28" viewBox="-14 -14 28 28"><path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path></svg>
        </span>

        {useCases.map((useCase, index) => (
          <div class:list={["afb-bento-row", { "afb-bento-row--reverse": index % 2 === 1 }]}>
            {index % 2 === 1 && (
              <div class="afb-bento-cell afb-bento-content">
                <span class="afb-bento-eyebrow">{useCase.eyebrow}</span>
                <h3>{useCase.title}</h3>
                <p>{useCase.copy}</p>
              </div>
            )}
            <div class="afb-bento-cell afb-bento-visual">
              <div class={`afb-bento-shot-stage afb-bento-shot-stage--${useCase.stage}`}>
                <img class="afb-bento-product-shot" src={useCase.image} alt={useCase.alt} width={useCase.width} height={useCase.height} loading="lazy" />
                <span class="afb-shot-float afb-shot-float--top"><b>{useCase.top}</b><small>{useCase.topDetail}</small></span>
                <span class="afb-shot-float afb-shot-float--bottom"><i></i><b>{useCase.bottom}</b></span>
              </div>
            </div>
            {index % 2 === 0 && (
              <div class="afb-bento-cell afb-bento-content">
                <span class="afb-bento-eyebrow">{useCase.eyebrow}</span>
                <h3>{useCase.title}</h3>
                <p>{useCase.copy}</p>
              </div>
            )}
            <span class="afb-bento-cross" aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path>
                <path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path>
                <path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(90)"></path>
                <path style="fill:var(--ds-line-strong)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(-90)"></path>
              </svg>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="afb-fields ds-night" id="field-library">
    <div class="afb-shell">
      <header class="afb-heading afb-heading--dark animate-on-scroll" data-animation="fadeInUp">
        <h2 class="ds-h2">Build With Event-Ready Fields—<span class="ds-hl-dark">Not Generic Blanks</span></h2>
        <p>Start with familiar attendee details, then add the input type that fits the decision or response.</p>
      </header>
      <div class="afb-fields__grid">
        {fieldGroups.map(([title, copy], index) => (
          <article class="afb-field-card animate-on-scroll" data-animation="fadeInUp" data-delay={String((index % 3) * 70)}>
            {[1, 2, 4].includes(index) && (
              <>
                <span class="afb-field-petal afb-field-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path style="fill:var(--ds-ink-2)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
                <span class="afb-field-petal afb-field-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path style="fill:var(--ds-ink-2)" d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path></svg></span>
              </>
            )}
            <div class={`afb-field-card__preview afb-field-card__preview--${index}`} aria-hidden="true">
              {index === 0 && <><span>Name</span><i></i><span>Company</span><i></i></>}
              {index === 1 && <><span>Session format</span><i class="has-chevron"></i><small><b></b> Workshop</small><small><b></b> Keynote</small></>}
              {index === 2 && <><span>Preferred date</span><i class="has-date">18</i><span>Group size</span><i class="has-number">120</i></>}
              {index === 3 && <><span>Upload headshot</span><i class="has-upload">↑ &nbsp; Choose file</i><small>PNG, JPG or supported file</small></>}
              {index === 4 && <><span>How likely are you to recommend?</span><div class="afb-rating"><b>0</b><b>1</b><b>2</b><b>3</b><b>4</b><b>5</b></div></>}
            </div>
            <span class="afb-field-card__num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="afb-field-cta animate-on-scroll" data-animation="fadeInUp">
      <h2 class="ds-h2">Build the Questions Your <span class="ds-hl-dark">Event Actually Needs</span></h2>
      <a href="/book-a-demo/" class="ds-btn--light">Book a Demo</a>
    </div>
  </section>

  <section class="afb-modes" id="registration-logic">
    <div class="afb-modes__inner">
      <header class="afb-modes__header">
        <h2 class="afb-modes__title ds-h2 animate-on-scroll" data-animation="fadeInUp">Keep Shared Details Separate From <span class="ds-hl">Ticket-Specific Questions</span></h2>
        <p class="afb-modes__subtitle animate-on-scroll" data-animation="fadeInUp">EventHex changes the form-builder context to match the registration flow selected for the event.</p>
      </header>

      <div class="afb-modes__tabs animate-on-scroll" data-animation="fadeInUp" role="tablist" data-afb-mode-tabs>
        {registrationModes.map((item, index) => (
          <button
            class:list={["afb-modes__tab", { "afb-modes__tab--active": index === 0 }]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`afb-mode-panel-${item.id}`}
            id={`afb-mode-tab-${item.id}`}
            data-afb-mode-target={item.id}
          >
            {item.label}
          </button>
        ))}
      </div>

      <div class="afb-modes__box animate-on-scroll" data-animation="fadeInUp">
        {registrationModes.map((item, index) => (
          <div
            class:list={["afb-mode-panel", { "afb-mode-panel--active": index === 0 }]}
            id={`afb-mode-panel-${item.id}`}
            role="tabpanel"
            aria-labelledby={`afb-mode-tab-${item.id}`}
            data-afb-mode-panel={item.id}
            hidden={index !== 0}
          >
            <div class="afb-mode-panel__left">
              <h3>{item.title}</h3>
              <p class="afb-mode-panel__description">{item.copy}</p>
              <div class="afb-mode-panel__scope">
                <span>Form Scope</span>
                <strong>{item.scope}</strong>
              </div>
              <ul class="afb-mode-panel__checklist">
                {item.checklist.map((point) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            <div class="afb-mode-panel__right">
              <div class="afb-mode-panel__showcase">
                <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
                <span class="afb-mode-panel__visual-label">
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <rect x="3" y="3.5" width="14" height="13" rx="2"></rect>
                    <path d="M6.5 8h7M6.5 11h5M6.5 14h3"></path>
                  </svg>
                  {item.visualLabel}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="afb-modes__note">For the full flow decision, explore <a href="/event-registration/">Event Registration</a>. This page focuses on how the builder shapes questions inside each flow.</p>
    </div>
  </section>

  <section class="afb-stories ds-night" id="builder-control">
    <div class="afb-stories__inner">
      <header class="afb-stories__header">
        <span class="afb-pill afb-pill--dark">From Draft to Response</span>
        <h2 class="ds-h2">Organizer Control <span class="ds-hl-dark">at Every Step</span></h2>
      </header>
      <div class="afb-stories__cards">
        <article class="afb-story" style="--card-index: 0;">
          <div class="afb-story__copy">
            <span>Visual control after AI generation</span>
            <h3>Fine-Tune the Form Without Rebuilding It</h3>
            <p>Open a field and edit its label, helper text, required and validation settings, choices, width, order, configured-language copy, or cloned ticket questions—while the form structure stays visible.</p>
            <a href="/book-a-demo/" class="ds-btn--light">Explore the builder</a>
          </div>
          <div class="afb-story__visual" role="img" aria-label="EventHex field canvas beside a form settings sidebar">
            <div class="afb-editor-ui" aria-hidden="true">
              <div class="afb-editor-ui__canvas"><small>Registration questions</small><i>Full name</i><i class="is-selected">Company name</i><i>Job title</i><i>Country</i></div>
              <div class="afb-editor-ui__settings"><b>Company name</b><span>Field label</span><i>Company name</i><span>Width</span><div><em>Full</em><em class="is-active">Half</em></div><label><i></i> Required field</label><button>Save field</button></div>
            </div>
          </div>
        </article>

        <article class="afb-story" style="--card-index: 1;">
          <div class="afb-story__copy">
            <span>See the attendee experience before it goes out</span>
            <h3>Preview, Publish, and Place the Form Where People Need It</h3>
            <p>Configure the questions, open the attendee preview, publish when ready, then use the registration flow, a public link, QR code, or an EventHex website page.</p>
            <a href="/book-a-demo/" class="ds-btn--light">See the publish flow</a>
          </div>
          <div class="afb-story__visual" role="img" aria-label="An event form preview with public link, QR code, and website placement options">
            <div class="afb-publish-ui" aria-hidden="true">
              <div class="afb-publish-ui__screen"><small>Attendee preview</small><b>Speaker application</b><i></i><i></i><i class="is-tall"></i><span>Submit application</span></div>
              <div class="afb-publish-ui__destinations"><div><b>Public link</b><small>eventhex.ai/form/…</small></div><div class="afb-qr"><i></i><i></i><i></i><i></i><i></i></div><div><b>Event website</b><small>Form section selected</small></div></div>
            </div>
          </div>
        </article>

        <article class="afb-story" id="responses" style="--card-index: 2;">
          <div class="afb-story__copy">
            <span>Response handling stays with the event</span>
            <h3>Keep Every Response Next to the Form That Collected It</h3>
            <p>See submission counts, review response-aware columns, export data when needed, and keep supported feedback scores and comments connected to the event record.</p>
            <a href="/book-a-demo/" class="ds-btn--light">Review the response flow</a>
          </div>
          <div class="afb-story__visual" role="img" aria-label="EventHex form submissions table with response counts and export action">
            <div class="afb-response-ui" aria-hidden="true">
              <div class="afb-response-ui__head"><span><small>Form submissions</small><b>Speaker application</b></span><i>Export responses</i></div>
              <div class="afb-response-ui__stats"><span><small>Total submissions</small><b>128</b></span><span><small>Today's submissions</small><b>12</b></span></div>
              <div class="afb-response-ui__table"><b>Name</b><b>Session topic</b><b>Format</b><span>Ana Silva</span><span>Designing trust</span><span>Keynote</span><span>Marcus Lee</span><span>Better breakouts</span><span>Workshop</span><span>Priya Nair</span><span>Event accessibility</span><span>Panel</span></div>
            </div>
          </div>
        </article>
        <div class="afb-stories__spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>

