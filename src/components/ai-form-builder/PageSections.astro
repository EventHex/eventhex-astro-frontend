<script>
  document.querySelectorAll<HTMLElement>('[data-afb-mode-tabs]').forEach((tablist) => {
    if (tablist.dataset.tabsReady === 'true') return;
    tablist.dataset.tabsReady = 'true';
    const section = tablist.closest<HTMLElement>('.afb-modes');
    if (!section) return;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[data-afb-mode-target]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-afb-mode-panel]'));

    const activateMode = (activeTab: HTMLButtonElement) => {
      const target = activeTab.dataset.afbModeTarget;
      tabs.forEach((tab) => {
        const active = tab === activeTab;
        tab.classList.toggle('afb-modes__tab--active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        const active = panel.dataset.afbModePanel === target;
        panel.classList.toggle('afb-mode-panel--active', active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => activateMode(tab)));
  });

  document.querySelectorAll<HTMLElement>('[data-afb-workflow]').forEach((group) => {
    if (group.dataset.accordionReady === 'true') return;
    group.dataset.accordionReady = 'true';
    const items = Array.from(group.querySelectorAll<HTMLDetailsElement>('[data-afb-workflow-item]'));
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  });

  const afbFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-afb-faq]'));
  afbFaqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      afbFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const afbFieldBand = document.querySelector<HTMLElement>('.afb-fields');
  if (afbFieldBand && afbFieldBand.dataset.bleedReady !== 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    afbFieldBand.dataset.bleedReady = 'true';
    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let ticking = false;
    let lastProgress = -1;

    const measureBand = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = afbFieldBand.getBoundingClientRect().top + window.scrollY;
    };
    const updateBand = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * 0.7)));
      const roundedProgress = Math.round(progress * 100) / 100;
      if (roundedProgress === lastProgress) return;
      lastProgress = roundedProgress;
      afbFieldBand.style.setProperty('--afb-band-p', String(roundedProgress));
    };
    const handleBandScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateBand);
    };
    const handleBandResize = () => {
      measureBand();
      lastProgress = -1;
      handleBandScroll();
    };

    measureBand();
    updateBand();
    window.addEventListener('scroll', handleBandScroll, { passive: true });
    window.addEventListener('resize', handleBandResize, { passive: true });
    window.addEventListener('load', handleBandResize);
  }
</script>

