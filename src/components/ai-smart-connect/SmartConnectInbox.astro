---
interface Props { states: string[][]; }
const { states } = Astro.props;
---
<section class="ascx-section ascx-soft ascx-audiences ascx-networking-inbox"><div class="ascx-shell"><header class="ascx-audiences__heading"><h2>Keep Every Introduction in the <span>Right Place</span></h2></header><div class="ascx-card-grid">
  <i class="ascx-audiences__notch ascx-audiences__notch--1" aria-hidden="true"></i><i class="ascx-audiences__notch ascx-audiences__notch--2" aria-hidden="true"></i><i class="ascx-audiences__notch ascx-audiences__notch--3" aria-hidden="true"></i>
  {states.map(([title,text],i)=><article><div class="ascx-audiences__icon" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4M8 11h6M11 8v6"></path></svg> : i === 1 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8"></path><path d="m17 11 2 2 4-4"></path></svg> : i === 2 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path><path d="m8 11 2 2 5-5"></path></svg>}</div><h3>{title}</h3><p>{text}</p></article>)}
</div></div></section>
