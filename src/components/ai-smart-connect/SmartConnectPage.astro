---
import SmartConnectFaq from "./SmartConnectFaq.astro";
import SmartConnectDarkBand from "./SmartConnectDarkBand.astro";
import SmartConnectDiscovery from "./SmartConnectDiscovery.astro";
import SmartConnectControlsBento from "./SmartConnectControlsBento.astro";
import SmartConnectInbox from "./SmartConnectInbox.astro";

interface Props { faq: string[][]; }
const { faq } = Astro.props;

const mechanisms = [
  ["Profile-based recommendations", "Use participant information available to EventHex to identify profiles with relevant similarity."],
  ["Bound to the selected event", "Recommendations come from candidate profiles associated with the event the attendee has opened."],
  ["Context before action", "Review available role, company, event details, and social information before connecting."],
  ["Connection state included", "See whether a profile is new, requested, invited, or already connected."],
  ["Attendee-controlled action", "Each attendee reviews the recommendation and decides whether to send a connection request."],
];
const journey = [
  ["Open Networking", "Enter the event's networking area when it is enabled for the attendee."],
  ["See AI Recommended", "Review profiles surfaced as a relevant starting point."],
  ["Open a profile", "Check the available professional and event-specific context."],
  ["Send a request", "Choose whether to invite that person to connect."],
  ["Continue in chat", "Start a conversation after the connection is accepted."],
  ["Schedule a meeting", "Use the connected profile to arrange a one-to-one meeting."],
];
const journeyBullets = [
  ["Browse everyone in the event", "Search by attendee context", "Stay inside the mobile app"],
  ["Surface relevant profiles first", "Use event-scoped recommendations", "Keep discovery attendee controlled"],
  ["Review role and company", "See event-specific context", "Open social links when provided"],
  ["Invite the right person", "Track pending requests", "Accept or decline clearly"],
  ["Start chat after acceptance", "Keep the relationship easy to find", "Continue from the connected profile"],
  ["Choose a one-to-one time", "Select an available meeting point", "Keep meeting details together"],
];
const journeyVisuals = ["networking-settings-profile-fields.webp", "networking-settings-features.webp", "networking-settings-profile-fields.webp", "networking-settings-connection-options.webp", "networking-settings-sorting.webp", "networking-settings-connection-options.webp"];
const states = [
  ["All", "Browse the networking directory and find another participant."],
  ["Connections", "Return to people who have accepted a connection."],
  ["Invitations", "Review incoming connection requests and accept or decline."],
  ["Requests", "Track the connection requests the attendee has already sent."],
];
const contexts = [
  ["Professional context", "Use designation and company when they help attendees understand who they are viewing."],
  ["Event-specific context", "Use a relevant answer collected in the event or ticket form when that is more useful."],
  ["Intentional field order", "Arrange selected fields in the sequence attendees should scan them."],
  ["More detail on profile", "Let attendees open a profile for additional information and provided social links."],
];
const audiences = [
  ["Exhibitions", "Help delegates explore attendees and visible booth members, then connect before starting a conversation."],
  ["Conferences and tech events", "Surface relevant participant profiles and keep speakers visible when the organizer enables them."],
  ["Associations", "Create a familiar networking path for members, guests, committees, and recurring event communities."],
  ["Corporate events and agencies", "Configure networking access and profile context separately for each event and attendee group."],
];
const connectedWorkflows = [
  { id: "mobile-app", label: "Event mobile app", title: "Bring better matches into the attendee app", description: "Put AI recommendations, profiles, connection requests, and conversations in the same mobile experience attendees already use.", href: "/event-mobile-app/", cta: "Explore the mobile app", eyebrow: "Attendee experience", action: "View recommendation", meta: "AI Recommended · Inside this event", image: "/feature-images/ai-smart-connect/attendee-app-recommendation.png" },
  { id: "registration", label: "Event registration", title: "Turn registration data into useful context", description: "Use attendee, company, ticket, and event-form information to help people understand why a connection could be relevant.", href: "/event-registration/", cta: "Explore registration", eyebrow: "Profile context", action: "Review profile", meta: "Registration details · Attendee controlled" },
  { id: "meetings", label: "Appointments & meetings", title: "Move promising connections into real meetings", description: "Let accepted connections continue into chat and one-to-one scheduling without making attendees restart their journey.", href: "/appointments-meetings/", cta: "Explore meetings", eyebrow: "Connected journey", action: "Schedule a meeting", meta: "Connected · Ready to meet" },
  { id: "exhibitors", label: "Exhibitor management", title: "Connect attendees with the right booth members", description: "Make relevant exhibitor representatives visible with the role and company context attendees need before reaching out.", href: "/exhibitor-management/", cta: "Explore exhibitors", eyebrow: "Booth networking", action: "View booth member", meta: "Exhibitor team · Available to connect", image: "/feature-images/ai-smart-connect/booth-networking-dashboard.png" },
];
---

<div class="ascx-page">
  <section class="ascx-hero">
    <div class="ascx-shell ascx-hero__grid">
      <div class="ascx-hero__copy">
        <span class="ascx-kicker animate-on-scroll" data-animation="fadeInDown">AI event matchmaking</span>
        <h1 class="animate-on-scroll" data-animation="fadeInUp">AI event matchmaking that helps the <em>right people</em> find each other</h1>
        <p class="animate-on-scroll" data-animation="fadeInUp">Give attendees a more focused way to discover people inside your event app. EventHex recommends profiles from the event, then lets each attendee review, connect, chat, and choose when to meet.</p>
        <ul class="ascx-proof animate-on-scroll" data-animation="fadeInUp" aria-label="Smart-Connect highlights"><li>Event-scoped recommendations</li><li>Attendee-controlled connections</li><li>Connected chat and meetings</li></ul>
        <div class="ascx-actions animate-on-scroll" data-animation="fadeInUp">
          <a class="ascx-btn" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          <a class="ascx-btn ascx-btn--ghost" href="#attendee-journey-redesign">See the attendee journey</a>
        </div>
      </div>
      <div class="ascx-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="ascx-hero__image"><div class="ascx-hero__image-inner"><img src="/feature-images/ai/ai-smart-networking.webp" alt="EventHex AI Smart-Connect profile recommendations in the attendee app" width="640" height="537" loading="eager" fetchpriority="high" /></div></div>
        <div class="ascx-float ascx-float--top"><span>AI Recommended</span><b>Profiles from this event</b></div>
        <div class="ascx-float ascx-float--bottom"><i></i><span>Attendee controlled</span></div>
      </div>
    </div>
  </section>

  <div class="ascx-trust" aria-label="Smart-Connect journey"><div class="ascx-shell"><span class="ascx-trust__label">Built for attendee connections</span>{[["Discover","Relevant profiles"],["Review","Profile context"],["Connect","Attendee controlled"],["Meet","One-to-one ready"]].map(([a,b]) => <span><b>{a}</b> {b}</span>)}</div></div>

  <SmartConnectDiscovery />

  <SmartConnectDarkBand items={mechanisms} />

  <section class="ascx-section ascx-spotlight">
    <div class="ascx-shell ascx-spotlight__grid"><div class="ascx-heading ascx-heading--left"><span class="ascx-kicker">AI Recommended</span><h2>Give each attendee a focused set of profiles to consider</h2><p>Recommended profiles appear as part of the networking experience, not as a separate organizer report.</p></div>
      <figure class="ascx-spotlight__image"><img src="/feature-images/ai-smart-connect/focused-profile-recommendations.png" alt="An attendee reviewing recommended professional connections on her phone at a conference" width="1536" height="1152" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <SmartConnectInbox {states} />

  <section id="attendee-journey" class="ascx-journey-dark"><div class="ascx-journey-dark__inner"><header class="ascx-journey-dark__header"><span class="ascx-journey-dark__eyebrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z"></path><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z"></path></svg>The attendee journey</span><h2>Networking that keeps every <em>introduction</em><span>moving toward a meeting</span></h2></header><div class="ascx-journey-stack">{journey.map(([title,text],i)=><article style={`--journey-index:${i}`}><div class="ascx-journey-stack__copy"><span>Step {String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p><a href="/book-a-demo/">Explore the journey</a></div><div class="ascx-journey-stack__visual"><div class="ascx-journey-ui"><div class="ascx-journey-ui__top"><i></i><b>Smart-Connect</b><small>{String(i+1).padStart(2,'0')} / 06</small></div><div class="ascx-journey-ui__person"><i>{i < 2 ? 'AM' : i < 4 ? 'JD' : 'SK'}</i><div><b>{i === 0 ? 'Networking directory' : i === 1 ? 'AI Recommended' : i === 2 ? 'Aisha Malik' : i === 3 ? 'Connection request' : i === 4 ? 'New conversation' : 'Meeting confirmed'}</b><small>{i === 0 ? 'Discover attendees' : i === 1 ? 'Profiles selected for you' : i === 2 ? 'Partnerships · Fintech' : i === 3 ? 'Ready to send' : i === 4 ? 'Connected now' : 'Tuesday · 2:30 PM'}</small></div></div><div class="ascx-journey-ui__progress"><span style={`width:${((i+1)/6)*100}%`}></span></div><button type="button">{i === 0 ? 'Open networking' : i === 1 ? 'View recommendation' : i === 2 ? 'View profile' : i === 3 ? 'Send request' : i === 4 ? 'Open chat' : 'View meeting'}</button></div></div></article>)}<div class="ascx-journey-stack__spacer" aria-hidden="true"></div></div></div></section>

  <section id="attendee-journey-redesign" class="ascx-workflow" aria-labelledby="ascx-workflow-title"><div class="ascx-workflow__inner">
    <header class="ascx-workflow__header animate-on-scroll" data-animation="fadeInUp"><h2 id="ascx-workflow-title">From First Discovery to a Real Meeting</h2></header>
    <ol class="ascx-workflow__steps">{journey.map(([title,text],i)=><li><details open={i===0}><summary><span>0{i+1}</span><div class="ascx-workflow__copy"><h3>{title}</h3><p>{text}</p><ul>{journeyBullets[i].map(bullet=><li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul></div><button type="button" class="ascx-workflow__arrow" aria-label={`${i===0?'Collapse':'Expand'} ${title}`} aria-expanded={i===0?'true':'false'}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg></button></summary><figure><img src={`/feature-images/ai-smart-connect/${journeyVisuals[i]}`} alt={`EventHex ${title.toLowerCase()} workflow`} width="600" height="550" loading="lazy" decoding="async" /></figure></details></li>)}</ol>
  </div></section>

  <script>
    document.querySelectorAll<HTMLDetailsElement>('.ascx-workflow details').forEach((item, _, all) => {
      const summary = item.querySelector('summary'); const trigger = item.querySelector<HTMLButtonElement>('.ascx-workflow__arrow');
      summary?.addEventListener('click', event => { event.preventDefault(); item.open = !item.open; });
      item.addEventListener('toggle', () => { trigger?.setAttribute('aria-expanded', String(item.open)); if (item.open) all.forEach(other => { if (other !== item) other.open = false; }); });
    });
  </script>

  <section class="ascx-section ascx-soft ascx-inbox" hidden><div class="ascx-heading"><span class="ascx-kicker">A networking inbox attendees can understand</span><h2>Keep every introduction in the right place</h2><p>The networking screen separates discovery from requests and relationships that need attention.</p></div><div class="ascx-shell ascx-inbox__grid">
    <i class="ascx-inbox__notch ascx-inbox__notch--1" aria-hidden="true"></i><i class="ascx-inbox__notch ascx-inbox__notch--2" aria-hidden="true"></i><i class="ascx-inbox__notch ascx-inbox__notch--3" aria-hidden="true"></i>
    {states.map(([title,text],i)=><article><div class="ascx-inbox__icon" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4M8 11h6M11 8v6"></path></svg> : i === 1 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8"></path><path d="m17 11 2 2 4-4"></path></svg> : i === 2 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path><path d="m8 11 2 2 5-5"></path></svg>}</div><h3>{title}</h3><p>{text}</p></article>)}
  </div></section>

  <section class="ascx-section ascx-after"><div class="ascx-shell ascx-after__layout"><div class="ascx-after__left"><div class="ascx-after__sticky"><span class="ascx-after__eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 12.5 11 15l5-6"></path><circle cx="12" cy="12" r="9"></circle></svg>After the connection</span><h2>Move from a profile to a <em>real conversation</em></h2><p>Smart-Connect keeps the next steps close to the relationship attendees choose to create.</p><a href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a></div></div><div class="ascx-after__cards">{[["Accept the connection","Both participants can see when the relationship is confirmed."],["Open chat","Continue the conversation from the connected profile."],["Arrange a one-to-one","Open the meeting flow and choose the meeting details."],["Return to the relationship","Find the person under Connections instead of restarting the search."]].map(([t,p],i)=><article><header><i>{String(i+1).padStart(2,'0')}</i><div><h3>{t}</h3><p>{p}</p></div></header><div class={`ascx-after__visual ascx-after__visual--${i+1}`}>{i === 0 ? <img class="ascx-after__photo" src="/feature-images/ai-smart-connect/connection-accepted-conversation.png" alt="Two conference attendees meeting after connecting in the event app" width="1536" height="1152" loading="lazy" decoding="async" /> : <div class="ascx-after__mock"><div class="ascx-after__mockbar"><span></span><span></span><span></span></div><div class="ascx-after__person"><b>{i === 1 ? 'Aisha Malik' : i === 2 ? 'Schedule a meeting' : 'Your connections'}</b><small>{i === 1 ? 'Online · Connected' : i === 2 ? 'Choose a time that works' : '12 people in your network'}</small></div><div class="ascx-after__lines"><span></span><span></span><span></span></div><button type="button">{i === 1 ? 'Open conversation' : i === 2 ? 'View available times' : 'View connection'}</button></div>}</div></article>)}</div></div></section>

  <section class="ascx-section ascx-soft ascx-audiences ascx-context-cards"><div class="ascx-shell"><header class="ascx-audiences__heading"><h2>Decide What Attendees Should <span>See on Each Networking Card</span></h2></header><div class="ascx-card-grid">
    <i class="ascx-audiences__notch ascx-audiences__notch--1" aria-hidden="true"></i><i class="ascx-audiences__notch ascx-audiences__notch--2" aria-hidden="true"></i><i class="ascx-audiences__notch ascx-audiences__notch--3" aria-hidden="true"></i>
    {contexts.map(([t,p],i)=><article><div class="ascx-audiences__icon" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0M18 3v4M16 5h4"></path></svg> : i === 1 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4zM8 8h8M8 12h5M8 16h3"></path></svg> : i === 2 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13"></path><circle cx="3" cy="6" r="1"></circle><circle cx="3" cy="12" r="1"></circle><circle cx="3" cy="18" r="1"></circle></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2h6v6M20 2l-8 8"></path><circle cx="10" cy="14" r="7"></circle><path d="M7 14h6M10 11v6"></path></svg>}</div><h3>{t}</h3><p>{p}</p></article>)}
  </div></div></section>

  <SmartConnectControlsBento />

  <section class="ascx-section ascx-soft ascx-audiences">
    <div class="ascx-shell">
      <header class="ascx-audiences__heading">
        <h2>Built for Events Where <span>Who You Meet Matters</span></h2>
      </header>
      <div class="ascx-card-grid">
        <i class="ascx-audiences__notch ascx-audiences__notch--1" aria-hidden="true"></i>
        <i class="ascx-audiences__notch ascx-audiences__notch--2" aria-hidden="true"></i>
        <i class="ascx-audiences__notch ascx-audiences__notch--3" aria-hidden="true"></i>
        {audiences.map(([t,p],i)=><article>
          <div class="ascx-audiences__icon" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-9h16v9M7 12V5h10v7M9 8h2m2 0h2M8 16h2m4 0h2"></path></svg> : i === 1 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M19 8v6m-3-3h6"></path></svg> : i === 2 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8M12 8v8"></path></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M6 21V8l6-4 6 4v13M9 12h2m2 0h2M9 16h2m2 0h2"></path></svg>}</div>
          <h3>{t}</h3><p>{p}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section class="ascx-connected" aria-labelledby="ascx-connected-title">
    <div class="ascx-connected__inner">
      <header class="ascx-connected__header">
        <h2 id="ascx-connected-title"><span>Connect Smart-Connect to</span><span>the rest of the attendee journey</span></h2>
        <p>Bring discovery, profiles, conversations, and meetings together in one connected experience.</p>
      </header>
      <div class="ascx-connected__tabs" role="tablist" aria-label="Connected EventHex workflows">
        {connectedWorkflows.map((item, index) => <button class:list={["ascx-connected__tab", { "is-active": index === 0 }]} type="button" role="tab" id={`ascx-tab-${item.id}`} aria-controls={`ascx-panel-${item.id}`} aria-selected={index === 0 ? "true" : "false"} data-connected-tab={item.id}>{item.label}</button>)}
      </div>
      <div class="ascx-connected__panels">
        {connectedWorkflows.map((item, index) => <article class:list={["ascx-connected__panel", { "is-active": index === 0 }]} id={`ascx-panel-${item.id}`} role="tabpanel" aria-labelledby={`ascx-tab-${item.id}`} data-connected-panel={item.id}>
          <div class="ascx-connected__copy"><span>{item.eyebrow}</span><h3>{item.title}</h3><p>{item.description}</p><a href={item.href}>{item.cta} <i aria-hidden="true">→</i></a></div>
          <div class:list={["ascx-connected__visual", { "ascx-connected__visual--image": item.image }]} aria-hidden="true">{item.image ? <img src={item.image} alt="" width="1575" height="998" loading="lazy" decoding="async" /> : <div class="ascx-connected__window"><div class="ascx-connected__bar"><i></i><i></i><i></i><b>Smart-Connect</b></div><div class="ascx-connected__profile"><span>AM</span><div><b>Aisha Malik</b><small>{item.meta}</small></div></div><div class="ascx-connected__lines"><i></i><i></i><i></i></div><button type="button">{item.action}</button></div>}<em>{item.eyebrow}</em></div>
        </article>)}
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('.ascx-connected');
      if (!root) return;
      const tabs = Array.from(root.querySelectorAll('[data-connected-tab]'));
      const panels = Array.from(root.querySelectorAll('[data-connected-panel]'));
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-connected-tab');
        tabs.forEach((item) => { const active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
        panels.forEach((panel) => panel.classList.toggle('is-active', panel.getAttribute('data-connected-panel') === target));
      }));
    });
  </script>

  <SmartConnectFaq {faq} />
</div>

<style is:global>
  .ascx-page{--blue:#375dfb;--ink:#111827;--muted:#667085;--line:#d9dee8;--soft:#f5f7fb;background:#fff;color:var(--ink);overflow-x:clip}.ascx-shell{width:min(1200px,calc(100% - 48px));margin-inline:auto}.ascx-section{padding:clamp(72px,8vw,112px) 0}.ascx-kicker{display:inline-block;margin-bottom:18px;color:var(--blue);font:750 12px/1 var(--font-body);letter-spacing:.13em;text-transform:uppercase}.ascx-heading{max-width:820px;margin:0 auto 56px;text-align:center}.ascx-heading--left{margin:0;text-align:left}.ascx-heading h2{margin:0 0 20px;font:500 clamp(36px,5vw,56px)/1.06 var(--font-heading);letter-spacing:-.04em}.ascx-heading p{margin:0;color:var(--muted);font:400 18px/1.65 var(--font-body)}
  .ascx-hero{position:relative;padding:clamp(84px,10vw,140px) 0 84px;background:radial-gradient(circle at 80% 25%,#d9efff 0,transparent 31%),radial-gradient(circle at 15% 90%,#f0e8ff 0,transparent 30%),#fff}.ascx-hero__grid{display:grid;grid-template-columns:1.02fr .98fr;gap:70px;align-items:center}.ascx-hero h1{margin:0 0 24px;font:500 clamp(48px,6.2vw,78px)/.98 var(--font-heading);letter-spacing:-.055em}.ascx-hero h1 em{font-style:normal;color:var(--blue)}.ascx-hero__copy>p{max-width:650px;margin:0;color:var(--muted);font:400 19px/1.65 var(--font-body)}.ascx-actions{display:flex;gap:12px;margin-top:32px}.ascx-btn{display:inline-flex;align-items:center;gap:16px;padding:15px 22px;border:1px solid var(--blue);border-radius:12px;background:var(--blue);color:#fff;font:650 15px var(--font-body);text-decoration:none}.ascx-btn--ghost{background:#fff;color:var(--ink);border-color:var(--line)}.ascx-proof{display:flex;flex-wrap:wrap;gap:8px 22px;margin:28px 0 0;padding:0;list-style:none;color:#475467;font:600 12px var(--font-body)}.ascx-proof li:before{content:'✓';margin-right:7px;color:var(--blue)}.ascx-hero__visual{position:relative}.ascx-hero__image{padding:24px;border:1px solid rgba(55,93,251,.16);border-radius:34px;background:rgba(255,255,255,.76);box-shadow:0 30px 80px rgba(31,50,97,.13);backdrop-filter:blur(12px)}.ascx-hero__image img{display:block;width:100%;height:auto;border-radius:22px}.ascx-float{position:absolute;display:flex;flex-direction:column;padding:13px 16px;border:1px solid #e2e7f0;border-radius:14px;background:#fff;box-shadow:0 14px 38px rgba(23,39,75,.14);font-family:var(--font-body)}.ascx-float span{font-size:11px;color:#667085}.ascx-float b{font-size:13px}.ascx-float--top{top:-24px;right:-18px}.ascx-float--bottom{right:-16px;bottom:28px;flex-direction:row;align-items:center;gap:8px}.ascx-float--bottom i{width:8px;height:8px;border-radius:50%;background:#18b981}.ascx-trust{border-block:1px solid var(--line);background:#fff}.ascx-trust .ascx-shell{disp