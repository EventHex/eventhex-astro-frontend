<script>
  function initAscXBandBleed() {
    const band = document.querySelector<HTMLElement>('.ascx-dark');
    if (!band || band.dataset.bleedReady === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    band.dataset.bleedReady = 'true';
    let bandTop = 0;
    let viewportHeight = window.innerHeight || 1;
    let ticking = false;
    let lastProgress = -1;
    const measure = () => {
      viewportHeight = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };
    const update = () => {
      ticking = false;
      const travelled = viewportHeight - (bandTop - window.scrollY);
      const progress = Math.min(1, Math.max(0, travelled / (viewportHeight * .7)));
      const rounded = Math.round(progress * 100) / 100;
      if (rounded === lastProgress) return;
      lastProgress = rounded;
      band.style.setProperty('--band-p', String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      lastProgress = -1;
      onScroll();
    };
    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('load', onResize);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAscXBandBleed);
  else initAscXBandBleed();
</script>
