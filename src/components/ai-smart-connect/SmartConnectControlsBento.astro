---
const controls = [
  {
    eyebrow: "Connection options",
    title: "Control how attendees connect",
    body: "Enable the connection, invitation, and request actions that fit the event. Attendees still decide who they want to connect with.",
    image: "/feature-images/ai-smart-connect/networking-settings-connection-options.webp",
    alt: "EventHex Networking Settings showing enabled connection, invitation, and request controls",
    tone: "yellow",
    top: "✓ Enabled",
    topSmall: "Connections + invites",
    bottom: "Attendee controlled",
  },
  {
    eyebrow: "Networking features",
    title: "Choose the discovery tools attendees can use",
    body: "Turn on meeting scheduling, AI recommendations, and similar-profile discovery when they support the way people should network at your event.",
    image: "/feature-images/ai-smart-connect/networking-settings-features.webp",
    alt: "EventHex networking feature settings for meetings, AI recommendations, and similar people",
    tone: "mint",
    top: "AI recommended",
    topSmall: "Similar people enabled",
    bottom: "Meetings ready",
  },
  {
    eyebrow: "Profile context",
    title: "Show the details that help people decide",
    body: "Select and order the profile fields attendees see in the networking list, so every recommendation arrives with useful professional context.",
    image: "/feature-images/ai-smart-connect/networking-settings-profile-fields.webp",
    alt: "EventHex Card Display Fields settings with designation and company selected",
    tone: "blue",
    top: "2 of 3 selected",
    topSmall: "Display order saved",
    bottom: "Context ready",
  },
  {
    eyebrow: "Directory order",
    title: "Put the right profiles nearer the top",
    body: "Sort the networking directory by profile completion, alphabetically, or by registration date to create the starting point that suits the event.",
    image: "/feature-images/ai-smart-connect/networking-settings-sorting.webp",
    alt: "EventHex attendee directory sorting options with registration date selected",
    tone: "pink",
    top: "Directory sorted",
    topSmall: "Created date selected",
    bottom: "Rules applied",
  },
];
---

<section class="scb-section" aria-labelledby="scb-title">
  <div class="scb-container">
    <header class="scb-header animate-on-scroll" data-animation="fadeInUp">
      <span>Organizer controls</span>
      <h2 id="scb-title">Set the networking rules before attendees start <em>connecting</em></h2>
      <p>Choose which actions are available, what profile context appears, and how the attendee directory is ordered.</p>
    </header>

    <div class="scb-grid animate-on-scroll" data-animation="fadeInUp">
      <span class="scb-notch scb-notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path></svg></span>
      <span class="scb-notch scb-notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path></svg></span>

      {controls.map((control, index) => (
        <div class:list={["scb-row", { "scb-row--reverse": index % 2 === 1 }]}>
          <div class="scb-cell scb-visual">
            <div class={`scb-shot scb-shot--${control.tone}`}>
              <img src={control.image} alt={control.alt} width="600" height="550" loading="lazy" decoding="async" />
              <span class="scb-float scb-float--top"><b>{control.top}</b><small>{control.topSmall}</small></span>
              <span class="scb-float scb-float--bottom"><i></i><b>{control.bottom}</b></span>
            </div>
          </div>
          <div class="scb-cell scb-content">
            <span class="scb-eyebrow">{control.eyebrow}</span>
            <h3>{control.title}</h3>
            <p>{control.body}</p>
          </div>
          <span class="scb-cross" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
            </svg>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scb-section{padding:clamp(72px,8vw,104px) 5%;background:#fff;color:#111827}.scb-container{max-width:1200px;margin:0 auto}.scb-header{max-width:920px;margin:0 auto 60px;text-align:center}.scb-header>span,.scb-eyebrow{display:block;margin-bottom:1rem;color:#5b21b6;font:600 .875rem var(--font-body);letter-spacing:.05em;text-transform:uppercase}.scb-header h2{margin:0;font-family:var(--font-heading);font-size:clamp(32px,4vw,56px);font-weight:500;line-height:normal;letter-spacing:-.03em}.scb-header h2 em{font-style:normal;background:linear-gradient(90deg,#555 0%,#aaa 100%);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;color:transparent}.scb-header p{max-width:720px;margin:22px auto 0;color:#667085;font:400 1.075rem/1.55 var(--font-body)}
  .scb-grid{position:relative;overflow:hidden;border:1px solid #e5e7eb;border-radius:16px;background:transparent}.scb-notch{position:absolute;left:50%;z-index:3;width:28px;height:28px;pointer-events:none;line-height:0}.scb-notch--top{top:0;transform:translate(-50%,-50%)}.scb-notch--bottom{bottom:0;transform:translate(-50%,50%)}.scb-row{position:relative;display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #e5e7eb}.scb-row:last-child{border-bottom:0}.scb-cell{display:flex;flex-direction:column;justify-content:center;padding:4rem}.scb-row:not(.scb-row--reverse) .scb-visual{border-right:1px solid #e5e7eb}.scb-row--reverse .scb-content{order:1;border-right:1px solid #e5e7eb}.scb-row--reverse .scb-visual{order:2}.scb-visual{align-items:center}.scb-shot{position:relative;isolation:isolate;width:100%;padding:32px 18px;border-radius:22px}.scb-shot--yellow{background:linear-gradient(180deg,#fdefb8 0%,#fdf7dd 45%,#f5f6f9 100%)}.scb-shot--mint{background:linear-gradient(180deg,#cdf3de 0%,#e6f8ee 45%,#f5f6f9 100%)}.scb-shot--blue{background:linear-gradient(180deg,#dbe1fb 0%,#eceffd 45%,#f5f6f9 100%)}.scb-shot--pink{background:linear-gradient(180deg,#fbdde4 0%,#fdecf0 45%,#f5f6f9 100%)}.scb-shot img{display:block;width:100%;height:auto;border:1px solid #dfe4ec;border-radius:14px;animation:scb-shot-breathe 7s ease-in-out infinite;will-change:transform}.scb-row:nth-child(even) .scb-shot img{animation-delay:-3.5s}.scb-visual:hover .scb-shot img{animation-play-state:paused;transform:scale(1.018)}
  .scb-float{position:absolute;z-index:2;display:flex;align-items:center;gap:9px;padding:11px 14px;border:1px solid rgba(206,215,232,.9);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 14px 34px rgba(30,45,88,.2);color:#111827;font-family:var(--font-body);line-height:1.15;animation:scb-card-float 4.8s ease-in-out infinite;backdrop-filter:blur(10px)}.scb-float b{font-size:.78rem;font-weight:700;white-space:nowrap}.scb-float small{display:block;color:#7b8497;font-size:.65rem;white-space:nowrap}.scb-float i{width:9px;height:9px;border-radius:50%;background:#19b874;box-shadow:0 0 0 5px rgba(25,184,116,.13)}.scb-float--top{top:12px;right:3px;align-items:flex-start;flex-direction:column;gap:3px}.scb-float--bottom{bottom:12px;left:3px;animation-delay:-2.4s}.scb-row:nth-child(n+3) .scb-float--top{animation-delay:-1.2s}.scb-cross{position:absolute;bottom:0;left:50%;z-index:3;width:28px;height:28px;transform:translate(-50%,50%);pointer-events:none;line-height:0}.scb-row:last-child .scb-cross{display:none}
  .scb-content h3{margin:0 0 1.25rem;color:#111827;font:500 2.25rem/1.02 var(--font-heading);letter-spacing:-.02em}.scb-content p{margin:0;color:#4b5563;font:400 1.125rem/1.45 var(--font-body)}
  @keyframes scb-shot-breathe{0%,100%{transform:translateY(3px) scale(.985)}50%{transform:translateY(-3px) scale(1)}}@keyframes scb-card-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-9px,0)}}
  @media(prefers-reduced-motion:reduce){.scb-shot img,.scb-float{animation:none;will-change:auto}.scb-visual:hover .scb-shot img{transform:none}}
  @media(max-width:900px){.scb-row{display:flex;flex-direction:column}.scb-cell{padding:3rem 1.5rem}.scb-row .scb-content{order:1;border-right:0;border-bottom:1px solid #e5e7eb}.scb-row .scb-visual{order:2;border-right:0}.scb-content h3{font-size:clamp(1.85rem,7vw,2.25rem)}}
  @media(max-width:520px){.scb-section{padding-inline:16px}.scb-header{margin-bottom:40px}.scb-shot{padding:24px 12px}.scb-float{padding:9px 11px}.scb-float b{font-size:.7rem}.scb-float small{font-size:.6rem}}
</style>
