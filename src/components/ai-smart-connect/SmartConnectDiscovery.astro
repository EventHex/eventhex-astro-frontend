  .scd-directory-shot{position:relative;z-index:2;display:block;width:min(82%,430px);height:auto;border:1px solid #dce3ee;border-radius:15px;background:#fff;box-shadow:0 22px 46px rgba(38,66,105,.18);animation:scd-screen-breathe 7s ease-in-out infinite;will-change:transform}.scd-orbit{position:absolute;z-index:0;border:1px solid rgba(55,93,251,.22);border-radius:50%;animation:scd-orbit-pulse 5s ease-in-out infinite}.scd-orbit--one{width:330px;height:330px}.scd-orbit--two{width:430px;height:430px;animation-delay:-2.5s}.scd-chip{position:absolute;z-index:3;display:flex;align-items:center;gap:8px;padding:11px 14px;border:1px solid rgba(210,218,234,.94);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 16px 34px rgba(39,57,104,.17);color:#111827;font-family:var(--font-body);animation:scd-chip-float 4.5s ease-in-out infinite;backdrop-filter:blur(10px)}.scd-chip b{font-size:11px;white-space:nowrap}.scd-chip small{color:#7a8496;font-size:9px;white-space:nowrap}.scd-chip i{width:8px;height:8px;border-radius:50%;background:#19b874;box-shadow:0 0 0 5px rgba(25,184,116,.13)}.scd-chip--top{top:28px;right:18px;flex-direction:column;align-items:flex-start;gap:3px}.scd-chip--bottom{bottom:28px;left:18px;flex-direction:column;align-items:flex-start;gap:3px;animation-delay:-2.2s}
