<style>
  .scd-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 64px 24px 40px;
    background: #fff;
  }
  .scd-flow__header {
    display: flex;
    max-width: 1100px;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
    text-align: center;
  }
  .scd-flow__header h2 {
    margin: 0 0 12px;
    background: linear-gradient(98deg, var(--heading-dark, #1e1d24) 43.06%, #8f8f8f 91.81%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font: 500 clamp(28px, 4.2vw, 48px)/1.1 var(--font-heading);
    letter-spacing: -.04em;
  }
  .scd-flow__header p {
    max-width: 640px;
    margin: 0;
    color: var(--subheading-gray, #555);
    font: 400 18px/1.5 var(--font-body);
  }
  .scd-flow__quad {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    width: 100%;
    max-width: 1180px;
    margin: 24px auto;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }
  .scd-flow__cell {
    min-height: 260px;
    padding: 56px 48px;
  }
  .scd-flow__cell h3 {
    margin: 0 0 16px;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.1;
  }
  .scd-flow__cell p { max-width: 40ch; line-height: 1.6; }
  .scd-flow__cell--media { min-height: 360px; padding: 18px 22px; background: #fff; }
  .scd-preview-stage { height: 320px; min-height: 0; border-radius: 0; }
  .scd-flow__cell--directory {
    min-height: 360px;
    padding: 18px 22px;
    background: #fff;
  }
  .scd-directory-composite {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: visible;
  }
  .scd-directory-composite__screen {
    position: absolute;
    display: block;
    object-fit: cover;
    object-position: top left;
    border: 1px solid rgba(209, 214, 226, 0.92);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 16px 34px rgba(31, 41, 72, 0.14);
  }
  .scd-directory-composite__screen--primary { top: 42px; left: 20px; z-index: 1; width: 74%; height: 62%; }
  .scd-directory-composite__screen--secondary { right: 18px; bottom: 20px; z-index: 2; width: 64%; height: 52%; }
  .scd-directory-composite__screen--detail { left: 24px; bottom: 12px; z-index: 3; width: 30%; height: 48%; }
  .scd-directory-composite__status,
  .scd-directory-composite__action {
    position: absolute;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    white-space: nowrap;
    font: 700 11px/1 var(--font-body);
    box-shadow: 0 10px 24px rgba(31, 41, 72, 0.16);
  }
  .scd-directory-composite__status {
    top: 14px;
    left: 14px;
    gap: 7px;
    padding: 9px 11px;
    border: 1px solid #cfead9;
    background: #effbf4;
    color: #18864b;
  }
  .scd-directory-composite__status svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .scd-directory-composite__action { right: 14px; bottom: 14px; padding: 10px 13px; background: #4b65f6; color: #fff; }
  .scd-directory-composite__cursor {
    position: absolute;
    right: 4px;
    bottom: 34px;
    z-index: 6;
    width: 22px;
    height: 26px;
    filter: drop-shadow(0 3px 3px rgba(17, 24, 39, 0.25));
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .scd-flow { padding: 60px 16px; }
    .scd-flow__header { margin-bottom: 24px; }
    .scd-flow__quad { grid-template-columns: 1fr; margin: 24px auto; }
    .scd-flow__cell { min-height: 0; padding: 32px 20px; }
    .scd-flow__cell--directory { min-height: 360px; padding: 16px 20px 32px; }
    .scd-flow__cell--recommendation { min-height: 360px; padding: 16px 20px 32px; }
    .scd-preview-stage { height: 285px; }
  }
</style>
