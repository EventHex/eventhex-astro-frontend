  .scd-flow__cell--directory{min-height:360px;padding:18px 22px;background:#fff}.scd-directory-composite{position:relative;width:100%;height:320px;overflow:visible}.scd-directory-composite__screen{position:absolute;display:block;object-fit:cover;object-position:top left;border:1px solid rgba(209,214,226,.92);border-radius:12px;background:#fff;box-shadow:0 16px 34px rgba(31,41,72,.14)}.scd-directory-composite__screen--primary{top:42px;left:20px;z-index:1;width:74%;height:62%}.scd-directory-composite__screen--secondary{right:18px;bottom:20px;z-index:2;width:64%;height:52%}.scd-directory-composite__screen--detail{left:24px;bottom:12px;z-index:3;width:30%;height:48%}.scd-directory-composite__status,.scd-directory-composite__action{position:absolute;z-index:5;display:inline-flex;align-items:center;border-radius:10px;white-space:nowrap;font:700 11px/1 var(--font-body);box-shadow:0 10px 24px rgba(31,41,72,.16)}.scd-directory-composite__status{top:14px;left:14px;gap:7px;padding:9px 11px;border:1px solid #cfead9;background:#effbf4;color:#18864b}.scd-directory-composite__status svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}.scd-directory-composite__action{right:14px;bottom:14px;padding:10px 13px;background:#4b65f6;color:#fff}.scd-directory-composite__cursor{position:absolute;right:4px;bottom:34px;z-index:6;width:22px;height:26px;filter:drop-shadow(0 3px 3px rgba(17,24,39,.25));pointer-events:none}
