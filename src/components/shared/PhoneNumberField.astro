---
interface Props {
  codeName: string;
  phoneName: string;
  required?: boolean;
  defaultCode?: string;
}

const {
  codeName,
  phoneName,
  required = false,
  defaultCode = "+91",
} = Astro.props;

const codeListId = `${codeName}-suggestions`;
---

<fieldset class="ehf-phone-field">
  <legend>Phone number{required ? " *" : ""}</legend>
  <div class="ehf-phone-field__control">
    <input
      class="ehf-phone-field__code"
      type="tel"
      name={codeName}
      value={defaultCode}
      list={codeListId}
      inputmode="tel"
      autocomplete="tel-country-code"
      aria-label="Country code"
      pattern="[+][0-9]{1,4}"
      title="Enter a country code such as +91"
      required={required}
    />
    <span class="ehf-phone-field__divider" aria-hidden="true"></span>
    <input
      class="ehf-phone-field__number"
      type="tel"
      name={phoneName}
      inputmode="tel"
      autocomplete="tel-national"
      aria-label="Phone number"
      placeholder="Phone number"
      required={required}
    />
  </div>
  <datalist id={codeListId}>
    <option value="+91">India</option>
    <option value="+971">United Arab Emirates</option>
    <option value="+973">Bahrain</option>
    <option value="+966">Saudi Arabia</option>
    <option value="+974">Qatar</option>
    <option value="+965">Kuwait</option>
    <option value="+968">Oman</option>
    <option value="+1">United States / Canada</option>
    <option value="+44">United Kingdom</option>
    <option value="+60">Malaysia</option>
    <option value="+65">Singapore</option>
    <option value="+61">Australia</option>
    <option value="+49">Germany</option>
    <option value="+33">France</option>
  </datalist>
</fieldset>

<style>
  .ehf-phone-field {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ehf-phone-field legend {
    margin-bottom: 6px;
    padding: 0;
    color: #525866;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
  }

  .ehf-phone-field__control {
    display: grid;
    grid-template-columns: 78px 1px minmax(0, 1fr);
    align-items: center;
    min-width: 0;
    border: 1px solid #e8ecf2;
    border-radius: 10px;
    background: #ffffff;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .ehf-phone-field__control:focus-within {
    border-color: #375dfb;
    box-shadow: 0 0 0 3px rgba(55, 93, 251, 0.14);
  }

  .ehf-phone-field__code,
  .ehf-phone-field__number {
    width: 100%;
    min-width: 0;
    padding: 12px 14px;
    border: 0;
    outline: 0;
    background: transparent;
    color: #22272f;
    font-family: var(--font-body);
    font-size: 15px;
    box-sizing: border-box;
  }

  .ehf-phone-field__code {
    padding-right: 8px;
    font-weight: 650;
  }

  .ehf-phone-field__number {
    padding-left: 12px;
  }

  .ehf-phone-field__number::placeholder {
    color: #868c98;
  }

  .ehf-phone-field__divider {
    width: 1px;
    height: 24px;
    background: #e2e4e9;
  }
</style>
