---
interface Props { title?: string; buttonText?: string; href?: string }
const { title = "Begin Your Journey With EventHex Now!", buttonText = "Get a demo", href = "/book-a-demo/" } = Astro.props;
---

<section class="shared-cta">
  <div class="shared-cta__banner">
    <div class="shared-cta__glow" aria-hidden="true"></div>
    <div class="shared-cta__left">
      <span class="shared-cta__pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Trusted Event Platform
      </span>
      <h2>{title}</h2>
      <p>All your ticketing, agenda, and attendee data in one secure platform.</p>
      <a href={href}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {buttonText}
      </a>
    </div>
    <div class="shared-cta__right">
      <img src="/feature-images/footer-cta-devices.webp" alt="EventHex platform on laptop, tablet, and mobile" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .shared-cta { max-width: 1280px; margin: 80px auto; padding: 0 24px; position: relative; z-index: 1; }
  .shared-cta__banner { min-height: 480px; display: flex; align-items: stretch; position: relative; overflow: hidden; border: 1px solid rgba(172,161,241,.2); border-radius: 30px; background: #0d0a2c; }
  .shared-cta__glow { position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(at 0% 100%, hsl(220 100% 48% / .55) 0px, transparent 46%), radial-gradient(at 15% 85%, hsl(220 100% 50% / .3) 0px, transparent 42%), radial-gradient(at 88% 12%, hsl(265 90% 58% / .3) 0px, transparent 45%), radial-gradient(at 55% 45%, hsl(250 70% 25% / .3) 0px, transparent 55%); background-position: center center; background-repeat: no-repeat; background-size: cover; }
  .shared-cta__left { position: relative; z-index: 1; flex: 0 0 52%; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 20px; padding: 56px 24px 56px 56px; }
  .shared-cta__pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(255,255,255,.08); color: #e8ebe6; font: 500 13px var(--font-body); }
  .shared-cta h2 { max-width: 92%; margin: 0; color: #fff; font-family: "Creato Display",var(--font-heading); font-size: 44px; font-weight: 600; line-height: 1.14; letter-spacing: -1px; }
  .shared-cta p { max-width: 85%; margin: 0; color: rgba(255,255,255,.68); font: 400 16px/1.5 var(--font-body); }
  .shared-cta a { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; padding: 12px 24px; border-radius: 10px; background: #fff; color: #06120a; font: 600 15px/24px var(--font-body); letter-spacing: -.48px; text-decoration: none; transition: transform .3s ease; }
  .shared-cta a:hover { transform: scale(1.05); }
  .shared-cta__right { position: relative; z-index: 1; flex: 0 0 48%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .shared-cta__right img { display: block; width: 100%; max-width: 640px; height: auto; }
  @media (max-width: 1024px) {
    .shared-cta__banner { min-height: 420px; }
    .shared-cta__left { padding: 40px 24px 40px 40px; }
    .shared-cta h2 { font-size: 30px; line-height: 1.2; }
    .shared-cta__right img { max-width: 420px; }
  }
  @media (max-width: 767px) {
    .shared-cta { margin: 60px auto; padding: 0 16px; }
    .shared-cta__banner { min-height: 0; border-radius: 24px; }
    .shared-cta__left { z-index: 2; flex: 1 1 100%; width: 100%; padding: 78px 100px 32px 20px; }
    .shared-cta__pill { position: absolute; top: 24px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 12px; padding: 6px 14px; }
    .shared-cta__right { position: absolute; inset: 0 0 0 auto; width: 34%; justify-content: flex-start; overflow: visible; }
    .shared-cta__right img { width: 460px; max-width: none; }
    .shared-cta h2 { max-width: 100%; font-size: 24px; line-height: 1.25; }
    .shared-cta p { max-width: 24ch; line-height: 1.3; }
    .shared-cta a { padding: 10px 18px; font-size: 14px; }
  }
</style>
