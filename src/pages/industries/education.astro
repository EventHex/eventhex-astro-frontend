---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import EducationPage from "../../components/industries/EducationPage.astro";

const title = "Education Event Management Software | EventHex";
const description = "Run academic conferences, university open days, graduation-related events, and student hackathons with connected submissions, sessions, registration, communication, engagement, badges, and check-in.";
const faqs: [string, string][] = [
  ["Can EventHex manage academic submissions?", "Yes. Use the Call for Papers workflow for configured submissions, reviewer assignment, rubric scoring, decisions, and programme handoff."],
  ["Can different campus audiences use different registration paths?", "Use ticket types, custom or ticket-specific fields, approvals, and access rules to configure the event journey."],
  ["Does EventHex manage academic credits?", "No. EventHex does not manage academic credits; event certificates should not be used as evidence of credit or accreditation."],
  ["Can we run live questions and polls?", "Yes. Use the multiple-choice polling, anonymous access where configured, spotlight, and feedback mechanisms."],
  ["Can we manage graduation seating?", "No. EventHex does not provide a graduation seating-plan workflow."],
];
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Education Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/education/",
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Academic submissions", "Programme and speaker management", "Registration", "Live polling", "Badges and check-in"],
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/education/"
  footerCtaEyebrow="Configuration review"
  footerCtaTitle="Plan your next education event"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <EducationPage {faqs} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</MarketingLayout>
