---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import MiddleEastPage from "../../components/industries/MiddleEastPage.astro";

const title = "Middle East & GCC Event Management Software | EventHex";
const description =
  "Run GCC summits, MENA conferences, exhibitions, corporate events, and technology events with market-aware payment choices, WhatsApp-ready communication.";

const faqs: [string, string][] = [
  [
    "Does EventHex support local GCC payment methods?",
    "Tap Payments is a supported gateway path. Actual methods, currencies, account eligibility, fees, and settlement depend on provider and market configuration.",
  ],
  [
    "Can we use WhatsApp for attendee communication?",
    "Yes, through supported workflows after the required official account, sender, and approved-template setup is ready.",
  ],
  [
    "Is every EventHex surface fully Arabic and RTL?",
    "EventHex does not promise universal Arabic and RTL coverage. Validate the exact organizer, website, registration, email, WhatsApp, app, badge, and invoice surfaces required.",
  ],
  [
    "Can the scanner work offline?",
    "The EventHex Scanner workflow supports offline-resilient capture; validate the venue operating plan before launch.",
  ],
  [
    "Does EventHex automate VIP or diplomatic protocol?",
    "No. EventHex does not include a diplomatic-protocol or hierarchy workflow.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Middle East and GCC Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/middle-east/",
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Configurable registration, tickets, and attendee journeys",
    "Supported payment gateway connections",
    "Supported email and WhatsApp communication workflows",
    "Badges and offline-resilient QR check-in",
    "Event and attendance reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/middle-east/"
  ogImage="https://eventhex.ai/images/industries/technology/event-dashboard-web-800.webp"
  footerCtaEyebrow="Plan the configuration"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <MiddleEastPage {faqs} />
</MarketingLayout>
