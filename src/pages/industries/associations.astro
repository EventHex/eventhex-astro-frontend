---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import AssociationsPage from "../../components/industries/AssociationsPage.astro";

const title = "Associations Event Management Software | EventHex";
const description =
  "Run association conferences, chapter events, awards, and trade shows with configurable registration, ticket rules, sponsors, exhibitors, communications.";

const faqs: [string, string][] = [
  [
    "Does EventHex replace an association membership database?",
    "No. EventHex covers event operations. Represent member-related event access through configured fields, ticket rules, approvals, discounts, or a separately reviewed integration.",
  ],
  [
    "Can chapters run separate events?",
    "Yes. Use separate event workspaces and the centralized dashboard for multi-event visibility and selective cloning.",
  ],
  [
    "Can we offer different ticket prices?",
    "Yes. Configure ticket types, sale windows, purchase limits, automatic discounts, and coupons for the event.",
  ],
  [
    "Can sponsors and exhibitors have separate workflows?",
    "Yes. Sponsor presentation and exhibitor application, portal, team, pass, and lead workflows have separate feature owners.",
  ],
  [
    "Can we use past event audiences for campaigns?",
    "Yes. Event Marketing can build supported email or WhatsApp audiences from current and previous registration data.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Associations Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/associations/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Configurable event registration and ticket rules",
    "Programme and speaker coordination",
    "Sponsor and exhibitor workflows",
    "Event communications and attendee engagement",
    "QR check-in and attendance context",
    "Multi-event portfolio visibility",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/associations/"
  footerCtaEyebrow="Plan your next associations event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <AssociationsPage {faqs} />
</MarketingLayout>
