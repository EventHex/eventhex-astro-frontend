---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import TechnologyPage from "../../components/industries/TechnologyPage.astro";

const faqs = [
  ["Can EventHex support multi-track technology conferences?", "Yes. Use Session Management for speakers, time, room, capacity, and track-aware programme discovery."],
  ["Does AI Smart-Connect automatically schedule meetings?", "No. It can surface relevant recommendations and supports participant-controlled connection and meeting handoffs."],
  ["Can we run live audience participation?", "EventHex supports polling, anonymous access where configured, spotlight, and session feedback."],
  ["Can attendees receive session recaps?", "Use the supported AI Session Recap workflow for eligible live transcription and recap outputs; review the exact delivery path in a demo."],
  ["Can a small meetup use the same platform?", "Yes. Start with registration, a simple agenda, communication, and check-in, then add modules only when the format needs them."],
];

const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<MarketingLayout
  title="Technology Event Management Software | EventHex"
  description="Build multi-track conferences, developer summits, SaaS launches, hackathons, and meetups with connected registration, sessions, networking, live participation, and recaps."
  canonical="https://eventhex.ai/industries/technology/"
  footerCtaTitle="Plan your next technology event"
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqSchema)} /></Fragment>
  <TechnologyPage faqs={faqs} />
</MarketingLayout>
