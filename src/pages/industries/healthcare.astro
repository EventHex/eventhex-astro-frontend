---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import HealthcarePage from "../../components/industries/HealthcarePage.astro";

const title = "Healthcare Event Management Software | EventHex";
const description =
  "Move medical congresses, healthcare conferences, pharma summits, and health-technology expos from submissions to programme, registration, badges.";

const faqs: [string, string][] = [
  [
    "Can EventHex manage abstract submissions and peer review?",
    "Yes. Call for Papers supports configured submissions, reviewer assignment, rubric scoring, decisions, and programme handoff.",
  ],
  [
    "Does EventHex calculate or certify CME or CE credits?",
    "No. EventHex does not calculate or certify CME or CE credits; keep accreditation in the system responsible for it.",
  ],
  [
    "Can we collect additional delegate information?",
    "Yes. Configure custom and ticket-specific fields in the selected registration journey.",
  ],
  [
    "Can accepted work become sessions?",
    "Yes. The workflow can push accepted submissions into the programme for session and speaker coordination.",
  ],
  [
    "Can teams scan delegates onsite?",
    "Yes. EventHex Scanner supports QR arrival validation with offline-resilient capture and live attendance context.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Healthcare Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/healthcare/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Abstract submissions and review",
    "Programme and speaker coordination",
    "Delegate registration",
    "Badges and QR check-in",
    "Attendance and event reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/healthcare/"
  footerCtaEyebrow="Plan your next healthcare event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <HealthcarePage {faqs} />
</MarketingLayout>
