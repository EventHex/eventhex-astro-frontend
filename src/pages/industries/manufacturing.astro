---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ManufacturingPage from "../../components/industries/ManufacturingPage.astro";

const title = "Manufacturing Event Management Software | EventHex";
const description =
  "Run industrial trade fairs, supply-chain summits, manufacturing conferences, and machinery expos with exhibitor portals, attendee access, badges, and lead capture.";

const faqs: [string, string][] = [
  [
    "Can exhibitors manage products, resources, and teams?",
    "Yes. The portal includes those records plus allocated passes and badge workflows.",
  ],
  [
    "Can teams capture and qualify leads onsite?",
    "Yes. Use QR or manual capture, supported qualification detail, team visibility, and CSV export.",
  ],
  [
    "Does EventHex design expo booth layouts?",
    "No. EventHex does not include a floor-plan or booth-layout designer.",
  ],
  [
    "Can leads be routed automatically to sales teams?",
    "Automated lead scoring and routing are not included. Use exports or a separately reviewed integration workflow.",
  ],
  [
    "Does EventHex replace supply-chain software?",
    "No. It supports event operations for supply-chain and manufacturing audiences.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Manufacturing Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/manufacturing/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Exhibitor portal and team workflows",
    "Configurable registration and attendee access",
    "B2B appointments and networking",
    "QR and manual lead capture",
    "QR check-in and attendance",
    "Event and portfolio reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/manufacturing/"
  footerCtaEyebrow="Plan your next manufacturing event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <ManufacturingPage {faqs} />
</MarketingLayout>
