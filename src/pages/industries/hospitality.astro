<script>
  const hospitalityFaqs = Array.from(document.querySelectorAll<HTMLDetailsElement>(".hsp-faq details"));
  hospitalityFaqs.forEach((item) => { item.addEventListener("toggle", () => { if (!item.open) return; hospitalityFaqs.forEach((other) => { if (other !== item) other.open = false; }); }); });

  const eventDayDetails = Array.from(document.querySelectorAll<HTMLDetailsElement>(".hsp-day__steps details"));
  eventDayDetails.forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".hsp-day__arrow");
    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });
    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} event-day feature`);
      if (!item.open) return;
      all.forEach((other) => { if (other !== item) other.open = false; });
    });
  });

  const linksSuite = document.querySelector<HTMLElement>(".hsp-links");
  if (linksSuite) {
    const tabs = Array.from(linksSuite.querySelectorAll<HTMLButtonElement>(".hsp-links__tab"));
    const panels = Array.from(linksSuite.querySelectorAll<HTMLElement>(".hsp-links__panel"));
    let linksRotationId: number | undefined;
    const activateLinksTab = (tab: HTMLButtonElement) => {
      const targetId = tab.getAttribute("data-target");
      tabs.forEach((item) => { item.classList.remove("hsp-links__tab--active"); item.setAttribute("aria-selected", "false"); });
      panels.forEach((panel) => { panel.classList.remove("hsp-links__panel--active"); });
      tab.classList.add("hsp-links__tab--active");
      tab.setAttribute("aria-selected", "true");
      linksSuite.querySelector<HTMLElement>(`#hsp-links-panel-${targetId}`)?.classList.add("hsp-links__panel--active");
    };
    const stopLinksRotation = () => { if (linksRotationId === undefined) return; window.clearInterval(linksRotationId); linksRotationId = undefined; };
    const startLinksRotation = () => {
      stopLinksRotation();
      if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      linksRotationId = window.setInterval(() => {
        const currentIndex = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateLinksTab(tabs[(currentIndex + 1) % tabs.length]);
      }, 4000);
    };
    tabs.forEach((tab) => { tab.addEventListener("click", () => { activateLinksTab(tab); startLinksRotation(); }); });
    linksSuite.addEventListener("mouseenter", stopLinksRotation);
    linksSuite.addEventListener("mouseleave", startLinksRotation);
    linksSuite.addEventListener("focusin", stopLinksRotation);
    linksSuite.addEventListener("focusout", (event) => { if (!(event.relatedTarget instanceof Node) || !linksSuite.contains(event.relatedTarget)) startLinksRotation(); });
    document.addEventListener("visibilitychange", () => { document.hidden ? stopLinksRotation() : startLinksRotation(); });
    startLinksRotation();
  }

  const workflowStack = document.querySelector<HTMLElement>(".hsp-workflow-stack");
  const workflowStackHeader = workflowStack?.querySelector<HTMLElement>(".hsp-workflow-stack__header");
  const workflowStackCards = workflowStack?.querySelectorAll<HTMLElement>(".hsp-workflow-stack__card");
  const workflowStackFinalCard = workflowStackCards?.[workflowStackCards.length - 1];
  if (workflowStackHeader && workflowStackFinalCard) {
    let workflowStackFrame = 0;
    const syncWorkflowStackRelease = () => {
      workflowStackFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(workflowStackFinalCard).top) || 0;
      const releaseOffset = Math.min(0, workflowStackFinalCard.getBoundingClientRect().top - stickyTop);
      workflowStackHeader.style.setProperty("--hsp-stack-release-y", `${releaseOffset}px`);
      workflowStackHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueWorkflowStackRelease = () => {
      if (workflowStackFrame) return;
      workflowStackFrame = requestAnimationFrame(syncWorkflowStackRelease);
    };
    window.addEventListener("scroll", queueWorkflowStackRelease, { passive: true });
    window.addEventListener("resize", queueWorkflowStackRelease, { passive: true });
    syncWorkflowStackRelease();
  }
</script>
