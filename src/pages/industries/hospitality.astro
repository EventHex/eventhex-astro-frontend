---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "Hospitality Event Management Software | EventHex";
const description =
  "Run hotel conferences, tourism summits, F&B trade shows, and hospitality awards with event websites, registration, exhibitors, partners, programme, communication, badges, and analytics.";
const canonical = "https://eventhex.ai/industries/hospitality/";

const workflow = [
  { label: "Brand", detail: "Website + identity" },
  { label: "Invite", detail: "Guests + partners" },
  { label: "Register", detail: "Fields + tickets" },
  { label: "Present", detail: "Exhibitors + programme" },
  { label: "Host", detail: "Badges + updates" },
  { label: "Review", detail: "Event signals" },
];

const eventModel = [
  {
    tag: "Primary model",
    title: "Exhibition-led event",
    copy: "Connect exhibitor setup, passes, lead capture, attendee access, and event reporting.",
    primaryImage: "/images/platform-analytics-dashboard.jpg",
    primaryAlt: "EventHex analytics dashboard for exhibition operations",
    secondaryImage: "/feature-images/hospitality/platform-analytics-dashboard.png",
    secondaryAlt: "EventHex analytics view for exhibition event trends",
    detailImage: "/images/platform-analytics-dashboard.jpg",
  },
  {
    tag: "Alternate model",
    title: "Conference-led event",
    copy: "Use registration, programme, speakers, meetings, and communications without adding expo complexity.",
    primaryImage: "/feature-images/session-management/timeline-view.jpeg",
    primaryAlt: "EventHex programme timeline for a conference-led event",
    secondaryImage: "/feature-images/speaker-management/session-scheduling-dashboard.png",
    secondaryAlt: "EventHex agenda and sessions screen for conference planning",
    detailImage: "/feature-images/session-management/detail-panel.png",
    detailAlt: "EventHex selected session details for a conference programme",
  },
];

const coreFeatures = [
  { title: "Branded event website", copy: "Publish the event, programme, partners, and registration entry points in a consistent EventHex site.", link: "/event-website-builder/" },
  { title: "Guest registration", copy: "Configure forms, ticket types, approvals, discounts, and delivery for the audience.", link: "/event-registration/" },
  { title: "Exhibitors and sponsors", copy: "Manage partner records, exhibitor teams, passes, resources, and leads.", link: "/exhibitor-management/" },
  { title: "Event experience", copy: "Connect app, notifications, badges, QR arrival, photos, and event analytics where needed.", link: "/event-mobile-app/" },
];

const hospitalityWorkflowFeatures = [
  {
    eyebrow: "Connected workflow",
    title: "One event record, from invite to review",
    copy: "Bring the audience, programme, partners, and operations into a workflow teams can understand. Keep the exhibitor journey attached to the attendee journey as the event changes.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex platform analytics dashboard showing connected event activity",
    link: "/book-a-demo/",
  },
  {
    title: "Branded event website",
    copy: "Publish the event, programme, partners, and registration entry points in a consistent EventHex site.",
    image: "/feature-images/event-registration/website-embed.png",
    alt: "EventHex website mode settings for a branded hospitality event website",
    link: "/event-website-builder/",
  },
  {
    title: "Guest registration",
    copy: "Configure forms, ticket types, approvals, discounts, and delivery for the audience.",
    image: "/feature-images/event-registration-dashboard.png",
    alt: "EventHex registration dashboard for hospitality event guests",
    link: "/event-registration/",
  },
  {
    title: "Exhibitors and sponsors",
    copy: "Manage partner records, exhibitor teams, passes, resources, and leads.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex platform analytics view for exhibitor and sponsor activity",
    link: "/exhibitor-management/",
  },
  {
    title: "Event experience",
    copy: "Connect app, notifications, badges, QR arrival, photos, and event analytics where needed.",
    image: "/feature-images/solutions/events-activities-laptop-mockup.png",
    alt: "EventHex event experience dashboard for hospitality attendees",
    link: "/event-mobile-app/",
  },
];

const roles = [
  {
    title: "Event owner",
    cue: "Accountable",
    copy: "Sets the event, audience, access, programme, and reporting decisions.",
    accent: "#375dfb",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16"></path><path d="M6 21V8l6-4 6 4v13"></path><path d="M9 21v-5h6v5"></path><path d="M9 10h.01M15 10h.01"></path></svg>`,
  },
  {
    title: "Specialist teams",
    cue: "Operational",
    copy: "Work in focused registration, programme, exhibitor, marketing, check-in, or analytics areas.",
    accent: "#375dfb",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
  },
  {
    title: "Event leadership",
    cue: "Decision",
    copy: "Reviews event and portfolio signals for the next operating decision.",
    accent: "#375dfb",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 15 4-4 3 3 6-7"></path><path d="M17 7h3v3"></path></svg>`,
  },
];

const journey = [
  ["Discover", "Open with the hospitality event's own brand and programme."],
  ["Register", "Collect configured guest and ticket details."],
  ["Prepare", "Send planned campaigns and operational updates."],
  ["Arrive", "Validate access and issue the configured badge."],
  ["Participate", "Use agenda, app, networking, polling, and photos as relevant."],
  ["Review", "Use supported event and exhibitor reporting after the event."],
];

const journeyVisuals = [
  { image: "/feature-images/hospitality/platform-analytics-dashboard.png", alt: "EventHex platform analytics dashboard showing hospitality event activity", width: 1262, height: 697 },
  { image: "/feature-images/event-registration-dashboard.png", alt: "EventHex registration dashboard for hospitality event guests", width: 512, height: 459 },
  { image: "/feature-images/event-registration/confirmation-delivery.png", alt: "EventHex WhatsApp campaigns screen for sending hospitality event updates", width: 762, height: 696 },
  { image: "/feature-images/event-check-in/scan-engine-figma.png", alt: "EventHex QR check-in screen confirming a hospitality event attendee", width: 512, height: 422 },
  { image: "/feature-images/session-management/agenda-card-visual.svg", alt: "EventHex event agenda and session engagement view for attendees", width: 672, height: 584 },
  { image: "/feature-images/speaker-management/audience-engagement-dashboard.png", alt: "EventHex event feedback dashboard for post-event review", width: 762, height: 696 },
];

const eventDaySteps = [
  {
    num: "01",
    title: "Guest arrival",
    desc: "Scan the EventHex ticket and show clear status feedback.",
    bullets: ["Fast QR validation", "Clear access status", "Arrival stays on the event record"],
    image: "/feature-images/event-check-in/scan-engine-visual.png",
    alt: "EventHex QR check-in screen showing a guest access status",
    width: 240,
    height: 197,
  },
  {
    num: "02",
    title: "Exhibitor teams",
    desc: "Use allocated passes, badges, and lead capture.",
    bullets: ["Team passes in one place", "Badge-ready guest details", "Lead capture for exhibitors"],
    image: "/feature-images/hospitality/platform-analytics-dashboard.png",
    alt: "EventHex platform analytics dashboard for exhibitor team activity and event reporting",
    width: 1262,
    height: 697,
  },
  {
    num: "03",
    title: "Programme updates",
    desc: "Keep sessions and operational app announcements current.",
    bullets: ["Live agenda changes", "Operational announcements", "One connected event workspace"],
    image: "/feature-images/solutions/events-activities-laptop-mockup.png",
    alt: "EventHex event activities and programme workspace on a laptop",
    width: 255,
    height: 215,
  },
  {
    num: "04",
    title: "Photo discovery",
    desc: "Use the attendee selfie/face-match gallery flow where approved.",
    bullets: ["Attendee photo discovery", "Mobile-first event experience", "Share moments after arrival"],
    image: "/feature-images/ai-photo-gallery/selfie-match-visual.svg",
    alt: "EventHex AI photo gallery selfie-match experience for attendee photo discovery",
    width: 775,
    height: 812,
  },
];

const formats = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V9l7-5 7 5v12"></path><path d="M9 21v-5h6v5"></path><path d="M9 10h.01M15 10h.01"></path></svg>`,
    title: "Hotel conferences",
    copy: "Connect branded registration, programme, guest communication, and arrival.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18"></path><path d="M12 3a14 14 0 0 0 0 18"></path></svg>`,
    title: "Tourism summits",
    copy: "Coordinate speakers, partners, delegates, networking, and event reporting.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V8h14v13"></path><path d="M3 8h18"></path><path d="M7 8V5h10v3"></path><path d="M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"></path></svg>`,
    title: "F&B trade shows",
    copy: "Manage exhibitors, team access, attendee tickets, leads, and event-day updates.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"></path></svg>`,
    title: "Hospitality awards",
    copy: "Keep nominations in the responsible system; use EventHex for the event, guests, programme, badges, and communication.",
  },
];

const deepLinks = [
  ["Event Website Builder", "Create the event destination.", "/event-website-builder/"],
  ["Exhibitor Management", "Coordinate exhibitors and leads.", "/exhibitor-management/"],
  ["Sponsor Management", "Present event partners.", "/sponsor-management/"],
  ["Badge & Certificate Designer", "Prepare event outputs.", "/badge-certificate-designer/"],
];

const deepLinkVisuals = [
  {
    id: "website",
    label: "Event Website Builder",
    title: "Shape the hospitality event destination",
    description: "Publish the event identity, programme, partners, and registration entry points in one branded surface.",
    checklist: ["Branded event destination", "Programme and partner content", "Registration entry point"],
    image: "/feature-images/solutions/event-builder-laptop-mockup.png",
    alt: "EventHex event website builder laptop mockup for a hospitality event",
    width: 512,
    height: 355,
  },
  {
    id: "exhibitors",
    label: "Exhibitor Management",
    title: "Keep exhibitor operations connected",
    description: "Coordinate partner records, team access, resources, lead capture, and the event-day handoff.",
    checklist: ["Exhibitor teams and passes", "Partner resources", "Lead capture and reporting"],
    image: "/feature-images/hospitality/exhibitor-add-form.png",
    alt: "EventHex exhibitor setup form for company, category, and booth details",
    width: 800,
    height: 1020,
  },
  {
    id: "sponsors",
    label: "Sponsor Management",
    title: "Present partners with the event context",
    description: "Give sponsors a clear place in the event story while keeping their delivery and reporting connected.",
    checklist: ["Partner visibility", "Sponsor-ready event content", "Connected event reporting"],
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex analytics reference dashboard for sponsor and partner reporting",
    width: 1262,
    height: 697,
  },
  {
    id: "badges",
    label: "Badge & Certificate Designer",
    title: "Prepare the outputs guests carry",
    description: "Turn configured guest data into badges and event outputs that are ready for arrival and follow-up.",
    checklist: ["Configured badge details", "Event-ready output design", "Guest record stays connected"],
    image: "/feature-images/solutions/badge-management-mockup.png",
    alt: "EventHex badge management mockup for hospitality event credentials",
    width: 615,
    height: 512,
  },
];

const setupSteps = [
  ["Start with the event format", "Choose the smallest workflow that matches this event."],
  ["Add only the modules you need", "Use the connected feature pages to understand each mechanism."],
  ["Review the setup in the demo", "Bring market, event, audience, access, communication, and onsite requirements."],
];

const faqs = [
  ["Can the event use its own brand?", "Use the website and branding controls documented on the Event Website Builder and White Label pages."],
  ["Can exhibitors manage teams and resources?", "Yes. The exhibitor portal covers company, products, resources, booth teams, passes, badges, and leads."],
  ["Does EventHex manage tasting entitlements?", "No. EventHex does not include a specialized F&B entitlement workflow."],
  ["Does EventHex include awards nominee management?", "No. EventHex does not include a specialized nominee-management workflow. Use EventHex for the surrounding event operations."],
  ["Is every attendee surface multilingual?", "EventHex does not promise universal multilingual coverage. Validate the exact required surfaces during the demo."],
];

const softwareSchema = {
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "EventHex Hospitality Event Management Software",
  applicationCategory: "BusinessApplication", operatingSystem: "Web", description, url: canonical,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Branded event websites", "Guest registration and ticketing", "Exhibitor and partner workflows", "Programme and speaker management", "Event-day badges and QR arrival", "Event and exhibitor reporting"],
};

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  footerCtaEyebrow="Plan Your Next Hospitality Event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaProofItems={["Branded event workflows", "Guest and exhibitor operations", "Event-day reporting"]}
  footerCtaButtonText="Book a Free Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/speaker-management/cta-illustration.svg"
  footerCtaImageAlt="EventHex event management workflow illustration with connected speaker and attendee tools"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="hsp-page">
    <section class="hsp-hero">
      <div class="hsp-hero__shell">
        <div class="hsp-hero__grid">
          <div class="hsp-hero__content">
            <div class="hsp-hero__badge animate-on-scroll" data-animation="fadeInDown">
              <span>Hospitality event management</span>
            </div>

            <h1 class="hsp-hero__title animate-on-scroll" data-animation="fadeInUp">
              <span class="hsp-hero__title-line">Build a branded guest,</span>
              <span class="hsp-hero__title-line">exhibitor, and event-day</span>
              <span class="hsp-hero__title-line">journey for hospitality</span>
              <span class="hsp-hero__title-line">events</span>
            </h1>

            <p class="hsp-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
              Run hotel conferences, tourism summits, F&amp;B trade shows, and hospitality awards with event websites, registration, exhibitors, partners, programme, communication, badges, and analytics.
            </p>

            <div class="hsp-hero__points animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 950ms" aria-label="Hospitality event workflow capabilities">
              <span class="hsp-hero__point">Branded event website + registration</span>
              <span class="hsp-hero__point">Guest, exhibitor and partner workflows</span>
              <span class="hsp-hero__point">Event-day check-in and analytics</span>
            </div>

            <div class="hsp-hero__cta animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
              <a href="/book-a-demo/" class="hsp-hero__btn hsp-hero__btn--primary">Get a Free Demo</a>
              <a href="#hsp-workflow" class="hsp-hero__btn hsp-hero__btn--secondary">See how it works</a>
            </div>
          </div>

          <div class="hsp-hero__visual animate-on-scroll" data-animation="fadeInRight">
            <div class="hsp-hero__visual-card">
              <div class="hsp-hero__visual-inner">
                <img
                  src="/images/platform-analytics-dashboard.jpg"
                  alt="EventHex platform analytics dashboard for hospitality event workflows"
                  class="hsp-hero__img"
                  width="1262"
                  height="700"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="hsp-workflow" class="hsp-workflow-strip" aria-label="Connected hospitality event workflow"><div class="hsp-workflow-strip__inner">{workflow.map((step, index) => <span class="hsp-workflow-strip__stat animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}><strong>{step.label}</strong> <span>{step.detail}</span></span>)}</div></section>

    <section class="hsp-model hsp-section">
      <div class="hsp-container">
        <div class="hsp-model__header">
          <h2>Start with the operating shape <span>that fits the event</span></h2>
          <p>Start with one model, then add only the modules the event actually needs.</p>
        </div>

        <div class="hsp-model__grid">
          {eventModel.map((model, index) => {
            const label = index === 0 ? "Exhibition operations" : "Conference operations";
            const action = index === 0 ? "Review event data" : "Review programme data";
            return (
              <div class:list={["hsp-model__row", index % 2 === 1 && "hsp-model__row--reverse"]}>
                <article class="hsp-model__cell hsp-model__cell--copy">
                  <span class="hsp-model__tag">{model.tag}</span>
                  <h3>{model.title}</h3>
                  <p>{model.copy}</p>
                </article>
                <div class="hsp-model__cell hsp-model__cell--media">
                  <div class="hsp-model__composite">
                    <img class="hsp-model__screen hsp-model__screen--primary" src={model.primaryImage} alt={model.primaryAlt} width="1262" height="700" loading="lazy" decoding="async" />
                    <img class="hsp-model__screen hsp-model__screen--secondary" src={model.secondaryImage} alt={model.secondaryAlt} width="1262" height="700" loading="lazy" decoding="async" />
                    <img class="hsp-model__screen hsp-model__screen--detail" src={model.detailImage} alt={model.detailAlt ?? ""} width="1262" height="700" loading="lazy" decoding="async" aria-hidden={model.detailAlt ? undefined : "true"} />
                    <span class="hsp-model__status">✓ {label}</span>
                    <span class="hsp-model__action">{action}</span>
                  </div>
                </div>
                <span class="hsp-model__cross" aria-hidden="true">
                  <svg width="28" height="28" viewBox="-14 -14 28 28">
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb"></path>
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="scale(1,-1)"></path>
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(90)"></path>
                    <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e5e7eb" transform="rotate(-90)"></path>
                  </svg>
                </span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="hsp-core hsp-section">
      <div class="hsp-container hsp-workflow-stack">
        <div class="hsp-workflow-stack__header">
          <div class="hsp-workflow-stack__eyebrow"><span aria-hidden="true">✦</span><span>From event setup to event-day review</span></div>
          <h2><span class="hsp-workflow-stack__title-line">Connect the exhibitor journey to the</span><span class="hsp-workflow-stack__title-line"><span>attendee journey</span></span></h2>
        </div>

        <div class="hsp-workflow-stack__cards" id="hsp-workflow-stack">
          {hospitalityWorkflowFeatures.map((feature, index) => (
            <article class="hsp-workflow-stack__card" data-card-index={index} style={`--card-index: ${index};`}>
              <div class="hsp-workflow-stack__copy">
                {feature.eyebrow && <span class="hsp-workflow-stack__tag">{feature.eyebrow}</span>}
                <h3>{feature.title}</h3>
                <p>{feature.copy}</p>
                <a href={feature.link} class="hsp-workflow-stack__button">Explore More</a>
              </div>
              <div class="hsp-workflow-stack__image">
                <img src={feature.image} alt={feature.alt} width="1262" height="700" loading="lazy" decoding="async" />
              </div>
            </article>
          ))}
          <div class="hsp-workflow-stack__spacer" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="hsp-roles hsp-section">
      <div class="hsp-container hsp-roles__inner">
        <header class="hsp-roles__header">
          <span class="hsp-kicker">Team coordination</span>
          <h2>Keep the floor team and event team aligned</h2>
          <p>Give each team a clear job while keeping the attendee and event record connected.</p>
        </header>
        <div class="hsp-roles__grid">
          {roles.slice(0, -1).map((_, index) => (
            <span class="hsp-roles__notch" style={`left: ${((index + 1) / roles.length) * 100}%`} aria-hidden="true">
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--hsp-role-line, #e8ecf2)"></path>
              </svg>
            </span>
          ))}
          {roles.map((role, index) => (
            <article class:list={["hsp-role-card", { "hsp-role-card--first": index === 0 }]} style={`--hsp-role-accent: ${role.accent}`}>
              <span class="hsp-role-card__icon" set:html={role.icon} aria-hidden="true" />
              <div class="hsp-role-card__content">
                <h3>{role.title}</h3>
                <span class="hsp-role-card__cue">{role.cue}</span>
                <p>{role.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hsp-journey hsp-section">
      <div class="hsp-container hsp-journey__container">
        <div class="hsp-journey__left">
          <div class="hsp-journey__sticky">
            <div class="hsp-journey__eyebrow">Audience experience</div>
            <h2>Connect the moments <span>attendees actually move through</span></h2>
            <p>Keep each attendee moment connected to the same hospitality event record, from discovery through post-event review.</p>
            <a class="hsp-journey__cta" href="/book-a-demo/">
              Book a Demo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
        </div>

        <div class="hsp-journey__right">
          {journey.map(([label, copy], index) => (
            <article class="hsp-journey__stack-card" style={`--hsp-journey-top: ${80 + index * 20}px`}>
              <div class="hsp-journey__stack-header">
                <div class="hsp-journey__stack-number">0{index + 1}</div>
                <div class="hsp-journey__stack-copy">
                  <h3>{label}</h3>
                  <p>{copy}</p>
                </div>
              </div>
              <div class:list={["hsp-journey__visual", `hsp-journey__visual--${index + 1}`]}>
                <img src={journeyVisuals[index].image} alt={journeyVisuals[index].alt} width={journeyVisuals[index].width} height={journeyVisuals[index].height} loading="lazy" decoding="async" />
              </div>
