---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import FinanceIndustryPage from "../../components/industries/FinanceIndustryPage.astro";

const title = "Finance Event Management Software | EventHex";
const description =
  "Run banking summits, fintech conferences, investor events, and insurance forums with configurable registration, ticketing, payment, programme, communication, check-in, and analytics.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Finance Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/industries/finance/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Configurable registration and approval workflows",
    "Ticketing and supported payment workflows",
    "Programme and session management",
    "Participant-controlled networking",
    "Badge printing and QR check-in",
    "Event analytics",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    ["Can finance events use approval-based registration?", "Yes. Configure the appropriate registration journey and approval flow for the event."],
    ["Which payment gateways are supported?", "Current paths include Stripe, Razorpay, and Tap Payments. Account eligibility, methods, currencies, fees, and settlement are provider-dependent."],
    ["Does EventHex guarantee financial-services compliance?", "No. EventHex does not provide regulatory, security, data-residency, or compliance certification through this event workflow."],
    ["Can attendees network and arrange meetings?", "Use AI Smart-Connect for participant-controlled discovery and the appointments workflow for meeting operations."],
    ["Can we track ROI?", "EventHex provides event analytics, but financial ROI and attribution are not included."],
  ].map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/finance/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/03/Untitled-design-11-1024x576.webp"
  footerCtaEyebrow="Plan your next finance event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, access rules, programme, communication channels, onsite plan, and integration needs."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <FinanceIndustryPage />
</MarketingLayout>
