<script>
  const retailFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".retail-faq-reference__item"));
  retailFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      retailFaqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const retailJourneyItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".retail-journey-workflow details"));
  retailJourneyItems.forEach((item, _, all) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".retail-journey-workflow__arrow");
    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });
    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} attendee journey step`);
      if (!item.open) return;
      all.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const retailFeatureSuite = document.querySelector<HTMLElement>(".retail-feature-suites");
  const retailFeatureTabs = Array.from(retailFeatureSuite?.querySelectorAll<HTMLButtonElement>(".retail-feature-suites__tab") ?? []);
  const retailFeaturePanels = Array.from(retailFeatureSuite?.querySelectorAll<HTMLElement>(".retail-feature-suites__panel") ?? []);
  let retailFeatureRotation: number | undefined;
  const activateRetailFeature = (tab: HTMLButtonElement) => {
    const target = tab.dataset.target;
    retailFeatureTabs.forEach((item) => {
      item.classList.toggle("retail-feature-suites__tab--active", item === tab);
      item.setAttribute("aria-selected", String(item === tab));
    });
    retailFeaturePanels.forEach((panel) => panel.classList.toggle("retail-feature-suites__panel--active", panel.dataset.panel === target));
  };
  const stopRetailFeatureRotation = () => {
    if (retailFeatureRotation === undefined) return;
    window.clearInterval(retailFeatureRotation);
    retailFeatureRotation = undefined;
  };
  const startRetailFeatureRotation = () => {
    stopRetailFeatureRotation();
    if (retailFeatureTabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    retailFeatureRotation = window.setInterval(() => {
      const currentIndex = retailFeatureTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      activateRetailFeature(retailFeatureTabs[(currentIndex + 1) % retailFeatureTabs.length]);
    }, 4000);
  };
  retailFeatureTabs.forEach((tab) => tab.addEventListener("click", () => { activateRetailFeature(tab); startRetailFeatureRotation(); }));
  retailFeatureSuite?.addEventListener("mouseenter", stopRetailFeatureRotation);
  retailFeatureSuite?.addEventListener("mouseleave", startRetailFeatureRotation);
  retailFeatureSuite?.addEventListener("focusin", stopRetailFeatureRotation);
  retailFeatureSuite?.addEventListener("focusout", (event) => { if (!(event.relatedTarget instanceof Node) || !retailFeatureSuite.contains(event.relatedTarget)) startRetailFeatureRotation(); });
  document.addEventListener("visibilitychange", () => { document.hidden ? stopRetailFeatureRotation() : startRetailFeatureRotation(); });
  startRetailFeatureRotation();
</script>

