---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import CulturalIndustryPage from "../../components/cultural-industry/CulturalIndustryPage.astro";

const title = "Cultural Event Management Software | EventHex";
const description =
  "Run cultural festivals, art exhibitions, heritage events, and community celebrations with sessions, ticketing, an attendee app, communication, and event-day tools.";
const canonical = "https://eventhex.ai/industries/cultural/";

// Visible FAQ copy. The same array builds the FAQPage structured data.
const faqs: Array<[string, string]> = [
  [
    "Can EventHex support multi-day or multi-area programmes?",
    "Use Session Management for the session, room, time, capacity, speaker, and attendee-agenda workflow.",
  ],
  [
    "Can we sell day passes and other ticket types?",
    "Yes. Configure ticket types, capacity, sale windows, limits, discounts, coupons, add-ons, and delivery.",
  ],
  [
    "Does EventHex manage venues or festival production?",
    "No. EventHex does not replace venue production, artist-contract, rights, or logistics systems.",
  ],
  [
    "Is every EventHex surface available in every language?",
    "EventHex does not promise universal multilingual coverage. Validate the exact required surfaces during the demo.",
  ],
  [
    "Can attendees find their photos?",
    "Yes. Use the selfie and face-match discovery flow where approved by the event.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Cultural Event Management Software",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: canonical,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Event registration and configurable ticket types",
    "Session, speaker, room, and capacity programme records",
    "Event websites and attendee schedules",
    "Attendee app and supported notifications",
    "QR ticket validation and check-in",
    "Approved photo discovery workflows",
    "Event, attendance, app, exhibitor, and portfolio reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogImage="https://eventhex.ai/images/cultural-industry/app/attendee-app-modules-web-1200.webp"
  ogType="website"
  footerCtaEyebrow="Plan the configuration"
  footerCtaTitle="Bring one cultural event workflow to the demo"
  footerCtaSubtitle="Review the event format, audience groups, access rules, programme, communication channels, onsite plan, and required integrations with the EventHex team."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <CulturalIndustryPage {faqs} />
</MarketingLayout>
