---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import MediaPage from "../../components/industries/MediaPage.astro";

const title = "Media Event Management Software | EventHex";
const description =
  "Run film festivals, media conferences, creator summits, and awards events with configured submissions, review, programme, registration, badges, photo discovery, and reporting.";

const faqs: [string, string][] = [
  [
    "Can EventHex collect film or content submissions?",
    "The Call for Papers mechanism can collect configured submissions and run review. Film-specific rights and asset management are not included.",
  ],
  [
    "Can accepted submissions become programme sessions?",
    "Yes. Accepted work can move into the programme for session and speaker coordination.",
  ],
  [
    "Does EventHex manage press accreditation?",
    "No. EventHex does not include a dedicated press-accreditation product. Configured fields, ticket types, approvals, badges, and check-in may support an event process after review.",
  ],
  [
    "Can attendees find event photos?",
    "Yes. Use the selfie and face-match discovery flow where the event has approved its operating and privacy approach.",
  ],
  [
    "Does EventHex store and manage video libraries?",
    "No. EventHex does not include a general digital-asset or video-rights management system.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Media Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/media/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Configured submissions and review",
    "Programme and speaker coordination",
    "Event registration and badges",
    "Audience communication and participation",
    "Photo discovery and event reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/media/"
  ogImage="https://eventhex.ai/images/industries/media/cfp-portal-sessions.webp"
  footerCtaEyebrow="Plan your next media event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <MediaPage {faqs} />
</MarketingLayout>
