---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import GovernmentPage from "../../components/industries/GovernmentPage.astro";

const title = "Government Event Management Software | EventHex";
const description =
  "Run government summits, policy conferences, public consultations, and inter-agency events with configurable registration, approvals, sessions, badges.";

const faqs: [string, string][] = [
  [
    "Can government events use approval-based registration?",
    "Yes. Configure the registration journey and approval workflow appropriate to the event.",
  ],
  [
    "Does EventHex certify accessibility compliance?",
    "No. Review the required attendee surfaces and complete the appropriate accessibility assessment before launch.",
  ],
  [
    "Does EventHex guarantee data sovereignty or security compliance?",
    "No. Data residency, encryption compliance, security clearance, and regulatory guarantees require separate technical and legal evidence.",
  ],
  [
    "Can the scanner work during connectivity issues?",
    "The check-in workflow supports offline-resilient capture; validate the intended event-day operating plan in a demo.",
  ],
  [
    "Does EventHex automate protocol or ministerial hierarchy?",
    "No. EventHex does not include a diplomatic-protocol workflow.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Government Event Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/industries/government/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Configurable registration and approval workflows",
    "Programme and speaker coordination",
    "Campaigns and supported app announcements",
    "Badges and QR check-in",
    "Attendance and event reporting",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/industries/government/"
  footerCtaEyebrow="Plan your next government event"
  footerCtaTitle="See the workflow with your own event requirements"
  footerCtaSubtitle="Bring the format, audience, registration and access rules, programme, communication channels, onsite plan, and integration needs. We’ll show the supported EventHex path and identify anything that needs separate validation."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <GovernmentPage {faqs} />
</MarketingLayout>
