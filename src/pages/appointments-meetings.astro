---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Event Meeting Scheduling Software | EventHex";
const description = "Configure event meeting hours, slots and locations, then let registered attendees request, confirm, reschedule and track one-to-one meetings.";

const lifecycle = [
  ["Discover", "Registered attendees"],
  ["Request", "Choose time and add context"],
  ["Confirm", "Accept or suggest a new time"],
  ["Attend", "Adjust, reminders and details"],
];

const controls = [
  ["Enable meetings", "Turn attendee scheduling on for the event."],
  ["Choose slot length", "Offer 15, 20, 30, 45 or 60-minute appointments."],
  ["Add meeting windows", "Set the dates and hours that fit your event programme."],
  ["Name meeting points", "Give attendees a clear place to meet at the venue."],
  ["Limit open requests", "Control how many unanswered invitations one attendee can hold."],
  ["Allow free-time mode", "Leave meeting windows empty when attendees should choose arbitrary times."],
];

const requestSteps = [
  ["01", "Open a profile", "Start from another registered attendee.", "/images/appointments-meetings/app/registered-attendee-directory.png", "EventHex registered attendee directory used to open an attendee profile"],
  ["02", "Pick an available time", "Choose from the event's configured meeting schedule.", "/images/appointments-meetings/app/event-time-location-settings.png", "EventHex event date, time and location settings used to define available meeting slots"],
  ["03", "Add context", "Include an optional title, message, and meeting place.", "/images/appointments-meetings/app/attendee-app-preview-settings.png", "EventHex attendee app configuration where meeting details appear in the personal experience"],
  ["04", "Send the request", "Create a pending invitation for the other attendee.", "/images/appointments-meetings/app/meeting-notification-settings.png", "EventHex meeting request notification settings used after an invitation is sent"],
];

const conflictStages = [
  { label:"01 · Before a Request", title:"Define the Event-Timezone Grid", text:"Generate future slots from organizer meeting windows and the event timezone.", rules:["Event-timezone grid","Past-time protection"], image:"/images/appointments-meetings/app/event-time-location-settings.png", alt:"EventHex event timezone, schedule and venue settings used to generate meeting availability" },
  { label:"02 · While Choosing", title:"Protect Both Participants' Calendars", text:"Remove any time that overlaps an accepted meeting for either person.", rules:["Requester calendar","Invitee calendar"], image:"/images/appointments-meetings/app/attendee-app-preview-settings.png", alt:"EventHex attendee app settings for the personal experience where participants choose meeting times" },
  { label:"03 · Before It Changes", title:"Recheck Before Accepting or Rescheduling", text:"Run the same two-calendar guard again before a proposed time becomes confirmed.", rules:["Accept-time recheck","Reschedule-time recheck"], image:"/images/appointments-meetings/app/meeting-notification-settings.png", alt:"EventHex meeting request notification settings supporting confirmed meeting changes" },
];

const states = [
  ["Pending", "Waiting for the invited attendee to respond.", "/images/appointments-meetings/app/meeting-notification-settings.png"],
  ["Accepted", "Confirmed and shown in both participants' upcoming meetings.", "/images/appointments-meetings/app/attendee-app-preview-settings.png"],
  ["Declined", "Closed after the invited attendee says no.", "/images/appointments-meetings/app/registered-attendee-directory.png"],
  ["Rescheduled", "A new time has been proposed for review.", "/images/appointments-meetings/app/event-time-location-settings.png"],
  ["Cancelled", "Closed by either participant after confirmation.", "/images/appointments-meetings/app/meetings-module-settings.png"],
  ["Expired", "Closed when an unanswered request passes its start time.", "/images/appointments-meetings/app/event-dashboard-timezone.png"],
];

const connected = [
  ["AI Smart-Connect", "Explain AI-assisted attendee recommendations and matching.", "/enhance-networking-ai-smart-connect/"],
  ["Event Mobile App", "Give attendees access to their meeting workflow on the event app.", "/event-mobile-app/"],
  ["Event Notifications", "Coordinate wider event communication and operational alerts.", "/event-notifications/"],
  ["Exhibitor Management", "Manage exhibitor operations outside the attendee-meeting lifecycle.", "/exhibitor-management/"],
];

const connectedIcons = [
  ["M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1", "M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"],
  ["M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z", "M9 6h6M10 18h4"],
  ["M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9", "M10 21h4"],
  ["M3 21V8l9-5 9 5v13M7 21v-6h4v6m3-9h3m-3 4h3"],
];

const useCases = [
  { id:"exhibitions", tab:"Exhibitions", title:"Create Valuable Meetings Around the Show Floor", text:"Set named meeting points and focused booking windows so attendees and exhibitors can turn discovery into scheduled conversations.", points:["Show-floor meeting windows","Named venue meeting points","Attendee and partner conversations"], image:"/images/appointments-meetings/app/multi-event-workspace.png", alt:"EventHex multi-event workspace for exhibition meeting programmes", tint:"#fff8dc", border:"#f0dfa6" },
  { id:"conferences", tab:"Conferences & tech", title:"Place One-to-One Conversations Around the Program", text:"Build meeting availability around sessions and breaks while keeping every request aligned with the event timetable.", points:["Session-aware availability","Focused networking windows","Conflict-aware booking"], image:"/images/appointments-meetings/app/event-time-location-settings.png", alt:"EventHex event schedule and venue settings for conference meeting windows", tint:"#edf7ff", border:"#d4e7f7" },
  { id:"associations", tab:"Associations", title:"Give Members a Structured Way to Connect", text:"Help members discover one another, request time, and keep confirmed conversations organized inside the event experience.", points:["Registered-member discovery","Clear request lifecycle","Personal meeting views"], image:"/images/appointments-meetings/app/registered-attendee-directory.png", alt:"EventHex registered attendee directory for association member discovery", tint:"#f3efff", border:"#e2d8fa" },
  { id:"corporate", tab:"Corporate & multi-day", title:"Coordinate Partner Meetings Across Event Days", text:"Configure each event date separately and create controlled windows for internal, client, and partner conversations.", points:["Day-specific schedules","Internal and partner meetings","Adjustable time and place"], image:"/images/appointments-meetings/app/event-dashboard-timezone.png", alt:"EventHex event dashboard showing a dated multi-day event and its timezone", tint:"#eefbf4", border:"#d4efdf" },
];

const faqs = [
  ["Who can schedule a meeting?", "Both participants must be registered for the same event, and the mobile module must be enabled for that event."],
  ["Can organizers control when meetings happen?", "Yes. Organizers can enable meetings, choose 15, 20, 30, 45 or 60-minute slots, add event-day meeting windows, name meeting points, and limit open requests."],
  ["How are double bookings prevented?", "EventHex checks accepted meetings for both participants when a request is created and checks both calendars again when a meeting is accepted or rescheduled."],
  ["Can attendees propose a different time?", "Yes. Either participant can propose a new time, and the same availability checks are applied before the meeting is confirmed."],
  ["What happens to unanswered requests?", "A pending request is marked expired after its proposed start time has passed, keeping active and historical meeting views clear."],
  ["Are reminders supported?", "Yes. The workflow sends a deduplicated push reminder to both participants before an accepted meeting. Email and external-calendar reminders are not implied."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Appointments & Meetings",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/appointments-meetings/",
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Organizer-defined event meeting windows",
    "15 to 60 minute meeting slots",
    "Named venue meeting points",
    "Attendee meeting requests",
    "Two-participant availability checks",
    "Accept, decline, reschedule and cancel states",
    "Pre-meeting push reminders",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/appointments-meetings/"
  footerCtaEyebrow="Design the meeting policy"
  footerCtaTitle="Bring Your Event Timetable and Venue Meeting Plan"
  footerCtaSubtitle="Show us the days, time windows, slot length, locations, attendee rules, and reminder expectations."
  footerCtaProofItems={["Event-specific setup", "Conflict-aware booking", "Clear attendee workflow"]}
  footerCtaButtonText="Book a Demo"
>
  <main class="amm-page">
    <section class="amm-hero" aria-labelledby="amm-title">
      <div class="amm-shell amm-hero__grid">
        <div class="amm-hero__copy animate-on-scroll" data-animation="fadeInUp">
          <span class="amm-eyebrow">Event meeting scheduling software</span>
          <h1 id="amm-title">Turn event networking into meetings people can actually schedule</h1>
          <p>Define when and where meetings can happen, then let registered attendees propose, confirm, reschedule, cancel, and revisit one-to-one meetings inside the event experience.</p>
          <div class="amm-actions">
            <a class="amm-button" href="/book-a-demo/">See it with your event <span aria-hidden="true">›</span></a>
            <a class="amm-button amm-button--outline" href="#workflow">See the meeting flow</a>
          </div>
          <ul class="amm-trust" aria-label="Meeting scheduling highlights">
            <li>Event-specific meeting hours</li><li>Two-calendar conflict checks</li>
          </ul>
        </div>
        <div class="amm-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="amm-hero__visual-card">
            <div class="amm-hero__visual-inner" aria-label="EventHex event dashboard and meeting module settings">
              <img class="amm-product-shot amm-product-shot--dashboard" src="/images/appointments-meetings/app/event-dashboard-timezone.png" width="1263" height="698" alt="Creators Conference dashboard showing the event date and Asia Kolkata timezone" loading="eager" fetchpriority="high" />
              <img class="amm-product-shot amm-product-shot--modules" src="/images/appointments-meetings/app/meetings-module-settings.png" width="1263" height="698" alt="Meetings module enabled in the EventHex attendee mobile app settings" loading="lazy" />
              <span class="amm-shot-status"><i></i> Meetings enabled</span>
              <span class="amm-shot-cursor" aria-hidden="true">↖</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="workflow" class="amm-section amm-workflow" aria-label="Meeting workflow overview">
      <ol class="amm-shell amm-rail" aria-label="Meeting workflow">
        <li class="amm-rail__label">One Connected Flow</li>
        {lifecycle.map(([name, detail]) => <li><b>{name}</b> <span>{detail}</span></li>)}
      </ol>
    </section>

    <section class="amm-section amm-meeting-spotlight" aria-labelledby="amm-view-title">
      <div class="amm-shell">
        <header class="amm-meeting-spotlight__heading"><h2 id="amm-view-title">One meeting view, every next action clear</h2><p>Separate confirmed plans from requests that need attention, while keeping sent invitations and meeting history close.</p></header>
        <div class="amm-meeting-quad">
          <article class="amm-meeting-quad__copy"><h3>Upcoming and requests</h3><p>See confirmed meetings first, then handle invitations that still need a response. Time, person, and place stay visible at a glance.</p></article>
          <div class="amm-meeting-quad__media"><div class="amm-meeting-composite">
            <img class="amm-meeting-composite__screen amm-meeting-composite__screen--primary" src="/images/appointments-meetings/app/attendee-app-preview-settings.png" width="1263" height="698" alt="EventHex attendee app preview showing the personal meeting experience" loading="lazy" decoding="async" />
            <img class="amm-meeting-composite__screen amm-meeting-composite__screen--secondary" src="/images/appointments-meetings/app/meeting-notification-settings.png" width="1263" height="698" alt="EventHex meeting notification settings for upcoming requests" loading="lazy" decoding="async" />
            <span class="amm-meeting-composite__status">✓ &nbsp;Personal app view</span><span class="amm-meeting-composite__action">Review request</span>
          </div></div>
          <div class="amm-meeting-quad__media"><div class="amm-meeting-composite amm-meeting-composite--history">
            <img class="amm-meeting-composite__screen amm-meeting-composite__screen--primary" src="/images/appointments-meetings/app/registered-attendee-directory.png" width="1263" height="698" alt="EventHex registered attendee directory used to find meeting participants" loading="lazy" decoding="async" />
            <img class="amm-meeting-composite__screen amm-meeting-composite__screen--secondary" src="/images/appointments-meetings/app/meetings-module-settings.png" width="1263" height="698" alt="EventHex meetings module settings supporting sent invitations and meeting history" loading="lazy" decoding="async" />
            <span class="amm-meeting-composite__status">✓ &nbsp;Meeting history retained</span><span class="amm-meeting-composite__action">View meeting</span>
          </div></div>
          <article class="amm-meeting-quad__copy"><h3>Sent and history</h3><p>Track requests awaiting a reply and revisit declined, cancelled, expired, or completed meetings without mixing them into what is next.</p></article>
          <span class="amm-meeting-quad__cross" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section class="amm-section amm-toolkit" aria-labelledby="amm-controls-title">
      <div class="amm-shell">
        <header class="amm-heading"><span class="amm-eyebrow">Organizer controls</span><h2 id="amm-controls-title">Set the booking boundaries before attendees start requesting time</h2><p>Configure a predictable meeting structure around the event programme and venue.</p></header>
        <div class="amm-toolkit-grid">
          {controls.map(([name, text], i) => <article>
            {(i === 1 || i === 2 || i === 4 || i === 5) && <span class="amm-toolkit-petal amm-toolkit-petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>}
            {(i === 1 || i === 2) && <span class="amm-toolkit-petal amm-toolkit-petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg></span>}
            <h3>{name}</h3><p>{text}</p>
            <div class:list={["amm-toolkit-ui", `amm-toolkit-ui--${i}`]} aria-hidden="true">
              <div class="amm-toolkit-ui__top"><span>{["Meeting module","Appointment length","Event schedule","Meeting points","Pending requests","Free-time mode"][i]}</span><i></i></div>
              <div class="amm-toolkit-ui__body"><span></span><span></span><span></span><strong>{["Enabled","30 minutes","Thu · 09:00—17:00","Point B · Lobby","3 open requests","Flexible time enabled"][i]}</strong></div>
            </div>
          </article>)}
        </div>
      </div>
    </section>
    <script is:inline>
      (() => {
        const initToolkitBand = () => {
          const band = document.querySelector('.amm-toolkit');
          if (!band || band.dataset.bandReady === 'true') return;
          band.dataset.bandReady = 'true';
          let frame = 0;
          const update = () => {
            frame = 0;
            const rect = band.getBoundingClientRect();
            const start = window.innerHeight * .92;
            const end = window.innerHeight * .35;
            const progress = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
            band.style.setProperty('--band-p', progress.toFixed(3));
          };
          const queue = () => { if (!frame) frame = requestAnimationFrame(update); };
          update();
          addEventListener('scroll', queue, { passive: true });
          addEventListener('resize', queue, { passive: true });
        };
        initToolkitBand();
        document.addEventListener('astro:page-load', initToolkitBand);
      })();
    </script>

    <section class="amm-section amm-request-flow" aria-labelledby="amm-request-title">
      <div class="amm-shell amm-request-flow__layout">
        <div class="amm-request-flow__intro"><div class="amm-request-flow__sticky"><span class="amm-request-flow__eyebrow">In-app coordination</span><h2 id="amm-request-title">Let attendees propose a meeting with the essential details attached</h2><p>The request carries the two people, event, start and end time, plus optional title, message, and place.</p><a href="/book-a-demo/" class="amm-request-flow__cta">Book a Demo <span aria-hidden="true">→</span></a></div></div>
        <div class="amm-journey">{requestSteps.map(([n, name, text, image, alt]) => <article><div class="amm-journey__header"><span>{n}</span><div><h3>{name}</h3><p>{text}</p></div></div><div class="amm-journey__visual"><div class="amm-app-frame amm-app-frame--journey"><img src={image} width="1263" height="698" alt={alt} loading="lazy" /><span><i></i> {name}</span></div></div></article>)}</div>
      </div>
    </section>

    <section class="amm-section amm-dark amm-conflict-journey" aria-labelledby="amm-conflict-title">
      <div class="amm-shell">
        <header class="amm-heading" data-amm-conflict-header><span class="amm-conflict-pill">✦ Before, during, and before confirmation</span><h2 id="amm-conflict-title">Put Every Availability Check at the Moment It Can Help</h2><p>Accepted meetings determine whether a slot is free, busy for the requester, or busy for the other attendee.</p></header>
        <div class="amm-conflict-stages">{conflictStages.map((stage, stageIndex) => <article>
          <div class="amm-conflict-stage__copy"><span>{stage.label}</span><h3>{stage.title}</h3><p>{stage.text}</p><ul>{stage.rules.map(rule => <li>✓ {rule}</li>)}</ul><a href="/book-a-demo/">Explore More</a></div>
          <div class="amm-conflict-stage__visual" aria-label={`${stage.title} availability example`}>
            <div class="amm-app-frame amm-app-frame--availability"><img src={stage.image} width="1263" height="698" alt={stage.alt} loading="lazy" /></div>
            <span class="amm-conflict-stage__status">{stageIndex === 0 ? "Windows ready" : stageIndex === 1 ? "Calendars checked" : "Safe to confirm"}</span>
          </div>
        </article>)}<div class="amm-conflict-stack-spacer" aria-hidden="true"></div></div>
      </div>
    </section>

    <script is:inline>
      (() => {
        const section = document.querySelector('.amm-conflict-journey');
        const header = section?.querySelector('[data-amm-conflict-header]');
        const cards = section?.querySelectorAll('.amm-conflict-stages > article');
        const finalCard = cards?.[cards.length - 1];
        if (!header || !finalCard) return;
        let frame = 0;
        const sync = () => { frame = 0; const top = Number.parseFloat(getComputedStyle(finalCard).top) || 0; const offset = Math.min(0, finalCard.getBoundingClientRect().top - top); header.style.transform = `translateY(${offset}px)`; };
        const queue = () => { if (!frame) frame = requestAnimationFrame(sync); };
        addEventListener('scroll', queue, { passive:true }); addEventListener('resize', queue); sync();
      })();
    </script>

    <section class="amm-section amm-lifecycle" aria-labelledby="amm-lifecycle-title">
      <div class="amm-shell">
        <header class="amm-heading"><span class="amm-eyebrow">A clear response at every stage</span><h2 id="amm-lifecycle-title">Keep each meeting in an explicit lifecycle state</h2><p>Participants can act on the meeting while the system keeps the next step unambiguous.</p></header>
        <div class="amm-state-accordion">{states.map(([name, text, image], i) => <details style={`--state-tint:${["#fff9df","#eefbf4","#fff0f3","#eef2ff","#f6efff","#f1f3f6"][i]};--state-line:${["#eddda8","#cee9d9","#efd2da","#d4dcfa","#dfd2f1","#dce1e8"][i]}`} data-state-row>
          <summary><span>{String(i + 1).padStart(2,"0")}</span><strong>{name}</strong><small>{text}</small><i aria-hidden="true"></i></summary>
          <div class="amm-state-accordion__body"><p>{text}</p><div class="amm-state-accordion__shot"><img src={image} width="1263" height="698" alt={`EventHex product screen illustrating the ${name.toLowerCase()} meeting state`} loading="lazy" /><span class={`amm-state amm-state--${i}`}>{name}</span></div></div>
        </details>)}</div>
      </div>
    </section>

    <script is:inline>
      (() => {
        const rows = [...document.querySelectorAll('[data-state-row]')];
        rows.forEach((row) => row.addEventListener('toggle', () => { if (!row.open) return; rows.forEach((other) => { if (other !== row) other.open = false; }); }));
      })();
    </script>

    <section class="amm-section">
      <div class="amm-shell amm-spotlight">
        <div class="amm-reminder" aria-label="EventHex meeting notification configuration">
          <div class="amm-reminder__screen"><img src="/images/appointments-meetings/app/meeting-notification-settings.png" width="1263" height="698" alt="EventHex meeting request notification settings used for participant reminders" loading="lazy" /></div>
          <span class="amm-reminder__status"><i></i> Meeting alerts enabled</span>
        </div>
        <div><span class="amm-eyebrow">Before the meeting</span><h2>Remind both participants with the time, person, and place</h2><p>Accepted meetings approaching their start time enter the reminder window and receive a deduplicated push notification.</p><ul class="amm-checks"><li>Accepted meetings only</li><li>Sent near the start</li><li>Includes useful context</li><li>Stored to prevent repeat sends</li></ul></div>
      </div>
    </section>

    <section class="amm-section amm-links-section">
      <div class="amm-shell">
        <header class="amm-heading"><span class="amm-eyebrow">Discovery and communication</span><h2>Use the specialist feature that owns each adjacent job</h2><p>Meeting scheduling coordinates time; connected features handle discovery, messaging, and operational alerts.</p></header>
        <div class="amm-link-grid">{connected.map(([name, text, href], i) => <a href={href}><span aria-hidden="true"><svg viewBox="0 0 24 24">{connectedIcons[i].map(d => <path d={d}></path>)}</svg></span><h3>{name}</h3><p>{text}</p></a>)}</div>
      </div>
    </section>

    <section class="amm-section amm-use-cases" aria-labelledby="amm-use-title">
      <div class="amm-shell">
        <header class="amm-heading"><span class="amm-eyebrow">Built for scheduled conversations</span><h2 id="amm-use-title">Match the meeting policy to the way your event creates value</h2><p>Choose the setup that reflects how people move through your programme.</p></header>
        <div class="amm-use-tabs" role="radiogroup" aria-label="Event formats">
          {useCases.map((item, i) => <><input class="amm-use-radio" type="radio" name="amm-use-format" id={`amm-tab-${item.id}`} checked={i === 0} /><label id={`amm-tab-label-${item.id}`} for={`amm-tab-${item.id}`} aria-controls={`amm-panel-${item.id}`}>{item.tab}</label></>)}
        </div>
        <div class="amm-use-panels">
          {useCases.map((item) => <article class="amm-use-panel" id={`amm-panel-${item.id}`} role="region" aria-labelledby={`amm-tab-label-${item.id}`} style={`--format-tint:${item.tint};--format-border:${item.border}`}>
            <div class="amm-use-panel__copy"><h3>{item.title}</h3><p>{item.text}</p><span class="amm-use-panel__label">MEETING POLICY</span><ul>{item.points.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul></div>
            <div class="amm-use-panel__visual"><div class="amm-app-frame amm-app-frame--events"><img src={item.image} width="1263" height="698" alt={item.alt} loading="lazy" /><span><i></i> {item.tab} setup</span></div></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="amm-section amm-faq">
      <div class="amm-shell amm-faq__grid">
        <div class="amm-faq__intro animate-on-scroll" data-animation="fadeInLeft">
          <span class="amm-faq__eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Quick Answers</span>
          <h2>Meeting Scheduling<br />Questions, Answered.</h2>
          <p>Find quick answers about attendee access, booking windows, conflict checks, meeting states, and reminders.</p>
          <a href="/contact-en/" class="amm-faq__cta">Visit Help Center <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>
        <div class="amm-faq__list">{faqs.map(([q, a], i) => <details class="amm-faq__item animate-on-scroll" data-animation="fadeInUp" data-delay={String(i * 50)} data-amm-faq-item open={i === 0}><summary><strong>{q}</strong><i aria-hidden="true"></i></summary><div class="amm-faq__answer"><p>{a}</p></div></details>)}</div>
      </div>
    </section>

    <script is:inline>
      (() => {
        const items = [...document.querySelectorAll('[data-amm-faq-item]')];
        items.forEach((item) => item.addEventListener('toggle', () => { if (!item.open) return; items.forEach((other) => { if (other !== item) other.open = false; }); }));
      })();
    </script>

