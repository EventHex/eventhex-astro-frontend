---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/event-marketing/HeroSection.astro";
import BentoGridSection from "../components/event-marketing/BentoGridSection.astro";
import FeatureCardsSection from "../components/event-marketing/FeatureCardsSection.astro";
import BenefitCardsSection from "../components/event-marketing/BenefitCardsSection.astro";
import FaqLightSection from "../components/event-marketing/FaqLightSection.astro";

const title = "Event Marketing Software for Email & WhatsApp | EventHex";
const description = "Build targeted event email and WhatsApp campaigns from registration data, schedule delivery, and review recipient-level status in EventHex.";
const canonical = "https://eventhex.ai/event-marketing/";

const faqs = [
  [
    "What is EventHex event marketing software?",
    "EventHex gives organizers one workspace to create email or WhatsApp campaigns, select audiences from their event data, personalize content, schedule delivery, and inspect campaign and recipient status.",
  ],
  [
    "Can I send both email and WhatsApp campaigns?",
    "Yes. Each campaign uses one selected channel. Email campaigns use the organization's connected marketing email identity. WhatsApp marketing campaigns use its connected official WhatsApp Business number and available approved templates.",
  ],
  [
    "Which audiences can I target?",
    "You can build from current-event registrants, selected tickets or forms, saved audiences, registrants from other organizer events, and available people segments. The exact recipient set depends on the selected channel and the email addresses or phone numbers available.",
  ],
  [
    "Can I exclude people who already registered?",
    "Yes. The audience workflow supports excluding people already registered for the current event when the campaign is built from another event audience.",
  ],
  [
    "Can I schedule an event campaign?",
    "Yes. Review the campaign, then send it immediately or choose a future date and time in the available event or user timezone.",
  ],
  [
    "What can I see after the campaign starts?",
    "EventHex shows the campaign state and available delivery or engagement counts. You can open recipient-level dispatch detail, refresh counts, and act on failed deliveries from the campaign workspace.",
  ],
  [
    "How does EventHex handle email opt-outs and bounces?",
    "Marketing emails include an unsubscribe path. Unsubscribes, complaints, and permanent bounces are suppressed from later marketing email sends.",
  ],
  [
    "Is Event Marketing the same as Event Notifications?",
    "No. Event Marketing is for planned promotional campaigns. Event Notifications owns operational alerts and updates connected to event actions or timing.",
  ],
  [
    "Is a WhatsApp campaign the same as WhatsApp Concierge?",
    "No. A WhatsApp campaign sends a planned template message to a selected audience. WhatsApp Concierge is the separate conversational workflow for attendee questions and event help.",
  ],
] as const;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Marketing",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: canonical,
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Email campaign builder and preview",
    "WhatsApp template campaigns",
    "Registration-aware audience selection",
    "Cross-event audience targeting",
    "Campaign scheduling",
    "Recipient-level delivery status",
    "Email suppression management",
    "Organization-owned sender identities",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogImage="https://eventhex.ai/feature-images/solutions/event-marketing-mockup.svg"
  footerCtaEyebrow="Event Marketing"
  footerCtaTitle={"See How Your Next Audience\nMoves From Event Data to\nCampaign Follow-Through"}
  footerCtaSubtitle="Map one email or WhatsApp campaign to its audience, message, schedule, connected sender, and recipient-status view."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform on laptop, tablet, and mobile"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <style is:inline>
      body .site-footer .footer-cta-title {
        max-width: 100%;
        font-size: 36px;
        font-weight: 500;
        line-height: 1.16;
      }

      @media (max-width: 1024px) {
        body .site-footer .footer-cta-title {
          font-size: 27px;
        }
      }

      @media (max-width: 767px) {
        body .site-footer .footer-cta-title {
          font-size: 23px;
          white-space: normal;
        }
      }
    </style>
  </Fragment>

  <div class="em-page-bg">
    <HeroSection />
    <BentoGridSection />
    <FeatureCardsSection />
    <BenefitCardsSection />
    <FaqLightSection faqs={faqs} />
  </div>
</MarketingLayout>

<style is:global>
  .em-page-bg {
    background:
      radial-gradient(ellipse 75% 68% at 50% 40%, rgba(255,255,255,.94) 0%, rgba(255,255,255,.65) 38%, rgba(255,255,255,.28) 58%, transparent 78%),
      linear-gradient(to bottom,#fff 0,rgba(255,255,255,.85) 130px,rgba(255,255,255,.5) 260px,rgba(255,255,255,.18) 390px,transparent 500px),
      linear-gradient(to top,#fff 0,rgba(255,255,255,.7) 70px,rgba(255,255,255,.3) 130px,transparent 190px),
      radial-gradient(circle 380px at 3% 34%,rgba(175,163,255,.28),transparent 100%),
      radial-gradient(circle 300px at 97% 30%,rgba(255,182,213,.26),transparent 100%),
      radial-gradient(circle 340px at 95% 75%,rgba(130,170,255,.24),transparent 100%),
      radial-gradient(circle 300px at 4% 78%,rgba(255,224,150,.2),transparent 100%),
      #fff;
    background-attachment: fixed;
  }

  .em-page-bg a:focus-visible,
  .em-page-bg button:focus-visible,
  .em-page-bg summary:focus-visible {
    outline: 3px solid #f6bd35;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .em-page-bg *,
    .em-page-bg *::before,
    .em-page-bg *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
