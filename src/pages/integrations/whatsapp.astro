    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const suite = document.querySelector<HTMLElement>('.wix-template-suites');
        if (!suite) return;

        const tabs = Array.from(suite.querySelectorAll<HTMLButtonElement>('.wix-template__tab'));
        const panels = Array.from(suite.querySelectorAll<HTMLElement>('.wix-template__panel'));
        let rotationId: number | undefined;

        const activateTab = (tab: HTMLButtonElement) => {
          const targetId = tab.getAttribute('data-target');
          tabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle('wix-template__tab--active', active);
            item.setAttribute('aria-selected', String(active));
          });
          panels.forEach((panel) => panel.classList.toggle('wix-template__panel--active', panel.getAttribute('data-panel') === targetId));
        };

        const stopRotation = () => {
          if (rotationId === undefined) return;
          window.clearInterval(rotationId);
          rotationId = undefined;
        };

        const startRotation = () => {
          stopRotation();
          if (tabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          rotationId = window.setInterval(() => {
            const currentIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
            activateTab(tabs[(currentIndex + 1) % tabs.length]);
          }, 4200);
        };

        tabs.forEach((tab) => tab.addEventListener('click', () => {
          activateTab(tab);
          startRotation();
        }));
        suite.addEventListener('mouseenter', stopRotation);
        suite.addEventListener('mouseleave', startRotation);
        suite.addEventListener('focusin', stopRotation);
        suite.addEventListener('focusout', (event) => {
          if (!suite.contains(event.relatedTarget as Node | null)) startRotation();
        });
        startRotation();
      });
    </script>

