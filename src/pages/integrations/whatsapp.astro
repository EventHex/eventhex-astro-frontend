---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "WhatsApp Integration for Event Messages | EventHex";
const description =
  "Connect an event or organization WhatsApp account, use approved templates, map attendee and event fields, and keep marketing sends on an official tenant-owned account.";
const canonical = "https://eventhex.ai/integrations/whatsapp/";

const accountRoutes = [
  {
    title: "Platform WhatsApp",
    label: "Platform-managed",
    copy: "Use the centrally managed EventHex route for supported transactional purposes when that setup applies.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing platform-level event messaging context",
    status: "Platform route",
    action: "View platform route",
    tone: "blue",
  },
  {
    title: "Organization WhatsApp",
    label: "Portfolio-level",
    copy: "Reuse the organization's configured WhatsApp account across eligible events.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing organization-level event messaging context",
    status: "Organization route",
    action: "Review organization route",
    tone: "violet",
  },
  {
    title: "Custom event WhatsApp",
    label: "Event-level",
    copy: "Use event-specific provider credentials and template overrides when the event owns its setup.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event-level configuration context",
    status: "Event route",
    action: "Review event route",
    tone: "mint",
  },
];
const providerFields = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v5"></path><path d="M5.5 7.5h13"></path><rect x="3" y="7.5" width="18" height="12" rx="2"></rect><path d="M7 12h.01M12 12h.01M17 12h.01M7 16h10"></path></svg>`,
    title: "Provider",
    copy: "Choose the supported provider used by the account.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2"></rect><path d="M10 5h4"></path><path d="M11 18.5h2"></path></svg>`,
    title: "Account or phone ID",
    copy: "Identify the sending account or device according to that provider.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="15.5" r="4.5"></circle><path d="m12 12 8.5-8.5"></path><path d="m17 5 2 2"></path><path d="m15 7 2 2"></path></svg>`,
    title: "Access credential",
    copy: "Store the provider token or API key used for delivery.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"></circle><circle cx="18" cy="18" r="2.5"></circle><path d="M8 6h5a5 5 0 0 1 5 5v4.5"></path><path d="M16 18h-3a5 5 0 0 1-5-5V9"></path></svg>`,
    title: "Fallback",
    copy: "Use only where the configured provider path supports it and the organizer has enabled it.",
  },
];
const templateSuites = [
  {
    id: "authentication",
    label: "Authentication",
    title: "Verify the right person at the right moment",
    description: "OTP and checkout verification templates help the configured account support an intentional event journey.",
    checklist: ["OTP templates", "Checkout verification", "Purpose-specific preview"],
    image: "/images/platform-analytics-dashboard.jpg",
    imageAlt: "EventHex Platform Analytics dashboard used as a visual reference for WhatsApp authentication message setup",
    visualLabel: "Authentication purpose",
  },
  {
    id: "registration",
    label: "Registration",
    title: "Keep registration outcomes clear",
    description: "Use the registry's success, pending, approval, rejection, and related status message purposes for attendee updates.",
    checklist: ["Success and pending status", "Approval and rejection status", "Related registration messages"],
    image: "/images/_tmp-analytics-reference.png",
    imageAlt: "EventHex Platform Analytics dashboard used as a visual reference for WhatsApp registration status templates",
    visualLabel: "Registration status",
  },
  {
    id: "delivery",
    label: "Tickets and certificates",
    title: "Deliver the event document or media",
    description: "Represent text, image, document, and certificate delivery purposes in the connected template registry.",
    checklist: ["Text delivery purpose", "Image and document delivery", "Certificate delivery purpose"],
    image: "/images/platform-analytics-dashboard.jpg",
    imageAlt: "EventHex Platform Analytics dashboard used as a visual reference for WhatsApp ticket and certificate delivery templates",
    visualLabel: "Delivery purpose",
  },
  {
    id: "exhibitors",
    label: "Exhibitors and media",
    title: "Cover exhibitor and media workflows",
    description: "Keep exhibitor, booth-member, InstaSnap, InstaRecap, campaign, and system purposes visible in one template library.",
    checklist: ["Exhibitor and booth-member messages", "InstaSnap and InstaRecap purposes", "Campaign and system purposes"],
    image: "/images/_tmp-analytics-reference.png",
    imageAlt: "EventHex Platform Analytics dashboard used as a visual reference for WhatsApp exhibitor and media templates",
    visualLabel: "Workflow purpose",
  },
];
const overrideSteps = [
  ["Choose the message purpose", "Open the template used for that registration, ticket, exhibitor, or campaign moment."],
  ["Enter the approved template name", "Use the exact Meta-approved name for the connected account."],
  ["Add variables in order", "Create the numbered placeholders expected by the template."],
  ["Map each variable", "Connect each position to the supported EventHex field, then save the override."],
];
const overrideVisuals = [
  {
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard used as a visual reference for choosing a WhatsApp message purpose",
    status: "Purpose selected",
    action: "Choose purpose",
    tone: "blue",
  },
  {
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard used as a visual reference for entering an approved WhatsApp template name",
    status: "Approved name",
    action: "Enter template name",
    tone: "mint",
  },
  {
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard used as a visual reference for ordering WhatsApp template variables",
    status: "Variables ordered",
    action: "Add variables",
    tone: "violet",
  },
  {
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard used as a visual reference for saving a WhatsApp template override",
    status: "Override saved",
    action: "Save override",
    tone: "rose",
  },
];
const moments = [
  ["01", "Verify", "Send supported OTP or checkout verification messages."],
  ["02", "Confirm", "Notify attendees about registration outcomes."],
  ["03", "Deliver", "Send supported ticket, badge, or certificate media."],
  ["04", "Coordinate", "Notify exhibitors and booth members through their configured templates."],
  ["05", "Promote", "Use an approved organization-owned account for campaign messages."],
  ["06", "Support AI media", "Use the relevant InstaSnap or InstaRecap notification purpose."],
];
const messagePurposeSteps = [
  {
    title: "Verify the right person",
    desc: "Send supported OTP and checkout verification messages through the configured WhatsApp route.",
    bullets: ["OTP verification templates", "Checkout verification", "Purpose-specific message preview"],
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event and registration activity for WhatsApp verification",
  },
  {
    title: "Confirm registration outcomes",
    desc: "Keep attendees informed about registration success, pending review, approval, or rejection.",
    bullets: ["Success and pending status", "Approval and rejection status", "Attendee outcome notifications"],
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing registration and check-in trends for WhatsApp outcome messages",
  },
  {
    title: "Deliver tickets and certificates",
    desc: "Use the connected template registry for supported ticket, badge, certificate, and event media delivery.",
    bullets: ["Ticket and badge delivery", "Certificate messages", "Text, image, and document media"],
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event delivery context for WhatsApp tickets and certificates",
  },
  {
    title: "Coordinate exhibitors and booths",
    desc: "Notify exhibitors and booth members through the message purposes configured for the event.",
    bullets: ["Exhibitor notifications", "Booth-member updates", "Configured event templates"],
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing event operations for WhatsApp exhibitor and booth messages",
  },
  {
    title: "Promote from the right account",
    desc: "Keep campaign messages on an approved organization-owned official WhatsApp account.",
    bullets: ["Organization-owned identity", "Approved campaign templates", "Separate marketing route"],
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing organization-level activity for WhatsApp campaign messages",
  },
  {
    title: "Support AI media notifications",
    desc: "Represent the relevant InstaSnap and InstaRecap notification purposes in the connected template setup.",
    bullets: ["InstaSnap notifications", "InstaRecap notifications", "Media delivery purpose"],
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing event activity for WhatsApp AI media notifications",
  },
];
const scenarios = [
  ["01", "Event agencies", "Separate client-owned accounts and approved templates where the event requires them."],
  ["02", "Associations", "Reuse organization-level routing for a repeat event programme."],
  ["03", "Exhibitions", "Coordinate exhibitor and booth-member message purposes alongside attendee delivery."],
  ["04", "Conferences", "Connect verification, registration status, ticket, and reminder journeys to the chosen account."],
];
const scenarioCards = [
  {
    eyebrow: "Event agencies",
    title: "Keep each client event on the right account",
    desc: "Separate client-owned accounts and approved templates where the event requires them.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event-level activity for agency-managed WhatsApp routes",
  },
  {
    eyebrow: "Associations",
    title: "Reuse organization-level routing",
    desc: "Reuse organization-level routing for a repeat event programme and its connected message purposes.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing organization-level event activity for WhatsApp routing",
  },
  {
    eyebrow: "Exhibitions",
    title: "Coordinate exhibitor and booth messages",
    desc: "Coordinate exhibitor and booth-member message purposes alongside attendee delivery.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event operations for exhibitor WhatsApp messages",
  },
  {
    eyebrow: "Conferences",
    title: "Connect the full conference journey",
    desc: "Connect verification, registration status, ticket, and reminder journeys to the chosen account.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing registration and check-in trends for conference WhatsApp journeys",
  },
];
const trustStats = [
  ["3", "Account routes"],
  ["Approved", "Template controls"],
  ["Event-level", "Overrides"],
  ["Separate", "Campaign identity"],
];
const links = [
  { heading: "WhatsApp Event Concierge", copy: "Give attendees event-aware answers, forms, tickets, reminders, networking, and human help.", href: "/whatsapp-event-concierge/", icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-4 2 1.6-4.2A7.5 7.5 0 1 1 20 11.5Z"></path><path d="M8 11h.01M12 11h.01M16 11h.01"></path></svg>` },
  { heading: "Event Marketing", copy: "Build and schedule campaigns from EventHex audience data.", href: "/event-marketing/", icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-6-6 18-3.5-8.5L3 11Z"></path><path d="M11.5 14.5 21 5"></path></svg>` },
  { heading: "Event Notifications", copy: "Orchestrate operational messages and delivery status across channels.", href: "/event-notifications/", icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg>` },
  { heading: "Event Registration", copy: "Create the attendee journey that triggers verification and outcome messages.", href: "/event-registration/", icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path><path d="m9 15 2 2 4-4"></path></svg>` },
];
const faqs = [
  ["Can an event use its own WhatsApp Business account?", "Yes. EventHex supports organization-level or event-specific account configuration where the required provider credentials are available."],
  ["Can we use the platform number for marketing campaigns?", "No. The verified campaign path requires a tenant-owned official Meta Cloud API account so one organization's marketing does not use the shared platform identity."],
  ["Can we customize the templates?", "Custom-account events can enter their Meta-approved template names and map numbered variables to supported EventHex fields."],
  ["Which event messages are represented?", "The current registry covers authentication, registration, tickets, certificates, exhibitors, media products, campaigns, and system purposes."],
  ["What affects message delivery?", "Delivery depends on the connected account, approved template, recipient eligibility and consent, provider availability, and the destination device or network."],
  ["Is this the WhatsApp concierge product?", "No. This page explains the account and template connection. The concierge page owns attendee conversations and event-aware assistance."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex WhatsApp Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: canonical,
  description,
  featureList: [
    "Platform, organization, and event-specific WhatsApp account routing",
    "Provider credential configuration",
    "Meta-approved template preview and variable mapping",
    "Transactional and campaign account boundaries",
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  footerCtaEyebrow="Map the sending setup"
  footerCtaTitle="Bring your WhatsApp account and templates to the demo"
  footerCtaSubtitle="Show us who owns the number, the provider and credentials available, the message purposes you need, and any Meta-approved templates already in place. We’ll map the supported EventHex connection and its boundaries."
  footerCtaProofItems={["Account routing", "Approved templates", "Provider credentials"]}
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/speaker-management/cta-illustration.svg"
  footerCtaImageAlt="EventHex WhatsApp account and template setup workflow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <div class="wix-page">
    <section class="wix-hero"><div class="wix-shell wix-hero__grid">
      <div class="wix-hero__content animate-on-scroll" data-animation="fadeInUp">
        <span class="wix-kicker">WhatsApp integration for events</span>
        <h1>Connect the WhatsApp account behind your event messages</h1>
        <p class="wix-lead">Choose the configured sending route, use approved templates for the messages your event needs, and keep marketing sends on an organization-owned official account.</p>
        <div class="wix-actions"><a class="wix-button wix-button--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a><a class="wix-button wix-button--quiet" href="#wix-routing">See account routing</a></div>
        <div class="wix-proof" aria-label="WhatsApp integration capabilities"><span>Account routing</span><span>Template controls</span><span>Transactional and campaign separation</span></div>
      </div>
      <div class="wix-hero__visual animate-on-scroll" data-animation="fadeInRight">
        <div class="wix-hero__visual-card">
          <div class="wix-hero__visual-inner">
            <span class="wix-hero__blue-panel" aria-hidden="true"></span>
            <img class="wix-hero__image" src="/images/razorpay-platform-analytics-organizations.png" width="1262" height="697" loading="eager" alt="EventHex Platform Analytics organizations view showing organization-owned account routes and event activity" />
            <span class="wix-hero__float wix-hero__float--route" aria-hidden="true"><b>Account route</b><small>Organization</small></span>
            <span class="wix-hero__float wix-hero__float--template" aria-hidden="true"><b>Template</b><small>Approved</small></span>
          </div>
        </div>
      </div>
    </div></section>

    <section class="wix-trust" aria-label="WhatsApp integration setup coverage"><div class="wix-trust__inner"><span class="wix-trust__label">WhatsApp setup coverage</span>{trustStats.map(([value, label]) => <span class="wix-trust__stat"><b>{value}</b> {label}</span>)}</div></section>

    <section id="wix-routing" class="wix-routing-spotlight" aria-labelledby="wix-routing-title">
      <div class="wix-routing-spotlight__header">
        <span class="wix-kicker">WhatsApp account routing choices</span>
        <h2 id="wix-routing-title">Match the WhatsApp setup to who owns the number</h2>
        <p>The available route depends on organization and event configuration; one option is not presented as universally best.</p>
      </div>
      <div class="wix-routing-spotlight__grid">
        {accountRoutes.map((route, i) => <Fragment>
          {i % 2 === 0 ? <article class="wix-routing-spotlight__cell wix-routing-spotlight__cell--copy">
            <div class="wix-routing-spotlight__copy"><span class="wix-routing-spotlight__icon" aria-hidden="true">{i === 0 ? "◎" : "↗"}</span><h3>{route.title}</h3><p>{route.copy}</p><b>{route.label}</b></div>
          </article> : <div class="wix-routing-spotlight__cell wix-routing-spotlight__cell--media"><div class={`wix-routing-spotlight__visual wix-routing-spotlight__visual--${route.tone}`}><img src={route.image} alt={route.alt} width="1262" height="697" loading="lazy" decoding="async" /><span class="wix-routing-spotlight__status">✓ {route.status}</span><span class="wix-routing-spotlight__action">{route.action}</span></div></div>}
          {i % 2 === 0 ? <div class="wix-routing-spotlight__cell wix-routing-spotlight__cell--media"><div class={`wix-routing-spotlight__visual wix-routing-spotlight__visual--${route.tone}`}><img src={route.image} alt={route.alt} width="1262" height="697" loading="lazy" decoding="async" /><span class="wix-routing-spotlight__status">✓ {route.status}</span><span class="wix-routing-spotlight__action">{route.action}</span></div></div> : <article class="wix-routing-spotlight__cell wix-routing-spotlight__cell--copy"><div class="wix-routing-spotlight__copy"><span class="wix-routing-spotlight__icon" aria-hidden="true">{i === 1 ? "◌" : "✦"}</span><h3>{route.title}</h3><p>{route.copy}</p><b>{route.label}</b></div></article>}
        </Fragment>)}
        <span class="wix-routing-spotlight__cross wix-routing-spotlight__cross--one" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="scale(1,-1)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(90)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(-90)"/></svg></span>
        <span class="wix-routing-spotlight__cross wix-routing-spotlight__cross--two" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="scale(1,-1)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(90)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(-90)"/></svg></span>
      </div>
    </section>

    <section id="wix-provider" class="wix-provider-reference" aria-labelledby="wix-provider-title">
      <div class="wix-provider-reference__head">
        <span class="wix-kicker">Provider credential panel</span>
        <h2 id="wix-provider-title">Route each message through the provider configured for the event</h2>
        <p>EventHex resolves the selected event or organization account before dispatch. Provider fields vary, and saved access tokens remain a credential—not customer-facing copy.</p>
      </div>
      <div class="wix-provider-reference__grid" aria-label="Connection credentials">
        {providerFields.map((field, index) => <Fragment>
          {index > 0 && <span class="wix-provider-reference__notch" style={`left: ${(index / providerFields.length) * 100}%`} aria-hidden="true"><svg width="26" height="26" viewBox="-13 -13 26 26"><path d="M-13,0 A13,13 0 0,1 0,13 A13,13 0 0,1 13,0 Z" fill="#e8ecf2"></path></svg></span>}
          <article class="wix-provider-reference__card">
            <span class="wix-provider-reference__icon" set:html={field.icon} aria-hidden="true"></span>
            <h3>{field.title}</h3>
            <p>{field.copy}</p>
          </article>
        </Fragment>)}
      </div>
    </section>

    <section id="wix-boundary-spotlight" class="wix-boundary-spotlight"><div class="wix-boundary-spotlight__header"><span class="wix-kicker">Transactional / marketing account boundary</span><h2>Keep campaigns on an organization-owned official WhatsApp account</h2><p>Separate operational event delivery from the organization-owned identity required for campaign sends.</p></div><div class="wix-boundary-flow"><article class="wix-boundary-flow__cell wix-boundary-flow__cell--copy"><h3>Transactional event messages</h3><p>Use the event's configured route for supported OTP, registration, ticket, certificate, exhibitor, and system messages.</p></article><div class="wix-boundary-flow__cell wix-boundary-flow__cell--media"><div class="wix-boundary-composite"><img class="wix-boundary-composite__screen" src="/images/platform-analytics-dashboard.jpg" alt="EventHex Platform Analytics dashboard showing the operational event messaging route" width="1262" height="697" loading="lazy" decoding="async" /><span class="wix-boundary-composite__status">✓ Transactional route</span><span class="wix-boundary-composite__action">Event messages</span></div></div><div class="wix-boundary-flow__cell wix-boundary-flow__cell--media"><div class="wix-boundary-composite wix-boundary-composite--violet"><img class="wix-boundary-composite__screen" src="/images/_tmp-analytics-reference.png" alt="EventHex Platform Analytics dashboard showing an organization-owned campaign identity" width="1262" height="697" loading="lazy" decoding="async" /><span class="wix-boundary-composite__status">✓ Organization-owned</span><span class="wix-boundary-composite__action">Campaigns only</span></div></div><article class="wix-boundary-flow__cell wix-boundary-flow__cell--copy"><h3>Marketing campaigns</h3><p>Use a tenant-owned official Meta Cloud API account with complete credentials before campaign sending is considered ready.</p></article><span class="wix-boundary-flow__cross" aria-hidden="true"><svg width="18" height="18" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="scale(1,-1)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(90)"/><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--wix-line)" transform="rotate(-90)"/></svg></span></div><p class="wix-boundary-spotlight__note">Unofficial provider routes are deliberately blocked for marketing campaigns; the platform number is not used for a tenant's marketing send.</p></section>

    <section id="wix-template-library" class="wix-template-suites" aria-labelledby="wix-template-title">
      <div class="wix-template-suites__inner">
        <header class="wix-template__header">
          <h2 id="wix-template-title" class="wix-template__title">
            <span class="wix-template__title-line">Cover the event moments that</span>
            <span class="wix-template__title-line">need a structured WhatsApp message</span>
          </h2>
          <p class="wix-template__subtitle">The organizer workspace groups templates by purpose and lets teams preview the default message and variables before use.</p>
        </header>

        <div class="wix-template__tabs" role="tablist" aria-label="WhatsApp template purposes">
