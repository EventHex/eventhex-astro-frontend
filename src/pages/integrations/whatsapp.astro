    <script>
      const scenarioSection = document.querySelector<HTMLElement>('.wix-scenario-stack');
      const scenarioHeader = scenarioSection?.querySelector<HTMLElement>('.wix-scenario-stack__header');
      const scenarioCards = scenarioSection?.querySelectorAll<HTMLElement>('.wix-scenario-stack__card');
      const finalScenarioCard = scenarioCards?.[scenarioCards.length - 1];

      if (scenarioHeader && finalScenarioCard) {
        let scenarioFrame = 0;
        const syncScenarioRelease = () => {
          scenarioFrame = 0;
          const stickyTop = Number.parseFloat(getComputedStyle(finalScenarioCard).top) || 0;
          const releaseOffset = Math.min(0, finalScenarioCard.getBoundingClientRect().top - stickyTop);
          scenarioHeader.style.transform = `translateY(${releaseOffset}px)`;
        };
        const queueScenarioRelease = () => {
          if (scenarioFrame) return;
          scenarioFrame = requestAnimationFrame(syncScenarioRelease);
        };
        window.addEventListener('scroll', queueScenarioRelease, { passive: true });
        window.addEventListener('resize', queueScenarioRelease);
        syncScenarioRelease();
      }
    </script>
