---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import EmailSesIntegrationPage from "../../components/integrations/EmailSesIntegrationPage.astro";

const title = "AWS SES Integration for Event Email | EventHex";
const description = "Set up an EventHex-managed sending subdomain, verify the AWS SES identity, configure sender defaults, and review delivery events and suppression status.";
const faqs = [
  { question: "Do we need to configure our own AWS account?", answer: "The verified onboarding provisions an EventHex-managed SES sending identity and DNS path for the organization. Confirm any account-specific deployment model during the demo." },
  { question: "Will email send from our main company domain?", answer: "The current managed flow creates a dedicated subdomain under the configured EventHex sending root and lets you set the from name and reply-to address." },
  { question: "How do we know the sender is ready?", answer: "The connection report shows identity and tenant-association status. Campaign sending is enabled only after the required resources are verified." },
  { question: "Can we pause sending without deleting the setup?", answer: "Yes. The organization can disable and re-enable the verified sender while keeping the provisioned identity." },
  { question: "What affects email deliverability?", answer: "Message quality, audience consent, sender reputation, provider conditions, and recipient systems all affect delivery. Review the available delivery events instead of relying on one universal rate." },
  { question: "How are bounces and unsubscribes handled?", answer: "SES delivery events feed EventHex records, and suppression behavior is applied according to whether the message is critical, transactional, or marketing." },
];
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex AWS SES Email Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/integrations/email/",
  description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai/" },
  featureList: ["Managed SES identity provisioning", "Sending subdomain and DNS verification", "Sender readiness states", "Delivery event recording", "Purpose-aware suppression"],
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) };
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/integrations/email/"
  footerCtaEyebrow="Plan the sending identity"
  footerCtaTitle="Bring your event email workflow to the demo"
  footerCtaSubtitle="Show us the organization identity, from name, reply-to mailbox, campaign type, and current sender setup."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <EmailSesIntegrationPage {faqs} />
</MarketingLayout>
