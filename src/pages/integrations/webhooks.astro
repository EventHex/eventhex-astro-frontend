---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import WebhooksPage from "../../components/integrations/webhooks/WebhooksPage.astro";

const title = "Event Webhooks & Zapier Integration | EventHex";
const description = "Trigger webhooks from registration, check-in, orders, leads, and forms. Configure payloads and auth, verify signatures, review logs, and use automatic retries.";
const canonical = "https://eventhex.ai/integrations/webhooks/";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Webhooks & Zapier Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: canonical,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Six event webhook trigger types",
    "Configurable HTTP methods, headers, and authentication",
    "Dynamic and static webhook field mapping",
    "Optional HMAC-SHA256 payload signatures",
    "Webhook execution logs and delivery statistics",
    "Automatic retry backoff",
    "Zapier REST-hook subscriptions",
    "Zapier create and find attendee actions",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogType="website"
  footerCtaEyebrow="Plan Your Integration"
  footerCtaTitle="Bring your trigger, payload, and endpoint to the demo"
  footerCtaSubtitle="Show us the EventHex event that should start the automation, the ticket scope, the fields the receiver needs, its authentication contract, and the failure-handling expectation. We’ll map the supported webhook or Zapier path."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <WebhooksPage />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
</MarketingLayout>
