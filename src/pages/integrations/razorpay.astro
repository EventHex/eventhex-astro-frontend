---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import RazorpayPage from "../../components/integrations/RazorpayPage.astro";

const title = "Razorpay Integration for Event Ticket Payments | EventHex";
const description = "Connect a supported Razorpay account to EventHex ticket checkout, keep payment status linked to event orders, and manage full or partial refunds.";
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Razorpay Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/integrations/razorpay/",
  description,
  featureList: [
    "Connect a supported Razorpay account",
    "Keep payment status linked to event orders",
    "Manage full or partial refunds",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/integrations/razorpay/"
  footerCtaTitle="Bring one paid event to the demo"
  footerCtaEyebrow="Plan the Razorpay connection"
  footerCtaSubtitle="Show us the market, event currency, ticket flow, Razorpay account setup, refund process, and finance needs. We’ll walk through the supported EventHex path and identify anything that needs separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </Fragment>
  <RazorpayPage />
</MarketingLayout>
