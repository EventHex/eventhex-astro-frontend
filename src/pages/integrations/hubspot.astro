---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "HubSpot Integration for Event Registration | EventHex";
const description =
  "Connect EventHex to HubSpot contacts with a private-app token, map registration and event fields, control ticket scope, and review sync activity.";

const faqItems = [
  { question: "Is the EventHex HubSpot integration bidirectional?", answer: "The verified shipped path sends supported EventHex data to HubSpot contacts. HubSpot-to-EventHex synchronization is not promised in this recommendation." },
  { question: "How do we connect HubSpot?", answer: "Use a HubSpot private-app access token in the EventHex integration settings, then test the connection and load contact properties." },
  { question: "Can we map custom registration questions?", answer: "Supported dynamic registration fields can be mapped to HubSpot contact properties alongside standard attendee and event fields." },
  { question: "How are duplicates handled?", answer: "The current configuration uses email as the dedupe key and can update an existing contact when that option is enabled." },
  { question: "Can speakers and exhibitors sync too?", answer: "Yes. The product contains dedicated HubSpot paths for speakers, exhibitors, booth members, and company context." },
  { question: "Does EventHex create HubSpot deals or sequences?", answer: "Those behaviors were not verified in the current integration and should not be promised on this page." },
];

const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) };
const softwareJsonLd = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "EventHex HubSpot Integration", applicationCategory: "BusinessApplication", operatingSystem: "Web", url: "https://eventhex.ai/integrations/hubspot/", description };

const roles = [
  ["01", "Speakers", "Send supported speaker contact and event context through the dedicated speaker path.", "◉"],
  ["02", "Exhibitors", "Send supported exhibitor contacts through the dedicated exhibitor path.", "◇"],
  ["03", "Booth members", "Handle booth-member contacts through the exhibitor integration workflow.", "◫"],
  ["04", "Companies", "Create or update supported company context used by the exhibitor path.", "▦"],
  ["05", "Attendees", "Keep regular registrations on the mapped contact-upsert path.", "○"],
  ["06", "Ticket scope", "Choose which ticket types are eligible for the configured integration.", "⌁"],
];
const scenarios = [
  ["01", "B2B conferences", "Send eligible delegate contacts and ticket context to the CRM used for follow-up."],
  ["02", "Associations", "Keep member-event registration data connected to the contact record."],
  ["03", "Exhibitions", "Sync exhibitors, booth members, companies, and attendee contacts through their supported paths."],
  ["04", "Event agencies", "Configure field maps and ticket scope for the client account running each event."],
];
const scenarioTabs = [
  {
    id: "b2b-conferences",
    label: scenarios[0][1],
    title: scenarios[0][1],
    description: scenarios[0][2],
    checklist: ["Eligible delegate contacts", "Ticket context", "CRM follow-up"],
    image: "/images/_tmp-analytics-reference.png",
    imageAlt: "EventHex platform analytics dashboard showing event contact context for B2B conferences",
    visualLabel: "Event contact context",
  },
  {
    id: "associations",
    label: scenarios[1][1],
    title: scenarios[1][1],
    description: scenarios[1][2],
    checklist: ["Member-event registration data", "Connected contact record"],
    image: "/images/platform-analytics-dashboard.jpg",
    imageAlt: "EventHex platform analytics dashboard showing member registration data for associations",
    visualLabel: "Member registration data",
  },
  {
    id: "exhibitions",
    label: scenarios[2][1],
    title: scenarios[2][1],
    description: scenarios[2][2],
    checklist: ["Exhibitor contacts", "Booth members", "Company context", "Attendee contacts"],
    image: "/images/_tmp-analytics-reference.png",
    imageAlt: "EventHex platform analytics dashboard showing exhibitor and attendee contact paths",
    visualLabel: "Exhibitor contact paths",
  },
  {
    id: "event-agencies",
    label: scenarios[3][1],
    title: scenarios[3][1],
    description: scenarios[3][2],
    checklist: ["Field maps", "Ticket scope", "Client event configuration"],
    image: "/images/platform-analytics-dashboard.jpg",
    imageAlt: "EventHex platform analytics dashboard showing client event setup and mapping context",
    visualLabel: "Client event setup",
  },
];
const adjacentLinks = [
  ["Event Registration", "Build the forms and checkout journeys that create attendee records.", "/event-registration/"],
  ["Exhibitor Management", "Manage exhibitor applications, booth members, and lead operations.", "/exhibitor-management/"],
  ["Event Marketing", "Build campaigns from EventHex audience data and connected senders.", "/event-marketing/"],
  ["Webhooks", "Send selected EventHex events to another endpoint or a supported Zapier workflow.", "/integrations/webhooks/"],
];
const adjacentLinkVisuals = [
  {
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing event creation and registration trends for Event Registration",
  },
  {
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing event and organization context for Exhibitor Management",
  },
  {
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing audience and event trends for Event Marketing",
  },
  {
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex Platform Analytics dashboard showing connected event data for Webhooks",
  },
];
const workflowCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"></path><path d="M3 12h18"></path><circle cx="12" cy="12" r="9"></circle></svg>`,
    title: "Create or choose the HubSpot private app",
    body: "Use the access token from the HubSpot account your team controls.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M7 9h10"></path><path d="M7 13h6"></path></svg>`,
    title: "Add the token in EventHex",
    body: "Secrets stay out of normal read responses after save.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8.1 8.1 0 0 0-14.7-3L3 11"></path><path d="M3 4v7h7"></path><path d="M4 13a8.1 8.1 0 0 0 14.7 3L21 13"></path><path d="M21 20v-7h-7"></path></svg>`,
    title: "Test the connection",
    body: "Validate the credentials before building the field map.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"></path><path d="M8 8h8"></path><path d="M8 12h8"></path><path d="M8 16h5"></path></svg>`,
    title: "Load properties",
    body: "Use the available HubSpot contact fields as mapping targets.",
  },
];

const syncControls = [
  {
    title: "Eligible tickets",
    body: "Limit the integration to selected ticket types or leave it available to all configured tickets.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex platform analytics dashboard showing event activity for ticket-scope review",
    status: "Eligible tickets",
    action: "Review controls",
    tone: "approval",
  },
  {
    title: "Update existing",
    body: "Control whether a matching HubSpot contact should be refreshed.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex platform analytics dashboard showing registration and check-in trends for contact updates",
    status: "Update existing",
    action: "Apply setting",
    tone: "success",
  },
  {
    title: "Auto-create properties",
    body: "Create the EventHex properties needed by the selected mapping when enabled.",
    image: "/images/_tmp-analytics-reference.png",
    alt: "EventHex platform analytics dashboard showing event reporting alongside mapped data context",
    status: "Auto-create properties",
    action: "Review fields",
    tone: "neutral",
  },
  {
    title: "Disable CRM sync",
    body: "Use the event-level stop when an event should not send CRM contacts.",
    image: "/images/platform-analytics-dashboard.jpg",
    alt: "EventHex platform analytics dashboard showing event activity while CRM sync is controlled",
    status: "Disable CRM sync",
    action: "Save control",
    tone: "success",
  },
];
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/integrations/hubspot/"
  footerCtaEyebrow="MAP ONE EVENT BEFORE ROLLOUT"
  footerCtaTitle="Bring your HubSpot field plan to the demo"
  footerCtaSubtitle="Show us one registration form, the HubSpot contact properties you use, the ticket types that should sync, and whether speakers or exhibitors need their own path. We’ll map the supported workflow with you."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform on laptop, tablet, and mobile"
  footerCtaImageLoading="lazy"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="hubspot-page">
    <section class="hs-hero">
      <div class="hs-hero__copy">
        <p class="hs-eyebrow">HubSpot integration for events</p>
        <h1>Send event contacts to HubSpot with the context your team needs</h1>
        <p class="hs-hero__lead">Connect HubSpot with a private-app token, map EventHex fields to contact properties, control which tickets sync, and review the result without relying on manual exports.</p>
        <div class="hs-actions"><a class="hs-btn hs-btn--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a><a class="hs-btn hs-btn--quiet" href="#hs-mapping">See what syncs</a></div>
        <div class="hs-proof-row" aria-label="Integration capabilities"><span>Contact field mapping</span><span>Email-based dedupe</span><span>Attendee, speaker &amp; exhibitor paths</span></div>
      </div>
      <div class="hs-hero__visual" aria-label="EventHex platform analytics dashboard showing event creation, registration, and check-in trends" role="img">
        <div class="hs-hero__visual-card">
          <div class="hs-hero__visual-inner">
            <img
              src="/images/_tmp-analytics-reference.png"
              alt="EventHex platform analytics dashboard with event creation and registration trend charts"
              class="hs-hero__img"
              width="1262"
              height="697"
              loading="eager"
            />
          </div>
          <div class="hs-hero__visual-backplate" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="hs-trust" aria-label="Verified HubSpot integration capabilities"><div class="hs-trust__inner"><span class="hs-trust__label">Trusted By Event Teams</span><span class="hs-trust__stat"><b>Private-app token</b> Setup</span><span class="hs-trust__stat"><b>Field mapping</b> Properties</span><span class="hs-trust__stat"><b>Email dedupe</b> Upsert</span><span class="hs-trust__stat"><b>Role paths</b> Attendees, speakers &amp; exhibitors</span></div></section>

    <section class="hs-setup-hero">
      <div class="hs-setup-hero__inner">
        <header class="hs-setup-hero__header">
          <p class="hs-kicker">Connection setup</p>
          <h2>Start with a HubSpot private-app access token</h2>
          <p>Set up the connection your team controls, validate it, and then choose the fields EventHex can send.</p>
        </header>

        <div class="hs-setup-grid">
          {workflowCards.slice(0, -1).map((_, index) => (
            <div
              class="hs-setup-notch"
              style={`left: ${((index + 1) / workflowCards.length) * 100}%`}
              aria-hidden="true"
            >
              <svg width="28" height="28" viewBox="-14 -14 28 28">
                <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#e8ecf2"></path>
              </svg>
            </div>
          ))}
          {workflowCards.map((card, index) => (
            <article class:list={["hs-setup-card", { "hs-setup-card--first": index === 0 }]}>
              <div class="hs-setup-card__icon" set:html={card.icon} aria-hidden="true" />
              <div class="hs-setup-card__content">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="hs-mapping" class="hs-section hs-mapping-section">
      <div class="hs-shell">
        <div class="hs-section-heading">
          <p class="hs-kicker">Field mapping</p>
          <h2>Decide exactly what becomes a HubSpot contact property</h2>
          <p>Map standard identity fields, dynamic registration answers, and event context instead of pushing an undefined data dump.</p>
        </div>
        <div class="hs-mapping-grid">
          <div class="hs-mapping-table">
            <div class="hs-table-head"><span>EventHex field</span><span>HubSpot property</span><span>Status</span></div>
            {[['Email','email','Required'],['Full name','firstname + lastname','Mapped'],['Ticket type','event_ticket','Mapped'],['Registration status','event_status','Mapped'],['Venue','event_venue','Optional']].map((row) => <div class="hs-table-row"><span>{row[0]}</span><b>→</b><span>{row[1]}</span><em class:is-required={row[2] === 'Required'}>{row[2]}</em></div>)}
          </div>
          <div class="hs-mini-card">
            <span class="hs-mapping-petal hs-mapping-petal--top" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span>
            <span class="hs-mapping-petal hs-mapping-petal--bottom" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span>
            <span class="hs-mini-card__icon">◈</span><h3>Required identity</h3><p>Use email as the required contact key, with name and phone where collected.</p>
            <img class="hs-mini-card__shot" src="/images/_tmp-analytics-reference.png" alt="EventHex Platform Analytics dashboard showing event and registration context for required identity mapping" width="1262" height="697" loading="lazy" decoding="async" />
          </div>
          <div class="hs-mini-card">
            <span class="hs-mapping-petal hs-mapping-petal--top" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span>
            <span class="hs-mapping-petal hs-mapping-petal--bottom" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span>
            <span class="hs-mini-card__icon">⌁</span><h3>Registration answers</h3><p>Map supported ticket-form fields to the matching HubSpot properties.</p>
            <img class="hs-mini-card__shot" src="/images/platform-analytics-dashboard.jpg" alt="EventHex Platform Analytics dashboard showing registration activity for mapped answers" width="1262" height="697" loading="lazy" decoding="async" />
          </div>
          <div class="hs-mini-card">
            <span class="hs-mapping-petal hs-mapping-petal--top" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36"></path></svg></span>
            <span class="hs-mapping-petal hs-mapping-petal--bottom" aria-hidden="true"><svg width="22" height="22" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#2d2d36" transform="scale(1,-1)"></path></svg></span>
            <span class="hs-mini-card__icon">＋</span><h3>Property setup</h3><p>Optionally create missing HubSpot properties before the sync runs.</p>
            <img class="hs-mini-card__shot" src="/images/_tmp-analytics-reference.png" alt="EventHex Platform Analytics dashboard showing reporting context for property setup" width="1262" height="697" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <section id="hs-attendee-sync" class="hs-section hs-ai-section">
      <div class="hs-ai-section__inner">
        <div class="hs-ai-section__left">
          <p class="hs-kicker">Attendee sync</p>
          <h2 class="hs-ai-section__title">Create or update the HubSpot contact after an eligible registration</h2>
          <p class="hs-ai-section__copy">The EventHex-to-HubSpot path upserts a contact using the configured mapping and email-based dedupe. Approval and ticket eligibility can affect whether a registration is ready to sync.</p>
          <div class="hs-ai-section__actions">
            <a href="#hs-controls" class="hs-ai-section__btn hs-ai-section__btn--dark">See sync controls <span aria-hidden="true">→</span></a>
            <a href="#hs-mapping" class="hs-ai-section__btn hs-ai-section__btn--light">Explore Solution <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hs-ai-section__right">
          <div class="hs-ai-section__showcase" role="img" aria-label="EventHex platform analytics dashboard showing event and registration activity">
            <div class="hs-ai-section__shot">
              <img src="/images/_tmp-analytics-reference.png" alt="EventHex platform analytics dashboard with event creation and registration trend charts" width="1262" height="697" loading="lazy" decoding="async" />
            </div>
            <span class="hs-ai-section__status">Contact activity ready</span>
            <span class="hs-ai-section__publish">Review activity <span aria-hidden="true">→</span></span>
          </div>
        </div>
      </div>
    </section>

    <section id="hs-roles" class="hs-section hs-roles-workflow">
      <div class="hs-roles-workflow__inner">
        <header class="hs-roles-workflow__header">
          <p class="hs-kicker">More than attendee contacts</p>
          <h2>Extend the connection to the people and companies behind the event</h2>
          <p>Separate shipped paths can sync event roles without forcing them through the generic attendee trigger.</p>
        </header>
        <ol class="hs-roles-steps">
          {roles.map((role, index) => (
            <li>
              <details open={index === 0}>
                <summary>
                  <span>{role[0]}</span>
                  <div class="hs-role-step__content">
                    <h3>{role[1]}</h3>
                    <p>{role[2]}</p>
                  </div>
                  <button type="button" class="hs-role-step__arrow" aria-label={`${index === 0 ? "Collapse" : "Expand"} ${role[1]}`} aria-expanded={index === 0 ? "true" : "false"}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                  </button>
                </summary>
                <div class="hs-roles-workflow__visual">
                  <div class="hs-role-shot">
                    <img src="/images/_tmp-analytics-reference.png" alt={`EventHex platform analytics dashboard supporting the ${role[1].toLowerCase()} workflow`} width="1262" height="697" loading="lazy" decoding="async" />
                    <span aria-hidden="true">{role[1]}</span>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <script>
      const roleWorkflow = document.querySelector<HTMLElement>(".hs-roles-workflow");
      roleWorkflow?.querySelectorAll<HTMLDetailsElement>("details").forEach((item, _, all) => {
        const summary = item.querySelector("summary");
        const trigger = item.querySelector<HTMLButtonElement>(".hs-role-step__arrow");

        summary?.addEventListener("click", (event) => {
          event.preventDefault();
          item.open = !item.open;
        });

        item.addEventListener("toggle", () => {
          trigger?.setAttribute("aria-expanded", String(item.open));
          trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} workflow step`);
          if (!item.open) return;
          all.forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });
    </script>

    <script>
      const scenarioSuite = document.querySelector<HTMLElement>(".hs-scenario-suites");
      if (scenarioSuite) {
        const scenarioTabs = Array.from(scenarioSuite.querySelectorAll<HTMLButtonElement>(".hs-scenario__tab"));
        const scenarioPanels = Array.from(scenarioSuite.querySelectorAll<HTMLElement>(".hs-scenario__panel"));
        let scenarioRotation: number | undefined;

        const activateScenario = (tab: HTMLButtonElement) => {
          const target = tab.dataset.target;
          scenarioTabs.forEach((item) => {
            item.classList.toggle("hs-scenario__tab--active", item === tab);
            item.setAttribute("aria-selected", String(item === tab));
          });
          scenarioPanels.forEach((panel) => {
            panel.classList.toggle("hs-scenario__panel--active", panel.dataset.panel === target);
          });
        };

        const stopScenarioRotation = () => {
          if (scenarioRotation === undefined) return;
          window.clearInterval(scenarioRotation);
          scenarioRotation = undefined;
        };

        const startScenarioRotation = () => {
          stopScenarioRotation();
          if (scenarioTabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          scenarioRotation = window.setInterval(() => {
            const current = scenarioTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
            activateScenario(scenarioTabs[(current + 1) % scenarioTabs.length]);
          }, 4000);
        };

        scenarioTabs.forEach((tab) => tab.addEventListener("click", () => {
          activateScenario(tab);
          startScenarioRotation();
        }));
        scenarioSuite.addEventListener("mouseenter", stopScenarioRotation);
        scenarioSuite.addEventListener("mouseleave", startScenarioRotation);
        scenarioSuite.addEventListener("focusin", stopScenarioRotation);
        scenarioSuite.addEventListener("focusout", (event) => {
          if (!(event.relatedTarget instanceof Node) || !scenarioSuite.contains(event.relatedTarget)) startScenarioRotation();
        });
        document.addEventListener("visibilitychange", () => document.hidden ? stopScenarioRotation() : startScenarioRotation());
        startScenarioRotation();
      }
    </script>

    <section id="hs-choice" class="hs-choice-spotlight">
      <div class="hs-choice-spotlight__header">
        <p class="hs-kicker">Data quality controls</p>
        <h2>Choose how EventHex handles a contact it already finds</h2>
      </div>

      <div class="hs-choice-spotlight__grid">
        <article class="hs-choice-spotlight__cell hs-choice-spotlight__cell--copy">
          <div class="hs-choice-spotlight__copy">
            <span class="hs-choice-spotlight__icon" aria-hidden="true">＋</span>
            <h3>Create when no match exists</h3>
            <p>Use the mapped email to create a HubSpot contact when one is not found.</p>
            <b>New contact</b>
          </div>
        </article>

        <div class="hs-choice-spotlight__cell hs-choice-spotlight__cell--media">
          <div class="hs-choice-spotlight__visual">
            <div class="hs-choice-spotlight__screen-wrap">
              <img
                src="/images/platform-analytics-dashboard.jpg"
                alt="EventHex platform analytics dashboard showing event creation and registration activity"
                width="1262"
                height="697"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <div class="hs-choice-spotlight__cell hs-choice-spotlight__cell--media">
          <div class="hs-choice-spotlight__visual hs-choice-spotlight__visual--update">
            <div class="hs-choice-spotlight__screen-wrap">
              <img
                src="/images/_tmp-analytics-reference.png"
                alt="EventHex platform analytics dashboard with registration and check-in trend reporting"
                width="1262"
                height="697"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <article class="hs-choice-spotlight__cell hs-choice-spotlight__cell--copy">
          <div class="hs-choice-spotlight__copy">
            <span class="hs-choice-spotlight__icon" aria-hidden="true">↻</span>
            <h3>Update an existing match</h3>
            <p>Turn on update-existing behavior when the event should refresh the matched contact properties.</p>
            <b>Existing contact</b>
          </div>
        </article>

        <span class="hs-choice-spotlight__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="scale(1,-1)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(90)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#eef0f3" transform="rotate(-90)" />
          </svg>
        </span>
      </div>

      <p class="hs-choice-spotlight__note"><span aria-hidden="true">i</span> The verified direction is EventHex to HubSpot. No HubSpot-to-EventHex synchronization is promised on this page.</p>
    </section>

