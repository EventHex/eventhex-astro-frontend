    <script>
      const linkedWorkflowSection = document.querySelector<HTMLElement>('.hs-linked-workflows');
      const linkedWorkflowHeader = linkedWorkflowSection?.querySelector<HTMLElement>('.hs-linked-workflows__header');
      const linkedWorkflowCards = linkedWorkflowSection?.querySelectorAll<HTMLElement>('.hs-linked-workflows__card');
      const finalLinkedWorkflowCard = linkedWorkflowCards?.[linkedWorkflowCards.length - 1];

      if (linkedWorkflowHeader && finalLinkedWorkflowCard) {
        let linkedWorkflowFrame = 0;
        const syncLinkedWorkflowRelease = () => {
          linkedWorkflowFrame = 0;
          const stickyTop = Number.parseFloat(getComputedStyle(finalLinkedWorkflowCard).top) || 0;
          const releaseOffset = Math.min(0, finalLinkedWorkflowCard.getBoundingClientRect().top - stickyTop);
          linkedWorkflowHeader.style.setProperty('--hs-linked-release-y', `${releaseOffset}px`);
          linkedWorkflowHeader.style.transform = `translateY(${releaseOffset}px)`;
        };
        const queueLinkedWorkflowRelease = () => {
          if (linkedWorkflowFrame) return;
          linkedWorkflowFrame = requestAnimationFrame(syncLinkedWorkflowRelease);
        };

        window.addEventListener('scroll', queueLinkedWorkflowRelease, { passive: true });
        window.addEventListener('resize', queueLinkedWorkflowRelease, { passive: true });
        syncLinkedWorkflowRelease();
      }
    </script>

