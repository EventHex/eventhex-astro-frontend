<script>
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".tpi-faq details"));
  faqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const stateItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".tpi-state-steps details"));
  stateItems.forEach((item) => {
    const arrow = item.querySelector<HTMLButtonElement>(".tpi-state-step__arrow");
    item.addEventListener("toggle", () => {
      arrow?.setAttribute("aria-expanded", String(item.open));
      arrow?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} payment record step`);
      if (!item.open) return;
      stateItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const lifecycleCards = Array.from(document.querySelectorAll<HTMLElement>(".tpi-lifecycle-card"));
  if (lifecycleCards.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let lifecycleFrame = 0;
    const syncLifecycleStack = () => {
      lifecycleFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(lifecycleCards[0]).top) || 80;
      lifecycleCards.forEach((card) => {
        const distance = card.getBoundingClientRect().top - stickyTop;
        const progress = Math.max(0, Math.min(1, 1 - distance / 180));
        card.style.setProperty("--stack-progress", progress.toFixed(3));
      });
    };
    const queueLifecycleStack = () => {
      if (lifecycleFrame) return;
      lifecycleFrame = requestAnimationFrame(syncLifecycleStack);
    };
    window.addEventListener("scroll", queueLifecycleStack, { passive: true });
    window.addEventListener("resize", queueLifecycleStack, { passive: true });
    syncLifecycleStack();
  }

  const usecaseShell = document.querySelector<HTMLElement>(".tpi-usecase-shell");
  const usecaseHeader = usecaseShell?.querySelector<HTMLElement>(".tpi-usecase-header");
  const usecaseCards = usecaseShell?.querySelectorAll<HTMLElement>(".tpi-usecase-card");
  const finalUsecaseCard = usecaseCards?.[usecaseCards.length - 1];
  if (usecaseHeader && finalUsecaseCard) {
    let usecaseFrame = 0;
    const syncUsecaseRelease = () => {
      usecaseFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalUsecaseCard).top) || 0;
      const releaseOffset = Math.min(0, finalUsecaseCard.getBoundingClientRect().top - stickyTop);
      usecaseHeader.style.setProperty("--tpi-usecase-release-y", `${releaseOffset}px`);
      usecaseHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueUsecaseRelease = () => {
      if (usecaseFrame) return;
      usecaseFrame = requestAnimationFrame(syncUsecaseRelease);
    };
    window.addEventListener("scroll", queueUsecaseRelease, { passive: true });
    window.addEventListener("resize", queueUsecaseRelease, { passive: true });
    syncUsecaseRelease();
  }

  if (usecaseCards?.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const usecaseRevealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.18 });
    usecaseCards.forEach((card) => {
      card.classList.add("tpi-usecase-card--reveal");
      usecaseRevealObserver.observe(card);
    });
  } else {
    usecaseCards?.forEach((card) => card.classList.add("is-visible"));
  }

  const linkSwitcher = document.querySelector<HTMLElement>(".tpi-links-switcher");
  const linkTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-link-tab]"));
  const linkPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-link-panel]"));
  if (linkSwitcher && linkTabs.length && linkPanels.length) {
    let activeLinkIndex = 0;
    let linkTimer = 0;
    const reduceLinkMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const setLinkPanel = (nextIndex: number, moveFocus = false) => {
      activeLinkIndex = (nextIndex + linkTabs.length) % linkTabs.length;
      linkTabs.forEach((tab, index) => {
        const active = index === activeLinkIndex;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      linkPanels.forEach((panel, index) => {
        const active = index === activeLinkIndex;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
      if (moveFocus) linkTabs[activeLinkIndex].focus();
    };
    const stopLinkRotation = () => {
      if (linkTimer) window.clearInterval(linkTimer);
      linkTimer = 0;
    };
    const startLinkRotation = () => {
      stopLinkRotation();
      if (!reduceLinkMotion.matches) linkTimer = window.setInterval(() => setLinkPanel(activeLinkIndex + 1), 4000);
    };
    linkTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => { setLinkPanel(index); startLinkRotation(); });
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowDown") { event.preventDefault(); setLinkPanel(index + 1, true); }
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") { event.preventDefault(); setLinkPanel(index - 1, true); }
        if (event.key === "Home") { event.preventDefault(); setLinkPanel(0, true); }
        if (event.key === "End") { event.preventDefault(); setLinkPanel(linkTabs.length - 1, true); }
      });
    });
    linkSwitcher.addEventListener("mouseenter", stopLinkRotation);
    linkSwitcher.addEventListener("mouseleave", startLinkRotation);
    linkSwitcher.addEventListener("focusin", stopLinkRotation);
    linkSwitcher.addEventListener("focusout", (event) => {
      if (!linkSwitcher.contains(event.relatedTarget as Node | null)) startLinkRotation();
    });
    reduceLinkMotion.addEventListener?.("change", startLinkRotation);
    setLinkPanel(0);
    startLinkRotation();
  }
</script>

