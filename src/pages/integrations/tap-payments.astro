  .tpi-usecase-shell { position: relative; width: 100%; background-color: #000; background-image: linear-gradient(180deg,#0d0a2c 0%,transparent 320px),radial-gradient(circle at 12% 30%,rgba(70,130,255,.28) 0%,transparent 55%); background-repeat: no-repeat; background-size: 100% 100%,120% 120%; animation: tpi-usecase-mesh 30s linear infinite; color: #fff; }
