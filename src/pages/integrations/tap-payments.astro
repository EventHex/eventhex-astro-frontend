---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "Tap Payments Integration for GCC Events | EventHex";
const description =
  "Connect Tap Payments to EventHex ticket checkout, use the supported currency-aware payment path, track order status, and manage full or partial refunds.";

const lifecycle = [
  {
    title: "Configure the connection",
    copy: "Choose the event or organization connection and save the supported Tap credentials before tickets go on sale.",
    image: "/images/razorpay-platform-analytics-organizations.png",
    alt: "EventHex Platform Analytics organization view used as a connection setup reference",
    width: 1262,
    height: 697,
  },
  {
    title: "Price in event currency",
    copy: "Keep the ticket amount and event currency together so the supported Tap source can be selected for the order.",
    image: "/images/razorpay-platform-analytics-overview.png",
    alt: "EventHex Platform Analytics overview with event metrics used as an event currency reference",
    width: 790,
    height: 492,
  },
  {
    title: "Hand off to checkout",
    copy: "Create the provider charge from the EventHex order and send the buyer through the returned Tap payment path.",
    image: "/images/razorpay-platform-analytics-order-context.png",
    alt: "EventHex Platform Analytics dashboard used as an order context reference for provider handoff",
    width: 790,
    height: 492,
  },
  {
    title: "Confirm the payment",
    copy: "Confirmation and webhook paths attach the Tap result to the same order, including captured, pending, or failed state.",
    image: "/images/razorpay-platform-analytics-payment-result.png",
    alt: "EventHex Platform Analytics usage view used as a payment result reference",
    width: 1262,
    height: 697,
  },
  {
    title: "Continue to the ticket",
    copy: "Use the confirmed order for registration outcome, ticket delivery, and any order-linked invoice handling.",
    image: "/images/razorpay-platform-analytics-ticket-continuation.png",
    alt: "EventHex Platform Analytics registration and check-in view used as a ticket continuation reference",
    width: 1262,
    height: 697,
  },
  {
    title: "Review refunds and finance",
    copy: "Keep refund history and provider context available for the event team’s operational and finance review.",
    image: "/images/razorpay-platform-analytics-usage.png",
    alt: "EventHex Platform Analytics feature usage view used as a finance review reference",
    width: 1262,
    height: 697,
  },
];

const setupSteps = [
  ["Choose the gateway", "Select Tap Payments in the supported payment settings."],
  ["Add credentials", "Add the supported public and secret keys; saved secrets remain masked in organizer responses."],
  ["Confirm event currency", "Use an event currency supported by the Tap runtime and confirm that the required source is enabled for the merchant account."],
  ["Test the paid journey", "Run the event's own checkout and confirmation path before launch."],
];

const checkoutCards = [
  ["Order context", "Keep buyer, ticket, amount, currency, and recorded tax context together."],
  ["Provider handoff", "EventHex creates a Tap charge using the event currency and selected or currency-mapped source, then sends the buyer through the returned payment URL."],
  ["Payment result", "Tap charge confirmation and webhook paths update the order with captured or authorized state."],
  ["Ticket continuation", "Use the confirmed order for registration outcome, ticket delivery, and invoice handling."],
];

const marketSources = [
  ["Kuwait", "KWD can surface the configured KNET source in the supported path."],
  ["Saudi Arabia", "SAR can surface the configured mada source in the supported path."],
  ["Bahrain", "BHD can surface the configured BENEFIT source; Apple Pay and card sources are also represented in runtime options."],
];

const marketVisuals = [
  { src: "/images/razorpay-platform-analytics-organizations.png", alt: "EventHex Platform Analytics organization view for Kuwait payment source setup", width: 1262, height: 697 },
  { src: "/images/razorpay-platform-analytics-overview.png", alt: "EventHex Platform Analytics overview for Saudi event currency context", width: 790, height: 492 },
  { src: "/images/razorpay-platform-analytics-payment-result.png", alt: "EventHex Platform Analytics payment result view for Bahrain payment context", width: 1262, height: 697 },
];

const marketSpotlightVisuals = [
  {
    primary: marketVisuals[0],
    secondary: { src: "/images/razorpay-platform-analytics-provider-handoff.png", alt: "EventHex Platform Analytics provider handoff view for Kuwait payment source setup", width: 1262, height: 697 },
    detail: { src: "/images/razorpay-platform-analytics-reference.png", alt: "EventHex Platform Analytics payment record detail for Kuwait", width: 1262, height: 697 },
    status: "KWD · KNET",
    action: "View source",
  },
  {
    primary: marketVisuals[1],
    secondary: { src: "/images/razorpay-platform-analytics-organizations.png", alt: "EventHex Platform Analytics organization view for Saudi event currency context", width: 1262, height: 697 },
    detail: { src: "/images/razorpay-platform-analytics-ticket-continuation.png", alt: "EventHex Platform Analytics ticket continuation detail for Saudi Arabia", width: 1262, height: 697 },
    status: "SAR · mada",
    action: "View source",
  },
  {
    primary: marketVisuals[2],
    secondary: { src: "/images/razorpay-platform-analytics-usage.png", alt: "EventHex Platform Analytics usage view for Bahrain payment context", width: 1262, height: 697 },
    detail: { src: "/images/razorpay-platform-analytics-overview.png", alt: "EventHex Platform Analytics event overview detail for Bahrain", width: 790, height: 492 },
    status: "BHD · BENEFIT",
    action: "View source",
  },
];

const paymentStates = [
  ["Gateway", "Identify Tap Payments as the order's payment path."],
  ["Amount and currency", "Keep the value beside the event order."],
  ["Captured or pending", "Separate completed payment from a state that still needs attention."],
  ["Failure context", "Keep an unsuccessful attempt distinct from a successful order."],
  ["Refund history", "See returned value and the remaining refundable amount."],
  ["Buyer and tickets", "Trace the payment back to the registration it belongs to."],
];

const paymentStateVisuals = [
  { src: "/images/razorpay-platform-analytics-reference.png", alt: "EventHex Platform Analytics dashboard used as a gateway record reference", width: 1262, height: 697 },
  { src: "/images/razorpay-platform-analytics-overview.png", alt: "EventHex Platform Analytics overview used as an amount and currency reference", width: 790, height: 492 },
  { src: "/images/razorpay-platform-analytics-organizations.png", alt: "EventHex Platform Analytics organization view used as a captured or pending payment reference", width: 1262, height: 697 },
  { src: "/images/razorpay-platform-analytics-payment-result.png", alt: "EventHex Platform Analytics feature usage view used as a payment failure context reference", width: 1262, height: 697 },
  { src: "/images/razorpay-platform-analytics-usage.png", alt: "EventHex Platform Analytics usage view used as a refund history reference", width: 1262, height: 697 },
  { src: "/images/razorpay-platform-analytics-ticket-continuation.png", alt: "EventHex Platform Analytics registration and check-in view used as a buyer and ticket reference", width: 1262, height: 697 },
];

const refundCards = [
  ["Full refund", "Return the remaining eligible paid amount."],
  ["Partial refund", "Enter a smaller amount when only part of the order should be returned."],
  ["Balance guard", "Prevent refund requests above the paid total minus earlier refunds."],
  ["Recorded outcome", "Keep the refund result beside the original event payment."],
];

const useCases = [
  { title: "GCC conferences", desc: "Keep the regional provider handoff connected to EventHex ticket orders.", image: "/images/razorpay-platform-analytics-organizations.png", alt: "EventHex Platform Analytics organization view for a GCC conference payment workflow", width: 1262, height: 697, eyebrow: "Connected GCC flow" },
  { title: "Multi-country organizers", desc: "Validate currency and source behavior separately for every market launch.", image: "/images/razorpay-platform-analytics-overview.png", alt: "EventHex Platform Analytics overview for comparing multi-country event payment context", width: 790, height: 492 },
  { title: "Corporate events", desc: "Use event- or organization-level credentials according to the merchant setup.", image: "/images/razorpay-platform-analytics-order-context.png", alt: "EventHex Platform Analytics order context for a corporate event payment workflow", width: 790, height: 492 },
  { title: "Exhibitions", desc: "Track delegate or visitor payments and supported refunds alongside registration.", image: "/images/razorpay-platform-analytics-usage.png", alt: "EventHex Platform Analytics usage view for exhibition payment and registration review", width: 1262, height: 697 },
];

const connectedPages = [
  {
    id: "payment-processing",
    label: "Payment processing",
    title: "Event Payment Processing",
    description: "Compare supported gateway paths and event-level finance workflow.",
    href: "/event-payment-processing/",
    image: "/images/razorpay-platform-analytics-reference.png",
    alt: "EventHex Platform Analytics dashboard showing an event payment processing record",
    width: 1262,
    height: 697,
    visualLabel: "Payment record",
    bullets: ["Compare supported gateway paths", "Keep event-level finance context", "Trace each provider record to its order"],
  },
  {
    id: "ticketing",
    label: "Ticketing",
    title: "Event Ticketing",
    description: "Configure ticket price, capacity, sale windows, approvals, and discounts.",
    href: "/event-ticketing/",
    image: "/images/razorpay-platform-analytics-overview.png",
    alt: "EventHex Platform Analytics overview showing ticketing and event metrics",
    width: 790,
    height: 492,
    visualLabel: "Event overview",
    bullets: ["Set ticket price and capacity", "Control sale windows and approvals", "Apply discounts before checkout"],
  },
  {
    id: "registration",
    label: "Registration",
    title: "Event Registration",
    description: "Choose the form or checkout journey that creates the order.",
    href: "/event-registration/",
    image: "/images/razorpay-platform-analytics-order-context.png",
    alt: "EventHex Platform Analytics order context showing a registration checkout record",
    width: 790,
    height: 492,
    visualLabel: "Order context",
    bullets: ["Choose the registration journey", "Keep buyer and ticket context together", "Create the order for payment"],
  },
  {
    id: "invoicing",
    label: "Invoicing and tax",
    title: "Invoicing and tax",
    description: "Collect billing details and create an order-linked invoice with configured tax lines.",
    href: "/invoicing-gst/",
    image: "/images/razorpay-platform-analytics-usage.png",
    alt: "EventHex Platform Analytics usage view showing an order-linked finance review",
    width: 1262,
    height: 697,
    visualLabel: "Finance review",
    bullets: ["Collect billing details", "Create an order-linked invoice", "Keep configured tax lines with the order"],
  },
];

const faqs = [
  ["Which GCC payment sources are represented in the EventHex Tap path?", "The runtime includes currency-aware options such as KNET for KWD, mada for SAR, BENEFIT for BHD, plus card and Apple Pay sources. Availability must be confirmed for the connected merchant account."],
  ["Can we use our existing Tap account?", "Yes, EventHex supports Tap credentials at event or organization level. Confirm the account, currency, and enabled sources before launch."],
  ["Can organizers issue refunds?", "Authorized organizers can request full or partial refunds through the supported Tap path, up to the remaining refundable amount."],
  ["Does EventHex guarantee local settlement or zero platform fees?", "No universal settlement or fee promise is established by the integration evidence. Review the EventHex commercial setup and Tap merchant terms."],
  ["Does the page guarantee VAT compliance?", "No. EventHex can record configured tax lines and generate order-linked invoices, but jurisdictional tax treatment remains the organizer's responsibility."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Tap Payments Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/integrations/tap-payments/",
  description,
  featureList: [
    "Tap Payments event and organization configuration",
    "Currency-aware GCC payment sources",
    "Order-linked payment status",
    "Full and partial refunds",
    "Event finance context",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/integrations/tap-payments/"
  footerCtaEyebrow="Plan the Tap Payments connection"
  footerCtaTitle="Bring one paid event to the demo"
  footerCtaSubtitle="Show us the market, event currency, ticket flow, Tap Payments account setup, refund process, and finance needs. We’ll walk through the supported EventHex path and identify anything that needs separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform on laptop, tablet, and mobile"
  footerCtaImageLoading="eager"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="tpi-page">
    <section class="tpi-hero">
      <div class="tpi-shell tpi-hero__grid">
        <div class="tpi-hero__content">
          <span class="tpi-eyebrow animate-on-scroll" data-animation="fadeInDown">Tap Payments integration for events</span>
          <h1 class="tpi-hero__title animate-on-scroll" data-animation="fadeInUp">Connect Tap Payments to your <span>GCC event checkout</span></h1>
          <p class="tpi-hero__lead animate-on-scroll" data-animation="fadeInUp">Use the supported Tap Payments path for a GCC-first paid event, keep the provider charge tied to the EventHex order, and manage payment and refund state from the event workflow.</p>
          <div class="tpi-hero__actions animate-on-scroll" data-animation="fadeInUp">
            <a class="tpi-btn tpi-btn--primary" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
            <a class="tpi-btn tpi-btn--secondary" href="#tpi-lifecycle">See the Tap Payments flow</a>
          </div>
          <div class="tpi-hero__proof" aria-label="Integration highlights">
            <span>Supported merchant account</span>
            <span>Order-linked status</span>
            <span>Full or partial refunds</span>
          </div>
        </div>
        <div class="tpi-hero__visual animate-on-scroll" data-animation="fadeInRight" aria-label="EventHex Platform Analytics payment result and finance context">
          <img class="tpi-hero__image" src="/images/razorpay-platform-analytics-payment-result.png" alt="EventHex Platform Analytics payment result and finance context" width="1262" height="697" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section class="tpi-trust-strip" aria-label="Tap Payments workflow highlights">
      <div class="tpi-trust-strip__inner"><span class="tpi-trust-strip__stat"><b>Event</b> or organization connection</span><span class="tpi-trust-strip__stat"><b>Currency-aware</b> payment source</span><span class="tpi-trust-strip__stat"><b>Captured or pending</b> order state</span><span class="tpi-trust-strip__stat"><b>Refund</b> and finance context</span></div>
    </section>

    <section class="tpi-section tpi-scope">
      <div class="tpi-shell tpi-scope__inner">
        <div class="tpi-section-heading tpi-scope__heading"><h2>Use Tap Payments at the level that matches your event portfolio</h2><p>EventHex can resolve a supported Tap Payments configuration from the event or the organization before checkout begins.</p></div>
        <div class="tpi-scope__grid">
          <article class="tpi-scope__cell tpi-scope__cell--copy">
            <span class="tpi-card-number">01</span>
            <h3>Event-level connection</h3>
            <p>Use Tap Payments credentials for one event when its account, market, or commercial setup differs.</p>
            <span class="tpi-chip">Specific event</span>
          </article>
          <div class="tpi-scope__cell tpi-scope__cell--media">
            <div class="tpi-scope__composite">
              <img class="tpi-scope__screen tpi-scope__screen--primary" src="/images/razorpay-platform-analytics-organizations.png" alt="EventHex Platform Analytics organization view for an event-level connection reference" width="1262" height="697" loading="lazy" decoding="async" />
              <img class="tpi-scope__screen tpi-scope__screen--secondary" src="/images/razorpay-platform-analytics-reference.png" alt="EventHex Platform Analytics overview supporting an event-level connection reference" width="1262" height="697" loading="lazy" decoding="async" />
              <span class="tpi-scope__status"><span aria-hidden="true">✓</span> Specific event</span>
              <span class="tpi-scope__action">Save connection</span>
            </div>
          </div>
          <div class="tpi-scope__cell tpi-scope__cell--media">
            <div class="tpi-scope__composite">
              <img class="tpi-scope__screen tpi-scope__screen--primary" src="/images/razorpay-platform-analytics-overview.png" alt="EventHex Platform Analytics overview for an organization-level connection reference" width="790" height="492" loading="lazy" decoding="async" />
              <img class="tpi-scope__screen tpi-scope__screen--secondary" src="/images/razorpay-platform-analytics-usage.png" alt="EventHex Platform Analytics feature usage view supporting an organization portfolio reference" width="1262" height="697" loading="lazy" decoding="async" />
              <span class="tpi-scope__status"><span aria-hidden="true">✓</span> Repeat portfolio</span>
              <span class="tpi-scope__action">Use organization</span>
            </div>
          </div>
          <article class="tpi-scope__cell tpi-scope__cell--copy">
            <span class="tpi-card-number">02</span>
            <h3>Organization-level connection</h3>
            <p>Reuse the organization's supported Tap Payments configuration across events that select Organization Payment.</p>
            <span class="tpi-chip">Repeat portfolio</span>
          </article>
        </div>
      </div>
    </section>

    <section id="tpi-lifecycle" class="tpi-section tpi-lifecycle">
      <div class="tpi-lifecycle__container">
        <div class="tpi-lifecycle__left">
          <div class="tpi-lifecycle__sticky animate-on-scroll" data-animation="fadeInUp">
            <span class="tpi-lifecycle__eyebrow"><span aria-hidden="true">✦</span> One connected payment path</span>
            <h2>What happens after Tap Payments is selected</h2>
            <p>From organizer setup to a recorded refund, each stage stays connected to the event order.</p>
            <a class="tpi-lifecycle__cta" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="tpi-lifecycle__right">
          {lifecycle.map((item, index) => (
            <article class="tpi-lifecycle-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)} style={`--card-index: ${index};`}>
              <div class="tpi-lifecycle-card__header">
                <span class="tpi-lifecycle-card__number">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                </div>
              </div>
              <div class:list={["tpi-lifecycle-card__visual", `tpi-lifecycle-card__visual--${index + 1}`]}>
                <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
                <span class="tpi-lifecycle-card__status"><span aria-hidden="true">✓</span> EventHex workflow</span>
                <span class="tpi-lifecycle-card__action">{index === 0 ? "Save connection" : index === 5 ? "Review record" : "Continue"}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tpi-section tpi-setup">
      <div class="tpi-shell">
        <div class="tpi-section-heading tpi-section-heading--center tpi-setup__heading"><h2>Connect the account before tickets go on sale</h2></div>
        <div class="tpi-step-grid">
          {[1, 2, 3].map((index) => <span class:list={["tpi-step-grid__notch", `tpi-step-grid__notch--${index}`]} aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--tpi-line)"></path></svg></span>)}
          {setupSteps.map(([stepTitle, stepDescription], index) => <article>
            <div class="tpi-step-icon" aria-hidden="true">
              {index === 0 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M7 4v6M17 4v6M5 11h14v8H5z"></path><path d="M8 15h3"></path></svg> : index === 1 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18M7 15h4"></path></svg> : index === 2 ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M9.5 9.5c.5-1 1.4-1.5 2.7-1.5 1.5 0 2.3.7 2.3 1.7 0 2.8-5 1.1-5 4 0 1.1.9 1.8 2.5 1.8 1.3 0 2.2-.5 2.8-1.5"></path></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.3-5.7"></path><path d="M4 5v5h5"></path><path d="m9 12 2 2 4-4"></path></svg>}
            </div>
            <div class="tpi-step-grid__content"><span class="tpi-step-grid__number">{String(index + 1).padStart(2, "0")}</span><h3>{stepTitle}</h3><p>{stepDescription}</p></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="tpi-section tpi-dark-section">
      <div class="tpi-shell">
        <div class="tpi-section-heading tpi-section-heading--center tpi-section-heading--light"><h2>Keep Tap Payments connected to the ticket order</h2><p>The event configuration determines the gateway; the buyer continues through the Tap Payments path tied to that order.</p></div>
        <div class="tpi-bento-grid">
          {[1, 2, 3].map((index) => <span class:list={["tpi-bento-notch", `tpi-bento-notch--${index}`]} aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg></span>)}
          {checkoutCards.map(([cardTitle, cardDescription], index) => <article class:list={["tpi-bento-card", index === 1 && "tpi-bento-card--featured", `tpi-bento-card--${index + 1}`]}><span class="tpi-bento-card__icon">{String(index + 1).padStart(2, "0")}</span><h3>{cardTitle}</h3><p>{cardDescription}</p>{index === 0 ? <div class="tpi-mini-ui tpi-mini-ui--1" aria-hidden="true"><span class="tpi-mini-record"><i>ORDER</i><em></em></span><span class="tpi-mini-record"><i>TICKET</i><em></em></span></div> : index === 2 ? <div class="tpi-mini-ui tpi-result-ui" aria-hidden="true"><div class="tpi-result-ui__header"><i>PAYMENT RESULT</i><b>LIVE</b></div><div class="tpi-result-ui__row"><span>Captured</span><em></em><b>✓</b></div><div class="tpi-result-ui__row"><span>Webhook</span><em></em><b>✓</b></div><div class="tpi-result-ui__row"><span>Order updated</span><em></em><b>✓</b></div></div> : index === 3 ? <div class="tpi-mini-ui tpi-ticket-ui" aria-hidden="true"><span class="tpi-ticket-ui__label">TICKET FLOW</span><div class="tpi-ticket-ui__chips"><i>Registration</i><i>Ticket issued</i><i>Check-in</i><i>Invoice</i><i>Attendee pass</i><i>Ready</i></div><b class="tpi-ticket-ui__cursor"></b></div> : <div class:list={["tpi-mini-ui", `tpi-mini-ui--${index + 1}`]} aria-hidden="true"><span></span><span></span><b></b></div>}</article>)}
        </div>
      </div>
    </section>

    <section class="tpi-section tpi-market tpi-market-spotlight">
      <div class="tpi-market-spotlight__header">
        <h2 class="tpi-market-spotlight__title animate-on-scroll" data-animation="fadeInUp">Match the checkout source to the event currency</h2>
        <p class="tpi-market-spotlight__subtitle animate-on-scroll" data-animation="fadeInUp">The current EventHex Tap path contains currency-aware source options for GCC markets. Availability still depends on the merchant account, currency, and Tap configuration.</p>
      </div>

      <div class="tpi-market-spotlight__grid">
        {marketSources.map(([country, source], index) => {
          const visual = marketSpotlightVisuals[index];
          return <article class:list={["tpi-market-spotlight__row", index % 2 === 1 && "is-reversed"]}>
            <div class="tpi-market-spotlight__copy animate-on-scroll" data-animation={index % 2 === 1 ? "fadeInRight" : "fadeInLeft"}>
              <span class="tpi-market-spotlight__number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{country}</h3>
              <p>{source}</p>
            </div>

            <div class="tpi-market-spotlight__media animate-on-scroll" data-animation={index % 2 === 1 ? "fadeInLeft" : "fadeInRight"}>
              <div class="tpi-market-spotlight__composite">
                <img class="tpi-market-spotlight__screen tpi-market-spotlight__screen--primary" src={visual.primary.src} alt={visual.primary.alt} width={visual.primary.width} height={visual.primary.height} loading="lazy" decoding="async" />
                <img class="tpi-market-spotlight__screen tpi-market-spotlight__screen--secondary" src={visual.secondary.src} alt={visual.secondary.alt} width={visual.secondary.width} height={visual.secondary.height} loading="lazy" decoding="async" />
                <img class="tpi-market-spotlight__screen tpi-market-spotlight__screen--detail" src={visual.detail.src} alt={visual.detail.alt} width={visual.detail.width} height={visual.detail.height} loading="lazy" decoding="async" />
