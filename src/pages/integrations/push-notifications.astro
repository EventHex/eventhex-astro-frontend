---
import PushNotificationsPage from "../../components/integrations/push-notifications/PushNotificationsPage.astro";

const title = "Firebase Push Notification Integration for Events | EventHex";
const description = "Configure Firebase for the event app, register active device tokens, respect attendee push preferences, and send supported iOS and Android notification payloads.";
const canonical = "https://eventhex.ai/integrations/push-notifications/";

const faqs: [string, string][] = [
  ["Does EventHex support iOS and Android push paths?", "Yes. The current sender builds Android and APNs payloads through Firebase Cloud Messaging. The attendee still needs the relevant event app and push permission."],
  ["What Firebase credentials are required?", "The configuration accepts Firebase service-account fields such as project ID, private key, client email, and related authentication URLs. Validate the exact deployment requirements with the EventHex team."],
  ["Can we store configuration for one event?", "The API model supports event, organization, and global scopes. Confirm which configuration the target app build and delivery environment will use."],
  ["What happens when an attendee disables push?", "The send path checks the user's notification setting and skips device delivery when push is disabled."],
  ["Can EventHex guarantee delivery in under one second?", "No. Delivery timing depends on Firebase, Apple/Google services, network state, the device, and app conditions. This page makes no latency guarantee."],
  ["Can we track opens and clicks?", "The verified integration reports provider send success/failure and invalid tokens. A customer-facing open/click analytics surface was not verified for this page."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Firebase Push Notification Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, iOS, Android",
  url: canonical,
  description,
};
---

<PushNotificationsPage {title} {description} {canonical} {faqs} faqSchema={faqSchema} softwareSchema={softwareSchema} />
