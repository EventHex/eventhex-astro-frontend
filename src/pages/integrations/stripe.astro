---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import StripePage from "../../components/integrations/StripePage.astro";

const title = "Stripe Integration for Event Ticket Payments | EventHex";
const description = "Connect a supported Stripe account to EventHex ticket checkout, keep payment status tied to event orders, and manage full or partial refunds.";
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Stripe Integration",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/integrations/stripe/",
  description,
  featureList: [
    "Connect a supported Stripe account",
    "Keep payment status tied to event orders",
    "Manage full or partial refunds",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/integrations/stripe/"
  footerCtaTitle="Bring one paid event to the demo"
  footerCtaEyebrow="Trusted Event Platform"
  footerCtaSubtitle="Show us the market, event currency, ticket flow, Stripe account setup, refund process, and finance needs. We’ll walk through the supported EventHex path and identify anything that needs separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </Fragment>
  <StripePage />
</MarketingLayout>
