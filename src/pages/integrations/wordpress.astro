---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import IntegrationFaq from "../../components/integrations/IntegrationFaq.astro";
import FourColumnFeatureStrip from "../../components/integrations/FourColumnFeatureStrip.astro";

const title = "EventHex WordPress Event Feed Integration";
const description = "Connect WordPress to a read-only EventHex feed, import eligible upcoming events as drafts, include speakers, review connection status, and revoke access.";

const feedItems = [
  ["Event details", "Title, dates, country, presentation fields, and other formatted event content supported by the feed."],
  ["Event domain", "Use the event’s active or default EventHex domain where available."],
  ["Speakers", "Include registration-backed or legacy speaker data when publication settings allow it."],
  ["Publication state", "Expose whether an event is eligible for the connected site policy."],
];
const feedImages = [
  "/feature-images/wordpress/read-only-feed.png",
  "/feature-images/wordpress/integrations-overview.png",
  "/feature-images/wordpress/scoped-access.png",
  "/feature-images/wordpress/developer-connection.png",
];

const statusItems = [
  ["Connection summary", "Read organization name, region, site label, URL, import policy, and upcoming counts.", "/feature-images/wordpress/developer-connection.png"],
  ["Event-status feed", "Read active and WordPress-publication state for the organization’s events.", "/feature-images/wordpress/integrations-overview.png"],
  ["Pagination", "Request event and status pages with bounded page sizes.", "/feature-images/wordpress/read-only-feed.png"],
  ["Updated since", "Request events changed after a supplied date for an incremental refresh.", "/feature-images/wordpress/scoped-access.png"],
  ["Single event", "Fetch one upcoming event by its EventHex identifier.", "/feature-images/wordpress/developer-connection.png"],
  ["Eligibility filter", "Request only events that meet the connection’s enabled or publication policy.", "/feature-images/wordpress/integrations-overview.png"],
];

const useCases = [
  ["Associations", "Bring upcoming chapter or member events into the existing organization site as drafts."],
  ["Conference portfolios", "Import event and speaker content for editorial review on a central WordPress property."],
  ["Event agencies", "Connect an approved client site without giving the plugin organizer-level credentials."],
  ["Corporate event hubs", "Maintain a reviewed WordPress event directory from eligible EventHex source records."],
];
const useCaseImages = [
  ["/feature-images/wordpress/read-only-feed.png", "Draft feed ready", "Chapter events", "Eligible content"],
  ["/feature-images/wordpress/integrations-overview.png", "Portfolio connected", "Central review", "Speakers included"],
  ["/feature-images/wordpress/scoped-access.png", "Client access", "Read-only key", "Revoke anytime"],
  ["/feature-images/wordpress/developer-connection.png", "Directory synced", "Draft first", "Editorial control"],
];

const related = [
  ["Event Website Builder", "Build and publish a complete EventHex event site when WordPress is not the destination.", "/event-website-builder/"],
  ["Event Registration", "Choose the EventHex form or checkout journey used by attendees.", "/event-registration/"],
  ["Event Ticketing", "Configure ticket types, sales rules, capacity, and delivery.", "/event-ticketing/"],
  ["Developers", "Review the broader EventHex API for a custom integration beyond this connector.", "/developers/"],
];
const relatedImages = [
  "/feature-images/wordpress/integrations-overview.png",
  "/feature-images/event-registration/single-registration-form.png",
  "/feature-images/event-registration/single-ticket-list.png",
  "/feature-images/wordpress/developer-connection.png",
];
const relatedBullets = [
  ["EventHex-hosted event site", "Custom domain and branded pages", "Live event content"],
  ["Custom registration forms", "Attendee checkout journey", "Confirmation workflows"],
  ["Ticket types and capacity", "Sales and payment rules", "Digital ticket delivery"],
  ["Custom API integrations", "Read-only connection keys", "Controlled data access"],
];

const faqs = [
  ["What does the current WordPress connection import?", "The verified site feed provides eligible upcoming event content and speaker data. The key-only connector flow imports upcoming events, including inactive ones, as drafts."],
  ["Can the connector publish events automatically?", "The verified flow creates WordPress drafts for local review. WordPress publication remains a separate editorial decision."],
  ["Is the connection key read-only?", "Yes. The site integration stores read permissions for events and speakers, and a connector key cannot mint additional site keys."],
  ["Can we revoke a connected site?", "Yes. An authorized EventHex user can revoke the key; the connected site then stops authenticating to the feed."],
  ["Does it embed EventHex checkout inside WordPress?", "Embedded registration, checkout, attendee portal, blocks, and shortcodes were not verified in the current connector and are not promised here."],
  ["Will imported pages automatically match our WordPress theme?", "Theme design and local rendering belong to the WordPress plugin and site implementation. The current EventHex evidence confirms the data connection, not universal theme inheritance."],
];

const softwareSchema = {
  "@context": "https://schema.org", "@type": "SoftwareApplication",
  name: "EventHex WordPress Event Feed Integration", applicationCategory: "BusinessApplication",
  operatingSystem: "WordPress", url: "https://eventhex.ai/integrations/wordpress/", description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Read-only connection key", "Upcoming event draft import", "Event and speaker feed", "Connection status", "Incremental feed queries", "Connection revocation"],
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<MarketingLayout {title} {description} canonical="https://eventhex.ai/integrations/wordpress/" footerCtaTitle="Bring your WordPress event-content workflow to the demo" footerCtaSubtitle="Show us the site, event scope, speaker rules, and review process. We’ll walk through the verified key and feed path." footerCtaButtonText="Book a Demo" footerCtaHref="/book-a-demo/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="wpi-page">
    <section class="wpi-hero">
      <div class="wpi-shell wpi-hero__grid">
        <div class="wpi-hero__content animate-on-scroll" data-animation="fadeInUp">
          <span class="wpi-eyebrow">WordPress integration for event content</span>
          <h1>Bring upcoming EventHex events into an existing WordPress site</h1>
          <p>Generate a one-time read-only connection key, add it to the EventHex Developer Connection plugin, and import eligible upcoming events as WordPress drafts with event and speaker content from the EventHex feed.</p>
          <div class="wpi-actions"><a class="wpi-btn" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a><a class="wpi-btn wpi-btn--ghost" href="#read-only-access">See how it works</a></div>
          <ul class="wpi-pills" aria-label="Integration capabilities"><li>Read-only key</li><li>Upcoming-event import</li><li>Event and speaker feed</li></ul>
        </div>
        <div class="wpi-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="wpi-connect-card">
            <div class="wpi-app"><img src="/icons/integrations/wordpress.svg" alt="WordPress logo" width="72" height="72" /><strong>WordPress</strong><span>Draft destination</span></div>
            <span class="wpi-line" aria-hidden="true"><i></i></span>
            <div class="wpi-app wpi-app--eventhex"><span class="wpi-mark" aria-hidden="true">E</span><strong>EventHex</strong><span>Event source</span></div>
            <div class="wpi-status"><i aria-hidden="true"></i><span><strong>Read-only feed connected</strong><small>Events + speakers · Draft import</small></span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="wpi-trust" aria-label="WordPress connector capabilities">
      <div class="wpi-shell"><span><b>One-time</b> Connection Key</span><span><b>Read-only</b> Permissions</span><span><b>Upcoming-event</b> Drafts</span><span><b>Status &amp; Revoke</b> Control</span></div>
    </section>

    <section class="wpi-readonly" id="read-only-access">
      <header class="wpi-readonly__header"><h2>Event content access, without organizer control</h2><p>Give WordPress only the information it needs while keeping administration and credentials inside EventHex.</p></header>
      <div class="wpi-readonly__quad">
        <article class="wpi-readonly__cell wpi-readonly__cell--copy"><h3>Events and speakers</h3><p>The site key exposes read permissions for eligible upcoming event and published speaker content through the protected feed.</p></article>
        <figure class="wpi-readonly__cell wpi-readonly__cell--media"><div class="wpi-readonly__composite"><img class="wpi-readonly__screen wpi-readonly__screen--primary" src="/feature-images/wordpress/read-only-feed.png" alt="EventHex Developer Connection showing read-only API key generation" loading="lazy" /><img class="wpi-readonly__screen wpi-readonly__screen--secondary" src="/feature-images/wordpress/integrations-overview.png" alt="EventHex integrations overview" loading="lazy" /><span class="wpi-readonly__status">✓ Read-only feed</span><span class="wpi-readonly__action">Events + speakers</span></div></figure>
        <figure class="wpi-readonly__cell wpi-readonly__cell--media"><div class="wpi-readonly__composite"><img class="wpi-readonly__screen wpi-readonly__screen--primary" src="/feature-images/wordpress/scoped-access.png" alt="EventHex connector key management with scoped and revocable access" loading="lazy" /><img class="wpi-readonly__screen wpi-readonly__screen--secondary" src="/feature-images/wordpress/developer-connection.png" alt="EventHex developer connection controls" loading="lazy" /><span class="wpi-readonly__status wpi-readonly__status--blue">✓ Scoped access</span><span class="wpi-readonly__action">Revoke anytime</span></div></figure>
        <article class="wpi-readonly__cell wpi-readonly__cell--copy"><h3>Organizer access stays private</h3><p>A connector key cannot create more keys or operate as a general EventHex organizer credential. Access remains individually scoped and revocable.</p></article>
        <span class="wpi-readonly__cross" aria-hidden="true">✦</span>
      </div>
    </section>

    <section class="wpi-key-section">
      <div class="wpi-shell wpi-key-layout">
        <div class="wpi-key-intro">
          <div class="wpi-key-intro__sticky">
            <span class="wpi-key-eyebrow"><span aria-hidden="true">⌁</span> Connection key</span>
            <h2>Control your <span>connection</span></h2>
            <p>An authorized key manager creates the WordPress connection. EventHex shows the raw key once and stores only its hashed form.</p>
            <a class="wpi-key-cta" href="/book-a-demo/">Book a Demo <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="wpi-key-cards">
          <article class="wpi-key-card">
            <div class="wpi-key-card__header"><span class="wpi-key-card__number">01</span><div><h3>Open the connection</h3><p>Open organization integrations and choose the EventHex Developer Connection.</p></div></div>
            <figure class="wpi-key-card__visual"><img src="/feature-images/wordpress/developer-connection.png" alt="Expanded EventHex Developer Connection panel" loading="lazy" /><span class="wpi-key-card__status">Connection ready</span><span class="wpi-key-card__action">Open integration</span></figure>
          </article>
          <article class="wpi-key-card">
            <div class="wpi-key-card__header"><span class="wpi-key-card__number">02</span><div><h3>Generate and copy the key</h3><p>Create a one-time read-only key and copy it immediately. The full secret is not displayed again.</p></div></div>
            <figure class="wpi-key-card__visual"><img src="/feature-images/wordpress/integrations-overview.png" alt="EventHex organization integrations overview" loading="lazy" /><span class="wpi-key-card__status">Read-only access</span><span class="wpi-key-card__action">Generate key</span></figure>
          </article>
          <article class="wpi-key-card">
            <div class="wpi-key-card__header"><span class="wpi-key-card__number">03</span><div><h3>Connect WordPress</h3><p>Paste the one-time key into the EventHex Developer Connection plugin to authenticate the read-only feed.</p></div></div>
            <figure class="wpi-key-card__visual"><img src="/feature-images/wordpress/developer-connection.png" alt="EventHex connection status and refresh controls" loading="lazy" /><span class="wpi-key-card__status">WordPress connected</span><span class="wpi-key-card__action">Import drafts</span></figure>
          </article>
          <article class="wpi-key-card">
            <div class="wpi-key-card__header"><span class="wpi-key-card__number">04</span><div><h3>Review and rotate</h3><p>Refresh the connection state, review imported drafts, and replace or revoke the key whenever access needs to change.</p></div></div>
            <figure class="wpi-key-card__visual"><img src="/feature-images/wordpress/integrations-overview.png" alt="EventHex integrations dashboard for reviewing the WordPress connection" loading="lazy" /><span class="wpi-key-card__status">Access reviewed</span><span class="wpi-key-card__action">Refresh status</span></figure>
          </article>
        </div>
      </div>
    </section>

    <section class="wpi-draft" aria-labelledby="wpi-draft-title">
      <div class="wpi-draft__inner">
        <div class="wpi-draft__copy">
          <span class="wpi-eyebrow">Automatic draft import</span>
          <h2 id="wpi-draft-title">Bring upcoming events into WordPress without publishing them blindly</h2>
          <p>The key-only connection imports upcoming events—including inactive EventHex events—as WordPress drafts. Your site team keeps control of the final review and publishing decision.</p>
          <div class="wpi-draft__actions">
            <a class="wpi-draft__button wpi-draft__button--dark" href="/book-a-demo/">Get Started Free <span aria-hidden="true">→</span></a>
            <a class="wpi-draft__button wpi-draft__button--light" href="/integrations/">Explore Integrations <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="wpi-draft__visual" role="img" aria-label="EventHex connection and event feed creating review-ready WordPress drafts">
          <div class="wpi-draft__shot wpi-draft__shot--feed"><img src="/feature-images/wordpress/read-only-feed.png" alt="" loading="lazy" decoding="async" /></div>
          <div class="wpi-draft__shot wpi-draft__shot--connection"><img src="/feature-images/wordpress/developer-connection.png" alt="" loading="lazy" decoding="async" /></div>
          <span class="wpi-draft__status"><b aria-hidden="true">✓</b> Draft feed ready</span>
          <span class="wpi-draft__publish">Review &amp; publish</span>
          <span class="wpi-draft__cursor" aria-hidden="true">◆</span>
        </div>
      </div>
    </section>

    <section class="wpi-section wpi-section--feed" aria-labelledby="wpi-feed-title">
      <div class="wpi-shell wpi-feed-stack">
        <header class="wpi-feed-stack__header">
          <span class="wpi-feed-stack__eyebrow"><span aria-hidden="true">✦</span> Event content stays connected</span>
          <h2 id="wpi-feed-title">Keep the WordPress copy tied to <span>EventHex event data</span></h2>
        </header>
        <div class="wpi-feed-stack__cards">
          {feedItems.map(([t,d],i) => (
            <article class="wpi-feed-stack__card" style={`--stack-index:${i};`}>
              <div class="wpi-feed-stack__copy">
                <span class="wpi-feed-stack__label">{String(i + 1).padStart(2,"0")} · {t}</span>
                <h3>{t}</h3>
                <p>{d}</p>
                <span class="wpi-feed-stack__cue">Included in the read-only feed <span aria-hidden="true">↗</span></span>
              </div>
              <figure class="wpi-feed-stack__visual">
                <div class="wpi-feed-stack__screen">
                  <div class="wpi-feed-stack__bar" aria-hidden="true"><span><i></i><i></i><i></i></span><small>EventHex · {t}</small></div>
                  <img src={feedImages[i]} alt={`${t} in the EventHex WordPress data feed`} loading="lazy" decoding="async" />
                </div>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wpi-compare-section">
      <header class="wpi-compare-header"><span class="wpi-eyebrow">Import is not publication</span><h2>Keep EventHex content flow separate from the WordPress publishing <span>decision</span></h2><p>Each platform owns a different part of the workflow.</p></header>
      <div class="wpi-compare-quad">
        <article class="wpi-compare-cell wpi-compare-copy"><span class="wpi-compare-label">Source</span><h3>EventHex</h3><p>Controls the source event, dates, domain, speaker visibility, and connector eligibility exposed by the feed.</p></article>
        <div class="wpi-compare-cell wpi-compare-media"><div class="wpi-compare-composite"><img class="wpi-compare-screen wpi-compare-screen--primary" src="/feature-images/wordpress/read-only-feed.png" alt="EventHex read-only event feed" loading="lazy" /><img class="wpi-compare-screen wpi-compare-screen--secondary" src="/feature-images/wordpress/integrations-overview.png" alt="EventHex integrations overview" loading="lazy" /><span class="wpi-compare-status">✓ Source connected</span><span class="wpi-compare-action">Events + speakers</span></div></div>
        <div class="wpi-compare-cell wpi-compare-media"><div class="wpi-compare-composite"><img class="wpi-compare-screen wpi-compare-screen--primary" src="/feature-images/wordpress/developer-connection.png" alt="WordPress developer connection" loading="lazy" /><img class="wpi-compare-screen wpi-compare-screen--secondary" src="/feature-images/wordpress/scoped-access.png" alt="Scoped WordPress access" loading="lazy" /><span class="wpi-compare-status">✓ Draft received</span><span class="wpi-compare-action">Review locally</span></div></div>
        <article class="wpi-compare-cell wpi-compare-copy"><span class="wpi-compare-label">Destination</span><h3>WordPress</h3><p>Receives drafts and remains responsible for local review, page design, site metadata, access, and publication.</p></article>
        <span class="wpi-compare-cross" aria-hidden="true">✦</span>
      </div>
      <p class="wpi-compare-note">A connected feed does not prove that every draft was reviewed, published, or kept in sync by the WordPress site.</p>
    </section>

    <FourColumnFeatureStrip heading="See the connection state without<br />exposing the secret again" items={[["Key prefix","Identify the connection by a safe display prefix."],["Last used","See whether and when the connector last used the key."],["Refresh","Reload the connection list and current state."],["Revoke","Invalidate an active key so the connected site stops authenticating."]]} />

    <section class="wpi-fit-section">
      <div class="wpi-fit-container">
        <header class="wpi-fit-header"><span class="wpi-eyebrow">Where the connector fits</span><h2>Reuse EventHex event content on the WordPress site your organization already <span>operates</span></h2></header>
        <div class="wpi-fit-grid">
          <span class="wpi-fit-notch wpi-fit-notch--top" aria-hidden="true"></span>
          <span class="wpi-fit-notch wpi-fit-notch--bottom" aria-hidden="true"></span>
          {useCases.map(([t,d],i) => (
            <article class:list={["wpi-fit-row", { "wpi-fit-row--reverse": i % 2 === 1 }]}> 
              <div class="wpi-fit-cell wpi-fit-visual">
                <div class={`wpi-fit-stage wpi-fit-stage--${i + 1}`}>
                  <img src={useCaseImages[i][0]} alt={`${t} workflow in EventHex`} loading="lazy" />
                  <span class="wpi-fit-float wpi-fit-float--top"><b>✓ {useCaseImages[i][1]}</b><small>{useCaseImages[i][2]}</small></span>
                  <span class="wpi-fit-float wpi-fit-float--bottom"><i></i><b>{useCaseImages[i][3]}</b></span>
                </div>
              </div>
              <div class="wpi-fit-cell wpi-fit-copy"><span class="wpi-fit-eyebrow">{String(i+1).padStart(2,"0")} · Connected</span><h3>{t}</h3><p>{d}</p></div>
              <span class="wpi-fit-cross" aria-hidden="true"></span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wpi-section wpi-section--workflow"><div class="wpi-shell"><header class="wpi-heading"><h2>Give the connector enough state to update responsibly</h2></header><ol class="wpi-workflow-steps">{statusItems.map(([t,d,img],i) => <li><details open={i === 0}><summary><span>{String(i+1).padStart(2,"0")}</span><div><h3>{t}</h3><p>{d}</p></div><button type="button" class="wpi-workflow__arrow" aria-label={`${i === 0 ? "Collapse" : "Expand"} ${t}`} aria-expanded={i === 0 ? "true" : "false"}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></button></summary><figure><img src={img} alt={`${t} shown in the EventHex connector interface`} loading="lazy" decoding="async" /></figure></details></li>)}</ol></div></section>

    <script>
      document.querySelectorAll<HTMLDetailsElement>(".wpi-workflow-steps details").forEach((item, _, all) => {
        const summary = item.querySelector("summary");
        const trigger = item.querySelector<HTMLButtonElement>(".wpi-workflow__arrow");
        summary?.addEventListener("click", event => {
          event.preventDefault();
          item.open = !item.open;
        });
        item.addEventListener("toggle", () => {
          trigger?.setAttribute("aria-expanded", String(item.open));
          trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} workflow step`);
          if (item.open) all.forEach(other => { if (other !== item) other.open = false; });
        });
      });
    </script>

    <section class="wpi-compare-section wpi-compare-section--boundary">
      <header class="wpi-compare-header"><span class="wpi-eyebrow">Clear connector boundary</span><h2>Event content import is verified; native WordPress ticketing <span>is not</span></h2><p>See exactly what the current connection covers—and what stays outside it.</p></header>
      <div class="wpi-compare-quad">
        <article class="wpi-compare-cell wpi-compare-copy"><span class="wpi-compare-label">Verified connector</span><h3>Content import</h3><p>Read-only key, event and speaker feed, upcoming draft import, connection status, incremental queries, and revoke control.</p></article>
        <div class="wpi-compare-cell wpi-compare-media"><div class="wpi-compare-composite"><img class="wpi-compare-screen wpi-compare-screen--primary" src="/feature-images/wordpress/integrations-overview.png" alt="Verified WordPress integration" loading="lazy" /><img class="wpi-compare-screen wpi-compare-screen--secondary" src="/feature-images/wordpress/read-only-feed.png" alt="Verified event content feed" loading="lazy" /><span class="wpi-compare-status">✓ Verified</span><span class="wpi-compare-action">Import drafts</span></div></div>
        <div class="wpi-compare-cell wpi-compare-media"><div class="wpi-compare-composite wpi-compare-composite--muted"><img class="wpi-compare-screen wpi-compare-screen--primary" src="/feature-images/event-registration/checkout-select-tickets.png" alt="EventHex ticket checkout shown outside the WordPress connector" loading="lazy" /><img class="wpi-compare-screen wpi-compare-screen--secondary" src="/feature-images/event-registration/checkout-order-details.png" alt="EventHex checkout order details" loading="lazy" /><span class="wpi-compare-status wpi-compare-status--muted">Not included</span><span class="wpi-compare-action wpi-compare-action--muted">EventHex checkout</span></div></div>
        <article class="wpi-compare-cell wpi-compare-copy"><span class="wpi-compare-label wpi-compare-label--muted">Not established</span><h3>Native ticketing</h3><p>Gutenberg blocks, shortcodes, embedded registration or checkout, attendee portal, theme inheritance, WordPress-admin attendee analytics, or WooCommerce behavior.</p></article>
        <span class="wpi-compare-cross" aria-hidden="true">✦</span>
      </div>
    </section>

    <section class="wpi-destination" aria-labelledby="wpi-destination-title">
      <div class="wpi-shell">
        <header class="wpi-destination__header"><span class="wpi-eyebrow">Connected website choices</span><h2 id="wpi-destination-title">Continue with the experience that <span>owns the next step</span></h2><p>Choose where your website, registration, ticketing, or custom integration workflow belongs.</p></header>
        <div class="wpi-destination__showcase">
          <div class="wpi-destination__tabs" role="tablist">
            {related.map(([t],i) => <a class="wpi-destination__tab" href={`#wpi-panel-${i}`} role="tab">{t}</a>)}
          </div>
          <div class="wpi-destination__panels">
          {related.map(([t,d,h],i) => <article class="wpi-destination__panel" id={`wpi-panel-${i}`} role="tabpanel">
            <div class="wpi-destination__copy"><h3>{t}</h3><p>{d}</p><ul>{relatedBullets[i].map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul><a href={h}>Explore {t} <span aria-hidden="true">→</span></a></div>
            <div class="wpi-destination__visual"><img src={relatedImages[i]} alt={`${t} interface in EventHex`} loading="lazy" /></div>
          </article>)}
          </div>
        </div>
      </div>
    </section>

    <IntegrationFaq heading="WordPress Integration<br />Questions, Answered." intro="Find quick answers about connection keys, draft imports, publication control, and site access." faqs={faqs} />
  </main>
</MarketingLayout>

<style>
