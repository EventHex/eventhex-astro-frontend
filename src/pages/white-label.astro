---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/white-label/HeroSection.astro";
import ContentSections from "../components/white-label/ContentSections.astro";
import FaqSection from "../components/white-label/FaqSection.astro";

const title = "White-Label Event Management Software | EventHex";
const description =
  "Run branded event organizations with organization-level identity, scoped teams, feature and usage controls, custom-domain options, and supported payment configuration.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex White-Label Event Platform",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/white-label/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Organization-level branding",
    "Scoped teams and event records",
    "Plan-aware capability control",
    "Custom-domain options",
    "Usage context",
    "Supported payment configuration",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/white-label/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Dashboard.png"
  footerCtaEyebrow="Map Your Organization Model"
  footerCtaTitle="Ready to run branded event organizations?"
  footerCtaSubtitle="Bring one client, chapter, or business unit to the demo. We will map the organization boundary, brand surfaces, domain path, plan controls, and supported payment setup."
  footerCtaProofItems={["Scoped organizations", "Plan-aware controls", "Portfolio usage"]}
  footerCtaButtonText="Book a Free Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/centralized-dashboard/event-portfolio-visual.svg"
  footerCtaImageAlt="EventHex organization dashboard showing multiple branded event workspaces"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div class="wl-page-bg">
    <HeroSection />
    <ContentSections />
    <FaqSection />
  </div>
</MarketingLayout>

<style is:global>
  .wl-page-bg {
    background:
      radial-gradient(ellipse 75% 68% at 50% 40%, rgba(255, 255, 255, .94) 0%, rgba(255, 255, 255, .65) 38%, rgba(255, 255, 255, .28) 58%, transparent 78%),
      linear-gradient(to bottom, #fff 0, rgba(255, 255, 255, .85) 130px, rgba(255, 255, 255, .5) 260px, rgba(255, 255, 255, .18) 390px, transparent 500px),
      linear-gradient(to top, #fff 0, rgba(255, 255, 255, .7) 70px, rgba(255, 255, 255, .3) 130px, transparent 190px),
      radial-gradient(circle 380px at 3% 34%, rgba(175, 163, 255, .28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 30%, rgba(255, 182, 213, .26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 75%, rgba(130, 170, 255, .24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 78%, rgba(255, 224, 150, .2) 0%, transparent 100%),
      #fff;
    background-attachment: fixed;
  }

  .wl-page-bg > section {
    background: transparent;
  }

  .wl-page-bg > .wlf-faq {
    background: #fff;
  }

  body:has(.wl-page-bg) .site-footer .cta-devices-img {
    width: 84%;
    max-width: 480px;
  }

  body:has(.wl-page-bg) .site-footer .cta-proof-row {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  body:has(.wl-page-bg) .site-footer .cta-proof-row span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 999px;
    background: rgba(255, 255, 255, .12);
    color: rgba(255, 255, 255, .92);
    font: 600 12px/16px var(--font-body);
  }

</style>
