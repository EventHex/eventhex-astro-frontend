---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/speaker-management/HeroSection.astro";
import StatsSection from "../components/speaker-management/StatsSection.astro";
import FeatureCards from "../components/speaker-management/FeatureCards.astro";
import CTASection from "../components/speaker-management/CTASection.astro";
import FaqSection from "../components/speaker-management/FaqSection.astro";
import DeckSections from "../components/speaker-management/DeckSections.astro";
import ProgramContentSections from "../components/speaker-management/ProgramContentSections.astro";

const title = "Speaker Management Software for Conferences | EventHex";
const description = "Build your speaker lineup and multi-track agenda in one place. Import speakers from LinkedIn, schedule across stages, and keep attendees updated automatically.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Speaker Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/speaker-management/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "AI LinkedIn speaker import",
    "Visual session timeline scheduling",
    "AI agenda builder with EventHex Copilot",
    "Call for papers and reviewer workflows",
    "Offline attendee agenda",
    "Push and WhatsApp reminders",
    "Live transcription and translation",
    "AI session recap and speaker social kit",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/speaker-management/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/03/Untitled-design-11-1024x576.webp"
>
  <div class="smp-page-bg">
    <HeroSection />
    <StatsSection />
    <ProgramContentSections section="setup" />
    <ProgramContentSections section="agenda" />
    <DeckSections section="ai" />
    <ProgramContentSections section="cfp" />
    <ProgramContentSections section="event-day" />
    <FeatureCards />
    <DeckSections section="use-cases" />
    <FaqSection />
    <CTASection />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  </div>
</MarketingLayout>

<style is:global>
  .smp-page-bg {
    background:
      radial-gradient(
        ellipse 75% 68% at 50% 40%,
        rgba(255, 255, 255, 0.94) 0%,
        rgba(255, 255, 255, 0.65) 38%,
        rgba(255, 255, 255, 0.28) 58%,
        transparent 78%
      ),
      linear-gradient(
        to bottom,
        #fff 0,
        rgba(255, 255, 255, 0.85) 130px,
        rgba(255, 255, 255, 0.5) 260px,
        rgba(255, 255, 255, 0.18) 390px,
        transparent 500px
      ),
      linear-gradient(
        to top,
        #fff 0,
        rgba(255, 255, 255, 0.7) 70px,
        rgba(255, 255, 255, 0.3) 130px,
        transparent 190px
      ),
      radial-gradient(
        circle 380px at 3% 34%,
        rgba(175, 163, 255, 0.28) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 300px at 97% 30%,
        rgba(255, 182, 213, 0.26) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 340px at 95% 75%,
        rgba(130, 170, 255, 0.24) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 300px at 4% 78%,
        rgba(255, 224, 150, 0.2) 0%,
        transparent 100%
      ),
      #ffffff !important;
    background-attachment: fixed !important;
  }
  .smp-page-bg > section,
  .smp-page-bg > div > section {
    background: transparent !important;
  }
</style>
