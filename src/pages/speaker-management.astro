---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import RelatedFeatures from "../components/shared/RelatedFeatures.astro";
import HeroSection from "../components/speaker-management/HeroSection.astro";
import StatsSection from "../components/speaker-management/StatsSection.astro";
import FeatureCards from "../components/speaker-management/FeatureCards.astro";
import FaqSection from "../components/speaker-management/FaqSection.astro";
import DeckSections from "../components/speaker-management/DeckSections.astro";
import ProgramContentSections from "../components/speaker-management/ProgramContentSections.astro";

const title = "Speaker Management Software for Conferences | EventHex";
const description = "Build your speaker lineup and multi-track agenda in one place. Import speakers from LinkedIn, schedule across stages, and keep attendees updated automatically.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Speaker Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/speaker-management/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "AI LinkedIn speaker import",
    "Visual session timeline scheduling",
    "AI agenda builder with EventHex Copilot",
    "Call for papers and reviewer workflows",
    "Offline attendee agenda",
    "Push and WhatsApp reminders",
    "Live transcription and translation",
    "AI session recap and speaker social kit",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/speaker-management/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/03/Untitled-design-11-1024x576.webp"
  footerCtaEyebrow="Start Your Next Event Faster"
  footerCtaTitle="Ready to Simplify Your Speaker Workflow?"
  footerCtaSubtitle="Join hundreds of event organizers who manage speakers, sessions, and engagement—all in one AI-powered platform."
  footerCtaProofItems={["AI-powered setup", "Live event-day tools", "Free onboarding support"]}
  footerCtaButtonText="Book a Free Demo"
  footerCtaImageSrc="/feature-images/speaker-management/cta-illustration.svg"
  footerCtaImageAlt="Speaker management profiles and workflow in EventHex"
>
  <div class="smp-page-bg">
    <HeroSection />
    <StatsSection />
    <ProgramContentSections section="setup" />
    <ProgramContentSections section="agenda" />
    <DeckSections section="ai" />
    <ProgramContentSections section="cfp" />
    <ProgramContentSections section="event-day" />
    <FeatureCards />
    <DeckSections section="use-cases" />
    <FaqSection />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  </div>
  <RelatedFeatures links={[
    { href: "/session-management/", label: "Conference session management", text: "Multi-day, multi-track agendas with stages, speakers, and booking rules." },
    { href: "/call-for-papers/", label: "Call for papers software", text: "Collect abstracts, assign reviewers, and move accepted work into the programme." },
    { href: "/ai-session-recap/", label: "AI session recap", text: "Live transcription, AI summaries, and takeaways from event sessions." },
    { href: "/live-polling-qa/", label: "Live polling and Q&A", text: "Session polls, anonymous voting, live Q&A, and post-session feedback." },
  ]} />
</MarketingLayout>

<style is:global>
  .smp-page-bg {
    background: var(--ds-white);
  }

  /* Keep primary section titles consistent with Event Registration. */
  .smp-page-bg .smp-clickup-hero__header h2,
  .smp-page-bg .smp-content--agenda .smp-content__header h2,
  .smp-page-bg .smd-ai__title,
  .smp-page-bg .smp-workflow__heading h2,
  .smp-page-bg .smf-title,
  .smp-page-bg .smd-agent__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .smp-page-bg .smd-ai__title span {
    font-size: inherit;
    font-weight: inherit;
  }

  /* Speaker-specific footer CTA content treatment. */
  body:has(.smp-page-bg) .site-footer .cta-devices-img {
    width: 84%;
    max-width: 480px;
  }
  body:has(.smp-page-bg) .site-footer .cta-proof-row {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  body:has(.smp-page-bg) .site-footer .cta-proof-row span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.92);
    font: 600 12px/16px var(--font-body);
  }

  /* Keep the long-form page flowing without oversized blank bands between sections. */
  .smp-page-bg .smp-clickup-hero,
  .smp-page-bg .smp-content--clickup {
    padding-block: clamp(64px, 7vw, 96px);
  }
  .smp-page-bg .smp-content--workflow {
    padding-block: clamp(72px, 8vw, 108px);
  }
  .smp-page-bg .smd-ai {
    padding-block: 32px;
  }
  .smp-page-bg .smd-agent-suites {
    padding-block: clamp(64px, 7vw, 96px);
  }
  .smp-page-bg .smf-cards {
    padding-top: 40px;
  }

  @media (max-width: 767px) {
    body:has(.smp-page-bg) .site-footer .cta-proof-row {
      display: flex;
      gap: 6px;
    }
    body:has(.smp-page-bg) .site-footer .cta-proof-row span {
      padding: 5px 8px;
      font-size: 11px;
      line-height: 15px;
    }
    .smp-page-bg .smp-clickup-hero,
    .smp-page-bg .smp-content--clickup {
      padding-block: 48px;
    }
    .smp-page-bg .smp-content--workflow {
      padding-block: 56px;
    }
    .smp-page-bg .smd-ai {
      padding-block: 20px;
    }
    .smp-page-bg .smd-agent-suites {
      padding-block: 52px;
    }
    .smp-page-bg .smf-cards {
      padding-top: 36px;
    }
  }
</style>
