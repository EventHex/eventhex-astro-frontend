---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import RelatedFeatures from "../components/shared/RelatedFeatures.astro";
import HeroSection from "../components/event-mobile-app/HeroSection.astro";
import StatsSection from "../components/event-mobile-app/StatsSection.astro";
import OrganizerUpdates from "../components/event-mobile-app/OrganizerUpdates.astro";
import BentoGrid from "../components/event-mobile-app/BentoGrid.astro";
import JourneySections from "../components/event-mobile-app/JourneySections.astro";
import HowItWorksSection from "../components/event-mobile-app/HowItWorksSection.astro";
import CoordinationTools from "../components/event-mobile-app/CoordinationTools.astro";
import FaqSection from "../components/event-mobile-app/FaqSection.astro";

const title = "Event Mobile App for Conferences & Events | EventHex";
const description = "Configure a branded event mobile app with agenda, networking, notifications, sponsors, photos, live engagement, gamification, and attendee shortcuts.";
const faqEntries = [
  ["Can the app match our event brand?", "Yes. Current settings include app identity and store assets, primary and secondary colors, app font, banner options, and supported home-screen variants."],
  ["Can we choose what appears on the home screen?", "Yes. Organizers can order, show, or hide supported quick-access items and add configured web links. Some items remain tied to the module that powers them."],
  ["Which attendee experiences can appear in the app?", "Verified mobile screens cover agenda, saved sessions, networking, connection requests, chat, notifications, sponsors, photos, polls and Q&A, feedback, and gamification. Availability depends on event setup."],
  ["Is it a dedicated branded app?", "EventHex provides a request workflow for a dedicated app and tracks publication status and store URLs. Final approval and timing remain subject to the app stores and delivery process."],
  ["Does the whole app work offline?", "No. Several datasets have local storage or cache-first paths, but support varies by module and network-dependent actions may still require connectivity."],
  ["Can attendees use AI matchmaking?", "The app can connect to the configured networking experience. See AI Smart-Connect for the matching and recommendation workflow."],
];
const softwareSchema = {
  "@context": "https://schema.org", "@type": "SoftwareApplication",
  name: "EventHex Event Mobile App", applicationCategory: "BusinessApplication",
  operatingSystem: "iOS, Android", url: "https://eventhex.ai/event-mobile-app/", description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Configurable app identity, colors, fonts, banners, and shortcuts", "Agenda and saved sessions", "Attendee profiles, connections, and chat", "Event notifications and sponsor information", "Photos, live polling, Q&A, feedback, and gamification", "Dedicated app request and publication-status workflow", "Local storage and cache-first paths for supported event data"],
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqEntries.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/event-mobile-app/"
  ogImage="https://eventhex.ai/feature-images/solutions/attendee-app-phones.png"
  footerCtaEyebrow="Plan the attendee home"
  footerCtaTitle="Bring your app brief and attendee journey to the demo"
  footerCtaSubtitle="Show us the brand, programme, modules, shortcuts, engagement plan, and offline-critical views you need. We’ll map them to the current EventHex app workflow and identify publication dependencies early."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaSecondaryButtonText="Contact Sales"
  footerCtaSecondaryHref="/contact-en/"
>
  <div class="ema-page-bg">
    <HeroSection />
    <StatsSection />
    <div class="ema-dark-band ds-night">
      <BentoGrid />
      <OrganizerUpdates />
    </div>
    <JourneySections />
    <HowItWorksSection />
    <CoordinationTools />
    <FaqSection />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <RelatedFeatures links={[
    { href: "/event-gamification/", label: "Event gamification", text: "App-action challenges, points, leaderboards, and rewards for attendees." },
    { href: "/enhance-networking-ai-smart-connect/", label: "AI event matchmaking", text: "Recommendations that help attendees find relevant people and book meetings." },
    { href: "/event-notifications/", label: "Event push notifications", text: "Schedule targeted alerts for attendees in the event app." },
    { href: "/compare/best-conference-apps/", label: "Best conference apps compared", text: "Eight conference apps compared for in-person and hybrid events." },
  ]} />
</MarketingLayout>

<style is:global>
  html:has(.ema-page-bg), body:has(.ema-page-bg) { overflow-x: clip; }
  .ema-page-bg { background: var(--ds-white); }
  .ema-dark-band { position: relative; isolation: isolate; overflow: hidden; background: var(--ds-night-bg); }
  .ema-dark-band > section { position: relative; background: transparent; }
  .ema-page-bg .emaj-section--agenda.ds-stage,
  .ema-page-bg .emaj-modules.ds-stage,
  .ema-page-bg .emahw-full.ds-stage,
  .ema-page-bg .emaf-faq.ds-stage { background: var(--ds-g4-stage) !important; }
  body:has(.ema-page-bg) .footer-cta-title { font-weight: 500; }
</style>
