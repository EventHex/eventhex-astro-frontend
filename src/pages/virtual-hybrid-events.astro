---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import VirtualHybridEventsPage from "../components/virtual-hybrid-events/VirtualHybridEventsPage.astro";

const title = "Virtual & Hybrid Event Platform | EventHex";
const description = "Connect Zoom, Google Meet, or Microsoft Teams to EventHex for meeting-bot recording, transcripts, RTMP streaming, virtual attendance, and post-session follow-up.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Virtual & Hybrid Events",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/virtual-hybrid-events/",
  featureList: [
    "Zoom, Google Meet, and Microsoft Teams meeting links",
    "Meeting bot control",
    "Provider-dependent recording and transcripts",
    "YouTube, Facebook, and custom RTMP destinations",
    "Virtual check-in and attendance",
    "Post-session recap and insights",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/virtual-hybrid-events/"
  showFooterCta={true}
  footerCtaEyebrow="Virtual & hybrid events"
  footerCtaTitle="Ready to run your next session online?"
  footerCtaSubtitle="Connect the meeting room you already use, configure the bot and streaming destinations before go-live, and keep attendance and session outputs inside the same event."
  footerCtaButtonText="Book a Free Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/virtual-hybrid-events/meeting-recording-insights.jpg"
  footerCtaImageAlt="EventHex virtual meeting workspace with recording, transcript, and AI insights"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <VirtualHybridEventsPage />
</MarketingLayout>
