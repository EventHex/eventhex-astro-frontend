---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/ai-photo-gallery/HeroSection.astro";
import StatsSection from "../components/ai-photo-gallery/StatsSection.astro";
import PageSections from "../components/ai-photo-gallery/PageSections.astro";
import FaqSection from "../components/ai-photo-gallery/FaqSection.astro";

const ogImage = "https://cms.eventhex.ai/wp-content/uploads/2025/01/Instasnap.png";
const title = "AI Event Photo Gallery & Photo Sharing | EventHex";
const description = "Give attendees a selfie-searchable event photo gallery. Upload and organize photos, send match alerts, and share branded event moments with EventHex.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex AI Event Photo Gallery",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/ai-photo-gallery/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Selfie-based photo discovery",
    "Browser and Google Drive photo import",
    "Event folders, highlights, and upload history",
    "Public and attendee-only gallery access",
    "Personal photo galleries and person-specific share links",
    "Optional WhatsApp alerts for newly matched photos",
    "Moderated attendee photo contributions",
    "Image and text watermarks",
    "Configurable partner placements",
  ],
};
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/ai-photo-gallery/"
  ogImage={ogImage}
  footerCtaEyebrow="See the gallery journey"
  footerCtaTitle="Bring One Event Photo Workflow. See How InstaSnap Would Handle It."
  footerCtaSubtitle="Show us how photographers deliver files, who should access the gallery, and how attendees should receive and share their photos. We’ll map the EventHex setup in a focused demo."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform on laptop, tablet, and mobile"
  showFooterCta={true}
>
  <div class="apg-page-bg">
    <HeroSection />
    <StatsSection />
    <PageSections />
    <FaqSection />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  </div>
</MarketingLayout>

<style is:global>
  .apg-page-bg {
    background:
      radial-gradient(ellipse 75% 68% at 50% 40%, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.65) 38%, rgba(255, 255, 255, 0.28) 58%, transparent 78%),
      linear-gradient(to bottom, var(--ds-white) 0, rgba(255, 255, 255, 0.85) 130px, rgba(255, 255, 255, 0.5) 260px, rgba(255, 255, 255, 0.18) 390px, transparent 500px),
      linear-gradient(to top, var(--ds-white) 0, rgba(255, 255, 255, 0.7) 70px, rgba(255, 255, 255, 0.3) 130px, transparent 190px),
      radial-gradient(circle 380px at 3% 34%, rgba(175, 163, 255, 0.28) 0%, transparent 100%),
      radial-gradient(circle 300px at 97% 30%, rgba(255, 182, 213, 0.26) 0%, transparent 100%),
      radial-gradient(circle 340px at 95% 75%, rgba(130, 170, 255, 0.24) 0%, transparent 100%),
      radial-gradient(circle 300px at 4% 78%, rgba(255, 224, 150, 0.2) 0%, transparent 100%),
      var(--ds-white);
    background-attachment: fixed;
  }

  .apg-page-bg > section {
    background-color: transparent;
  }

  .apg-page-bg > .apg-intake {
    background-color: var(--ds-black) !important;
  }

  .apg-page-bg > .apg-faq {
    background: var(--ds-white) !important;
  }

  body:has(.apg-page-bg) .site-footer .footer-cta-title {
    font-weight: 500;
  }

  @media (max-width: 767px) {
    body:has(.apg-page-bg) .footer-main-inner { padding-inline: 12px; }
    body:has(.apg-page-bg) .footer-columns { gap: 12px; }
    body:has(.apg-page-bg) .footer-col { min-width: 0; }
    body:has(.apg-page-bg) .footer-link { white-space: normal; }
  }

  /* ===== v5 design-system pass: tokens only (see src/styles/ds.css) ===== */
  .apg-page-bg { background: var(--ds-white); }
  .apg-page-bg h1, .apg-page-bg h2 {
    font-family: var(--ds-font-heading); font-weight: 500; letter-spacing: -0.035em;
    background: none; -webkit-text-fill-color: var(--ds-ink); color: var(--ds-ink);
  }
  .apg-page-bg h3 { font-family: var(--ds-font-heading); font-weight: 500; }
  .apg-page-bg .ds-hl, .apg-page-bg .ds-hl-dark { -webkit-text-fill-color: transparent; color: transparent; font-weight: 500; }
  .apg-page-bg .ds-hl { background-image: var(--ds-g1-text); }
  .apg-page-bg .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .apg-page-bg > .apg-intake, .apg-page-bg > .apg-evidence { background: var(--ds-night-bg) !important; background-color: var(--ds-night) !important; }
  .apg-page-bg .apg-intake h2, .apg-page-bg .apg-evidence h2 { -webkit-text-fill-color: var(--ds-on-night); color: var(--ds-on-night); }
  .apg-page-bg .apg-intake h2 .ds-hl-dark, .apg-page-bg .apg-evidence h2 .ds-hl-dark { -webkit-text-fill-color: transparent; color: transparent; }
  .apg-page-bg > .apg-hero, .apg-page-bg > .apg-story { background: var(--ds-g4-stage); }
  .apg-page-bg > .apg-faq { background: var(--ds-white) !important; }
  .apg-page-bg .apg-hero__btn { border-radius: 12px; font-weight: 500; }
  .apg-page-bg .apg-hero__btn--primary, .apg-page-bg .apg-faq__cta { background: var(--ds-blue); color: var(--ds-white); box-shadow: var(--ds-shadow-btn); border: 0; }
  .apg-page-bg .apg-hero__btn--primary:hover, .apg-page-bg .apg-faq__cta:hover { background: var(--ds-blue-hover); color: var(--ds-white); }
  .apg-page-bg .apg-hero__btn--secondary { background: color-mix(in srgb, var(--ds-white) 75%, transparent); color: var(--ds-ink); border: 1px solid var(--ds-line); }
  .apg-page-bg .apg-evidence a, .apg-page-bg .apg-links__card { font-weight: 500; }
  .apg-page-bg .apg-story__stage, .apg-page-bg .apg-links__card {
    background: var(--ds-glass-fill); border: 1px solid var(--ds-glass-edge); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur);
  }
  /* chips that sat over screenshots: quiet inline labels */
  .apg-page-bg .apg-portal-composite__status, .apg-page-bg .apg-events__fit-label { box-shadow: none; }
  .apg-page-bg .apg-hero__visual-card { border-radius: var(--ds-r-lg); border: 1px solid var(--ds-line-strong); box-shadow: var(--ds-shadow-hero); backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--ds-white); }
</style>
