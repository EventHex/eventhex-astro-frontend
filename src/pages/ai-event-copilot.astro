---
import MarketingLayout from "../layouts/MarketingLayout.astro";

import HeroSection from "../components/ai-event-copilot/HeroSection.astro";
import StatsSection from "../components/ai-event-copilot/StatsSection.astro";
import PageSections from "../components/ai-event-copilot/PageSections.astro";
import FaqSection from "../components/ai-event-copilot/FaqSection.astro";
import { copilotFaqs } from "../components/ai-event-copilot/content";

const title = "AI Event Copilot for Event Management | EventHex";
const description = "Ask about attendees, check-ins, tickets, sessions, orders, exhibitors, and more. Use one EventHex Copilot for supported organizer questions and actions.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "EventHex Copilot",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": "https://eventhex.ai/ai-event-copilot/",
  "description": "An organizer-facing AI event copilot for supported questions, structured results, drafts, and actions inside an EventHex event.",
  "creator": {
    "@type": "Organization",
    "name": "EventHex",
    "url": "https://eventhex.ai"
  },
  "featureList": [
    "Event-scoped organizer conversations",
    "Natural-language event questions",
    "Structured metrics, charts, tables, and lists",
    "Supported agenda, ticket, attendee, form, poll, coupon, and event actions",
    "Draft and confirmation controls",
    "Voice-note transcription and record mentions",
    "Event-scoped conversation history"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": copilotFaqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/ai-event-copilot/"
  footerCtaEyebrow="Bring one real event question"
  footerCtaTitle="See How EventHex Copilot Would Handle the Next Task on Your List"
  footerCtaSubtitle="Show us the workflow your team keeps switching screens to complete. We’ll map the question, data, supported action, and control point in a focused EventHex demo."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>
  <div class="aec-page-bg">
    <HeroSection />
    <StatsSection />
    <PageSections />
    <FaqSection />
  </div>
</MarketingLayout>

<style>
  :global(main) {
    background: #ffffff;
  }

  .aec-page-bg {
    --aec-section-title-size: 50px;
    --aec-section-title-line: 1.08;
    --aec-section-title-tracking: -0.04em;
    --aec-light-title-gradient: linear-gradient(98deg, var(--heading-dark) 43.06%, #8f8f8f 91.81%);
    --aec-dark-title-gradient: linear-gradient(98deg, #fff 43.06%, #aeb4c0 91.81%);
    background:
      radial-gradient(ellipse 720px 540px at -8% 18%, rgba(55, 93, 251, 0.08), transparent 72%),
      radial-gradient(ellipse 760px 620px at 108% 70%, rgba(255, 116, 184, 0.08), transparent 74%),
      #fff;
  }

  :global(.site-footer .footer-cta-title) {
    font-weight: 500;
  }

  @media (min-width: 1025px) {
    :global(.site-footer .footer-cta-banner .cta-left) {
      flex-basis: 58%;
    }

    :global(.site-footer .footer-cta-banner .cta-right) {
      flex-basis: 42%;
      transform: translateX(24px);
    }

    :global(.site-footer .footer-cta-title) {
      max-width: 540px;
    }
  }
</style>
