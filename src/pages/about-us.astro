---
import EditorialCard from "../components/editorial/EditorialCard.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { decodeHtmlEntities, normalizeBlogPosts } from "../lib/editorial";
import { getPosts } from "../lib/wordpress";

const title = "About EventHex — The Team Behind the AI Event Platform";
const description = "Meet the team building EventHex: the AI-powered event platform for registration, check-in, photo delivery, and attendee engagement. Our story, mission, and the events we power worldwide.";
const rawPosts = await getPosts({ per_page: "6" });
const latestPosts = normalizeBlogPosts(rawPosts)
  .slice(0, 6)
  .map((post) => {
    const sourcePost = rawPosts.find((candidate) => candidate.id === post.id);
    const authorTerm = sourcePost?._embedded?.["wp:term"]
      ?.flat()
      .find((term) => term.taxonomy === "authors");

    return {
      ...post,
      author: authorTerm ? decodeHtmlEntities(authorTerm.name) : post.author,
    };
  });
---

<MarketingLayout {title} {description}>
  <div class="about-top ds-stage">
  <section class="about-hero">
    <div class="about-hero__outer">
      <div class="about-hero__inner">
        <h1 class="about-hero__title">Built To <span class="ds-hl">Keep Them Recurring</span></h1>
        <p class="about-hero__desc">At EventHex, we're transforming the ways event organizers and recurring events approach event personalisation, attendee retention, and event campaigning.</p>
      </div>
    </div>
  </section>

  <section class="about-showcase" aria-label="EventHex showcase">
    <div class="about-showcase__frame">
      <img
        src="/about/eventhex-conference-showcase.jpg"
        alt="EventHex team at a conference"
        width="1536"
        height="742"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>
  </div>

  <section class="about-editorial ds-night" aria-labelledby="about-editorial-title">
    <div class="about-editorial__inner">
      <a href="/blog/" class="about-editorial__link">Explore More</a>
      <h2 id="about-editorial-title" class="about-editorial__title">Your Countless Events <span class="ds-hl-dark">Begin Here</span></h2>

      <div class="about-editorial__track">
        {latestPosts.map((post) => (
          <div class="about-editorial__item">
            <EditorialCard item={post} showDescription={false} />
          </div>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .about-hero {
    padding: 0 20px;
  }

  .about-hero__outer {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(112px, 12vw, 152px) clamp(20px, 3vw, 36px) clamp(40px, 5vw, 64px);
  }

  .about-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(16px, 3vw, 28px);
  }

  .about-hero__title {
    margin: 0;
    width: 100%;
    font-family: "Creato Display", var(--font-heading);
    font-size: clamp(3rem, 6vw, 4.25rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--ds-ink);
  }

  .about-hero__desc {
    margin: 20px auto 0;
    width: 100%;
    max-width: 720px;
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--ds-sub);
    text-wrap: balance;
  }

  .about-showcase {
    padding: 0 20px clamp(64px, 8vw, 104px);
  }

  .about-showcase__frame {
    width: min(100%, 960px);
    height: 500px;
    margin: 0 auto;
    border-radius: var(--ds-r-lg);
    border: 1px solid var(--ds-line-strong);
    overflow: hidden;
    background: var(--ds-surface);
    box-shadow: var(--ds-shadow-hero);
  }

  .about-showcase__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-editorial {
    padding: clamp(64px, 8vw, 104px) 20px clamp(64px, 8vw, 104px);
  }

  .about-editorial__inner {
    max-width: 1140px;
    margin: 0 auto;
  }

  .about-editorial__link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ds-on-night-accent);
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 12px;
  }

  .about-editorial__title {
    margin: 0 0 40px;
    max-width: 760px;
    font-family: "Creato Display", var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--ds-on-night);
    text-wrap: balance;
  }

  .about-editorial__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 12px;
    scrollbar-width: none;
  }

  .about-editorial__track::-webkit-scrollbar {
    display: none;
  }

  .about-editorial__item {
    flex: 0 0 calc((100% - 40px) / 3);
    min-width: 320px;
    scroll-snap-align: start;
  }

  .about-editorial__item :global(.editorial-card) {
    height: 100%;
  }

  @media (max-width: 1024px) {
    .about-showcase__frame {
      height: 460px;
    }

    .about-editorial__item {
      flex-basis: calc((100% - 20px) / 2);
    }

    .about-editorial__title {
      margin-bottom: 32px;
    }
  }

  @media (max-width: 767px) {
    .about-hero {
      padding: 0 16px;
    }

    .about-hero__outer {
      padding: 104px 16px 36px;
    }

    .about-hero__title {
      white-space: normal;
      max-width: 10ch;
    }

    .about-hero__desc {
      margin-top: 16px;
      font-size: 18px;
    }

    .about-showcase {
      padding: 0 16px 48px;
    }

    .about-showcase__frame {
      width: 100%;
      height: auto;
      border-radius: var(--ds-r-md);
    }

    .about-showcase__frame img {
      height: auto;
      aspect-ratio: 1536 / 742;
    }

    .about-editorial {
      padding: 56px 16px;
    }

    .about-editorial__link {
      font-size: 16px;
      margin-bottom: 10px;
    }

    .about-editorial__title {
      margin-bottom: 24px;
    }

    .about-editorial__track {
      gap: 16px;
    }

    .about-editorial__item {
      flex-basis: 82%;
      min-width: 82%;
    }
  }
</style>
