---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import EventWebsiteBuilderRevamp from "../components/event-website-builder/EventWebsiteBuilderRevamp.astro";

const title = "AI Event Website Builder for Branded Event Sites | EventHex";
const description = "Design a branded event website with AI in minutes. EventHex builds it from your speakers, sessions and tickets; edit anything, then publish.";

const faqs = [
  ["Can we create more than one page?", "Yes. The EventHex Website Builder supports a home page and enabled custom pages with slugs, menu state, search listing details and ordered content, within the documented site limits."],
  ["Can the website use EventHex event data?", "Yes. Supported sections can use event, speaker, session, ticket, sponsor, exhibitor, gallery and form data from the event workspace."],
  ["Is there a visual editor?", "Yes. Teams can add and reorder event sections, use advanced layout blocks, edit design and content properties, and review a live private draft."],
  ["How does Design with AI work?", "Describe the look you want and choose how many designs to see (up to three). AI designs the page from your event's speakers, sessions and tickets, usually in a minute or two, and applies it to your private draft. Switch designs, edit anything or undo; nothing goes live until you publish."],
  ["Does editing change the live website immediately?", "No. Your edits stay in a private draft with saved revisions. A draft goes live only when your team clicks Publish."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Website Builder",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/event-website-builder/",
  description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Design with AI", "Event-native website sections", "Connected event data", "Multi-page website editing", "Responsive preview controls", "Draft revisions", "SEO and social sharing fields", "Custom domain support"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })),
};
---

<MarketingLayout title={title} description={description} canonical="https://eventhex.ai/event-website-builder/" ogImage="/feature-images/event-website-builder/v5/meridian-site-desktop-hero.webp" footerCtaTitle="Ready to plan your event website?" footerCtaButtonText="Book a Demo" footerCtaHref="/book-a-demo/" showFooterCta={true}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <EventWebsiteBuilderRevamp {faqs} />
</MarketingLayout>
