    copy: "Send the reminder through the available WhatsApp window or configured template path.",
    status: "Reminder scheduled",
    tone: "success",
    action: "Send now",
    icon: '<path d="M18 8.5a6 6 0 0 0-12 0c0 6.5-2.5 8-2.5 8h17s-2.5-1.5-2.5-8"></path><path d="M13.7 20.5a2 2 0 0 1-3.4 0"></path>',
  },
  {
