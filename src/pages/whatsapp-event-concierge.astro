---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "WhatsApp Event Assistant for Attendees | EventHex";
const description =
  "Give attendees event-aware answers, forms, tickets, reminders, networking, polls, and human help inside WhatsApp, with organizer controls in EventHex.";
const canonical = "https://eventhex.ai/whatsapp-event-concierge/";

const featureList = [
  "Answers grounded in current event data",
  "Agenda, speaker, exhibitor and venue answers",
  "Personal attendee actions",
  "Supported EventHex forms as WhatsApp Flows",
  "Public registration link fallback",
  "Attendee-managed reminders",
  "Session and networking recommendations",
  "Polls and event feedback",
  "Human handoff with transcripts",
  "Organizer conversation and topic insights",
];

const faqs = [
  {
    q: "What is EventHex WhatsApp Event Concierge?",
    a: "It is an event-aware attendee assistant inside WhatsApp. It can answer questions and open available attendee actions using the selected event's data and settings, while organizers manage status, conversations, handoffs, and insights in EventHex.",
  },
  {
    q: "What can attendees ask about?",
    a: "Depending on the event configuration, attendees can ask about the agenda, sessions, speakers, exhibitors, venue, registration, polls, and available event help. Recognized attendees can also access personal capabilities such as a ticket, schedule, networking, reminders, profile, certificate, matched photos, or recap when those items are available.",
  },
  {
    q: "Does every event show the same options?",
    a: "No. The capability menu changes with the event's settings and content. Personal options also depend on whether the WhatsApp number can be matched to an event registration.",
  },
  {
    q: "Can attendees register inside WhatsApp?",
    a: "A configured EventHex registration form can open as a native WhatsApp Flow when its fields are supported. If no Flow is available, the assistant can send the public registration link while registration is open.",
  },
  {
    q: "Can attendees pay inside the WhatsApp chat?",
    a: "The inspected WhatsApp Concierge workflow does not include native payment collection. Paid registration should continue through the EventHex checkout or ticketing path shown from the registration link.",
  },
  {
    q: "Can we use our own WhatsApp Business number?",
    a: "Yes. An event can use a connected Meta Cloud phone number and access token. EventHex also provides a shared-number path for eligible events. The setup still depends on WhatsApp Business platform requirements.",
  },
  {
    q: "How does human handoff work?",
    a: "An attendee can ask to speak with a person. The conversation enters the organizer handoff inbox, keeps its transcript and later attendee context, and returns to the assistant after an organizer marks it resolved.",
  },
  {
    q: "What can organizers see?",
    a: "Organizers can see concierge status, conversation and handoff counts, open 24-hour windows, message counts, top topics, recent questions, conversation transcripts, and pending human handoffs for the selected event.",
  },
  {
    q: "Is WhatsApp Concierge the same as a WhatsApp campaign?",
    a: "No. Concierge handles attendee questions and interactive actions. Event Marketing owns planned broadcast campaigns, Event Notifications owns operational alerts, and WhatsApp Integration owns connection and template infrastructure.",
  },
];

const railSteps = [
  ["Ask", "Type a question naturally"],
  ["Resolve", "Match the event and attendee"],
  ["Answer", "Use current event information"],
  ["Act", "Open the available attendee tool"],
  ["Remember", "Keep the conversation context"],
  ["Escalate", "Hand off to the event team"],
];

const personalActions = [
