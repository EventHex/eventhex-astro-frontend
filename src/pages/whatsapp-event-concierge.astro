                    </span>
                  </div>
                  <div class="wa-suite-mock__thread">
                    <p class="wa-suite-mock__ask">{flow.ask}</p>
                    <div class="wa-suite-mock__answer">
                      <b>{flow.answerTitle}</b>
                      <span>{flow.answerBody}</span>
                      <em>{flow.action}</em>
                    </div>
                  </div>
                </div>

                <div class="wa-vote-pane">
                  <p class="wa-vote-pane__label">{flow.paneLabel}</p>

                  {flow.id === "polls" ? (
                    <div class="wa-vote-poll">
                      <p class="wa-vote-poll__q">
                        Which track are you following today?
                      </p>
                      <span class="wa-poll__opt is-picked">
                        <span>AI and product</span>
                        <i style="width: 64%"></i>
                        <b>64%</b>
                      </span>
                      <span class="wa-poll__opt">
                        <span>Operations</span>
                        <i style="width: 36%"></i>
                        <b>36%</b>
                      </span>
                    </div>
                  ) : (
                    <div class="wa-vote-feedback">
                      <p class="wa-vote-poll__q">How was the AI keynote?</p>
                      <div class="wa-rating__stars">
                        <span></span><span></span><span></span><span class="is-on"></span><span></span>
                      </div>
                      <span class="wa-vote-feedback__note">
                        4 of 5 recorded for this session
                      </span>
                      <span class="wa-chip is-live">Submit rating</span>
                    </div>
                  )}
                </div>
              </div>

              <span
                class:list={[
                  "wa-suite-mock__badge",
                  `wa-suite-mock__badge--${flow.id}`,
                ]}
              >
                {flow.id === "polls" ? (
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <rect x="3" y="10" width="3.4" height="7" rx="1.4"></rect>
                    <rect x="8.3" y="5.5" width="3.4" height="11.5" rx="1.4"></rect>
                    <rect x="13.6" y="8" width="3.4" height="9" rx="1.4"></rect>
                  </svg>
                ) : (
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 3.4l1.9 4 4.4.6-3.2 3 .8 4.4L10 13.2l-3.9 2.2.8-4.4-3.2-3 4.4-.6z"></path>
                  </svg>
                )}
                {flow.visualLabel}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== REMINDERS JOURNEY ===== -->
    <!-- ===== REMINDER PATH =====
         Sticky summary beside stacked step cards, matching the registration
         path layout above. -->
    <section class="wa-section wa-journey-section">
      <div class="wa-reg">
        <div class="wa-reg__aside">
          <div class="wa-reg__sticky animate-on-scroll" data-animation="fadeInUp">
            <span class="wa-reg__eyebrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8.5a6 6 0 0 0-12 0c0 6.5-2.5 8-2.5 8h17s-2.5-1.5-2.5-8"></path>
                <path d="M13.7 20.5a2 2 0 0 1-3.4 0"></path>
              </svg>
              Reminders an attendee can manage
            </span>
            <h2 class="wa-reg__title">
              Set, view, and cancel
              <span class="wa-reg__accent">reminders from the chat</span>
            </h2>
            <p class="wa-reg__lede">
              Recognized attendees can ask for a reminder, confirm when it should
              arrive, see upcoming reminders, or cancel the next one.
            </p>
            <a class="wa-reg__cta" href="/book-a-demo/">
              Book a Demo
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="wa-reg__cards">
          {reminderSteps.map((step, index) => (
            <article
              class="wa-regcard animate-on-scroll"
              data-animation="fadeInUp"
              data-delay={index * 60}
            >
              <div class="wa-regcard__head">
                <span class="wa-regcard__num">{String(index + 1).padStart(2, "0")}</span>
                <div class="wa-regcard__text">
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                </div>
              </div>

              <div class="wa-regcard__stage">
                {step.id === "ask" && (
                  <div class="wa-chat wa-regshot wa-regshot--chat" aria-hidden="true">
                    <div class="wa-chat__head">
                      <span class="wa-chat__avatar">
                        <svg viewBox="0 0 24 24">
                          <path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.3A9 9 0 1 0 12 3Z"></path>
                        </svg>
                      </span>
                      <div class="wa-chat__who">
                        <b>EH Tech Summit Assistant</b>
                        <span>Event-aware help</span>
                      </div>
                    </div>
                    <div class="wa-chat__body">
                      <p class="wa-bubble wa-bubble--in">
                        Remind me before the AI keynote.
                      </p>
                      <p class="wa-bubble wa-bubble--out">
                        Noted. What time should I remind you?
                      </p>
                      <div class="wa-chips">
                        <span class="wa-chip is-live">Tomorrow, 09:45</span>
                      </div>
                    </div>
                  </div>
                )}

                {step.id === "confirm" && (
                  <div class="wa-regshot wa-regshot--form" aria-hidden="true">
                    <div class="wa-regshot__bar">
                      <span class="wa-regshot__tag">Reminder time</span>
                      <span class="wa-regshot__meta">Event timezone</span>
                    </div>
                    <p class="wa-regshot__label">When should we remind you?</p>
                    <span class="wa-regshot__field">
                      <b>Date</b>
                      <i>12 Oct 2026</i>
                    </span>
                    <span class="wa-regshot__field">
                      <b>Time</b>
                      <i>09:45 AM</i>
                    </span>
                    <span class="wa-regshot__field">
                      <b>Timezone</b>
                      <i>Asia/Kolkata (IST)</i>
                    </span>
                    <span class="wa-regshot__check">
                      <i>
                        <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg>
                      </i>
                      Remind 45 minutes before the session
                    </span>
                    <span class="wa-regshot__submit">Confirm time</span>
                  </div>
                )}

                {step.id === "receive" && (
                  <div class="wa-regshot wa-regshot--record" aria-hidden="true">
                    <div class="wa-regshot__bar">
                      <span class="wa-regshot__tag wa-regshot__tag--ok">Reminder sent</span>
                      <span class="wa-regshot__meta">WhatsApp</span>
                    </div>
                    <span class="wa-regshot__row">
                      <b>Reminder</b>
                      <i>The AI keynote</i>
                    </span>
                    <span class="wa-regshot__row">
                      <b>Path</b>
                      <i>Approved template</i>
                    </span>
                    <span class="wa-regshot__row">
                      <b>Window</b>
                      <i class="is-ok">Open session</i>
                    </span>
                    <span class="wa-regshot__row">
                      <b>Status</b>
                      <i class="is-ok">Delivered</i>
                    </span>
                    <p class="wa-regshot__note">
                      A scheduled reminder is delivered through the available
                      WhatsApp window or the configured template path, in the
                      event timezone.
                    </p>
                  </div>
                )}

                {step.id === "manage" && (
                  <div class="wa-remlist" aria-hidden="true">
                    <div class="wa-remlist__head">
                      <span class="wa-remlist__title">Upcoming reminders</span>
                      <span class="wa-pill">2 scheduled</span>
                    </div>
                    <div class="wa-remlist__item is-next">
                      <span class="wa-remlist__when">Tomorrow, 09:45</span>
                      <b class="wa-remlist__what">The AI keynote</b>
                      <span class="wa-remlist__where">Hall A, 10:30 AM</span>
                      <span class="wa-remlist__cancel">Cancel reminder</span>
                    </div>
                    <div class="wa-remlist__item">
                      <span class="wa-remlist__when">Fri, 14:30</span>
                      <b class="wa-remlist__what">Closing keynote</b>
                      <span class="wa-remlist__where">Main stage, 3:15 PM</span>
                    </div>
                  </div>
                )}

                <span class:list={["wa-regcard__status", `wa-regcard__status--${step.tone}`]}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={step.icon} />
                  {step.status}
                </span>
                <span class="wa-regcard__action">{step.action}</span>
                <svg class="wa-regcard__cursor" viewBox="0 0 28 32" aria-hidden="true">
                  <path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path>
                </svg>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

