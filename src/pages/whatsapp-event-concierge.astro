      "Help visitors find sessions, exhibitors, venues, tickets, and available networking actions.",
    checklist: [
      "Sessions, exhibitors, and venue lookups",
      "Ticket and registration answers",
      "Available networking actions",
    ],
    event: "Global Expo 2026",
    ask: "Where is Hall 3 and stand B12?",
