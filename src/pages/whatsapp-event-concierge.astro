];

const voteFlows = [
  {
    id: "polls",
    label: "Live polls",
    eyebrow: "Live vote",
    title: "Take the vote without leaving the chat",
    description:
      "Show an active event or session poll, accept one of the available options, and return the updated result.",
    checklist: [
      "Opens an active event or session poll",
      "Accepts one of the available options",
      "Returns the updated result in the chat",
    ],
    event: "Association Congress",
    ask: "Can I vote on the live poll?",
    answerTitle: "Live poll is open",
    answerBody: "Pick one option and I will show the running result.",
    action: "Vote on this poll",
    paneLabel: "Live results",
    visualLabel: "Live poll open",
  },
  {
    id: "feedback",
    label: "Event and session feedback",
    eyebrow: "After the session",
    title: "Collect the rating in the same thread",
    description:
      "Open a configured feedback form in WhatsApp or use the available lightweight rating path after the event starts.",
    checklist: [
      "Opens the configured feedback form in WhatsApp",
      "Offers the lightweight rating path",
      "Reuses the enabled feedback workflow",
    ],
    event: "Association Congress",
    ask: "Can I rate the session I just attended?",
    answerTitle: "Rate the session",
    answerBody: "Score it out of five and it is filed with the session.",
    action: "Rate this session",
    paneLabel: "Session feedback",
    visualLabel: "Rating captured",
  },
];

const relatedLinks = [
  [
    "Event Marketing",
    "Build planned email or WhatsApp campaigns for a selected event audience.",
    "/event-marketing/",
  ],
  [
    "Event Notifications",
    "Configure operational and trigger-based attendee alerts across supported channels.",
    "/event-notifications/",
  ],
  [
    "WhatsApp Integration",
    "Understand the WhatsApp Business connection, templates, and messaging infrastructure.",
    "/integrations/whatsapp/",
  ],
  [
    "Event Registration",
    "Design the complete web registration, form, and ticket-selection journey.",
    "/event-registration/",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex WhatsApp Event Assistant",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: canonical,
  featureList,
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogImage="/images/whatsapp-event-concierge/eventhex-whatsapp-concierge-overview.png"
  ogType="website"
  footerCtaEyebrow="WhatsApp Event Assistant"
  footerCtaTitle="See how your event becomes a useful WhatsApp conversation"
  footerCtaSubtitle="Bring one real attendee journey and map it from the first message to the organizer view."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="wa-page-bg">
    <!-- ===== HERO ===== -->
    <section class="wa-hero">
      <div class="wa-hero__grid">
        <div class="wa-hero__content">
          <span
            class="wa-hero__badge animate-on-scroll"
            data-animation="fadeInDown">WhatsApp Event Assistant</span
          >
          <h1
            class="wa-hero__title animate-on-scroll"
            data-animation="fadeInUp"
          >
            Give every attendee an event assistant inside WhatsApp
          </h1>
          <p
            class="wa-hero__desc animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 800ms"
          >
            Let attendees ask about the agenda, speakers, exhibitors, venue,
            and their own event journey in a familiar chat. EventHex connects
            each conversation to current event data, available attendee tools,
            and your team when a human should take over.
          </p>
          <div
            class="wa-hero__cta-row animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 1100ms"
          >
            <a href="/book-a-demo/" class="wa-hero__btn">
              Book a Demo
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
            <a href="#wa-actions" class="wa-hero__btn wa-hero__btn--outline">
              See what attendees can do
            </a>
          </div>
          <div
            class="wa-hero__trust animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 1300ms"
          >
            <span class="wa-hero__trust-item">Event-aware answers</span>
            <span class="wa-hero__trust-item">Personal attendee actions</span>
            <span class="wa-hero__trust-item">Human handoff</span>
          </div>
        </div>

        <div class="wa-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="wa-hero__visual-card">
            <div class="wa-hero__visual-inner">
              <div class="wa-console" aria-hidden="true">
                <div class="wa-console__top">
                  <span class="wa-console__mark">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.3A9 9 0 1 0 12 3Z"></path>
                    </svg>
                  </span>
                  <div class="wa-console__id">
                    <span>EventHex / WhatsApp Concierge</span>
                    <b>Tech Summit 2026</b>
                  </div>
                  <span class="wa-pill wa-pill--ok">Concierge live</span>
                </div>
                <div class="wa-console__row">
                  <span class="wa-console__label">Event Connect</span>
                  <span class="wa-console__value">On</span>
                </div>
                <div class="wa-console__row">
                  <span class="wa-console__label">Pending handoffs</span>
                  <span class="wa-console__value">2</span>
                </div>
                <div class="wa-console__row">
                  <span class="wa-console__label">Open 24h windows</span>
                  <span class="wa-console__value">18</span>
                </div>
              </div>

              <div class="wa-chat wa-chat--hero" aria-hidden="true">
                <div class="wa-chat__head">
                  <span class="wa-chat__avatar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.3A9 9 0 1 0 12 3Z"></path>
                    </svg>
                  </span>
                  <div class="wa-chat__who">
                    <b>EH Tech Summit Assistant</b>
                    <span>Event-aware help</span>
                  </div>
                </div>
                <div class="wa-chat__body">
                  <p class="wa-bubble wa-bubble--in">Where is the AI keynote?</p>
                  <p class="wa-bubble wa-bubble--out">
                    The AI keynote starts at 10:30 AM in Hall A. Would you like
                    directions?
                  </p>
                  <div class="wa-chips">
                    <span class="wa-chip">Show agenda</span>
                    <span class="wa-chip">My ticket</span>
                  </div>
                </div>
                <div class="wa-chat__foot">
                  <span class="wa-pill wa-pill--info">Talk to the event team</span>
                  <span class="wa-pill">Human handoff requested</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CONVERSATION MODEL BAND ===== -->
    <section id="wa-actions" class="wa-section wa-rail-section">
      <div
        class="wa-flow-band animate-on-scroll"
        data-animation="fadeInUp"
        role="group"
        aria-label="WhatsApp Concierge conversation actions"
      >
        <ul class="wa-flow-band__inner">
          {railSteps.map(([step, copy]) => (
            <li class="wa-flow-band__item">
              <b>{step}</b>{" "}
              {copy}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== SETUP QUAD ===== -->
    <section class="wa-quad-section">
      <div class="wa-quad-header animate-on-scroll" data-animation="fadeInUp">
        <p class="wa-head__eyebrow">A practical setup for each event</p>
        <h2 class="wa-quad-title">
          <span class="wa-quad-title__line">Start on the shared number</span>
          <span class="wa-quad-title__line">or connect your own</span>
        </h2>
        <p class="wa-quad-subtitle">
          <span class="wa-quad-subtitle__line"
            >Turn on Event Connect, enable WhatsApp Concierge for the event,
            and</span
          >
          <span class="wa-quad-subtitle__line"
            >choose how attendees should reach it.</span
          >
        </p>
      </div>

      <div class="wa-quad">
        <article
          class="wa-quad__cell animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="wa-quad__title">EventHex shared number</h3>
          <p class="wa-quad__text">
            Use the shared EventHex WhatsApp entry point without adding a
            separate event number. Attendees can choose from eligible events
            linked to their phone number.
          </p>
        </article>

        <div
          class="wa-quad__cell wa-quad__cell--media animate-on-scroll"
          data-animation="fadeInRight"
        >
          <div class="wa-quad__composite">
            <img
              class="wa-quad__capture wa-quad__capture--primary"
              src="/images/whatsapp-event-concierge/eventhex-whatsapp-concierge-overview.png"
              alt="EventHex WhatsApp Concierge settings for an event, showing the per-event toggle, the Event Connect dependency notice, and concierge status, conversation and pending-handoff counts"
              width="910"
              height="696"
              loading="lazy"
              decoding="async"
            />
            <div
              class="wa-quad__capture wa-quad__capture--secondary"
              aria-hidden="true"
            >
              <div class="wa-panel">
                <p class="wa-panel__label">Choose your event</p>
                <span class="wa-panel__row is-active">Tech Summit 2026</span>
                <span class="wa-panel__row">Design Week 2026</span>
              </div>
            </div>
            <span class="wa-quad__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="m5 12 4 4L19 6"></path></svg
              >
              Eligible events found
            </span>
            <span class="wa-quad__action">Choose your event</span>
          </div>
        </div>

        <div
          class="wa-quad__cell wa-quad__cell--media animate-on-scroll"
          data-animation="fadeInLeft"
        >
          <div class="wa-quad__composite">
            <div
              class="wa-quad__capture wa-quad__capture--primary"
              aria-hidden="true"
            >
              <div class="wa-panel">
                <p class="wa-panel__label">Meta Cloud phone number</p>
                <span class="wa-panel__field">
                  <b>Phone number ID</b>
                  <i>Required</i>
                </span>
                <span class="wa-panel__field">
                  <b>Access token</b>
                  <i>Required</i>
                </span>
                <span class="wa-panel__hint"
                  >Messages bind to the configured event</span
                >
              </div>
            </div>
            <div
              class="wa-quad__capture wa-quad__capture--secondary"
              aria-hidden="true"
            >
              <div class="wa-panel">
                <span class="wa-panel__row is-active">Tech Summit 2026</span>
                <p class="wa-panel__bubble">Where is the AI keynote?</p>
              </div>
            </div>
            <span class="wa-quad__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="m5 12 4 4L19 6"></path></svg
              >
              Bound to one event
            </span>
            <span class="wa-quad__action">Connect your number</span>
          </div>
        </div>

        <article
          class="wa-quad__cell animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="wa-quad__title">Your WhatsApp Business number</h3>
          <p class="wa-quad__text">
            Connect the event to an organizer-owned Meta Cloud phone number and
            access token. Messages for that number bind directly to the
            configured event.
          </p>
        </article>

        <span class="wa-quad__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)"></path>
          </svg>
        </span>
      </div>

      <p class="wa-quad-note">
        Availability depends on the event's Event Connect and WhatsApp
        Concierge settings. Account verification, templates, and Meta platform
        requirements remain part of the
        <a href="/integrations/whatsapp/">WhatsApp Business setup</a>.
      </p>
    </section>

    <!-- ===== EVENT-GROUNDED ANSWERS (dark band + capability grid) ===== -->
    <div class="wa-band">
      <div class="wa-head wa-head--dark animate-on-scroll" data-animation="fadeInUp">
        <p class="wa-head__eyebrow">Answers grounded in the event you configured</p>
        <h2 class="wa-head__title wa-head__title--dark">
          Help attendees find the event information they need now
        </h2>
        <p class="wa-head__subtitle wa-head__subtitle--dark">
          Public event capabilities appear only when the event has the matching
          data or setting.
        </p>
      </div>

      <section class="wa-cap-section">
        <div class="wa-cap">
          <article
            class="wa-cap__cell animate-on-scroll"
            data-animation="fadeInUp"
          >
            <h3 class="wa-cap__label">Agenda and sessions</h3>
            <p class="wa-cap__desc">
              Show the current event schedule and help attendees find relevant
              sessions.
            </p>
            <div class="wa-cap__visual">
              <div class="wa-cap__card" aria-hidden="true">
                <span class="wa-cap__card-head">Agenda</span>
                <div class="wa-cap__row">
                  <span class="wa-cap__row-time">09:30</span>
                  <span class="wa-cap__row-name">Opening keynote</span>
                  <span class="wa-cap__row-tag">Hall A</span>
                </div>
