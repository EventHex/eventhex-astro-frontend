  <script>
    // Opens the dark capability band to full bleed as it scrolls into view.
    function initWaBandBleed() {
      const band = document.querySelector<HTMLElement>(".wa-band");
      if (!band || band.dataset.bleedReady === "true") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      band.dataset.bleedReady = "true";

      let bandTop = 0;
      let vh = window.innerHeight || 1;
      const measure = () => {
        vh = window.innerHeight || 1;
        bandTop = band.getBoundingClientRect().top + window.scrollY;
      };

      let ticking = false;
      let last = -1;
      const update = () => {
        ticking = false;
        const travelled = vh - (bandTop - window.scrollY);
        const p = Math.min(1, Math.max(0, travelled / (vh * 0.7)));
        const rounded = Math.round(p * 100) / 100;
        if (rounded === last) return;
        last = rounded;
        band.style.setProperty("--band-p", String(rounded));
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      const onResize = () => {
        measure();
        last = -1;
        onScroll();
      };

      measure();
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });
      window.addEventListener("load", onResize);
    }

    // Slides the sticky stacking-band header up once the last card sticks.
    function initWaStackRelease() {
      const shell = document.querySelector<HTMLElement>(".wa-stack-shell");
      const header = shell?.querySelector<HTMLElement>(".wa-stack-header");
      const cards = shell?.querySelectorAll<HTMLElement>(".wa-stack-card");
      const last = cards?.[cards.length - 1];
      if (!header || !last) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      let queued = 0;
      const paint = () => {
        queued = 0;
        const stickTop = Number.parseFloat(getComputedStyle(last).top) || 0;
        const release = Math.min(
          0,
          last.getBoundingClientRect().top - stickTop,
        );
        header.style.setProperty("--wa-release-y", `${release}px`);
        header.style.transform = `translateY(${release}px)`;
      };
      const onScroll = () => {
        if (queued) return;
        queued = requestAnimationFrame(paint);
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      paint();
    }

    function initWhatsappConcierge() {
      initWaBandBleed();
      initWaStackRelease();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWhatsappConcierge);
    } else {
      initWhatsappConcierge();
    }
  </script>

  <script>
    // Tabbed sections: click, arrow keys, and gentle auto-rotation.
    function initWaTabGroup(section: HTMLElement) {
      if (section.dataset.suitesReady === "true") return;

      const tabs = Array.from(
        section.querySelectorAll<HTMLButtonElement>(".wa-suite-tab")
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>(".wa-suite-panel")
      );
      if (tabs.length < 2 || panels.length === 0) return;
      section.dataset.suitesReady = "true";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const rail = section.querySelector<HTMLElement>(".wa-suite-tabs");
      let rotationId: number | undefined;

      const revealTab = (tab: HTMLButtonElement, smooth: boolean) => {
        if (!rail || rail.scrollWidth <= rail.clientWidth + 1) return;
        const tabRect = tab.getBoundingClientRect();
        const railRect = rail.getBoundingClientRect();
        if (tabRect.left >= railRect.left && tabRect.right <= railRect.right) {
          return;
        }
        rail.scrollTo({
          left:
            rail.scrollLeft +
            (tabRect.left - railRect.left) -
            (railRect.width - tabRect.width) / 2,
          behavior: smooth && !reduceMotion.matches ? "smooth" : "auto",
        });
      };

      const activate = (
        tab: HTMLButtonElement,
        options: { focus?: boolean; smooth?: boolean } = {}
      ) => {
        const target = tab.dataset.suiteTab;

        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
          item.tabIndex = active ? 0 : -1;
        });

        panels.forEach((panel) => {
          const active = panel.dataset.suitePanel === target;
          panel.classList.toggle("is-active", active);
          if (active) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
        });

        if (options.focus) {
          tab.focus({ preventScroll: true });
        }
        revealTab(tab, options.smooth === true);
      };

      const stopRotation = () => {
        if (rotationId === undefined) return;
        window.clearInterval(rotationId);
        rotationId = undefined;
      };

      const startRotation = () => {
        stopRotation();
        if (reduceMotion.matches) return;
        rotationId = window.setInterval(() => {
          const current = tabs.findIndex(
            (tab) => tab.getAttribute("aria-selected") === "true"
          );
          activate(tabs[(current + 1) % tabs.length]);
        }, 4000);
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          activate(tab, { smooth: true });
          startRotation();
        });
        tab.addEventListener("keydown", (event) => {
          const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
          if (!keys.includes(event.key)) return;
          event.preventDefault();

          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          if (event.key === "ArrowLeft")
            next = (index - 1 + tabs.length) % tabs.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = tabs.length - 1;

          activate(tabs[next], { focus: true, smooth: true });
          startRotation();
        });
      });

      section.addEventListener("mouseenter", stopRotation);
      section.addEventListener("mouseleave", startRotation);
      section.addEventListener("focusin", stopRotation);
      section.addEventListener("focusout", (event) => {
        if (
          !(event.relatedTarget instanceof Node) ||
          !section.contains(event.relatedTarget)
        ) {
          startRotation();
        }
      });
      document.addEventListener("visibilitychange", () => {
        document.hidden ? stopRotation() : startRotation();
      });

      startRotation();
    }

    function initWaAudienceSuites() {
      document
        .querySelectorAll<HTMLElement>(".wa-suite-section")
        .forEach((section) => initWaTabGroup(section));
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWaAudienceSuites);
    } else {
      initWaAudienceSuites();
    }
  </script>
</MarketingLayout>

