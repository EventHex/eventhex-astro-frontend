      "Answer programme questions, surface speakers, recommend sessions, and collect available polls or feedback.",
    checklist: [
      "Programme questions answered",
      "Speaker and session recommendations",
      "Available polls and feedback",
    ],
    event: "Association Congress",
    ask: "Which sessions cover programme analytics?",
