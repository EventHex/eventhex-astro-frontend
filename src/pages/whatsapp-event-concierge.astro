      "Guide invited attendees to their event information, schedule, badge, reminders, and event-team help.",
    checklist: [
      "Invitee event information",
      "Schedule, badge, and reminders",
      "Event-team help on request",
    ],
    event: "Tech Summit 2026",
    ask: "What is my badge and schedule for tomorrow?",
    answerTitle: "Badge ready - VIP",
