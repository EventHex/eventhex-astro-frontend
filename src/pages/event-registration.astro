  .erg-ticket-row span {
    display: grid;
    gap: 4px;
  }
  .erg-ticket-row b {
    color: var(--heading-dark);
  }
  .erg-ticket-row small {
    color: var(--label-gray);
  }
  .erg-ticket-row strong {
    color: var(--heading-dark);
  }
  .erg-ticket-row .is-free {
    color: #0e9f6e;
  }
  .erg-choice-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .erg-choice-card,
  .erg-use-card {
    padding: 32px;
    border: 1px solid #e5eaf3;
    border-radius: 24px;
    background: #f8faff;
  }
  .erg-choice-card > span {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 34px;
    border-radius: 10px;
    color: var(--brand-blue);
    background: #e9eeff;
    font-weight: 800;
  }
  .erg-choice-card h3,
  .erg-dark-card h3,
  .erg-use-card h3 {
    margin: 0 0 10px;
    color: var(--heading-dark);
    font: 700 1.25rem/1.25 var(--font-heading);
  }
  .erg-choice-card p,
  .erg-dark-card p,
  .erg-use-card p {
    margin: 0;
    color: var(--subheading-gray);
    line-height: 1.65;
  }
  .erg-content-note {
    margin: 24px auto 0;
    color: #667085;
    text-align: center;
    font-weight: 500;
  }
  .erg-feature-four {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .erg-dark-card {
    padding: 30px 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.06);
  }
  .erg-dark-card > b {
    display: block;
    margin-bottom: 34px;
    color: #8eabff;
    font-size: 0.75rem;
  }
  .erg-dark-card h3,
  .erg-dark-card p {
    color: #fff;
  }
  .erg-dark-card p {
    opacity: 0.72;
  }
  .erg-message-card {
    max-width: 430px;
    padding: 22px;
    border-radius: 28px;
    background: #e8f4e5;
    box-shadow: 0 28px 80px rgba(30, 91, 51, 0.12);
  }
  .erg-message-card > small {
    display: block;
    margin-bottom: 14px;
    color: #39774d;
    font-weight: 700;
  }
  .erg-message-card > div {
    display: grid;
    gap: 5px;
    padding: 20px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 4px 18px rgba(22, 55, 35, 0.08);
  }
  .erg-message-card b {
    color: var(--heading-dark);
    font-family: var(--font-heading);
  }
  .erg-message-card span {
    color: #475467;
  }
  .erg-message-card em {
    color: #8a94a6;
    font-style: normal;
    font-size: 0.82rem;
  }
  .erg-embed-window {
    padding-bottom: 22px;
  }
  .erg-embed-window__body {
    margin: 24px;
    padding: 22px;
    border: 2px dashed rgba(55, 93, 251, 0.55);
    border-radius: 16px;
    background: #fff;
  }
  .erg-embed-window__body small {
    display: block;
    margin-bottom: 18px;
    color: var(--brand-blue);
    font-weight: 800;
  }
  .erg-embed-window__body label {
    display: block;
    margin: 12px 0 6px;
    color: #475467;
    font-size: 0.78rem;
  }
  .erg-embed-window__body div {
    height: 38px;
    border: 1px solid #dfe4ec;
    border-radius: 8px;
  }
  .erg-embed-window__body button {
    width: 100%;
    margin-top: 16px;
    padding: 11px;
    border: 0;
    border-radius: 9px;
    color: #fff;
    background: var(--brand-blue);
    font-weight: 700;
