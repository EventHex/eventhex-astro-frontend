  .erg-use-cases {
    padding: clamp(82px, 9vw, 116px) 24px;
    background: transparent !important;
  }
  .erg-use-cases .erg-content-shell {
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    box-shadow: none;
  }
  .erg-use-cases .erg-content-heading {
    max-width: none;
    margin: 0;
    padding: 0 24px clamp(52px, 6vw, 72px);
  }
  .erg-use-cases .erg-content-heading h2 {
    max-width: 680px;
    margin: 0 auto;
    font-size: clamp(2.45rem, 4.6vw, 4rem);
  }
  .erg-use-gradient-text {
    background: linear-gradient(90deg, #555 0%, #aaa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .erg-use-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }
  .erg-use-card {
    min-height: 300px;
    padding: 34px 28px 42px;
    border: 0;
    border-right: 1px solid #eee;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .erg-use-card:last-child {
    border-right: 0;
  }
  .erg-use-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-bottom: 38px;
    background: var(--brand-blue);
    color: #fff;
    border-radius: 50%;
    padding: 6px;
  }
  .erg-use-card__icon svg {
    width: 100%;
    height: 100%;
  }
  .erg-use-card h3 {
    margin-bottom: 24px;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: #333;
  }
  .erg-use-card h3 a {
    color: #333;
    text-decoration: none;
  }
  .erg-use-card p {
    font-size: 15px;
    line-height: 1.55;
    color: #666;
  }
  @media (max-width: 900px) {
    .erg-content-split,
    .erg-content-split--reverse {
      grid-template-columns: 1fr;
    }
    .erg-feature-four {
      grid-template-columns: repeat(2, 1fr);
    }
    .erg-content-split--reverse .erg-content-copy {
      order: -1;
    }
    .erg-access-grid {
      grid-template-columns: 1fr;
    }
    .erg-access-card {
      grid-template-columns: 1fr;
    }
    .erg-access-card:nth-child(even) .erg-access-card__visual,
    .erg-access-card:nth-child(even) .erg-access-card__copy {
      order: initial;
    }
    .erg-use-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .erg-use-card:nth-child(2) {
      border-right: 0;
    }
    .erg-use-card:nth-child(-n + 2) {
      border-bottom: 1px solid #dfe5f0;
    }
    .erg-payment-table {
      overflow-x: auto;
    }
    .erg-payment-table__plans,
    .erg-payment-table__row,
    .erg-payment-table__group {
      min-width: 760px;
    }
  }
  @media (max-width: 600px) {
    .erg-content-section {
      padding: 62px 16px;
    }
    .erg-choice-grid,
    .erg-feature-four {
      grid-template-columns: 1fr;
    }
    .erg-choice-card,
    .erg-dark-card,
    .erg-use-card {
      padding: 24px 20px;
    }
    .erg-access-card__visual {
      height: 300px;
      padding: 26px 24px 0;
    }
    .erg-access-card__copy {
      min-height: 0;
      padding: 38px 28px 44px;
    }
    .erg-use-cases {
      padding-inline: 16px;
    }
    .erg-use-grid {
      grid-template-columns: 1fr;
    }
    .erg-use-card,
    .erg-use-card:nth-child(2) {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid #dfe5f0;
    }
    .erg-use-card:last-child {
      border-bottom: 0;
    }
  }

  /* ===== ECOSYSTEM ===== */
  .erg-platform {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 9vw, 112px) 24px clamp(76px, 10vw, 120px);
    background: #fff;
  }
  .erg-platform::before,
  .erg-platform::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0.72;
  }
  .erg-platform::before {
    width: 420px;
    height: 420px;
    left: -180px;
    top: 22%;
    background: radial-gradient(
      circle,
      rgba(55, 93, 251, 0.1),
      rgba(55, 93, 251, 0)
    );
  }
  .erg-platform::after {
    width: 460px;
    height: 460px;
    right: -190px;
    bottom: -120px;
    background: radial-gradient(
      circle,
      rgba(79, 214, 224, 0.12),
      rgba(79, 214, 224, 0)
    );
  }
  .erg-platform__heading {
    position: relative;
    z-index: 1;
    max-width: 760px;
    padding-bottom: 0;
  }
  .erg-platform__heading .erg-heading__eyebrow {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    line-height: 1;
  }
  .erg-platform__heading .erg-heading__title {
    font-size: var(--erg-section-title-size);
    line-height: var(--erg-section-title-line);
    letter-spacing: var(--erg-section-title-tracking);
    font-weight: 700;
    margin-bottom: 1.15rem;
  }
  .erg-platform__heading .erg-heading__subtitle {
    max-width: 720px;
    margin: 0 auto;
  }
  .erg-eco {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding-top: clamp(38px, 5vw, 58px);
  }
  .erg-eco__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.35rem 1.6rem;
  }
  .erg-eco__card {
    position: relative;
    min-width: 0;
    width: min(100%, 342px);
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 1.05rem;
    text-decoration: none;
    overflow: hidden;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 16px 44px rgba(10, 28, 64, 0.045),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }
  .erg-eco__card:nth-child(6) {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(226, 232, 240, 0.95);
    box-shadow:
      0 16px 44px rgba(10, 28, 64, 0.045),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
