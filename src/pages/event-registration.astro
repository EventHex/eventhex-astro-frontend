  .erg-hero {
    position: relative;
    overflow: hidden;
    margin-top: -90px;
    padding: 140px 24px 64px;
    background:
      radial-gradient(
        ellipse 700px 500px at -5% -10%,
        #375dfb24,
        #375dfb0f 40%,
        #375dfb00 75%
      ),
      radial-gradient(
        ellipse 800px 600px at 100% 105%,
        #ff74b83d,
        #ff74b81a 45%,
        #ff74b800 78%
      ),
      #fff;
  }
  .erg-hero:after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 220px;
    max-width: 30vw;
    background: linear-gradient(to right, #fff0, #ffffff73 70%, #ffffffbf);
    pointer-events: none;
    z-index: 2;
  }
  .erg-hero__grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 542px) minmax(0, 490px);
    gap: 48px;
    align-items: center;
  }
  .erg-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .erg-hero__badge {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: normal;
    color: var(--brand-blue);
  }
  .erg-hero__title {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading);
    font-size: 60px;
    font-weight: 700;
    line-height: 66px;
    letter-spacing: -2.1px;
    background: linear-gradient(
      98deg,
      var(--heading-dark) 43.06%,
      #8f8f8f 91.81%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .erg-hero__desc {
    margin: 0;
    width: 100%;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.25px;
    color: var(--subheading-gray);
  }
  .erg-hero__cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 8px;
    flex-wrap: wrap;
  }
  .erg-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 20px;
    border-radius: 12px;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.36px;
    line-height: 24px;
    background: var(--heading-dark);
    color: #fff;
    transition:
      transform 0.3s,
      background 0.3s;
  }
  .erg-hero__btn:hover {
    transform: translateY(-2px);
    background: #000;
  }
  .erg-hero__cta-note {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
    color: var(--subheading-gray);
    max-width: 156px;
  }
  .erg-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding-top: 4px;
  }
  .erg-hero__trust-item {
    position: relative;
    padding-left: 16px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--heading-dark);
  }
  .erg-hero__trust-item:before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }
  .erg-hero__visual {
    position: relative;
    margin-right: calc(-1 * (max(0px, (100vw - 1128px) / 2) + 24px));
  }
  .erg-hero__visual-card {
    position: relative;
    padding: 14px;
    border-radius: 22px 0 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-right: none;
    background: linear-gradient(180deg, #ffffff9e, #ffffff47), #ffffff57;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .erg-hero__visual-inner {
    position: relative;
    border-radius: 16px 0 0 16px;
    overflow: hidden;
    padding: 32px;
    background: linear-gradient(135deg, #d9ecfa, #eef6fc 45%, #fff);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .erg-hero__lottie {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }
  .erg-hero__lottie svg {
    width: 100% !important;
    height: auto !important;
  }

  /* ===== TRUST STRIP ===== */
  .erg-trust-strip {
    border-top: 1px solid var(--surface-card-border);
    padding: 1.5rem;
  }
  .erg-trust-strip__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.25rem;
  }
  .erg-trust-strip__label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--label-gray);
  }
  .erg-trust-strip__stat {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--subheading-gray);
    white-space: nowrap;
  }
  .erg-trust-strip__stat b {
    color: var(--heading-dark);
    font-weight: 700;
  }

  /* ===== SPOTLIGHT (CHOOSE REGISTRATION FLOW) ===== */
  .erg-flow-section {
    padding: 40px 24px;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .erg-flow-header {
    text-align: center;
    max-width: 800px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .erg-flow-eyebrow {
    font-family: var(--font-body, monospace);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #7b5aff;
    margin-bottom: 16px;
  }
  .erg-flow-title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 700;
    color: #333;
    line-height: 1.1;
    margin: 0 0 12px;
    letter-spacing: -0.04em;
  }
  .erg-flow-title-dim {
    background: linear-gradient(90deg, #333 0%, #aaa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .erg-flow-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--subheading-gray, #555);
    line-height: 1.5;
    margin: 0;
    max-width: 640px;
  }
  .erg-flow-compare {
    display: flex;
    max-width: 1024px;
    width: 100%;
    margin: 0 auto 24px;
    border-radius: 12px;
    background: transparent !important;
    box-shadow: none;
  }
  .erg-flow-column {
    flex: 1;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
  }
  .erg-flow-column--left {
    border-right: 1px solid #eef0f3;
  }
  .erg-flow-column__title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--heading-dark, #1e1d24);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .erg-flow-column__intro {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--subheading-gray, #555);
    line-height: 1.6;
    margin: 0;
  }
  .erg-flow-column__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .erg-flow-column__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--subheading-gray, #555);
    line-height: 1.5;
  }
  .erg-flow-icon {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .erg-flow-icon--cross path {
    stroke: #e63946;
  }
  .erg-flow-icon--check path {
    stroke: #079455;
  }
  .erg-flow-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    padding: 12px 20px;
    border-radius: 6px;
    background: #f1f2f4;
    color: var(--heading-dark, #1e1d24);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    width: max-content;
    transition: background 0.2s;
  }
  .erg-flow-cta:hover {
    background: #e2e4e7;
  }
  @media (max-width: 768px) {
    .erg-flow-compare {
      flex-direction: column;
    }
    .erg-flow-column--left {
      border-right: none;
      border-bottom: 1px solid #eef0f3;
    }
    .erg-flow-column {
      padding: 32px 24px;
    }
    .erg-flow-section {
      padding: 60px 16px;
    }
  }

  /* ===== PAYMENT REDESIGN ===== */
  .erg-payment-redesign {
    padding: 100px 24px;
    background: linear-gradient(180deg, #f8fafc, #ffffff);
  }
  .erg-payment-compare__intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 64px;
  }
  .erg-payment-compare__intro h2 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    color: var(--heading-dark);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }
  .erg-payment-compare__intro p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--subheading-gray);
  }

  .erg-payment-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
    max-width: 1140px;
    margin: 0 auto;
  }

  .erg-paycard {
    background: #fff;
    border: 1px solid #eef0f3;
    border-radius: 24px;
    padding: 40px 32px;
    position: relative;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 1;
  }

  .erg-paycard:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    border-color: #d1d5db;
    z-index: 2;
  }

  .erg-paycard--featured {
    background: linear-gradient(145deg, #16151a, #2a2a35);
    color: #fff;
    border: none;
    box-shadow: 0 20px 48px rgba(30, 29, 36, 0.15);
  }

  .erg-paycard--featured:hover {
    box-shadow: 0 30px 60px rgba(30, 29, 36, 0.25);
    border-color: transparent;
  }

  .erg-paycard__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 99px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .erg-paycard__icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: transform 0.3s ease;
  }

  .erg-paycard:hover .erg-paycard__icon {
    transform: scale(1.05);
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__icon {
    background: #f8fafc;
    color: #4f8cff;
  }

  .erg-paycard--featured .erg-paycard__icon {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .erg-paycard h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .erg-paycard p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 32px;
  }

  .erg-paycard:not(.erg-paycard--featured) p {
    color: var(--subheading-gray);
  }

  .erg-paycard--featured p {
    color: rgba(255, 255, 255, 0.8);
  }

  .erg-paycard__features {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .erg-paycard__features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__features li {
    color: var(--heading-dark);
  }

  .erg-paycard--featured .erg-paycard__features li {
    color: #fff;
  }

  .erg-paycard__features svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__features svg {
    color: #079455; /* Green checkmarks */
  }

  .erg-paycard--featured .erg-paycard__features svg {
    color: #10b981; /* Brighter green for dark mode */
  }

  @media (max-width: 768px) {
    .erg-payment-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ===== ACCESS REDESIGN ===== */
  .erg-access-redesign {
    padding: 100px 24px;
    background: #fff;
  }
  .erg-access-redesign__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: stretch;
  }
  .erg-access-redesign__left {
    flex: 0 0 40%;
  }
  .erg-access-redesign__sticky {
    position: sticky;
    top: 120px;
  }
  .erg-access-redesign__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f4f5f7;
    padding: 6px 12px;
    border-radius: 99px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--heading-dark);
    margin-bottom: 24px;
  }
  .erg-access-redesign__left h2 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    color: var(--heading-dark);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }
  .erg-access-redesign__left p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--subheading-gray);
  }

  .erg-access-redesign__right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .erg-access-rcard {
    background: #f4f5f7;
    border-radius: 24px;
    padding: 32px;
    transition: transform 0.3s ease;
    position: sticky;
    top: 80px;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.05);
  }

  .erg-access-rcard:nth-child(1) {
    top: 80px;
  }
  .erg-access-rcard:nth-child(2) {
    top: 100px;
  }
  .erg-access-rcard:nth-child(3) {
    top: 120px;
  }
  .erg-access-rcard:nth-child(4) {
    top: 140px;
  }

  .erg-access-rcard:hover {
    transform: translateY(-4px);
  }

  .erg-access-rcard__header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .erg-access-rcard__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .erg-access-rcard__text h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--heading-dark);
    margin: 0 0 8px;
  }

  .erg-access-rcard__text p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--subheading-gray);
    margin: 0;
  }

  .erg-access-rcard__text p a {
    color: #0055ff;
    text-decoration: underline;
  }

  .erg-access-rcard__visual {
    background: #fff;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .erg-access-rcard__visual img {
    max-width: 100%;
    width: 100%;
    max-height: 280px;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
  }

  @media (max-width: 992px) {
    .erg-access-redesign__container {
      flex-direction: column;
      gap: 40px;
    }
    .erg-access-redesign__left {
      flex: none;
      width: 100%;
    }
    .erg-access-redesign__left h2 {
      white-space: normal;
    }
    .erg-access-redesign__sticky {
      position: static;
    }
    .erg-access-rcard {
      padding: 32px 24px;
    }
    .erg-access-rcard__header {
      flex-direction: column;
      gap: 16px;
    }
    .erg-access-rcard__visual {
      padding: 24px;
    }
  }

  /* ===== HERO RESPONSIVE ===== */
  @media (max-width: 1120px) {
    .erg-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: 32px;
    }
    .erg-hero__title {
      font-size: 46px;
      line-height: 52px;
      letter-spacing: -1.5px;
    }
  }
  @media (max-width: 960px) {
    .erg-hero {
      padding: 130px 20px 48px;
    }
    .erg-hero:after {
      display: none;
    }
    .erg-hero__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }
    .erg-hero__content {
      align-items: center;
    }
    .erg-hero__desc {
      max-width: 520px;
    }
    .erg-hero__cta-row,
    .erg-hero__trust {
      justify-content: center;
    }
    .erg-hero__visual {
      margin-right: 0;
    }
    .erg-hero__visual-card {
      border-radius: 22px;
      border-right: 1px solid rgba(255, 255, 255, 0.62);
    }
    .erg-hero__visual-inner {
      border-radius: 16px;
    }
  }
  @media (max-width: 767px) {
    .erg-hero {
      margin-top: -80px;
      padding: 112px 16px 40px;
    }
    .erg-hero__title {
      font-size: 34px;
      line-height: 40px;
      letter-spacing: -0.8px;
    }
    .erg-hero__cta-row {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .erg-hero__btn {
      width: 100%;
      justify-content: center;
    }
    .erg-hero__cta-note {
      max-width: 100%;
      text-align: center;
    }
    .erg-trust-strip__inner {
      justify-content: center;
      text-align: center;
    }
  }

  /* ===== HEADING ===== */
  .erg-heading {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 24px 8px;
    text-align: center;
  }
  .erg-heading__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-blue);
    margin-bottom: 0.75rem;
  }
  .erg-heading__title {
    font-family: var(--font-heading);
    font-size: var(--erg-section-title-size);
    font-weight: 700;
    color: var(--heading-dark);
    line-height: var(--erg-section-title-line);
    letter-spacing: var(--erg-section-title-tracking);
    margin: 0 0 0.75rem;
  }
  .erg-heading__title .dim {
    color: #9aa1ae;
  }
  .erg-heading__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--subheading-gray);
    margin: 0;
  }
  .erg-capabilities-heading {
    max-width: 980px;
  }

  /* ===== SPOTLIGHT ===== */
  #erg-spotlight {
    background: #fff;
    padding: clamp(72px, 9vw, 112px) 24px;
    overflow: hidden;
  }
  #erg-spotlight .erg-heading {
    max-width: 860px;
    padding: 10px 20px 20px;
    text-align: center;
  }
  #erg-spotlight .erg-heading__title {
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    color: var(--heading-dark);
    font-size: clamp(2.35rem, 4vw, 3.15rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  #erg-spotlight .erg-heading__title .dim {
    color: #9aa1ae;
  }
  #erg-spotlight .erg-heading__subtitle {
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
    color: var(--subheading-gray);
    font-size: 1.05rem;
    line-height: 1.55;
  }
  #erg-spotlight .animate-on-scroll {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
  }
  #erg-spotlight .erg-spot-grid--legacy {
    display: none;
  }
  @media (max-width: 860px) {
    #erg-spotlight .erg-heading {
      text-align: center;
    }
    #erg-spotlight .erg-heading__title,
