  /* ===== PAYMENT REDESIGN ===== */
  .erg-payment-redesign {
    padding: 100px 24px;
    background: linear-gradient(180deg, #f8fafc, #ffffff);
  }
  .erg-payment-compare__intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 64px;
  }
  .erg-payment-compare__intro h2 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    color: var(--heading-dark);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }
  .erg-payment-compare__intro p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--subheading-gray);
  }

  .erg-payment-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
    max-width: 1140px;
    margin: 0 auto;
  }

  .erg-paycard {
    background: #fff;
    border: 1px solid #eef0f3;
    border-radius: 24px;
    padding: 40px 32px;
    position: relative;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 1;
  }

  .erg-paycard:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    border-color: #d1d5db;
    z-index: 2;
  }

  .erg-paycard--featured {
    background: linear-gradient(145deg, #16151a, #2a2a35);
    color: #fff;
    border: none;
    box-shadow: 0 20px 48px rgba(30, 29, 36, 0.15);
  }

  .erg-paycard--featured:hover {
    box-shadow: 0 30px 60px rgba(30, 29, 36, 0.25);
    border-color: transparent;
  }

  .erg-paycard__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 99px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .erg-paycard__icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: transform 0.3s ease;
  }

  .erg-paycard:hover .erg-paycard__icon {
    transform: scale(1.05);
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__icon {
    background: #f8fafc;
    color: #4f8cff;
  }

  .erg-paycard--featured .erg-paycard__icon {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .erg-paycard h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .erg-paycard p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 32px;
  }

  .erg-paycard:not(.erg-paycard--featured) p {
    color: var(--subheading-gray);
  }

  .erg-paycard--featured p {
    color: rgba(255, 255, 255, 0.8);
  }

  .erg-paycard__features {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .erg-paycard__features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__features li {
    color: var(--heading-dark);
  }

  .erg-paycard--featured .erg-paycard__features li {
    color: #fff;
  }

  .erg-paycard__features svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .erg-paycard:not(.erg-paycard--featured) .erg-paycard__features svg {
    color: #079455; /* Green checkmarks */
  }

  .erg-paycard--featured .erg-paycard__features svg {
    color: #10b981; /* Brighter green for dark mode */
  }

  @media (max-width: 768px) {
    .erg-payment-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ===== ACCESS REDESIGN ===== */
  .erg-access-redesign {
    padding: 100px 24px;
    background: #fff;
  }
  .erg-access-redesign__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: stretch;
  }
  .erg-access-redesign__left {
    flex: 0 0 40%;
  }
  .erg-access-redesign__sticky {
    position: sticky;
    top: 120px;
  }
  .erg-access-redesign__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f4f5f7;
    padding: 6px 12px;
    border-radius: 99px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--heading-dark);
    margin-bottom: 24px;
  }
  .erg-access-redesign__left h2 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 500;
    color: var(--heading-dark);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }
  .erg-access-redesign__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .erg-access-redesign__cta:hover {
    background: #000;
    transform: translateY(-1px);
  }
  .erg-access-redesign__left p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--subheading-gray);
  }

  .erg-access-redesign__right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .erg-access-rcard {
    background: #f4f5f7;
    border-radius: 24px;
    padding: 32px;
    transition: transform 0.3s ease;
    position: sticky;
    top: 80px;
  }

  .erg-access-rcard:nth-child(1) {
    top: 80px;
  }
  .erg-access-rcard:nth-child(2) {
    top: 100px;
  }
  .erg-access-rcard:nth-child(3) {
    top: 120px;
  }
  .erg-access-rcard:nth-child(4) {
    top: 140px;
  }

  .erg-access-rcard:hover {
    transform: translateY(-4px);
  }

  .erg-access-rcard__header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .erg-access-rcard__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .erg-access-rcard__text h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--heading-dark);
    margin: 0 0 8px;
  }

  .erg-access-rcard__text p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--subheading-gray);
    margin: 0;
  }

  .erg-access-rcard__text p a {
    color: #0055ff;
    text-decoration: underline;
  }

  .erg-access-rcard__visual {
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .erg-access-rcard:nth-child(1) .erg-access-rcard__visual {
    background: linear-gradient(180deg, #fff9dc 0%, #fffdf1 48%, #ffffff 100%);
  }

  .erg-access-rcard:nth-child(2) .erg-access-rcard__visual {
    background: linear-gradient(180deg, #e9f9f0 0%, #f5fcf8 48%, #ffffff 100%);
  }

  .erg-access-rcard:nth-child(3) .erg-access-rcard__visual {
    background: linear-gradient(180deg, #eef1ff 0%, #f8f9ff 48%, #ffffff 100%);
  }

  .erg-access-rcard:nth-child(4) .erg-access-rcard__visual {
    background: linear-gradient(180deg, #fdeff3 0%, #fff8fa 48%, #ffffff 100%);
  }

  .erg-access-rcard__visual img {
    max-width: 100%;
    width: 100%;
    max-height: 280px;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
  }

  .erg-access-rcard__visual--approval {
    padding: 20px;
  }

  .erg-approval-stack {
    position: relative;
    width: 100%;
    height: 280px;
  }

  .erg-approval-stack img {
    position: absolute;
    width: 76%;
    max-width: none;
    max-height: none;
    border: 1px solid #e2e4e9;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 14px 30px rgba(17, 24, 39, 0.14);
  }

  .erg-approval-stack__tickets {
    top: 0;
    left: 0;
  }

  .erg-approval-stack__setting {
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .erg-access-rcard__visual--product-shot {
    padding: 18px;
  }

  .erg-access-product-shot {
    position: relative;
    width: 100%;
    height: 280px;
  }

  .erg-access-product-shot > img {
    position: absolute;
    inset: 10px 8px 18px;
    width: calc(100% - 16px);
    height: calc(100% - 28px);
    max-width: none;
    max-height: none;
    border: 1px solid #e2e4e9;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 16px 34px rgba(17, 24, 39, 0.14);
    object-fit: cover;
  }

  .erg-access-product-shot--payment > img {
    object-position: 50% 58%;
  }

  .erg-access-product-shot--private > img {
    object-position: 50% 28%;
  }

  .erg-access-product-shot--rules > img {
    object-position: 50% 20%;
  }

  .erg-access-product-shot__status,
  .erg-access-product-shot__action {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    border-radius: 10px;
    box-shadow: 0 10px 24px rgba(17, 24, 39, 0.16);
  }

  .erg-access-product-shot__status {
    top: 0;
    left: 0;
    gap: 7px;
    padding: 9px 12px;
    border: 1px solid #dfe4f2;
    background: #fff;
    color: #253047;
  }

  .erg-access-product-shot__status svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .erg-access-product-shot__status--success {
    border-color: #ccebd8;
    background: #edfbf3;
    color: #18864b;
  }

  .erg-access-product-shot__status--approval {
    border-color: #d9dfff;
    background: #f1f3ff;
    color: #4b65f6;
  }

  .erg-access-product-shot__action {
    right: 10px;
    bottom: 0;
    padding: 11px 15px;
    background: #4b65f6;
    color: #fff;
  }

  .erg-access-product-shot__cursor {
    position: absolute;
    right: 2px;
    bottom: 27px;
    z-index: 3;
    width: 24px;
    height: 28px;
    fill: #111827;
    stroke: #fff;
    stroke-width: 2;
    stroke-linejoin: round;
    filter: drop-shadow(0 4px 5px rgba(17, 24, 39, 0.25));
    animation: erg-access-cursor-tap 2.4s ease-in-out infinite;
  }

  @keyframes erg-access-cursor-tap {
    0%,
    65%,
    100% {
      transform: translate(0, 0);
    }
    74% {
      transform: translate(-3px, 3px) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .erg-access-product-shot__cursor {
      animation: none;
    }
  }

  @media (max-width: 992px) {
    .erg-access-redesign__container {
      flex-direction: column;
      gap: 40px;
    }
    .erg-access-redesign__left {
      flex: none;
      width: 100%;
    }
    .erg-access-redesign__left h2 {
      white-space: normal;
    }
    .erg-access-redesign__sticky {
      position: static;
    }
    .erg-access-rcard {
      padding: 32px 24px;
    }
    .erg-access-rcard__header {
      flex-direction: column;
      gap: 16px;
    }
    .erg-access-rcard__visual {
      padding: 24px;
    }

    .erg-access-rcard__visual--approval {
      padding: 16px;
    }

    .erg-approval-stack {
      height: 240px;
    }

    .erg-approval-stack img {
      width: 82%;
    }

    .erg-access-rcard__visual--product-shot {
      padding: 14px;
    }

    .erg-access-product-shot {
      height: 240px;
    }

    .erg-access-product-shot__status,
    .erg-access-product-shot__action {
      font-size: 11px;
    }
  }

