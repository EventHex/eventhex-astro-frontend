    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }
  .erg-cta__right::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 70% 50%,
      rgba(255, 100, 200, 0.15),
