---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import LottiePlayer from "../components/LottiePlayer.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex — Event Registration Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Event registration software for single sign-up forms or full checkout, with custom fields, payments, and email and WhatsApp confirmations.",
  url: "https://eventhex.ai/event-registration/",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free demo available",
  },
  featureList: [
    "Single Registration",
    "Multi-Ticket Checkout",
    "Custom Registration Forms",
    "Free and Paid Tickets",
    "Approval Workflows",
    "Email and WhatsApp Confirmations",
    "Embedded Registration",
    "Invitation-Only Events",
    "QR Check-In and Badge Printing",
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    [
      "What is the difference between the two registration modes?",
      "Single registration is one form for one person taking one ticket. Checkout lets one buyer select several tickets and pay once. You choose per event.",
    ],
    [
      "Can I collect different information for different ticket types?",
      "Yes. Shared questions and ticket-specific questions are built on the same screen, so each pass can collect exactly what it needs.",
    ],
    [
      "Can I take registrations for a free event?",
      "Yes. Free tickets skip the payment gateway and take the attendee straight to confirmation with their badge.",
    ],
    [
      "Can I approve people before confirming them?",
      "Yes. Registrations can wait for approval, and paid tickets can authorise the card at checkout and charge it only after approval.",
    ],
    [
      "Can I put registration on my own website?",
      "Yes. Embed either the registration form or full checkout with tickets pre-selected, so people can register without leaving your website.",
    ],
    [
      "Do attendees get their ticket automatically?",
      "Yes. Confirmation can go out by email, WhatsApp, or both, with the badge attached. Attendees can also download their badge and add the event to their calendar.",
    ],
    [
      "Can I run an invitation-only event?",
      "Yes. Send invitations, collect yes, maybe or no responses, and close the registration page to everyone who was not invited. Invitees can bring guests up to a limit you set.",
    ],
    [
      "What happens with the data on event day?",
      "Every registration carries a QR code your team scans at the door to check people in and print badges. Walk-ins can be registered at the desk and printed on the spot.",
    ],
  ].map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  title="Event Registration Software That Fits How People Sign Up | EventHex"
  description="Run a single registration form or a full checkout, collect the details and payments you need, and confirm attendees by email and WhatsApp."
  canonical="https://eventhex.ai/event-registration/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="erg-registration-page-bg">
    <!-- ===== HERO ===== -->
    <section class="erg-hero">
      <div class="erg-hero__grid">
        <div class="erg-hero__content">
          <span
            class="erg-hero__badge animate-on-scroll"
            data-animation="fadeInDown">Event Registration</span
          >
          <h1
            class="erg-hero__title animate-on-scroll"
            data-animation="fadeInUp"
          >
            Event registration software that fits how people actually sign up
          </h1>
          <p
            class="erg-hero__desc animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 800ms"
          >
            Take sign-ups through a single form or a full checkout, build
            exactly the fields you need, collect payment if you charge, and
            confirm by email and WhatsApp — without stitching four tools
            together.
          </p>
          <div
            class="erg-hero__cta-row animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 1100ms"
          >
            <a href="/book-a-demo/" class="erg-hero__btn">
              See it with your event
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            <span class="erg-hero__cta-note">Compare the two modes.</span>
          </div>
          <div
            class="erg-hero__trust animate-on-scroll"
            data-animation="fadeIn"
            style="--anim-duration: 1250ms"
          >
            <span class="erg-hero__trust-item">500+ events</span>
            <span class="erg-hero__trust-item">15+ countries</span>
          </div>
        </div>
        <div
          class="erg-hero__visual animate-on-scroll"
          data-animation="fadeInRight"
        >
          <div class="erg-hero__visual-card">
            <div class="erg-hero__visual-inner">
              <LottiePlayer
                src="/animations/event-registration-hero.json"
                class="erg-hero__lottie"
                eager
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TRUST STRIP ===== -->
    <section class="erg-trust-strip">
      <div class="erg-trust-strip__inner">
        <span class="erg-trust-strip__stat"
          ><b>500+</b> Events Run on EventHex</span
        >
        <span class="erg-trust-strip__stat"><b>15+</b> Countries</span>
        <span class="erg-trust-strip__stat"
          ><b>Free &amp; Paid</b> Registration</span
        >
        <span class="erg-trust-strip__stat"
          ><b>0%</b> Platform Fees on Your Gateway</span
        >
      </div>
    </section>

    <!-- ===== SPOTLIGHT (CHOOSE REGISTRATION FLOW) ===== -->
    <section id="erg-spotlight" class="erg-flow-section">
      <div class="erg-flow-header">
        <span
          class="erg-flow-eyebrow animate-on-scroll"
          data-animation="fadeInUp">THE EVENTHEX WAY</span
        >
        <h2 class="erg-flow-title animate-on-scroll" data-animation="fadeInUp">
          One form, or a full <span class="erg-flow-title-dim">checkout,</span
          ><br />your call
        </h2>
        <p
          class="erg-flow-subtitle animate-on-scroll"
          data-animation="fadeInUp"
        >
          Pick the flow that matches how people sign up for your event. You can
          change it per event.
        </p>
      </div>

      <div class="erg-flow-compare animate-on-scroll" data-animation="fadeInUp">
        <article class="erg-flow-column erg-flow-column--left">
          <h3 class="erg-flow-column__title">Single registration</h3>
          <p class="erg-flow-column__intro">
            One person, one ticket, one form. They fill it in and they are done
            — the fastest path for free events, workshops and webinars.
          </p>
        </article>

        <article class="erg-flow-column erg-flow-column--right">
          <h3 class="erg-flow-column__title">Checkout</h3>
          <p class="erg-flow-column__intro">
            One buyer, several tickets, one payment. A cart flow for teams
            booking together, families, and companies sending a group.
          </p>
          <a class="erg-flow-cta" href="/book-a-demo/">
            <span>Get started. It's FREE</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M6 3l5 5-5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </article>
      </div>
      <p class="erg-content-note">
        Not sure? Most free events use single registration. Anything where one
        person pays for several people needs checkout.
      </p>
    </section>

    <!-- ===== CORE CAPABILITIES HEADING ===== -->
    <div class="erg-heading erg-capabilities-heading">
      <h2
        class="erg-heading__title animate-on-scroll"
        data-animation="fadeInUp"
      >
        Build the form <span class="erg-global-heading-gradient"
          >you actually need</span
        >
      </h2>
    </div>

    <!-- ===== CAPABILITIES GRID ===== -->
    <section class="erg-grid-section">
      <div class="erg-grid">
        <div
          class="erg-grid__item animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="0"
        >
          <div class="erg-grid__icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="18" y1="20" x2="18" y2="10"></line><line
                x1="12"
                y1="20"
                x2="12"
                y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg
            >
          </div>
          <h3 class="erg-grid__item-title">Start from ready-made fields</h3>
          <p class="erg-grid__item-desc">
            Name, email, phone, company, job title, country, website, photo, and
            more — then add your own.
          </p>
        </div>

        <div
          class="erg-grid__item animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="60"
        >
          <div class="erg-grid__icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="17 8 12 3 7 8"></polyline><line
                x1="12"
                y1="3"
                x2="12"
                y2="15"></line></svg
            >
          </div>
          <h3 class="erg-grid__item-title">Thirteen field types</h3>
          <p class="erg-grid__item-desc">
            Text, email, number, date, time, dropdown, multi-select, checkbox,
            file upload, rating, NPS, password and information blocks.
          </p>
        </div>

        <div
          class="erg-grid__item animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="120"
        >
          <div class="erg-grid__icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
              ></path><polyline points="9 12 11 14 15 10"></polyline></svg
            >
          </div>
          <h3 class="erg-grid__item-title">
            Ask different questions per ticket
          </h3>
          <p class="erg-grid__item-desc">
            Shared questions everyone answers sit alongside questions only one
            ticket type sees, edited on the same screen.
          </p>
        </div>

        <div
          class="erg-grid__item animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="0"
        >
          <div class="erg-grid__icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg
            >
          </div>
          <h3 class="erg-grid__item-title">Collect files at sign-up</h3>
          <p class="erg-grid__item-desc">
            Portfolios, ID documents, dietary forms, signed waivers — accept
            uploads as part of registration.
          </p>
        </div>

        <div
          class="erg-grid__item animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="60"
        >
          <div class="erg-grid__icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><line
                x1="2"
                y1="12"
                x2="22"
                y2="12"></line><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
          </div>
          <h3 class="erg-grid__item-title">Works in your languages</h3>
          <p class="erg-grid__item-desc">
            Field labels carry per-language overrides for international
            audiences.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== ACCESS CONTROL ===== -->
    <section class="erg-content-section erg-access-redesign">
      <div class="erg-access-redesign__container">
        <div class="erg-access-redesign__left">
          <div
            class="erg-access-redesign__sticky animate-on-scroll"
            data-animation="fadeInUp"
          >
            <div class="erg-access-redesign__eyebrow">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
              Access Control
            </div>
            <h2>
              Control who <span class="erg-global-heading-gradient"
                >gets in</span
              >
            </h2>
            <p>
              Set the approval, payment, visibility, and capacity rules that fit
              each registration flow.
            </p>
          </div>
        </div>

        <div class="erg-access-redesign__right">
          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">01</div>
              <div class="erg-access-rcard__text">
                <h3>Approve before confirming</h3>
                <p>
                  Review each registration and approve or reject it. Rejected
                  registrations get their own message.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual">
              <img
                src="/feature-images/centralized-dashboard/role-access-visual.svg"
                alt="EventHex registration approval and role access controls"
                loading="lazy"
              />
            </div>
          </article>

          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="60"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">02</div>
              <div class="erg-access-rcard__text">
                <h3>Hold the payment</h3>
                <p>
                  Authorise the card at checkout and charge only once you
                  approve. Nothing is taken if you say no.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual">
              <img
                src="/feature-images/event-ticketing/secure-payment.svg"
                alt="EventHex secure payment authorisation workflow"
                loading="lazy"
              />
            </div>
          </article>

          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="120"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">03</div>
              <div class="erg-access-rcard__text">
                <h3>Private tickets</h3>
                <p>
                  Keep a ticket off the public page and share it by direct link
                  only.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual">
              <img
                src="/feature-images/event-ticketing/custom-ticketing-brand.svg"
                alt="EventHex private ticket access page"
                loading="lazy"
              />
            </div>
          </article>

          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="180"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">04</div>
              <div class="erg-access-rcard__text">
                <h3>Ticket-specific rules</h3>
                <p>
                  Limits per purchase, limits per person across separate orders,
                  and <a href="/event-ticketing/">sale windows</a> that open and close
                  on their own.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual">
              <img
                src="/feature-images/session-management/capacity-access-v2.svg"
                alt="EventHex ticket capacity and access rules"
                loading="lazy"
              />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== ATTENDEE DATA ===== -->
    <!-- ===== ATTENDEE DATA (TEMPLATE STYLE) ===== -->
    <section class="erg-template-section">
      <div class="erg-template-shell">
        <div
          class="erg-template-heading animate-on-scroll"
          data-animation="fadeInUp"
        >
          <div class="erg-template-eyebrow">DATA COLLECTION</div>
          <h2 class="erg-template-title">
            Decide how much you collect from each attendee.
          </h2>
          <p class="erg-template-subtitle">
            When one person books for several people, you choose what happens
            next.
          </p>
        </div>
        <div class="erg-template-grid">
          <article
            class="erg-template-card animate-on-scroll"
            data-animation="fadeInUp"
          >
            <div class="erg-template-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                ></path><circle cx="12" cy="7" r="4"></circle></svg
              >
            </div>
            <div class="erg-template-content">
              <h3>Collect everyone's details</h3>
              <p>
                Each ticket gets its own form, so you know exactly who is
                attending, what they need and what they answered. Best when
                badges, dietary needs or sessions matter.
              </p>
            </div>
          </article>

          <article
            class="erg-template-card animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="100"
          >
            <div class="erg-template-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                ></path><circle cx="9" cy="7" r="4"></circle><path
                  d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
                  d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
              >
            </div>
            <div class="erg-template-content">
              <h3>Take the buyer's details</h3>
              <p>
                The rest inherit the buyer's name and email, and checkout stays
                short. Best when speed matters more than per-person data.
              </p>
            </div>
          </article>

          <article
            class="erg-template-card animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="200"
          >
            <div class="erg-template-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                ></path><path
                  d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                ></path></svg
              >
            </div>
            <div class="erg-template-content">
              <h3>Change rules per event</h3>
              <p>
                You can change this rule per event, and switch it on later if
                the first approach proves too thin or you need more data.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== FINAL CTA ===== -->
    <section class="erg-page-cta-wrapper">
      <div
        class="erg-page-cta-banner animate-on-scroll"
        data-animation="fadeInUp"
      >
        <div class="erg-page-cta-glow" aria-hidden="true"></div>
        <div class="erg-page-cta-left">
          <span class="erg-page-cta-pill">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                y1="15"
                x2="12"
                y2="3"></line></svg
            >
            Trusted Event Platform
          </span>
          <h3 class="erg-page-cta-title">Ready to open registrations?</h3>
          <p class="erg-page-cta-subtitle">
            All your ticketing, agenda, and attendee data in one secure
            platform.
          </p>
          <a href="/book-a-demo/" class="erg-page-cta-button">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="4" width="18" height="18" rx="2"></rect><line
                x1="16"
                y1="2"
                x2="16"
                y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                x1="3"
                y1="10"
                x2="21"
                y2="10"></line></svg
            >
            Book a Demo
          </a>
        </div>
        <div class="erg-page-cta-right">
          <div class="erg-page-cta-img">
            <LottiePlayer
              src="/animations/event-registration-hero.json"
              eager
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CONFIRMATIONS BENTO GRID ===== -->
    <section class="erg-bento-section">
      <div class="erg-bento-container">
        <div class="erg-bento-header animate-on-scroll" data-animation="fadeInUp">
          <h2>
            Confirmations that reach <span class="erg-global-heading-gradient">people</span>
          </h2>
        </div>
        
        <div class="erg-bento-grid animate-on-scroll" data-animation="fadeInUp">
          <!-- Row 1: Visual Left, Content Right -->
          <div class="erg-bento-row">
            <div class="erg-bento-cell erg-bento-visual">
              <div class="erg-bento-shot-stage erg-bento-shot-stage--confirm">
                <img class="erg-bento-product-shot" src="/feature-images/event-registration/confirmation-delivery.png" alt="EventHex WhatsApp confirmation campaigns dashboard" loading="lazy" />
                <span class="erg-shot-float erg-shot-float--top"><b>✓ Delivered</b><small>Email + WhatsApp</small></span>
                <span class="erg-shot-float erg-shot-float--bottom"><i></i><b>Badge attached</b></span>
              </div>
            </div>
            <div class="erg-bento-cell erg-bento-content">
              <span class="erg-bento-eyebrow">Automated</span>
              <h3>Confirmations that reach people</h3>
              <p>Every registration triggers a confirmation by email, <a href="/whatsapp-event-concierge/">WhatsApp</a>, or both — with the badge attached if you want it. Approval and rejection messages have their own templates, and you can edit all of them per event and per language.</p>
