  }
  .erg-cta__desc {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.85);
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 480px;
  }
  .erg-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: #000;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    padding: 16px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .erg-cta__btn:hover {
