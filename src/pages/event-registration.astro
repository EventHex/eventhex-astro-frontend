  .erg-faq__item { counter-increment: registration-faq; overflow: hidden; border-bottom: 1px solid var(--ds-line); }
  .erg-faq__item:last-child { border-bottom: 0; }
  .erg-faq__question { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; font-family: var(--ds-font-body); font-size: 17px; font-weight: 500; color: var(--ds-ink); cursor: pointer; list-style: none; }
