  }
  .erg-cta-phone__list {
    display: grid;
    gap: 8px;
  }
  .erg-cta-phone__list div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border: 1px solid rgba(232, 236, 242, 0.9);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.86);
  }
  .erg-cta-phone__list b {
    font: 800 0.88rem/1.2 var(--font-heading);
  }
  .erg-cta-phone__list span {
    color: var(--subheading-gray);
    font: 600 0.76rem/1.2 var(--font-body);
  }
  @media (max-width: 767px) {
    .erg-cta {
      padding: 40px 16px 58px;
    }
    .erg-cta__card {
      min-height: 690px;
