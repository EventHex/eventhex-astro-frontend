    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .erg-faq__icon::before, .erg-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: #000;
    transform: translate(-50%, -50%);
  }
  .erg-faq__icon::before {
    width: 14px;
    height: 2px;
  }
  .erg-faq__icon::after {
    width: 2px;
    height: 14px;
    transition: opacity 0.2s ease;
  }
  .erg-faq__item[open] .erg-faq__icon {
    transform: scale(0.9);
  }
  .erg-faq__item[open] .erg-faq__icon::after {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .erg-faq__item, .erg-faq__icon, .erg-faq__icon::after {
      transition: none;
    }
  }
  .erg-faq__answer {
    max-width: 640px;
    padding: 0 0 24px;
  }
  .erg-faq__answer p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #000;
    margin: 0;
  }
  @media (max-width: 1024px) {
    .erg-faq__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .erg-faq__sidebar {
      position: static;
    }
    .erg-faq__heading {
      font-size: 32px;
    }
  }
  @media (max-width: 767px) {
    .erg-faq {
      padding: 56px 16px;
    }
    .erg-faq__heading {
      font-size: 28px;
    }
    .erg-faq__item {
      padding: 4px 20px;
      border-radius: 16px;
    }
    .erg-faq__question {
      font-size: 0.9375rem;
      padding: 18px 0;
    }
  }
</style>

<script>
  function initErgEcosystemArc() {
    const grid = document.querySelector<HTMLElement>(".erg-eco__grid");
    if (!grid || grid.dataset.arcReady === "true") return;
    grid.dataset.arcReady = "true";
    const cards = Array.from(
      grid.querySelectorAll<HTMLAnchorElement>(".erg-eco__card"),
    );
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduced) {
      grid.classList.add("is-revealed");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            grid.classList.add("is-revealed");
            observer.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(grid);
    }

    function closeAll(except?: HTMLAnchorElement) {
      cards.forEach((card) => {
        if (card !== except) {
          card.classList.remove("is-active");
          card.setAttribute("aria-expanded", "false");
        }
      });
    }

    cards.forEach((card) => {
      card.setAttribute("aria-expanded", "false");
      card.addEventListener("click", (event) => {
        if (!card.classList.contains("is-active")) {
          event.preventDefault();
          closeAll(card);
          card.classList.add("is-active");
          card.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest?.(".erg-eco__card")) closeAll();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAll();
    });
  }

  function initScrollytelling() {
    const scrollyBlocks = document.querySelectorAll(".erg-scrolly-block");
    const scrollyVisuals = document.querySelectorAll(".erg-scrolly-img");

    if (scrollyBlocks.length && scrollyVisuals.length) {
      const scrollyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              console.log("Scrolly intersecting:", entry.target.id);
              scrollyBlocks.forEach((b) => b.classList.remove("is-active"));
              entry.target.classList.add("is-active");

              const targetId = entry.target.id;
              scrollyVisuals.forEach((v) => {
                if (v.getAttribute("data-target") === targetId) {
                  v.classList.add("is-active");
                } else {
                  v.classList.remove("is-active");
                }
              });
            }
          });
        },
        {
          rootMargin: "-30% 0px -30% 0px",
          threshold: 0,
        },
      );

      scrollyBlocks.forEach((block) => scrollyObserver.observe(block));
    }
  }

  function initErgBandBleed() {
    const band = document.querySelector<HTMLElement>(".erg-dark-band");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    // cache the band's document offset so the scroll handler never reads
    // layout (getBoundingClientRect mid-scroll forces a synchronous reflow)
    let bandTop = 0;
    let vh = window.innerHeight || 1;
    const measure = () => {
      vh = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let last = -1;
    const update = () => {
      ticking = false;
      // 0 while the band's top sits at the viewport bottom, 1 once it has
      // travelled 70% of a viewport upward
      const travelled = vh - (bandTop - window.scrollY);
      const p = Math.min(1, Math.max(0, travelled / (vh * 0.7)));
      const rounded = Math.round(p * 100) / 100;
      if (rounded === last) return;
      last = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      last = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initErgEcosystemArc();
      initScrollytelling();
      initErgBandBleed();
    });
  } else {
    initErgEcosystemArc();
    initScrollytelling();
    initErgBandBleed();
  }
</script>
