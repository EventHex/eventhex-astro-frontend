  /* ===== CTA CARD ===== */
  .erg-cta__visual[hidden],
  .erg-eco[hidden] {
    display: none !important;
  }
  .erg-cta {
    position: relative;
    max-width: none;
    margin: 0;
    padding: clamp(56px, 7vw, 90px) 24px;
    overflow: hidden;
    background: #fff;
  }
  .erg-cta__card {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    min-height: 620px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
    grid-template-rows: 1fr auto;
    border: 1px solid rgba(55, 93, 251, 0.1);
    border-radius: 36px;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 82% 38%,
        rgba(79, 214, 224, 0.17),
        transparent 26%
      ),
      radial-gradient(
        circle at 70% 32%,
        rgba(55, 93, 251, 0.14),
        transparent 40%
      ),
      linear-gradient(135deg, #fbfcff 0%, #f4f7ff 54%, #eef6ff 100%);
  }
  .erg-cta__card::before,
  .erg-cta__card::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
    z-index: -1;
  }
  .erg-cta__card::before {
    top: -250px;
    left: -120px;
    background: radial-gradient(
      circle,
      rgba(55, 93, 251, 0.13),
      transparent 70%
    );
  }
  .erg-cta__card::after {
    right: -150px;
    bottom: -250px;
    background: radial-gradient(
      circle,
      rgba(79, 214, 224, 0.18),
      transparent 70%
    );
  }
  .erg-cta-flow {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0 36px 30px;
    overflow: hidden;
    border: 1px solid rgba(55, 93, 251, 0.1);
    border-radius: 18px;
    background: rgba(55, 93, 251, 0.1);
    pointer-events: none;
  }
  .erg-cta-flow__lines {
    display: none;
  }
  .erg-cta-flow__lines path {
    fill: none;
    stroke: rgba(55, 93, 251, 0.17);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .erg-cta-flow__node {
    position: static;
    width: auto;
    display: grid;
    grid-template-columns: 34px 1fr;
    column-gap: 10px;
    padding: 15px 14px;
    border: 0;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: none;
    backdrop-filter: blur(12px);
  }
  .erg-cta-flow__node span {
    grid-row: 1 / 3;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(55, 93, 251, 0.1);
    color: var(--brand-blue);
    font: 800 0.68rem/1 var(--font-body);
  }
  .erg-cta-flow__node strong {
    color: var(--heading-dark);
    font: 700 0.78rem/1.2 var(--font-heading);
  }
  .erg-cta-flow__node small {
    margin-top: 3px;
    color: var(--subheading-gray);
    font: 500 0.66rem/1.25 var(--font-body);
  }
  .erg-cta__top {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 18px;
    padding: clamp(58px, 6vw, 86px) 28px 48px clamp(40px, 5vw, 72px);
    text-align: left;
  }
  .erg-cta__content {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .erg-cta__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 0 0 20px;
    padding: 7px 12px;
    border: 1px solid rgba(55, 93, 251, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: none;
    color: var(--brand-blue);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .erg-cta__brand-icon {
    display: inline-block;
    width: auto;
    height: auto;
    border-radius: 0;
    background: transparent;
    color: var(--brand-blue);
    font-size: 0.72rem;
    line-height: 1;
  }
  .erg-cta__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.6vw, 3.35rem);
    font-weight: 700;
    color: var(--heading-dark);
    margin: 0;
    line-height: var(--erg-section-title-line);
    letter-spacing: var(--erg-section-title-tracking);
    max-width: 590px;
  }
  .erg-cta__desc {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.65;
    color: var(--subheading-gray);
    margin: 20px 0 0;
    max-width: 470px;
  }
  .erg-cta__btn {
    position: relative;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 15px 30px;
    border-radius: 13px;
    text-decoration: none;
    border: 0;
    background: linear-gradient(90deg, var(--brand-blue), #4fd6e0);
    color: #fff;
    white-space: nowrap;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
    box-shadow: 0 18px 38px rgba(55, 93, 251, 0.22);
  }
  .erg-cta__btn svg,
  .erg-cta__btn path {
    color: #fff;
    stroke: #fff;
  }
  .erg-cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 46px rgba(55, 93, 251, 0.28);
  }
  .erg-cta__visual {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 520px;
    margin: 28px 28px 0 0;
    overflow: hidden;
    isolation: isolate;
    width: auto;
  }
  .erg-cta__visual::before {
    content: "";
    position: absolute;
    inset: 14% 10% 0;
    z-index: -1;
    border-radius: 999px;
    background:
      radial-gradient(
        circle at 50% 15%,
        rgba(55, 93, 251, 0.18),
        transparent 45%
      ),
      radial-gradient(
        circle at 58% 44%,
        rgba(79, 214, 224, 0.14),
        transparent 52%
      );
    filter: blur(28px);
  }
  .erg-cta__visual::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 22%;
    z-index: 2;
    background: linear-gradient(180deg, rgba(245, 249, 255, 0), #f5f9ff 88%);
    pointer-events: none;
  }
  .erg-cta-phone {
    position: absolute;
    top: 22px;
    left: 50%;
    width: min(100%, 350px);
    align-self: flex-start;
    transform: translate(-50%, 4px);
  }
  .erg-cta-phone::before,
  .erg-cta-phone::after {
    display: none;
  }
  .erg-cta-phone::before {
    content: "LIVE";
    right: 60%;
  }
  .erg-cta-phone::after {
    content: "REGISTRATION";
    left: 60%;
  }
  .erg-cta-phone__bezel {
    position: relative;
    padding: 10px;
    border-radius: 46px 46px 34px 34px;
    background: linear-gradient(135deg, #050816, #20242f);
    box-shadow: 0 24px 70px rgba(15, 22, 41, 0.18);
  }
  .erg-cta-phone__screen {
    position: relative;
    min-height: clamp(330px, 32vw, 390px);
    overflow: hidden;
    border-radius: 36px 36px 26px 26px;
    padding: 20px 16px 18px;
    background:
      radial-gradient(
        circle at 72% 18%,
        rgba(79, 214, 224, 0.16),
        transparent 34%
      ),
      linear-gradient(180deg, #eef3ff 0%, #ffffff 72%);
    color: var(--heading-dark);
  }
  .erg-cta-phone__notch {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 104px;
    height: 28px;
    border-radius: 999px;
    background: #05060c;
    transform: translateX(-50%);
  }
  .erg-cta-phone__status {
    display: flex;
    justify-content: space-between;
    margin-bottom: 26px;
    padding: 0 8px;
    font: 800 0.78rem/1 var(--font-body);
    color: #111827;
  }
  .erg-cta-phone__signal {
    letter-spacing: 1px;
    font-size: 0.62rem;
  }
  .erg-cta-phone__intro {
    display: flex;
    color: #9aa1ae;
    font: 500 0.9rem/1.2 var(--font-body);
  }
  .erg-cta-phone__intro strong {
    font: 800 1.28rem/1.15 var(--font-heading);
    letter-spacing: -0.03em;
  }
  .erg-cta-phone__tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .erg-cta-phone__tabs span,
  .erg-cta-phone__tabs b {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 9px;
    background: #fff;
    color: var(--heading-dark);
    font: 700 0.78rem/1 var(--font-body);
  }
  .erg-cta-phone__tabs span:first-child {
    background: var(--brand-blue);
    color: #fff;
  }
  .erg-cta-phone__tabs b {
    margin-left: auto;
    background: transparent;
    color: var(--brand-blue);
    padding: 0;
  }
  .erg-cta-phone__card {
    min-height: clamp(118px, 12vw, 138px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-bottom: 16px;
    padding: 20px;
    border-radius: 22px;
    background:
      radial-gradient(
        circle at 76% 16%,
        rgba(255, 255, 255, 0.8),
        transparent 18%
      ),
