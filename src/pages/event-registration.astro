    <script>
      const registrationFaqItems = Array.from(
        document.querySelectorAll<HTMLDetailsElement>('.erg-faq__item'),
      );
      const registrationFaqAnimations = new WeakMap<HTMLDetailsElement, Animation[]>();
      const registrationFaqReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const animateRegistrationFaq = (item: HTMLDetailsElement, shouldOpen: boolean) => {
        const summary = item.querySelector<HTMLElement>('.erg-faq__question');
        const answer = item.querySelector<HTMLElement>('.erg-faq__answer');
        if (!summary || !answer) return;

        const startHeight = item.getBoundingClientRect().height;
        registrationFaqAnimations.get(item)?.forEach((animation) => animation.cancel());

        if (shouldOpen) item.open = true;
        const styles = window.getComputedStyle(item);
        const closedHeight = summary.getBoundingClientRect().height
          + parseFloat(styles.paddingTop)
          + parseFloat(styles.paddingBottom)
          + parseFloat(styles.borderTopWidth)
          + parseFloat(styles.borderBottomWidth);
        const endHeight = shouldOpen ? item.getBoundingClientRect().height : closedHeight;

        item.dataset.faqExpanded = String(shouldOpen);

        if (registrationFaqReducedMotion.matches) {
          item.open = shouldOpen;
          return;
        }

        const itemAnimation = item.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        const answerAnimation = answer.animate(
          shouldOpen
            ? { opacity: [0, 1], transform: ['translateY(-6px)', 'translateY(0)'] }
            : { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-6px)'] },
          { duration: shouldOpen ? 240 : 180, easing: 'ease-out', fill: 'both' },
        );

        registrationFaqAnimations.set(item, [itemAnimation, answerAnimation]);
        itemAnimation.addEventListener('finish', () => {
          item.open = shouldOpen;
          answerAnimation.cancel();
          registrationFaqAnimations.delete(item);
        }, { once: true });
      };

      registrationFaqItems.forEach((item) => {
        item.dataset.faqExpanded = String(item.open);
        item.querySelector('.erg-faq__question')?.addEventListener('click', (event) => {
          event.preventDefault();
          const shouldOpen = item.dataset.faqExpanded !== 'true';

          if (shouldOpen) {
            registrationFaqItems.forEach((other) => {
              if (other !== item && other.dataset.faqExpanded === 'true') {
                animateRegistrationFaq(other, false);
              }
            });
          }

          animateRegistrationFaq(item, shouldOpen);
        });
      });
    </script>
