    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff746c;
  }
  .erg-mini-window__bar i:nth-child(2) {
    background: #ffc759;
  }
  .erg-mini-window__bar i:nth-child(3) {
    background: #4dcb72;
  }
  .erg-mini-window__bar span {
    margin-left: 8px;
    color: #667085;
    font-size: 0.78rem;
  }
  .erg-ticket-row {
    display: flex;
