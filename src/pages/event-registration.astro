    <script>
      const registrationFaqItems = Array.from(
        document.querySelectorAll<HTMLDetailsElement>('.erg-faq__item'),
      );
      const registrationFaqAnimations = new WeakMap<HTMLDetailsElement, Animation[]>();
      const registrationFaqReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const animateRegistrationFaq = (item: HTMLDetailsElement, shouldOpen: boolean) => {
        const summary = item.querySelector<HTMLElement>('.erg-faq__question');
        const answer = item.querySelector<HTMLElement>('.erg-faq__answer');
        if (!summary || !answer) return;

        const startHeight = item.getBoundingClientRect().height;
        registrationFaqAnimations.get(item)?.forEach((animation) => animation.cancel());

        if (shouldOpen) item.open = true;
        const styles = window.getComputedStyle(item);
        const closedHeight = summary.getBoundingClientRect().height
          + parseFloat(styles.paddingTop)
          + parseFloat(styles.paddingBottom)
          + parseFloat(styles.borderTopWidth)
          + parseFloat(styles.borderBottomWidth);
        const endHeight = shouldOpen ? item.getBoundingClientRect().height : closedHeight;

        item.dataset.faqExpanded = String(shouldOpen);

        if (registrationFaqReducedMotion.matches) {
          item.open = shouldOpen;
          return;
        }

        const itemAnimation = item.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        const answerAnimation = answer.animate(
          shouldOpen
            ? { opacity: [0, 1], transform: ['translateY(-6px)', 'translateY(0)'] }
            : { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-6px)'] },
          { duration: shouldOpen ? 240 : 180, easing: 'ease-out', fill: 'both' },
        );

        registrationFaqAnimations.set(item, [itemAnimation, answerAnimation]);
        itemAnimation.addEventListener('finish', () => {
          item.open = shouldOpen;
          answerAnimation.cancel();
          registrationFaqAnimations.delete(item);
        }, { once: true });
      };

      registrationFaqItems.forEach((item) => {
        item.dataset.faqExpanded = String(item.open);
        item.querySelector('.erg-faq__question')?.addEventListener('click', (event) => {
          event.preventDefault();
          const shouldOpen = item.dataset.faqExpanded !== 'true';

          if (shouldOpen) {
            registrationFaqItems.forEach((other) => {
              if (other !== item && other.dataset.faqExpanded === 'true') {
                animateRegistrationFaq(other, false);
              }
            });
          }

          animateRegistrationFaq(item, shouldOpen);
        });
      });
    </script>
  </div>
</MarketingLayout>

<script>
  function initErgEcosystemArc() {
    const grid = document.querySelector<HTMLElement>(".erg-eco__grid");
    if (!grid || grid.dataset.arcReady === "true") return;
    grid.dataset.arcReady = "true";
    const cards = Array.from(
      grid.querySelectorAll<HTMLAnchorElement>(".erg-eco__card"),
    );
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduced) {
      grid.classList.add("is-revealed");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            grid.classList.add("is-revealed");
            observer.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(grid);
    }

    function closeAll(except?: HTMLAnchorElement) {
      cards.forEach((card) => {
        if (card !== except) {
          card.classList.remove("is-active");
          card.setAttribute("aria-expanded", "false");
        }
      });
    }

    cards.forEach((card) => {
      card.setAttribute("aria-expanded", "false");
      card.addEventListener("click", (event) => {
        if (!card.classList.contains("is-active")) {
          event.preventDefault();
          closeAll(card);
          card.classList.add("is-active");
          card.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest?.(".erg-eco__card")) closeAll();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAll();
    });
  }

  function initScrollytelling() {
    const scrollyBlocks = document.querySelectorAll(".erg-scrolly-block");
    const scrollyVisuals = document.querySelectorAll(".erg-scrolly-img");

    if (scrollyBlocks.length && scrollyVisuals.length) {
      const scrollyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              console.log("Scrolly intersecting:", entry.target.id);
              scrollyBlocks.forEach((b) => b.classList.remove("is-active"));
              entry.target.classList.add("is-active");

              const targetId = entry.target.id;
              scrollyVisuals.forEach((v) => {
                if (v.getAttribute("data-target") === targetId) {
                  v.classList.add("is-active");
                } else {
                  v.classList.remove("is-active");
                }
              });
            }
          });
        },
        {
          rootMargin: "-30% 0px -30% 0px",
          threshold: 0,
        },
      );

      scrollyBlocks.forEach((block) => scrollyObserver.observe(block));
    }
  }

  function initErgBandBleed() {
    const band = document.querySelector<HTMLElement>(".erg-dark-band");
    if (!band || band.dataset.bleedReady === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    band.dataset.bleedReady = "true";

    // cache the band's document offset so the scroll handler never reads
    // layout (getBoundingClientRect mid-scroll forces a synchronous reflow)
    let bandTop = 0;
    let vh = window.innerHeight || 1;
    const measure = () => {
      vh = window.innerHeight || 1;
      bandTop = band.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let last = -1;
    const update = () => {
      ticking = false;
      // 0 while the band's top sits at the viewport bottom, 1 once it has
      // travelled 70% of a viewport upward
      const travelled = vh - (bandTop - window.scrollY);
      const p = Math.min(1, Math.max(0, travelled / (vh * 0.7)));
      const rounded = Math.round(p * 100) / 100;
      if (rounded === last) return;
      last = rounded;
      band.style.setProperty("--band-p", String(rounded));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const onResize = () => {
      measure();
      last = -1;
      onScroll();
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initErgEcosystemArc();
      initScrollytelling();
      initErgBandBleed();
    });
  } else {
    initErgEcosystemArc();
    initScrollytelling();
    initErgBandBleed();
  }
</script>
