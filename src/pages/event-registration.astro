<script>
  function initErgEcosystemArc() {
    const grid = document.querySelector<HTMLElement>(".erg-eco__grid");
    if (!grid || grid.dataset.arcReady === "true") return;
    grid.dataset.arcReady = "true";
    const cards = Array.from(
      grid.querySelectorAll<HTMLAnchorElement>(".erg-eco__card"),
    );
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduced) {
      grid.classList.add("is-revealed");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            grid.classList.add("is-revealed");
            observer.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(grid);
    }

    function closeAll(except?: HTMLAnchorElement) {
      cards.forEach((card) => {
        if (card !== except) {
          card.classList.remove("is-active");
          card.setAttribute("aria-expanded", "false");
        }
      });
    }

    cards.forEach((card) => {
      card.setAttribute("aria-expanded", "false");
      card.addEventListener("click", (event) => {
        if (!card.classList.contains("is-active")) {
          event.preventDefault();
          closeAll(card);
          card.classList.add("is-active");
          card.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest?.(".erg-eco__card")) closeAll();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAll();
    });
  }

  function initScrollytelling() {
    const scrollyBlocks = document.querySelectorAll(".erg-scrolly-block");
    const scrollyVisuals = document.querySelectorAll(".erg-scrolly-img");

    if (scrollyBlocks.length && scrollyVisuals.length) {
      const scrollyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              console.log("Scrolly intersecting:", entry.target.id);
              scrollyBlocks.forEach((b) => b.classList.remove("is-active"));
              entry.target.classList.add("is-active");

              const targetId = entry.target.id;
              scrollyVisuals.forEach((v) => {
                if (v.getAttribute("data-target") === targetId) {
                  v.classList.add("is-active");
                } else {
                  v.classList.remove("is-active");
                }
              });
            }
          });
        },
        {
          rootMargin: "-30% 0px -30% 0px",
          threshold: 0,
        },
      );

      scrollyBlocks.forEach((block) => scrollyObserver.observe(block));
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initErgEcosystemArc();
      initScrollytelling();
    });
  } else {
    initErgEcosystemArc();
    initScrollytelling();
  }
</script>
