  /* ===== CTA CARD ===== */
  .erg-cta__visual[hidden],
  .erg-eco[hidden] {
    display: none !important;
  }
  .erg-cta {
    position: relative;
    max-width: none;
    margin: 0;
    padding: clamp(56px, 7vw, 90px) 24px;
    overflow: hidden;
    background: #fff;
  }
  .erg-cta__card {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    min-height: 620px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
    grid-template-rows: 1fr auto;
    border: 1px solid rgba(55, 93, 251, 0.1);
    border-radius: 36px;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 82% 38%,
        rgba(79, 214, 224, 0.17),
        transparent 26%
      ),
      radial-gradient(
        circle at 70% 32%,
        rgba(55, 93, 251, 0.14),
        transparent 40%
      ),
      linear-gradient(135deg, #fbfcff 0%, #f4f7ff 54%, #eef6ff 100%);
  }
  .erg-cta__card::before,
  .erg-cta__card::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
    z-index: -1;
  }
  .erg-cta__card::before {
    top: -250px;
    left: -120px;
    background: radial-gradient(
      circle,
      rgba(55, 93, 251, 0.13),
      transparent 70%
    );
  }
  .erg-cta__card::after {
    right: -150px;
    bottom: -250px;
    background: radial-gradient(
      circle,
      rgba(79, 214, 224, 0.18),
      transparent 70%
    );
  }
  .erg-cta-flow {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0 36px 30px;
    overflow: hidden;
    border: 1px solid rgba(55, 93, 251, 0.1);
    border-radius: 18px;
    background: rgba(55, 93, 251, 0.1);
    pointer-events: none;
  }
  .erg-cta-flow__lines {
    display: none;
  }
  .erg-cta-flow__lines path {
    fill: none;
    stroke: rgba(55, 93, 251, 0.17);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .erg-cta-flow__node {
    position: static;
    width: auto;
    display: grid;
    grid-template-columns: 34px 1fr;
    column-gap: 10px;
    padding: 15px 14px;
    border: 0;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.82);
