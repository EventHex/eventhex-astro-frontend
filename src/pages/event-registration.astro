    <script>
      const registrationFaqItems = Array.from(document.querySelectorAll('.erg-faq__item'));
      registrationFaqItems.forEach((item) => {
        const summary = item.querySelector('summary');
        summary?.addEventListener('click', (event) => {
          if (!(item instanceof HTMLDetailsElement)) return;
          event.preventDefault();
          const shouldOpen = !item.open;
          registrationFaqItems.forEach((other) => {
            if (other instanceof HTMLDetailsElement) other.open = false;
          });
          item.open = shouldOpen;
        });
      });
    </script>
