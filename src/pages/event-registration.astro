  }
  .erg-heading__eyebrow::before {
    content: "✦";
    position: absolute;
    left: 13px;
    top: 50%;
    color: #4f8cff;
    font-size: 14px;
    transform: translateY(-50%);
    transform-origin: center;
    animation: erg-brand-star 2s ease-in-out infinite;
  }
  .erg-heading__eyebrow::after {
    content: "";
    position: absolute;
    inset: -1.5px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--erg-brand-angle),
      transparent 0deg,
      transparent 270deg,
      #4f8cff 315deg,
      #b08bff 340deg,
      #4f8cff 355deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: erg-brand-spin 3s linear infinite;
