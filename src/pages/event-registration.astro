    }
  }

  /* ===== FINAL CTA ===== */
  .erg-cta {
    position: relative;
    max-width: none;
    margin: 0;
    padding: clamp(56px, 7vw, 90px) 24px;
    background: #fff;
  }
  .erg-cta__card {
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 32px;
    background: linear-gradient(135deg, #090614 0%, #170d2b 50%, #4a215c 100%);
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
  }
  .erg-cta__left {
    flex: 1;
    padding: 80px 60px;
    position: relative;
    z-index: 2;
  }
  .erg-cta__brand {
    display: flex;
    align-items: center;
    margin-bottom: 32px;
  }
  .erg-cta__title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: clamp(32px, 4vw, 48px);
