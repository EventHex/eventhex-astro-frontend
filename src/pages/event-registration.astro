    border: 1px solid #cfead9;
    background: #effbf4;
    color: #18864b;
  }
  .erg-flow-composite__status svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .erg-flow-composite__action {
    right: 14px;
    bottom: 14px;
    padding: 10px 13px;
    background: #4b65f6;
    color: #fff;
  }
  .erg-flow-composite__cursor {
    position: absolute;
    right: 4px;
    bottom: 34px;
    z-index: 6;
    width: 22px;
    height: 26px;
    filter: drop-shadow(0 3px 3px rgba(17, 24, 39, 0.25));
    pointer-events: none;
  }
  .erg-flow-column__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .erg-flow-column__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--subheading-gray, #555);
    line-height: 1.5;
  }
  .erg-flow-icon {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .erg-flow-icon--cross path {
    stroke: #e63946;
  }
  .erg-flow-icon--check path {
    stroke: #079455;
  }
  @media (min-width: 769px) {
    .erg-flow-title {
      white-space: nowrap;
    }
  }
  @media (max-width: 768px) {
    .erg-flow-quad {
      grid-template-columns: 1fr;
    }
    .erg-flow-quad__cross {
      display: none;
    }
    .erg-flow-quad__cell {
      min-height: 0;
      padding: 32px 20px;
      border-right: none;
      border-bottom: 1px solid #eef0f3;
    }
    .erg-flow-quad__cell:nth-child(3) {
      order: 4;
      border-bottom: none;
    }
    .erg-flow-quad__cell:nth-child(4) {
      order: 3;
      border-bottom: 1px solid #eef0f3;
    }
    .erg-flow-quad__cell--media {
      padding: 16px 20px 32px;
    }
    .erg-flow-composite {
      height: 285px;
    }
    .erg-flow-composite__screen--primary {
      width: 78%;
    }
    .erg-flow-composite__screen--secondary {
      width: 68%;
    }
    .erg-flow-section {
      padding: 60px 16px;
    }
