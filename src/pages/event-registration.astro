  }
  .erg-content-copy h2,
  .erg-content-heading h2 {
    margin: 14px 0 20px;
    color: var(--heading-dark);
    font: 700 clamp(2.25rem, 4vw, 3.75rem)/1.05 var(--font-heading);
    letter-spacing: -0.045em;
  }
  .erg-content-copy p,
  .erg-content-heading p {
    max-width: 720px;
    margin: 0 0 14px;
    color: var(--subheading-gray);
    font: 400 1.04rem/1.7 var(--font-body);
  }
  .erg-content-copy a,
  .erg-dark-card a,
  .erg-use-card a {
    color: var(--brand-blue);
    text-decoration: none;
  }
  .erg-content-heading {
    max-width: 820px;
    margin: 0 auto 42px;
    text-align: center;
  }
  .erg-content-heading p {
    margin-inline: auto;
  }
  .erg-content-section--center .erg-content-heading {
    margin-bottom: 0;
  }
  .erg-content-section--dark .erg-content-heading h2,
  .erg-content-section--dark .erg-content-heading p {
    color: #fff;
  }
  .erg-content-section--dark .erg-heading__eyebrow {
    color: #8eabff;
  }
  .erg-mini-window,
  .erg-embed-window {
    overflow: hidden;
    border: 1px solid #e3e8f2;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 28px 80px rgba(28, 49, 92, 0.12);
  }
  .erg-mini-window__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 18px;
    border-bottom: 1px solid #e8ecf2;
    background: #f9fbff;
  }
  .erg-mini-window__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff746c;
  }
  .erg-mini-window__bar i:nth-child(2) {
    background: #ffc759;
  }
  .erg-mini-window__bar i:nth-child(3) {
    background: #4dcb72;
  }
  .erg-mini-window__bar span {
    margin-left: 8px;
    color: #667085;
    font-size: 0.78rem;
  }
  .erg-ticket-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 21px 24px;
    border-bottom: 1px solid #edf0f5;
  }
  .erg-ticket-row:last-child {
    border: 0;
  }
  .erg-ticket-row span {
    display: grid;
    gap: 4px;
  }
  .erg-ticket-row b {
    color: var(--heading-dark);
  }
  .erg-ticket-row small {
    color: var(--label-gray);
  }
  .erg-ticket-row strong {
    color: var(--heading-dark);
  }
  .erg-ticket-row .is-free {
    color: #0e9f6e;
  }
  .erg-choice-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .erg-choice-card,
  .erg-use-card {
    padding: 32px;
    border: 1px solid #e5eaf3;
    border-radius: 24px;
    background: #f8faff;
  }
  .erg-choice-card > span {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 34px;
    border-radius: 10px;
    color: var(--brand-blue);
    background: #e9eeff;
    font-weight: 800;
  }
  .erg-choice-card h3,
  .erg-dark-card h3,
  .erg-use-card h3 {
    margin: 0 0 10px;
    color: var(--heading-dark);
    font: 700 1.25rem/1.25 var(--font-heading);
  }
  .erg-choice-card p,
  .erg-dark-card p,
  .erg-use-card p {
    margin: 0;
    color: var(--subheading-gray);
    line-height: 1.65;
  }
  .erg-content-note {
    margin: 24px auto 0;
    color: #667085;
    text-align: center;
    font-weight: 500;
  }
  .erg-feature-four {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .erg-dark-card {
    padding: 30px 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.06);
  }
  .erg-dark-card > b {
    display: block;
    margin-bottom: 34px;
    color: #8eabff;
    font-size: 0.75rem;
  }
  .erg-dark-card h3,
  .erg-dark-card p {
    color: #fff;
  }
  .erg-dark-card p {
    opacity: 0.72;
  }
  .erg-message-card {
    max-width: 430px;
    padding: 22px;
    border-radius: 28px;
    background: #e8f4e5;
    box-shadow: 0 28px 80px rgba(30, 91, 51, 0.12);
  }
  .erg-message-card > small {
    display: block;
    margin-bottom: 14px;
    color: #39774d;
    font-weight: 700;
  }
  .erg-message-card > div {
    display: grid;
    gap: 5px;
    padding: 20px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 4px 18px rgba(22, 55, 35, 0.08);
  }
  .erg-message-card b {
    color: var(--heading-dark);
    font-family: var(--font-heading);
  }
  .erg-message-card span {
    color: #475467;
  }
  .erg-message-card em {
    color: #8a94a6;
    font-style: normal;
    font-size: 0.82rem;
  }
  .erg-embed-window {
    padding-bottom: 22px;
  }
  .erg-embed-window__body {
    margin: 24px;
    padding: 22px;
    border: 2px dashed rgba(55, 93, 251, 0.55);
    border-radius: 16px;
    background: #fff;
  }
  .erg-embed-window__body small {
    display: block;
    margin-bottom: 18px;
    color: var(--brand-blue);
    font-weight: 800;
  }
  .erg-embed-window__body label {
    display: block;
    margin: 12px 0 6px;
    color: #475467;
    font-size: 0.78rem;
  }
  .erg-embed-window__body div {
    height: 38px;
    border: 1px solid #dfe4ec;
    border-radius: 8px;
  }
  .erg-embed-window__body button {
    width: 100%;
    margin-top: 16px;
    padding: 11px;
    border: 0;
    border-radius: 9px;
    color: #fff;
    background: var(--brand-blue);
    font-weight: 700;
  }
  .erg-use-cases {
    padding: clamp(40px, 4.5vw, 60px) 24px clamp(82px, 9vw, 116px);
    background: transparent !important;
  }
  .erg-use-cases .erg-content-shell {
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    box-shadow: none;
  }
  .erg-use-cases .erg-content-heading {
    max-width: none;
    margin: 0;
    padding: 0 24px clamp(20px, 2.4vw, 32px);
  }
  .erg-use-cases .erg-content-heading h2 {
    max-width: 680px;
    margin: 0 auto;
    font-size: clamp(2.45rem, 4.6vw, 4rem);
  }
  .erg-use-cases .erg-content-heading h2.erg-use-heading {
    max-width: none;
    font-weight: 500;
  }
  @media (min-width: 769px) {
    .erg-use-heading {
      white-space: nowrap;
    }
  }
  .erg-use-gradient-text {
    background: linear-gradient(90deg, #555 0%, #aaa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  /* same treatment as the home page "Why event teams switch" grid */
  .erg-use-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--surface-card-border);
    border-bottom: 0;
  }
  .erg-use-card {
    position: relative;
    min-height: 300px;
    padding: 28px;
    border: 0;
    border-left: 1px solid var(--surface-card-border);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .erg-use-card:first-of-type {
    border-left: none;
  }
  .erg-use-notch {
    position: absolute;
    top: 0;
    width: 28px;
    height: 28px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    line-height: 0;
    z-index: 2;
  }
  .erg-use-notch--1 {
    left: 25%;
  }
  .erg-use-notch--2 {
    left: 50%;
  }
  .erg-use-notch--3 {
    left: 75%;
  }
  .erg-use-cross {
    display: none;
  }
  .erg-use-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-bottom: 28px;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--brand-blue);
  }
  .erg-use-card__icon svg {
    width: 100%;
    height: 100%;
  }
  .erg-use-card h3 {
    max-width: 230px;
    margin: 0 0 28px;
    font-family: var(--font-heading);
    font-size: 21px;
    /* Creato has no 600 face, so 600 was rendering as Bold 700 */
    font-weight: 500;
    line-height: 1.15;
    /* hold two lines whether the title needs them or not, so the copy
       below every card starts on the same baseline */
    min-height: 2.3em;
    color: var(--heading-dark);
  }
  .erg-use-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .erg-use-card p {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--body-gray);
  }
  @media (max-width: 900px) {
    .erg-content-split,
    .erg-content-split--reverse {
      grid-template-columns: 1fr;
    }
    .erg-feature-four {
      grid-template-columns: repeat(2, 1fr);
    }
    .erg-content-split--reverse .erg-content-copy {
      order: -1;
    }
    .erg-access-grid {
      grid-template-columns: 1fr;
    }
    .erg-access-card {
      grid-template-columns: 1fr;
    }
    .erg-access-card:nth-child(even) .erg-access-card__visual,
    .erg-access-card:nth-child(even) .erg-access-card__copy {
      order: initial;
    }
    .erg-use-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .erg-use-notch--1,
    .erg-use-notch--3 {
      display: none;
    }
    .erg-use-card:nth-of-type(odd) {
      border-left: none;
    }
    .erg-use-card:nth-of-type(n + 3) {
      border-top: 1px solid var(--surface-card-border);
    }
    .erg-use-cross {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 28px;
      height: 28px;
      transform: translate(50%, -50%);
      pointer-events: none;
      line-height: 0;
      z-index: 2;
    }
    .erg-payment-table {
      overflow-x: auto;
    }
    .erg-payment-table__plans,
    .erg-payment-table__row,
    .erg-payment-table__group {
      min-width: 760px;
    }
  }
  @media (max-width: 600px) {
    .erg-content-section {
      padding: 62px 16px;
    }
    .erg-choice-grid,
    .erg-feature-four {
      grid-template-columns: 1fr;
    }
    .erg-choice-card,
    .erg-dark-card,
    .erg-use-card {
      padding: 24px 20px;
    }
    .erg-access-card__visual {
      height: 300px;
      padding: 26px 24px 0;
    }
    .erg-access-card__copy {
      min-height: 0;
      padding: 38px 28px 44px;
    }
    .erg-use-cases {
      padding-inline: 16px;
    }
    .erg-use-grid {
      grid-template-columns: 1fr;
    }
    .erg-use-card h3 {
      min-height: 0;
    }
    .erg-use-card {
      min-height: 0;
      border-left: none;
      border-top: 1px solid var(--surface-card-border);
    }
    .erg-use-card:first-of-type {
      border-top: none;
    }
    .erg-use-cross,
    .erg-use-notch--2 {
      display: none;
    }
  }

  /* ===== ECOSYSTEM ===== */
  .erg-platform {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 9vw, 112px) 24px clamp(76px, 10vw, 120px);
    background: #fff;
  }
  .erg-platform::before,
  .erg-platform::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0.72;
  }
  .erg-platform::before {
    width: 420px;
    height: 420px;
    left: -180px;
    top: 22%;
    background: radial-gradient(
      circle,
      rgba(55, 93, 251, 0.1),
      rgba(55, 93, 251, 0)
    );
  }
  .erg-platform::after {
    width: 460px;
    height: 460px;
    right: -190px;
    bottom: -120px;
    background: radial-gradient(
      circle,
      rgba(79, 214, 224, 0.12),
      rgba(79, 214, 224, 0)
    );
  }
  .erg-platform__heading {
    position: relative;
    z-index: 1;
    max-width: 760px;
    padding-bottom: 0;
  }
  .erg-platform__heading .erg-heading__eyebrow {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    line-height: 1;
  }
  .erg-platform__heading .erg-heading__title {
    font-size: var(--erg-section-title-size);
    line-height: var(--erg-section-title-line);
    letter-spacing: var(--erg-section-title-tracking);
    font-weight: 700;
    margin-bottom: 1.15rem;
  }
  .erg-platform__heading .erg-heading__subtitle {
    max-width: 720px;
    margin: 0 auto;
  }
  .erg-eco {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding-top: clamp(38px, 5vw, 58px);
  }
  .erg-eco__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.35rem 1.6rem;
  }
  .erg-eco__card {
    position: relative;
    min-width: 0;
    width: min(100%, 342px);
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 1.05rem;
    text-decoration: none;
    overflow: hidden;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 16px 44px rgba(10, 28, 64, 0.045),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }
  .erg-eco__card:nth-child(6) {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(226, 232, 240, 0.95);
    box-shadow:
      0 16px 44px rgba(10, 28, 64, 0.045),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }
  .erg-eco__card:hover {
    transform: translateY(-4px);
    border-color: rgba(55, 93, 251, 0.18);
    box-shadow:
      0 28px 86px rgba(10, 28, 64, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.96);
  }
  .erg-eco__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue);
    background: rgba(55, 93, 251, 0.08);
    box-shadow: inset 0 0 0 1px rgba(55, 93, 251, 0.1);
  }
  .erg-eco__card:nth-child(1) .erg-eco__icon {
    color: #f97316;
    background: rgba(249, 115, 22, 0.13) !important;
    box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.16);
  }
  .erg-eco__card:nth-child(2) .erg-eco__icon {
    color: #16a34a;
    background: rgba(22, 163, 74, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.16);
  }
  .erg-eco__card:nth-child(3) .erg-eco__icon {
    color: #375dfb;
    background: rgba(55, 93, 251, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(55, 93, 251, 0.16);
  }
  .erg-eco__card:nth-child(4) .erg-eco__icon {
    color: #7c3aed;
    background: rgba(124, 58, 237, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, 0.16);
  }
  .erg-eco__card:nth-child(5) .erg-eco__icon {
    color: #0ea5e9;
    background: rgba(14, 165, 233, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.16);
  }
  .erg-eco__card:nth-child(6) .erg-eco__icon {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.14) !important;
    box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.18);
  }
  .erg-eco__card:nth-child(7) .erg-eco__icon {
    color: #ec4899;
    background: rgba(236, 72, 153, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(236, 72, 153, 0.16);
  }
  .erg-eco__card:nth-child(8) .erg-eco__icon {
    color: #14b8a6;
    background: rgba(20, 184, 166, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(20, 184, 166, 0.16);
  }
  .erg-eco__icon svg {
    width: 21px;
    height: 21px;
  }
  .erg-eco__icon {
    position: relative;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 15px;
    color: #fff !important;
    transform: rotate(-4deg);
    box-shadow:
      0 12px 22px rgba(38, 57, 105, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      inset 0 -8px 15px rgba(12, 25, 58, 0.12) !important;
    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.28s ease;
  }
  .erg-eco__icon::after {
    content: "";
    position: absolute;
    width: 34px;
    height: 22px;
    top: -8px;
    left: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    filter: blur(5px);
    pointer-events: none;
  }
  .erg-eco__icon svg {
    position: relative;
    z-index: 1;
    width: 23px;
    height: 23px;
    stroke: #fff;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.12));
  }
  .erg-eco__card:nth-child(even) .erg-eco__icon {
    transform: rotate(4deg);
  }
  .erg-eco__card:hover .erg-eco__icon {
    transform: translateY(-3px) rotate(0deg) scale(1.06);
    box-shadow:
      0 17px 28px rgba(38, 57, 105, 0.23),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -8px 15px rgba(12, 25, 58, 0.1) !important;
  }
  .erg-eco__card:nth-child(1) .erg-eco__icon {
    background: linear-gradient(145deg, #ff9b42, #f25c2a) !important;
  }
  .erg-eco__card:nth-child(2) .erg-eco__icon {
    background: linear-gradient(145deg, #4ed99b, #0ea765) !important;
  }
  .erg-eco__card:nth-child(3) .erg-eco__icon {
    background: linear-gradient(145deg, #6fa8ff, #375dfb) !important;
  }
  .erg-eco__card:nth-child(4) .erg-eco__icon {
    background: linear-gradient(145deg, #a878ff, #7137e8) !important;
  }
  .erg-eco__card:nth-child(5) .erg-eco__icon {
    background: linear-gradient(145deg, #50d7f4, #129bda) !important;
  }
  .erg-eco__card:nth-child(6) .erg-eco__icon {
    background: linear-gradient(145deg, #ffc94d, #ef8f16) !important;
  }
  .erg-eco__card:nth-child(7) .erg-eco__icon {
    background: linear-gradient(145deg, #ff7fbd, #e93686) !important;
  }
  .erg-eco__card:nth-child(8) .erg-eco__icon {
    background: linear-gradient(145deg, #45ded5, #0ca6a0) !important;
  }
  .erg-platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(88px, 10vw, 132px);
  }
  .erg-platform__heading {
    order: 1;
    padding-top: 0;
    padding-bottom: 0;
  }
  .erg-platform__heading .erg-heading__title {
    max-width: 760px;
    margin-inline: auto;
  }
  .erg-eco {
    order: 2;
    width: 100%;
    max-width: 980px;
    padding-top: clamp(28px, 4vw, 46px);
  }
  .erg-eco__grid {
    position: relative;
    isolation: isolate;
    min-height: 178px;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    padding: 14px 24px 48px;
    perspective: 900px;
  }
  .erg-eco__grid::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 5px;
    width: 720px;
    height: 154px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 93, 251, 0.09),
      transparent 67%
    );
    transform: translateX(-50%);
    pointer-events: none;
  }
  .erg-eco__card,
  .erg-eco__card:nth-child(n) {
    position: relative;
    flex: 0 0 70px;
    width: 90px;
    min-height: 90px;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 20px;
    background: transparent;
    box-shadow: none;
    transform-origin: 50% 130%;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      z-index 0s;
  }
  .erg-eco__card-text {
    position: absolute;
    left: 50%;
    top: calc(100% + 14px);
    bottom: auto;
    z-index: 30;
    width: max-content;
    max-width: 180px;
    padding: 10px 14px;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 18px 42px rgba(31, 49, 92, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -5px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    text-align: left;
    pointer-events: none;
  }
  .erg-eco__card-desc {
