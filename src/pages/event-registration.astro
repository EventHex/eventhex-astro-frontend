    }
  }
  @property --erg-brand-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  .erg-cta__brand {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    margin: 0 0 24px;
    padding: 7px 16px 7px 34px;
    border: 1px solid #eef0f3;
    border-radius: 999px;
    background: #fff;
    color: #14151a;
    box-shadow: 0 5px 18px rgba(25, 40, 78, 0.045);
    font-size: 15px;
    font-weight: 500;
  }
  .erg-cta__brand::before {
    content: "✦";
    position: absolute;
    left: 13px;
    top: 50%;
    color: #4f8cff;
    font-size: 14px;
    transform: translateY(-50%);
    transform-origin: center;
    animation: erg-brand-star 2s ease-in-out infinite;
  }
  .erg-cta__brand::after {
    content: "";
    position: absolute;
    inset: -1.5px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--erg-brand-angle),
      transparent 0deg,
      transparent 270deg,
      #4f8cff 315deg,
      #b08bff 340deg,
      #4f8cff 355deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: erg-brand-spin 3s linear infinite;
  }
  .erg-heading__eyebrow {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin-bottom: 14px;
    padding: 7px 16px 7px 34px;
    border: 1px solid #eef0f3;
    border-radius: 999px;
    background: #fff;
    color: #14151a;
    box-shadow: 0 5px 18px rgba(25, 40, 78, 0.045);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
