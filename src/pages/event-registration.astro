---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex — Event Registration Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Event registration software for single sign-up forms or full checkout, with custom fields, payments, and email and WhatsApp confirmations.",
  url: "https://eventhex.ai/event-registration/",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free demo available",
  },
  featureList: [
    "Single Registration",
    "Multi-Ticket Checkout",
    "Custom Registration Forms",
    "Free and Paid Tickets",
    "Approval Workflows",
    "Email and WhatsApp Confirmations",
    "Embedded Registration",
    "Invitation-Only Events",
    "QR Check-In and Badge Printing",
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    [
      "What is the difference between the two registration modes?",
      "Single registration is one form for one person taking one ticket. Checkout lets one buyer select several tickets and pay once. You choose per event.",
    ],
    [
      "Can I collect different information for different ticket types?",
      "Yes. Shared questions and ticket-specific questions are built on the same screen, so each pass can collect exactly what it needs.",
    ],
    [
      "Can I take registrations for a free event?",
      "Yes. Free tickets skip the payment gateway and take the attendee straight to confirmation with their badge.",
    ],
    [
      "Can I approve people before confirming them?",
      "Yes. Registrations can wait for approval, and paid tickets can authorise the card at checkout and charge it only after approval.",
    ],
    [
      "Can I put registration on my own website?",
      "Yes. Embed either the registration form or full checkout with tickets pre-selected, so people can register without leaving your website.",
    ],
    [
      "Do attendees get their ticket automatically?",
      "Yes. Confirmation can go out by email, WhatsApp, or both, with the badge attached. Attendees can also download their badge and add the event to their calendar.",
    ],
    [
      "Can I run an invitation-only event?",
      "Yes. Send invitations, collect yes, maybe or no responses, and close the registration page to everyone who was not invited. Invitees can bring guests up to a limit you set.",
    ],
    [
      "What happens with the data on event day?",
      "Every registration carries a QR code your team scans at the door to check people in and print badges. Walk-ins can be added from the admin and printed at the desk.",
    ],
  ].map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  title="Online Event Registration Software & Checkout | EventHex"
  description="Run a single registration form or a full checkout, collect the details and payments you need, and confirm attendees by email and WhatsApp."
  canonical="https://eventhex.ai/event-registration/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
  footerCtaTitle="Ready to open registrations?"
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="erg-registration-page-bg">
    <!-- ===== HERO: one clear visual, a live registration demo ===== -->
    <section class="erx-hero">
      <div class="erx-hero__grid">
        <div class="erx-hero__content">
          <span class="erx-eyebrow animate-on-scroll" data-animation="fadeInDown">Event Registration</span>
          <h1 class="erx-h1 animate-on-scroll" data-animation="fadeInUp">
            Event registration software that fits how people actually sign up
          </h1>
          <p class="erx-lead animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">
            Take sign-ups through a single form or a full checkout, build
            exactly the fields you need, collect payment if you charge, and
            confirm by email and WhatsApp — without stitching four tools
            together.
          </p>
          <div class="erx-hero__ctas animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1100ms">
            <a href="/book-a-demo/" class="erx-btn erx-btn--dark">
              See it with your event
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <a href="#erg-spotlight" class="erx-btn erx-btn--outline">Compare the two modes</a>
          </div>
          <div class="erx-hero__trust animate-on-scroll" data-animation="fadeIn" style="--anim-duration: 1250ms">
            <span><b>500+</b> events</span>
            <span><b>15+</b> countries</span>
          </div>
        </div>
        <div class="erx-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="erx-browser">
            <div class="erx-browser__bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span>meridian-health-congress.eventhex.ai/register</span>
            </div>
            <video class="erx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="700"
              poster="/feature-images/event-registration/v3/register-poster.webp"
              aria-label="An attendee fills the Meridian Health Congress registration form, then receives an e-ticket with a QR code">
              <source src="/feature-images/event-registration/v3/register.mp4" type="video/mp4" />
            </video>
          </div>
          <ol class="erx-steps" aria-label="What the demo shows">
            <li>Fill the form</li>
            <li>Pay if you charge</li>
            <li>Ticket arrives</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ===== TRUST STRIP ===== -->
    <section class="erx-trust">
      <span><b>500+</b> Events Run on EventHex</span>
      <span><b>15+</b> Countries</span>
      <span><b>Free &amp; Paid</b> Registration</span>
      <span><b>0%</b> Platform Fees on Your Gateway</span>
    </section>

    <!-- ===== TWO MODES: same event (Meridian) for both ===== -->
    <section id="erg-spotlight" class="erx-section">
      <div class="erx-head">
        <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">
          Online Event Registration: One Form or a Full Checkout, Your Call
        </h2>
        <p class="erx-sub animate-on-scroll" data-animation="fadeInUp">
          Pick the flow that matches how people sign up for your event. You can
          change it per event.
        </p>
      </div>
      <div class="erx-modes">
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp">
          <h3 class="erx-h3">Single Registration</h3>
          <p class="erx-text">
            One person, one ticket, one form. They fill it in and they are done
            — the fastest path for free events, workshops and webinars.
          </p>
          <div class="erx-shot erx-shot--lift">
            <img src="/feature-images/event-registration/v3/single-registration.webp" width="960" height="525" loading="lazy"
              alt="Single registration form for the Meridian Health Congress Member ticket, with a $290 total" />
          </div>
          <span class="erx-caption"><b>One attendee, one form</b> · Register now</span>
        </article>
        <article class="erx-card erx-card--tint animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <h3 class="erx-h3">Checkout</h3>
          <p class="erx-text">
            One buyer, several tickets, one payment. A cart flow for teams
            booking together, families, and companies sending a group.
          </p>
          <div class="erx-shot erx-shot--lift">
            <video class="erx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="722"
              poster="/feature-images/event-registration/v3/checkout-poster.webp"
              aria-label="A buyer adds Member, Non-member and Student tickets for the same congress, the total updates to $775, then they enter attendee details">
              <source src="/feature-images/event-registration/v3/checkout.mp4" type="video/mp4" />
            </video>
          </div>
          <span class="erx-caption"><b>Multi-ticket checkout</b> · Continue to checkout</span>
        </article>
      </div>
      <p class="erx-note">
        Not sure? Most free events use single registration. Anything where one
        person pays for several people needs checkout.
      </p>
    </section>

    <!-- ===== FORM BUILDER ===== -->
    <section class="erx-section erx-section--tight">
      <div class="erx-head">
        <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">Build the Form You Actually Need</h2>
      </div>
      <div class="erx-fgrid">
        <article class="erx-card erx-fgrid__wide animate-on-scroll" data-animation="fadeInUp">
          <h3 class="erx-h3">Start From Ready-Made Fields</h3>
          <p class="erx-text">
            Name, email, phone, company, job title, country, website, photo, and
            more — then add your own.
          </p>
          <div class="erx-shot">
            <video class="erx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="1070"
              poster="/feature-images/event-registration/v3/form-builder-poster.webp"
              aria-label="Add Field opens the field picker in the EventHex form builder, and the new Specialty question appears on the form">
              <source src="/feature-images/event-registration/v3/form-builder.mp4" type="video/mp4" />
            </video>
          </div>
        </article>
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <h3 class="erx-h3 erx-h3--sm">Thirteen Field Types</h3>
          <p class="erx-text erx-text--sm">
            Text, email, number, date, time, dropdown, multi-select, checkbox,
            file upload, rating, NPS, password and information blocks.
          </p>
          <div class="erx-shot">
            <img src="/feature-images/event-registration/v3/field-types.webp" width="509" height="568" loading="lazy"
              alt="The thirteen custom field types from the EventHex field picker: text input, email, number, password, date, time, file upload, checkbox, dropdown, multi-select, NPS, rating and info" />
          </div>
        </article>
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp">
          <h3 class="erx-h3 erx-h3--sm">Ask Different Questions per Ticket</h3>
          <p class="erx-text erx-text--sm">
            Shared questions everyone answers sit alongside questions only one
            ticket type sees, edited on the same screen.
          </p>
          <div class="erx-shot erx-shot--crop" style="--pos: 50% 100%">
            <img src="/feature-images/event-registration/v3/per-ticket-questions.webp" width="960" height="803" loading="lazy"
              alt="Form builder with shared questions and a Member-only membership number question" />
          </div>
        </article>
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <h3 class="erx-h3 erx-h3--sm">Collect Files at Sign-Up</h3>
          <p class="erx-text erx-text--sm">
            Portfolios, ID documents, dietary forms, signed waivers — accept
            uploads as part of registration.
          </p>
          <div class="erx-shot erx-shot--crop" style="--pos: 78% 92%">
            <img src="/feature-images/event-registration/v3/file-upload.webp" width="960" height="673" loading="lazy"
              alt="Student ticket form asking for a student or residency ID upload" />
          </div>
        </article>
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
          <h3 class="erx-h3 erx-h3--sm">Works in Your Languages</h3>
          <p class="erx-text erx-text--sm">
            Field labels carry per-language overrides for international
            audiences.
          </p>
          <div class="erx-shot erx-shot--crop" style="--pos: 10% 30%">
            <img src="/feature-images/event-registration/v3/form-arabic.webp" width="960" height="525" loading="lazy"
              alt="Ascend Impact Summit registration form shown in Arabic, right to left" />
          </div>
        </article>
      </div>
    </section>

    <!-- ===== QUICK REGISTER: LinkedIn autofill + AI voice ===== -->
    <section class="erx-section erx-section--tight">
      <div class="erx-head">
        <span class="erx-eyebrow">Quick Register</span>
        <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">Let People Register Without Typing Everything</h2>
        <p class="erx-sub">Two optional shortcuts sit above your form. Attendees can use one, or skip both and type as usual.</p>
      </div>
      <div class="erx-modes">
        <article class="erx-card animate-on-scroll" data-animation="fadeInUp">
          <div class="erx-titlerow">
            <span class="erx-icon erx-icon--li" aria-hidden="true">in</span>
            <h3 class="erx-h3">Autofill with LinkedIn</h3>
          </div>
          <p class="erx-text">
            One tap on Quick Register signs people in with LinkedIn and fills in
            their name, email and photo. It is on by default, and you can switch
            it off for any event.
          </p>
          <div class="erx-shot erx-shot--lift erx-shot--top">
            <img src="/feature-images/event-registration/v3/linkedin-quick-register.webp" width="1200" height="298" loading="lazy"
              alt="Quick Register, Autofill with LinkedIn button at the top of the Meridian Health Congress form" />
          </div>
          <div class="erx-split">
            <div class="erx-shot erx-shot--lift">
              <img src="/feature-images/event-registration/v3/linkedin-integration.webp" width="687" height="413" loading="lazy"
                alt="LinkedIn Autofill integration card, connected and switched on" />
            </div>
            <p class="erx-text erx-text--sm"><b>You stay in control</b><br />Design › Website Integrations. Switch it off and the button disappears from the form.</p>
          </div>
        </article>
        <article class="erx-card erx-card--tint animate-on-scroll" data-animation="fadeInUp" data-delay="80">
          <div class="erx-titlerow">
            <span class="erx-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
            </span>
            <h3 class="erx-h3">Fill the Form by Voice</h3>
          </div>
          <p class="erx-text">
            Attendees tap Record using AI and talk through their details in their
            own words. AI fills in the matching fields, and they check everything
            before they submit. Turn it on per event.
          </p>
          <div class="erx-shot erx-shot--lift">
            <video class="erx-loop" autoplay muted loop playsinline preload="metadata" width="1280" height="822"
              poster="/feature-images/event-registration/v3/voice-fill-poster.webp"
              aria-label="An attendee records their details, AI processes the audio, and the form fills in name, email, phone, hospital, specialty and dietary needs">
              <source src="/feature-images/event-registration/v3/voice-fill.mp4" type="video/mp4" />
            </video>
          </div>
          <span class="erx-caption">Needs microphone permission. Photo and file-upload fields are still filled by hand.</span>
        </article>
      </div>
    </section>

    <!-- ===== DARK BAND CTA ===== -->
    <div class="erx-darkcta animate-on-scroll" data-animation="fadeInUp">
      <h2 class="erx-darkcta__title">The only registration flow your event actually needs</h2>
      <a class="erx-btn erx-btn--light" href="/book-a-demo/">Get Started with EventHex</a>
    </div>

    <!-- ===== ACCESS CONTROL ===== -->
    <section class="erx-panel">
      <div class="erx-panel__head">
        <div class="erx-head erx-head--left">
          <span class="erx-eyebrow">Access Control</span>
          <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">Control who gets in</h2>
          <p class="erx-sub">Set the approval, payment, visibility, and capacity rules that fit each registration flow.</p>
        </div>
        <a class="erx-btn erx-btn--dark" href="/book-a-demo/">Book a Demo</a>
      </div>
      <div class="erx-access">
        <article class="erx-acard animate-on-scroll" data-animation="fadeInUp">
          <span class="erx-acard__n">01</span>
          <h3 class="erx-h3 erx-h3--xs">Approve before confirming</h3>
          <p class="erx-text erx-text--sm">Review each registration and approve or reject it. Rejected registrations get their own message.</p>
          <div class="erx-shot">
            <img src="/feature-images/event-registration/v3/approval-settings.webp" width="900" height="457" loading="lazy" alt="Approval settings for a ticket: require approval and enable refund" />
          </div>
        </article>
        <article class="erx-acard animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="erx-acard__n">02</span>
          <h3 class="erx-h3 erx-h3--xs">Hold the payment</h3>
          <p class="erx-text erx-text--sm">Authorise the card at checkout and charge only once you approve. Nothing is taken if you say no.</p>
          <span class="erx-caption">Available with Stripe.</span>
          <div class="erx-shot erx-shot--crop erx-shot--h230" style="--pos: 100% 0%">
            <img src="/feature-images/event-registration/v3/checkout-cart.webp" width="960" height="542" loading="lazy" alt="Checkout order with three congress tickets, total $775" />
          </div>
        </article>
        <article class="erx-acard animate-on-scroll" data-animation="fadeInUp">
          <span class="erx-acard__n">03</span>
          <h3 class="erx-h3 erx-h3--xs">Private tickets</h3>
          <p class="erx-text erx-text--sm">Keep a ticket off the public page and share it by direct link only.</p>
          <div class="erx-shot">
            <img src="/feature-images/event-registration/v3/private-ticket.webp" width="1198" height="424" loading="lazy" alt="Private Faculty Pass ticket in the EventHex admin, marked Private ticket and Link only, with its share link button" />
          </div>
        </article>
        <article class="erx-acard animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="erx-acard__n">04</span>
          <h3 class="erx-h3 erx-h3--xs">Ticket-specific rules</h3>
          <p class="erx-text erx-text--sm">Limits per purchase, limits per person across separate orders, and <a href="/event-ticketing/">sale windows</a> that open and close on their own.</p>
          <div class="erx-shot erx-shot--crop erx-shot--h175" style="--pos: 50% 100%">
            <img src="/feature-images/event-registration/v3/ticket-rules.webp" width="900" height="811" loading="lazy" alt="Ticket settings with maximum tickets to sell and per-purchase limits" />
          </div>
        </article>
      </div>
    </section>

    <!-- ===== DECIDE HOW MUCH YOU COLLECT ===== -->
    <section class="erx-section erx-collect">
      <div class="erx-collect__copy">
        <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">Decide How Much You Collect From Each Attendee</h2>
        <p class="erx-sub">When one person books for several people, you choose what happens next.</p>
        <div class="erx-collect__item is-active">
          <h3>Collect everyone's details</h3>
          <p>Each ticket gets its own form, so you know exactly who is attending, what they need and what they answered. Best when badges, dietary needs or sessions matter.</p>
        </div>
        <div class="erx-collect__item">
          <h3>Take the buyer's details</h3>
          <p>The rest inherit the buyer's name and email, and checkout stays short. Best when speed matters more than per-person data.</p>
        </div>
        <div class="erx-collect__item">
          <h3>Change rules per event</h3>
          <p>You can change this rule per event, and switch it on later if the first approach proves too thin or you need more data.</p>
        </div>
      </div>
      <div class="erx-shot erx-shot--lift animate-on-scroll" data-animation="fadeInRight">
        <img src="/feature-images/event-registration/v3/checkout-attendee-details.webp" width="960" height="542" loading="lazy" alt="Checkout step 2: attendee details for an order of three congress tickets" />
      </div>
    </section>

    <!-- ===== BRIDGE TO EVENT TICKETING ===== -->
    <section class="erx-bridge animate-on-scroll" data-animation="fadeInUp">
      <div class="erx-bridge__copy">
        <span class="erx-bridge__eyebrow">Charging for tickets?</span>
        <h2 class="erx-bridge__title">Registration gets the right people in. Event Ticketing handles the money.</h2>
        <p>Ticket types and prices, discount coupons, orders and refunds, and a finance report of what you collected, all on the same event. See how it works on its own page.</p>
        <a class="erx-btn erx-btn--light" href="/event-ticketing/">Explore Event Ticketing →</a>
        <nav class="erx-bridge__related" aria-label="Related features">
          <span>Related</span>
          <a href="/event-payment-processing/">Payment processing</a>
          <a href="/invoicing-gst/">Invoicing &amp; GST</a>
          <a href="/event-check-in/">Check-in</a>
        </nav>
      </div>
      <div class="erx-bridge__visual">
        <img src="/feature-images/event-registration/v3/checkout-cart.webp" width="960" height="542" loading="lazy" alt="Meridian Health Congress checkout with three tickets, total $775" />
      </div>
    </section>

    <!-- ===== CONFIRMATIONS BENTO ===== -->
    <section class="erx-section erx-section--tight">
      <div class="erx-head">
        <h2 class="erx-h2 animate-on-scroll" data-animation="fadeInUp">Confirmations That Reach People</h2>
      </div>
      <div class="erx-bento">
        <article class="erx-bcard erx-bcard--dark animate-on-scroll" data-animation="fadeInUp">
          <span class="erx-tag">Automated</span>
          <h3 class="erx-h3">Confirmations That Reach People</h3>
          <p class="erx-text">Every registration triggers a confirmation by email, WhatsApp, or both — with the badge attached if you want it. Approval and rejection messages have their own templates, and you can edit all of them per event and per language.</p>
          <p class="erx-text erx-text--sm">If someone books for a group, one WhatsApp message can cover the whole order instead of one per ticket.</p>
          <div class="erx-tickets">
            <img src="/feature-images/event-registration/v3/eticket-pulse.webp" width="420" height="720" loading="lazy" alt="Pulse Tech Expo e-ticket with QR code" />
            <img src="/feature-images/event-registration/v3/eticket-ascend.webp" width="420" height="720" loading="lazy" alt="Ascend Impact Summit e-ticket with QR code" />
            <img src="/feature-images/event-registration/v3/eticket-meridian.webp" width="420" height="744" loading="lazy" alt="Meridian Health Congress e-ticket with QR code" />
          </div>
        </article>
        <article class="erx-bcard animate-on-scroll" data-animation="fadeInUp" data-delay="60">
          <span class="erx-tag">Embedded</span>
          <h3 class="erx-h3">Put Registration on Your Own Website</h3>
          <p class="erx-text">Embed the form or the full checkout directly in your site, with the tickets already selected. Visitors register without leaving your page, and everything still lands in EventHex.</p>
          <div class="erx-browser erx-browser--sm">
            <div class="erx-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>northgatemedical.org/annual-congress</span></div>
            <img src="/feature-images/event-registration/v3/embedded-form.webp" width="1600" height="1000" loading="lazy" alt="The Meridian Health Congress registration form embedded inside an association's own website" />
          </div>
          <p class="erx-text erx-text--xs">Useful when your event lives inside a bigger site you already run — or use the EventHex event website instead and skip the embedding.</p>
        </article>
        <article class="erx-bcard animate-on-scroll" data-animation="fadeInUp">
          <span class="erx-tag">Gated</span>
          <h3 class="erx-h3">Invite People Directly</h3>
          <p class="erx-text">Send an invitation and let people respond yes, maybe or no before they register. Accepting takes them straight into the right form with their details already filled in. Invitees can bring guests, up to a limit you set.</p>
          <p class="erx-text erx-text--sm">Turn on invitation-only and the registration page closes to everyone else — useful for board meetings, private dinners and members-only events.</p>
          <div class="erx-shot erx-shot--crop erx-shot--h300" style="--pos: 50% 0%">
            <img src="/feature-images/event-registration/v3/invitations.webp" width="1400" height="881" loading="lazy" alt="Ticket invitations list with each guest's RSVP (accepted, maybe, pending, declined), guests and registration status" />
          </div>
        </article>
