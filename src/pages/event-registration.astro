<script>
  // Play the demo loops only while they are on screen; keep them paused for reduced motion.
  const erxLoops = Array.from(document.querySelectorAll<HTMLVideoElement>('.erx-loop'));
  const erxReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (erxReduced) {
    erxLoops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const erxObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    erxLoops.forEach((video) => erxObserver.observe(video));
  }
  // Highlight the hero step that the demo is showing.
  const erxHeroVideo = document.querySelector<HTMLVideoElement>('.erx-hero .erx-loop');
  const erxSteps = Array.from(document.querySelectorAll<HTMLLIElement>('.erx-steps li'));
  if (erxHeroVideo && erxSteps.length === 3) {
    const marks = [0, 6.2, 7.4];
    const sync = () => {
      const t = erxHeroVideo.currentTime;
      const step = t >= marks[2] ? 2 : t >= marks[1] ? 1 : 0;
      erxSteps.forEach((li, i) => li.classList.toggle('is-current', i === step));
    };
    erxSteps[0].classList.add('is-current');
    erxHeroVideo.addEventListener('timeupdate', sync);
  }
</script>

