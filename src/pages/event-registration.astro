  }
  .erg-payment-plan h3 {
    margin: 0 0 5px;
    color: var(--heading-dark);
    font: 700 1.2rem/1.2 var(--font-heading);
  }
  .erg-payment-plan p {
    margin: 0 0 18px;
    color: #596579;
    font-size: 0.84rem;
  }
  .erg-payment-plan span {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid #dce1e9;
    border-radius: 12px;
    color: var(--heading-dark);
    background: #fff;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .erg-payment-plan--featured span {
    border-color: var(--brand-blue);
    color: #fff;
    background: linear-gradient(135deg, #5681ff, var(--brand-blue));
    box-shadow: 0 8px 20px rgba(55, 93, 251, 0.22);
  }
  .erg-payment-table__group {
    padding: 30px 0 20px;
    border-top: 1px solid #e5e9f0;
    color: var(--heading-dark);
    font: 700 1.05rem/1.3 var(--font-heading);
  }
  .erg-payment-table__row {
    min-height: 62px;
    border-top: 1px solid #e5e9f0;
  }
  .erg-payment-table__row > span {
    display: flex;
    align-items: center;
    padding-right: 24px;
    color: #344054;
    font-size: 0.94rem;
  }
  .erg-payment-table__row > b {
    display: grid;
    place-items: center;
    color: var(--heading-dark);
    font-size: 1.08rem;
  }
  .erg-payment-table__row > .is-featured {
    color: var(--brand-blue);
    background: var(--compare-featured);
  }
  .erg-payment-compare__note {
    max-width: 880px;
    margin: 34px auto 0;
    color: var(--subheading-gray);
    font: 400 0.95rem/1.7 var(--font-body);
    text-align: center;
  }
  .erg-payment-compare__note a {
    color: var(--brand-blue);
    text-decoration: none;
  }
  .erg-content-section--dark {
    color: #fff;
    background: linear-gradient(135deg, #172033 0%, #222f4a 100%);
  }
  .erg-access-showcase {
    background: #fff;
  }
  .erg-access-showcase .erg-content-heading {
    max-width: 760px;
  }
  .erg-access-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    overflow: hidden;
    border-top: 1px solid #dce3ee;
    border-left: 1px solid #dce3ee;
