---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import LottiePlayer from "../components/LottiePlayer.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex — Event Registration Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Event registration software for single sign-up forms or full checkout, with custom fields, payments, and email and WhatsApp confirmations.",
  url: "https://eventhex.ai/event-registration/",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free demo available",
  },
  featureList: [
    "Single Registration",
    "Multi-Ticket Checkout",
    "Custom Registration Forms",
    "Free and Paid Tickets",
    "Approval Workflows",
    "Email and WhatsApp Confirmations",
    "Embedded Registration",
    "Invitation-Only Events",
    "QR Check-In and Badge Printing",
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    [
      "What is the difference between the two registration modes?",
      "Single registration is one form for one person taking one ticket. Checkout lets one buyer select several tickets and pay once. You choose per event.",
    ],
    [
      "Can I collect different information for different ticket types?",
      "Yes. Shared questions and ticket-specific questions are built on the same screen, so each pass can collect exactly what it needs.",
    ],
    [
      "Can I take registrations for a free event?",
      "Yes. Free tickets skip the payment gateway and take the attendee straight to confirmation with their badge.",
    ],
    [
      "Can I approve people before confirming them?",
      "Yes. Registrations can wait for approval, and paid tickets can authorise the card at checkout and charge it only after approval.",
    ],
    [
      "Can I put registration on my own website?",
      "Yes. Embed either the registration form or full checkout with tickets pre-selected, so people can register without leaving your website.",
    ],
    [
      "Do attendees get their ticket automatically?",
      "Yes. Confirmation can go out by email, WhatsApp, or both, with the badge attached. Attendees can also download their badge and add the event to their calendar.",
    ],
    [
      "Can I run an invitation-only event?",
      "Yes. Send invitations, collect yes, maybe or no responses, and close the registration page to everyone who was not invited. Invitees can bring guests up to a limit you set.",
    ],
    [
      "What happens with the data on event day?",
      "Every registration carries a QR code your team scans at the door to check people in and print badges. Walk-ins can be registered at the desk and printed on the spot.",
    ],
  ].map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  title="Event Registration Software That Fits How People Sign Up | EventHex"
  description="Run a single registration form or a full checkout, collect the details and payments you need, and confirm attendees by email and WhatsApp."
  canonical="https://eventhex.ai/event-registration/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
  footerCtaTitle="Ready to open registrations?"
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="erg-registration-page-bg">
    <!-- ===== HERO ===== -->
    <section class="erg-hero">
      <div class="erg-hero__grid">
        <div class="erg-hero__content">
          <span
            class="erg-hero__badge animate-on-scroll"
            data-animation="fadeInDown">Event Registration</span
          >
          <h1
            class="erg-hero__title animate-on-scroll"
            data-animation="fadeInUp"
          >
            Event registration software that fits how people actually sign up
          </h1>
          <p
            class="erg-hero__desc animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 800ms"
          >
            Take sign-ups through a single form or a full checkout, build
            exactly the fields you need, collect payment if you charge, and
            confirm by email and WhatsApp — without stitching four tools
            together.
          </p>
          <div
            class="erg-hero__cta-row animate-on-scroll"
            data-animation="fadeInUp"
            style="--anim-duration: 1100ms"
          >
            <a href="/book-a-demo/" class="erg-hero__btn">
              See it with your event
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            <a href="#erg-spotlight" class="erg-hero__btn erg-hero__btn--outline">
              Compare the two modes
            </a>
          </div>
          <div
            class="erg-hero__trust animate-on-scroll"
            data-animation="fadeIn"
            style="--anim-duration: 1250ms"
          >
            <span class="erg-hero__trust-item">500+ events</span>
            <span class="erg-hero__trust-item">15+ countries</span>
          </div>
        </div>
        <div
          class="erg-hero__visual animate-on-scroll"
          data-animation="fadeInRight"
        >
          <div class="erg-hero__visual-card">
            <div class="erg-hero__visual-inner">
              <LottiePlayer
                src="/animations/event-registration-hero.json"
                class="erg-hero__lottie"
                eager
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TRUST STRIP ===== -->
    <section class="erg-trust-strip">
      <div class="erg-trust-strip__inner">
        <span class="erg-trust-strip__stat"
          ><b>500+</b> Events Run on EventHex</span
        >
        <span class="erg-trust-strip__stat"><b>15+</b> Countries</span>
        <span class="erg-trust-strip__stat"
          ><b>Free &amp; Paid</b> Registration</span
        >
        <span class="erg-trust-strip__stat"
          ><b>0%</b> Platform Fees on Your Gateway</span
        >
      </div>
    </section>

    <!-- ===== SPOTLIGHT (CHOOSE REGISTRATION FLOW) ===== -->
    <section id="erg-spotlight" class="erg-flow-section">
      <div class="erg-flow-header">
        <h2 class="erg-flow-title animate-on-scroll" data-animation="fadeInUp">
          One Form, or a Full Checkout, Your Call
        </h2>
        <p
          class="erg-flow-subtitle animate-on-scroll"
          data-animation="fadeInUp"
        >
          Pick the flow that matches how people sign up for your event. You can
          change it per event.
        </p>
      </div>

      <div class="erg-flow-quad">
        <article
          class="erg-flow-quad__cell erg-flow-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="erg-flow-quad__title">Single Registration</h3>
          <p class="erg-flow-quad__text">
            One person, one ticket, one form. They fill it in and they are done
            — the fastest path for free events, workshops and webinars.
          </p>
        </article>

        <div
          class="erg-flow-quad__cell erg-flow-quad__cell--media animate-on-scroll"
          data-animation="fadeInRight"
        >
          <div class="erg-flow-composite">
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--primary"
              src="/feature-images/event-registration/single-registration-form.png"
              alt="EventHex single registration form"
              width="760"
              height="480"
              loading="lazy"
            />
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--secondary"
              src="/feature-images/event-registration/single-ticket-list.png"
              alt="EventHex ticket list for single registration"
              width="760"
              height="480"
              loading="lazy"
            />
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--detail"
              src="/feature-images/event-registration/single-preview-settings.png"
              alt="EventHex single registration preview settings"
              width="360"
              height="480"
              loading="lazy"
            />
            <span class="erg-flow-composite__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              One attendee, one form
            </span>
            <span class="erg-flow-composite__action">Register now</span>
            <img class="erg-flow-composite__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
          </div>
        </div>

        <div
          class="erg-flow-quad__cell erg-flow-quad__cell--media animate-on-scroll"
          data-animation="fadeInLeft"
        >
          <div class="erg-flow-composite">
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--primary"
              src="/feature-images/event-registration/checkout-select-tickets.png"
              alt="EventHex multi-ticket checkout selection"
              width="1180"
              height="540"
              loading="lazy"
            />
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--secondary"
              src="/feature-images/event-registration/checkout-attendee-details.png"
              alt="EventHex checkout attendee details step"
              width="1180"
              height="540"
              loading="lazy"
            />
            <img
              class="erg-flow-composite__screen erg-flow-composite__screen--detail"
              src="/feature-images/event-registration/checkout-order-details.png"
              alt="EventHex checkout order summary"
              width="360"
              height="440"
              loading="lazy"
            />
            <span class="erg-flow-composite__status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
              Multi-ticket checkout
            </span>
            <span class="erg-flow-composite__action">Continue to checkout</span>
            <img class="erg-flow-composite__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
          </div>
        </div>

        <article
          class="erg-flow-quad__cell erg-flow-quad__cell--copy animate-on-scroll"
          data-animation="fadeInUp"
        >
          <h3 class="erg-flow-quad__title">Checkout</h3>
          <p class="erg-flow-quad__text">
            One buyer, several tickets, one payment. A cart flow for teams
            booking together, families, and companies sending a group.
          </p>
        </article>
        <span class="erg-flow-quad__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="scale(1,-1)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(90)" />
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--surface-card-border)" transform="rotate(-90)" />
          </svg>
        </span>
      </div>
      <p class="erg-content-note">
        Not sure? Most free events use single registration. Anything where one
        person pays for several people needs checkout.
      </p>
    </section>

    <div class="erg-dark-band">
    <!-- ===== CORE CAPABILITIES HEADING ===== -->
    <div class="erg-heading erg-capabilities-heading">
      <h2
        class="erg-heading__title animate-on-scroll"
        data-animation="fadeInUp"
      >
        Build the Form <span class="erg-global-heading-gradient"
          >You Actually Need</span
        >
      </h2>
    </div>

    <!-- ===== CAPABILITIES GRID ===== -->
    <section class="erg-grid-section">
      <div class="erg-cap">
        <article
          class="erg-cap__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="0"
        >
          <h3 class="erg-cap__label">Start From Ready-Made Fields</h3>
          <p class="erg-cap__desc">
            Name, email, phone, company, job title, country, website, photo, and
            more — then add your own.
          </p>
          <div class="erg-cap__visual">
            <div class="erg-cap__card">
              <span class="erg-cap__card-head">Registration form</span>
              <div class="erg-cap__field"><span>Full name</span><i></i></div>
              <div class="erg-cap__field"><span>Work email</span><i></i></div>
              <div class="erg-cap__field"><span>Company</span><i></i></div>
              <div class="erg-cap__field erg-cap__field--add">
                <span>+ Add your own field</span>
              </div>
            </div>
          </div>
        </article>

        <article
          class="erg-cap__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="60"
        >
          <span class="erg-cap__petal erg-cap__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="erg-cap__petal erg-cap__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="erg-cap__label">Thirteen Field Types</h3>
          <p class="erg-cap__desc">
            Text, email, number, date, time, dropdown, multi-select, checkbox,
            file upload, rating, NPS, password and information blocks.
          </p>
          <div class="erg-cap__visual">
            <div class="erg-cap__chips">
              <span>Text</span><span>Email</span><span>Number</span><span
                class="is-active">Date</span
              ><span>Time</span><span>Dropdown</span><span>Multi-select</span
              ><span>Checkbox</span><span>File upload</span><span>Rating</span
              ><span>NPS</span><span>Password</span><span>Info block</span>
            </div>
          </div>
        </article>

        <article
          class="erg-cap__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="120"
        >
          <span class="erg-cap__petal erg-cap__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="erg-cap__petal erg-cap__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="erg-cap__label">Ask Different Questions per Ticket</h3>
          <p class="erg-cap__desc">
            Shared questions everyone answers sit alongside questions only one
            ticket type sees, edited on the same screen.
          </p>
          <div class="erg-cap__visual">
            <div class="erg-cap__stack">
              <div class="erg-cap__ticket">
                <span class="erg-cap__ticket-name">Shared questions</span>
                <span class="erg-cap__ticket-tag">All tickets</span>
              </div>
              <div class="erg-cap__ticket">
                <span class="erg-cap__ticket-name">All access pass</span>
                <span class="erg-cap__ticket-tag">+2</span>
              </div>
              <div class="erg-cap__ticket is-active">
                <span class="erg-cap__ticket-name">Workshop seat</span>
                <span class="erg-cap__ticket-tag">+4</span>
              </div>
            </div>
          </div>
        </article>

        <article
          class="erg-cap__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="180"
        >
          <h3 class="erg-cap__label">Collect Files at Sign-Up</h3>
          <p class="erg-cap__desc">
            Portfolios, ID documents, dietary forms, signed waivers — accept
            uploads as part of registration.
          </p>
          <div class="erg-cap__visual">
            <div class="erg-cap__card">
              <span class="erg-cap__card-head">Upload ID document</span>
              <div class="erg-cap__file">
                <span class="erg-cap__file-icon">PDF</span>
                <div class="erg-cap__file-meta">
                  <span>passport-scan.pdf</span>
                  <div class="erg-cap__bar"><i></i></div>
                </div>
              </div>
              <div class="erg-cap__file">
                <span class="erg-cap__file-icon erg-cap__file-icon--img"
                  >JPG</span
                >
                <div class="erg-cap__file-meta">
                  <span>portfolio-cover.jpg</span>
                  <div class="erg-cap__bar"><i style="width: 62%"></i></div>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article
          class="erg-cap__cell animate-on-scroll"
          data-animation="fadeInUp"
          data-delay="240"
        >
          <span class="erg-cap__petal erg-cap__petal--top" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path>
            </svg>
          </span>
          <span class="erg-cap__petal erg-cap__petal--bottom" aria-hidden="true">
            <svg width="28" height="28" viewBox="-14 -14 28 28">
              <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path>
            </svg>
          </span>
          <h3 class="erg-cap__label">Works in Your Languages</h3>
          <p class="erg-cap__desc">
            Field labels carry per-language overrides for international
            audiences.
          </p>
          <div class="erg-cap__visual">
            <div class="erg-cap__langs">
              <div class="erg-cap__lang is-active">
                <span class="erg-cap__lang-code">EN</span>
                <span>Full name</span>
              </div>
              <div class="erg-cap__lang">
                <span class="erg-cap__lang-code">AR</span>
                <span>الاسم الكامل</span>
              </div>
              <div class="erg-cap__lang">
                <span class="erg-cap__lang-code">FR</span>
                <span>Nom complet</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ===== DARK BAND CTA ===== -->
    <div class="erg-dark-cta animate-on-scroll" data-animation="fadeInUp">
      <h2 class="erg-dark-cta__title">
        The only registration flow your
        <span class="erg-dark-cta__break">event actually needs</span>
      </h2>
      <a class="erg-dark-cta__btn" href="/book-a-demo/">Get Started with EventHex</a>
    </div>
    </div>

    <!-- ===== ACCESS CONTROL ===== -->
    <section class="erg-content-section erg-access-redesign">
      <div class="erg-access-redesign__container">
        <div class="erg-access-redesign__left">
          <div
            class="erg-access-redesign__sticky animate-on-scroll"
            data-animation="fadeInUp"
          >
            <div class="erg-access-redesign__eyebrow">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
              Access Control
            </div>
            <h2>
              Control who <span class="erg-global-heading-gradient"
                >gets in</span
              >
            </h2>
            <p>
              Set the approval, payment, visibility, and capacity rules that fit
              each registration flow.
            </p>
            <a class="erg-access-redesign__cta" href="/book-a-demo/">
              Book a Demo
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                ><path
                  d="M5 12h14M13 6l6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>

        <div class="erg-access-redesign__right">
          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">01</div>
              <div class="erg-access-rcard__text">
                <h3>Approve before confirming</h3>
                <p>
                  Review each registration and approve or reject it. Rejected
                  registrations get their own message.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual erg-access-rcard__visual--approval">
              <div class="erg-approval-stack">
                <img
                  class="erg-approval-stack__tickets"
                  src="/feature-images/event-registration/approval-ticket-list.png"
                  alt="EventHex ticket list for an event registration workflow"
                  loading="lazy"
                />
                <img
                  class="erg-approval-stack__setting"
                  src="/feature-images/event-registration/approval-setting.png"
                  alt="EventHex Require Approval setting for attendee registrations"
                  loading="lazy"
                />
                <span class="erg-access-product-shot__status erg-access-product-shot__status--approval">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
                  Approval required
                </span>
                <span class="erg-access-product-shot__action">Review &amp; approve</span>
                <svg class="erg-access-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
              </div>
            </div>
          </article>

          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="60"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">02</div>
              <div class="erg-access-rcard__text">
                <h3>Hold the payment</h3>
                <p>
                  Authorise the card at checkout and charge only once you
                  approve. Nothing is taken if you say no.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual erg-access-rcard__visual--product-shot">
              <div class="erg-access-product-shot erg-access-product-shot--payment">
                <img
                  src="/feature-images/event-registration/hold-payment-settings.png"
                  alt="EventHex paid event and checkout configuration"
                  loading="lazy"
                />
                <span class="erg-access-product-shot__status erg-access-product-shot__status--success">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.2 3 3 6-6"></path></svg>
                  Payment secured
                </span>
                <span class="erg-access-product-shot__action">Approve &amp; charge</span>
                <svg class="erg-access-product-shot__cursor" viewBox="0 0 28 32" aria-hidden="true"><path d="M3 2.5 23.5 17l-9.2 1.2-5.2 8.3L3 2.5Z"></path></svg>
              </div>
            </div>
          </article>

          <article
            class="erg-access-rcard animate-on-scroll"
            data-animation="fadeInUp"
            data-delay="120"
          >
            <div class="erg-access-rcard__header">
              <div class="erg-access-rcard__number">03</div>
              <div class="erg-access-rcard__text">
                <h3>Private tickets</h3>
                <p>
                  Keep a ticket off the public page and share it by direct link
                  only.
                </p>
              </div>
            </div>
            <div class="erg-access-rcard__visual erg-access-rcard__visual--product-shot">
              <div class="erg-access-product-shot erg-access-product-shot--private">
                <img
                  src="/feature-images/event-registration/private-ticket-settings.png"
                  alt="EventHex private ticket management screen"
                  loading="lazy"
                />
                <span class="erg-access-product-shot__status">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 9V7a3.5 3.5 0 0 1 7 0v2M5 9h10v8H5z"></path></svg>
                  Link-only access
                </span>
