  .erg-eco__card:hover {
    transform: translateY(-4px);
    border-color: rgba(55, 93, 251, 0.18);
    box-shadow:
      0 28px 86px rgba(10, 28, 64, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.96);
  }
  .erg-eco__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue);
    background: rgba(55, 93, 251, 0.08);
    box-shadow: inset 0 0 0 1px rgba(55, 93, 251, 0.1);
  }
  .erg-eco__card:nth-child(1) .erg-eco__icon {
    color: #f97316;
    background: rgba(249, 115, 22, 0.13) !important;
    box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.16);
  }
  .erg-eco__card:nth-child(2) .erg-eco__icon {
    color: #16a34a;
    background: rgba(22, 163, 74, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.16);
  }
  .erg-eco__card:nth-child(3) .erg-eco__icon {
    color: #375dfb;
    background: rgba(55, 93, 251, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(55, 93, 251, 0.16);
  }
  .erg-eco__card:nth-child(4) .erg-eco__icon {
    color: #7c3aed;
    background: rgba(124, 58, 237, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, 0.16);
  }
  .erg-eco__card:nth-child(5) .erg-eco__icon {
    color: #0ea5e9;
    background: rgba(14, 165, 233, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.16);
  }
  .erg-eco__card:nth-child(6) .erg-eco__icon {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.14) !important;
    box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.18);
  }
  .erg-eco__card:nth-child(7) .erg-eco__icon {
    color: #ec4899;
    background: rgba(236, 72, 153, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(236, 72, 153, 0.16);
  }
  .erg-eco__card:nth-child(8) .erg-eco__icon {
    color: #14b8a6;
    background: rgba(20, 184, 166, 0.12) !important;
    box-shadow: inset 0 0 0 1px rgba(20, 184, 166, 0.16);
  }
  .erg-eco__icon svg {
    width: 21px;
    height: 21px;
  }
  .erg-eco__icon {
    position: relative;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 15px;
    color: #fff !important;
    transform: rotate(-4deg);
    box-shadow:
      0 12px 22px rgba(38, 57, 105, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      inset 0 -8px 15px rgba(12, 25, 58, 0.12) !important;
    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.28s ease;
  }
  .erg-eco__icon::after {
    content: "";
    position: absolute;
    width: 34px;
    height: 22px;
    top: -8px;
    left: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    filter: blur(5px);
    pointer-events: none;
  }
  .erg-eco__icon svg {
    position: relative;
    z-index: 1;
    width: 23px;
    height: 23px;
    stroke: #fff;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.12));
  }
  .erg-eco__card:nth-child(even) .erg-eco__icon {
    transform: rotate(4deg);
  }
  .erg-eco__card:hover .erg-eco__icon {
    transform: translateY(-3px) rotate(0deg) scale(1.06);
    box-shadow:
      0 17px 28px rgba(38, 57, 105, 0.23),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -8px 15px rgba(12, 25, 58, 0.1) !important;
  }
  .erg-eco__card:nth-child(1) .erg-eco__icon {
    background: linear-gradient(145deg, #ff9b42, #f25c2a) !important;
  }
  .erg-eco__card:nth-child(2) .erg-eco__icon {
    background: linear-gradient(145deg, #4ed99b, #0ea765) !important;
  }
  .erg-eco__card:nth-child(3) .erg-eco__icon {
    background: linear-gradient(145deg, #6fa8ff, #375dfb) !important;
  }
  .erg-eco__card:nth-child(4) .erg-eco__icon {
    background: linear-gradient(145deg, #a878ff, #7137e8) !important;
  }
  .erg-eco__card:nth-child(5) .erg-eco__icon {
    background: linear-gradient(145deg, #50d7f4, #129bda) !important;
  }
  .erg-eco__card:nth-child(6) .erg-eco__icon {
    background: linear-gradient(145deg, #ffc94d, #ef8f16) !important;
  }
  .erg-eco__card:nth-child(7) .erg-eco__icon {
    background: linear-gradient(145deg, #ff7fbd, #e93686) !important;
  }
  .erg-eco__card:nth-child(8) .erg-eco__icon {
    background: linear-gradient(145deg, #45ded5, #0ca6a0) !important;
  }
  .erg-platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(88px, 10vw, 132px);
  }
  .erg-platform__heading {
    order: 1;
    padding-top: 0;
    padding-bottom: 0;
  }
  .erg-platform__heading .erg-heading__title {
    max-width: 760px;
    margin-inline: auto;
  }
  .erg-eco {
    order: 2;
    width: 100%;
    max-width: 980px;
    padding-top: clamp(28px, 4vw, 46px);
  }
  .erg-eco__grid {
    position: relative;
    isolation: isolate;
    min-height: 178px;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    padding: 14px 24px 48px;
    perspective: 900px;
  }
  .erg-eco__grid::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 5px;
    width: 720px;
    height: 154px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 93, 251, 0.09),
      transparent 67%
    );
    transform: translateX(-50%);
    pointer-events: none;
  }
  .erg-eco__card,
  .erg-eco__card:nth-child(n) {
    position: relative;
    flex: 0 0 70px;
    width: 90px;
    min-height: 90px;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 20px;
    background: transparent;
    box-shadow: none;
    transform-origin: 50% 130%;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      z-index 0s;
  }
  .erg-eco__card-text {
    position: absolute;
    left: 50%;
    top: calc(100% + 14px);
    bottom: auto;
    z-index: 30;
    width: max-content;
    max-width: 180px;
    padding: 10px 14px;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 18px 42px rgba(31, 49, 92, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -5px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    text-align: left;
    pointer-events: none;
  }
  .erg-eco__card-desc {
    display: none;
  }
  .erg-eco__card-title {
    margin: 0;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .erg-eco__card-text::after {
    display: none;
    content: "Explore →";
    display: block;
    margin-top: 9px;
    color: var(--brand-blue);
    font: 700 0.7rem/1 var(--font-body);
  }
  .erg-eco__card:hover .erg-eco__card-text,
  .erg-eco__card:focus-visible .erg-eco__card-text,
  .erg-eco__card.is-active .erg-eco__card-text {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .erg-eco__icon {
    width: 90px;
    height: 90px;
    margin: 0;
    border-radius: 22px;
    transform: none !important;
    box-shadow:
      0 18px 30px rgba(38, 57, 105, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -12px 18px rgba(12, 25, 58, 0.13) !important;
  }
  .erg-eco__icon svg {
    width: 34px;
    height: 34px;
  }
  .erg-platform .erg-eco__card:nth-child(1) {
    --arc-y: 54px;
    --arc-r: -15deg;
    --pop-delay: 280ms;
  }
  .erg-platform .erg-eco__card:nth-child(2) {
    --arc-y: 29px;
    --arc-r: -10deg;
    --pop-delay: 180ms;
  }
  .erg-platform .erg-eco__card:nth-child(3) {
    --arc-y: 11px;
    --arc-r: -6deg;
    --pop-delay: 80ms;
  }
  .erg-platform .erg-eco__card:nth-child(4) {
    --arc-y: 0px;
    --arc-r: -2deg;
    --pop-delay: 0ms;
  }
  .erg-platform .erg-eco__card:nth-child(5) {
    --arc-y: 0px;
    --arc-r: 2deg;
    --pop-delay: 40ms;
  }
  .erg-platform .erg-eco__card:nth-child(6) {
    --arc-y: 11px;
    --arc-r: 6deg;
    --pop-delay: 120ms;
  }
  .erg-platform .erg-eco__card:nth-child(7) {
    --arc-y: 29px;
    --arc-r: 10deg;
    --pop-delay: 220ms;
  }
  .erg-platform .erg-eco__card:nth-child(8) {
    --arc-y: 54px;
    --arc-r: 15deg;
    --pop-delay: 320ms;
  }
  .erg-platform .erg-eco__card {
    opacity: 0;
    transform: translateY(calc(var(--arc-y) + 42px)) rotate(var(--arc-r))
      scale(0.72) !important;
  }
  .erg-platform .erg-eco__grid.is-revealed .erg-eco__card {
    opacity: 1;
    transform: translateY(var(--arc-y)) rotate(var(--arc-r)) scale(1) !important;
    transition:
      opacity 0.5s ease var(--pop-delay),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--pop-delay),
      z-index 0s;
  }
  .erg-platform .erg-eco__card:hover,
  .erg-platform .erg-eco__card:focus-visible,
  .erg-platform .erg-eco__card.is-active {
    z-index: 25;
    transform: translateY(-8px) rotate(0deg) scale(1.1) !important;
    transition-delay: 0s;
  }
  .erg-eco__card-text {
    min-width: 0;
  }
  .erg-platform__heading .erg-heading__eyebrow {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin-bottom: 14px;
    padding: 7px 16px 7px 34px;
    border: 1px solid #eef0f3;
    border-radius: 999px;
    background: #fff;
    color: #14151a;
    box-shadow: 0 5px 18px rgba(25, 40, 78, 0.045);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
  }
  .erg-platform__heading .erg-heading__eyebrow::before {
    content: "✦";
    position: absolute;
    left: 13px;
    top: 50%;
    color: #4f8cff;
    font-size: 14px;
    transform: translateY(-50%);
    animation: erg-brand-star 2s ease-in-out infinite;
  }
  .erg-platform__heading .erg-heading__eyebrow::after {
    content: "";
    position: absolute;
    inset: -1.5px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--erg-brand-angle),
      transparent 0 270deg,
      #4f8cff 315deg,
      #b08bff 340deg,
      #4f8cff 355deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: erg-brand-spin 3s linear infinite;
  }
  .erg-eco__card-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--heading-dark);
    margin: 0 0 0.3rem;
    letter-spacing: -0.02em;
  }
  .erg-eco__card-desc {
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--subheading-gray);
    margin: 0;
  }
  @media (max-width: 1024px) {
    .erg-eco__grid {
      gap: 1rem;
    }
  }
  @media (max-width: 767px) {
    .erg-platform {
      padding: 64px 16px 72px;
    }
    .erg-platform__heading {
      padding-left: 0;
      padding-right: 0;
    }
    .erg-eco {
      overflow: hidden;
    }
    .erg-eco__grid {
      min-height: 126px;
      gap: 2px;
      padding-inline: 0;
      transform: scale(0.78);
      transform-origin: top center;
      width: 760px;
      margin-left: calc((100% - 760px) / 2);
    }
    .erg-eco__card,
    .erg-eco__card:nth-child(n) {
      flex-basis: 76px;
      width: 76px;
      min-height: 76px;
      padding: 0;
      border-radius: 18px;
    }
    .erg-eco__icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
    }
    .erg-platform__heading {
      padding-top: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .erg-platform .erg-eco__card,
    .erg-platform .erg-eco__grid.is-revealed .erg-eco__card {
      opacity: 1;
      transform: translateY(var(--arc-y)) rotate(var(--arc-r));
      transition: none;
    }
  }

  /* ===== FAQ ===== */
  .erg-faq {
    width: 100%;
    padding: 80px 24px;
    background: #fff;
  }
  .erg-faq__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 64px;
    align-items: start;
  }
  .erg-faq__sidebar {
    position: sticky;
    top: 6rem;
  }
  .erg-faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid #e4e7ec;
    border-radius: 999px;
    margin-bottom: 20px;
    color: #000;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .erg-faq__heading {
    font-family: 'Creato Display', var(--font-heading);
    font-size: 44px;
    font-weight: 500;
    color: #000;
    margin: 0 0 20px;
    line-height: 1.1;
    letter-spacing: -1px;
  }
  .erg-faq__intro {
    margin: 0 0 28px;
    color: var(--body-light);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
  }
  .erg-faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #171a21;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .erg-faq__cta:hover {
    background: #000;
    transform: translateY(-1px);
  }
  .erg-faq__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    counter-reset: registration-faq;
  }
  .erg-faq__item {
    counter-increment: registration-faq;
    padding: 4px 28px;
    overflow: hidden;
    border: 1px solid #e4e7ec;
    border-radius: 20px;
    background: #fff;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .erg-faq__item[open] {
    border-color: #e4e7ec;
    background: #e4e7ec;
  }
  .erg-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    font-family: 'Creato Display', var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 500;
    color: #000;
    cursor: pointer;
    list-style: none;
  }
  .erg-faq__question strong {
    font-weight: 500;
  }
  .erg-faq__question strong::before {
    content: counter(registration-faq) '. ';
  }
  .erg-faq__question::-webkit-details-marker {
    display: none;
  }
  .erg-faq__chevron {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
  .erg-faq__chevron path {
    display: none;
  }
  .erg-faq__chevron::before,
  .erg-faq__chevron::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 2px;
    margin: 8px 0 0 2px;
    background: #000;
  }
  .erg-faq__chevron::after {
    transform: rotate(90deg);
    transition: opacity 0.2s ease;
  }
  .erg-faq__item[open] .erg-faq__chevron::after {
    opacity: 0;
  }
  .erg-faq__answer {
    max-width: 640px;
    padding: 0 0 24px;
  }
  .erg-faq__answer p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #000;
    margin: 0;
  }
  @media (max-width: 1024px) {
    .erg-faq__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .erg-faq__sidebar {
      position: static;
    }
    .erg-faq__heading {
      font-size: 32px;
    }
  }
  @media (max-width: 767px) {
    .erg-faq {
      padding: 56px 16px;
    }
    .erg-faq__heading {
      font-size: 28px;
    }
    .erg-faq__item {
      padding: 4px 20px;
      border-radius: 16px;
    }
    .erg-faq__question {
      font-size: 0.9375rem;
      padding: 18px 0;
    }
  }

  .footer-cta-banner {
    background:
      linear-gradient(
        115deg,
        rgba(5, 6, 12, 0.86) 0% 22%,
        rgba(26, 20, 80, 0.62) 42%,
        rgba(55, 93, 251, 0.35) 68%,
        rgba(79, 214, 224, 0.28)
      ),
      url("/brand/footer-mask.png") center center / cover no-repeat !important;
  }
  /* ===== ATTENDEE DATA TEMPLATE STYLE ===== */
  .erg-template-section {
    padding: 120px 24px;
    background: #fff;
  }
  .erg-template-shell {
    max-width: 1200px;
    margin: 0 auto;
  }
  .erg-template-heading {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 64px;
  }
  .erg-template-eyebrow {
    color: #6a40fa;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .erg-template-title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #222 0%, #333 40%, #888 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .erg-template-subtitle {
    font-family: var(--font-body);
    font-size: 20px;
    color: #6b7280;
    line-height: 1.5;
  }
  .erg-template-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .erg-template-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .erg-template-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    background: #f8f7ff;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6a40fa;
  }
  .erg-template-content h3 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
  }
  .erg-template-content p {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: #6b7280;
  }

  @media (max-width: 992px) {
    .erg-template-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* ===== SCROLLYTELLING COMBINED SECTION ===== */
  .erg-scrolly-section {
    padding: 120px 24px;
    background: #fff;
  }
  .erg-scrolly-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: flex-start;
  }
  .erg-scrolly-text {
    flex: 0 0 45%;
    padding-bottom: 50vh;
  }
  .erg-scrolly-block {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.3;
    transition: opacity 0.5s ease;
  }
  .erg-scrolly-block.is-active {
    opacity: 1;
  }
  .erg-scrolly-block h2 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 700;
    color: var(--heading-dark);
    margin-bottom: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .erg-scrolly-block p {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--subheading-gray);
    margin-bottom: 16px;
  }
  .erg-scrolly-block p a {
    color: #0055ff;
    text-decoration: underline;
  }
  .erg-scrolly-visual {
    flex: 1;
    position: sticky;
    top: 120px;
    height: calc(100vh - 240px);
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .erg-scrolly-sticky {
    position: relative;
    width: 100%;
    height: 100%;
    background: #f4f5f7;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
  }
  .erg-scrolly-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0.6s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  .erg-scrolly-img.is-active {
    opacity: 1;
    visibility: visible;
  }
  .erg-scrolly-img img,
  .erg-scrolly-img .erg-message-card,
  .erg-scrolly-img .erg-embed-window {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media (max-width: 992px) {
    .erg-scrolly-container {
      flex-direction: column-reverse;
      gap: 40px;
    }
    .erg-scrolly-text {
      flex: none;
      width: 100%;
      padding-bottom: 40vh;
    }
    .erg-scrolly-visual {
      flex: none;
      width: 100%;
      height: 350px;
      min-height: auto;
      top: 80px;
      z-index: 10;
    }
    .erg-scrolly-sticky {
      border-radius: 20px;
    }
    .erg-scrolly-block {
      min-height: 60vh;
    }
  }

  /* ===== PAGE CTA (LIKE FOOTER) ===== */
  .erg-page-cta-wrapper {
    max-width: 1280px;
    margin: 80px auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }
