    );
    pointer-events: none;
  }
  .erg-cta__mockup {
    position: absolute;
    right: -40px;
    bottom: -40px;
    width: 110%;
    max-width: none;
    object-fit: contain;
    border-radius: 20px 0 0 0;
    box-shadow: -10px -10px 40px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 992px) {
    .erg-cta__card {
      flex-direction: column;
    }
    .erg-cta__left {
      padding: 60px 30px 40px;
    }
    .erg-cta__right {
      width: 100%;
      min-height: 350px;
    }
    .erg-cta__mockup {
      width: 120%;
      right: -10%;
      bottom: -20px;
      border-radius: 20px 20px 0 0;
    }
  }
  @property --erg-brand-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  .erg-cta__brand {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    margin: 0 0 24px;
    padding: 7px 16px 7px 34px;
    border: 1px solid #eef0f3;
    border-radius: 999px;
    background: #fff;
    color: #14151a;
    box-shadow: 0 5px 18px rgba(25, 40, 78, 0.045);
    font-size: 15px;
    font-weight: 500;
  }
  .erg-cta__brand::before {
    content: "✦";
    position: absolute;
    left: 13px;
    top: 50%;
    color: #4f8cff;
    font-size: 14px;
    transform: translateY(-50%);
    transform-origin: center;
    animation: erg-brand-star 2s ease-in-out infinite;
  }
  .erg-cta__brand::after {
    content: "";
    position: absolute;
    inset: -1.5px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--erg-brand-angle),
      transparent 0deg,
      transparent 270deg,
      #4f8cff 315deg,
      #b08bff 340deg,
      #4f8cff 355deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: erg-brand-spin 3s linear infinite;
  }
  .erg-heading__eyebrow,
  .erg-faq__eyebrow {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin-bottom: 14px;
    padding: 7px 16px 7px 34px;
    border: 1px solid #eef0f3;
    border-radius: 999px;
    background: #fff;
    color: #14151a;
    box-shadow: 0 5px 18px rgba(25, 40, 78, 0.045);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }
  .erg-heading__eyebrow::before,
  .erg-faq__eyebrow::before {
    content: "✦";
    position: absolute;
    left: 13px;
    top: 50%;
    color: #4f8cff;
    font-size: 14px;
    transform: translateY(-50%);
    transform-origin: center;
    animation: erg-brand-star 2s ease-in-out infinite;
  }
  .erg-heading__eyebrow::after,
  .erg-faq__eyebrow::after {
    content: "";
    position: absolute;
    inset: -1.5px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--erg-brand-angle),
      transparent 0deg,
      transparent 270deg,
      #4f8cff 315deg,
      #b08bff 340deg,
      #4f8cff 355deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: erg-brand-spin 3s linear infinite;
  }
  @keyframes erg-brand-spin {
    to {
      --erg-brand-angle: 360deg;
    }
  }
  @keyframes erg-brand-star {
    0%,
    100% {
      transform: translateY(-50%) scale(1) rotate(0);
    }
    50% {
      transform: translateY(-50%) scale(1.22) rotate(10deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .erg-cta__brand::before,
    .erg-cta__brand::after,
    .erg-heading__eyebrow::before,
    .erg-heading__eyebrow::after,
    .erg-faq__eyebrow::before,
    .erg-faq__eyebrow::after {
      animation: none;
    }
  }

