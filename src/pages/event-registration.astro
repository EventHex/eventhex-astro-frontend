  .erx-shot { border-radius: 14px; overflow: hidden; border: 1px solid #eef0f3; background: #fff; }
  .erx-shot img, .erx-shot video { display: block; width: 100%; height: auto; }
  .erx-shot--lift { box-shadow: 0 12px 28px rgba(16, 24, 40, .08); }
  .erx-shot--float { box-shadow: 0 30px 60px rgba(16, 24, 40, .2); border-color: var(--erx-line); }
  .erx-shot--crop { height: 300px; }
  .erx-shot--crop img { height: 100%; object-fit: cover; object-position: var(--pos, 50% 0%); }
  .erx-shot--h175 { height: 175px; }
  .erx-shot--h230 { height: 230px; }
  .erx-shot--h260 { height: 260px; }
  .erx-shot--h300 { height: 300px; }
  .erx-card > .erx-shot, .erx-acard > .erx-shot, .erx-bcard > .erx-shot { margin-top: auto; }

  .erx-fgrid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px; }
  .erx-fgrid > .erx-card { grid-column: span 2; padding: 28px; gap: 14px; }
  .erx-fgrid > .erx-card.erx-fgrid__wide { grid-column: span 4; }
  .erx-fgrid > .erx-card:nth-child(2) > .erx-shot { margin-top: 0; }

  .erx-titlerow { display: flex; align-items: center; gap: 12px; }
  .erx-icon { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: #eef2ff; color: var(--erx-accent); }
  .erx-icon--li { background: #0a66c2; color: #fff; font-weight: 800; font-size: 18px; font-family: Inter, system-ui, sans-serif; }
  .erx-card > .erx-shot.erx-shot--top { margin-top: 0; }
  .erx-split { margin-top: auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: center; }
  .erx-split b { color: var(--erx-ink); font-weight: 600; }

  .erx-darkcta { max-width: 1200px; margin: 0 auto clamp(64px, 8vw, 112px); padding: 56px 24px; border-radius: 28px; background: radial-gradient(80% 120% at 50% 100%, #2a2f6b 0%, #0b1020 70%); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .erx-darkcta__title { margin: 0; max-width: 680px; font-family: var(--font-heading); font-weight: 500; font-size: clamp(28px, 3vw, 40px); line-height: 1.15; letter-spacing: -0.03em; color: #fff; }

  /* panels (soft background) */
  .erx-panel { max-width: 1360px; margin: 0 auto clamp(64px, 8vw, 112px); padding: clamp(40px, 7vw, 96px) clamp(20px, 6vw, 80px); border-radius: 32px; background: var(--erx-soft); display: flex; flex-direction: column; gap: 40px; box-sizing: border-box; }
  .erx-panel__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .erx-head--left { max-width: 760px; }
  .erx-access { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .erx-acard { background: #fff; border: 1px solid var(--erx-line); border-radius: 22px; padding: 26px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .erx-acard__n { font-size: 14px; font-weight: 700; color: var(--erx-accent); }
  .erx-acard .erx-shot { margin-top: auto; }
  .erx-acard .erx-text a { color: var(--erx-accent); }

  .erx-collect { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; align-items: center; padding-top: 0; }
  .erx-collect__copy { display: flex; flex-direction: column; gap: 22px; }
  .erx-collect__item { padding: 4px 0 4px 21px; border-left: 3px solid transparent; }
  .erx-collect__item.is-active { border-left-color: var(--erx-accent); padding-left: 18px; }
  .erx-collect__item h3 { margin: 0; font-family: Inter, system-ui, sans-serif; font-size: 18px; font-weight: 600; color: var(--erx-ink); }
  .erx-collect__item p { margin: 6px 0 0; font-size: 16px; line-height: 1.5; color: var(--erx-muted); }

  /* bridge to /event-ticketing/ */
  .erx-bridge { max-width: 1200px; margin: 0 auto clamp(64px, 8vw, 112px); padding: 48px; border-radius: 28px; background: linear-gradient(120deg, #0b1020 0%, #1b2550 100%); color: #fff; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: 48px; align-items: center; overflow: hidden; box-sizing: border-box; }
  .erx-bridge__copy { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .erx-bridge__eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #a9b1c6; }
  .erx-bridge__title { margin: 0; font-family: var(--font-heading); font-weight: 500; font-size: clamp(28px, 2.9vw, 40px); line-height: 1.12; letter-spacing: -0.035em; color: #fff; }
  .erx-bridge p { margin: 0; font-size: 17px; line-height: 1.55; color: #cbd5e1; }
  .erx-bridge__related { width: 100%; display: flex; flex-wrap: wrap; gap: 8px 20px; padding-top: 16px; margin-top: 4px; border-top: 1px solid rgba(255, 255, 255, .12); font-size: 14px; color: #a9b1c6; }
  .erx-bridge__related a { color: #fff; text-decoration: none; }
  .erx-bridge__related a:hover { text-decoration: underline; }
  .erx-bridge__visual img { display: block; width: 100%; height: 300px; object-fit: cover; object-position: 100% 0%; border-radius: 16px; border: 1px solid rgba(255, 255, 255, .15); box-shadow: 0 30px 60px rgba(0, 0, 0, .45); transform: rotate(2deg); }

  /* bento */
  .erx-bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .erx-bcard { border: 1px solid var(--erx-line); border-radius: 26px; padding: 32px; display: flex; flex-direction: column; gap: 14px; background: #fff; min-width: 0; }
  .erx-bcard--dark { background: #0b1020; border-color: #0b1020; }
  .erx-bcard--dark .erx-h3 { color: #fff; }
  .erx-bcard--dark .erx-text { color: #cbd5e1; }
  .erx-bcard--dark .erx-text--sm { color: #a9b1c6; }
  .erx-bcard--dark .erx-tag { color: #a9b1c6; }
  .erx-tag { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #667085; }
  .erx-tickets { margin-top: auto; padding-top: 18px; display: flex; justify-content: center; align-items: flex-end; gap: 14px; }
  .erx-tickets img { width: 30%; max-width: 160px; height: auto; border-radius: 12px; box-shadow: 0 16px 32px rgba(0, 0, 0, .4); }
  .erx-tickets img:nth-child(1) { transform: rotate(-5deg) translateY(6px); }
  .erx-tickets img:nth-child(2) { width: 34%; max-width: 176px; }
  .erx-tickets img:nth-child(3) { transform: rotate(5deg) translateY(6px); }

  /* after sign-up list */
  .erx-list { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 56px; align-items: center; }
  .erx-list__copy { display: flex; flex-direction: column; gap: 20px; }
  .erx-list__points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5; color: #475467; }
  .erx-list__points b { color: var(--erx-ink); font-weight: 600; }
  .erx-list__visual { position: relative; min-height: 600px; }
  .erx-list__main { position: absolute; left: 0; top: 0; width: 80%; }
  .erx-list__detail { position: absolute; right: 0; top: 37%; width: 36%; }
  .erx-list__export { position: absolute; left: 4%; bottom: 0; width: 34%; }

  /* the page-level rule clears section backgrounds; these sections own theirs */
  .erg-registration-page-bg > section.erx-panel { background: var(--erx-soft) !important; }
  .erg-registration-page-bg > section.erx-bridge { background: linear-gradient(120deg, #0b1020 0%, #1b2550 100%) !important; }

  @media (max-width: 1024px) {
    .erx-hero__grid, .erx-collect, .erx-list, .erx-bridge { grid-template-columns: minmax(0, 1fr); }
    .erx-fgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .erx-fgrid > .erx-card, .erx-fgrid > .erx-card.erx-fgrid__wide { grid-column: span 1; }
    .erx-fgrid > .erx-card.erx-fgrid__wide { grid-column: span 2; }
    .erx-list__visual { min-height: 0; display: flex; flex-direction: column; gap: 16px; }
    .erx-list__main, .erx-list__detail, .erx-list__export { position: static; width: 100%; }
    .erx-list__detail { max-width: 420px; }
    .erx-list__export { display: none; }
  }
  @media (max-width: 767px) {
    .erx-modes, .erx-access, .erx-bento, .erx-fgrid { grid-template-columns: minmax(0, 1fr); }
    .erx-fgrid > .erx-card.erx-fgrid__wide { grid-column: span 1; }
    .erx-trust { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .erx-panel { border-radius: 24px; margin-left: 12px; margin-right: 12px; }
    .erx-panel__head { flex-direction: column; align-items: flex-start; }
    .erx-card, .erx-bcard { padding: 20px; border-radius: 18px; }
    .erx-darkcta, .erx-bridge { margin-left: 12px; margin-right: 12px; padding: 28px 20px; border-radius: 24px; }
    .erx-bridge__visual { display: none; }
    .erx-split { grid-template-columns: minmax(0, 1fr); }
    .erx-steps { flex-wrap: wrap; }
  }

