---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "EventHex vs Competitors — Platform Comparisons | EventHex";
const description = "Compare EventHex with Cvent, Bizzabo, Whova, and other event management platforms. See features, pricing models, and why teams switch to EventHex.";

const comparisons = [
  {
    slug: "eventhex-vs-cvent",
    competitor: "Cvent",
    tagline: "Enterprise power without the enterprise price tag.",
    highlights: ["0% platform fee", "Face-match check-in", "WhatsApp automation"],
  },
  {
    slug: "eventhex-vs-bizzabo",
    competitor: "Bizzabo",
    tagline: "All-in-one AI platform vs. a marketing-first suite.",
    highlights: ["AI photo gallery", "Virtual & hybrid", "GCC/India payments"],
  },
  {
    slug: "eventhex-vs-whova",
    competitor: "Whova",
    tagline: "Mobile-first networking without the trade-offs.",
    highlights: ["White-label app", "On-site face check-in", "Own payment gateway"],
  },
  {
    slug: "eventhex-vs-eventbrite",
    competitor: "Eventbrite",
    tagline: "Full event management vs. consumer ticketing.",
    highlights: ["0% platform fee", "Session management", "WhatsApp automation"],
  },
  {
    slug: "eventhex-vs-hopin",
    competitor: "Hopin",
    tagline: "AI-powered all-in-one vs. virtual-first networking.",
    highlights: ["Face-match check-in", "AI Copilot", "GCC/India payments"],
  },
  {
    slug: "eventhex-vs-splash",
    competitor: "Splash",
    tagline: "Full event ops vs. event marketing pages.",
    highlights: ["On-site face check-in", "Virtual & hybrid", "WhatsApp automation"],
  },
  {
    slug: "eventhex-vs-airmeet",
    competitor: "Airmeet",
    tagline: "In-person + virtual platform vs. webinar-focused.",
    highlights: ["Face-match check-in", "AI Smart Connect", "Own payment gateway"],
  },
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/compare/"
  footerCtaTitle="Ready to see EventHex in action?"
  footerCtaButtonText="Book a demo"
  footerCtaHref="/book-a-demo/"
>
  <section class="compare-hero ds-stage">
    <div class="container hero-panel ds-glass">
      <p class="eyebrow ds-eyebrow">Platform Comparisons</p>
      <h1 class="ds-h1">How EventHex <span class="ds-hl">Stacks Up</span></h1>
      <p class="intro">
        Choosing the right event platform is a long-term decision. We've put together
        honest, feature-by-feature comparisons so you can evaluate EventHex alongside
        the most popular alternatives.
      </p>
    </div>
  </section>

  <section class="compare-grid">
    <div class="container">
      <div class="cards">
        {comparisons.map((c) => (
          <a href={`/compare/${c.slug}/`} class="card">
            <div class="card-header">
              <span class="vs-badge">EventHex vs</span>
              <h2 class="competitor-name ds-h3 ds-h3--sm">{c.competitor}</h2>
            </div>
            <p class="card-tagline">{c.tagline}</p>
            <ul class="card-highlights">
              {c.highlights.map((h) => (
                <li>
                  <span class="check">✓</span> {h}
                </li>
              ))}
            </ul>
            <span class="card-cta">Compare now →</span>
          </a>
        ))}

        <a href="/compare/best-event-management-software-2026/" class="card card-listicle">
          <div class="card-header">
            <span class="vs-badge">Ranked list</span>
            <h2 class="competitor-name ds-h3 ds-h3--sm">Best Event Management Software 2026</h2>
          </div>
          <p class="card-tagline">
            An honest look at the top platforms — who they're for, what they do well,
            and where EventHex fits.
          </p>
          <ul class="card-highlights">
            <li><span class="check">✓</span> 8–10 platforms reviewed</li>
            <li><span class="check">✓</span> Honest pros per tool</li>
            <li><span class="check">✓</span> FAQ + schema markup</li>
          </ul>
          <span class="card-cta">Read the guide →</span>
        </a>

        <a href="/compare/best-conference-apps/" class="card card-listicle">
          <div class="card-header">
            <span class="vs-badge">Ranked list</span>
            <h2 class="competitor-name ds-h3 ds-h3--sm">Best Conference Apps 2026</h2>
          </div>
          <p class="card-tagline">
            Eight conference apps ranked honestly — AI check-in, WhatsApp automation,
            hybrid support, and regional payments compared.
          </p>
          <ul class="card-highlights">
            <li><span class="check">✓</span> 8 platforms reviewed</li>
            <li><span class="check">✓</span> In-person, virtual &amp; hybrid coverage</li>
            <li><span class="check">✓</span> FAQ + schema markup</li>
          </ul>
          <span class="card-cta">Read the guide →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="disclaimer-section">
    <div class="container">
      <p class="disclaimer">
        All comparisons are based on publicly available information as of 2026.
        Verify current details directly with each vendor.
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .compare-hero { padding: clamp(48px, 7vw, 96px) 24px; }
  .hero-panel { max-width: 860px; padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 56px); text-align: center; }
  .eyebrow { margin: 0 0 16px; }
  h1 { margin: 0 0 20px; }
  .intro { font-size: 1.125rem; color: var(--ds-body); max-width: 640px; margin: 0 auto; line-height: 1.7; }
  .compare-grid { padding: var(--ds-section-y) 24px; background: var(--ds-white); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .card {
    display: flex; flex-direction: column; gap: 16px; padding: 32px 28px;
    border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); background: var(--ds-white);
    box-shadow: var(--ds-shadow-shot); text-decoration: none; color: var(--ds-ink);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--ds-blue); box-shadow: var(--ds-shadow-hero); transform: translateY(-2px); }
  .card-header { display: flex; flex-direction: column; gap: 6px; }
  .vs-badge {
    font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--ds-blue); background: var(--ds-surface-tint); padding: 3px 10px; border-radius: 20px; width: fit-content;
  }
  .competitor-name { font-family: var(--ds-font-heading); font-size: 1.35rem; font-weight: 500; color: var(--ds-ink); margin: 0; }
  .card-tagline { font-size: 0.95rem; color: var(--ds-sub); line-height: 1.6; margin: 0; }
  .card-highlights { list-style: none; display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; }
  .card-highlights li { font-size: 0.9rem; color: var(--ds-body); display: flex; align-items: center; gap: 8px; }
  .check { color: var(--ds-success); font-weight: 700; flex-shrink: 0; }
  .card-cta { font-size: 0.9rem; font-weight: 500; color: var(--ds-blue); margin-top: auto; }
  .card-listicle { background: color-mix(in srgb, var(--ds-blue) 6%, white); border-color: color-mix(in srgb, var(--ds-blue) 25%, white); }
  .disclaimer-section { padding: 24px; text-align: center; }
  .disclaimer { font-size: 0.8rem; color: var(--ds-label); margin: 0; }
</style>
