---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SponsorManagementPage from "../components/sponsor-management/SponsorManagementPage.astro";

const title = "Event Sponsor Management Software | EventHex";
const description =
  "Organize sponsor and partner profiles, create ordered categories, and publish responsive sponsor sections on your EventHex event website.";

// Visible FAQ copy. The same array builds the FAQPage structured data, so the two stay identical.
const faqs: Array<[string, string]> = [
  [
    "What can I store in an EventHex sponsor profile?",
    "A sponsor or partner profile can include the brand name, logo, contact details, website, description, event relationship, and sponsor category.",
  ],
  [
    "Can I create Gold, Silver, or custom sponsor categories?",
    "Yes. Category names are custom, so you can use tiers or role-based groups. Add a description and order value, then assign sponsors to the appropriate category.",
  ],
  [
    "Where can sponsor logos appear?",
    "The current implementation supports sponsor sections and a dedicated sponsor directory in the EventHex event website. Automatic placement on badges, emails, signage, or every app surface is not included.",
  ],
  [
    "Can I control the website layout?",
    "Yes. The website renderer supports several sponsor-section layouts and treatments, including grouped tiers, logo collections, color or monochrome presentation, and responsive column choices.",
  ],
  [
    "Does EventHex sell sponsor packages online?",
    "Sponsor-package inventory, checkout, benefit automation, and sponsor self-service are not part of the current workflow described here.",
  ],
  [
    "Does EventHex generate sponsor ROI reports?",
    "Sponsor impression, click-through, comparison, and PDF ROI reports are not included in the current sponsor workflow.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Sponsor Management Software",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/sponsor-management/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Registration-backed sponsor and partner profiles",
    "Custom sponsor category names and descriptions",
    "Category order and sponsor presentation order",
    "Search, edit, reorder, and delete operations with activity records",
    "Live sponsor sections on the EventHex event website",
    "Tiered grid and single logo-collection website layouts",
    "Logo color or monochrome treatments with column and spacing controls",
    "Dedicated sponsor directory page for attendees",
    "Event Connect sponsor list and search",
    "LinkedIn company-profile lookup for sponsor drafts",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/sponsor-management/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/HP-Elite-Dragonfly-1.png"
  ogType="website"
  footerCtaEyebrow="Bring your sponsor structure"
  footerCtaTitle="See how your sponsor list becomes an event-ready directory"
  footerCtaSubtitle="In the demo, map real sponsor profiles into categories, order the groups, and preview the website section your attendees will see."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SponsorManagementPage {faqs} />
</MarketingLayout>
