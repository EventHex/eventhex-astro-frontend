---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/event-check-in/HeroSection.astro";
import ArrivalRail from "../components/event-check-in/ArrivalRail.astro";
import FlowQuadSection from "../components/event-check-in/FlowQuadSection.astro";
import DarkCapabilityBand from "../components/event-check-in/DarkCapabilityBand.astro";
import ScanFeedback from "../components/event-check-in/ScanFeedback.astro";
import OfflineResilience from "../components/event-check-in/OfflineResilience.astro";
import AttendanceVisibility from "../components/event-check-in/AttendanceVisibility.astro";
import InstanceFlowTabs from "../components/event-check-in/InstanceFlowTabs.astro";
import InstanceBento from "../components/event-check-in/InstanceBento.astro";
import ConnectedWorkflow from "../components/event-check-in/ConnectedWorkflow.astro";
import FaqSection from "../components/event-check-in/FaqSection.astro";

const title = "Event Check-In Software & App for QR Scanning | EventHex";
const description =
  "Run event check-in with the EventHex Scanner app on iOS or Android: validate attendee QR tickets at every door and desk, and watch live arrival counts as the venue fills.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Check-In",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, iOS, Android",
  url: "https://eventhex.ai/event-check-in/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "EventHex Scanner app for iOS and Android",
    "Attendee QR check-in",
    "Offline-resilient check-in with pending sync state",
    "Duplicate scan detection for event, ticket, or instance",
    "Ticket eligibility checks at scan time",
    "Named scanning instances for meals, sessions, and merchandise",
    "Live attendance counts with ticket and instance filters",
    "Event Day Portal attendee search and manual attendance",
  ],
};

const scannerAppOptions = [
  {
    title: "Download for iPhone and iPad",
    description:
      "Install EventHex Scanner from the Apple App Store, then open the event or assigned scanning point.",
    note: "Apple App Store",
  },
  {
    title: "Download for Android",
    description:
      "Install EventHex Scanner from Google Play, then use the same event-day role and scanning workflow.",
    note: "Google Play",
  },
];

// Real EventHex portal screens captured from the organizer account, one per store option.
const scannerAppComposites = [
  {
    primary: {
      src: "/feature-images/event-check-in/v5/cms-instance-checkin.webp",
      alt: "EventHex portal with the Download the Scanner app banner (App Store and Play Store) above the Lunch instance check-in screen, 9 of 20 checked in",
      width: 2880,
      height: 1650,
    },
  },
  {
    primary: {
      src: "/feature-images/event-check-in/v5/cms-instance-list.webp",
      alt: "CMS Instance list: Lunch (General, All Tickets), Impact Measurement Workshop (Session, Delegate) and Speaker Dinner (General, Speaker)",
      width: 2880,
      height: 1300,
    },
  },
];

const doorFlowCells = [
  {
    label: "Open the event",
    desc: "Choose the event and the intended scan mode.",
    visual: "picker" as const,
  },
  {
    label: "Scan the QR",
    desc: "Read the attendee ticket or badge code.",
    visual: "scan" as const,
  },
  {
    label: "Validate the record",
    desc: "Check registration and ticket eligibility for that scan.",
    visual: "checks" as const,
  },
  {
    label: "Confirm the result",
    desc: "Mark attendance or show the reason the scan needs attention.",
    visual: "result" as const,
  },
];

const eventDayOptions = [
  {
    title: "Mobile scanning",
    description:
      "Use the iOS or Android Scanner app for moving teams, entrances, and ticket-based scanning points.",
    note: "Best for handheld scanning",
  },
  {
    title: "Desk operations",
    description:
      "Use the Event Day Portal for attendee search, manual attendance, badge layout, and supported print paths.",
    note: "Best for registration desks",
  },
];

// Real EventHex screens: the door-side scanner banner and the desk-side attendance list.
const eventDayComposites = [
  {
    primary: {
      src: "/feature-images/event-check-in/v5/cms-instance-checkin.webp",
      alt: "Scanner app banner and instance check-in screen for Lunch, 9 of 20 checked in",
      width: 2880,
      height: 1650,
    },
  },
  {
    primary: {
      src: "/feature-images/event-check-in/v5/portal-attendance.webp",
      alt: "Event Day Portal attendance list with Check in buttons and Pending and Checked-In filters",
      width: 2880,
      height: 1500,
    },
  },
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/event-check-in/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/01/Instasnap.png"
  footerCtaEyebrow="Plan the door before event day"
  footerCtaTitle="Bring your entrance plan. See the check-in workflow around it."
  footerCtaSubtitle="Show us the ticket groups, scanning points, staffing plan, badge needs, and venue-network risks for one event. We'll map the mobile and desk workflow in a focused demo."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform on laptop, tablet, and mobile"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div class="ecx-page">
    <HeroSection />
    <ArrivalRail />

    <FlowQuadSection
      id="scanner-app"
      stage
      highlight="phones your team already carries"
      title="QR code event check-in on the phones your team already carries"
      subtitle="Install the EventHex Scanner app for the event-day team and sign in with the access assigned by the organizer."
      options={scannerAppOptions}
      composites={scannerAppComposites}
      note="Store availability, device compatibility, camera permissions, and cached event data should be checked before doors open."
    />

    <DarkCapabilityBand
      id="door-flow"
      eyebrow="Front-door check-in"
      title="Turn one QR scan into a"
      accent="clear staff decision"
      subtitle="Keep the screen focused on the action the person at the entrance needs to take."
      cells={doorFlowCells}
    />

    <ScanFeedback />
    <OfflineResilience />

    <AttendanceVisibility />

    <InstanceBento id="instances" />

    <InstanceFlowTabs id="instance-flow" />

    <FlowQuadSection
      id="event-day"
      highlight="the desk and the door"
      title="Event check-in software for the desk and the door"
      subtitle="The mobile Scanner and the browser-based Event Day Portal support different event-day stations around the same attendance data."
      options={eventDayOptions}
      composites={eventDayComposites}
      note="Badge-printing setup and printer compatibility are handled separately; this page keeps the handoff to the Event Day Portal clear."
    />

    <ConnectedWorkflow />
    <FaqSection />
  </div>
</MarketingLayout>

<style is:global>
  .ecx-page {
    overflow: clip;
    background: var(--ds-white);
  }
</style>
