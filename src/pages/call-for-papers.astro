---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageSections from "../components/call-for-papers/PageSections.astro";
import { faqs } from "../components/call-for-papers/content";

const title = "Call for Papers Software for Events | EventHex";
const description = "Collect abstracts, assign reviewers, score with rubrics, manage decisions and revisions, notify authors, and move accepted submissions into your event programme.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Call for Papers",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/call-for-papers/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Configurable abstract submission forms",
    "Reviewer assignment and scoped reviewer access",
    "Rubric scoring and reviewer comments",
    "Blind review settings",
    "Submission decisions and revision workflows",
    "Decision notifications",
    "Accepted-submission handoff to Session Management",
    "Submission CSV export",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/call-for-papers/"
  footerCtaEyebrow="Call for Papers"
  footerCtaTitle="Bring Your Submission and Review Workflow to the Demo"
  footerCtaSubtitle="See how EventHex connects structured submissions, reviewer workflows, decisions, and accepted sessions in one product walkthrough."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/call-for-papers/cta-visual.svg"
  footerCtaImageAlt="EventHex call for papers submission and review workspace"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageSections />
</MarketingLayout>
