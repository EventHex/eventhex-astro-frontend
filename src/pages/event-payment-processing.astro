---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/event-payment-processing/HeroSection.astro";
import StatsSection from "../components/event-payment-processing/StatsSection.astro";
import BentoGrid from "../components/event-payment-processing/BentoGrid.astro";
import FeatureCards from "../components/event-payment-processing/FeatureCards.astro";
import HowItWorksSection from "../components/event-payment-processing/HowItWorksSection.astro";
import CoordinationTools from "../components/event-payment-processing/CoordinationTools.astro";
import FaqSection from "../components/event-payment-processing/FaqSection.astro";
import CTASection from "../components/event-payment-processing/CTASection.astro";

const title = "Event Payment Processing for Ticket Sales | EventHex";
const description =
  "Connect event checkout to Stripe, Razorpay, or Tap, use your supported gateway account, track payment and refund state, and review event-level finance data.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Payment Processing",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/event-payment-processing/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
};
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/event-payment-processing/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
  showFooterCta={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div class="eppx-page">
    <HeroSection />
    <StatsSection />
    <BentoGrid />
    <FeatureCards />
    <HowItWorksSection />
    <CoordinationTools />
    <FaqSection />
    <CTASection />
  </div>
</MarketingLayout>

<style is:global>
  .eppx-page {
    overflow: clip;
    background: #fff;
  }

  /* Product-evidence framing, borrowed from the Event Registration bento rows:
     pastel tinted stage + a bordered screenshot with a soft lift. */
  .eppx-shot-stage {
    position: relative;
    width: 100%;
    padding: 30px 16px;
    border-radius: 22px;
    isolation: isolate;
    background: linear-gradient(180deg, #dbe1fb 0%, #eceffd 45%, #f5f6f9 100%);
  }

  .eppx-shot-stage--warm {
    background: linear-gradient(180deg, #fdefb8 0%, #fdf7dd 45%, #f5f6f9 100%);
  }

  .eppx-shot-stage--mint {
    background: linear-gradient(180deg, #cdf3de 0%, #e6f8ee 45%, #f5f6f9 100%);
  }

  .eppx-shot-stage--rose {
    background: linear-gradient(180deg, #fbdde4 0%, #fdecf0 45%, #f5f6f9 100%);
  }

  .eppx-shot-stage--violet {
    background: linear-gradient(180deg, #e2dbfb 0%, #efeafd 45%, #f5f6f9 100%);
  }

  .eppx-shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #dfe4ec;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 16px 36px rgba(30, 45, 88, 0.14);
  }

  .eppx-shot-float {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border: 1px solid rgba(206, 215, 232, 0.9);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    color: #111827;
    box-shadow: 0 14px 34px rgba(30, 45, 88, 0.2);
    font: 700 0.76rem/1.15 var(--font-body);
    white-space: nowrap;
    backdrop-filter: blur(10px);
  }

  .eppx-shot-float small {
    display: block;
    color: #7b8497;
    font: 400 0.64rem/1.2 var(--font-body);
  }

  .eppx-shot-float--tr {
    top: 14px;
    right: 10px;
  }

  .eppx-shot-float--bl {
    bottom: 14px;
    left: 10px;
  }

  @media (max-width: 767px) {
    .eppx-shot-stage {
      padding: 18px 10px;
    }

    .eppx-shot-float {
      padding: 8px 10px;
      font-size: 0.68rem;
    }
  }
</style>
