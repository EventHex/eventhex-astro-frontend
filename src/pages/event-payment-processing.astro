---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/event-payment-processing/HeroSection.astro";
import StatsSection from "../components/event-payment-processing/StatsSection.astro";
import BentoGrid from "../components/event-payment-processing/BentoGrid.astro";
import FeatureCards from "../components/event-payment-processing/FeatureCards.astro";
import HowItWorksSection from "../components/event-payment-processing/HowItWorksSection.astro";
import CoordinationTools from "../components/event-payment-processing/CoordinationTools.astro";
import OrdersPaymentSection from "../components/event-payment-processing/OrdersPaymentSection.astro";
import FaqSection from "../components/event-payment-processing/FaqSection.astro";

const title = "Event Payment Processing for Ticket Sales | EventHex";
const description =
  "Connect event checkout to Stripe, Razorpay, or Tap, use your supported gateway account, track payment and refund state, and review event-level finance data.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Payment Processing",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/event-payment-processing/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
};
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/event-payment-processing/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
  footerCtaEyebrow="Map your event payment setup"
  footerCtaTitle="Bring your gateway and finance workflow to the demo"
  footerCtaSubtitle="Show us the market, currency, ticket flow, supported provider account, refund process, and reporting needs for one event. We’ll walk through the matching EventHex path and call out anything that requires separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/event-payment-processing/v5/finance.webp"
  footerCtaImageAlt="EventHex event Finance view with gross collected, refunded, fees and charges, net payout, applied gateway rates, and breakdown by gateway"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div class="eppx-page">
    <HeroSection />
    <StatsSection />
    <BentoGrid />
    <FeatureCards />
    <HowItWorksSection />
    <OrdersPaymentSection />
    <CoordinationTools />
    <FaqSection />
  </div>
</MarketingLayout>

<script>
  // Play the demo loop only while it is on screen; keep it paused for reduced motion.
  const eppxLoops = Array.from(document.querySelectorAll<HTMLVideoElement>('.eppx-loop'));
  const eppxReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (eppxReduced) {
    eppxLoops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const eppxObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    eppxLoops.forEach((video) => eppxObserver.observe(video));
  }
</script>

<style is:global>
  .eppx-page { overflow: clip; background: var(--ds-white); }

  /* Screenshot framing: flat border + soft shadow (design system .ds-shot look). */
  .eppx-shot-stage {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    padding: 20px 16px;
    box-sizing: border-box;
    border-radius: var(--ds-r-lg);
    isolation: isolate;
    background: var(--ds-surface-stage);
  }

  .eppx-shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--ds-line-strong);
    border-radius: var(--ds-r-md);
    background: var(--ds-white);
    box-shadow: var(--ds-shadow-shot);
  }

  /* Captions that used to float over screenshots now sit under them, same words. */
  .eppx-shot-float {
    position: static;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 6px 12px;
    border: 1px solid var(--ds-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ds-white) 70%, transparent);
    color: var(--ds-sub);
    font: 500 0.78rem/1.2 var(--ds-font-body);
    white-space: normal;
  }
  .eppx-shot-float b { font-weight: 500; }
  .eppx-shot-float small { display: inline; margin-left: 6px; color: var(--ds-muted); font: 400 0.72rem/1.2 var(--ds-font-body); }

  .eppx-shot-float i { flex: none; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ds-success); }
  .eppx-page .ds-hl, .eppx-page .ds-hl-dark { -webkit-text-fill-color: transparent; }

  @media (max-width: 767px) {
    .eppx-shot-stage { padding: 12px 10px; }
  }
</style>
