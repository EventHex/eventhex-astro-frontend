---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import LivePollingPage from "../components/live-polling-qa/LivePollingPage.astro";

const title = "Live Polling & Q&A for Events | EventHex";
const description = "Run session polls, anonymous audience voting, live Q&A spotlight, and post-session feedback from the same EventHex session workflow.";

const faqs = [
  ["What poll type is currently supported?", "EventHex supports multiple-choice polls with option-level vote totals and percentages."],
  ["Can attendees vote anonymously?", "Yes, when anonymous mode is enabled. The public vote path uses a client token so a browser can retain its selection without exposing an attendee identity."],
  ["How do attendees open a poll?", "Organizers can share a participation link or QR code, and polls can also appear in the configured attendee mobile experience."],
  ["Can audience questions be anonymous?", "Yes. Anonymous questions remove attendee identity from the returned question. Organizers can review the queue and choose one question for spotlight."],
  ["Does Q&A include upvoting or moderation approval?", "Upvoting and moderation approval are not currently included in this workflow."],
  ["What feedback can we collect?", "Session feedback supports written feedback, a reaction value, and an optional 1–5 rating, with organizer review in the session workspace."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Live Polling & Q&A",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/live-polling-qa/",
  description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: ["Multiple-choice session polls", "Registered and anonymous voting", "QR code and share-link access", "Vote totals and percentages", "Anonymous audience questions", "Single-question stage spotlight", "Text, reaction, and 1–5 session feedback"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })),
};
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://eventhex.ai/live-polling-qa/"
  footerCtaEyebrow="Map one live session"
  footerCtaTitle="Bring your audience interaction plan to the demo"
  footerCtaSubtitle="Show us the session, poll, Q&A policy, participation path, stage display, and feedback outcome you need. We’ll walk through the matching EventHex workflow."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <LivePollingPage faqs={faqs} />
</MarketingLayout>
