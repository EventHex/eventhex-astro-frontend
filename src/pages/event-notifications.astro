---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import EventNotificationsPage from "../components/event-notifications/EventNotificationsPage.astro";

const title = "Event Notification Software & Push Alerts | EventHex";
const description =
  "Schedule targeted event push notifications and configure attendee-app alerts for messages, connections, meetings, and sessions with EventHex.";
const canonical = "https://eventhex.ai/event-notifications/";

// Visible FAQ copy. The same array builds the FAQPage structured data, so the two stay identical.
const faqs: Array<[string, string]> = [
  [
    "What does this page mean by event notification software?",
    "It covers organizer-created push announcements, attendee-app notification controls, and configured reminder services tied to event records. Planned promotional campaigns and conversational WhatsApp help have separate EventHex pages.",
  ],
  [
    "Can I schedule a push notification?",
    "Yes. Create the notification, choose its audience and future send time, and set it to scheduled. The processor sends eligible scheduled notifications when they become due.",
  ],
  [
    "Can attendees control push notifications?",
    "Push delivery depends on the attendee having notifications enabled and an active device token. Event-level controls also enable or disable message, connection, meeting, and session-reminder categories.",
  ],
  [
    "Can I choose a session reminder time?",
    "Yes. The event notification settings offer lead times from five minutes to one day before a saved or upcoming session.",
  ],
  [
    "Does EventHex show notification opens?",
    "The verified notification model records targeted, sent, failed, status, and error data for push jobs. This page does not claim open or read tracking.",
  ],
  [
    "Does the generic notification builder send email and SMS?",
    "The inspected builder displays email and SMS controls, but its verified processor sends push only. Email/WhatsApp event reminders use a separate service; SMS is not claimed on this page.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Notification Software",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: canonical,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Immediate and scheduled push announcements",
    "Audience and segment targeting for notifications",
    "Notification type, priority, image, and sound settings",
    "Per-event attendee-app notification category toggles",
    "Configurable session reminder lead times with duplicate protection",
    "Firebase push delivery with invalid-token cleanup",
    "Push job status, error, and send-count review",
    "Configured email and WhatsApp event reminders",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogType="website"
  footerCtaEyebrow="Bring one real communication plan"
  footerCtaTitle="See how your event alerts move from setup to attendee"
  footerCtaSubtitle="In the demo, map one scheduled announcement, one attendee-app reminder, and the audience and status checks your event team needs."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="enx-page-bg">
    <EventNotificationsPage {faqs} />
  </div>
</MarketingLayout>

<style is:global>
  /* Same soft page wash as Speaker Management / Event Registration. */
  .enx-page-bg {
    background:
      radial-gradient(
        ellipse 75% 68% at 50% 40%,
        rgba(255, 255, 255, 0.94) 0%,
        rgba(255, 255, 255, 0.65) 38%,
        rgba(255, 255, 255, 0.28) 58%,
        transparent 78%
      ),
      linear-gradient(
        to bottom,
        #fff 0,
        rgba(255, 255, 255, 0.85) 130px,
        rgba(255, 255, 255, 0.5) 260px,
        rgba(255, 255, 255, 0.18) 390px,
        transparent 500px
      ),
      linear-gradient(
        to top,
        #fff 0,
        rgba(255, 255, 255, 0.7) 70px,
        rgba(255, 255, 255, 0.3) 130px,
        transparent 190px
      ),
      radial-gradient(
        circle 380px at 3% 34%,
        rgba(175, 163, 255, 0.28) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 300px at 97% 30%,
        rgba(255, 182, 213, 0.26) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 340px at 95% 75%,
        rgba(130, 170, 255, 0.24) 0%,
        transparent 100%
      ),
      radial-gradient(
        circle 300px at 4% 78%,
        rgba(255, 224, 150, 0.2) 0%,
        transparent 100%
      ),
      #ffffff !important;
    background-attachment: fixed !important;
  }

  /* Let the page wash show through every content section. */
  .enx-page-bg > section,
  .enx-page-bg > div > section {
    background: transparent !important;
  }

  /* Dark shells keep their own near-black treatment. */
  .enx-page-bg > .enx-page > .enx-band,
  .enx-page-bg > .enx-page > .enx-stack-shell {
    background-color: #000 !important;
    background-image: radial-gradient(
      130% 42% at 50% 0%,
      rgba(92, 138, 255, 0.22) 0%,
      rgba(124, 108, 255, 0.1) 45%,
      transparent 72%
    ) !important;
    background-repeat: no-repeat !important;
  }

  /* FAQ sits on a white isolation panel, as on Speaker Management. */
  .enx-page-bg > .enx-page > .enx-faq {
    background: #fff !important;
  }
</style>
