---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageSections from "../components/ai-form-builder/PageSections.astro";

const title = "AI Event Form Builder for Registration & Feedback | EventHex";
const description = "Describe the form you need, review AI-generated fields, and publish ticket questions, standalone event forms, or feedback forms with EventHex.";

const faqs = [
  {
    q: "What does the EventHex AI Form Builder generate?",
    a: "It turns a typed description into a draft set of form fields. The draft can include standard attendee fields, custom questions, suitable input types, required-field choices, and options for selection fields. The organizer reviews and edits the result before publishing.",
  },
  {
    q: "Can I use the same builder for registration and standalone forms?",
    a: "Yes. EventHex uses the builder for ticket registration questions and for standalone event forms. Standalone forms can also support event feedback workflows.",
  },
  {
    q: "Can different ticket types ask different questions?",
    a: "Yes. In Single Registration, shared questions can appear across ticket forms while ticket-specific questions stay with one ticket. In multi-ticket Checkout, buyer details are collected once and ticket-specific questions are collected for each attendee.",
  },
  {
    q: "Which field types can I add?",
    a: "The verified field palette includes attendee details, text and long-text answers, numbers, dates, times, files, images, checkboxes, dropdowns, multi-selects, NPS, ratings, and information content.",
  },
  {
    q: "Can I edit an AI-generated form?",
    a: "Yes. You can change field copy, required settings, available validation, choices, width, and order. You can also add or remove fields before publishing.",
  },
  {
    q: "Can form fields use the event's configured languages?",
    a: "Yes. When event languages are configured, field labels, placeholders, supporting copy, and select-option labels can carry language-specific values. The organizer can review the generated translations.",
  },
  {
    q: "How do I share a standalone event form?",
    a: "Use its public event-domain link, open it for review, or present its QR code. A selected standalone form can also be placed in a form section on an EventHex website page.",
  },
  {
    q: "What happens after someone submits a standalone form?",
    a: "EventHex stores the response with the event and form. Organizers can view submission counts, review the answers in a response table, and export the response data.",
  },
  {
    q: "Does AI publish the form automatically?",
    a: "No. AI creates the field draft. The organizer reviews the questions and uses the form builder's preview and publish flow.",
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex AI Form Builder",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/ai-form-builder/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Typed-prompt field drafting",
    "Organizer-reviewed visual form builder",
    "Ticket registration questions",
    "Standalone event forms",
    "Event feedback forms",
    "Configured event-language field copy",
    "Public form links and QR codes",
    "Submission review and export",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/ai-form-builder/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/AI-Form-Builder.png"
  footerCtaEyebrow="AI Form Builder"
  footerCtaTitle="Bring One Event Form. See It Move From Prompt to Publish."
  footerCtaSubtitle="Show us the registration, application, or feedback form you need. We’ll map its fields, attendee journey, publishing options, and response workflow in EventHex."
  footerCtaButtonText="Book a Demo"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform displayed on a laptop, tablet, and mobile phone"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageSections {faqs} />
</MarketingLayout>
