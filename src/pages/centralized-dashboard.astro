---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/centralized-dashboard/HeroSection.astro";
import MidSections from "../components/centralized-dashboard/MidSections.astro";
import CapabilitySections from "../components/centralized-dashboard/CapabilitySections.astro";
import WorkflowSections from "../components/centralized-dashboard/WorkflowSections.astro";
import FaqSection from "../components/centralized-dashboard/FaqSection.astro";

const title = "Centralized Event Dashboard for Multiple Events | EventHex";
const description =
  "Manage multiple events from one portfolio dashboard. Find what needs attention, compare event performance, clone proven setups, and control team access.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex \u2014 Centralized Event Dashboard",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/centralized-dashboard/",
  featureList: [
    "Multi-event portfolio view",
    "Portfolio attention signals",
    "Unique-person and returning-attendee insight",
    "Cross-event comparison with currency-aware revenue",
    "Portfolio comparison CSV export",
    "Selective event cloning",
    "Organization and event-scoped access",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/centralized-dashboard/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Dashboard.png"
  footerCtaEyebrow="Map Your Event Portfolio"
  footerCtaTitle="Bring three events and one repeatable workflow to the demo"
  footerCtaSubtitle="Show us the events, metrics, currencies, clone choices, and team boundaries you manage today. We will map the matching EventHex portfolio workflow and open the event-level detail that matters next."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaProofItems={["Portfolio visibility", "Selective cloning", "Event-scoped access"]}
  footerCtaImageSrc="/feature-images/centralized-dashboard/event-portfolio-visual.svg"
  footerCtaImageAlt="EventHex organization dashboard showing multiple events with status and metrics"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div class="cdd-page-bg">
    <HeroSection />
    <MidSections />
    <CapabilitySections />
    <WorkflowSections />
    <FaqSection />
  </div>
</MarketingLayout>

<script>
  // Play the demo loops only while they are on screen; keep them paused for reduced motion.
  const cddLoops = Array.from(document.querySelectorAll<HTMLVideoElement>('.cdd-loop'));
  const cddReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cddReduced) {
    cddLoops.forEach((video) => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });
  } else if ('IntersectionObserver' in window) {
    const cddObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    cddLoops.forEach((video) => cddObserver.observe(video));
  }
</script>

<style is:global>
  /* Sections carry their own backgrounds (white, tinted bands, dark band);
     the page wrapper stays plain white so none of them get overridden. */
  .cdd-page-bg {
    background: var(--ds-white);
  }

  /* ===== EventHex design system v5 ===== */
  .cdd-page-bg.cdd-page-bg section h1, .cdd-page-bg.cdd-page-bg section h2, .cdd-page-bg.cdd-page-bg .cdd-setup__header h2, .cdd-page-bg.cdd-page-bg .cdd-flow-title, .cdd-page-bg.cdd-page-bg .cdd-use-title, .cdd-page-bg.cdd-page-bg .cdd-hero__title { color: var(--ds-ink); background: none; -webkit-text-fill-color: currentColor; font-weight: 500; letter-spacing: -0.035em; }
  .cdd-page-bg.cdd-page-bg .cdd-bandheading__title, .cdd-page-bg.cdd-page-bg .cdd-darkcta__title { color: var(--ds-on-night); background: none; -webkit-text-fill-color: currentColor; }
  .cdd-page-bg.cdd-page-bg h1 .ds-hl, .cdd-page-bg.cdd-page-bg h2 .ds-hl, .cdd-page-bg.cdd-page-bg h2 .ds-hl-dark { -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .cdd-page-bg.cdd-page-bg h1 .ds-hl, .cdd-page-bg.cdd-page-bg h2 .ds-hl { background-image: var(--ds-g1-text); }
  .cdd-page-bg.cdd-page-bg h2 .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .cdd-page-bg.cdd-page-bg .cdd-darkcta__break { display: block; }
  .cdd-page-bg.cdd-page-bg h3 { font-weight: 500; }
  .cdd-page-bg.cdd-page-bg .cdd-setup__header > span, .cdd-page-bg.cdd-page-bg .cdd-flow-eyebrow, .cdd-page-bg.cdd-page-bg .cdd-steps__header > span, .cdd-page-bg.cdd-page-bg .cdd-bento-kicker, .cdd-page-bg.cdd-page-bg .cdd-use-kicker, .cdd-page-bg.cdd-page-bg .cdd-bento-eyebrow, .cdd-page-bg.cdd-page-bg .cdd-hero__badge { color: var(--ds-blue); font-weight: 500; letter-spacing: 0.04em; }
  .cdd-page-bg.cdd-page-bg .cdd-bandheading__eyebrow { color: var(--ds-on-night-accent); font-weight: 500; }

  /* Buttons */
  .cdd-page-bg.cdd-page-bg .cdd-hero__btn { min-height: 0; padding: 14px 24px; border-radius: 12px; font-size: 16px; font-weight: 500; letter-spacing: 0; line-height: 1.2; }
  .cdd-page-bg.cdd-page-bg .cdd-hero__btn--primary { background: var(--ds-blue); color: var(--ds-white); box-shadow: var(--ds-shadow-btn); }
  .cdd-page-bg.cdd-page-bg .cdd-hero__btn--primary:hover { background: var(--ds-blue-hover); }
  .cdd-page-bg.cdd-page-bg .cdd-hero__btn--secondary { background: rgba(255,255,255,.75); color: var(--ds-ink); border: 1px solid var(--ds-line); box-shadow: none; }
  .cdd-page-bg.cdd-page-bg .cdd-hero__btn--secondary:hover { background: var(--ds-white); border-color: var(--ds-line); }
  .cdd-page-bg.cdd-page-bg .cdd-darkcta__btn { background: var(--ds-white); color: var(--ds-band-ink); font-weight: 500; letter-spacing: 0; }
  .cdd-page-bg.cdd-page-bg .cdd-faq__cta { background: var(--ds-blue); font-weight: 500; box-shadow: var(--ds-shadow-btn); }
  .cdd-page-bg.cdd-page-bg .cdd-faq__cta:hover { background: var(--ds-blue-hover); }

  /* Surfaces */
  .cdd-page-bg.cdd-page-bg .cdd-hero { background: var(--ds-g4-stage); }
  .cdd-page-bg.cdd-page-bg .cdd-hero::after { display: none; }
  .cdd-page-bg.cdd-page-bg .cdd-hero__visual { margin-right: 0; }
  .cdd-page-bg.cdd-page-bg .cdd-hero__visual-card { border-radius: var(--ds-r-xl); border: 1px solid var(--ds-glass-edge); background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .cdd-page-bg.cdd-page-bg .cdd-hero__visual-inner { border-radius: var(--ds-r-lg); background: var(--ds-surface); }
  .cdd-page-bg.cdd-page-bg .cdd-trust-strip, .cdd-page-bg.cdd-page-bg .cdd-flow, .cdd-page-bg.cdd-page-bg .cdd-steps, .cdd-page-bg.cdd-page-bg .cdd-bento, .cdd-page-bg.cdd-page-bg .cdd-aud, .cdd-page-bg.cdd-page-bg .cdd-faq, .cdd-page-bg.cdd-page-bg .cdd-setup--alt { background: var(--ds-white); }
  .cdd-page-bg.cdd-page-bg .cdd-setup--alt { border-top: 0; border-bottom: 0; }
  .cdd-page-bg.cdd-page-bg .cdd-aud { border-top: 0; }
  .cdd-page-bg.cdd-page-bg .cdd-setup:not(.cdd-setup--alt), .cdd-page-bg.cdd-page-bg .cdd-clickup, .cdd-page-bg.cdd-page-bg .cdd-use { background: var(--ds-g4-stage); }
  .cdd-page-bg.cdd-page-bg .cdd-darkband { background-color: var(--ds-night); background-image: var(--ds-night-bg); }
  .cdd-page-bg.cdd-page-bg .cdd-darkband::before { display: none; }

  /* Glass on stage */
  .cdd-page-bg.cdd-page-bg .cdd-setup:not(.cdd-setup--alt) .cdd-setup-grid, .cdd-page-bg.cdd-page-bg .cdd-use-grid { border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); background: var(--ds-glass-fill); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); overflow: hidden; }
  .cdd-page-bg.cdd-page-bg .cdd-setup-notch, .cdd-page-bg.cdd-page-bg .cdd-use-notch, .cdd-page-bg.cdd-page-bg .cdd-bento-notch, .cdd-page-bg.cdd-page-bg .cdd-bento-cross, .cdd-page-bg.cdd-page-bg .cdd-cap__petal, .cdd-page-bg.cdd-page-bg .cdd-flow-quad__cross { display: none; }
  .cdd-page-bg.cdd-page-bg .cdd-clickup__card { background: var(--ds-glass-fill); border: 1px solid var(--ds-glass-edge); border-radius: var(--ds-r-xl); box-shadow: var(--ds-glass-shadow); -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur); }
  .cdd-page-bg.cdd-page-bg .cdd-clickup__card:hover { border-color: var(--ds-glass-edge); box-shadow: var(--ds-glass-shadow); }
  .cdd-page-bg.cdd-page-bg .cdd-clickup__card h3, .cdd-page-bg.cdd-page-bg .cdd-aud__card h3 { font-weight: 500; }
  .cdd-page-bg.cdd-page-bg .cdd-aud__card { background: var(--ds-white); border-radius: var(--ds-r-xl); }
  .cdd-page-bg.cdd-page-bg .cdd-aud__card:hover { border-color: var(--ds-line); box-shadow: var(--ds-shadow-shot); }
  .cdd-page-bg.cdd-page-bg .cdd-bento-grid { border-radius: var(--ds-r-xl); background: var(--ds-white); }
  .cdd-page-bg.cdd-page-bg .cdd-bento-product-shot { border-radius: var(--ds-r-md); box-shadow: var(--ds-shadow-shot); }
  .cdd-page-bg.cdd-page-bg .cdd-bento-shot-stage { border-radius: var(--ds-r-lg); display: flex; flex-direction: column; gap: 12px; }
  .cdd-page-bg.cdd-page-bg .cdd-shot-float { position: static; animation: none; align-self: flex-start; box-shadow: none; background: var(--ds-surface); }
  .cdd-page-bg.cdd-page-bg .cdd-shot-float--bottom { display: none; }
  .cdd-page-bg.cdd-page-bg .cdd-faq__item { background: var(--ds-surface); border-color: var(--ds-line); }
  .cdd-page-bg.cdd-page-bg .cdd-faq__item[open] { background: var(--ds-surface-tint); }
  .cdd-page-bg.cdd-page-bg .cdd-faq__heading { color: var(--ds-ink); font-weight: 500; letter-spacing: -0.035em; }

  /* Real captures: flat frames, centred, width set per frame via --cdd-w */
  .cdd-page-bg .cdd-media { width: min(var(--cdd-w, 1040px), 100%); margin: 0 auto 48px; }
  .cdd-page-bg .cdd-shot--crop > img { aspect-ratio: var(--ar, 16 / 9); object-fit: cover; object-position: var(--pos, 50% 0%); }
  .cdd-page-bg .cdd-bento-product-shot[style*="--ar"] { aspect-ratio: var(--ar); object-fit: cover; object-position: var(--pos, 50% 0%); }
  .cdd-page-bg .cdd-darkband .ds-shot { border-color: var(--ds-glass-dark-edge); }
  .cdd-page-bg .cdd-steps .cdd-media { margin-top: 0; }
  .cdd-page-bg .cdd-flow-quad__cell--media .ds-shot { width: 100%; }

  /* Dark glass */
  .cdd-page-bg.cdd-page-bg .cdd-cap { border: 1px solid var(--ds-glass-dark-edge); border-radius: var(--ds-r-xl); background: var(--ds-glass-dark-fill); box-shadow: var(--ds-glass-dark-shadow); }
  .cdd-page-bg.cdd-page-bg .cdd-cap__label { font-weight: 500; }
  .cdd-page-bg.cdd-page-bg .cdd-bandheading__sub { color: var(--ds-on-night-body); }
</style>
