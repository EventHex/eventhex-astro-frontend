---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import RelatedFeatures from "../components/shared/RelatedFeatures.astro";
import HeroSection from "../components/exhibitor-management/HeroSection.astro";
import SetupCardsSection from "../components/exhibitor-management/SetupCardsSection.astro";
import PortalShowcaseSection from "../components/exhibitor-management/PortalShowcaseSection.astro";
import LeadWorkspaceDarkSection from "../components/exhibitor-management/LeadWorkspaceDarkSection.astro";
import TeamPassesSection from "../components/exhibitor-management/TeamPassesSection.astro";
import CTASection from "../components/exhibitor-management/CTASection.astro";
import ProductsDiscoverySection from "../components/exhibitor-management/ProductsDiscoverySection.astro";
import AnalyticsSection from "../components/exhibitor-management/AnalyticsSection.astro";
import UseCasesSection from "../components/exhibitor-management/UseCasesSection.astro";
import ConnectedWorkflowsSection from "../components/exhibitor-management/ConnectedWorkflowsSection.astro";
import FaqSection from "../components/exhibitor-management/FaqSection.astro";

const title = "Exhibitor Management Software & Lead Capture | EventHex";
const description =
  "Manage exhibitor applications, company profiles, booth teams, allocated passes, product listings, lead capture, CRM handoff, and analytics in EventHex.";

// Visible FAQ copy matching structured data schema
const faqs: Array<[string, string]> = [
  [
    "What can organizers manage before approving an exhibitor?",
    "Create exhibitor package types, configure application fields and pass allocations, review submitted companies, approve or reject them, and resend onboarding communication when needed.",
  ],
  [
    "What can an approved exhibitor do in the portal?",
    "Depending on the modules enabled for the event, the exhibitor can update its company profile, manage products and resources, add booth members, issue allocated passes, view badges and floor-plan files, read announcements and FAQs, scan leads, and review analytics.",
  ],
  [
    "How does exhibitor lead capture work?",
    "Booth staff can scan an attendee QR code from the exhibitor portal or add a lead manually. The lead stays connected to the event, exhibitor, and capturing team member.",
  ],
  [
    "Can exhibitors qualify and export leads?",
    "Yes. They can search and filter leads, set high, medium, or low priority, add a status and remarks, and export available lead data as CSV.",
  ],
  [
    "Can captured leads go to a CRM?",
    "An exhibitor-specific connection can be configured for HubSpot, Zoho CRM, Salesforce, or Pipedrive. EventHex sends captured leads on a best-effort basis, so lead capture remains available even if the CRM is unavailable.",
  ],
  [
    "Does EventHex include an interactive booth-layout editor?",
    "No. The current workflow stores booth numbers and lets organizers upload titled floor-plan files that exhibitors can view or download. A visual drag-and-drop booth inventory and selection workflow is not available.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Exhibitor Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/exhibitor-management/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Ticket-backed exhibitor packages and approvals",
    "Configurable self-service exhibitor portal",
    "Company profiles, products, and resources",
    "Booth team members and allocated passes",
    "QR and manual lead capture",
    "Lead priority, status, remarks, and CSV export",
    "Exhibitor CRM handoff on a best-effort basis",
    "Lead trends and booth-team analytics",
    "Public exhibitor directory and attendee bookmarks",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/exhibitor-management/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/iPhone-15-Pro.png"
  ogType="website"
  footerCtaEyebrow="Start with one exhibitor"
  footerCtaTitle="Ready to run your exhibitor workflow in EventHex?"
  footerCtaSubtitle="Bring packages, applications, portal setup, company profiles, and booth-lead capture into one connected workflow."
  footerCtaProofItems={[]}
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/speaker-management/cta-illustration.svg"
  footerCtaImageAlt="Exhibitor management workflow and portal in EventHex"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="exm-page-bg">
    <HeroSection />
    <section class="exm-workflow-summary" aria-label="Exhibitor workflow summary">
      <div><strong>Define</strong><span>Create exhibitor package types</span></div>
      <div><strong>Apply</strong><span>Collect company information</span></div>
      <div><strong>Review</strong><span>Approve or reject</span></div>
      <div><strong>Onboard</strong><span>Open the exhibitor portal</span></div>
      <div><strong>Activate</strong><span>Publish profiles and products</span></div>
      <div><strong>Capture</strong><span>Manage and export leads</span></div>
    </section>
    <SetupCardsSection />
    <PortalShowcaseSection />
    <LeadWorkspaceDarkSection />
    <TeamPassesSection />
    <CTASection />
    <ProductsDiscoverySection />
    <AnalyticsSection />
    <UseCasesSection />
    <ConnectedWorkflowsSection />
    <FaqSection {faqs} />
  </div>
  <RelatedFeatures links={[
    { href: "/sponsor-management/", label: "Event sponsor management software", text: "Sponsor profiles, ordered categories, and sponsor sections on your event site." },
    { href: "/appointments-meetings/", label: "Event meeting scheduling", text: "Let attendees request, confirm, and reschedule one-to-one meetings." },
    { href: "/event-check-in/", label: "Event check-in software", text: "Scan QR tickets on iOS or Android and watch arrival counts update." },
    { href: "/crm-integrations/", label: "Event CRM integration", text: "Sync attendee and exhibitor records to HubSpot." },
  ]} />
</MarketingLayout>

<script>
  // Ensure visible elements unhide cleanly on initial render and scrolling
  document.addEventListener('DOMContentLoaded', () => {
    const reveals = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const anim = el.dataset.animation || 'fadeIn';
          const delay = parseInt(el.dataset.delay || '0', 10);
          setTimeout(() => {
            el.classList.add('is-visible');
            el.style.animationName = anim;
            el.style.opacity = '1';
          }, delay);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.08, rootMargin: '50px 0px 50px 0px' });

    reveals.forEach((el) => observer.observe(el));
  });
</script>

<style is:global>
  .exm-page-bg { background: var(--ds-white); }

  /* Surfaces come from ds-stage / ds-night / ds-band classes on each section */
  .exm-page-bg > section { background: transparent; }
  .exm-page-bg > section.ds-stage { background: var(--ds-g4-stage); }
  .exm-page-bg > section.ds-night { background: var(--ds-night-bg); }
  .exm-page-bg > section.exh-hero::after { display: none; }

  .exm-workflow-summary {
    display: flex;
    justify-content: center;
    gap: clamp(20px, 4vw, 58px);
    flex-wrap: wrap;
    padding: 24px 28px;
    border-top: 1px solid var(--ds-line);
    border-bottom: 1px solid var(--ds-line);
    background: var(--ds-white);
  }
  .exm-workflow-summary div { display:flex; gap:5px; align-items:baseline; color:var(--ds-muted); font: 14px/1.4 var(--font-body); }
  .exm-workflow-summary strong { color:var(--ds-ink); font-weight:500; }
  @media (max-width: 700px) { .exm-workflow-summary { justify-content:flex-start; gap:12px 24px; } .exm-workflow-summary div { flex: 1 1 42%; } }

  /* Headings: solid ink, Creato 500, one gradient key phrase */
  .exm-page-bg h1,
  .exm-page-bg h2 {
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.035em;
    color: var(--ds-ink);
    background: none;
    -webkit-text-fill-color: currentColor;
  }
  .exm-page-bg h3 { font-weight: 500; background: none; -webkit-text-fill-color: currentColor; }
  .exm-page-bg .ds-hl,
  .exm-page-bg .ds-hl-dark {
    display: inline !important;
    white-space: normal !important;
    background-clip: text; -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .exm-page-bg .ds-hl { background-image: var(--ds-g1-text); }
  .exm-page-bg .ds-hl-dark { background-image: var(--ds-g2-text-dark); }
  .exm-page-bg .exh-hero__title,
  .exm-page-bg .exh-portal__title,
  .exm-page-bg .exh-passes__title,
  .exm-page-bg .exh-analytics__title,
  .exm-page-bg .exh-suites__title {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.035em;
  }
  .exm-page-bg .exh-analytics__title span { white-space: normal; }
  .exm-page-bg .exh-lead-dark__header h2,
  .exm-page-bg .exh-discovery__title,
  .exm-page-bg .exh-cta__title {
    color: var(--ds-on-night);
    -webkit-text-fill-color: var(--ds-on-night);
  }

  /* Buttons */
  .exm-page-bg .exh-hero__btn,
  .exm-page-bg .exh-portal__btn,
  .exm-page-bg .exh-cta__btn { font-weight: 500; border-radius: 999px; }
  .exm-page-bg .exh-hero__btn--primary,
  .exm-page-bg .exh-portal__btn--dark { background: var(--ds-blue); color: var(--ds-white); border: 0; box-shadow: var(--ds-shadow-btn); }
  .exm-page-bg .exh-hero__btn--primary:hover,
  .exm-page-bg .exh-portal__btn--dark:hover { background: var(--ds-blue-hover); }
  .exm-page-bg .exh-hero__btn--secondary,
  .exm-page-bg .exh-portal__btn--light { background: var(--ds-white); color: var(--ds-ink); border: 1px solid var(--ds-line-strong); box-shadow: none; }

  /* Screenshots: flat frame, soft shadow */
  .exm-page-bg .exh-app-shot,
  .exm-page-bg .exh-app-shot--product-card,
  .exm-page-bg .exh-pass-screenshot { transform: none !important; box-shadow: var(--ds-shadow-shot); border: 1px solid var(--ds-line-strong); }

  /* Glass cards on stage sections */
  .exm-page-bg .exh-hero__visual-card,
  .exm-page-bg .exh-workflow-card,
  .exm-page-bg .exh-faq-item,
  .exm-page-bg .exh-pass-step,
  .exm-page-bg .exh-chart-card {
    background: var(--ds-glass-fill); border-color: var(--ds-glass-edge); box-shadow: var(--ds-glass-shadow);
    -webkit-backdrop-filter: var(--ds-glass-blur); backdrop-filter: var(--ds-glass-blur);
  }
  /* Dark glass on night sections */
  .exm-page-bg .exh-dark-card {
    background: var(--ds-glass-dark-fill); border: 1px solid var(--ds-glass-dark-edge); box-shadow: var(--ds-glass-dark-shadow);
  }
  /* Sticky stacking cards stay opaque */
  .exm-page-bg .exh-disc-card {
    background: color-mix(in srgb, var(--ds-night-card) 40%, var(--ds-night));
    border: 1px solid var(--ds-glass-dark-edge); box-shadow: var(--ds-glass-dark-shadow);
  }
  .exm-page-bg .exh-cta__card { background: var(--ds-g3-band); }

  @media (max-width: 900px) {
    .exm-page-bg .exh-disc-card { height: auto; min-height: 0; display: flex; flex-direction: column; }
    .exm-page-bg .exh-disc-card::after { display: none; }
    .exm-page-bg .exh-disc-card__content { width: 100%; height: auto; padding: 28px 22px 18px; box-sizing: border-box; }
    .exm-page-bg .exh-disc-card .exh-app-shot--product-card { position: static; order: 2; width: calc(100% - 32px); height: 220px; margin: 0 16px 16px; }
  }

  /* Spacing normalization */
  .exm-page-bg .exh-trust-strip { margin-bottom: 20px; }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
