---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageSections from "../components/ai-session-recap/PageSections.astro";

const title = "AI Session Recap & Live Event Transcription | EventHex";
const description = "Capture live or recorded event sessions with live transcription, AI summaries, personalized takeaways, resources, and share-ready content.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex InstaRecap",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/ai-session-recap/",
  description,
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Live and recorded event-session capture",
    "Live transcription",
    "Reviewable session summaries and takeaways",
    "Referenced session resources",
    "Profile-aware attendee takeaways",
    "Organizer-selected recap translation",
    "LinkedIn and X drafts",
    "Takeaway posters and recap PDF",
    "Scoped AV-team access",
    "Event-level recap reporting",
  ],
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/ai-session-recap/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/01/Instasnap.png"
  footerCtaEyebrow="See InstaRecap with Your Event"
  footerCtaTitle="Turn Every Session Into Something Attendees Can Use"
  footerCtaSubtitle="Bring us your agenda, capture setup, and audience requirements. We’ll show you how the recap workflow fits your event."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/footer-cta-devices.webp"
  footerCtaImageAlt="EventHex platform displayed on a laptop and mobile phone"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <PageSections />
</MarketingLayout>

<style is:global>
  body:has(.asrv-page) .site-footer .cta-devices-img {
    width: auto;
    max-width: 360px;
    height: 320px;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    body:has(.asrv-page) .site-footer .cta-devices-img {
      width: auto;
      max-width: 240px;
      height: 220px;
    }
  }
</style>
