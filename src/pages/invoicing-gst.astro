---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/invoicing-gst/HeroSection.astro";
import WorkflowSection from "../components/invoicing-gst/WorkflowSection.astro";
import ConfigurationSections from "../components/invoicing-gst/ConfigurationSections.astro";
import FaqSection from "../components/invoicing-gst/FaqSection.astro";

const title = "Event Invoicing & Configurable Tax | EventHex";
const description = "Create numbered event-order invoices with buyer billing fields, configurable GST, VAT, or custom tax lines, inclusive or exclusive pricing, and PDF delivery.";
const canonical = "https://eventhex.ai/invoicing-gst/";

const faqs = [
  ["Can buyers request an invoice during registration?", "Yes. In the supported flow, organizers can enable invoice requests and collect the configured company, tax-ID, and billing-address details."],
  ["Can we use GST, VAT, or a custom tax label?", "Yes. Your team configures the supported tax names and percentage rates. GST and VAT are examples; EventHex does not decide which tax applies."],
  ["Can we customize the invoice number?", "You can configure the supported invoice prefix, starting number, document title, and invoice-number label."],
  ["Does EventHex calculate the legally correct tax automatically?", "No universal tax-determination engine was verified. Your finance or tax adviser should approve the labels, rates, treatment, and required fields."],
  ["Can EventHex send a PDF invoice?", "The supported invoice workflow generates an order-linked PDF and can send it through the configured delivery path. Confirm the exact trigger and template in the demo."],
  ["Does this page include credit notes and reconciliation?", "Those invoice-document capabilities were not verified end to end. Payment refunds and event finance reporting belong to the Payment Processing workflow and should not be presented as proof of credit-note automation."],
] as const;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Invoicing and Configurable Tax",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: canonical,
  description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Organizer-defined invoice identity",
    "Invoice prefix and starting number configuration",
    "Buyer company, tax ID, and billing-address fields",
    "Named tax lines with organizer-defined percentage rates",
    "Inclusive or exclusive ticket pricing",
    "Order-linked invoice PDF and configured delivery",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  ogImage="https://eventhex.ai/feature-images/invoicing-gst/hero-invoice-workflow.svg"
  footerCtaEyebrow="Map one invoice workflow"
  footerCtaTitle={"Bring Your Invoice and Tax\nRequirements to the Demo"}
  footerCtaSubtitle="Show us one event, ticket, buyer journey, invoice identity, numbering rule, and approved tax setup. We’ll map the supported EventHex workflow and flag anything that needs separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/invoicing-gst/hero-invoice-workflow.svg"
  footerCtaImageAlt="EventHex event invoice workspace with buyer, order, tax, and PDF delivery details"
  showFooterCta={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <div class="ig-page-bg">
    <HeroSection />
    <WorkflowSection />
    <ConfigurationSections />
    <FaqSection {faqs} />
  </div>
</MarketingLayout>

<style is:global>
  .ig-page-bg { background:radial-gradient(ellipse 75% 68% at 50% 40%,rgba(255,255,255,.94) 0%,rgba(255,255,255,.65) 38%,rgba(255,255,255,.28) 58%,transparent 78%),linear-gradient(to bottom,#fff 0,rgba(255,255,255,.85) 130px,rgba(255,255,255,.5) 260px,rgba(255,255,255,.18) 390px,transparent 500px),linear-gradient(to top,#fff 0,rgba(255,255,255,.7) 70px,rgba(255,255,255,.3) 130px,transparent 190px),radial-gradient(circle 380px at 3% 34%,rgba(175,163,255,.28),transparent 100%),radial-gradient(circle 300px at 97% 30%,rgba(255,182,213,.26),transparent 100%),radial-gradient(circle 340px at 95% 75%,rgba(130,170,255,.24),transparent 100%),radial-gradient(circle 300px at 4% 78%,rgba(255,224,150,.2),transparent 100%),#fff; background-attachment:fixed; }
  .ig-page-bg a:focus-visible,.ig-page-bg summary:focus-visible { outline:3px solid #f6bd35; outline-offset:4px; }
  body:has(.ig-page-bg) .site-footer .cta-devices-img { width:90%; max-width:510px; border-radius:18px; }
  @media (prefers-reduced-motion:reduce) { .ig-page-bg *,.ig-page-bg *::before,.ig-page-bg *::after { scroll-behavior:auto!important; transition-duration:.01ms!important; animation-duration:.01ms!important; animation-iteration-count:1!important; } }
  @media (max-width:767px) {
    body:has(.ig-page-bg) .site-footer .footer-cta-banner { flex-direction:column; }
    body:has(.ig-page-bg) .site-footer .cta-left { flex:none; padding:78px 20px 20px; }
    body:has(.ig-page-bg) .site-footer .cta-subtitle { max-width:none; }
    body:has(.ig-page-bg) .site-footer .cta-right { position:relative; inset:auto; width:100%; padding:0 20px 34px; justify-content:center; overflow:hidden; }
    body:has(.ig-page-bg) .site-footer .cta-devices-img { width:100%; max-width:330px; }
  }
</style>
