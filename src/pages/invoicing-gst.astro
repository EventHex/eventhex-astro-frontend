---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Event Invoicing & Configurable Tax | EventHex";
const description = "Create numbered event-order invoices with buyer billing fields, configurable GST, VAT, or custom tax lines, inclusive or exclusive pricing, and PDF delivery.";
const canonical = "https://eventhex.ai/invoicing-gst/";

const lifecycle = [
  ["Configure", "Identity + numbering"],
  ["Request", "Buyer chooses invoice"],
  ["Collect", "Billing fields"],
  ["Calculate", "Named tax lines"],
  ["Generate", "Numbered PDF"],
  ["Deliver", "Order-linked email"],
];

const workflow = [
  ["Set the invoice rules", "Choose identity, numbering, buyer fields, and tax configuration."],
  ["Buyer requests an invoice", "Show the invoice option in the supported registration or checkout journey."],
  ["Complete payment and order", "Retain ticket, amount, currency, buyer, and tax context."],
  ["Generate and deliver", "Create the PDF and send it through the configured order workflow."],
];

const invoiceIdentity = [
  ["Document title", "Use Invoice, Tax Invoice, Receipt, or another approved title."],
  ["Bill-to label", "Adapt the buyer section label to the document type."],
  ["Organizer details", "Show the configured billing company, address, and logo."],
  ["Invoice number label", "Name the reference field the way your workflow requires."],
];

const buyerFields = [
  ["Company name", "Collect the legal or trading name supplied by the buyer."],
  ["Tax ID", "Use GSTIN, VAT number, TRN, or another configured label."],
  ["Billing address", "Capture the address needed for the organizer's document."],
  ["Required fields", "Choose which supported B2B fields must be completed."],
  ["Invoice preview", "Show the configured buyer details in the available preview flow."],
  ["Order record", "Retain invoice-request context with the registration or order."],
];

const regions = [
  { title: "India", body: "Use GST and GSTIN labels when they are required for the event's approved invoice setup.", bullets: ["GST label", "GSTIN label", "Approved event setup"] },
  { title: "UAE and GCC", body: "Use VAT, TRN, or another locally approved label and configured rate.", bullets: ["VAT label", "TRN label", "Locally approved rate"] },
  { title: "United Kingdom", body: "Use VAT and the billing fields approved for the organizer's UK invoice workflow.", bullets: ["VAT label", "Approved billing fields", "Organizer's UK workflow"] },
  { title: "United States", body: "Use the applicable organizer-defined sales-tax label or no tax line where advised.", bullets: ["Organizer-defined sales-tax label", "Applicable event setup", "No tax line where advised"] },
  { title: "Cross-border events", body: "Keep the event currency and buyer details visible without implying tax determination.", bullets: ["Event currency", "Buyer details", "No implied tax determination"] },
  { title: "Custom terminology", body: "Adapt supported labels to the document and market your team has validated.", bullets: ["Supported labels", "Approved document wording", "Validated market terminology"] },
];

const responsibilities = [
  ["EventHex configures", "Invoice identity, supported buyer fields, tax lines, price mode, numbering, PDF, and delivery."],
  ["Organizer approves", "Business identity, tax names, rates, required fields, and event setup."],
  ["Adviser validates", "Jurisdiction, tax treatment, statutory wording, and filing obligations."],
  ["Payment provider handles", "The selected gateway's payment, settlement, and account requirements."],
];

const connected = [
  ["Event Registration", "Collect buyer and attendee details in the chosen sign-up flow.", "/event-registration/"],
  ["Event Ticketing", "Configure ticket pricing, capacity, sale windows, and access rules.", "/event-ticketing/"],
  ["Payment Processing", "Connect the order to Stripe, Razorpay, or Tap and manage payment/refund state.", "/event-payment-processing/"],
  ["Centralized Dashboard", "Review the wider event portfolio outside the individual invoice workflow.", "/centralized-dashboard/"],
];

const audiences = [
  ["Conferences", "Give delegates and corporate buyers an order-linked invoice."],
  ["Exhibitions", "Support exhibitor or attendee ticket purchases with billing detail."],
  ["Association events", "Handle member and company registrations with invoice requests."],
  ["Corporate events", "Keep internal or customer-event documents consistent."],
  ["Tech conferences", "Connect paid ticket orders to buyer finance requirements."],
  ["Multi-market teams", "Reuse the workflow while configuring the correct regional labels."],
];

const faqs = [
  ["Can buyers request an invoice during registration?", "Yes. In the supported flow, organizers can enable invoice requests and collect the configured company, tax-ID, and billing-address details."],
  ["Can we use GST, VAT, or a custom tax label?", "Yes. Your team configures the supported tax names and percentage rates. GST and VAT are examples; EventHex does not decide which tax applies."],
  ["Can we customize the invoice number?", "You can configure the supported invoice prefix, starting number, document title, and invoice-number label."],
  ["Does EventHex calculate the legally correct tax automatically?", "No universal tax-determination engine was verified. Your finance or tax adviser should approve the labels, rates, treatment, and required fields."],
  ["Can EventHex send a PDF invoice?", "The supported invoice workflow generates an order-linked PDF and can send it through the configured delivery path. Confirm the exact trigger and template in the demo."],
  ["Does this page include credit notes and reconciliation?", "Those invoice-document capabilities were not verified end to end. Payment refunds and event finance reporting belong to the Payment Processing workflow and should not be presented as proof of credit-note automation."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Event Invoicing & Configurable Tax",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: canonical,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Organizer-defined invoice identity",
    "Buyer billing and tax fields",
    "Named tax lines",
    "Inclusive or exclusive ticket pricing",
    "Numbered PDF",
    "Order-linked email",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  {canonical}
  footerCtaEyebrow="Map one invoice workflow"
  footerCtaTitle="Bring your invoice and tax requirements to the demo"
  footerCtaSubtitle="Show us one event, ticket, buyer journey, invoice identity, numbering rule, and approved tax setup. We’ll map the supported EventHex workflow and flag anything that needs separate scoping."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaProofItems={[]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="igt-page">
    <section class="igt-hero">
      <div class="igt-hero__grid">
        <div class="igt-hero__content">
          <span class="igt-eyebrow animate-on-scroll" data-animation="fadeInDown">Event invoicing and tax</span>
          <h1 class="igt-hero__title animate-on-scroll" data-animation="fadeInUp">Create event-order invoices with the tax detail your market needs</h1>
          <p class="igt-hero__desc animate-on-scroll" data-animation="fadeInUp">Collect buyer billing details, apply your approved GST, VAT, or custom tax lines, and deliver a numbered PDF invoice connected to the original event order.</p>
          <div class="igt-hero__points animate-on-scroll" data-animation="fadeInUp">
            <span>Organizer-defined invoice identity</span>
            <span>Buyer billing and tax fields</span>
            <span>Order-linked PDF delivery</span>
          </div>
          <div class="igt-hero__actions animate-on-scroll" data-animation="fadeInUp">
            <a class="igt-btn igt-btn--dark" href="/book-a-demo/">Book a Demo</a>
            <a class="igt-btn igt-btn--light" href="#invoice-workflow">See the invoice workflow</a>
          </div>
        </div>

        <div class="igt-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="igt-hero__frame">
            <div class="igt-hero__visual-inner">
              <div class="igt-hero__shot igt-hero__shot--tax">
                <img
                  src="/feature-images/invoicing-gst/tax-settings-full.jpg"
                  alt="EventHex portal showing Tax and Discounts settings with tax configuration and discount controls"
                  width="1117"
                  height="837"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
              <div class="igt-hero__shot igt-hero__shot--invoice">
                <img
                  src="/feature-images/invoicing-gst/invoice-settings-full.jpg"
                  alt="EventHex portal showing Invoice and Billing settings with invoice generation and delivery controls"
                  width="1117"
                  height="837"
                  loading="lazy"
                />
              </div>
              <div class="igt-hero__delivery"><i></i><span>Order-linked PDF delivery</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="igt-lifecycle" aria-labelledby="lifecycle-heading">
      <div class="igt-lifecycle__inner">
        <span class="igt-lifecycle__sr-only">One order-linked workflow</span>
        <h2 id="lifecycle-heading" class="igt-lifecycle__sr-only">From buyer request to delivered invoice</h2>
        {lifecycle.map(([itemTitle, body]) => <a class="igt-lifecycle__stage" href="#invoice-workflow"><strong>{itemTitle}</strong><span>{body}</span></a>)}
      </div>
    </section>

    <section id="invoice-workflow" class="igt-section igt-workflow">
      <div class="igt-shell">
        <header class="igt-section-head igt-workflow__head"><span class="igt-kicker">Invoice workflow</span><h2>Keep every invoice attached to the transaction that <span>created it</span></h2><p>The invoice starts from the paid registration or ticket order, not from a disconnected spreadsheet or document template.</p></header>
        <div class="igt-four-grid">
          {workflow.map(([itemTitle, body], index) => (
            <article class="igt-line-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
              {index === 2 && <span class="igt-grid-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(-90)"></path></svg></span>}
              <div class="igt-line-card__icon" aria-hidden="true">{index === 0 && <svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M9 18h6"></path><circle cx="8" cy="6" r="2"></circle><circle cx="15" cy="12" r="2"></circle><circle cx="12" cy="18" r="2"></circle></svg>}{index === 1 && <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h5"></path><path d="m15 16 2 2 4-5"></path></svg>}{index === 2 && <svg viewBox="0 0 24 24"><path d="M7 3h10v4H7zM5 7h14v14H5zM8 11h8M8 15h5"></path></svg>}{index === 3 && <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M10 13h6M10 17h4"></path><path d="m3 14 2 2 3-4"></path></svg>}</div>
              <h3>{itemTitle}</h3>
              <p>{body}</p>
            </article>
          ))}
          <span class="igt-grid-notch igt-grid-notch--one" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
          <span class="igt-grid-notch igt-grid-notch--two" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
          <span class="igt-grid-notch igt-grid-notch--three" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
        </div>
      </div>
    </section>

    <section class="igt-section igt-evidence">
      <div class="igt-evidence__container">
        <header class="igt-evidence__header animate-on-scroll" data-animation="fadeInUp">
          <span class="igt-evidence__eyebrow">Your invoice identity</span>
          <h2>Make the document match the organizer and the <span>transaction</span></h2>
          <p>Set the fields your finance team has approved before opening ticket sales.</p>
        </header>
        <div class="igt-evidence__bento animate-on-scroll" data-animation="fadeInUp">
          <span class="igt-evidence__notch igt-evidence__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
          <span class="igt-evidence__notch igt-evidence__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path></svg></span>
          {invoiceIdentity.map(([itemTitle, body], index) => (
            <article class:list={["igt-evidence__row", { "igt-evidence__row--visual-first": index % 2 === 0 }]}>
              <div class="igt-evidence__cell igt-evidence__content">
                <span class="igt-evidence__eyebrow">0{index + 1}</span>
                <h3>{itemTitle}</h3>
                <p>{body}</p>
              </div>
              <div class="igt-evidence__cell igt-evidence__visual">
                <div class:list={["igt-evidence__shot-stage", `igt-evidence__shot-stage--${index + 1}`]}>
                  <div class="igt-evidence__shot-crop">
                    <img src="/feature-images/invoicing-gst/invoice-identity-settings.jpg" alt={index === 0 ? "EventHex Global Ticket Settings showing Invoice and Billing controls" : ""} width="1117" height="837" loading="lazy" />
                  </div>
                  <span class="igt-evidence__float igt-evidence__float--top">
                    <strong>{itemTitle}</strong>
                    {index === 0 && <small>Invoice · Tax Invoice · Receipt</small>}
                    {index === 1 && <small>Bill-to label</small>}
                    {index === 2 && <small>Billing company · Address · Logo</small>}
                    {index === 3 && <small>Invoice number label</small>}
                  </span>
                  <span class="igt-evidence__float igt-evidence__float--bottom"><i></i><strong>{itemTitle}</strong></span>
                </div>
              </div>
              {index < invoiceIdentity.length - 1 && <span class="igt-evidence__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="rotate(-90)"></path></svg></span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="igt-sequence">
      <div class="igt-sequence__container">
        <div class="igt-sequence__left">
          <div class="igt-sequence__sticky animate-on-scroll" data-animation="fadeInUp">
            <span class="igt-sequence__eyebrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"></path></svg>
              Invoice numbering
            </span>
            <h2>Start with the prefix and <span>sequence your event uses</span></h2>
            <p>Configure the invoice prefix and starting number so generated documents carry a consistent order-linked reference.</p>
          </div>
        </div>

        <div class="igt-sequence__right">
          <article class="igt-sequence-card animate-on-scroll" data-animation="fadeInUp">
            <div class="igt-sequence-card__header">
              <span class="igt-sequence-card__number">01</span>
              <div><h3>Prefix</h3><p>Add the approved event or document prefix.</p></div>
            </div>
            <div class="igt-sequence-card__visual" aria-hidden="true">
              <div class="igt-sequence-field"><span>Prefix</span><div><strong>Prefix</strong><i></i></div></div>
            </div>
          </article>

          <article class="igt-sequence-card animate-on-scroll" data-animation="fadeInUp" data-delay="60">
            <div class="igt-sequence-card__header">
              <span class="igt-sequence-card__number">02</span>
              <div><h3>Starting number</h3><p>Choose where the generated sequence begins.</p></div>
            </div>
            <div class="igt-sequence-card__visual" aria-hidden="true">
              <div class="igt-sequence-field"><span>Starting number</span><div><strong>Starting number</strong><i></i></div></div>
            </div>
          </article>

          <article class="igt-sequence-card animate-on-scroll" data-animation="fadeInUp" data-delay="120">
            <div class="igt-sequence-card__header">
              <span class="igt-sequence-card__number">03</span>
              <div><h3>Invoice label</h3><p>Control how the number is named on the document.</p></div>
            </div>
            <div class="igt-sequence-card__visual" aria-hidden="true">
              <div class="igt-sequence-result"><span>Invoice label</span><i></i></div>
            </div>
          </article>

          <article class="igt-sequence-card animate-on-scroll" data-animation="fadeInUp" data-delay="180">
            <div class="igt-sequence-card__header">
              <span class="igt-sequence-card__number">04</span>
              <div><h3>Order connection</h3><p>Keep the invoice reference with the source transaction.</p></div>
            </div>
            <div class="igt-sequence-card__visual" aria-hidden="true">
              <div class="igt-sequence-result"><span>Order connection</span><i></i></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="igt-billing-band">
      <div class="igt-billing-heading animate-on-scroll" data-animation="fadeInUp">
        <span class="igt-billing-heading__eyebrow">Buyer billing details</span>
        <h2>Collect the information the invoice needs <span>during registration</span></h2>
        <p>When the buyer requests an invoice, surface the configured fields in the same journey instead of chasing them after payment.</p>
      </div>

      <div class="igt-billing-grid">
        {buyerFields.map(([itemTitle, body], index) => (
          <article class="igt-billing-card animate-on-scroll" data-animation="fadeInUp" data-delay={String(index * 60)}>
            {index % 3 !== 0 && (
              <>
                <span class="igt-billing-card__petal igt-billing-card__petal--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z"></path></svg></span>
                <span class="igt-billing-card__petal igt-billing-card__petal--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" transform="scale(1,-1)"></path></svg></span>
              </>
            )}
            <h3>{itemTitle}</h3>
            <p>{body}</p>
            <div class="igt-billing-card__visual" aria-hidden="true">
              {index === 0 && <div class="igt-billing-form"><span>Company name</span><div><span>Company name</span><i></i></div></div>}
              {index === 1 && <div class="igt-billing-chips"><span class="is-active">GSTIN</span><span>VAT number</span><span>TRN</span></div>}
              {index === 2 && <div class="igt-billing-form"><span>Billing address</span><div><span>Billing address</span><i></i></div></div>}
              {index === 3 && <div class="igt-billing-toggles"><div><span>Required fields</span><i></i></div><div><span>Required fields</span><i></i></div></div>}
              {index === 4 && <div class="igt-billing-document"><span>Invoice preview</span><i></i><i></i><i></i></div>}
              {index === 5 && <div class="igt-billing-record"><span></span><i></i><span></span><i></i><span></span><strong>Order record</strong></div>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="igt-section igt-choice">
      <div class="igt-shell">
        <header class="igt-section-head"><span class="igt-kicker">Configurable tax detail</span><h2>Use named tax lines with inclusive or exclusive ticket pricing</h2><p>Your team supplies the tax names and percentage rates; EventHex applies that configuration to the supported checkout and invoice breakdown.</p></header>
        <div class="igt-choice__grid">
          <article class="igt-choice__cell igt-choice__copy animate-on-scroll" data-animation="fadeInLeft"><span>01</span><h3>Tax-exclusive price</h3><p>Show the base ticket price and add the configured tax lines to the order total.</p><strong>Best when tax is added at checkout</strong></article>
          <div class="igt-choice__cell igt-choice__visual animate-on-scroll" data-animation="fadeInRight" aria-hidden="true"><div class="igt-tax-preview"><span></span><span></span><span></span><b></b></div></div>
          <div class="igt-choice__cell igt-choice__visual animate-on-scroll" data-animation="fadeInLeft" aria-hidden="true"><div class="igt-tax-preview"><span></span><span></span><span></span><b></b></div></div>
          <article class="igt-choice__cell igt-choice__copy animate-on-scroll" data-animation="fadeInRight"><span>02</span><h3>Tax-inclusive price</h3><p>Treat the displayed ticket price as inclusive and show the configured tax portion in the breakdown.</p><strong>Best when the advertised price already includes tax</strong></article>
          <span class="igt-choice__cross" aria-hidden="true"></span>
        </div>
        <p class="igt-boundary-note">EventHex applies organizer-defined rules; it does not select the legally correct rate or jurisdiction for you.</p>
      </div>
    </section>

    <section class="igt-regions">
      <div class="igt-regions__inner">
        <header class="igt-regions__header animate-on-scroll" data-animation="fadeInUp">
          <span class="igt-kicker">Global by configuration</span>
          <h2>Use the tax language your market and finance team approve</h2>
          <p>The product mechanism stays the same; the labels, IDs, and rates change with the organizer's approved setup.</p>
        </header>

        <ol class="igt-region-steps">
          {regions.map((region, index) => (
            <li>
              <details open={index === 0} data-region-step>
                <summary tabindex="-1">
                  <span>0{index + 1}</span>
                  <div class="igt-region-step__content">
                    <h3>{region.title}</h3>
                    <p>{region.body}</p>
                    <ul>{region.bullets.map((bullet) => <li><i aria-hidden="true">✦</i>{bullet}</li>)}</ul>
                  </div>
                  <button type="button" class="igt-region-step__arrow" aria-label={`${index === 0 ? "Collapse" : "Expand"} ${region.title}`} aria-expanded={index === 0 ? "true" : "false"}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
                  </button>
                </summary>
                <div class="igt-region-step__visual" aria-hidden="true">
                  <div class="igt-region-preview">
                    <div class="igt-region-preview__bar"><span></span><span></span><span></span><strong>{region.title}</strong></div>
                    <div class="igt-region-preview__body">
                      {region.bullets.map((bullet, bulletIndex) => <div class:list={{ "is-active": bulletIndex === 0 }}><i></i><span>{bullet}</span><b></b></div>)}
                    </div>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="igt-finance-dark-flow">
    <section class="igt-delivery-shell">
      <div class="igt-delivery-section">
        <header class="igt-delivery-header">
          <div class="igt-delivery-eyebrow">
            <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5s3 1.6 5.6 2c-2.6.4-4.3 1.2-5.6 2.5s-2 2.9-2.4 5.5c-.4-2.6-1.2-4.3-2.5-5.6s-2.9-2-5.5-2.4c2.6-.4 4.3-1.2 5.5-2.5s2.1-2.4 2.5-5Z" fill="#4F8CFF"></path><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" fill="#B08BFF"></path></svg></span>
            <strong>PDF delivery</strong>
          </div>
          <h2>Give the buyer a clear document they can keep with the <span>order</span></h2>
          <p>Generate the available invoice PDF from the order data and send it through the configured invoice-delivery path.</p>
        </header>

        <div class="igt-delivery-cards" id="igt-delivery-cards">
          <article class="igt-delivery-card" style="--delivery-card-index:0">
            <div class="igt-delivery-card__content"><span>Order-linked PDF delivery</span><h3>Branded PDF</h3><p>Use the configured organizer identity and invoice labels.</p></div>
