<script>
  const regionSteps = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-region-step]"));
  regionSteps.forEach((item) => {
    const summary = item.querySelector("summary");
    const trigger = item.querySelector<HTMLButtonElement>(".igt-region-step__arrow");

    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      item.open = !item.open;
    });

    item.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(item.open));
      trigger?.setAttribute("aria-label", `${item.open ? "Collapse" : "Expand"} regional configuration`);
      if (item.open) regionSteps.forEach((other) => { if (other !== item) other.open = false; });
    });
  });

  const deliverySection = document.querySelector<HTMLElement>(".igt-delivery-shell");
  const deliveryHeader = deliverySection?.querySelector<HTMLElement>(".igt-delivery-header");
  const deliveryCards = deliverySection?.querySelectorAll<HTMLElement>(".igt-delivery-card");
  const finalDeliveryCard = deliveryCards?.[deliveryCards.length - 1];

  if (deliveryHeader && finalDeliveryCard) {
    let deliveryFrame = 0;
    const syncDeliveryRelease = () => {
      deliveryFrame = 0;
      const stickyTop = Number.parseFloat(getComputedStyle(finalDeliveryCard).top) || 0;
      const releaseOffset = Math.min(0, finalDeliveryCard.getBoundingClientRect().top - stickyTop);
      deliveryHeader.style.transform = `translateY(${releaseOffset}px)`;
    };
    const queueDeliveryRelease = () => {
      if (deliveryFrame) return;
      deliveryFrame = requestAnimationFrame(syncDeliveryRelease);
    };
    window.addEventListener("scroll", queueDeliveryRelease, { passive: true });
    window.addEventListener("resize", queueDeliveryRelease, { passive: true });
    syncDeliveryRelease();
  }

  const connectedSuite = document.querySelector<HTMLElement>(".igt-connected");
  if (connectedSuite) {
    const connectedTabs = Array.from(connectedSuite.querySelectorAll<HTMLButtonElement>(".igt-connected__tab"));
    const connectedPanels = Array.from(connectedSuite.querySelectorAll<HTMLElement>(".igt-connected__panel"));
    let connectedRotationId: number | undefined;

    const activateConnectedTab = (tab: HTMLButtonElement) => {
      const target = tab.dataset.connectedTarget;
      connectedTabs.forEach((item) => {
        item.classList.remove("igt-connected__tab--active");
        item.setAttribute("aria-selected", "false");
      });
      connectedPanels.forEach((panel) => panel.classList.remove("igt-connected__panel--active"));
      tab.classList.add("igt-connected__tab--active");
      tab.setAttribute("aria-selected", "true");
      connectedSuite.querySelector<HTMLElement>(`[data-connected-panel="${target}"]`)?.classList.add("igt-connected__panel--active");
    };

    const stopConnectedRotation = () => {
      if (connectedRotationId === undefined) return;
      window.clearInterval(connectedRotationId);
      connectedRotationId = undefined;
    };

    const startConnectedRotation = () => {
      stopConnectedRotation();
      if (connectedTabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      connectedRotationId = window.setInterval(() => {
        const currentIndex = connectedTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
        activateConnectedTab(connectedTabs[(currentIndex + 1) % connectedTabs.length]);
      }, 4000);
    };

    connectedTabs.forEach((tab) => tab.addEventListener("click", () => {
      activateConnectedTab(tab);
      startConnectedRotation();
    }));
    connectedSuite.addEventListener("mouseenter", stopConnectedRotation);
    connectedSuite.addEventListener("mouseleave", startConnectedRotation);
    connectedSuite.addEventListener("focusin", stopConnectedRotation);
    connectedSuite.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !connectedSuite.contains(event.relatedTarget)) startConnectedRotation();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? stopConnectedRotation() : startConnectedRotation());
    startConnectedRotation();
  }

  const invoiceFaqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-invoice-faq]"));
  invoiceFaqItems.forEach((item) => item.addEventListener("toggle", () => {
    if (item.open) invoiceFaqItems.forEach((other) => { if (other !== item) other.open = false; });
  }));
</script>

