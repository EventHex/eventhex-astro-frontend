---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import BadgeBuilderPage from "../components/badge-builder/BadgeBuilderPage.astro";

const title = "Event Badge Builder & Badge Designer Software | EventHex";
const description = "Design branded event badges from attendee, ticket and registration data, set a design per audience, then print them in bulk or at the registration desk.";
const url = "https://eventhex.ai/badge-builder/";
const ogImage = "https://eventhex.ai/feature-images/badge-builder/og-badge-builder.jpg";
const faqs: [string, string][] = [
  ["Can we print badges at the venue as people arrive?", "Yes. In the EventHex Event Day Portal, staff scan the attendee's QR code or search their name, attendance is marked, and the badge you designed prints straight away on a connected label printer."],
  ["Which badge printers work?", "Event-day printing sends labels to Zebra and other thermal label printers through the EventHex Print Agent or QZ Tray. Pre-printed badges can be exported as a PDF for any office printer. See Event Badge Printing for the full desk setup."],
  ["Can we use registration form answers on a badge?", "Yes. The builder loads common and custom form fields alongside attendee, event, ticket, booth and exhibitor fields. Output depends on the data being present."],
  ["Can different ticket types use different designs?", "Yes. Badges support a common design for all tickets, or a specific design for chosen tickets or participant types."],
  ["Can a badge contain a QR code?", "Yes. The QR element supports size, colour, padding and position controls. Test the printed QR with the exact scanner and media."],
  ["Can we print badges in bulk and track reprints?", "Yes. Select registrations and export one print-ready PDF. Print and download counts are kept per attendee, and the Event Day Portal logs who printed each badge and when."],
];
const softwareSchema = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "EventHex Badge Builder", applicationCategory: "BusinessApplication", operatingSystem: "Web", url, description, creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" }, featureList: ["Data-bound badge layouts", "Common and ticket-specific badge designs", "QR code controls", "Bulk badge PDF export", "Scan-to-print onsite badge printing", "Print count tracking"] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---
<MarketingLayout title={title} description={description} canonical={url} ogImage={ogImage}>
  <BadgeBuilderPage faqs={faqs} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</MarketingLayout>
