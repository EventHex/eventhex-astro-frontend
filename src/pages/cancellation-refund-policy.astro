---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { getPageBySlug, rewriteContentUrls } from "../lib/wordpress";

const page = await getPageBySlug("cancellation-refund-policy");

if (!page) {
  Astro.response.status = 404;
}

const title = page ? `${page.title.rendered} | EventHex` : "Cancellation & Refund Policy | EventHex";
const description = "EventHex Cancellation & Refund Policy — our policies on cancellations, refunds, and event changes.";
const content = page ? rewriteContentUrls(page.content.rendered) : "";
const legalTitle: string = page ? page.title.rendered : "Cancellation & Refund Policy";
const legalWords = legalTitle.split(" ");
const legalTailCount = legalWords.length > 2 ? 2 : 1;
const legalTail = legalWords.slice(-legalTailCount).join(" ");
const legalHead = legalWords.slice(0, -legalTailCount).join(" ");
---

<MarketingLayout title={title} description={description}>
  <section class="legal-page">
    <div class="legal-hero ds-stage">
      <h1 class="legal-hero__title ds-h1">{legalHead}{legalHead ? " " : ""}<span class="ds-hl">{legalTail}</span></h1>
    </div>
    <div class="legal-page__inner">
      <div class="legal-page__content" set:html={content} />
    </div>
  </section>

  <style>
    .legal-page { background: var(--ds-white); }
    .legal-hero { padding: clamp(7rem, 10vw, 9rem) var(--ds-gutter) clamp(2.5rem, 5vw, 4rem); text-align: center; }
    .legal-hero__title { font-size: clamp(2rem, 4vw, 3.25rem); max-width: 48rem; margin: 0 auto; }
    .legal-page__inner {
      max-width: 46rem;
      margin: 0 auto;
      padding: clamp(2.5rem, 5vw, 4rem) var(--ds-gutter) clamp(3.5rem, 7vw, 6rem);
    }
    .legal-page__content {
      font-family: var(--ds-font-body);
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--ds-ink);
    }
    .legal-page__content :global(h2) {
      font-family: var(--ds-font-heading);
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1.25;
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      color: var(--ds-ink);
    }
    .legal-page__content :global(h3) {
      font-family: var(--ds-font-heading);
      font-size: 1.25rem;
      font-weight: 500;
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      color: var(--ds-ink);
    }
    .legal-page__content :global(p) { margin-bottom: 1rem; }
    .legal-page__content :global(ul),
    .legal-page__content :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
    .legal-page__content :global(li) { margin-bottom: 0.5rem; }
    .legal-page__content :global(a) { color: var(--ds-blue); text-decoration: underline; text-underline-offset: 2px; }
    .legal-page__content :global(a:hover) { color: var(--ds-blue-hover); }
    .legal-page__content :global(strong) { font-weight: 600; color: var(--ds-ink); }
    .legal-page__content :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  </style>
</MarketingLayout>
