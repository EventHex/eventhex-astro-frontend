---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Conference Session Management Software | EventHex";
const description = "Build multi-day, multi-track event agendas with stages, session types, speakers, booking rules, attendee access, and a connected mobile schedule in EventHex.";

const lifecycle = [
  ["Structure", "Days + stages"],
  ["Classify", "Types + tracks"],
  ["Assign", "Speakers + roles"],
  ["Control", "Tickets + booking"],
  ["Publish", "Mobile agenda"],
  ["Continue", "Engage + recap"],
];

const sessionModels = [
  ["Normal session", "Set title, type, track, stage, timing, speakers, and access.", "Talks, panels, workshops"],
  ["Break", "Reserve non-content time in the same agenda.", "Lunch, networking, transitions"],
  ["Sub-session", "Nest a breakout or parallel activity under its parent session.", "Breakouts and grouped programmes"],
];

const narrativeCards = [
  {
    eyebrow: "Multi-track scheduling",
    title: "See the programme by day and stage—then move what changed",
    description: "Switch between agenda and timeline views, filter the programme, and reschedule a session from the timeline when the run-of-show moves.",
    image: "/feature-images/session-management/timeline-stack-card-v2.svg",
    alt: "EventHex timeline with sessions arranged across programme stages",
    width: 672,
    height: 584,
  },
  {
    eyebrow: "Clear programme structure",
    title: "Give every session the context organizers and attendees need",
    description: "Keep stages, session types, tracks, start and end times, descriptions, and parent relationships on the agenda record instead of encoding the programme in titles alone.",
    image: "/feature-images/session-management/session-types-v2.svg",
    alt: "EventHex session type and programme structure controls",
    width: 771,
    height: 584,
  },
  {
    eyebrow: "Speaker connection",
    title: "Put the right people—and the right role—on each session",
    description: "Select speakers from the event, assign a role for this session, preserve their order, and continue to Speaker Management for profiles, collection, and broader coordination.",
    image: "/feature-images/session-management/portal-session-assignment.jpg",
    alt: "EventHex session workspace showing assigned speakers and their session roles",
    width: 1280,
    height: 720,
  },
];

const accessControls = [
  ["Attendance limit", "Turn on a session limit and set the available capacity.", "capacity"],
  ["Ticket eligibility", "Choose which event ticket types can access the session.", "tickets"],
  ["Booking cap", "Set the maximum number of sessions an attendee can book.", "cap"],
  ["Conflict prevention", "Block overlapping session bookings when that event rule is enabled.", "conflict"],
  ["Cancellation policy", "Allow cancellations and define the cutoff before a session starts.", "cancel"],
];

const connectedWorkflows = [
  {
    id: "speakers",
    title: "Speaker Management",
    description: "Collect profiles and coordinate the wider speaker workflow.",
    checklist: ["Collect speaker profiles", "Coordinate the wider workflow", "Keep speaker roles tied to sessions"],
    href: "/speaker-management/",
    image: "/feature-images/speaker-management/use-case-panel-speakers.jpg",
    imageAlt: "EventHex speaker roles connected to a session",
    width: 1117,
    height: 837,
  },
  {
    id: "polling",
    title: "Live Polling & Q&A",
    description: "Run live questions, polls, and feedback around the session.",
    checklist: ["Run live audience questions", "Launch in-session polls", "Collect session feedback"],
    href: "/live-polling-qa/",
    image: "/feature-images/speaker-management/audience-engagement-dashboard.png",
    imageAlt: "EventHex audience engagement dashboard for a live session",
    width: 762,
    height: 696,
  },
  {
    id: "notifications",
    title: "Event Notifications",
    description: "Send event and session updates through the configured channels.",
    checklist: ["Send event updates", "Send session updates", "Use configured delivery channels"],
    href: "/event-notifications/",
    image: "/feature-images/session-management/engagement-card-visual.svg",
    imageAlt: "EventHex attendee engagement and session communication view",
    width: 674,
    height: 705,
  },
  {
    id: "recap",
    title: "AI Session Recap",
    description: "Turn supported session media into an attendee-facing recap experience.",
    checklist: ["Use supported session media", "Create an attendee-facing recap", "Continue post-session content"],
    href: "/ai-session-recap/",
    image: "/feature-images/ai-session-recap/attendee-recap-summary.webp",
    imageAlt: "EventHex attendee-facing AI session recap",
    width: 2880,
    height: 1560,
  },
];

const eventFormats = [
  {
    title: "Conferences",
    description: "Coordinate multi-track talks, panels, and breakouts.",
    bullets: ["Multi-day programme structure", "Parallel tracks and stages", "Talks, panels, and breakouts"],
    image: "/feature-images/speaker-management/use-case-multi-track.jpg",
    imageAlt: "EventHex multi-track conference programme timeline",
    width: 1117,
    height: 837,
  },
  {
    title: "Associations",
    description: "Run member programmes across days and stages.",
    bullets: ["Session types and tracks", "Speaker roles and timing", "Attendee agenda publishing"],
    image: "/feature-images/speaker-management/session-scheduling-dashboard.png",
    imageAlt: "EventHex programme scheduling dashboard for an association event",
    width: 762,
    height: 696,
  },
  {
    title: "Exhibitions",
    description: "Connect content stages to the wider exhibition schedule.",
    bullets: ["Content-stage schedules", "Session types and tracks", "Mobile agenda publishing"],
    image: "/feature-images/session-management/timeline-view.jpeg",
    imageAlt: "EventHex exhibition content-stage schedule",
    width: 1024,
    height: 480,
  },
  {
    title: "Corporate events",
    description: "Plan leadership, training, and internal programme blocks.",
    bullets: ["Leadership programme blocks", "Training session formats", "Capacity and booking rules"],
    image: "/feature-images/speaker-management/use-case-panel-speakers.jpg",
    imageAlt: "EventHex corporate event programme and speaker roles",
    width: 1117,
    height: 837,
  },
  {
    title: "Tech conferences",
    description: "Organize product, developer, and partner tracks.",
    bullets: ["Product and developer tracks", "Partner programme stages", "Speaker roles and session detail"],
    image: "/feature-images/session-management/detail-panel.png",
    imageAlt: "EventHex tech conference session detail and speaker lineup",
    width: 424,
    height: 524,
  },
  {
    title: "Recorded events",
    description: "Keep session timing and speakers connected to the recap workflow.",
    bullets: ["Session timing and speakers", "Supported recap workflow", "Attendee-facing follow-up"],
    image: "/feature-images/ai-session-recap/attendee-recap-summary.webp",
    imageAlt: "EventHex attendee-facing recap for a recorded session",
    width: 2880,
    height: 1560,
  },
];

const controlActions = [
  ["Move the time", "Reschedule from the timeline."],
  ["Change the stage", "Update where the session belongs."],
  ["Refine the track", "Keep attendee filtering useful."],
  ["Update the lineup", "Adjust speakers and their session roles."],
  ["Review access", "Recheck capacity and ticket eligibility."],
];

const faqItems = [
  ["Can EventHex manage a multi-day, multi-track agenda?", "Yes. Sessions can be organized by date and stage, categorized with types and tracks, and reviewed in agenda or timeline views."],
  ["Can we create breakouts under a main session?", "Yes. A sub-session can be attached to a parent session. The session form also supports normal sessions and breaks as separate modes."],
  ["Can organizers move sessions after the agenda is built?", "The organizer timeline supports dragging a session to a new time. Review downstream attendee communication whenever a published schedule changes."],
  ["Can session access depend on ticket type?", "The session record supports ticket selection and an optional attendance limit. Confirm the intended ticket and capacity setup during the demo."],
  ["Can EventHex prevent attendees from booking overlapping sessions?", "An event booking rule can prevent time conflicts. Organizers can also set a booking cap and cancellation policy; these controls should be configured for the event."],
  ["Where do polls, Q&A, notifications, and AI recaps fit?", "They are connected session workflows, but each has its own feature page and setup. Session Management owns the agenda and session record that those workflows use."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Session Management",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://eventhex.ai/session-management/",
  description,
  creator: { "@type": "Organization", name: "EventHex", url: "https://eventhex.ai" },
  featureList: [
    "Multi-day and multi-stage programme structure",
    "Normal sessions, breaks, and nested sub-sessions",
    "Agenda and timeline views",
    "Timeline rescheduling",
    "Session type, speaker, and track filters",
    "Per-session speaker roles",
    "Attendance limits and ticket access",
    "Configurable attendee booking rules",
    "Attendee agenda and saved sessions",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/session-management/"
  footerCtaEyebrow="Map Your Programme"
  footerCtaTitle="Bring Your Agenda Structure to the Demo"
  footerCtaSubtitle="Show us the days, stages, tracks, session formats, speaker assignments, and attendee booking rules you need. We’ll map them to the EventHex session workflow."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
  footerCtaImageSrc="/feature-images/session-management/cta-illustration.svg"
  footerCtaImageAlt="EventHex session management agenda workflow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="smr-page-bg">
    <section class="smr-hero ds-stage" aria-labelledby="smr-hero-title">
      <div class="smr-hero__grid">
        <div class="smr-hero__content">
          <span class="smr-hero__badge animate-on-scroll" data-animation="fadeInDown">Conference session management software</span>
          <h1 id="smr-hero-title" class="smr-hero__title ds-h1 animate-on-scroll" data-animation="fadeInUp">Build a <span class="ds-hl">multi-track event agenda</span> your team can keep under control</h1>
          <p class="smr-hero__desc animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 800ms">Plan sessions across days and stages, connect speakers and access rules, and publish a clear attendee agenda—without splitting the programme across disconnected tools.</p>
          <div class="smr-hero__cta-row animate-on-scroll" data-animation="fadeInUp" style="--anim-duration: 1000ms">
            <a href="/book-a-demo/" class="smr-hero__btn ds-btn">Book a Demo <span aria-hidden="true">→</span></a>
            <a href="#session-workflow" class="smr-hero__btn ds-btn--ghost">See the workflow</a>
          </div>
          <div class="smr-hero__trust animate-on-scroll" data-animation="fadeIn" style="--anim-duration: 1150ms">
            <span class="smr-hero__trust-item">Structure the full programme</span>
            <span class="smr-hero__trust-item">Move sessions as plans change</span>
            <span class="smr-hero__trust-item">Keep attendee access connected</span>
          </div>
        </div>
        <div class="smr-hero__visual animate-on-scroll" data-animation="fadeInRight">
          <div class="smr-hero__visual-card ds-glass"><div class="smr-hero__visual-inner">
            <img src="/feature-images/session-management/hero-visual.svg" alt="EventHex multi-track session agenda with stages, speakers, and attendee access" width="811" height="592" loading="eager" decoding="async" />
          </div></div>
        </div>
      </div>
    </section>

    <section id="session-workflow" class="smr-lifecycle" aria-label="Session management workflow">
      <div class="smr-lifecycle__inner">
        {lifecycle.map(([value, label]) => <span class="smr-lifecycle__item"><b>{value}</b>{label}</span>)}
      </div>
    </section>

    <section class="smr-models-section ds-stage" aria-labelledby="smr-models-title">
      <div class="smr-models-shell">
        <header class="smr-models-heading">
          <span class="smr-models-eyebrow animate-on-scroll" data-animation="fadeInDown">Model the programme</span>
          <h2 id="smr-models-title" class="smr-models-title ds-h2 animate-on-scroll" data-animation="fadeInUp">
            <span class="smr-models-title__line">Create the Right Block for Every</span>
            <span class="smr-models-title__line">Part of the <span class="ds-hl">Run-of-Show</span></span>
          </h2>
          <p class="smr-models-subtitle animate-on-scroll" data-animation="fadeInUp">Use a standard session for scheduled content, a break for programme gaps, or a nested sub-session when one block branches into smaller experiences.</p>
        </header>

        <div class="smr-models-grid">
          <span class="smr-models-notch smr-models-notch--one" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path></svg></span>
          <span class="smr-models-notch smr-models-notch--two" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path></svg></span>
          <span class="smr-models-notch smr-models-notch--tablet" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path></svg></span>
          {sessionModels.map(([model, copy, cue], index) => (
            <article class="smr-models-card ds-glass animate-on-scroll" data-animation="fadeInUp" data-delay={index * 60}>
              {index === 2 && <span class="smr-models-cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(-90)"></path></svg></span>}
              <div class="smr-models-card__icon">
                {index === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18M7 14h3M14 14h3M7 18h3"></path></svg>}
                {index === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 8h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8ZM16 10h2a3 3 0 0 1 0 6h-2M4 21h14"></path></svg>}
                {index === 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="16" width="7" height="5" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect><path d="M6.5 8v4h11v4M6.5 12v4"></path></svg>}
              </div>
              <h3>{model}</h3>
              <p>{copy} <span class="smr-models-card__cue">{cue}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="smr-stories ds-night" aria-labelledby="smr-stories-title">
      <div class="smr-stories__section">
        <header class="smr-stories__header">
          <span class="smr-stories__eyebrow"><span class="smr-stories__eyebrow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M10.5 3c.4 2.6 1.2 4.3 2.4 5.5S15.9 10.1 18.5 10.5c-2.6.4-4.3 1.2-5.6 2.5S10.9 15.9 10.5 18.5c-.4-2.6-1.2-4.3-2.5-5.6S5.1 10.9 2.5 10.5c2.6-.4 4.3-1.2 5.5-2.5S10.1 5.6 10.5 3Z" style="fill:var(--ds-blue)"></path><path d="M17.5 13c.2 1.3.6 2.1 1.2 2.8s1.5 1 2.8 1.2c-1.3.2-2.1.6-2.8 1.2s-1 1.5-1.2 2.8c-.2-1.3-.6-2.1-1.2-2.8s-1.5-1-2.8-1.2c1.3-.2 2.1-.6 2.8-1.2s1-1.5 1.2-2.8Z" style="fill:var(--ds-violet)"></path></svg></span>One connected agenda record</span>
          <h2 id="smr-stories-title" class="ds-h2"><span>Shape the Programme, Preserve Its Context,</span><span>and <em class="ds-hl-dark">Connect the Lineup</em></span></h2>
        </header>
        <div class="smr-stories__cards">
          {narrativeCards.map((card, index) => (
            <article class="smr-story-card" style={`--card-index: ${index};`}>
              <div class="smr-story-card__content">
                <span class="smr-story-card__eyebrow">{card.eyebrow}</span><h3>{card.title}</h3><p>{card.description}</p>
                <a href={index === 2 ? "/speaker-management/" : "/book-a-demo/"} class="smr-story-card__link ds-btn--light">{index === 2 ? "Explore Speaker Management" : "See it in a demo"}</a>
              </div>
              <div class:list={["smr-story-card__media", index === 2 ? "smr-story-card__media--portal" : "smr-story-card__media--animated"]}>
                {index === 2 ? (
                  <div class="smr-story-card__capture-stack">
                    <figure class="smr-story-card__capture smr-story-card__capture--session">
                      <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
                    </figure>
                    <figure class="smr-story-card__capture smr-story-card__capture--speakers">
                      <img src="/feature-images/session-management/portal-speaker-directory.jpg" alt="EventHex speaker directory showing connected speaker profiles and designations" width="1280" height="720" loading="lazy" decoding="async" />
                    </figure>
                  </div>
                ) : (
                  <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
                )}
              </div>
            </article>
          ))}
          <div class="smr-stories__spacer" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="smr-evidence ds-stage" aria-labelledby="smr-attendee-title">
      <div class="smr-evidence__header animate-on-scroll" data-animation="fadeInUp">
        <span class="smr-eyebrow">Attendee agenda</span><h2 id="smr-attendee-title" class="ds-h2">Turn the Organizer Schedule Into a <span class="ds-hl">Programme Attendees Can Navigate</span></h2>
        <p>Publish the same session structure into the event app so attendees can browse the programme and return to saved sessions.</p>
      </div>
      <div class="smr-evidence__grid ds-glass">
        <span class="smr-evidence__notch smr-evidence__notch--top" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path></svg></span>
        <span class="smr-evidence__notch smr-evidence__notch--bottom" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="scale(1,-1)"></path></svg></span>
        <article class="smr-evidence-row">
          <div class="smr-evidence-row__media"><div class="smr-evidence-stage smr-evidence-stage--agenda"><div class="smr-evidence-portal-window smr-evidence-portal-window--agenda"><img src="/feature-images/session-management/attendee-agenda-list.jpg" alt="EventHex agenda workspace organized by event date, time, stage, and session" width="1280" height="720" loading="lazy" decoding="async" /></div></div></div>
          <div class="smr-evidence-row__copy"><span>01 · Browse by date</span><h3>Move through the event programme day by day</h3><p>Keep each day’s sessions in the same agenda structure used by the organizer workspace.</p></div>
          <span class="smr-evidence-row__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(-90)"></path></svg></span>
        </article>
        <article class="smr-evidence-row smr-evidence-row--reverse">
          <div class="smr-evidence-row__copy"><span>02 · Filter by stage</span><h3>Focus on the stage or room that matters now</h3><p>Let attendees narrow a busy multi-track programme without losing the wider schedule.</p></div>
          <div class="smr-evidence-row__media"><div class="smr-evidence-stage smr-evidence-stage--filter"><div class="smr-stage-filter" aria-hidden="true"><span>All stages</span><span class="is-active">Main Stage</span><span>Stage A</span><span>Stage B</span></div></div></div>
          <span class="smr-evidence-row__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(-90)"></path></svg></span>
        </article>
        <article class="smr-evidence-row">
          <div class="smr-evidence-row__media smr-evidence-row__media--portrait"><div class="smr-evidence-stage smr-evidence-stage--detail"><div class="smr-evidence-portal-window smr-evidence-portal-window--detail"><img src="/feature-images/session-management/attendee-session-detail.jpg" alt="EventHex session record showing format, start and end times, stage, and speaker controls" width="1280" height="720" loading="lazy" decoding="async" /></div></div></div>
          <div class="smr-evidence-row__copy"><span>03 · Open session detail</span><h3>See timing, stage, format, speakers, and available actions</h3><p>The session record carries the context attendees need when they move from the agenda into a specific talk or workshop.</p></div>
          <span class="smr-evidence-row__cross" aria-hidden="true"><svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="scale(1,-1)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(90)"></path><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" style="fill:var(--ds-line-strong)" transform="rotate(-90)"></path></svg></span>
        </article>
        <article class="smr-evidence-row smr-evidence-row--reverse">
          <div class="smr-evidence-row__copy"><span>04 · Return to saved sessions</span><h3>Use the saved-session view as a personal agenda shortcut</h3><p>Attendees can get back to the sessions they selected without rebuilding their plan from the full programme.</p></div>
          <div class="smr-evidence-row__media"><div class="smr-evidence-stage smr-evidence-stage--saved"><div class="smr-saved-list" aria-hidden="true">
            <div><i>09:00</i><span><b>Opening keynote</b><small>Main Stage</small></span><em>Saved</em></div>
            <div><i>10:15</i><span><b>Product track</b><small>Stage A</small></span><em>Saved</em></div>
            <div><i>11:30</i><span><b>Breakout groups</b><small>Stage B</small></span><em>Saved</em></div>
          </div></div></div>
        </article>
      </div>
    </section>

