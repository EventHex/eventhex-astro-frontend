  .smr-format-step__arrow { position: absolute; top: 24px; right: 28px; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--ds-line-strong); border-radius: 50%; background: color-mix(in srgb, var(--ds-white) 80%, transparent); color: var(--ds-ink); transition: transform .25s ease, background .2s ease, border-color .2s ease; }
  .smr-format-step__arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .smr-format-steps details[open] { display: flex; align-items: stretch; border-radius: var(--ds-r-xl); background: linear-gradient(135deg, var(--smr-format-tint) 0%, var(--ds-white) 72%); }
  .smr-format-steps details[open] summary { flex: 0 0 55%; display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: start; gap: 14px; min-height: 0; padding: 64px 40px 64px 28px; background: transparent; }
  .smr-format-steps details[open] .smr-format-step__number { color: var(--ds-ink); font-size: 26px; line-height: 1; }
  .smr-format-steps details[open] .smr-format-step__content h3 { margin-bottom: 16px; color: var(--ds-ink); font: 500 32px/1.2 var(--font-heading); }
  .smr-format-steps details[open] .smr-format-step__content p { display: block; max-width: 90%; margin: 0 0 32px; color: var(--ds-body); font: 400 17px/1.6 var(--font-body); }
  .smr-format-steps details[open] .smr-format-step__content ul { display: flex; flex-direction: column; gap: 18px; margin: 0; padding: 0; list-style: none; }
  .smr-format-steps details[open] .smr-format-step__content li { display: flex; align-items: center; gap: 14px; color: var(--ds-ink); font: 500 16px/1.4 var(--font-body); }
  .smr-format-steps details[open] .smr-format-step__content li i { color: var(--ds-blue); font-size: 16px; font-style: normal; }
  .smr-format-steps details[open] .smr-format-step__arrow { top: 28px; transform: rotate(180deg); }
  .smr-format-step__visual { display: none; margin: 0; opacity: 0; }
  .smr-format-steps details[open] .smr-format-step__visual { flex: 0 0 45%; display: flex; align-items: center; justify-content: flex-start; padding: 40px 88px 40px 0; opacity: 1; }
  .smr-format-step__visual img { display: block; width: 100%; max-width: 400px; height: auto; max-height: 360px; object-fit: contain; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); box-shadow: var(--ds-shadow-shot); }

  .smr-control-use { padding: var(--ds-section-y) 24px; }
  .smr-control-use__shell { max-width: var(--ds-container); margin: 0 auto; }
  .smr-control-use__heading { max-width: none; margin: 0; padding: 0 0 clamp(32px, 3.5vw, 48px); text-align: center; }
  .smr-control-use__heading h2 { max-width: none; margin: 0 auto 16px; }
  .smr-control-use__heading h2 span { display: block; }
  .smr-control-use__heading p { max-width: 760px; margin: 0 auto; color: var(--ds-body); font: 400 17px/1.6 var(--font-body); }
  .smr-control-use__grid { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .smr-control-use__card { position: relative; min-width: 0; min-height: 280px; padding: 28px 24px; }
  .smr-control-use__icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin-bottom: 28px; color: var(--ds-blue); }
  .smr-control-use__icon svg { width: 100%; height: 100%; stroke-linecap: round; stroke-linejoin: round; }
  .smr-control-use__card h3 { max-width: 230px; min-height: 2.3em; margin: 0 0 20px; color: var(--ds-ink); font: 500 21px/1.15 var(--font-heading); }
  .smr-control-use__card p { margin: 14px 0 0; color: var(--ds-body); font: 400 15px/1.5 var(--font-body); }

  .smr-stories { width: 100%; }
  .smr-stories__section { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 1140px; margin: 0 auto; padding: 4px 0 30px; }
  .smr-stories__header { position: sticky; top: 69px; z-index: 20; isolation: isolate; width: min(94%, 1050px); margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 24px 0; text-align: center; will-change: transform; }
  .smr-stories__header::before { content: ""; position: absolute; z-index: -1; inset: -1px 50% -28px auto; width: 100vw; transform: translateX(50%); background: linear-gradient(180deg, var(--ds-night) 0%, color-mix(in srgb, var(--ds-night) 96%, transparent) 72%, transparent); pointer-events: none; }
  .smr-stories__eyebrow { display: flex; align-items: center; justify-content: center; gap: 8px; width: fit-content; padding: 6px 16px 6px 12px; border: 1px solid var(--ds-glass-dark-edge); border-radius: 999px; background: color-mix(in srgb, var(--ds-white) 12%, transparent); color: var(--ds-on-night); box-shadow: var(--ds-glass-dark-shadow); backdrop-filter: blur(16px); font: 500 15px/24px var(--font-body); }
  .smr-stories__eyebrow-icon { display: flex; width: 16px; height: 16px; }
  .smr-stories__eyebrow-icon svg { width: 100%; height: 100%; }
  .smr-stories__header h2 { margin: 0; line-height: 1.15; }
  .smr-stories__header h2 > span { display: block; }
  .smr-stories__header h2 em { font-style: normal; }
  .smr-stories__cards { --smr-stack-top: 300px; position: relative; width: 100%; padding: 40px 0 50px; }
  .smr-story-card { position: sticky; top: calc(var(--smr-stack-top) + var(--card-index) * 20px); z-index: var(--card-index); display: flex; align-items: stretch; height: 500px; margin-bottom: 60px; overflow: hidden; border: 1px solid var(--ds-glass-dark-edge); border-radius: var(--ds-r-xl); background: radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--ds-indigo) 28%, transparent) 0%, transparent 45%), linear-gradient(150deg, var(--ds-night-card) 0%, var(--ds-night) 72%); box-shadow: var(--ds-glass-dark-shadow); transition: transform .3s ease, box-shadow .3s ease; }
  .smr-story-card__content { flex: 0 0 45%; display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 40px; }
  .smr-story-card__eyebrow { align-self: flex-start; padding: 7px 13px; border: 1px solid color-mix(in srgb, var(--ds-violet-soft) 28%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--ds-violet-soft) 10%, transparent); color: var(--ds-on-night-accent); font: 500 12px/1.2 var(--font-body); }
  .smr-story-card h3 { margin: 0; color: var(--ds-on-night); font: 500 32px/1.2 var(--font-heading); }
  .smr-story-card p { margin: 0; color: var(--ds-on-night-body); font: 400 17px/1.65 var(--font-body); }
  .smr-story-card__link { align-self: flex-start; margin-top: 8px; }
  .smr-story-card__media { flex: 1; display: flex; align-items: center; justify-content: center; margin: 16px 16px 16px 0; padding: 20px; overflow: hidden; border: 1px solid var(--ds-glass-dark-edge); border-radius: var(--ds-r-lg); background: var(--ds-glass-dark-fill); box-shadow: inset 0 1px 0 var(--ds-glass-dark-edge); backdrop-filter: blur(24px); }
  .smr-story-card__media img { width: 100%; height: 100%; object-fit: contain; }
  .smr-story-card__media--animated img { animation: smr-float 4s ease-in-out infinite; }
  .smr-story-card__media--portal { padding: 14px; }
  .smr-story-card__capture-stack { position: relative; width: 100%; height: 100%; }
  .smr-story-card__capture { position: absolute; margin: 0; overflow: hidden; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-sm); background: var(--ds-white); box-shadow: var(--ds-shadow-hero); }
  .smr-story-card__capture--session { top: 2%; left: 0; width: 92%; aspect-ratio: 16 / 9; }
  .smr-story-card__capture--session img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .smr-story-card__capture--speakers { right: 0; bottom: 2%; z-index: 2; width: 76%; aspect-ratio: 3.2 / 1; }
  .smr-story-card__capture--speakers img { position: absolute; top: -88%; left: -50%; width: 188%; height: auto; max-width: none; object-fit: initial; }
  .smr-stories__spacer { height: 190px; }

  .smr-access-band { --band-p: 0; --band-gap: calc((1 - var(--band-p)) * clamp(16px, 3.5vw, 56px)); position: relative; overflow: hidden; padding: clamp(64px, 8vw, 96px) 0 0; clip-path: inset(0 var(--band-gap) round calc((1 - var(--band-p)) * 28px)); will-change: clip-path; }
  .smr-access-band > * { position: relative; z-index: 1; }
  .smr-access-heading { max-width: 980px; margin: 0 auto; padding: 0 24px 8px; text-align: center; }
  .smr-access-heading .smr-eyebrow { color: var(--ds-on-night-accent); }
  .smr-access-heading h2 span { display: block; }
  .smr-access-heading p { color: var(--ds-on-night-body); }
  .smr-access-grid-shell { max-width: 1140px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) 24px clamp(56px, 7vw, 88px); }
  .smr-access-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; }
  .smr-access-card { position: relative; grid-column: span 2; display: flex; flex-direction: column; min-height: 340px; padding: 32px 28px; }
  .smr-access-card:nth-child(n + 4) { grid-column: span 3; }
  .smr-access-card h3 { margin: 0 0 14px; color: var(--ds-on-night); font: 500 20px/1.25 var(--font-heading); letter-spacing: -.01em; }
  .smr-access-card p { max-width: 34ch; margin: 0; color: var(--ds-on-night-body); font: 400 .9375rem/1.45 var(--font-body); }
  .smr-access-visual { position: relative; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; margin-top: 24px; }
  .smr-access-visual::before { content: ""; position: absolute; left: 50%; bottom: -10%; width: 80%; height: 80%; transform: translateX(-50%); border-radius: 50%; filter: blur(30px); background: radial-gradient(closest-side, color-mix(in srgb, var(--ds-blue) 30%, transparent), color-mix(in srgb, var(--ds-indigo) 16%, transparent) 55%, transparent 100%); animation: smr-cap-bloom 6s ease-in-out infinite; }
  .smr-access-visual > * { position: relative; z-index: 1; }
  .smr-capacity-meter, .smr-ticket-list, .smr-rule-field, .smr-rule-toggle { width: 100%; max-width: 290px; padding: 16px; border: 1px solid transparent; border-radius: var(--ds-r-lg); background: linear-gradient(var(--ds-night), var(--ds-night)) padding-box, linear-gradient(135deg, var(--ds-cyan) 0%, var(--ds-blue) 38%, var(--ds-indigo) 70%, var(--ds-violet) 100%) border-box; box-shadow: 0 18px 44px -22px color-mix(in srgb, var(--ds-blue) 55%, transparent); animation: smr-cap-float 7s ease-in-out infinite; }
  .smr-capacity-meter > span { display: block; height: 10px; margin-bottom: 14px; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--ds-white) 10%, transparent); }
  .smr-capacity-meter i { display: block; width: 70%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, color-mix(in srgb, var(--ds-success) 55%, white), var(--ds-success)); }
  .smr-capacity-meter b, .smr-rule-field b { color: var(--ds-on-night); font: 500 14px/1.4 var(--font-body); }
  .smr-ticket-list { display: grid; gap: 8px; }
  .smr-ticket-list span { padding: 10px 12px; border: 1px solid color-mix(in srgb, var(--ds-white) 10%, transparent); border-radius: var(--ds-r-sm); color: var(--ds-on-night-body); font: 500 13px/1.2 var(--font-body); }
  .smr-ticket-list .is-active { border-color: transparent; background: linear-gradient(135deg, var(--ds-night-card), var(--ds-night)) padding-box, linear-gradient(135deg, var(--ds-cyan), var(--ds-blue) 38%, var(--ds-indigo) 70%, var(--ds-violet)) border-box; color: var(--ds-on-night); }
  .smr-rule-field small { display: block; margin-bottom: 8px; color: var(--ds-on-night-muted); font: 500 12px/1.3 var(--font-body); }
  .smr-rule-toggle { display: flex; align-items: center; justify-content: space-between; color: var(--ds-on-night); font: 500 13px/1.4 var(--font-body); }
  .smr-rule-toggle i { position: relative; width: 42px; height: 24px; border-radius: 999px; background: var(--ds-blue); }
  .smr-rule-toggle i::after { content: ""; position: absolute; top: 4px; right: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--ds-white); }

  @keyframes smr-cap-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes smr-cap-bloom { 0%, 100% { opacity: .68; } 50% { opacity: 1; } }

  .smr-evidence { padding: var(--ds-section-y) var(--ds-gutter); }
  .smr-evidence__header { max-width: 920px; margin: 0 auto 56px; text-align: center; }
  .smr-evidence__grid { position: relative; max-width: var(--ds-container); margin: 0 auto; overflow: hidden; }
  .smr-evidence-row { position: relative; display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--ds-line-strong); }
  .smr-evidence-row:last-child { border-bottom: 0; }
  .smr-evidence-row__media, .smr-evidence-row__copy { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 3rem; }
  .smr-evidence-row > :first-child { border-right: 1px solid var(--ds-line-strong); }
  .smr-evidence-row__media { align-items: center; }
  .smr-evidence-stage { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; padding: 32px 18px; border-radius: var(--ds-r-xl); isolation: isolate; }
  .smr-evidence-stage--agenda { background: linear-gradient(180deg, color-mix(in srgb, var(--ds-cat-amber) 22%, white) 0%, var(--ds-cat-amber-bg) 45%, var(--ds-surface-tab) 100%); }
  .smr-evidence-stage--filter { background: linear-gradient(180deg, color-mix(in srgb, var(--ds-cat-green) 22%, white) 0%, var(--ds-cat-green-bg) 45%, var(--ds-surface-tab) 100%); }
  .smr-evidence-stage--detail { background: linear-gradient(180deg, color-mix(in srgb, var(--ds-cat-indigo) 22%, white) 0%, var(--ds-cat-indigo-bg) 45%, var(--ds-surface-tab) 100%); }
  .smr-evidence-stage--saved { background: linear-gradient(180deg, color-mix(in srgb, var(--ds-cat-pink) 22%, white) 0%, var(--ds-cat-pink-bg) 45%, var(--ds-surface-tab) 100%); }
  .smr-evidence-row__media img { display: block; width: 100%; height: auto; max-height: 360px; object-fit: contain; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); animation: smr-product-breathe 7s ease-in-out infinite; }
  .smr-evidence-row__media--portrait img { width: auto; max-width: 100%; }
  .smr-evidence-portal-window { position: relative; overflow: hidden; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .smr-evidence-portal-window--agenda { width: 100%; aspect-ratio: 962 / 656; }
  .smr-evidence-portal-window--detail { width: min(360px, 100%); aspect-ratio: 5 / 6; }
  .smr-evidence-portal-window img { position: absolute; height: auto; max-width: none; max-height: none; border: 0; border-radius: 0; object-fit: initial; animation: none; }
  .smr-evidence-portal-window--agenda img { top: -9.76%; left: -33.06%; width: 133.06%; }
  .smr-evidence-portal-window--detail img { top: 0; left: -113.33%; width: 213.33%; }
  .smr-evidence-row__copy { display: flex; flex-direction: column; justify-content: center; }
  .smr-evidence-row__copy > span { display: block; margin-bottom: 1rem; color: var(--ds-blue); font: 500 .875rem/normal var(--font-body); letter-spacing: .05em; text-transform: uppercase; }
  .smr-evidence-row__copy h3 { margin: 0 0 1.25rem; color: var(--ds-ink); font: 500 2.25rem/1.08 var(--font-heading); letter-spacing: -.02em; }
  .smr-evidence-row__copy p { margin: 0; color: var(--ds-body); font: 400 1.125rem/1.5 var(--font-body); }
  @keyframes smr-product-breathe { 0%, 100% { transform: translateY(3px) scale(.985); } 50% { transform: translateY(-3px) scale(1); } }
  .smr-stage-filter { width: min(360px, 100%); display: grid; gap: 10px; padding: 18px; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-lg); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .smr-stage-filter span { padding: 13px 15px; border: 1px solid var(--ds-line); border-radius: 11px; color: var(--ds-muted); font: 500 14px/1.3 var(--font-body); }
  .smr-stage-filter .is-active { border-color: color-mix(in srgb, var(--ds-blue) 25%, white); background: var(--ds-surface-tint); color: var(--ds-blue); }
  .smr-saved-list { width: min(430px, 100%); display: grid; gap: 10px; }
  .smr-saved-list > div { display: grid; grid-template-columns: 54px 1fr auto; gap: 14px; align-items: center; padding: 15px; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  .smr-saved-list i { color: var(--ds-blue); font: 600 12px/1.3 var(--font-body); font-style: normal; }
  .smr-saved-list span { display: grid; gap: 3px; }
  .smr-saved-list b { color: var(--ds-ink); font: 500 13px/1.3 var(--font-body); }
  .smr-saved-list small { color: var(--ds-muted); font: 400 11px/1.3 var(--font-body); }
  .smr-saved-list em { padding: 6px 8px; border-radius: 999px; background: var(--ds-success-soft); color: var(--ds-success); font: 500 10px/1 var(--font-body); font-style: normal; }

  .smr-connected { padding: var(--ds-section-y) 24px; }
  .smr-connected__inner { width: min(1080px, 100%); margin: 0 auto; }
  .smr-connected__header { display: flex; flex-direction: column; align-items: center; margin-bottom: 32px; text-align: center; }
  .smr-connected__badge { margin-bottom: 16px; color: var(--ds-blue); font: 500 13px/1.2 var(--font-body); letter-spacing: .1em; text-transform: uppercase; }
  .smr-connected__title { max-width: 800px; margin: 0 0 16px; }
  .smr-connected__title span { display: block; }
  .smr-connected__subtitle { max-width: 900px; margin: 0; color: var(--ds-body); font: 400 17.5px/1.6 var(--font-body); }
  .smr-connected__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; width: fit-content; max-width: 100%; margin: 0 auto 32px; padding: 6px; border: 1px solid var(--ds-glass-edge); border-radius: 999px; background: color-mix(in srgb, var(--ds-white) 55%, transparent); }
  .smr-connected__tab { padding: 8px 18px; border: 1px solid transparent; border-radius: 999px; background: transparent; color: var(--ds-muted); font: 500 13.5px/normal var(--font-body); cursor: pointer; transition: all .2s ease; }
  .smr-connected__tab:hover { background: color-mix(in srgb, var(--ds-white) 65%, transparent); color: var(--ds-ink-2); }
  .smr-connected__tab.is-active { border-color: var(--ds-line); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); color: var(--ds-blue); }
  .smr-connected__box { padding: 0; border: 0; background: transparent; box-shadow: none; }
  .smr-connected__panel { display: none; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; padding: 52px 64px; animation: smr-connected-fade .4s ease forwards; }
  .smr-connected__panel.is-active { display: grid; }
  .smr-connected__copy h3 { margin: 0 0 18px; color: var(--ds-ink); font: 500 clamp(30px, 3.4vw, 40px)/1.1 var(--font-heading); letter-spacing: -.03em; }
  .smr-connected__copy p { margin: 0 0 24px; color: var(--ds-body); font: 400 16px/1.6 var(--font-body); }
  .smr-connected__checklist { display: flex; flex-direction: column; gap: 12px; margin: 0 0 28px; padding: 0; list-style: none; }
  .smr-connected__checklist li { display: flex; align-items: flex-start; gap: 10px; color: var(--ds-sub); font: 400 14.5px/1.4 var(--font-body); }
  .smr-connected__checklist svg { flex-shrink: 0; margin-top: 2px; stroke: var(--ds-blue); }
  .smr-connected__link { display: inline-flex; align-items: center; gap: 8px; color: var(--ds-blue); font: 500 14.5px/1.4 var(--font-body); text-decoration: none; }
  .smr-connected__link:hover { color: var(--ds-blue-hover); }
  .smr-connected__visual { min-width: 0; }
  .smr-connected__showcase { position: relative; isolation: isolate; }
  .smr-connected__showcase > img { display: block; width: 100%; height: auto; aspect-ratio: 1117 / 837; object-fit: contain; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); background: var(--ds-white); box-shadow: var(--ds-shadow-shot); }
  /* the label repeats the tab title; keep it visible but as a quiet caption under the screenshot, not a chip over it */
  .smr-connected__visual-label { display: block; margin-top: 12px; color: var(--ds-muted); font: 500 13px/1.3 var(--font-body); text-align: center; }

  @keyframes smr-connected-fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .smr-faq { width: 100%; padding: var(--ds-section-y) 24px; background: var(--ds-white); }
  .smr-faq__inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 360px 1fr; gap: 64px; align-items: start; }
  .smr-faq__sidebar { position: sticky; top: 6rem; }
  .smr-faq__eyebrow { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 20px; padding: 8px 16px; border: 1px solid var(--ds-line-strong); border-radius: 999px; color: var(--ds-ink); font: 500 .8125rem/normal var(--font-body); }
  .smr-faq__sidebar h2 { margin: 0 0 20px; }
  .smr-faq__sidebar p { margin: 0 0 28px; color: var(--ds-body); font: 400 16px/1.6 var(--font-body); }
  .smr-faq__list { display: flex; flex-direction: column; gap: 16px; counter-reset: session-faq; }
