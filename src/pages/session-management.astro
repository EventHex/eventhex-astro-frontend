  <script>
    const setupSessionManagementPage = () => {
      const page = document.querySelector<HTMLElement>(".smr-page-bg");
      if (!page || page.dataset.bound === "true") return;
      page.dataset.bound = "true";
      const faqItems = Array.from(page.querySelectorAll<HTMLDetailsElement>("[data-smr-faq]"));
      faqItems.forEach((item) => item.addEventListener("toggle", () => {
        if (item.open) faqItems.forEach((other) => { if (other !== item) other.open = false; });
      }));
      const formatSteps = Array.from(page.querySelectorAll<HTMLDetailsElement>("[data-format-step]"));
      formatSteps.forEach((item) => item.addEventListener("toggle", () => {
        if (item.open) formatSteps.forEach((other) => { if (other !== item) other.open = false; });
      }));
      const header = page.querySelector<HTMLElement>(".smr-stories__header");
      const cards = page.querySelectorAll<HTMLElement>(".smr-story-card");
      const lastCard = cards[cards.length - 1];
      if (header && lastCard) {
        let frame = 0;
        const syncHeader = () => {
          frame = 0;
          const stickyTop = Number.parseFloat(getComputedStyle(lastCard).top) || 0;
          header.style.transform = `translateY(${Math.min(0, lastCard.getBoundingClientRect().top - stickyTop)}px)`;
        };
        const queueHeader = () => { if (!frame) frame = requestAnimationFrame(syncHeader); };
        window.addEventListener("scroll", queueHeader, { passive: true });
        window.addEventListener("resize", queueHeader, { passive: true });
        syncHeader();
      }

      const connected = page.querySelector<HTMLElement>(".smr-connected");
      if (connected) {
        const tabs = Array.from(connected.querySelectorAll<HTMLButtonElement>("[data-connected-target]"));
        const panels = Array.from(connected.querySelectorAll<HTMLElement>("[data-connected-panel]"));
        let rotationId: number | undefined;
        const activateTab = (tab: HTMLButtonElement) => {
          const target = tab.dataset.connectedTarget;
          tabs.forEach((item) => {
            item.classList.toggle("is-active", item === tab);
            item.setAttribute("aria-selected", item === tab ? "true" : "false");
          });
          panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.connectedPanel === target));
        };
        const stopRotation = () => {
          if (rotationId === undefined) return;
          window.clearInterval(rotationId);
          rotationId = undefined;
        };
        const startRotation = () => {
          stopRotation();
          if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          rotationId = window.setInterval(() => {
            const currentIndex = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
            activateTab(tabs[(currentIndex + 1) % tabs.length]);
          }, 4000);
        };
        tabs.forEach((tab) => tab.addEventListener("click", () => { activateTab(tab); startRotation(); }));
        connected.addEventListener("mouseenter", stopRotation);
        connected.addEventListener("mouseleave", startRotation);
        connected.addEventListener("focusin", stopRotation);
        connected.addEventListener("focusout", (event) => {
          if (!(event.relatedTarget instanceof Node) || !connected.contains(event.relatedTarget)) startRotation();
        });
        startRotation();
      }

      const band = page.querySelector<HTMLElement>(".smr-access-band");
      if (!band || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      let bandTop = 0;
      let viewportHeight = window.innerHeight || 1;
      let bandFrame = 0;
      let lastProgress = -1;
      const measureBand = () => {
        viewportHeight = window.innerHeight || 1;
        bandTop = band.getBoundingClientRect().top + window.scrollY;
      };
      const syncBand = () => {
        bandFrame = 0;
        const travelled = viewportHeight - (bandTop - window.scrollY);
        const progress = Math.round(Math.min(1, Math.max(0, travelled / (viewportHeight * .7))) * 100) / 100;
        if (progress === lastProgress) return;
        lastProgress = progress;
        band.style.setProperty("--band-p", String(progress));
      };
      const queueBand = () => { if (!bandFrame) bandFrame = requestAnimationFrame(syncBand); };
      const resizeBand = () => { measureBand(); lastProgress = -1; queueBand(); };
      measureBand();
      syncBand();
      window.addEventListener("scroll", queueBand, { passive: true });
      window.addEventListener("resize", resizeBand, { passive: true });
      window.addEventListener("load", resizeBand, { once: true });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setupSessionManagementPage, { once: true });
    else setupSessionManagementPage();
  </script>
</MarketingLayout>

