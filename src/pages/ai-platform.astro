---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "AI Tools for Event Planning — One Connected Suite | EventHex";
const description = "Bring planning, attendee engagement, event photos, and session follow-up into one event workflow with EventHex AI Event Copilot, Form Builder, Smart-Connect, Photo Gallery, and Session Recap.";

const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="M19 3v4M17 5h4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M8 8h8M8 12h5M8 16h7"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.4-4 2.3-6 5.5-6s5.1 2 5.5 6M13.5 15c1-.9 2.1-1.4 3.5-1.4 2.8 0 4.2 1.8 4.5 5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m4 17 4-4 3 3 3-3 6 5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6V3Z"/><path d="M14 3v4h4M9 11h6M9 15h6"/></svg>`,
];

const tools = [
  { phase: "Plan", name: "AI Event Copilot", desc: "Ask event questions and prepare supported organizer actions from one Copilot.", href: "/ai-event-copilot/" },
  { phase: "Build", name: "AI Form Builder", desc: "Describe the form, review the suggested fields, reorder them, and publish.", href: "/ai-form-builder/" },
  { phase: "Connect", name: "AI Smart-Connect", desc: "Let attendees describe who they want to meet and discover relevant profiles.", href: "/enhance-networking-ai-smart-connect/" },
  { phase: "Capture", name: "AI Photo Gallery", desc: "Use a selfie to help attendees find their own event photos in the gallery.", href: "/ai-photo-gallery/" },
  { phase: "Recap", name: "AI Session Recap", desc: "Turn session audio into transcripts, summaries, and takeaways for the session page.", href: "/ai-session-recap/" },
];

const formSteps = [
  { title: "Describe", desc: "Tell EventHex what the form should collect and who it is for.", image: "/feature-images/ai-form-builder/stacking-card-1.svg" },
  { title: "Generate", desc: "Create a suggested starting set of fields from the description.", image: "/feature-images/ai-form-builder/stacking-card-2.svg" },
  { title: "Review", desc: "Edit labels, requirements, consent, and other field settings.", image: "/feature-images/ai-form-builder/stacking-card-3.svg" },
  { title: "Arrange and publish", desc: "Drag fields into order, preview the form, and publish when it is ready.", image: "/feature-images/ai-form-builder/how-it-works-visual.svg" },
];

const lifecycle = [
  ["Before the event", "Use Copilot for setup questions and supported actions, build forms, and help attendees find relevant connections."],
  ["During the event", "Continue networking, capture photos, and produce live session transcripts."],
  ["After each moment", "Surface matched galleries, summaries, takeaways, and attendee-ready follow-up content."],
];

const useCases = [
  { id: "exhibitions", label: "Exhibitions", title: "Make every show-floor interaction easier to act on", desc: "Help visitors discover relevant people, capture show-floor photos, and keep organizer questions close to the event workspace.", image: "/feature-images/ai/ai-smart-networking.webp", checks: ["Relevant attendee discovery", "Personal photo galleries", "Organizer answers in context"] },
  { id: "conferences", label: "Conferences & tech", title: "Connect the agenda, audience, and follow-up", desc: "Build forms, support networking, and give every recorded session a recap path.", image: "/feature-images/speaker-management/instarecap-v2.svg", checks: ["AI-assisted forms", "Networking recommendations", "Session transcripts and recaps"] },
  { id: "associations", label: "Associations", title: "Support member-led programs across repeat events", desc: "Use focused forms and session content to support member-led programs and repeat events.", image: "/feature-images/ai-form-builder/how-it-works-visual.svg", checks: ["Reusable form workflows", "Member discovery", "Attendee-ready takeaways"] },
  { id: "corporate", label: "Corporate & agencies", title: "Apply one AI toolkit across different event teams", desc: "Apply a consistent AI toolkit while configuring each client, audience, and event separately.", image: "/feature-images/ai-event-copilot/hero-visual.svg", checks: ["Event-specific controls", "Shared operating workflow", "Organizer review before changes"] },
];

const controls = [
  ["Organizer review", "Copilot requests confirmation for supported changes that write to event data.", "Review before write"],
  ["Event-level settings", "Gallery access, photo approval, notifications, and related attendee controls can be configured for the event.", "Configure the experience"],
  ["Feature-by-feature fit", "Availability and plan requirements vary. Use the demo to confirm the exact AI setup required for your workflow.", "Confirm before rollout"],
];

const faqs = [
  { q: "What AI tools does EventHex include?", a: "The EventHex AI feature family includes AI Event Copilot, AI Form Builder, AI Smart-Connect, AI Photo Gallery, and AI Session Recap. Each has a dedicated workflow and feature page." },
  { q: "Is the AI Platform one tool or a suite?", a: "It is a suite inside the EventHex product family. The AI Platform page helps you choose the right tool; the dedicated feature pages explain each workflow in detail." },
  { q: "What can AI Event Copilot help with?", a: "Copilot can answer supported questions about the event and prepare supported actions across sessions, tickets, forms, check-ins, polls, coupons, orders, and exhibitors. Changes that write event data use a review and confirmation step." },
  { q: "How does AI Smart-Connect work for attendees?", a: "An attendee describes who they want to meet in the event app. EventHex uses that request to return relevant attendee profiles, which the participant can review and act on through the networking experience." },
  { q: "How does the AI Photo Gallery find an attendee's photos?", a: "The attendee provides a selfie, and the gallery looks for face matches in the event photos. Access, approval, notifications, downloads, and watermarking depend on the event's configuration." },
  { q: "What does AI Session Recap create?", a: "It can turn captured session audio into a transcript, summary, and key takeaways. Translated recap artifacts can be offered when that workflow is enabled." },
  { q: "Are all AI features activated automatically?", a: "No blanket activation is assumed. Feature availability, plan requirements, event settings, and attendee access can differ. A demo is the right place to confirm the setup for your event." },
];

const softwareSchema = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "EventHex AI Platform", applicationCategory: "BusinessApplication", operatingSystem: "Web", description, url: "https://eventhex.ai/ai-platform/", featureList: tools.map((tool) => tool.name) };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/ai-platform/"
  footerCtaEyebrow="See the Right AI Workflow for Your Event"
  footerCtaTitle="Bring One Event. We'll Map the AI Tools to the Jobs That Matter."
  footerCtaSubtitle="Show us the setup work, attendee experience, or follow-up you want to improve. We'll walk through the relevant EventHex AI tools and the control points your team will use."
  footerCtaProofItems={["One connected suite", "Clear control points", "Free onboarding support"]}
  footerCtaButtonText="Book a Demo"
  footerCtaImageSrc="/feature-images/ai-event-copilot/cta-visual.svg"
  footerCtaImageAlt="EventHex AI Event Copilot workspace"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="aip-page">
    <!-- Event Registration / Speaker Management split hero -->
    <section class="aip-hero" id="hero">
      <div class="aip-shell aip-hero__grid">
        <div class="aip-hero__copy">
          <span class="aip-kicker">AI tools for event planning</span>
          <h1>AI tools for event planning, connected across your event</h1>
          <p>Bring planning, attendee engagement, event photos, and session follow-up into one event workflow. EventHex gives organizers one Copilot plus focused AI tools for forms, networking, galleries, and recaps.</p>
          <div class="aip-actions"><a class="aip-btn aip-btn--dark" href="/book-a-demo/">Book a Demo</a><a class="aip-btn aip-btn--light" href="#toolkit">Explore the AI toolkit</a></div>
          <ul class="aip-proof"><li>One EventHex Copilot</li><li>Four focused AI tools</li><li>One event workflow</li></ul>
        </div>
        <div class="aip-hero__visual"><div class="aip-hero__visual-card"><img src="/feature-images/ai-event-copilot/hero-visual.svg" alt="EventHex AI Copilot workspace" width="720" height="560" loading="eager" /></div></div>
      </div>
    </section>

    <!-- Speaker Management: Set up the lineup divided row -->
    <section class="ref-setup" aria-labelledby="jobs-title">
      <div class="aip-shell">
        <header class="ref-centered-heading"><h2 id="jobs-title">Five AI jobs. One route to the right tool.</h2></header>
        <div class="ref-setup__grid">
          {tools.slice(0, -1).map((_, index) => (<span class="ref-notch" style={`left:${((index + 1) / tools.length) * 100}%`} aria-hidden="true"></span>))}
          {tools.map((tool, index) => (
            <a class="ref-setup__card" href={tool.href}><span class="ref-line-icon" set:html={icons[index]} /><h3>{tool.phase}</h3><p>{tool.name}</p></a>
          ))}
        </div>
      </div>
    </section>

    <!-- Speaker Management: two-column problem statement -->
    <section class="ref-problem" aria-labelledby="connected-title">
      <div class="aip-shell ref-problem__grid">
        <h2 id="connected-title">Keep AI close to the event it is helping you run</h2>
        <div class="ref-problem__copy">
          <p>Use focused AI experiences without rebuilding the event context for every task.</p>
          <article><strong>Disconnected AI tools</strong><span>Copy event details into separate tools, move outputs by hand, and decide where each result belongs.</span></article>
          <article><strong>EventHex AI tools</strong><span>Start from the event workflow, use the tool for the job, and keep organizer review in the actions that change event data.</span></article>
          <small>Feature availability, automation, and attendee access depend on the EventHex setup selected for the event.</small>
        </div>
      </div>
    </section>

    <!-- Event Registration: Decide How Much You Collect template panels -->
    <section class="ref-template" id="toolkit" aria-labelledby="toolkit-title">
      <div class="aip-shell">
        <header class="ref-centered-heading ref-centered-heading--copy"><span class="aip-kicker">Explore the EventHex AI toolkit</span><h2 id="toolkit-title">Choose the AI job you need next</h2><p>Each feature has one clear role. Open the dedicated page when you need the full workflow and controls.</p></header>
        <div class="ref-template__grid ref-template__grid--five">
          {tools.slice(0, -1).map((_, index) => (<span class="ref-notch" style={`left:${((index + 1) / tools.length) * 100}%`} aria-hidden="true"></span>))}
          {tools.map((tool, index) => (
            <a class="ref-template__card" href={tool.href}><span class="ref-line-icon" set:html={icons[index]} /><h3>{tool.name}</h3><p>{tool.desc}</p></a>
          ))}
        </div>
      </div>
    </section>

    <!-- Speaker Management: describe the agenda / split AI showcase -->
    <section class="ref-ai" id="copilot" aria-labelledby="copilot-title">
      <div class="aip-shell ref-ai__grid">
        <div class="ref-ai__copy"><span class="aip-kicker">AI Event Copilot</span><h2 id="copilot-title">Ask about the event. Prepare the next move. Review before it changes.</h2><p>Use one EventHex Copilot for supported organizer questions and actions instead of switching between separate role-based bots.</p>
          <ul><li><strong>Find the answer</strong><span>Ask about attendees, check-ins, setup progress, orders, exhibitors, sessions, tickets, polls, or coupons.</span></li><li><strong>Prepare the action</strong><span>Create supported event items such as a session, ticket, form, poll, or coupon from the conversation.</span></li><li><strong>Keep the control point</strong><span>Review and confirm supported changes before Copilot writes them to the event.</span></li></ul>
          <div class="aip-actions"><a class="aip-btn aip-btn--dark" href="/book-a-demo/">Book a Demo</a><a class="aip-btn aip-btn--light" href="/ai-event-copilot/">Explore Solution</a></div>
        </div>
        <div class="ref-ai__showcase"><img src="/feature-images/ai-event-copilot/hero-visual.svg" alt="EventHex AI Event Copilot interface" loading="lazy" /><span>Event context connected</span><b>Review before publishing</b></div>
      </div>
    </section>

    <!-- Event Registration: Control who gets in sticky workflow -->
    <section class="ref-workflow" id="form-builder" aria-labelledby="form-title">
      <div class="aip-shell ref-workflow__grid">
        <div class="ref-workflow__intro"><div class="ref-workflow__sticky"><span class="aip-kicker">AI Form Builder</span><h2 id="form-title">Start with the form you need—not an empty canvas</h2><p>Describe the purpose in plain language, then use the visual builder to shape the final form.</p><a class="aip-btn aip-btn--dark" href="/ai-form-builder/">Explore AI Form Builder</a></div></div>
        <div class="ref-workflow__cards">
          {formSteps.map((step, index) => (
            <article class="ref-workflow__card"><div class="ref-workflow__header"><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{step.title}</h3><p>{step.desc}</p></div></div><div class="ref-workflow__visual"><img src={step.image} alt={`AI Form Builder ${step.title} step`} loading="lazy" /></div></article>
          ))}
        </div>
      </div>
    </section>

    <!-- Event Registration: Confirmations That Reach People alternating screenshot rows -->
    <section class="ref-bento" aria-labelledby="focused-tools-title">
      <div class="aip-shell"><header class="ref-centered-heading"><h2 id="focused-tools-title">Focused AI tools for every attendee moment</h2></header>
        <div class="ref-bento__grid">
          <div class="ref-bento__row" id="smart-connect">
            <div class="ref-bento__cell ref-bento__visual"><div class="ref-shot ref-shot--mint"><img src="/feature-images/ai/ai-smart-networking.webp" alt="EventHex AI Smart-Connect attendee matching" loading="lazy" /><span class="ref-float ref-float--top"><b>Relevant profiles</b><small>Matched to the request</small></span><span class="ref-float ref-float--bottom"><i></i><b>Ready to connect</b></span></div></div>
            <div class="ref-bento__cell ref-bento__copy"><span class="aip-kicker">AI Smart-Connect</span><h3>Turn an attendee's networking goal into people they can act on</h3><p>Inside the attendee app, a participant can describe the connection they are looking for and see relevant profiles from the event community.</p><ul><li>Describe the goal in natural language.</li><li>Discover profiles related to that request.</li><li>Open the profile and use the event's networking actions.</li></ul><a href="/enhance-networking-ai-smart-connect/">Learn more about AI Smart-Connect</a></div>
          </div>
          <div class="ref-bento__row ref-bento__row--reverse" id="photo-gallery">
            <div class="ref-bento__cell ref-bento__copy"><span class="aip-kicker">AI Photo Gallery</span><h3>Help attendees get from one selfie to their event photos</h3><p>Bring event photos into the gallery, match an attendee from their selfie, and show their personal results with the access rules set for the event.</p><ul><li>Bring event photos into the gallery.</li><li>Match an attendee from a selfie.</li><li>Open a personal gallery of matched results.</li><li>Control approval, downloads, notifications, and watermarking.</li></ul><a href="/ai-photo-gallery/">Learn more about AI Photo Gallery</a></div>
            <div class="ref-bento__cell ref-bento__visual"><div class="ref-shot ref-shot--pink"><img src="/feature-images/ai-photo-gallery/hero-visual.svg" alt="EventHex AI Photo Gallery selfie matching" loading="lazy" /><span class="ref-float ref-float--top"><b>Selfie matched</b><small>Personal gallery ready</small></span><span class="ref-float ref-float--bottom"><i></i><b>Photos found</b></span></div></div>
          </div>
          <div class="ref-bento__row" id="session-recap">
            <div class="ref-bento__cell ref-bento__visual"><div class="ref-shot ref-shot--yellow"><img src="/feature-images/speaker-management/instarecap-v2.svg" alt="EventHex AI Session Recap" loading="lazy" /><span class="ref-float ref-float--top"><b>Transcript complete</b><small>Summary generating</small></span><span class="ref-float ref-float--bottom"><i></i><b>Takeaways ready</b></span></div></div>
            <div class="ref-bento__cell ref-bento__copy"><span class="aip-kicker">AI Session Recap</span><h3>Carry the session beyond the room</h3><p>Turn captured session audio into a transcript, summary, and key takeaways that attendees can revisit from the session experience.</p><ul><li>Capture a live transcript.</li><li>Generate a summary and key takeaways.</li><li>Present recap content with the session.</li><li>Offer translation when enabled.</li></ul><a href="/ai-session-recap/">Learn more about AI Session Recap</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Event Registration template panels, three-step version -->
    <section class="ref-template" id="lifecycle" aria-labelledby="lifecycle-title">
      <div class="aip-shell"><header class="ref-centered-heading ref-centered-heading--copy"><span class="aip-kicker">Before, during, and after the event</span><h2 id="lifecycle-title">Put each AI tool at the moment it can help</h2><p>The suite is easier to evaluate when every feature is tied to a real event job.</p></header>
        <div class="ref-template__grid"><span class="ref-notch" style="left:33.333%" aria-hidden="true"></span><span class="ref-notch" style="left:66.666%" aria-hidden="true"></span>
          {lifecycle.map(([itemTitle, itemDesc], index) => (<article class="ref-template__card"><span class="ref-line-icon" set:html={icons[index === 2 ? 4 : index]} /><h3>{itemTitle}</h3><p>{itemDesc}</p></article>))}
        </div>
      </div>
    </section>

    <!-- Speaker Management: Built for hardest events tabs -->
    <section class="ref-tabs" aria-labelledby="use-cases-title">
      <div class="aip-shell"><header class="ref-centered-heading ref-centered-heading--copy"><span class="aip-kicker">For events with a lot to coordinate</span><h2 id="use-cases-title">Match the AI workflow to the way your event creates value</h2><p>Choose the tools that support the people, content, and follow-up your event depends on.</p></header>
        <div class="ref-tabs__nav" role="tablist">
          {useCases.map((item, index) => (<button class:list={["ref-tabs__tab", { "is-active": index === 0 }]} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`ai-panel-${item.id}`} data-ai-tab={item.id}>{item.label}</button>))}
        </div>
        <div class="ref-tabs__panels">
          {useCases.map((item, index) => (<article class:list={["ref-tabs__panel", { "is-active": index === 0 }]} id={`ai-panel-${item.id}`} role="tabpanel" data-ai-panel={item.id}><div><h3>{item.title}</h3><p>{item.desc}</p><ul>{item.checks.map((check) => (<li><span>✓</span>{check}</li>))}</ul></div><div class="ref-tabs__image"><img src={item.image} alt={`${item.label} AI event workflow`} loading="lazy" /></div></article>))}
        </div>
      </div>
    </section>

    <!-- Speaker Management: dark agenda feature grid -->
    <section class="ref-dark" aria-labelledby="controls-title">
      <div class="aip-shell"><header class="ref-centered-heading ref-centered-heading--light"><span class="aip-kicker">AI with clear control points</span><h2 id="controls-title">Automate the useful part. Keep the event team in the decision.</h2><p>EventHex uses different controls for organizer actions and attendee experiences, so the setup can match the event.</p></header>
        <div class="ref-dark__grid">{controls.map(([controlTitle, controlDesc, cue], index) => (<article><span class="ref-line-icon" set:html={icons[index]} /><h3>{controlTitle}</h3><p>{controlDesc}</p><strong>{cue}</strong></article>))}</div>
        <p class="ref-dark__note">Use the demo to confirm both the AI experience and the controls required for your event.</p>
      </div>
    </section>

    <!-- Event Registration / Speaker Management split FAQ -->
    <section class="ref-faq" id="faq" aria-labelledby="faq-title">
      <div class="aip-shell ref-faq__grid"><div class="ref-faq__intro"><span class="aip-kicker">Quick answers</span><h2 id="faq-title">AI Platform Questions, Answered.</h2><p>Clear answers about the suite, feature fit, and the controls available to organizers and attendees.</p><a class="aip-btn aip-btn--dark" href="/contact-en/">Visit Help Center</a></div>
        <div class="ref-faq__list">{faqs.map((faq, index) => (<details open={index === 0}><summary><span>{String(index + 1).padStart(2, "0")}</span>{faq.q}<i aria-hidden="true"></i></summary><p>{faq.a}</p></details>))}</div>
      </div>
    </section>
  </div>

  <script>
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ai-tab]'));
    const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-ai-panel]'));
    tabButtons.forEach((button) => button.addEventListener('click', () => {
      const target = button.dataset.aiTab;
      tabButtons.forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-selected', String(item === button)); });
      tabPanels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.aiPanel === target));
    }));
  </script>
</MarketingLayout>

<style>
  .aip-page { --ink:#22272f; --muted:#596579; --line:#e8ecf2; color:var(--ink); background:radial-gradient(circle 340px at 2% 34%,rgba(175,163,255,.18),transparent 100%),radial-gradient(circle 320px at 98% 66%,rgba(183,229,255,.2),transparent 100%),#fff; font-family:var(--font-body); font-weight:400; }
  .aip-shell { width:min(1180px,calc(100% - 48px)); margin-inline:auto; }
  .aip-kicker { display:inline-flex; margin-bottom:12px; color:#375dfb; font-family:var(--font-body); font-size:13px; font-weight:700; line-height:1.2; letter-spacing:.1em; text-transform:uppercase; }
  .aip-hero .aip-kicker { margin-bottom:0; font-size:16px; font-weight:500; letter-spacing:normal; }
  .aip-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
  .aip-btn { display:inline-flex; min-height:48px; align-items:center; justify-content:center; padding:0 24px; border:1px solid transparent; border-radius:9px; font-family:var(--font-body); font-size:15px; font-weight:650; line-height:22px; letter-spacing:-.3px; text-decoration:none; }
  .aip-btn--dark { background:#22272f; color:#fff; }.aip-btn--light { border-color:#dce1e8; background:#fff; color:#22272f; }
  .aip-btn:focus-visible,.ref-setup__card:focus-visible,.ref-template__card:focus-visible,.ref-tabs__tab:focus-visible,.ref-bento__copy a:focus-visible,.ref-faq summary:focus-visible { outline:3px solid rgba(55,93,251,.34); outline-offset:4px; }
  .aip-hero { padding:clamp(72px,8vw,110px) 0 74px; background:linear-gradient(180deg,#fff 0%,#fbfdff 100%); }
  .aip-hero__grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(44px,6vw,76px); align-items:center; }
  .aip-hero__copy h1 { margin:0; font-family:var(--font-heading); font-size:60px; font-weight:500; line-height:66px; letter-spacing:-2.1px; }
  .aip-hero__copy>p { max-width:610px; margin:28px 0 0; color:var(--muted); font-family:var(--font-body); font-size:18px; font-weight:400; line-height:24px; letter-spacing:-.25px; }
  .aip-proof { display:flex; flex-wrap:wrap; gap:12px 24px; margin:26px 0 0; padding:0; color:#4f5969; font-family:var(--font-body); font-size:16px; font-weight:400; list-style:none; }.aip-proof li::before { display:inline-block; width:7px; height:7px; margin-right:9px; border-radius:50%; background:#55c790; content:""; }
  .aip-hero__visual-card { display:grid; min-height:520px; overflow:hidden; place-items:center; padding:30px; border-radius:20px; background:linear-gradient(145deg,#e5f2ff,#f7fbff); }.aip-hero__visual-card img { width:100%; max-height:480px; object-fit:contain; }
  .ref-centered-heading { max-width:900px; margin:0 auto 58px; text-align:center; }.ref-centered-heading h2,.ref-problem h2,.ref-ai h2,.ref-workflow h2 { margin:0; font-family:var(--font-heading); font-size:clamp(36px,5vw,56px); font-weight:500; line-height:1.1; letter-spacing:-.03em; }.ref-centered-heading p { max-width:760px; margin:18px auto 0; color:#6b7280; font-family:var(--font-body); font-size:17px; font-weight:400; line-height:1.65; }.ref-centered-heading--light { color:#fff; }.ref-centered-heading--light p { color:#b5bdca; }
  .ref-setup,.ref-problem,.ref-template,.ref-ai,.ref-workflow,.ref-bento,.ref-tabs,.ref-faq { padding:clamp(72px,8vw,112px) 0; }
