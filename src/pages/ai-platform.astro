---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "AI Tools for Event Planning | One Connected Suite | EventHex";
const description = "Bring planning, attendee engagement, event photos, and session follow-up into one event workflow with EventHex AI Event Copilot, Form Builder, Smart-Connect, Photo Gallery, and Session Recap.";

const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="M19 3v4M17 5h4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M8 8h8M8 12h5M8 16h7"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.4-4 2.3-6 5.5-6s5.1 2 5.5 6M13.5 15c1-.9 2.1-1.4 3.5-1.4 2.8 0 4.2 1.8 4.5 5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m4 17 4-4 3 3 3-3 6 5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6V3Z"/><path d="M14 3v4h4M9 11h6M9 15h6"/></svg>`,
];

const tools = [
  { name: "AI Event Copilot", desc: "Ask event questions and prepare supported organizer actions from one Copilot.", href: "/ai-event-copilot/" },
  { name: "AI Form Builder", desc: "Describe the form, review the suggested fields, reorder them, and publish.", href: "/ai-form-builder/" },
  { name: "AI Smart-Connect", desc: "Let attendees describe who they want to meet and discover relevant profiles.", href: "/enhance-networking-ai-smart-connect/" },
  { name: "AI Photo Gallery", desc: "Use a selfie to help attendees find their own event photos in the gallery.", href: "/ai-photo-gallery/" },
  { name: "AI Session Recap", desc: "Turn session audio into transcripts, summaries, and takeaways for the session page.", href: "/ai-session-recap/" },
];

const formSteps = [
  { title: "Describe", desc: "Tell EventHex what the form should collect and who it is for.", image: "/feature-images/ai-platform/form-builder-describe.jpg", alt: "EventHex Generate Form with AI prompt", status: "Prompt ready", action: "Generate form" },
  { title: "Generate", desc: "Create a suggested starting set of fields from the description.", image: "/feature-images/ai-platform/form-builder-generated.jpg", alt: "EventHex form builder with AI-generated ticket questions", status: "4 fields generated", action: "Review fields" },
  { title: "Review", desc: "Choose fields and review labels, requirements, consent, and other settings.", image: "/feature-images/ai-platform/form-builder-add-field.jpg", alt: "EventHex form field library and AI Generate control", status: "Field library", action: "Choose fields" },
  { title: "Preview and Publish", desc: "Check the attendee experience, then publish when the form is ready.", image: "/feature-images/ai-platform/form-builder-preview.jpg", alt: "EventHex desktop registration form preview", status: "Desktop preview", action: "Preview form" },
];

const copilotSteps = [
  { title: "Find the Answer", desc: "Ask about the event without switching between separate role-based bots.", bullets: ["Attendees and check-ins", "Orders and exhibitors", "Sessions, tickets, polls, and coupons"], image: "/feature-images/ai-event-copilot/analyst-agent-visual.svg", alt: "EventHex AI Event Copilot event analysis workspace", width: 682, height: 504 },
  { title: "Prepare the Action", desc: "Use the conversation to prepare supported event items from the same event context.", bullets: ["Create a session or ticket", "Build a form or poll", "Prepare a coupon"], image: "/feature-images/ai-event-copilot/session-agent-visual.svg", alt: "EventHex AI Event Copilot session creation workflow", width: 787, height: 729 },
  { title: "Review Before It Changes", desc: "Keep the organizer control point before Copilot writes a supported change to the event.", bullets: ["Inspect the proposed change", "Confirm before EventHex writes", "Keep the decision with the event team"], image: "/feature-images/ai-event-copilot/hero-visual.svg", alt: "EventHex AI Event Copilot review and confirmation workspace", width: 855, height: 743 },
];

const lifecycle = [
  { title: "Before the Event", desc: "Use Copilot for setup questions and supported actions, build forms, and help attendees find relevant connections.", href: "/ai-event-copilot/", linkLabel: "Explore AI Event Copilot", screenshots: [
    { src: "/feature-images/ai-platform/lifecycle-before-dashboard.jpg", alt: "EventHex event dashboard for pre event planning", width: 1117, height: 837, kind: "primary" },
    { src: "/feature-images/ai-platform/lifecycle-before-detail.jpg", alt: "EventHex event setup details with complete field labels and controls", width: 779, height: 445, kind: "detail" },
  ] },
  { title: "During the Event", desc: "Continue networking, capture photos, and produce live session transcripts.", href: "/enhance-networking-ai-smart-connect/", linkLabel: "Explore AI Smart-Connect", screenshots: [
    { src: "/feature-images/ai-platform/lifecycle-during-gallery.jpg", alt: "EventHex AI Gallery analytics dashboard", width: 1117, height: 837, kind: "primary" },
    { src: "/feature-images/ai-platform/lifecycle-during-detail.jpg", alt: "EventHex live attendance dashboard with complete check in metrics", width: 779, height: 360, kind: "detail" },
  ] },
  { title: "After Each Moment", desc: "Surface matched galleries, summaries, takeaways, and attendee-ready follow-up content.", href: "/ai-session-recap/", linkLabel: "Explore AI Session Recap", screenshots: [
    { src: "/feature-images/ai-platform/lifecycle-after-dashboard.jpg", alt: "EventHex InstaRecap analytics dashboard", width: 1117, height: 837, kind: "primary" },
    { src: "/feature-images/ai-platform/lifecycle-after-detail.jpg", alt: "EventHex recap translation settings with complete labels and controls", width: 779, height: 505, kind: "detail" },
  ] },
];

const useCases = [
  { id: "exhibitions", label: "Exhibitions", title: "Make Every Show Floor Interaction Easier to Act On", desc: "Help visitors discover relevant people, capture show-floor photos, and keep organizer questions close to the event workspace.", checklist: ["AI-assisted attendee discovery", "Personal photo matching", "Organizer controls in one gallery"], image: "/feature-images/ai-platform/use-case-exhibitions.jpg", imageAlt: "EventHex AI Gallery analytics and face recognition workspace", visualLabel: "Gallery controls ready" },
  { id: "conferences", label: "Conferences & tech", title: "Connect the Agenda, Audience, and Follow Up", desc: "Build forms, support networking, and give every recorded session a recap path.", checklist: ["AI-assisted registration forms", "Networking recommendations", "Session transcripts and recaps"], image: "/feature-images/ai-platform/use-case-conferences.jpg", imageAlt: "EventHex InstaRecap session transcription workspace", visualLabel: "Recap workflow connected" },
  { id: "associations", label: "Associations", title: "Support Member Led Programs Across Repeat Events", desc: "Use focused forms and session content to support member-led programs and repeat events.", checklist: ["Generate focused registration questions", "Review fields before publishing", "Preview the attendee experience"], image: "/feature-images/ai-platform/form-builder-generated.jpg", imageAlt: "EventHex form builder with AI-generated registration questions", visualLabel: "Form fields generated" },
  { id: "corporate", label: "Corporate & agencies", title: "Apply One AI Toolkit Across Different Event Teams", desc: "Apply a consistent AI toolkit while configuring each client, audience, and event separately.", checklist: ["Event-level configuration", "One organizer overview", "Review before supported changes"], image: "/feature-images/ai-platform/use-case-corporate.jpg", imageAlt: "EventHex organizer dashboard and event overview", visualLabel: "Event workspace connected" },
];

const controls = [
  ["Organizer Review", "Copilot requests confirmation for supported changes that write to event data."],
  ["Event Level Settings", "Configure gallery access, photo approval, notifications, and related controls for the event."],
  ["Attendee Access", "Match attendee access to the experience and settings selected for the event."],
  ["Feature by Feature Fit", "Availability and plan requirements vary, so confirm the exact AI setup required for your workflow."],
];

const faqs = [
  { q: "What AI tools does EventHex include?", a: "The EventHex AI feature family includes AI Event Copilot, AI Form Builder, AI Smart-Connect, AI Photo Gallery, and AI Session Recap. Each has a dedicated workflow and feature page." },
  { q: "Is the AI Platform one tool or a suite?", a: "It is a suite inside the EventHex product family. The AI Platform page helps you choose the right tool; the dedicated feature pages explain each workflow in detail." },
  { q: "What can AI Event Copilot help with?", a: "Copilot can answer supported questions about the event and prepare supported actions across sessions, tickets, forms, check-ins, polls, coupons, orders, and exhibitors. Changes that write event data use a review and confirmation step." },
  { q: "How does AI Smart-Connect work for attendees?", a: "An attendee describes who they want to meet in the event app. EventHex uses that request to return relevant attendee profiles, which the participant can review and act on through the networking experience." },
  { q: "How does the AI Photo Gallery find an attendee's photos?", a: "The attendee provides a selfie, and the gallery looks for face matches in the event photos. Access, approval, notifications, downloads, and watermarking depend on the event's configuration." },
  { q: "What does AI Session Recap create?", a: "It can turn captured session audio into a transcript, summary, and key takeaways. Translated recap artifacts can be offered when that workflow is enabled." },
  { q: "Are all AI features activated automatically?", a: "No blanket activation is assumed. Feature availability, plan requirements, event settings, and attendee access can differ. A demo is the right place to confirm the setup for your event." },
];

const softwareSchema = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "EventHex AI Platform", applicationCategory: "BusinessApplication", operatingSystem: "Web", description, url: "https://eventhex.ai/ai-platform/", featureList: tools.map((tool) => tool.name) };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/ai-platform/"
  footerCtaEyebrow="See the Right AI Workflow for Your Event"
  footerCtaTitle="Bring One Event. We'll Map the AI Tools to the Jobs That Matter."
  footerCtaSubtitle="Show us the setup work, attendee experience, or follow-up you want to improve. We'll walk through the relevant EventHex AI tools and the control points your team will use."
  footerCtaButtonText="Book a Demo"
  footerCtaImageSrc="/feature-images/ai-event-copilot/cta-visual.svg"
  footerCtaImageAlt="EventHex AI Event Copilot workspace"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="aip-page">
    <!-- Event Registration split hero -->
    <section class="aip-hero" id="hero">
      <div class="aip-shell aip-hero__grid">
        <div class="aip-hero__copy">
          <span class="aip-kicker">AI Tools for Event Planning</span>
          <h1>AI Tools for Event Planning, Connected Across Your Event</h1>
          <p>Bring planning, attendee engagement, event photos, and session follow-up into one event workflow. EventHex gives organizers one Copilot plus focused AI tools for forms, networking, galleries, and recaps.</p>
          <div class="aip-actions"><a class="aip-btn aip-btn--dark" href="/book-a-demo/">See it with your event <span aria-hidden="true">&#8250;</span></a><a class="aip-btn aip-btn--light" href="#toolkit">Explore the AI toolkit</a></div>
          <ul class="aip-proof"><li>One EventHex Copilot</li><li>Four focused AI tools</li><li>One event workflow</li></ul>
        </div>
        <div class="aip-hero__visual">
          <div class="aip-hero__visual-card">
            <div class="aip-hero__visual-inner">
              <div class="aip-hero__product-stack">
                <div class="aip-hero__portal-crop aip-hero__portal-crop--overview">
                  <img src="/feature-images/ai-platform/hero-instarecap.jpg" alt="EventHex InstaRecap overview and usage analytics" width="1117" height="837" loading="eager" fetchpriority="high" />
                </div>
                <div class="aip-hero__portal-crop aip-hero__portal-crop--gallery">
                  <img src="/feature-images/ai-platform/hero-ai-gallery.jpg" alt="EventHex AI Gallery analytics summary" width="1117" height="837" loading="lazy" />
                </div>
                <img class="aip-hero__portal-shot aip-hero__portal-shot--recap" src="/feature-images/ai-platform/hero-instarecap.jpg" alt="EventHex InstaRecap analytics workspace" width="1117" height="837" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="aip-trust-strip" aria-label="AI platform overview">
      <div class="aip-trust-strip__inner">
        <span><b>5</b> connected AI workflows</span>
        <span><b>Before, during &amp; after</b> the event</span>
        <span><b>Organizer review</b> before supported changes</span>
        <span><b>Event context</b> stays connected</span>
      </div>
    </section>

    <!-- Event Registration: two-option comparison -->
    <section class="aip-flow-section" aria-labelledby="connected-title">
      <header class="aip-flow-header">
        <h2 class="aip-flow-title" id="connected-title">Keep AI Close to the Event It Is Helping You Run</h2>
        <p class="aip-flow-subtitle">Use focused AI experiences without rebuilding the event context for every task.</p>
      </header>

      <div class="aip-flow-quad">
        <article class="aip-flow-quad__cell aip-flow-quad__cell--copy">
          <h3 class="aip-flow-quad__title"><span>Disconnected</span> <span>AI Tools</span></h3>
          <p class="aip-flow-quad__text">Copy event details into separate tools, move outputs by hand, and decide where each result belongs.</p>
        </article>

        <div class="aip-flow-quad__cell aip-flow-quad__cell--media">
          <div class="aip-flow-composite">
            <img class="aip-flow-composite__screen aip-flow-composite__screen--primary" src="/feature-images/ai-platform/form-builder-generated.jpg" alt="EventHex registration form builder workspace" width="1117" height="837" loading="lazy" />
            <img class="aip-flow-composite__screen aip-flow-composite__screen--secondary" src="/feature-images/ai-platform/lifecycle-during-gallery.jpg" alt="EventHex AI Gallery analytics workspace" width="1117" height="837" loading="lazy" />
            <img class="aip-flow-composite__screen aip-flow-composite__screen--detail" src="/feature-images/ai-platform/lifecycle-after-detail.jpg" alt="EventHex InstaRecap translation settings" width="779" height="505" loading="lazy" />
            <span class="aip-flow-composite__status aip-flow-composite__status--separate">Separate workspaces</span>
            <span class="aip-flow-composite__action">Move output</span>
            <img class="aip-flow-composite__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
          </div>
        </div>

        <div class="aip-flow-quad__cell aip-flow-quad__cell--media">
          <div class="aip-flow-composite">
            <img class="aip-flow-composite__screen aip-flow-composite__screen--primary" src="/feature-images/ai-platform/hero-dashboard.jpg" alt="EventHex organizer dashboard for an active event" width="1117" height="837" loading="lazy" />
            <img class="aip-flow-composite__screen aip-flow-composite__screen--secondary" src="/feature-images/ai-platform/lifecycle-before-forms.jpg" alt="EventHex forms workspace connected to the event" width="1117" height="837" loading="lazy" />
            <img class="aip-flow-composite__screen aip-flow-composite__screen--detail" src="/feature-images/ai-platform/lifecycle-during-detail.jpg" alt="EventHex event attendance overview" width="779" height="360" loading="lazy" />
            <span class="aip-flow-composite__status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg> Event context connected</span>
            <span class="aip-flow-composite__action">Review action</span>
            <img class="aip-flow-composite__cursor" src="/feature-images/event-registration/cursor.svg" alt="" aria-hidden="true" />
          </div>
        </div>

        <article class="aip-flow-quad__cell aip-flow-quad__cell--copy">
          <h3 class="aip-flow-quad__title"><span>EventHex</span> <span>AI Tools</span></h3>
          <p class="aip-flow-quad__text">Start from the event workflow, use the tool for the job, and keep organizer review in the actions that change event data.</p>
        </article>

        <span class="aip-flow-quad__cross" aria-hidden="true">
          <svg width="18" height="18" viewBox="-14 -14 28 28">
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--aip-line)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--aip-line)" transform="scale(1,-1)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--aip-line)" transform="rotate(90)"></path>
            <path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="var(--aip-line)" transform="rotate(-90)"></path>
          </svg>
        </span>
      </div>

      <p class="aip-flow-note">Feature availability, automation, and attendee access depend on the EventHex setup selected for the event.</p>
    </section>

    <!-- Event Registration: "Build the Form You Actually Need" capability grid -->
    <section class="aip-toolkit-band" id="toolkit" aria-labelledby="toolkit-title">
      <header class="aip-toolkit-heading">
        <span class="aip-toolkit-heading__eyebrow">Explore the EventHex AI Toolkit</span>
        <h2 id="toolkit-title">Choose the AI Job <span>You Need Next</span></h2>
        <p>Each feature has one clear role. Open the dedicated page when you need the full workflow and controls.</p>
      </header>

      <div class="aip-toolkit-grid-section">
        <div class="aip-toolkit-grid">
          {tools.map((tool, index) => (
            <a class="aip-toolkit-grid__cell" href={tool.href}>
              {[1, 2, 4].includes(index) && (
                <>
                  <span class="aip-toolkit-grid__petal aip-toolkit-grid__petal--top" aria-hidden="true">
                    <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47"></path></svg>
                  </span>
                  <span class="aip-toolkit-grid__petal aip-toolkit-grid__petal--bottom" aria-hidden="true">
                    <svg width="28" height="28" viewBox="-14 -14 28 28"><path d="M-14,0 A14,14 0 0,1 0,14 A14,14 0 0,1 14,0 Z" fill="#3b3a47" transform="scale(1,-1)"></path></svg>
                  </span>
                </>
              )}
              <h3>{tool.name}</h3>
              <p>{tool.desc}</p>

              <div class="aip-toolkit-grid__visual" aria-hidden="true">
                {index === 0 && (
                  <div class="aip-toolkit-mock aip-toolkit-mock--copilot">
                    <span class="aip-toolkit-mock__head">Event Copilot</span>
                    <div class="aip-toolkit-chat"><i></i><span>What needs attention?</span></div>
                    <div class="aip-toolkit-chat aip-toolkit-chat--answer"><span>3 event actions ready</span><b>Review</b></div>
                  </div>
                )}
                {index === 1 && (
                  <div class="aip-toolkit-mock aip-toolkit-mock--form">
                    <span class="aip-toolkit-mock__head">Registration form</span>
                    <div class="aip-toolkit-field"><span>Full name</span><i></i></div>
                    <div class="aip-toolkit-field"><span>Work email</span><i></i></div>
                    <div class="aip-toolkit-field aip-toolkit-field--add">+ Generate fields</div>
                  </div>
                )}
                {index === 2 && (
                  <div class="aip-toolkit-match-list">
                    <div class="aip-toolkit-match"><i>AM</i><span><b>Amina Malik</b><small>92% match</small></span></div>
                    <div class="aip-toolkit-match is-active"><i>JL</i><span><b>Jon Lee</b><small>Shared interests</small></span></div>
                    <div class="aip-toolkit-match"><i>SK</i><span><b>Sam Kim</b><small>Recommended</small></span></div>
                  </div>
                )}
                {index === 3 && (
                  <div class="aip-toolkit-mock aip-toolkit-mock--gallery">
                    <span class="aip-toolkit-mock__head">Personal gallery</span>
                    <div class="aip-toolkit-gallery">
                      <span></span><span></span><span></span><span></span>
                    </div>
                    <div class="aip-toolkit-gallery__status"><i></i><span>12 matches found</span><b>View gallery</b></div>
                  </div>
                )}
                {index === 4 && (
                  <div class="aip-toolkit-mock aip-toolkit-mock--recap">
                    <span class="aip-toolkit-mock__head">Session recap</span>
                    <div class="aip-toolkit-recap-line"><i></i><span></span></div>
                    <div class="aip-toolkit-recap-line"><i></i><span></span></div>
                    <div class="aip-toolkit-recap-line"><i></i><span></span></div>
                    <div class="aip-toolkit-recap-tags"><span>Summary</span><span>Takeaways</span></div>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="aip-toolkit-cta animate-on-scroll" id="toolkit-cta" data-animation="fadeInUp">
        <h2 class="aip-toolkit-cta__title">
          Choose the AI tools your
          <span class="aip-toolkit-cta__break">event actually needs</span>
        </h2>
        <a class="aip-toolkit-cta__btn" href="/book-a-demo/">See It With Your Event</a>
      </div>
    </section>

    <!-- Speaker Management: "From call for papers to published program" workflow -->
    <section class="aip-copilot-workflow" id="copilot" aria-labelledby="copilot-title">
      <div class="aip-copilot-workflow__inner">
        <header class="aip-copilot-workflow__header">
          <span>AI Event Copilot</span>
          <h2 id="copilot-title">Ask About the Event. Prepare the Next Move. Review Before It Changes.</h2>
          <p>Use one EventHex Copilot for supported organizer questions and actions instead of switching between separate role-based bots.</p>
        </header>

        <ol class="aip-copilot-steps">
          {copilotSteps.map((step, index) => (
            <li>
              <details open={index === 0}>
                <summary>
                  <span>0{index + 1}</span>
                  <div class="aip-copilot-step__content">
                    <h3>{step.title}</h3>
                    <p>{step.desc}</p>
                    <ul>{step.bullets.map((bullet) => (<li><i aria-hidden="true">✦</i>{bullet}</li>))}</ul>
                  </div>
                  <span class="aip-copilot-step__arrow" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"></path></svg></span>
                </summary>
                <div class="aip-copilot-step__visual">
                  <img src={step.image} alt={step.alt} width={step.width} height={step.height} loading="lazy" decoding="async" />
                </div>
              </details>
            </li>
          ))}
        </ol>
        <a class="aip-copilot-workflow__link" href="/ai-event-copilot/">Explore AI Event Copilot <span aria-hidden="true">&#8250;</span></a>
      </div>
    </section>

    <!-- Event Registration: Access Control sticky card stack -->
    <section class="ref-workflow aip-form-stack" id="form-builder" aria-labelledby="form-title">
      <div class="aip-shell aip-form-stack__container">
        <div class="aip-form-stack__left">
          <div class="aip-form-stack__sticky">
            <div class="aip-form-stack__eyebrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"></path><path d="M19 3v4M17 5h4"></path></svg>
              AI Form Builder
            </div>
            <h2 id="form-title">Start With the <span class="aip-form-stack__gradient">Form You Need</span>, Not an Empty Canvas</h2>
            <p>Describe the purpose in plain language, then use the visual builder to shape the final form.</p>
            <a class="aip-form-stack__cta" href="/ai-form-builder/">
              Explore AI Form Builder
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
        </div>
        <div class="aip-form-stack__right">
          {formSteps.map((step, index) => (
            <article class="aip-form-stack__card">
              <div class="aip-form-stack__header">
                <div class="aip-form-stack__number">{String(index + 1).padStart(2, "0")}</div>
                <div class="aip-form-stack__text"><h3>{step.title}</h3><p>{step.desc}</p></div>
              </div>
              <div class="aip-form-stack__visual">
                <div class="aip-form-stack__shot">
