  <script>
    const suite = document.querySelector<HTMLElement>('.aip-event-suites');
    if (suite) {
      const suiteTabs = Array.from(suite.querySelectorAll<HTMLButtonElement>('.aip-event-suites__tab'));
      const suitePanels = Array.from(suite.querySelectorAll<HTMLElement>('.aip-event-suites__panel'));
      let suiteRotationId: number | undefined;

      const activateSuiteTab = (tab: HTMLButtonElement) => {
        const target = tab.dataset.aipSuiteTarget;
        suiteTabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
        });
        suitePanels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.aipSuitePanel === target));
      };

      const stopSuiteRotation = () => {
        if (suiteRotationId === undefined) return;
        window.clearInterval(suiteRotationId);
        suiteRotationId = undefined;
      };

      const startSuiteRotation = () => {
        stopSuiteRotation();
        if (suiteTabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        suiteRotationId = window.setInterval(() => {
          const currentIndex = suiteTabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
          activateSuiteTab(suiteTabs[(currentIndex + 1) % suiteTabs.length]);
        }, 4000);
      };

      suiteTabs.forEach((tab) => tab.addEventListener('click', () => {
        activateSuiteTab(tab);
        startSuiteRotation();
      }));
      suite.addEventListener('mouseenter', stopSuiteRotation);
      suite.addEventListener('mouseleave', startSuiteRotation);
      suite.addEventListener('focusin', stopSuiteRotation);
      suite.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !suite.contains(event.relatedTarget)) startSuiteRotation();
      });
      document.addEventListener('visibilitychange', () => document.hidden ? stopSuiteRotation() : startSuiteRotation());
      startSuiteRotation();
    }

    const toolkitBand = document.querySelector<HTMLElement>('.aip-toolkit-band');
    if (toolkitBand && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let toolkitTop = 0;
      let viewportHeight = window.innerHeight || 1;
      let toolkitTicking = false;
      let toolkitProgress = -1;

      const measureToolkitBand = () => {
        viewportHeight = window.innerHeight || 1;
        toolkitTop = toolkitBand.getBoundingClientRect().top + window.scrollY;
      };
      const updateToolkitBand = () => {
        toolkitTicking = false;
        const travelled = viewportHeight - (toolkitTop - window.scrollY);
        const progress = Math.round(Math.min(1, Math.max(0, travelled / (viewportHeight * .7))) * 100) / 100;
        if (progress === toolkitProgress) return;
        toolkitProgress = progress;
        toolkitBand.style.setProperty('--aip-toolkit-band-p', String(progress));
      };
      const onToolkitScroll = () => {
        if (toolkitTicking) return;
        toolkitTicking = true;
        window.requestAnimationFrame(updateToolkitBand);
      };
      const onToolkitResize = () => {
        measureToolkitBand();
        toolkitProgress = -1;
        onToolkitScroll();
      };

      measureToolkitBand();
      updateToolkitBand();
      window.addEventListener('scroll', onToolkitScroll, { passive: true });
      window.addEventListener('resize', onToolkitResize, { passive: true });
      window.addEventListener('load', onToolkitResize);
    }

    const copilotItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.aip-copilot-steps details'));
    copilotItems.forEach((item) => item.addEventListener('toggle', () => {
      if (!item.open) return;
      copilotItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    }));

    const lifecycleSection = document.querySelector<HTMLElement>('.aip-lifecycle');
    const lifecycleHeader = lifecycleSection?.querySelector<HTMLElement>('.aip-lifecycle__header');
    const lifecycleCards = lifecycleSection?.querySelectorAll<HTMLElement>('.aip-lifecycle__card');
    const finalLifecycleCard = lifecycleCards?.[lifecycleCards.length - 1];
    if (lifecycleHeader && finalLifecycleCard) {
      let lifecycleFrame = 0;
      const syncLifecycleRelease = () => {
        lifecycleFrame = 0;
        const stickyTop = Number.parseFloat(getComputedStyle(finalLifecycleCard).top) || 0;
        const releaseOffset = Math.min(0, finalLifecycleCard.getBoundingClientRect().top - stickyTop);
        lifecycleHeader.style.setProperty('--aip-lifecycle-release-y', `${releaseOffset}px`);
      };
      const queueLifecycleRelease = () => {
        if (lifecycleFrame) return;
        lifecycleFrame = window.requestAnimationFrame(syncLifecycleRelease);
      };
      window.addEventListener('scroll', queueLifecycleRelease, { passive: true });
      window.addEventListener('resize', queueLifecycleRelease, { passive: true });
      syncLifecycleRelease();
    }

    const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.ref-faq__item'));
    faqItems.forEach((item) => item.addEventListener('toggle', () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    }));
  </script>
</MarketingLayout>

