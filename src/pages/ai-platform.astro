    background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.07) 0 1px, transparent 1px 46px);
    content: "";
    mask-image: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 24px), linear-gradient(180deg, transparent 0%, #000 38%, #000 100%);
    mask-composite: intersect;
    pointer-events: none;
    transform: translateX(-50%);
    -webkit-mask-composite: source-in;
    -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 24px), linear-gradient(180deg, transparent 0%, #000 38%, #000 100%);
