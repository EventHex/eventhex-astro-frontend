    position: absolute;
    top: -420px;
    bottom: 0;
    left: 50%;
    z-index: 0;
    width: 100vw;
    background: radial-gradient(60% 55% at 30% 100%, rgba(56,189,248,.26), transparent 72%), radial-gradient(55% 50% at 78% 62%, rgba(164,92,255,.2), transparent 74%);
    content: "";
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.35) 34%, #000 62%);
