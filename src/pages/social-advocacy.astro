---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SocialAdvocacyPage from "../components/social-advocacy/SocialAdvocacyPage.astro";

const title = "Attendee Advocacy Software & Share Posters | EventHex";
const description =
  "Create branded attendee posters, map registration fields and tickets, and make post-registration download and social sharing easy with EventHex.";

// Visible FAQ copy. The same array builds the FAQPage structured data, so the two stay identical.
const faqs: Array<[string, string]> = [
  [
    "What is attendee advocacy for events?",
    "It gives attendees branded content they can personalize and share with their own networks. EventHex connects the poster design to event and registration data so the campaign stays consistent.",
  ],
  [
    "Is every poster generated automatically?",
    "The organizer publishes and assigns the campaign. The attendee opens the poster experience, completes or confirms the required details, chooses an available design, and generates the final image.",
  ],
  [
    "Can I choose which tickets receive a poster?",
    "Yes. Connect a poster to all eligible tickets or selected ticket types, then control draft, published, and priority settings.",
  ],
  [
    "Is the share caption written by AI?",
    "No. This workflow uses an organizer-defined caption template with attendee and event placeholders. AI caption generation is not part of this flow.",
  ],
  [
    "Where can attendees share their poster?",
    "They can download the image and use the available WhatsApp, LinkedIn, or device-sharing path. The exact handoff depends on the browser and device.",
  ],
  [
    "Can we attribute new registrations to a shared poster?",
    "Not end to end. EventHex can record clicks and hashed unique visitors when a share link is enabled, but registration attribution from that link was not verified, so it is not claimed here.",
  ],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "EventHex Attendee Advocacy Software",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: "https://eventhex.ai/social-advocacy/",
  creator: {
    "@type": "Organization",
    name: "EventHex",
    url: "https://eventhex.ai",
  },
  featureList: [
    "Branded poster builder with canvases and templates",
    "Registration-field mapping",
    "Common and ticket-specific attendee fields",
    "All-ticket or selected-ticket campaign assignment",
    "Draft, published, and priority poster states",
    "Multiple poster variations in one campaign",
    "Organizer caption templates with attendee and event placeholders",
    "PNG and JPEG poster download",
    "WhatsApp, LinkedIn, and device share handoffs",
    "Optional tokenized share links with a social-preview page",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<MarketingLayout
  {title}
  {description}
  canonical="https://eventhex.ai/social-advocacy/"
  ogImage="https://cms.eventhex.ai/wp-content/uploads/2025/04/Galaxy-Tab-S8-Ultra.png"
  ogType="website"
  footerCtaEyebrow="Start with one campaign"
  footerCtaTitle="Map one poster to your registration data"
  footerCtaSubtitle="See your attendee advocacy flow before you launch it. In the demo, map one poster design to your registration fields and tickets, then follow the attendee journey through personalization, download, and sharing."
  footerCtaButtonText="Book a Demo"
  footerCtaHref="/book-a-demo/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SocialAdvocacyPage {faqs} />
</MarketingLayout>
